//@version=6
indicator("Candle Science Engine v17.5", overlay=true, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════
// V17.5 CHANGES:
// 1. Simplified Auto-Detect: Presets (Minimal/Standard/Full/Custom) replace
//    16 individual checkboxes. Custom still available for fine-tuning.
// 2. Probability-adaptive projections: Candle & zones auto-switch between
//    MFE (when break is likely) and MAE (when containment is likely).
//    User can override with Always MFE / Always MAE.
// 3. All integer division bugs fixed (v17.4 carry-forward)
// 4. Historical scan runs on barstate.islast (v17.4 carry-forward)
// ═══════════════════════════════════════════════════════════════════════════

// === INPUTS ===
grp_general = "═══ GENERAL ═══"
min_samples = input.int(1, "Minimum Samples", minval=1, group=grp_general)
analysis_mode = input.string("Real-time (C3 Forming)", "Analysis Mode", options=["Real-time (C3 Forming)", "Historical (C3 Not Yet Open)"], group=grp_general)
filter_mode = input.string("Auto-Detect", "Filter Mode", options=["Auto-Detect", "Manual"], group=grp_general)

// === AUTO-DETECT (simplified) ===
grp_auto = "═══ AUTO-DETECT ═══"
auto_preset = input.string("Standard", "Pattern Preset", options=["Minimal", "Standard", "Detailed", "Full", "Custom"], group=grp_auto, tooltip="Minimal: C1+C2 direction only\nStandard: + HH/HL/LL/LH + C3O position\nDetailed: + C2C vs C1 levels + C2O positions\nFull: All 16 dimensions\nCustom: Pick your own below")

// Custom overrides (only used when preset = Custom)
grp_custom = "═══ CUSTOM DIMENSIONS (when Custom) ═══"
custom_c1_dir  = input.bool(true, "C1 Direction", group=grp_custom)
custom_c2_dir  = input.bool(true, "C2 Direction", group=grp_custom)
custom_c2h_c1h = input.bool(true, "C2H vs C1H", group=grp_custom)
custom_c2h_c1o = input.bool(false, "C2H vs C1O", group=grp_custom)
custom_c2l_c1l = input.bool(true, "C2L vs C1L", group=grp_custom)
custom_c2l_c1o = input.bool(false, "C2L vs C1O", group=grp_custom)
custom_c2c_c1h = input.bool(false, "C2C vs C1H", group=grp_custom)
custom_c2c_c1l = input.bool(false, "C2C vs C1L", group=grp_custom)
custom_c2c_c1c = input.bool(false, "C2C vs C1C", group=grp_custom)
custom_c2c_c1o = input.bool(false, "C2C vs C1O", group=grp_custom)
custom_c2o_c1c = input.bool(false, "C2O vs C1C", group=grp_custom)
custom_c2o_c1o = input.bool(false, "C2O vs C1O", group=grp_custom)
custom_c3o_c2h = input.bool(false, "C3O vs C2H", group=grp_custom)
custom_c3o_c2l = input.bool(false, "C3O vs C2L", group=grp_custom)
custom_c3o_c2c = input.bool(false, "C3O vs C2C", group=grp_custom)
custom_c3o_c2o = input.bool(true, "C3O vs C2O", group=grp_custom)

// Resolve preset into booleans
is_custom = auto_preset == "Custom"
is_minimal = auto_preset == "Minimal"
is_standard = auto_preset == "Standard"
is_detailed = auto_preset == "Detailed"
is_full = auto_preset == "Full"

// Preset definitions:
// Minimal:  C1 dir, C2 dir
// Standard: + C2H/C1H, C2L/C1L, C3O/C2O
// Detailed: + C2C/C1C, C2C/C1O, C2O/C1C, C2O/C1O, C3O/C2C
// Full:     everything
auto_c1_dir  = is_custom ? custom_c1_dir  : true                           // all presets
auto_c2_dir  = is_custom ? custom_c2_dir  : true                           // all presets
auto_c2h_c1h = is_custom ? custom_c2h_c1h : (is_standard or is_detailed or is_full)
auto_c2h_c1o = is_custom ? custom_c2h_c1o : is_full
auto_c2l_c1l = is_custom ? custom_c2l_c1l : (is_standard or is_detailed or is_full)
auto_c2l_c1o = is_custom ? custom_c2l_c1o : is_full
auto_c2c_c1h = is_custom ? custom_c2c_c1h : is_full
auto_c2c_c1l = is_custom ? custom_c2c_c1l : is_full
auto_c2c_c1c = is_custom ? custom_c2c_c1c : (is_detailed or is_full)
auto_c2c_c1o = is_custom ? custom_c2c_c1o : (is_detailed or is_full)
auto_c2o_c1c = is_custom ? custom_c2o_c1c : (is_detailed or is_full)
auto_c2o_c1o = is_custom ? custom_c2o_c1o : (is_detailed or is_full)
auto_c3o_c2h = is_custom ? custom_c3o_c2h : is_full
auto_c3o_c2l = is_custom ? custom_c3o_c2l : is_full
auto_c3o_c2c = is_custom ? custom_c3o_c2c : (is_detailed or is_full)
auto_c3o_c2o = is_custom ? custom_c3o_c2o : (is_standard or is_detailed or is_full)

// === MANUAL FILTERS ===
grp_manual = "═══ MANUAL FILTERS ═══"
f_c1_dir   = input.string("Any", "C1 Direction", options=["Any", "Bull", "Bear"], group=grp_manual)
f_c2_dir   = input.string("Any", "C2 Direction", options=["Any", "Bull", "Bear"], group=grp_manual)
f_c2h_c1h  = input.string("Any", "C2H vs C1H", options=["Any", "Above", "Below"], group=grp_manual)
f_c2h_c1o  = input.string("Any", "C2H vs C1O", options=["Any", "Above", "Below"], group=grp_manual)
f_c2l_c1l  = input.string("Any", "C2L vs C1L", options=["Any", "Above", "Below"], group=grp_manual)
f_c2l_c1o  = input.string("Any", "C2L vs C1O", options=["Any", "Above", "Below"], group=grp_manual)
f_c2c_c1h  = input.string("Any", "C2C vs C1H", options=["Any", "Above", "Below"], group=grp_manual)
f_c2c_c1l  = input.string("Any", "C2C vs C1L", options=["Any", "Above", "Below"], group=grp_manual)
f_c2c_c1c  = input.string("Any", "C2C vs C1C", options=["Any", "Above", "Below"], group=grp_manual)
f_c2c_c1o  = input.string("Any", "C2C vs C1O", options=["Any", "Above", "Below"], group=grp_manual)
f_c2o_c1c  = input.string("Any", "C2O vs C1C", options=["Any", "Above", "Below"], group=grp_manual)
f_c2o_c1o  = input.string("Any", "C2O vs C1O", options=["Any", "Above", "Below"], group=grp_manual)
f_c3o_c2h  = input.string("Any", "C3O vs C2H", options=["Any", "Above", "Below"], group=grp_manual)
f_c3o_c2l  = input.string("Any", "C3O vs C2L", options=["Any", "Above", "Below"], group=grp_manual)
f_c3o_c2c  = input.string("Any", "C3O vs C2C", options=["Any", "Above", "Below"], group=grp_manual)
f_c3o_c2o  = input.string("Any", "C3O vs C2O", options=["Any", "Above", "Below"], group=grp_manual)

grp_c3_hist = "═══ HISTORICAL MODE ═══"
c3_open_zone = input.string("In C2 Body", "Hypothetical C3 Open", options=["Above C2 High", "Between C2 High & Body Top", "In C2 Body", "Between C2 Body Bottom & Low", "Below C2 Low"], group=grp_c3_hist)

// === DISPLAY SETTINGS ===
grp_main_table = "═══ MAIN TABLE ═══"
show_main_table    = input.bool(true, "Show Statistics Table", group=grp_main_table)
main_table_position = input.string("Top Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grp_main_table)
main_table_size    = input.string("Normal", "Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_main_table)

grp_filter_table = "═══ PATTERN TABLE ═══"
show_filter_table    = input.bool(false, "Show Detected Pattern", group=grp_filter_table)
filter_table_position = input.string("Bottom Left", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grp_filter_table)
filter_table_size    = input.string("Small", "Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_filter_table)

grp_dist_table = "═══ DISTRIBUTION TABLE ═══"
show_dist_table    = input.bool(true, "Show Distribution", group=grp_dist_table)
dist_table_position = input.string("Bottom Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grp_dist_table)
dist_table_size    = input.string("Normal", "Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_dist_table)
num_buckets        = input.int(5, "Number of Buckets", minval=3, maxval=8, group=grp_dist_table)
trim_pct           = input.int(5, "Trim Percentile (%)", minval=0, maxval=20, group=grp_dist_table)
auto_zone_threshold = input.int(50, "Auto-Zone Threshold (%)", minval=30, maxval=80, group=grp_dist_table)
use_auto_zone      = input.bool(true, "Enable Auto-Zone", group=grp_dist_table)

grp_dist_show = "═══ DISTRIBUTION TOGGLES ═══"
show_mfe_from_c2h    = input.bool(true,  "MFE from C2H (C3H↑C2H)", group=grp_dist_show)
show_mae_from_c2h    = input.bool(false, "MAE from C2H (C3L↓C2H)", group=grp_dist_show)
show_mfe_from_c2l    = input.bool(true,  "MFE from C2L (C3L↓C2L)", group=grp_dist_show)
show_mae_from_c2l    = input.bool(false, "MAE from C2L (C3H↑C2L)", group=grp_dist_show)
show_mfe_up_from_c2c = input.bool(false, "MFE↑ from C2C (C3H↑C2C)", group=grp_dist_show)
show_mfe_dn_from_c2c = input.bool(false, "MFE↓ from C2C (C3L↓C2C)", group=grp_dist_show)
show_mfe_up_from_c2o = input.bool(false, "MFE↑ from C2O (C3H↑C2O)", group=grp_dist_show)
show_mfe_dn_from_c2o = input.bool(false, "MFE↓ from C2O (C3L↓C2O)", group=grp_dist_show)

grp_candle = "═══ PROJECTED CANDLE ═══"
show_projected_candle = input.bool(true, "Show Projected Candle", group=grp_candle)
candle_width  = input.int(1, "Width", minval=1, maxval=10, group=grp_candle)
candle_offset = input.int(5, "Offset", minval=1, maxval=20, group=grp_candle)
bull_color    = input.color(color.new(color.teal, 30), "Bull Color", group=grp_candle)
bear_color    = input.color(color.new(color.maroon, 30), "Bear Color", group=grp_candle)

grp_zones = "═══ PROBABILITY ZONES ═══"
show_zones       = input.bool(true, "Show Zones", group=grp_zones)
show_high_zone   = input.bool(true, "Show Upside Zone", group=grp_zones)
show_low_zone    = input.bool(true, "Show Downside Zone", group=grp_zones)
show_high_median = input.bool(true, "Show High Median", group=grp_zones)
show_low_median  = input.bool(true, "Show Low Median", group=grp_zones)
high_zone_color  = input.color(color.new(color.teal, 75), "Upside Color", group=grp_zones)
low_zone_color   = input.color(color.new(color.maroon, 75), "Downside Color", group=grp_zones)

grp_proj = "═══ PROJECTION MODE ═══"
proj_high_mode = input.string("Auto", "High Projection", options=["Auto", "MFE (Break C2H)", "MAE (Stay below C2H)"], group=grp_proj, tooltip="Auto: uses MFE when P(C3H>C2H)≥50%, MAE otherwise")
proj_low_mode  = input.string("Auto", "Low Projection", options=["Auto", "MFE (Break C2L)", "MAE (Stay above C2L)"], group=grp_proj, tooltip="Auto: uses MFE when P(C3L<C2L)≥50%, MAE otherwise")
proj_auto_threshold = input.int(50, "Auto Switch Threshold %", minval=30, maxval=70, group=grp_proj, tooltip="When probability exceeds this, use MFE; below it, use MAE")

grp_ref_lines = "═══ REFERENCE LINES ═══"
show_c2_high  = input.bool(true, "C2 High", group=grp_ref_lines)
show_c2_low   = input.bool(true, "C2 Low", group=grp_ref_lines)
show_c2_open  = input.bool(false, "C2 Open", group=grp_ref_lines)
show_c2_close = input.bool(true, "C2 Close", group=grp_ref_lines)

grp_labels = "═══ LABELS ═══"
label_size   = input.string("Normal", "Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_labels)
label_offset = input.int(8, "Offset", minval=1, maxval=50, group=grp_labels)
line_length  = input.int(6, "Line Length", minval=1, maxval=50, group=grp_labels)
mfe_decimals = input.int(2, "MFE Decimals", minval=1, maxval=4, group=grp_labels)

// === HELPER FUNCTIONS ===
get_table_position(string pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

get_text_size(string sz) =>
    switch sz
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        => size.large

fmt(float val, int dec) =>
    switch dec
        1 => str.tostring(val, "#.0")
        2 => str.tostring(val, "#.00")
        3 => str.tostring(val, "#.000")
        => str.tostring(val, "#.0000")

make_bar(int cnt, int max_cnt) =>
    bar_len = max_cnt > 0 ? math.min(8, int(float(cnt) / float(max_cnt) * 8.0)) : 0
    switch bar_len
        1 => "█"
        2 => "██"
        3 => "███"
        4 => "████"
        5 => "█████"
        6 => "██████"
        7 => "███████"
        8 => "████████"
        => ""

get_dir(float o, float c) => c >= o ? "bull" : "bear"

main_pos  = get_table_position(main_table_position)
main_sz   = get_text_size(main_table_size)
filter_pos = get_table_position(filter_table_position)
filter_sz = get_text_size(filter_table_size)
dist_pos  = get_table_position(dist_table_position)
dist_sz   = get_text_size(dist_table_size)
lbl_sz    = get_text_size(label_size)

is_auto = filter_mode == "Auto-Detect"

// === CURRENT CANDLES ===
is_rt = analysis_mode == "Real-time (C3 Forming)"
int c1_off = is_rt ? 2 : 1
int c2_off = is_rt ? 1 : 0

float cur_c1h = high[c1_off], float cur_c1l = low[c1_off], float cur_c1o = open[c1_off], float cur_c1c = close[c1_off]
float cur_c2h = high[c2_off], float cur_c2l = low[c2_off], float cur_c2o = open[c2_off], float cur_c2c = close[c2_off]

string cur_c1d = get_dir(cur_c1o, cur_c1c)
string cur_c2d = get_dir(cur_c2o, cur_c2c)

float c2h_ref = cur_c2h
float c2l_ref = cur_c2l
float c2o_ref = cur_c2o
float c2c_ref = cur_c2c
float c2_top = math.max(c2o_ref, c2c_ref)
float c2_bot = math.min(c2o_ref, c2c_ref)
int c2_bar = bar_index - c2_off

get_c3o_price() =>
    if is_rt
        open
    else
        switch c3_open_zone
            "Above C2 High" => c2h_ref + (c2h_ref - c2l_ref) * 0.1
            "Between C2 High & Body Top" => (c2h_ref + c2_top) / 2
            "In C2 Body" => (c2_top + c2_bot) / 2
            "Between C2 Body Bottom & Low" => (c2_bot + c2l_ref) / 2
            => c2l_ref - (c2h_ref - c2l_ref) * 0.1

float c3o_price = get_c3o_price()

// Auto-detect current relationships
bool cur_c2h_gt_c1h = cur_c2h > cur_c1h
bool cur_c2h_gt_c1o = cur_c2h > cur_c1o
bool cur_c2l_gt_c1l = cur_c2l > cur_c1l
bool cur_c2l_gt_c1o = cur_c2l > cur_c1o
bool cur_c2c_gt_c1h = cur_c2c > cur_c1h
bool cur_c2c_gt_c1l = cur_c2c > cur_c1l
bool cur_c2c_gt_c1c = cur_c2c > cur_c1c
bool cur_c2c_gt_c1o = cur_c2c > cur_c1o
bool cur_c2o_gt_c1c = cur_c2o > cur_c1c
bool cur_c2o_gt_c1o = cur_c2o > cur_c1o
bool cur_c3o_gt_c2h = c3o_price > c2h_ref
bool cur_c3o_gt_c2l = c3o_price > c2l_ref
bool cur_c3o_gt_c2c = c3o_price > c2c_ref
bool cur_c3o_gt_c2o = c3o_price > c2o_ref

// === FILTER MATCHING FUNCTIONS ===
passes_dir_check(bool is_auto_mode, bool auto_enabled, string cur_dir, string hist_dir, string manual_filter) =>
    if is_auto_mode
        not auto_enabled or (hist_dir == cur_dir)
    else
        manual_filter == "Any" or (manual_filter == "Bull" and hist_dir == "bull") or (manual_filter == "Bear" and hist_dir == "bear")

passes_rel_check(bool is_auto_mode, bool auto_enabled, bool cur_is_above, bool hist_is_above, string manual_filter) =>
    if is_auto_mode
        not auto_enabled or (hist_is_above == cur_is_above)
    else
        manual_filter == "Any" or (manual_filter == "Above" and hist_is_above) or (manual_filter == "Below" and not hist_is_above)

// === DATA STORAGE ===
var array<float> hist_c1h = array.new<float>()
var array<float> hist_c1l = array.new<float>()
var array<float> hist_c1o = array.new<float>()
var array<float> hist_c1c = array.new<float>()
var array<float> hist_c2h = array.new<float>()
var array<float> hist_c2l = array.new<float>()
var array<float> hist_c2o = array.new<float>()
var array<float> hist_c2c = array.new<float>()
var array<float> hist_c3h = array.new<float>()
var array<float> hist_c3l = array.new<float>()
var array<float> hist_c3o = array.new<float>()
var array<float> hist_c3c = array.new<float>()

var int total_filtered = 0
var int c3_bull_count = 0
var int c3_high_above_c2h = 0
var int c3_low_below_c2l = 0
var int c3_close_above_c2h = 0
var int c3_close_above_c2l = 0
var int c3_close_above_c2c = 0
var int c3_close_above_c2o = 0

var array<float> arr_c3h_vs_c2h = array.new<float>()
var array<float> arr_c3l_vs_c2h = array.new<float>()
var array<float> arr_c3l_vs_c2l = array.new<float>()
var array<float> arr_c3h_vs_c2l = array.new<float>()
var array<float> arr_c3h_vs_c2c = array.new<float>()
var array<float> arr_c3l_vs_c2c = array.new<float>()
var array<float> arr_c3h_vs_c2o = array.new<float>()
var array<float> arr_c3l_vs_c2o = array.new<float>()
var array<float> arr_c3_body = array.new<float>()

// Conditional arrays for MAE projection (C3H when it DOESN'T break C2H, etc.)
var array<float> arr_c3h_vs_c2h_contained = array.new<float>()  // C3H-C2H when C3H<=C2H (negative/zero)
var array<float> arr_c3l_vs_c2l_contained = array.new<float>()  // C3L-C2L when C3L>=C2L (positive/zero)

// C3 Close relative to C2C (for projected close)
var array<float> arr_c3c_vs_c2c = array.new<float>()

// === COLLECT HISTORICAL TRIPLETS ===
if bar_index >= 4
    hist_c1h.push(high[3]),  hist_c1l.push(low[3]),  hist_c1o.push(open[3]),  hist_c1c.push(close[3])
    hist_c2h.push(high[2]),  hist_c2l.push(low[2]),  hist_c2o.push(open[2]),  hist_c2c.push(close[2])
    hist_c3h.push(high[1]),  hist_c3l.push(low[1]),  hist_c3o.push(open[1]),  hist_c3c.push(close[1])

// === SCAN & FILTER ON LAST BAR ===
if barstate.islast
    total_filtered := 0
    c3_bull_count := 0
    c3_high_above_c2h := 0
    c3_low_below_c2l := 0
    c3_close_above_c2h := 0
    c3_close_above_c2l := 0
    c3_close_above_c2c := 0
    c3_close_above_c2o := 0
    arr_c3h_vs_c2h.clear(), arr_c3l_vs_c2h.clear()
    arr_c3l_vs_c2l.clear(), arr_c3h_vs_c2l.clear()
    arr_c3h_vs_c2c.clear(), arr_c3l_vs_c2c.clear()
    arr_c3h_vs_c2o.clear(), arr_c3l_vs_c2o.clear()
    arr_c3_body.clear()
    arr_c3h_vs_c2h_contained.clear()
    arr_c3l_vs_c2l_contained.clear()
    arr_c3c_vs_c2c.clear()
    
    for idx = 0 to hist_c1h.size() - 1
        float c1h = hist_c1h.get(idx), float c1l = hist_c1l.get(idx)
        float c1o = hist_c1o.get(idx), float c1c = hist_c1c.get(idx)
        float c2h = hist_c2h.get(idx), float c2l = hist_c2l.get(idx)
        float c2o = hist_c2o.get(idx), float c2c = hist_c2c.get(idx)
        float c3h = hist_c3h.get(idx), float c3l = hist_c3l.get(idx)
        float c3o = hist_c3o.get(idx), float c3c = hist_c3c.get(idx)
        
        string c1d = get_dir(c1o, c1c)
        string c2d = get_dir(c2o, c2c)
        
        bool h_c2h_gt_c1h = c2h > c1h, bool h_c2h_gt_c1o = c2h > c1o
        bool h_c2l_gt_c1l = c2l > c1l, bool h_c2l_gt_c1o = c2l > c1o
        bool h_c2c_gt_c1h = c2c > c1h, bool h_c2c_gt_c1l = c2c > c1l
        bool h_c2c_gt_c1c = c2c > c1c, bool h_c2c_gt_c1o = c2c > c1o
        bool h_c2o_gt_c1c = c2o > c1c, bool h_c2o_gt_c1o = c2o > c1o
        bool h_c3o_gt_c2h = c3o > c2h, bool h_c3o_gt_c2l = c3o > c2l
        bool h_c3o_gt_c2c = c3o > c2c, bool h_c3o_gt_c2o = c3o > c2o
        
        bool p1 = passes_dir_check(is_auto, auto_c1_dir, cur_c1d, c1d, f_c1_dir)
        bool p2 = passes_dir_check(is_auto, auto_c2_dir, cur_c2d, c2d, f_c2_dir)
        bool p3 = passes_rel_check(is_auto, auto_c2h_c1h, cur_c2h_gt_c1h, h_c2h_gt_c1h, f_c2h_c1h)
        bool p4 = passes_rel_check(is_auto, auto_c2h_c1o, cur_c2h_gt_c1o, h_c2h_gt_c1o, f_c2h_c1o)
        bool p5 = passes_rel_check(is_auto, auto_c2l_c1l, cur_c2l_gt_c1l, h_c2l_gt_c1l, f_c2l_c1l)
        bool p6 = passes_rel_check(is_auto, auto_c2l_c1o, cur_c2l_gt_c1o, h_c2l_gt_c1o, f_c2l_c1o)
        bool p7 = passes_rel_check(is_auto, auto_c2c_c1h, cur_c2c_gt_c1h, h_c2c_gt_c1h, f_c2c_c1h)
        bool p8 = passes_rel_check(is_auto, auto_c2c_c1l, cur_c2c_gt_c1l, h_c2c_gt_c1l, f_c2c_c1l)
        bool p9 = passes_rel_check(is_auto, auto_c2c_c1c, cur_c2c_gt_c1c, h_c2c_gt_c1c, f_c2c_c1c)
        bool p10 = passes_rel_check(is_auto, auto_c2c_c1o, cur_c2c_gt_c1o, h_c2c_gt_c1o, f_c2c_c1o)
        bool p11 = passes_rel_check(is_auto, auto_c2o_c1c, cur_c2o_gt_c1c, h_c2o_gt_c1c, f_c2o_c1c)
        bool p12 = passes_rel_check(is_auto, auto_c2o_c1o, cur_c2o_gt_c1o, h_c2o_gt_c1o, f_c2o_c1o)
        bool p13 = passes_rel_check(is_auto, auto_c3o_c2h, cur_c3o_gt_c2h, h_c3o_gt_c2h, f_c3o_c2h)
        bool p14 = passes_rel_check(is_auto, auto_c3o_c2l, cur_c3o_gt_c2l, h_c3o_gt_c2l, f_c3o_c2l)
        bool p15 = passes_rel_check(is_auto, auto_c3o_c2c, cur_c3o_gt_c2c, h_c3o_gt_c2c, f_c3o_c2c)
        bool p16 = passes_rel_check(is_auto, auto_c3o_c2o, cur_c3o_gt_c2o, h_c3o_gt_c2o, f_c3o_c2o)
        
        bool passes_all = p1 and p2 and p3 and p4 and p5 and p6 and p7 and p8 and p9 and p10 and p11 and p12 and p13 and p14 and p15 and p16
        
        if passes_all
            total_filtered += 1
            if c3c >= c3o
                c3_bull_count += 1
            if c3h > c2h
                c3_high_above_c2h += 1
            if c3l < c2l
                c3_low_below_c2l += 1
            if c3c > c2h
                c3_close_above_c2h += 1
            if c3c > c2l
                c3_close_above_c2l += 1
            if c3c > c2c
                c3_close_above_c2c += 1
            if c3c > c2o
                c3_close_above_c2o += 1
            
            float ref = c2c != 0 ? c2c : 1.0
            float h_vs_c2h = (c3h - c2h) / ref * 100
            float l_vs_c2l = (c3l - c2l) / ref * 100
            
            arr_c3h_vs_c2h.push(h_vs_c2h)
            arr_c3l_vs_c2h.push((c3l - c2h) / ref * 100)
            arr_c3l_vs_c2l.push(l_vs_c2l)
            arr_c3h_vs_c2l.push((c3h - c2l) / ref * 100)
            arr_c3h_vs_c2c.push((c3h - c2c) / ref * 100)
            arr_c3l_vs_c2c.push((c3l - c2c) / ref * 100)
            arr_c3h_vs_c2o.push((c3h - c2o) / ref * 100)
            arr_c3l_vs_c2o.push((c3l - c2o) / ref * 100)
            arr_c3_body.push((c3c - c3o) / ref * 100)
            arr_c3c_vs_c2c.push((c3c - c2c) / ref * 100)
            
            // Conditional: C3H when contained below C2H
            if c3h <= c2h
                arr_c3h_vs_c2h_contained.push(h_vs_c2h)
            // Conditional: C3L when contained above C2L
            if c3l >= c2l
                arr_c3l_vs_c2l_contained.push(l_vs_c2l)

// === PROBABILITIES ===
float tf = float(total_filtered)
float p_bull = tf > 0 ? float(c3_bull_count) / tf * 100.0 : na
float p_bear = not na(p_bull) ? 100.0 - p_bull : na
float p_high_gt_c2h = tf > 0 ? float(c3_high_above_c2h) / tf * 100.0 : na
float p_high_lt_c2h = not na(p_high_gt_c2h) ? 100.0 - p_high_gt_c2h : na
float p_low_lt_c2l = tf > 0 ? float(c3_low_below_c2l) / tf * 100.0 : na
float p_low_gt_c2l = not na(p_low_lt_c2l) ? 100.0 - p_low_lt_c2l : na
float p_close_gt_c2h = tf > 0 ? float(c3_close_above_c2h) / tf * 100.0 : na
float p_close_gt_c2l = tf > 0 ? float(c3_close_above_c2l) / tf * 100.0 : na
float p_close_gt_c2c = tf > 0 ? float(c3_close_above_c2c) / tf * 100.0 : na
float p_close_gt_c2o = tf > 0 ? float(c3_close_above_c2o) / tf * 100.0 : na

// === PERCENTILE FUNCTION ===
pct_interp(array<float> arr, float p) =>
    float r = na
    if arr.size() > 0
        sorted = arr.copy()
        sorted.sort(order.ascending)
        int n = sorted.size()
        if n == 1
            r := sorted.get(0)
        else
            float rank = (p / 100.0) * (n - 1)
            int lo = int(math.floor(rank))
            int hi = int(math.ceil(rank))
            lo := math.max(0, math.min(lo, n - 1))
            hi := math.max(0, math.min(hi, n - 1))
            r := lo == hi ? sorted.get(lo) : sorted.get(lo) + (sorted.get(hi) - sorted.get(lo)) * (rank - lo)
    r

// ═══════════════════════════════════════════════════════════════════════════
// DISTRIBUTION ENGINE
// ═══════════════════════════════════════════════════════════════════════════
type DistResult
    array<float> bounds
    array<int> counts
    int n
    float median
    float zone_lo
    float zone_hi
    float zone_pct

build_dist(array<float> src, string filter_sign) =>
    DistResult result = DistResult.new(
         array.new<float>(), array.new<int>(), 0, na, na, na, na)
    
    filtered = array.new<float>()
    for i = 0 to src.size() - 1
        v = src.get(i)
        if filter_sign == "pos" and v > 0
            filtered.push(v)
        else if filter_sign == "neg" and v < 0
            filtered.push(v)
        else if filter_sign == "all"
            filtered.push(v)
    
    result.n := filtered.size()
    
    if result.n >= 2
        result.median := pct_interp(filtered, 50)
        
        float lo_trim = na
        float hi_trim = na
        
        if filter_sign == "neg"
            hi_trim := trim_pct > 0 ? pct_interp(filtered, trim_pct) : filtered.min()
            lo_trim := trim_pct > 0 ? pct_interp(filtered, 100 - trim_pct) : filtered.max()
        else
            lo_trim := trim_pct > 0 ? pct_interp(filtered, trim_pct) : filtered.min()
            hi_trim := trim_pct > 0 ? pct_interp(filtered, 100 - trim_pct) : filtered.max()
        
        if filter_sign == "neg"
            if lo_trim > hi_trim
                bucket_size = (lo_trim - hi_trim) / num_buckets
                for i = 0 to num_buckets - 1
                    b_hi = lo_trim - (i * bucket_size)
                    b_lo = i == num_buckets - 1 ? hi_trim - 0.0001 : lo_trim - ((i + 1) * bucket_size)
                    result.bounds.push(b_lo)
                    result.bounds.push(b_hi)
                    cnt = 0
                    for j = 0 to filtered.size() - 1
                        v = filtered.get(j)
                        if v >= b_lo and v < b_hi
                            cnt += 1
                    result.counts.push(cnt)
        else
            if hi_trim > lo_trim
                bucket_size = (hi_trim - lo_trim) / num_buckets
                for i = 0 to num_buckets - 1
                    b_lo = lo_trim + (i * bucket_size)
                    b_hi = i == num_buckets - 1 ? hi_trim + 0.0001 : lo_trim + ((i + 1) * bucket_size)
                    result.bounds.push(b_lo)
                    result.bounds.push(b_hi)
                    cnt = 0
                    for j = 0 to filtered.size() - 1
                        v = filtered.get(j)
                        if v >= b_lo and v < b_hi
                            cnt += 1
                    result.counts.push(cnt)
        
        if result.counts.size() > 0
            target_n = int(float(result.n) * float(auto_zone_threshold) / 100.0)
            best_span = 1000
            for s = 0 to result.counts.size() - 1
                cumulative = 0
                for e = s to result.counts.size() - 1
                    cumulative += result.counts.get(e)
                    span = e - s + 1
                    if cumulative >= target_n and span < best_span
                        best_span := span
                        if filter_sign == "neg"
                            result.zone_lo := result.bounds.get(e * 2)
                            result.zone_hi := result.bounds.get(s * 2 + 1)
                        else
                            result.zone_lo := result.bounds.get(s * 2)
                            result.zone_hi := result.bounds.get(e * 2 + 1)
                        result.zone_pct := result.n > 0 ? float(cumulative) / float(result.n) * 100.0 : 0.0
                        break
    else if result.n == 1
        result.median := filtered.get(0)
    
    result

// ═══════════════════════════════════════════════════════════════════════════
// COMPUTED DISTRIBUTIONS
// ═══════════════════════════════════════════════════════════════════════════
var DistResult dist_mfe_c2h = na
var DistResult dist_mae_c2h = na
var DistResult dist_mfe_c2l = na
var DistResult dist_mae_c2l = na
var DistResult dist_mfe_up_c2c = na
var DistResult dist_mfe_dn_c2c = na
var DistResult dist_mfe_up_c2o = na
var DistResult dist_mfe_dn_c2o = na

// Contained distributions for MAE-based projection
var DistResult dist_c3h_contained = na  // C3H relative to C2H when C3H stayed below C2H
var DistResult dist_c3l_contained = na  // C3L relative to C2L when C3L stayed above C2L

var float med_body = na
var float med_body_bull = na
var float med_body_bear = na
var float med_c3c_vs_c2c = na

if barstate.islast and total_filtered >= min_samples
    dist_mfe_c2h    := build_dist(arr_c3h_vs_c2h, "pos")
    dist_mae_c2h    := build_dist(arr_c3l_vs_c2h, "neg")
    dist_mfe_c2l    := build_dist(arr_c3l_vs_c2l, "neg")
    dist_mae_c2l    := build_dist(arr_c3h_vs_c2l, "pos")
    dist_mfe_up_c2c := build_dist(arr_c3h_vs_c2c, "pos")
    dist_mfe_dn_c2c := build_dist(arr_c3l_vs_c2c, "neg")
    dist_mfe_up_c2o := build_dist(arr_c3h_vs_c2o, "pos")
    dist_mfe_dn_c2o := build_dist(arr_c3l_vs_c2o, "neg")
    
    // Contained distributions (all values, since they're already filtered during collection)
    dist_c3h_contained := build_dist(arr_c3h_vs_c2h_contained, "all")
    dist_c3l_contained := build_dist(arr_c3l_vs_c2l_contained, "all")
    
    body_pos = array.new<float>()
    body_neg = array.new<float>()
    for i = 0 to arr_c3_body.size() - 1
        v = arr_c3_body.get(i)
        if v > 0
            body_pos.push(v)
        else if v < 0
            body_neg.push(v)
    med_body := arr_c3_body.size() > 0 ? pct_interp(arr_c3_body, 50) : na
    med_body_bull := body_pos.size() > 0 ? pct_interp(body_pos, 50) : na
    med_body_bear := body_neg.size() > 0 ? pct_interp(body_neg, 50) : na
    med_c3c_vs_c2c := arr_c3c_vs_c2c.size() > 0 ? pct_interp(arr_c3c_vs_c2c, 50) : na

// === Determine projection mode ===
// use_mfe_high: true = project above C2H (MFE), false = project how far below C2H (contained)
bool use_mfe_high = switch proj_high_mode
    "MFE (Break C2H)" => true
    "MAE (Stay below C2H)" => false
    => not na(p_high_gt_c2h) ? p_high_gt_c2h >= proj_auto_threshold : true

bool use_mfe_low = switch proj_low_mode
    "MFE (Break C2L)" => true
    "MAE (Stay above C2L)" => false
    => not na(p_low_lt_c2l) ? p_low_lt_c2l >= proj_auto_threshold : true

// === PATTERN TABLE ===
var table filter_tbl = table.new(filter_pos, 4, 25, bgcolor=color.new(color.black, 85), border_width=1)

// Count active dimensions for display
int dim_count = 0
if is_auto
    dim_count += auto_c1_dir ? 1 : 0
    dim_count += auto_c2_dir ? 1 : 0
    dim_count += auto_c2h_c1h ? 1 : 0
    dim_count += auto_c2h_c1o ? 1 : 0
    dim_count += auto_c2l_c1l ? 1 : 0
    dim_count += auto_c2l_c1o ? 1 : 0
    dim_count += auto_c2c_c1h ? 1 : 0
    dim_count += auto_c2c_c1l ? 1 : 0
    dim_count += auto_c2c_c1c ? 1 : 0
    dim_count += auto_c2c_c1o ? 1 : 0
    dim_count += auto_c2o_c1c ? 1 : 0
    dim_count += auto_c2o_c1o ? 1 : 0
    dim_count += auto_c3o_c2h ? 1 : 0
    dim_count += auto_c3o_c2l ? 1 : 0
    dim_count += auto_c3o_c2c ? 1 : 0
    dim_count += auto_c3o_c2o ? 1 : 0

if show_filter_table and barstate.islast
    filter_tbl.delete()
    filter_tbl := table.new(filter_pos, 4, 25, bgcolor=color.new(color.black, 85), border_width=1)
    
    row = 0
    if is_auto
        preset_lbl = is_custom ? "CUSTOM" : auto_preset
        filter_tbl.cell(0, row, "🔍 " + preset_lbl + " (" + str.tostring(dim_count) + "d)", text_color=color.lime, text_size=filter_sz)
    else
        filter_tbl.cell(0, row, "⚙️ MANUAL", text_color=color.orange, text_size=filter_sz)
    row += 1
    
    c1_active = is_auto ? auto_c1_dir : f_c1_dir != "Any"
    filter_tbl.cell(0, row, "C1", text_color=color.gray, text_size=filter_sz)
    filter_tbl.cell(1, row, cur_c1d == "bull" ? "▲ Bull" : "▼ Bear", text_color=cur_c1d == "bull" ? color.green : color.red, text_size=filter_sz)
    filter_tbl.cell(2, row, c1_active ? "●" : "○", text_color=c1_active ? color.lime : color.gray, text_size=filter_sz)
    row += 1
    
    c2_active = is_auto ? auto_c2_dir : f_c2_dir != "Any"
    filter_tbl.cell(0, row, "C2", text_color=color.gray, text_size=filter_sz)
    filter_tbl.cell(1, row, cur_c2d == "bull" ? "▲ Bull" : "▼ Bear", text_color=cur_c2d == "bull" ? color.green : color.red, text_size=filter_sz)
    filter_tbl.cell(2, row, c2_active ? "●" : "○", text_color=c2_active ? color.lime : color.gray, text_size=filter_sz)
    row += 1
    
    filter_tbl.cell(0, row, "── Structure ──", text_color=color.aqua, text_size=filter_sz)
    row += 1
    
    hh_active = is_auto ? auto_c2h_c1h : f_c2h_c1h != "Any"
    filter_tbl.cell(0, row, "C2H/C1H", text_color=color.gray, text_size=filter_sz)
    filter_tbl.cell(1, row, cur_c2h_gt_c1h ? "HH" : "LH", text_color=cur_c2h_gt_c1h ? color.green : color.red, text_size=filter_sz)
    filter_tbl.cell(2, row, hh_active ? "●" : "○", text_color=hh_active ? color.lime : color.gray, text_size=filter_sz)
    row += 1
    
    hl_active = is_auto ? auto_c2l_c1l : f_c2l_c1l != "Any"
    filter_tbl.cell(0, row, "C2L/C1L", text_color=color.gray, text_size=filter_sz)
    filter_tbl.cell(1, row, cur_c2l_gt_c1l ? "HL" : "LL", text_color=cur_c2l_gt_c1l ? color.green : color.red, text_size=filter_sz)
    filter_tbl.cell(2, row, hl_active ? "●" : "○", text_color=hl_active ? color.lime : color.gray, text_size=filter_sz)
    row += 1
    
    filter_tbl.cell(0, row, "── C3 Open ──", text_color=color.orange, text_size=filter_sz)
    row += 1
    
    c3o_active = is_auto ? auto_c3o_c2o : f_c3o_c2o != "Any"
    filter_tbl.cell(0, row, "C3O/C2O", text_color=color.gray, text_size=filter_sz)
    filter_tbl.cell(1, row, cur_c3o_gt_c2o ? "Above" : "Below", text_color=cur_c3o_gt_c2o ? color.green : color.red, text_size=filter_sz)
    filter_tbl.cell(2, row, c3o_active ? "●" : "○", text_color=c3o_active ? color.lime : color.gray, text_size=filter_sz)
    row += 1
    
    // Projection mode indicator
    filter_tbl.cell(0, row, "── Projection ──", text_color=color.yellow, text_size=filter_sz)
    row += 1
    h_mode_txt = use_mfe_high ? "MFE ↑C2H" : "MAE ≤C2H"
    l_mode_txt = use_mfe_low ? "MFE ↓C2L" : "MAE ≥C2L"
    filter_tbl.cell(0, row, "High", text_color=color.gray, text_size=filter_sz)
    filter_tbl.cell(1, row, h_mode_txt, text_color=use_mfe_high ? color.teal : color.orange, text_size=filter_sz)
    row += 1
    filter_tbl.cell(0, row, "Low", text_color=color.gray, text_size=filter_sz)
    filter_tbl.cell(1, row, l_mode_txt, text_color=use_mfe_low ? color.maroon : color.orange, text_size=filter_sz)
    row += 1
    
    filter_tbl.cell(0, row, "────────────", text_color=color.gray, text_size=filter_sz)
    row += 1
    
    rc = total_filtered >= 50 ? color.green : total_filtered >= 20 ? color.yellow : color.orange
    filter_tbl.cell(0, row, "Matches", text_color=color.white, text_size=filter_sz)
    filter_tbl.cell(1, row, str.tostring(total_filtered), text_color=rc, text_size=filter_sz)

// === MAIN TABLE ===
var table main_tbl = table.new(main_pos, 4, 25, bgcolor=color.new(color.black, 85), border_width=1)

if show_main_table and barstate.islast
    main_tbl.delete()
    main_tbl := table.new(main_pos, 4, 25, bgcolor=color.new(color.black, 85), border_width=1)
    row = 0
    
    main_tbl.cell(0, row, is_rt ? "⚡ REAL-TIME" : "📊 HISTORICAL", text_color=is_rt ? color.lime : color.orange, text_size=main_sz)
    row += 1
    
    if total_filtered >= min_samples
        rc = total_filtered >= 50 ? color.green : total_filtered >= 20 ? color.yellow : color.orange
        main_tbl.cell(0, row, "n=" + str.tostring(total_filtered), text_color=rc, text_size=main_sz)
        row += 1
        
        main_tbl.cell(0, row, "═══ Direction ═══", text_color=color.white, text_size=main_sz)
        row += 1
        main_tbl.cell(0, row, "Bull " + str.tostring(p_bull, "#") + "%", text_color=color.green, text_size=main_sz)
        main_tbl.cell(1, row, "Bear " + str.tostring(p_bear, "#") + "%", text_color=color.red, text_size=main_sz)
        row += 1
        
        main_tbl.cell(0, row, "═══ C3H vs C2H ═══", text_color=color.teal, text_size=main_sz)
        row += 1
        main_tbl.cell(0, row, "Above " + str.tostring(p_high_gt_c2h, "#") + "%", text_color=color.green, text_size=main_sz)
        main_tbl.cell(1, row, "Below " + str.tostring(p_high_lt_c2h, "#") + "%", text_color=color.red, text_size=main_sz)
        row += 1
        
        float mfe_c2h_med = not na(dist_mfe_c2h) ? dist_mfe_c2h.median : na
        float cont_h_med = not na(dist_c3h_contained) ? dist_c3h_contained.median : na
        if use_mfe_high
            main_tbl.cell(0, row, "MFE +" + (na(mfe_c2h_med) ? "—" : fmt(mfe_c2h_med, mfe_decimals)) + "%", text_color=color.yellow, text_size=main_sz)
        else
            main_tbl.cell(0, row, "MAE " + (na(cont_h_med) ? "—" : fmt(cont_h_med, mfe_decimals)) + "%", text_color=color.orange, text_size=main_sz)
        row += 1
        
        main_tbl.cell(0, row, "═══ C3L vs C2L ═══", text_color=color.maroon, text_size=main_sz)
        row += 1
        main_tbl.cell(0, row, "Above " + str.tostring(p_low_gt_c2l, "#") + "%", text_color=color.green, text_size=main_sz)
        main_tbl.cell(1, row, "Below " + str.tostring(p_low_lt_c2l, "#") + "%", text_color=color.red, text_size=main_sz)
        row += 1
        
        float mfe_c2l_med = not na(dist_mfe_c2l) ? dist_mfe_c2l.median : na
        float cont_l_med = not na(dist_c3l_contained) ? dist_c3l_contained.median : na
        if use_mfe_low
            main_tbl.cell(0, row, "MFE " + (na(mfe_c2l_med) ? "—" : fmt(mfe_c2l_med, mfe_decimals)) + "%", text_color=color.yellow, text_size=main_sz)
        else
            main_tbl.cell(0, row, "MAE +" + (na(cont_l_med) ? "—" : fmt(cont_l_med, mfe_decimals)) + "%", text_color=color.orange, text_size=main_sz)
        row += 1
        
        // C3 Close probabilities relative to all C2 OHLC
        main_tbl.cell(0, row, "═══ C3 Close ═══", text_color=color.yellow, text_size=main_sz)
        row += 1
        main_tbl.cell(0, row, ">C2H " + str.tostring(p_close_gt_c2h, "#") + "%", text_color=not na(p_close_gt_c2h) and p_close_gt_c2h >= 50 ? color.green : color.red, text_size=main_sz)
        main_tbl.cell(1, row, ">C2O " + str.tostring(p_close_gt_c2o, "#") + "%", text_color=not na(p_close_gt_c2o) and p_close_gt_c2o >= 50 ? color.green : color.red, text_size=main_sz)
        row += 1
        main_tbl.cell(0, row, ">C2C " + str.tostring(p_close_gt_c2c, "#") + "%", text_color=not na(p_close_gt_c2c) and p_close_gt_c2c >= 50 ? color.green : color.red, text_size=main_sz)
        main_tbl.cell(1, row, ">C2L " + str.tostring(p_close_gt_c2l, "#") + "%", text_color=not na(p_close_gt_c2l) and p_close_gt_c2l >= 50 ? color.green : color.red, text_size=main_sz)
        row += 1
        
        cc_sign = (not na(med_c3c_vs_c2c) and med_c3c_vs_c2c > 0) ? "+" : ""
        main_tbl.cell(0, row, "Med C3C " + cc_sign + (na(med_c3c_vs_c2c) ? "—" : fmt(med_c3c_vs_c2c, mfe_decimals)) + "%", text_color=not na(med_c3c_vs_c2c) and med_c3c_vs_c2c >= 0 ? color.green : color.red, text_size=main_sz)
        row += 1
        
        // Body
        main_tbl.cell(0, row, "═══ Body ═══", text_color=color.purple, text_size=main_sz)
        row += 1
        bs = (not na(med_body) and med_body > 0) ? "+" : ""
        main_tbl.cell(0, row, "Med " + bs + (na(med_body) ? "—" : fmt(med_body, mfe_decimals)) + "%", text_color=med_body >= 0 ? color.green : color.red, text_size=main_sz)
    else
        main_tbl.cell(0, row, "Need " + str.tostring(min_samples) + " samples", text_color=color.orange, text_size=main_sz)

// === DISTRIBUTION TABLE ===
var table dist_tbl = table.new(dist_pos, 5, 80, bgcolor=color.new(color.black, 85), border_width=1)

render_dist_section(table tbl, int start_row, DistResult dist, string title, string sign, color title_clr, color base_clr, color zone_clr) =>
    int row = start_row
    
    med_str = na(dist.median) ? "—" : (sign == "pos" ? "+" : "") + fmt(dist.median, mfe_decimals) + "%"
    tbl.cell(0, row, title + " n=" + str.tostring(dist.n), text_color=title_clr, text_size=dist_sz)
    tbl.cell(3, row, "Med " + med_str, text_color=color.yellow, text_size=dist_sz)
    row += 1
    
    max_cnt = 1
    for i = 0 to dist.counts.size() - 1
        if dist.counts.get(i) > max_cnt
            max_cnt := dist.counts.get(i)
    
    for i = 0 to dist.counts.size() - 1
        b_lo = dist.bounds.get(i * 2)
        b_hi = dist.bounds.get(i * 2 + 1)
        cnt = dist.counts.get(i)
        pct = dist.n > 0 ? float(cnt) / float(dist.n) * 100.0 : 0.0
        
        in_zone = use_auto_zone and not na(dist.zone_lo)
        if sign == "neg"
            in_zone := in_zone and b_lo >= dist.zone_lo - 0.001 and b_hi <= dist.zone_hi
        else
            in_zone := in_zone and b_lo >= dist.zone_lo and b_hi <= dist.zone_hi + 0.001
        
        clr = in_zone ? zone_clr : base_clr
        
        if sign == "neg"
            tbl.cell(0, row, fmt(b_hi, mfe_decimals) + "→" + fmt(b_lo, mfe_decimals), text_color=clr, text_size=dist_sz)
        else
            tbl.cell(0, row, "+" + fmt(b_lo, mfe_decimals) + "→+" + fmt(b_hi, mfe_decimals), text_color=clr, text_size=dist_sz)
        tbl.cell(1, row, str.tostring(cnt), text_color=clr, text_size=dist_sz)
        tbl.cell(2, row, str.tostring(pct, "#") + "%", text_color=clr, text_size=dist_sz)
        tbl.cell(3, row, make_bar(cnt, max_cnt), text_color=clr, text_size=dist_sz)
        row += 1
    
    if use_auto_zone and not na(dist.zone_lo)
        if sign == "neg"
            tbl.cell(0, row, "Zone " + fmt(dist.zone_hi, mfe_decimals) + "→" + fmt(dist.zone_lo, mfe_decimals), text_color=zone_clr, text_size=dist_sz)
        else
            tbl.cell(0, row, "Zone +" + fmt(dist.zone_lo, mfe_decimals) + "→+" + fmt(dist.zone_hi, mfe_decimals), text_color=zone_clr, text_size=dist_sz)
        tbl.cell(2, row, str.tostring(dist.zone_pct, "#") + "%", text_color=zone_clr, text_size=dist_sz)
        row += 1
    
    row

if show_dist_table and barstate.islast and total_filtered >= min_samples
    dist_tbl.delete()
    dist_tbl := table.new(dist_pos, 5, 80, bgcolor=color.new(color.black, 85), border_width=1)
    
    int row = 0
    
    if show_mfe_from_c2h and not na(dist_mfe_c2h) and dist_mfe_c2h.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mfe_c2h, "▲ MFE C3H↑C2H", "pos", color.teal, color.teal, color.lime)
        dist_tbl.cell(0, row, "════════════════", text_color=color.gray, text_size=dist_sz)
        row += 1
    
    if show_mae_from_c2h and not na(dist_mae_c2h) and dist_mae_c2h.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mae_c2h, "▼ MAE C3L↓C2H", "neg", color.orange, color.orange, #FF6600)
        dist_tbl.cell(0, row, "════════════════", text_color=color.gray, text_size=dist_sz)
        row += 1
    
    if show_mfe_from_c2l and not na(dist_mfe_c2l) and dist_mfe_c2l.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mfe_c2l, "▼ MFE C3L↓C2L", "neg", color.maroon, color.maroon, color.fuchsia)
        dist_tbl.cell(0, row, "════════════════", text_color=color.gray, text_size=dist_sz)
        row += 1
    
    if show_mae_from_c2l and not na(dist_mae_c2l) and dist_mae_c2l.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mae_c2l, "▲ MAE C3H↑C2L", "pos", color.purple, color.purple, #CC44FF)
        dist_tbl.cell(0, row, "════════════════", text_color=color.gray, text_size=dist_sz)
        row += 1
    
    if show_mfe_up_from_c2c and not na(dist_mfe_up_c2c) and dist_mfe_up_c2c.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mfe_up_c2c, "▲ MFE C3H↑C2C", "pos", color.green, color.green, color.lime)
        dist_tbl.cell(0, row, "════════════════", text_color=color.gray, text_size=dist_sz)
        row += 1
    
    if show_mfe_dn_from_c2c and not na(dist_mfe_dn_c2c) and dist_mfe_dn_c2c.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mfe_dn_c2c, "▼ MFE C3L↓C2C", "neg", color.red, color.red, color.fuchsia)
        dist_tbl.cell(0, row, "════════════════", text_color=color.gray, text_size=dist_sz)
        row += 1
    
    if show_mfe_up_from_c2o and not na(dist_mfe_up_c2o) and dist_mfe_up_c2o.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mfe_up_c2o, "▲ MFE C3H↑C2O", "pos", color.aqua, color.aqua, color.lime)
        dist_tbl.cell(0, row, "════════════════", text_color=color.gray, text_size=dist_sz)
        row += 1
    
    if show_mfe_dn_from_c2o and not na(dist_mfe_dn_c2o) and dist_mfe_dn_c2o.n >= 2
        row := render_dist_section(dist_tbl, row, dist_mfe_dn_c2o, "▼ MFE C3L↓C2O", "neg", #FF4466, #FF4466, color.fuchsia)

// === PROJECTED CANDLE ===
var box candle_body = na
var line candle_wick_h = na
var line candle_wick_l = na
var label candle_lbl = na

if barstate.islast and total_filtered >= min_samples and show_projected_candle
    candle_body.delete()
    candle_wick_h.delete()
    candle_wick_l.delete()
    candle_lbl.delete()
    
    // HIGH WICK — probability-adaptive
    float proj_h = na
    if use_mfe_high
        // MFE mode: C2H + median excursion above C2H
        float mfe_h_med = not na(dist_mfe_c2h) ? dist_mfe_c2h.median : na
        proj_h := not na(mfe_h_med) ? c2h_ref + (c2c_ref * mfe_h_med / 100) : c2h_ref
    else
        // MAE mode: C3H likely stays below C2H — use contained median
        float cont_h_med = not na(dist_c3h_contained) ? dist_c3h_contained.median : na
        proj_h := not na(cont_h_med) ? c2h_ref + (c2c_ref * cont_h_med / 100) : c2h_ref
    proj_h := math.max(nz(proj_h, c2h_ref), c3o_price)
    
    // LOW WICK — probability-adaptive
    float proj_l = na
    if use_mfe_low
        // MFE mode: C2L + median excursion below C2L
        float mfe_l_med = not na(dist_mfe_c2l) ? dist_mfe_c2l.median : na
        proj_l := not na(mfe_l_med) ? c2l_ref + (c2c_ref * mfe_l_med / 100) : c2l_ref
    else
        // MAE mode: C3L likely stays above C2L — use contained median
        float cont_l_med = not na(dist_c3l_contained) ? dist_c3l_contained.median : na
        proj_l := not na(cont_l_med) ? c2l_ref + (c2c_ref * cont_l_med / 100) : c2l_ref
    proj_l := math.min(nz(proj_l, c2l_ref), c3o_price)
    
    // PROJECTED CLOSE — use median C3C relative to C2C
    // This anchors the close to where it typically lands relative to a known level,
    // rather than just body size from open which has no reference point
    float proj_c = na
    if not na(med_c3c_vs_c2c)
        proj_c := c2c_ref + (c2c_ref * med_c3c_vs_c2c / 100)
    else if not na(med_body)
        proj_c := c3o_price + (c2c_ref * med_body / 100)  // fallback to body size
    else
        proj_c := c3o_price
    proj_c := math.max(proj_l, math.min(proj_h, proj_c))
    
    act_bull = proj_c >= c3o_price
    b_top = math.max(c3o_price, proj_c)
    b_bot = math.min(c3o_price, proj_c)
    cx = c2_bar + candle_offset
    
    bc = act_bull ? bull_color : bear_color
    candle_body := box.new(cx - candle_width, b_top, cx + candle_width, b_bot, border_color=bc, bgcolor=bc)
    candle_wick_h := line.new(cx, b_top, cx, proj_h, color=color.gray, width=1)
    candle_wick_l := line.new(cx, b_bot, cx, proj_l, color=color.gray, width=1)
    
    lt = (act_bull ? "▲ " : "▼ ") + str.tostring(p_bull, "#") + "%"
    candle_lbl := label.new(cx, proj_h, lt, style=label.style_label_down, color=color.new(bc, 70), textcolor=act_bull ? color.teal : color.maroon, size=lbl_sz)

// === REFERENCE LINES AND ZONES ===
var line ln_c2h = na, var line ln_c2l = na, var line ln_c2o = na, var line ln_c2c = na
var label lb_c2h = na, var label lb_c2l = na, var label lb_c2o = na, var label lb_c2c = na
var box zone_high = na, var box zone_low = na
var line ln_high_med = na, var line ln_low_med = na
var label lb_high_med = na, var label lb_low_med = na
var label lb_high_zone = na, var label lb_low_zone = na

if barstate.islast and total_filtered >= min_samples
    ln_c2h.delete(), ln_c2l.delete(), ln_c2o.delete(), ln_c2c.delete()
    lb_c2h.delete(), lb_c2l.delete(), lb_c2o.delete(), lb_c2c.delete()
    zone_high.delete(), zone_low.delete()
    ln_high_med.delete(), ln_low_med.delete()
    lb_high_med.delete(), lb_low_med.delete()
    lb_high_zone.delete(), lb_low_zone.delete()
    
    ls = c2_bar
    le = bar_index + line_length
    lb = bar_index + label_offset
    
    if show_c2_high
        ln_c2h := line.new(ls, c2h_ref, le, c2h_ref, color=color.new(color.white, 60), style=line.style_dotted)
        lb_c2h := label.new(ls - 1, c2h_ref, "C2H", style=label.style_label_right, color=color.new(color.white, 90), textcolor=color.white, size=lbl_sz)
    if show_c2_low
        ln_c2l := line.new(ls, c2l_ref, le, c2l_ref, color=color.new(color.white, 60), style=line.style_dotted)
        lb_c2l := label.new(ls - 1, c2l_ref, "C2L", style=label.style_label_right, color=color.new(color.white, 90), textcolor=color.white, size=lbl_sz)
    if show_c2_open
        ln_c2o := line.new(ls, c2o_ref, le, c2o_ref, color=color.new(color.blue, 60), style=line.style_dotted)
        lb_c2o := label.new(ls - 1, c2o_ref, "C2O", style=label.style_label_right, color=color.new(color.blue, 90), textcolor=color.blue, size=lbl_sz)
    if show_c2_close
        ln_c2c := line.new(ls, c2c_ref, le, c2c_ref, color=color.new(color.yellow, 60), style=line.style_dashed)
        lb_c2c := label.new(ls - 1, c2c_ref, "C2C", style=label.style_label_right, color=color.new(color.yellow, 90), textcolor=color.yellow, size=lbl_sz)
    
    if show_zones
        // HIGH ZONE — adaptive: MFE zone above C2H or contained zone near/below C2H
        if use_mfe_high
            float ha_zlo = not na(dist_mfe_c2h) ? dist_mfe_c2h.zone_lo : na
            float ha_zhi = not na(dist_mfe_c2h) ? dist_mfe_c2h.zone_hi : na
            float ha_zpct = not na(dist_mfe_c2h) ? dist_mfe_c2h.zone_pct : na
            float ha_med = not na(dist_mfe_c2h) ? dist_mfe_c2h.median : na
            
            if show_high_zone and use_auto_zone and not na(ha_zlo) and not na(ha_zhi)
                p_lo = c2h_ref + (c2c_ref * ha_zlo / 100)
                p_hi = c2h_ref + (c2c_ref * ha_zhi / 100)
                zone_high := box.new(ls, p_lo, le, p_hi, bgcolor=high_zone_color, border_color=color.new(color.teal, 50), border_style=line.style_dotted)
                lb_high_zone := label.new(lb, p_hi, "MFE " + str.tostring(ha_zpct, "#") + "%", style=label.style_label_left, color=color.new(color.teal, 80), textcolor=color.teal, size=lbl_sz)
            
            if show_high_median and not na(ha_med)
                p_med = c2h_ref + (c2c_ref * ha_med / 100)
                ln_high_med := line.new(ls, p_med, le, p_med, color=color.teal, style=line.style_solid, width=2)
                lb_high_med := label.new(lb, p_med, "Med +" + fmt(ha_med, mfe_decimals) + "%", style=label.style_label_left, color=color.new(color.teal, 80), textcolor=color.teal, size=lbl_sz)
        else
            // MAE mode: show contained distribution zone (relative to C2H)
            float ch_zlo = not na(dist_c3h_contained) ? dist_c3h_contained.zone_lo : na
            float ch_zhi = not na(dist_c3h_contained) ? dist_c3h_contained.zone_hi : na
            float ch_zpct = not na(dist_c3h_contained) ? dist_c3h_contained.zone_pct : na
            float ch_med = not na(dist_c3h_contained) ? dist_c3h_contained.median : na
            
            if show_high_zone and use_auto_zone and not na(ch_zlo) and not na(ch_zhi)
                p_lo = c2h_ref + (c2c_ref * ch_zlo / 100)
                p_hi = c2h_ref + (c2c_ref * ch_zhi / 100)
                zone_high := box.new(ls, math.min(p_lo, p_hi), le, math.max(p_lo, p_hi), bgcolor=color.new(color.orange, 80), border_color=color.new(color.orange, 50), border_style=line.style_dotted)
                lb_high_zone := label.new(lb, math.max(p_lo, p_hi), "MAE " + str.tostring(ch_zpct, "#") + "%", style=label.style_label_left, color=color.new(color.orange, 80), textcolor=color.orange, size=lbl_sz)
            
            if show_high_median and not na(ch_med)
                p_med = c2h_ref + (c2c_ref * ch_med / 100)
                ln_high_med := line.new(ls, p_med, le, p_med, color=color.orange, style=line.style_solid, width=2)
                lb_high_med := label.new(lb, p_med, "Med " + fmt(ch_med, mfe_decimals) + "%", style=label.style_label_left, color=color.new(color.orange, 80), textcolor=color.orange, size=lbl_sz)
        
        // LOW ZONE — adaptive
        if use_mfe_low
            float lb_zlo = not na(dist_mfe_c2l) ? dist_mfe_c2l.zone_lo : na
            float lb_zhi = not na(dist_mfe_c2l) ? dist_mfe_c2l.zone_hi : na
            float lb_zpct = not na(dist_mfe_c2l) ? dist_mfe_c2l.zone_pct : na
            float lb_med = not na(dist_mfe_c2l) ? dist_mfe_c2l.median : na
            
            if show_low_zone and use_auto_zone and not na(lb_zlo) and not na(lb_zhi)
                p_lo = c2l_ref + (c2c_ref * lb_zlo / 100)
                p_hi = c2l_ref + (c2c_ref * lb_zhi / 100)
                zone_low := box.new(ls, p_lo, le, p_hi, bgcolor=low_zone_color, border_color=color.new(color.maroon, 50), border_style=line.style_dotted)
                lb_low_zone := label.new(lb, p_lo, "MFE " + str.tostring(lb_zpct, "#") + "%", style=label.style_label_left, color=color.new(color.maroon, 80), textcolor=color.maroon, size=lbl_sz)
            
            if show_low_median and not na(lb_med)
                p_med = c2l_ref + (c2c_ref * lb_med / 100)
                ln_low_med := line.new(ls, p_med, le, p_med, color=color.maroon, style=line.style_solid, width=2)
                lb_low_med := label.new(lb, p_med, "Med " + fmt(lb_med, mfe_decimals) + "%", style=label.style_label_left, color=color.new(color.maroon, 80), textcolor=color.maroon, size=lbl_sz)
        else
            float cl_zlo = not na(dist_c3l_contained) ? dist_c3l_contained.zone_lo : na
            float cl_zhi = not na(dist_c3l_contained) ? dist_c3l_contained.zone_hi : na
            float cl_zpct = not na(dist_c3l_contained) ? dist_c3l_contained.zone_pct : na
            float cl_med = not na(dist_c3l_contained) ? dist_c3l_contained.median : na
            
            if show_low_zone and use_auto_zone and not na(cl_zlo) and not na(cl_zhi)
                p_lo = c2l_ref + (c2c_ref * cl_zlo / 100)
                p_hi = c2l_ref + (c2c_ref * cl_zhi / 100)
                zone_low := box.new(ls, math.min(p_lo, p_hi), le, math.max(p_lo, p_hi), bgcolor=color.new(color.orange, 80), border_color=color.new(color.orange, 50), border_style=line.style_dotted)
                lb_low_zone := label.new(lb, math.min(p_lo, p_hi), "MAE " + str.tostring(cl_zpct, "#") + "%", style=label.style_label_left, color=color.new(color.orange, 80), textcolor=color.orange, size=lbl_sz)
            
            if show_low_median and not na(cl_med)
                p_med = c2l_ref + (c2c_ref * cl_med / 100)
                ln_low_med := line.new(ls, p_med, le, p_med, color=color.orange, style=line.style_solid, width=2)
                lb_low_med := label.new(lb, p_med, "Med +" + fmt(cl_med, mfe_decimals) + "%", style=label.style_label_left, color=color.new(color.orange, 80), textcolor=color.orange, size=lbl_sz)

// === ALERTS ===
alertcondition(p_high_gt_c2h > 65 and total_filtered >= min_samples, "High Break", "C3 likely to break C2 High")
alertcondition(p_low_lt_c2l > 65 and total_filtered >= min_samples, "Low Break", "C3 likely to break C2 Low")
alertcondition(p_bull > 60 and total_filtered >= min_samples, "Bullish", "C3 likely bullish")
alertcondition(p_bull < 40 and total_filtered >= min_samples, "Bearish", "C3 likely bearish")
