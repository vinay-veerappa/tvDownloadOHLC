//@version=6
strategy("All-Day ORB V4 [Simplified]", shorttitle="ORBv4", overlay=true,
          initial_capital=3000, default_qty_type=strategy.fixed, default_qty_value=1,
          margin_long=0, margin_short=0, calc_on_every_tick=true,
          calc_on_order_fills=true, use_bar_magnifier=true)

// =============================================================================
// 1. INPUTS - HIGHLY CONFIGURABLE FOR TESTING
// =============================================================================

// --- Core Settings ---
grp_core = "Core Settings"
sessionStart    = input.session("0930-0931", "Opening Range Session (ET)", group=grp_core)
tradingWindow   = input.session("0931-1545", "Trading Window (ET)", group=grp_core, tooltip="When to look for entries")
hardExitTime    = input.session("1550-1600", "Hard Exit Time (ET)", group=grp_core, tooltip="Force close all positions")

// --- Entry Configuration ---
grp_entry = "Entry Configuration"
entryMode = input.string("Immediate", "Entry Mode", 
    options=["Immediate", "Pullback Only", "Pullback + Fallback"], group=grp_entry)
minDisplacement = input.float(0.05, "Min Displacement %", step=0.01, group=grp_entry,
    tooltip="Breakout candle must close at least this % beyond boundary")
maxPullbackDepth = input.float(25, "Max Pullback Depth (% of Range)", minval=0, maxval=100, step=5, group=grp_entry)
pbTimeoutBars = input.int(5, "Pullback Timeout (Bars)", minval=1, maxval=20, group=grp_entry)
fallbackProximity = input.float(0.10, "Fallback Proximity %", step=0.01, group=grp_entry)

// --- Re-entry Rules ---
grp_reentry = "Re-entry Rules"
reentryMode = input.string("Fresh Only", "Re-entry Mode", 
    options=["Immediate", "Fresh Only"], group=grp_reentry,
    tooltip="Immediate=next breakout, Fresh=price must return to range first")
maxAttempts = input.int(5, "Max Attempts per Day", minval=1, maxval=15, group=grp_reentry)
stopAfterWin = input.bool(false, "Stop Trading After Win", group=grp_reentry)
cooldownBars = input.int(0, "Cooldown Bars After Exit", minval=0, maxval=30, group=grp_reentry,
    tooltip="Wait this many bars before next entry (0=no cooldown)")

// =============================================================================
// TAKE PROFIT CONFIGURATION
// =============================================================================
grp_tp = "Take Profit Settings"
useSingleTP = input.bool(false, "Single TP Mode", group=grp_tp,
    tooltip="When ON: Exit 100% at TP1. When OFF: Use Multi-TP split below.")

// TP1 Settings (used in both modes)
tp1Pct = input.float(0.10, "TP1 %", minval=0.05, maxval=0.50, step=0.01, group=grp_tp,
    tooltip="Take profit level. In Single TP mode, exits 100% here.")

// Multi-TP Settings (greyed out when Single TP is ON)
tp1Weight = input.float(50, "TP1 Position %", minval=20, maxval=80, step=10, group=grp_tp,
    tooltip="Percentage to exit at TP1.", active=not useSingleTP)
tp2Pct = input.float(0.25, "TP2 %", minval=0.10, maxval=2.50, step=0.05, group=grp_tp,
    active=not useSingleTP)

// Runner Management (greyed out when Single TP is ON)
grp_runner = "Runner Management"
runnerMode = input.string("Adaptive (Time + Trail)", "Runner Mode After TP1", 
    options=["Fixed TP", "Breakeven", "Trailing", "Time Exit", "Adaptive (Time + Trail)"], group=grp_runner,
    tooltip="Time Exit: Hold to EOD. Adaptive: Trail after profit threshold.", active=not useSingleTP)
moveToBreakevenAfterTP1 = input.bool(true, "Move SL to Breakeven After TP1", group=grp_runner,
    active=not useSingleTP)
trailOffsetPct = input.float(0.25, "Trail Offset %", step=0.01, group=grp_runner,
    active=not useSingleTP)
trailActivationPct = input.float(0.50, "Trail Activation %", step=0.01, group=grp_runner,
    active=not useSingleTP)

// =============================================================================
// STOP LOSS & RISK MANAGEMENT
// =============================================================================
grp_risk = "Stop Loss & Risk"
slMode = input.string("Range Boundary", "Stop Loss Mode", 
    options=["Range Boundary", "Fixed %"], group=grp_risk)
slFixedPct = input.float(0.20, "Fixed SL % (if selected)", step=0.01, group=grp_risk)
useMAEFilter = input.bool(true, "Enable MAE Filter", group=grp_risk)
maeThreshold = input.float(0.15, "MAE % Threshold", step=0.01, group=grp_risk)
maeReference = input.string("Entry Price", "MAE Measure From", options=["Entry Price", "Range Boundary"], group=grp_risk)
riskPercent = input.float(1.0, "Risk per Trade %", minval=0.1, step=0.1, group=grp_risk)
minContracts = input.int(1, "Min Contracts", minval=1, group=grp_risk,
    tooltip="Force minimum contracts for Multi-TP runners.")
maxContracts = input.int(20, "Max Contracts", minval=1, group=grp_risk)


// --- Risk Management (Daily) ---
grp_daily_risk = "Daily Risk Limits"
useMaxDailyLoss = input.bool(true, "Enable Max Daily Loss", group=grp_daily_risk)
maxDailyLossUSD = input.float(200, "Max Daily Loss ($)", minval=10, step=10, group=grp_daily_risk)
dailyLossMode = input.string("Fixed", "Daily Loss Mode", options=["Fixed", "Trailing"], group=grp_daily_risk,
    tooltip="Fixed: Stops at Start Balance - Limit.\nTrailing: Stops at Daily High Equity - Limit.")
closeOnDailyLimit = input.bool(true, "Close Positions on Limit Hit", group=grp_daily_risk,
    tooltip="If TRUE, immediately closes active trades when limit is breached. If FALSE, just stops NEW trades.")

// --- Filters ---
grp_filters = "Filters"
useVVIX = input.bool(true, "Enable VVIX Filter", group=grp_filters)
vvixMax = input.float(108, "Max VVIX (Skip if above)", group=grp_filters)
maxRangePct = input.float(0.25, "Max Range % (Skip if larger)", step=0.01, group=grp_filters)
minRangePct = input.float(0.03, "Min Range % (Skip if smaller)", step=0.01, group=grp_filters)

// Day of Week Filters removed in V4 (never used, toxic windows provide better filtering)

// Time of Day Filters
skipLunchHour = input.bool(false, "Skip Lunch (11:30-13:00)", group=grp_filters)
skipAfternoon = input.bool(false, "Skip Afternoon (14:00+)", group=grp_filters)

// --- TOXIC TIME WINDOWS (COMMENTED OUT FOR NOW) ---
// Uncomment when ready to use - based on 6,170 trade analysis
// grp_toxic = "Toxic Time Windows"
// skip10amNews = input.bool(true, "Skip 10:00 AM News (09:55-10:05)", group=grp_toxic)
// skip1030News = input.bool(true, "Skip 10:30 AM News (10:25-10:35)", group=grp_toxic)
// skipLunchChop = input.bool(true, "Skip Lunch Chop (11:10-11:25)", group=grp_toxic)
// skip1pmNews = input.bool(false, "Skip 1:00 PM News (12:55-13:05)", group=grp_toxic)

// Brooksian Chop Filter (advanced chop detection)
grp_chop = "Brooksian Chop Filter"
useChopFilter = input.bool(false, "Enable Chop Filter", group=grp_chop,
    tooltip="Skip entries when market is chopping (sideways/indecisive)")
chopMode = input.string("Efficiency Ratio", "Chop Detection Method", 
    options=["EMA Glue", "Efficiency Ratio", "Body vs Range", "Alternating Colors"], group=grp_chop)
chopLookback = input.int(10, "Chop Lookback Period", minval=3, maxval=30, group=grp_chop,
    tooltip="Number of bars to analyze for chop detection")
chopEmaLen = input.int(20, "EMA Length (Glue Mode)", minval=5, maxval=50, group=grp_chop)
chopCrossThreshold = input.int(4, "Min EMA Crosses (Glue Mode)", minval=1, maxval=10, group=grp_chop,
    tooltip="How many EMA crosses in lookback = chop")
chopEffThreshold = input.float(0.40, "Efficiency Threshold (Ratio Mode)", minval=0.1, maxval=0.8, step=0.05, group=grp_chop,
    tooltip="Below this ratio = chopping (lower = stricter)")
chopBodyThreshold = input.float(0.45, "Max Body % (Body Mode)", minval=0.1, maxval=0.8, step=0.05, group=grp_chop,
    tooltip="If avg body < this % of avg range = chop")

// --- Visuals ---
grp_visual = "Visuals & Debug"
showDashboard = input.bool(true, "Show Dashboard", group=grp_visual)
showDebugLabels = input.bool(false, "Show Debug Labels", group=grp_visual)
showRangeBox = input.bool(true, "Show Range Box", group=grp_visual)
showLevels = input.bool(true, "Show TP/SL Levels", group=grp_visual)

// =============================================================================
// 2. DATA & CALCULATIONS
// =============================================================================

// --- External Data ---
vvix_open = request.security("CBOE:VVIX", "D", open)

// --- Time Checks ---
isORBar = not na(time(timeframe.period, sessionStart, "America/New_York"))
isTradingTime = not na(time(timeframe.period, tradingWindow, "America/New_York"))
isHardExit = not na(time(timeframe.period, hardExitTime, "America/New_York"))
isNewDay = ta.change(time("D")) != 0

// --- Daily Risk Tracking ---
var float dayStartEquity = 0.0
var float dayHighEquity = 0.0
var bool isDailyLossHit = false

if isNewDay
    dayStartEquity := strategy.equity
    dayHighEquity := strategy.equity
    isDailyLossHit := false

// Update High Water Mark (for Trailing Mode)
if strategy.equity > dayHighEquity
    dayHighEquity := strategy.equity

// Calculate Limit Level
float dailyLimitLevel = na
if dailyLossMode == "Fixed"
    dailyLimitLevel := dayStartEquity - maxDailyLossUSD
else // Trailing
    dailyLimitLevel := dayHighEquity - maxDailyLossUSD

// Check Breach
if useMaxDailyLoss and strategy.equity <= dailyLimitLevel
    isDailyLossHit := true
    if closeOnDailyLimit and strategy.position_size != 0
        strategy.close_all("Daily Loss Limit")


// Time of day checks
currentHour = hour(time, "America/New_York")
currentMinute = minute(time, "America/New_York")
isLunchHour = (currentHour == 11 and currentMinute >= 15) or (currentHour == 12)
isAfternoon = currentHour >= 14

// --- Toxic Time Windows (COMMENTED OUT FOR NOW) ---
// Uncomment when ready to use
// is10amNewsWindow = (currentHour == 9 and currentMinute >= 55) or (currentHour == 10 and currentMinute <= 5)
// is1030NewsWindow = (currentHour == 10 and currentMinute >= 25 and currentMinute <= 35)
// isLunchChopWindow = (currentHour == 11 and currentMinute >= 10 and currentMinute <= 25)
// is1pmNewsWindow = (currentHour == 12 and currentMinute >= 55) or (currentHour == 13 and currentMinute <= 5)

// Day of week logic removed in V4

// --- Range Calculation ---
var float rHigh = na
var float rLow = na
var bool rDefined = false

if isNewDay
    rHigh := na
    rLow := na
    rDefined := false

if isORBar and not rDefined
    rHigh := high
    rLow := low
    rDefined := true

rSize = rDefined ? rHigh - rLow : na
rMid = rDefined ? rLow + rSize / 2 : na
rPct = rDefined ? (rSize / close) * 100 : 0

// --- Calculated Levels ---
// Displacement: % of PRICE - e.g., 0.05% means entry must be 0.05% of price past boundary
displacementHigh = rDefined ? rHigh * (1 + minDisplacement / 100) : na
displacementLow = rDefined ? rLow * (1 - minDisplacement / 100) : na
maxPBLong = rDefined ? rHigh - (rSize * maxPullbackDepth / 100) : na
maxPBShort = rDefined ? rLow + (rSize * maxPullbackDepth / 100) : na
fallbackLongZone = rDefined ? rHigh * (1 + fallbackProximity / 100) : na
fallbackShortZone = rDefined ? rLow * (1 - fallbackProximity / 100) : na

// --- Candle Shape Logic (Doji filter removed in V4) ---
candleRange = high - low
bodySize = math.abs(close - open)
bodyPct = (candleRange > 0) ? (bodySize / candleRange) * 100 : 0
// isDoji removed - was: isDoji = bodyPct < minBodyPct

// =============================================================================
// 3. FILTER LOGIC
// =============================================================================

// Time filter (toxic windows commented out for now)
// isToxicFiltered = (skip10amNews and is10amNewsWindow) or (skip1030News and is1030NewsWindow) or 
//                    (skipLunchChop and isLunchChopWindow) or (skip1pmNews and is1pmNewsWindow)
isTimeFiltered = (skipLunchHour and isLunchHour) or (skipAfternoon and isAfternoon)

// Range filter
isRangeFiltered = rPct > maxRangePct or rPct < minRangePct

// VVIX filter
isVVIXFiltered = useVVIX and nz(vvix_open, 0) > vvixMax

// --- Brooksian Chop Filter Logic ---
// METHOD 1: EMA GLUE (Counting Crosses)
chopEma = ta.ema(close, chopEmaLen)
chopCrossUp = ta.crossover(close, chopEma)
chopCrossDown = ta.crossunder(close, chopEma)
int recentCrosses = 0
for i = 0 to chopLookback - 1
    if chopCrossUp[i] or chopCrossDown[i]
        recentCrosses += 1
isChop_EMA = recentCrosses >= chopCrossThreshold

// METHOD 2: EFFICIENCY RATIO (Displacement vs Path)
float pathLength = math.sum(high - low, chopLookback)
float displacement = math.abs(close - close[chopLookback])
float effRatio = pathLength != 0 ? displacement / pathLength : 1.0
isChop_Eff = effRatio < chopEffThreshold

// METHOD 3: BODY VS RANGE (Doji Detector - lookback version)
float avgBodyChop = ta.sma(math.abs(close - open), chopLookback)
float avgRangeChop = ta.sma(high - low, chopLookback)
float bodyRatioChop = avgRangeChop != 0 ? avgBodyChop / avgRangeChop : 1.0
isChop_Body = bodyRatioChop < chopBodyThreshold

// METHOD 4: ALTERNATING COLORS
int colorFlips = 0
for i = 0 to chopLookback - 1
    bool isGreen = close[i] > open[i]
    bool prevGreen = close[i+1] > open[i+1]
    if isGreen != prevGreen
        colorFlips += 1
isChop_Color = colorFlips >= (chopLookback * 0.6)

// Master Chop Switch
bool isChopDetected = switch chopMode
    "EMA Glue" => isChop_EMA
    "Efficiency Ratio" => isChop_Eff
    "Body vs Range" => isChop_Body
    "Alternating Colors" => isChop_Color
    => false

isChopFiltered = useChopFilter and isChopDetected

// Combined filter (V4: Doji removed, Toxic windows commented out)
isFiltered = isTimeFiltered or isRangeFiltered or isVVIXFiltered or isChopFiltered

// =============================================================================
// 4. STATE TRACKING
// =============================================================================

var int attempts = 0
var int longAttempts = 0
var int shortAttempts = 0
var bool hasWonToday = false
var bool longPending = false
var bool shortPending = false
var int breakoutBar = na
var float sigCandleExtreme = na
var bool enteredViaFallback = false
var int lastExitBar = na
// longTakenToday/shortTakenToday removed (were for One Per Direction)
var bool priceReturnedToRange = true
var int currentAttempt = 0
var string currentEntryType = ""
var bool isFreshBreakout = true

// Multi-TP State
var bool tp1Hit = false
var bool tp2Hit = false
var float tradeEntryPrice = na
var float currentTrailStop = na
var bool isRunnerActive = false
var bool adaptiveTrailActivated = false // New for V3

// Reset on new day
if isNewDay
    attempts := 0
    longAttempts := 0
    shortAttempts := 0
    hasWonToday := false
    longPending := false
    shortPending := false
    breakoutBar := na
    sigCandleExtreme := na
    enteredViaFallback := false
    lastExitBar := na
    priceReturnedToRange := true
    currentAttempt := 0
    currentEntryType := ""
    isFreshBreakout := true
    tp1Hit := false
    tp2Hit := false
    tradeEntryPrice := na
    currentTrailStop := na
    isRunnerActive := false
    adaptiveTrailActivated := false

// Track if price returns to range (for fresh breakout logic)
if rDefined and not (strategy.position_size != 0)
    if close >= rLow and close <= rHigh
        priceReturnedToRange := true

// =============================================================================
// 5. ENTRY LOGIC
// =============================================================================

inTrade = strategy.position_size != 0

// Cooldown check
cooldownComplete = na(lastExitBar) or (bar_index - lastExitBar) >= cooldownBars

// Re-entry eligibility based on mode (V4: One Per Direction removed)
reentryEligible = switch reentryMode
    "Immediate" => true
    "Fresh Only" => priceReturnedToRange
    => true

// Direction eligibility (V4: simplified - always enabled)
canTakeLong = true
canTakeShort = true

// Overall trade eligibility
canTrade = rDefined and isTradingTime and not isHardExit and not inTrade and 
           attempts < maxAttempts and not isFiltered and cooldownComplete and
           reentryEligible and not (stopAfterWin and hasWonToday) and 
           not isDailyLossHit

// Breakout detection - use displacement level for entry trigger when enabled
breakoutLong = minDisplacement > 0 ? ta.crossover(close, displacementHigh) : ta.crossover(close, rHigh)
breakoutShort = minDisplacement > 0 ? ta.crossunder(close, displacementLow) : ta.crossunder(close, rLow)

// Displacement validation (for pullback modes)
hasDisplacementLong = close >= displacementHigh
hasDisplacementShort = close <= displacementLow

// Position sizing - for Multi-TP we need base contracts
calcBaseQty() =>
    qtyRisk = math.floor((strategy.equity * riskPercent / 100) / (rSize * syminfo.pointvalue))
    qtyFloored = math.max(minContracts, qtyRisk)
    math.min(maxContracts, qtyFloored)

// Generate trade comment for Excel analysis
getTradeComment(isLong, attemptNum, entryType, fresh) =>
    dir = isLong ? "L" : "S"
    hr = str.tostring(currentHour)
    if currentHour < 10
        hr := "0" + hr
    ent = switch entryType
        "Immediate" => "IM"
        "Pullback" => "PB"
        "Fallback" => "FB"
        => "IM"
    fr = fresh ? "FR" : "RE"
    mtp = useSingleTP ? "" : "-MTP"
    dir + str.tostring(attemptNum) + "-" + hr + "-" + ent + "-" + fr + mtp

// =============================================================================
// ENTRY EXECUTION
// =============================================================================

if canTrade
    // IMMEDIATE MODE
    if entryMode == "Immediate"
        // Displacement is built into breakoutLong/Short detection (set minDisplacement=0 to disable)
        if breakoutLong and canTakeLong
            attempts += 1
            longAttempts += 1
            currentAttempt := attempts
            currentEntryType := "Immediate"
            isFreshBreakout := priceReturnedToRange
            comment = getTradeComment(true, attempts, "Immediate", priceReturnedToRange)
            
            baseQty = calcBaseQty()
            strategy.entry("Long", strategy.long, qty=baseQty, comment=comment)
            
            tradeEntryPrice := close
            tp1Hit := false
            tp2Hit := false
            isRunnerActive := false
            currentTrailStop := na
            adaptiveTrailActivated := false
            sigCandleExtreme := low
            priceReturnedToRange := false
            enteredViaFallback := false
            
        else if breakoutShort and canTakeShort
            attempts += 1
            shortAttempts += 1
            currentAttempt := attempts
            currentEntryType := "Immediate"
            isFreshBreakout := priceReturnedToRange
            comment = getTradeComment(false, attempts, "Immediate", priceReturnedToRange)
            
            baseQty = calcBaseQty()
            strategy.entry("Short", strategy.short, qty=baseQty, comment=comment)
            
            tradeEntryPrice := close
            tp1Hit := false
            tp2Hit := false
            isRunnerActive := false
            currentTrailStop := na
            adaptiveTrailActivated := false
            sigCandleExtreme := high
            priceReturnedToRange := false
            enteredViaFallback := false

    // PULLBACK MODES
    else
        // ARM PULLBACK ON VALID BREAKOUT
        if not longPending and not shortPending
            if breakoutLong and hasDisplacementLong and canTakeLong
                longPending := true
                sigCandleExtreme := low
                breakoutBar := bar_index
                isFreshBreakout := priceReturnedToRange
                
            else if breakoutShort and hasDisplacementShort and canTakeShort
                shortPending := true
                sigCandleExtreme := high
                breakoutBar := bar_index
                isFreshBreakout := priceReturnedToRange
        
        // MANAGE PENDING LONG
        if longPending and bar_index > breakoutBar
            barsSinceBreakout = bar_index - breakoutBar
            timeoutReached = barsSinceBreakout >= pbTimeoutBars
            useFallback = entryMode == "Pullback + Fallback"
            
            if close < maxPBLong
                longPending := false
                breakoutBar := na
            else if low <= rHigh and close >= maxPBLong
                attempts += 1
                longAttempts += 1
                currentAttempt := attempts
                currentEntryType := "Pullback"
                comment = getTradeComment(true, attempts, "Pullback", isFreshBreakout)
                baseQty = calcBaseQty()
                strategy.entry("Long", strategy.long, qty=baseQty, comment=comment)
                tradeEntryPrice := close
                tp1Hit := false
                tp2Hit := false
                isRunnerActive := false
                adaptiveTrailActivated := false
                longPending := false
                breakoutBar := na
                priceReturnedToRange := false
                enteredViaFallback := false
            else if useFallback and timeoutReached
                if close <= fallbackLongZone and close > rHigh
                    attempts += 1
                    longAttempts += 1
                    currentAttempt := attempts
                    currentEntryType := "Fallback"
                    comment = getTradeComment(true, attempts, "Fallback", isFreshBreakout)
                    baseQty = calcBaseQty()
                    strategy.entry("Long", strategy.long, qty=baseQty, comment=comment)
                    tradeEntryPrice := close
                    tp1Hit := false
                    tp2Hit := false
                    isRunnerActive := false
                    adaptiveTrailActivated := false
                    longPending := false
                    breakoutBar := na
                    priceReturnedToRange := false
                    enteredViaFallback := true
                else
                    longPending := false
                    breakoutBar := na
            else if close < rLow
                longPending := false
                breakoutBar := na
        
        // MANAGE PENDING SHORT
        if shortPending and bar_index > breakoutBar
            barsSinceBreakout = bar_index - breakoutBar
            timeoutReached = barsSinceBreakout >= pbTimeoutBars
            useFallback = entryMode == "Pullback + Fallback"
            
            if close > maxPBShort
                shortPending := false
                breakoutBar := na
            else if high >= rLow and close <= maxPBShort
                attempts += 1
                shortAttempts += 1
                currentAttempt := attempts
                currentEntryType := "Pullback"
                comment = getTradeComment(false, attempts, "Pullback", isFreshBreakout)
                baseQty = calcBaseQty()
                strategy.entry("Short", strategy.short, qty=baseQty, comment=comment)
                tradeEntryPrice := close
                tp1Hit := false
                tp2Hit := false
                isRunnerActive := false
                adaptiveTrailActivated := false
                shortPending := false
                breakoutBar := na
                priceReturnedToRange := false
                enteredViaFallback := false
            else if useFallback and timeoutReached
                if close >= fallbackShortZone and close < rLow
                    attempts += 1
                    shortAttempts += 1
                    currentAttempt := attempts
                    currentEntryType := "Fallback"
                    comment = getTradeComment(false, attempts, "Fallback", isFreshBreakout)
                    baseQty = calcBaseQty()
                    strategy.entry("Short", strategy.short, qty=baseQty, comment=comment)
                    tradeEntryPrice := close
                    tp1Hit := false
                    tp2Hit := false
                    isRunnerActive := false
                    adaptiveTrailActivated := false
                    shortPending := false
                    breakoutBar := na
                    priceReturnedToRange := false
                    enteredViaFallback := true
                else
                    shortPending := false
                    breakoutBar := na
            else if close > rHigh
                shortPending := false
                breakoutBar := na

// Cleanup pending when can't trade
if not canTrade and not inTrade
    strategy.cancel_all()
    longPending := false
    shortPending := false

// =============================================================================
// 6. EXIT LOGIC - MULTI-TP
// =============================================================================

var int prevClosedTrades = 0
if isNewDay
    prevClosedTrades := strategy.closedtrades

// Track wins
if strategy.closedtrades > prevClosedTrades
    lastTradeProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastTradeProfit > 0
        hasWonToday := true
    lastExitBar := bar_index
    prevClosedTrades := strategy.closedtrades

// Exit management
if inTrade
    entryPrice = strategy.opentrades.entry_price(0)
    isLong = strategy.position_size > 0
    posSize = math.abs(strategy.position_size)
    
    // Calculate base SL
    baseSL = switch slMode
        "Range Boundary" => isLong ? rLow : rHigh
        "Fixed %" => isLong ? entryPrice * (1 - slFixedPct/100) : entryPrice * (1 + slFixedPct/100)
        => isLong ? rLow : rHigh
    
    if useSingleTP
        // =================================================================
        // SINGLE TP MODE - Exit 100% at TP1 level
        // =================================================================
        float tpPrice = isLong ? entryPrice * (1 + tp1Pct/100) : entryPrice * (1 - tp1Pct/100)
        float slTicksSingle = math.abs(entryPrice - baseSL) / syminfo.mintick
        float tpTicksSingle = math.abs(tpPrice - entryPrice) / syminfo.mintick
        strategy.exit("Exit", profit=tpTicksSingle, loss=slTicksSingle)
    
    else
        // =================================================================
        // MULTI-TP MODE - Split position at TP1/TP2 with runner
        // =================================================================
        
        // Calculate TP levels
        float tp1Price = isLong ? entryPrice * (1 + tp1Pct/100) : entryPrice * (1 - tp1Pct/100)
        float tp2Price = isLong ? entryPrice * (1 + tp2Pct/100) : entryPrice * (1 - tp2Pct/100)
        
        // Calculate quantities for each TP
        int tp1Qty = math.max(1, int(math.floor(posSize * tp1Weight / 100)))
        int remainingAfterTP1 = int(posSize) - tp1Qty
        
        // Current SL (may be moved to breakeven)
        float currentSL = baseSL
        if tp1Hit and moveToBreakevenAfterTP1
            currentSL := entryPrice
        
        // TP1 Exit
        if not tp1Hit and tp1Qty > 0
            float tp1Ticks = math.abs(tp1Price - entryPrice) / syminfo.mintick
            float slTicks1 = math.abs(entryPrice - baseSL) / syminfo.mintick
            strategy.exit("TP1", qty=tp1Qty, profit=tp1Ticks, loss=slTicks1)
        
        // Check if TP1 was hit (price crossed TP1 level)
        if not tp1Hit
            if (isLong and high >= tp1Price) or (not isLong and low <= tp1Price)
                tp1Hit := true
                isRunnerActive := true
                // Initialize trailing stop if using that mode
                if runnerMode == "Trailing"
                    currentTrailStop := isLong ? high - (entryPrice * trailOffsetPct / 100) : low + (entryPrice * trailOffsetPct / 100)
        
        // Manage runner after TP1 hit
        if tp1Hit and remainingAfterTP1 > 0
            // Calculate new SL for runner
            float runnerSL = currentSL
            
            // --- TRAILING LOGIC ---
            if runnerMode == "Trailing"
                if isLong
                    float newTrailStop = high - (entryPrice * trailOffsetPct / 100)
                    if na(currentTrailStop) or newTrailStop > currentTrailStop
                        currentTrailStop := newTrailStop
                    runnerSL := currentTrailStop
                else
                    float newTrailStop = low + (entryPrice * trailOffsetPct / 100)
                    if na(currentTrailStop) or newTrailStop < currentTrailStop
                        currentTrailStop := newTrailStop
                    runnerSL := currentTrailStop
            
            else if runnerMode == "Adaptive (Time + Trail)"
                float activationPrice = isLong ? entryPrice * (1 + trailActivationPct/100) : entryPrice * (1 - trailActivationPct/100)
                bool isActivated = isLong ? high >= activationPrice : low <= activationPrice
                
                if isActivated
                    adaptiveTrailActivated := true
                
                if adaptiveTrailActivated
                    if isLong
                        float newTrailStop = high - (entryPrice * trailOffsetPct / 100)
                        if na(currentTrailStop) or newTrailStop > currentTrailStop
                            currentTrailStop := newTrailStop
                        runnerSL := math.max(runnerSL, currentTrailStop)
                    else
                        float newTrailStop = low + (entryPrice * trailOffsetPct / 100)
                        if na(currentTrailStop) or newTrailStop < currentTrailStop
                            currentTrailStop := newTrailStop
                        runnerSL := math.min(runnerSL, currentTrailStop)

            else if runnerMode == "Breakeven" and moveToBreakevenAfterTP1
                runnerSL := entryPrice
            
            // --- END TRAILING LOGIC ---

            // TP2 Exit (runner takes remaining to TP2 or uses trailing SL)
            if not tp2Hit and remainingAfterTP1 > 0
                if runnerMode == "Time Exit" or runnerMode == "Adaptive (Time + Trail)"
                    // Just use SL (BE or Trailing) - let it ride to time exit
                    float slTicksR = math.abs(entryPrice - runnerSL) / syminfo.mintick
                    strategy.exit("Runner-SL", qty=remainingAfterTP1, loss=slTicksR)
                else
                    // Use TP2 as profit target
                    float tp2Ticks = math.abs(tp2Price - entryPrice) / syminfo.mintick
                    float slTicks2 = math.abs(entryPrice - runnerSL) / syminfo.mintick
                    strategy.exit("TP2", qty=remainingAfterTP1, profit=tp2Ticks, loss=slTicks2)
            
            // Check if TP2 was hit
            if not tp2Hit
                if (isLong and high >= tp2Price) or (not isLong and low <= tp2Price)
                    tp2Hit := true
    
    // MAE Filter (applies to all modes) - V4: uses maeReference setting correctly
    if useMAEFilter
        // Determine reference point: Entry Price or Range Boundary
        float maeRefLong = maeReference == "Range Boundary" ? rHigh : entryPrice
        float maeRefShort = maeReference == "Range Boundary" ? rLow : entryPrice
        float heatDistanceLong = maeRefLong * (maeThreshold / 100)
        float heatDistanceShort = maeRefShort * (maeThreshold / 100)
        
        if (isLong and low < maeRefLong - heatDistanceLong) or (not isLong and high > maeRefShort + heatDistanceShort)
            strategy.close_all("MAE Exit")

// Hard exit (Time Exit)
if inTrade and isHardExit
    strategy.close_all("Time Exit")

// =============================================================================
// 7. VISUALS
// =============================================================================

// --- Range Box ---
var box orbBox = na
if showRangeBox
    if isORBar and rDefined
        boxColor = isRangeFiltered ? color.new(color.red, 85) : color.new(color.blue, 90)
        // Use TIME coordinates (xloc.bar_time) to anchor firmly to the chart
        // Duration: 60 minutes * 60 seconds * 1000 ms = 3,600,000 ms
        int boxDuration = 5* 60 * 60 * 1000 
        orbBox := box.new(time, rHigh, time + boxDuration, rLow, xloc=xloc.bar_time, bgcolor=boxColor, border_color=color.blue)
    
    // Dynamic update removed to prevent "Stuck" glitch
    // if rDefined and not na(orbBox)
    //    box.set_right(orbBox, bar_index + 10)


// --- Range Lines (Removed by User Request) ---
// plot(rDefined ? rHigh : na, "Range High", color=color.new(color.blue, 50), linewidth=2)
// plot(rDefined ? rLow : na, "Range Low", color=color.new(color.blue, 50), linewidth=2)
// plot(rDefined ? rMid : na, "Range Mid", color=color.new(color.gray, 70), style=plot.style_linebr)

// --- Active Trade Levels ---
var float activeTP1 = na
var float activeTP2 = na
var float activeTP3 = na
var float activeSL = na

if inTrade
    entryPrice = strategy.opentrades.entry_price(0)
    isLong = strategy.position_size > 0
    
    activeTP1 := isLong ? entryPrice * (1 + tp1Pct/100) : entryPrice * (1 - tp1Pct/100)
    if not useSingleTP
        activeTP2 := isLong ? entryPrice * (1 + tp2Pct/100) : entryPrice * (1 - tp2Pct/100)
    else
        activeTP2 := na
    activeTP3 := na  // TP3 removed in V4
    
    activeSL := switch slMode
        "Range Boundary" => isLong ? rLow : rHigh
        "Fixed %" => isLong ? entryPrice * (1 - slFixedPct/100) : entryPrice * (1 + slFixedPct/100)
        => isLong ? rLow : rHigh
    
    // Show BE level if TP1 hit
    if tp1Hit and moveToBreakevenAfterTP1
        activeSL := entryPrice
else
    activeTP1 := na
    activeTP2 := na
    activeTP3 := na
    activeSL := na

plot(showLevels and inTrade ? activeTP1 : na, "TP1 Level", color=color.green, linewidth=2, style=plot.style_linebr)
plot(showLevels and inTrade and not useSingleTP ? activeTP2 : na, "TP2 Level", color=color.lime, linewidth=1, style=plot.style_linebr)
// TP3 plot removed in V4
plot(showLevels and inTrade ? activeSL : na, "SL Level", color=color.red, linewidth=2, style=plot.style_linebr)

// --- Bar Coloring ---
barcolor(isORBar ? color.yellow : na)

// =============================================================================
// 8. DASHBOARD
// =============================================================================

if showDashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 20, bgcolor=color.new(color.black, 20), 
                               border_width=1, border_color=color.gray)
    
    // Header
    table.cell(dash, 0, 0, "ALL-DAY ORB V4", text_color=color.white, text_size=size.normal, bgcolor=color.blue)
    table.cell(dash, 1, 0, "SIMPLIFIED", text_color=color.white, text_size=size.normal, bgcolor=color.purple)
    
    // Range Info
    table.cell(dash, 0, 1, "Range", text_color=color.white)
    rangeText = rDefined ? str.tostring(rSize, "#.##") + " pts (" + str.tostring(rPct, "#.##") + "%)" : "Not Set"
    rangeColor = isRangeFiltered ? color.red : color.green
    table.cell(dash, 1, 1, rangeText, text_color=rangeColor)
    
    // VVIX
    table.cell(dash, 0, 2, "VVIX", text_color=color.white)
    vvixColor = isVVIXFiltered ? color.red : color.green
    table.cell(dash, 1, 2, str.tostring(vvix_open, "#.#"), text_color=vvixColor)
    
    // Attempts
    table.cell(dash, 0, 3, "Attempts", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(attempts) + "/" + str.tostring(maxAttempts) + 
               " (L:" + str.tostring(longAttempts) + " S:" + str.tostring(shortAttempts) + ")", 
               text_color=attempts >= maxAttempts ? color.orange : color.white)
    
    // TP Mode Status
    table.cell(dash, 0, 4, "TP Mode", text_color=color.white)
    if useSingleTP
        table.cell(dash, 1, 4, "Single TP", text_color=color.white)
    else
        table.cell(dash, 1, 4, "Multi-TP", text_color=color.lime)
    
    // TP1 Hit Status
    table.cell(dash, 0, 5, "TP1 Hit", text_color=color.white)
    table.cell(dash, 1, 5, tp1Hit ? "YES ✓" : "NO", text_color=tp1Hit ? color.lime : color.gray)
    
    // Runner Status
    table.cell(dash, 0, 6, "Runner Mode", text_color=color.white)
    table.cell(dash, 1, 6, runnerMode, text_color=color.aqua)
    
    // Adaptive Status
    table.cell(dash, 0, 7, "Trail Active", text_color=color.white)
    table.cell(dash, 1, 7, adaptiveTrailActivated ? "ACTIVE" : "WAITING", text_color=adaptiveTrailActivated ? color.yellow : color.gray)
    
    // Status
    table.cell(dash, 0, 8, "Status", text_color=color.white)
    statusText = hasWonToday and stopAfterWin ? "WON - DONE" : 
                 inTrade ? "IN TRADE #" + str.tostring(currentAttempt) :
                 longPending ? "PENDING LONG" :
                 shortPending ? "PENDING SHORT" :
                 isFiltered ? "FILTERED" :
                 attempts >= maxAttempts ? "MAX ATTEMPTS" :
                 canTrade ? "READY" : "WAITING"
    statusColor = hasWonToday ? color.lime : inTrade ? color.aqua : 
                  (longPending or shortPending) ? color.yellow :
                  isFiltered ? color.red : canTrade ? color.green : color.gray
    table.cell(dash, 1, 8, statusText, text_color=statusColor)
    
    // Entry Mode
    table.cell(dash, 0, 9, "Entry Mode", text_color=color.white)
    table.cell(dash, 1, 9, entryMode, text_color=color.aqua)
    
    // Re-entry Mode
    table.cell(dash, 0, 10, "Re-entry", text_color=color.white)
    table.cell(dash, 1, 10, reentryMode, text_color=color.white)
    
    // Fresh Breakout Status
    table.cell(dash, 0, 11, "Fresh BO", text_color=color.white)
    table.cell(dash, 1, 11, priceReturnedToRange ? "YES" : "NO", 
               text_color=priceReturnedToRange ? color.green : color.orange)
    
    // MAE Filter
    table.cell(dash, 0, 12, "MAE Filter", text_color=color.white)
    maeText = useMAEFilter ? str.tostring(maeThreshold, "#.##") + "% (" + (maeReference == "Entry Price" ? "Entry" : "Range") + ")" : "OFF"
    table.cell(dash, 1, 12, maeText, text_color=useMAEFilter ? color.yellow : color.gray)
    
    // Time
    table.cell(dash, 0, 13, "Time", text_color=color.white)
    hourColor = isLunchHour ? color.orange : isAfternoon ? color.yellow : color.green
    table.cell(dash, 1, 13, str.tostring(currentHour) + ":" + (currentMinute < 10 ? "0" : "") + str.tostring(currentMinute), 
               text_color=hourColor)
    
    // Day (V4: simplified - just show day name)
    table.cell(dash, 0, 14, "Day", text_color=color.white)
    dayText = dayofweek == dayofweek.monday ? "MON" : dayofweek == dayofweek.tuesday ? "TUE" : 
              dayofweek == dayofweek.wednesday ? "WED" : dayofweek == dayofweek.thursday ? "THU" : 
              dayofweek == dayofweek.friday ? "FRI" : "?"
    table.cell(dash, 1, 14, dayText, text_color=color.white)

    // MAE/MFE Stats
    table.cell(dash, 0, 15, "Daily P&L", text_color=color.white)
    float dailyPnL = strategy.equity - dayStartEquity
    color pnlColor = dailyPnL > 0 ? color.green : dailyPnL < -maxDailyLossUSD*0.8 ? color.orange : color.red
    if dailyPnL < 0 
        pnlColor := color.red
    
    table.cell(dash, 1, 15, str.tostring(dailyPnL, format.mintick) + " (" + (isDailyLossHit ? "HALTED" : "Active") + ")", 
               text_color=isDailyLossHit ? color.red : (dailyPnL >= 0 ? color.green : color.orange))

    // Daily Limit Level
    table.cell(dash, 0, 16, "Risk Limit", text_color=color.white)
    table.cell(dash, 1, 16, str.tostring(dailyLimitLevel, "#.##"), text_color=color.gray)

    // Position Info
    table.cell(dash, 0, 17, "Position", text_color=color.white)
    if strategy.position_size != 0
        float avgPrice = strategy.position_avg_price
        float openPL = (close - avgPrice) * strategy.position_size * syminfo.pointvalue
        table.cell(dash, 1, 17, str.tostring(strategy.position_size) + " @ " + str.tostring(avgPrice, "#.##") + 
                   " (" + str.tostring(openPL, "#.##") + ")", text_color=openPL >= 0 ? color.lime : color.red)
    else
        table.cell(dash, 1, 17, "FLAT", text_color=color.gray)
    
    // Filters (V4: Doji removed, Toxic commented out)
    table.cell(dash, 0, 18, "Filters", text_color=color.white)
    filterList = ""
    if isTimeFiltered
        filterList += "TIME "
    if isVVIXFiltered
        filterList += "VVIX "
    if isRangeFiltered
        filterList += "RANGE "
    if isChopFiltered
        filterList += "CHOP "
    if filterList == ""
        filterList := "NONE"
    table.cell(dash, 1, 18, filterList, text_color=isFiltered ? color.red : color.green)

// =============================================================================
// 9. DEBUG LABELS
// =============================================================================

if showDebugLabels and inTrade
    debugText = "Entry: $" + str.tostring(tradeEntryPrice, "#.##") + "\n" +
                 "TP1 Hit: " + str.tostring(tp1Hit) + "\n" +
                 "Runner: " + str.tostring(isRunnerActive) + "\n" +
                 "Mode: " + runnerMode + "\n" +
                 "Trail Active: " + str.tostring(adaptiveTrailActivated) + "\n" +
                 "Trail SL: " + str.tostring(currentTrailStop, "#.##")
    label.new(bar_index, high, debugText, color=color.black, textcolor=color.white, 
              size=size.small, yloc=yloc.abovebar)

// =============================================================================
// 10. PLOTS FOR DATA WINDOW
// =============================================================================

plot(attempts, "Attempts Today", display=display.data_window)
plot(currentHour, "Entry Hour", display=display.data_window)
plot(tp1Hit ? 1 : 0, "TP1 Hit", display=display.data_window)
plot(isRunnerActive ? 1 : 0, "Runner Active", display=display.data_window)
