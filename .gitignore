# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.agent/scratch/
.agent/skills_backup/
.agents/
.agents
logs/*.log
web/logs/
**/tsbuildinfo

# Rust build artifacts
target/
crates/**/target/
*.pyd
# Rust crate source exceptions: the daemon's embedded widget HTML is source, not
# output; and crates/*/src/bin/ is source that the bare `bin/` rule would swallow.
!crates/trading_daemon/assets/widget.html
!crates/*/src/bin/**

# agent-loop --mode docs output. Model artifacts, regenerated on demand; not
# source, and not to be reviewed as if a human wrote them.
docs/generated/

# agent-loop run artifacts: raw model output, patches, worktrees left by a
# crashed run. `logs/*.log` does not cover these per-ticket directories.
# NOTE the `/*` rather than `/`: git never descends into an excluded DIRECTORY,
# so a negation under `logs/agent_loop/` is silently impossible. `/*` excludes
# the contents while still allowing the exception below.
logs/agent_loop/*
# The outcomes ledger IS tracked, deliberately: it is the cross-machine run
# history, not an artifact. Before this it sat tracked INSIDE an ignored
# directory, so every run left it dirty and `git add` refused it without -f.
!logs/agent_loop/ledger.jsonl

# Data
downloads_es_futures/
/data/
backup/
old_data/
debug_files/
*.csv
*.parquet

# ...but the NT8 ground-truth trade lists are EVIDENCE, not data. Their
# .meta.json was already tracked while the CSV it describes was not -- a
# versioned pointer to an unversioned file. STRATEGY_WORKFLOW.md section 5.4
# requires the trade list to be committed for a pinned range and profile;
# the blanket rule above is what made that impossible.
!scripts/parity/fixtures/nt8_trades_*.csv
# Explicitly exclude generated Phase 1 daily_context parquet files (regenerated locally)
/data/derived/daily_context_*.parquet
**/data/*.parquet
!web/components/data/
!docs/data/
web/public/data/
# Source modules living under data/ subdirs must NOT be gitignored
# (the bare `data/` pattern above matched scripts/libs_py/data/ too)
!scripts/libs_py/data/
!scripts/libs_py/data/**

# Chrome
chrome_profile/
tradingview-selenium-data/

# IDE
.vscode/
.idea/

# Logs
*.log
*.txt
!requirements.txt
!gaps_report.txt
*.png
!docs/nqstats/**/*.png
*.html
bin/
obj/
*.exe
*.dll
args.json

# Rust crate source exceptions: the daemon's embedded widget HTML is source, not
# output; crates/*/src/bin/ is source the bare bin/ rule would swallow. Negations
# must sit AFTER the broad rules they override.
!crates/trading_daemon/assets/widget.html
!crates/broker_sentinel/src/bin/
!crates/broker_sentinel/src/bin/**

# Credentials & Secrets (STRICT EXCLUSION)
secrets.json
secrets.enc
*.enc
*.key
tokens.db
token.json
*gdrive*.json
*service_account*.json
client_secret*.json
credentials.json
c7.json
discord_webhooks.json

.notebooklm-mcp-cli/
*.notebooklm-mcp*


# Output directories (not source -- regenerated by scripts)
tmp/
results/
reports/
scratch/
notebooks/
processed/

# Exception: source code under scripts/trading_brain/reports/ is tracked
!scripts/trading_brain/reports/
!scripts/trading_brain/reports/**

# Ignore dynamic runtime state files
scripts/libs_py/strategy_engine/scheduler_state.json
tradingview-mcp/

# MCP config contains local tokens -- do not commit
.mcp.json

# Databases & SQLite runtime sidecars (never commit binary DB state)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.agent/memory.db
mcp/memory.db
optuna_research.db
scripts/trading_framework/research.db
scripts/trading_framework/research_optuna.db

# Standalone MCP repositories
.tos_web_profile/

.env

# Media / audio (transcript source files -- keep transcripts, not the audio)
*.m4a
*.mp3
*.mp4
*.wav
*.webm
*.mkv
*.mov
*.flac
*.ogg
# Python bytecode caches - appended LAST so this rule overrides any earlier
# negation (e.g. '!scripts/trading_brain/reports/**') that re-includes package dirs.
**/__pycache__/
*.py[cod]

# single-source: junction to nt8-riskguard repo (strategies/Vinay) -- content lives there
scripts/ninjatrader/strategies/base/
