// Indicator: Intelligent Balance Probability Map+ [Herman]
// Version: 6.0

//@version=6
indicator("Intelligent Balance Probability Map+ [Herman]", overlay=true, 
  max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ══════════════════════════════════════════════
// ══ UDT DEFINITIONS
// ══════════════════════════════════════════════

type IBSession
    int     startBar
    int     endBar
    int     startTime
    int     endTime
    float   ibHigh
    float   ibLow
    float   ibOpen
    float   ibClose
    float   ibVwap
    int     confScore
    int     maxConf
    string  biasStr
    int     biasPct
    float   targetUp
    float   targetDn
    box     ibBox
    label   confLabel
    line    targetUpLine
    line    targetDnLine
    box     targetUpBox
    box     targetDnBox
    label   targetUpLabel
    label   targetDnLabel

// ══════════════════════════════════════════════
// ══ INPUTS & PARAMETERS
// ══════════════════════════════════════════════

// ── Session & IB Settings ──
GRP_SESS       = "Session & Initial Balance (IB)"
i_ibSession    = input.session("2100-2200", "IB Time Window", group=GRP_SESS, tooltip="Session range used for Initial Balance calculation (e.g. 2100-2200 or 0700-0800 ET)")
i_timezone     = input.string("America/New_York", "Timezone", group=GRP_SESS)
i_targetPts    = input.float(30.0, "Target Extension (Points)", minval=1.0, group=GRP_SESS, tooltip="Projected extension target beyond IB High/Low")

// ── Confluence Weights ──
GRP_CONF       = "Confluence Weights"
i_emaTF        = input.timeframe("15", "Trend Filter Timeframe", group=GRP_CONF)
i_emaLen       = input.int(50, "Trend Filter EMA Length", group=GRP_CONF)
i_minEdgePct   = input.int(70, "Edge Mode Minimum Threshold (%)", minval=50, maxval=100, group=GRP_CONF)

// ── Display & HUD Table ──
GRP_DISP       = "Display & Table Options"
i_showTable    = input.bool(true, "Show HUD Table", group=GRP_DISP)
i_tablePos     = input.string("Top Right", "Table Position", options=["Top Left","Top Right","Bottom Left","Bottom Right","Middle Left","Middle Right"], group=GRP_DISP)
i_tableSize    = input.string("normal", "Table Text Size", options=["tiny","small","normal","large"], group=GRP_DISP)
i_textFont     = input.string("Monospace", "Text Font", options=["Monospace", "Default"], group=GRP_DISP)
i_theme        = input.string("Dark", "Color Theme", options=["Dark", "Light"], group=GRP_DISP)

// ── Colors ──
GRP_COL        = "Colors"
i_bullCol      = input.color(#00c853, "Bullish Color", group=GRP_COL)
i_bearCol      = input.color(#ff1744, "Bearish Color", group=GRP_COL)
i_ibFillCol    = input.color(color.new(#0288d1, 85), "IB Box Fill Color", group=GRP_COL)
i_ibBorderCol  = input.color(color.new(#0288d1, 30), "IB Box Border Color", group=GRP_COL)

// ══════════════════════════════════════════════
// ══ HELPER FUNCTIONS
// ══════════════════════════════════════════════

f_font(string f) => f == "Monospace" ? font.family_monospace : font.family_default

f_tablePos(string p) =>
    switch p
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Left"  => position.middle_left
        => position.middle_right

f_textSize(string s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        => size.large

// ══════════════════════════════════════════════
// ══ HTF & INDICATOR CALCULATIONS
// ══════════════════════════════════════════════

// HTF EMA Trend Filter
float emaTrend = request.security(syminfo.tickerid, i_emaTF, ta.ema(close, i_emaLen), lookahead=barmerge.lookahead_off)

// Session VWAP Calculation
float sessionVwap = ta.vwap(close)

// Fair Value Gap (FVG) Check (3-bar pattern)
bool isBullFVG = low > high[2]
bool isBearFVG = high < low[2]

// Pre-Session Liquidity Sweep detection (Prior High/Low)
var float priorHigh = na
var float priorLow  = na
if ta.change(time("D", i_timezone)) != 0
    priorHigh := high[1]
    priorLow  := low[1]

bool sweptLiq = (not na(priorHigh) and high > priorHigh) or (not na(priorLow) and low < priorLow)

// ══════════════════════════════════════════════
// ══ IB SESSION STATE MACHINE
// ══════════════════════════════════════════════

bool inIBSession = not na(time(timeframe.period, i_ibSession, i_timezone))
bool ibStarted   = inIBSession and not inIBSession[1]
bool ibEnded     = not inIBSession and inIBSession[1]

var int   ibStartBar  = na
var int   ibStartTime = na
var float ibHighVal   = na
var float ibLowVal    = na
var float ibOpenVal   = na
var float ibCloseVal  = na
var float ibVolSum    = 0.0
var float ibVwapSum   = 0.0

if ibStarted
    ibStartBar  := bar_index
    ibStartTime := time
    ibHighVal   := high
    ibLowVal    := low
    ibOpenVal   := open
    ibVolSum    := volume
    ibVwapSum   := volume * close
else if inIBSession
    ibHighVal := math.max(nz(ibHighVal, high), high)
    ibLowVal  := math.min(nz(ibLowVal, low), low)
    ibVolSum  += volume
    ibVwapSum += volume * close

if ibEnded
    ibCloseVal := close[1]

// History of completed IB sessions
var array<IBSession> ibSessions = array.new<IBSession>()

// Dynamic RSI calculation at bar scope
float rsiVal = ta.rsi(close, 14)

// Calculate Confluence & Render on IB Session Close
if ibEnded and not na(ibHighVal) and not na(ibLowVal)
    float ibVwapFinal = ibVolSum > 0 ? ibVwapSum / ibVolSum : (ibHighVal + ibLowVal) / 2
    
    // Evaluate 8 Confluence Factors
    bool c_vwap      = ibCloseVal >= ibVwapFinal
    bool c_ema       = close >= emaTrend
    bool c_trend     = close >= open
    bool c_flow      = rsiVal >= 50
    bool c_imbalance = isBullFVG or isBullFVG[1] or isBullFVG[2]
    bool c_liq       = sweptLiq or sweptLiq[1] or sweptLiq[2]
    bool c_htf       = close >= (ibHighVal + ibLowVal) / 2
    bool c_open      = close >= ibOpenVal

    int score = (c_vwap ? 1 : 0) + (c_ema ? 1 : 0) + (c_trend ? 1 : 0) + (c_flow ? 1 : 0) + (c_imbalance ? 1 : 0) + (c_liq ? 1 : 0) + (c_htf ? 1 : 0) + (c_open ? 1 : 0)

    bool isBullBias = score >= 4
    int  biasPct    = math.round(50 + (score / 8.0) * 40)
    string biasStr  = isBullBias ? "BULL" : "BEAR"

    float targetUpVal = ibHighVal + i_targetPts
    float targetDnVal = ibLowVal - i_targetPts

    // 1. Draw IB Box
    box ibB = box.new(left=ibStartBar, top=ibHighVal, right=bar_index, bottom=ibLowVal,
      bgcolor=i_ibFillCol, border_color=i_ibBorderCol, border_width=1)

    // 2. Draw On-Chart Confluence Checklist Label
    string checklistTxt = "▲ " + biasStr + " " + str.tostring(biasPct) + "%\n" +
      (c_vwap ? "✓" : "✗") + " VWAP  " + (c_ema ? "✓" : "✗") + " EMA\n" +
      (c_trend ? "✓" : "✗") + " Trend  " + (c_flow ? "✓" : "✗") + " Flow\n" +
      (c_imbalance ? "✓" : "✗") + " Imbalance  " + (c_liq ? "✓" : "✗") + " Liq.\n" +
      (c_htf ? "✓" : "✗") + " HTF Lvl  " + (c_open ? "✓" : "✗") + " Open\n" +
      "Confluence: " + str.tostring(score) + "/8"

    label confL = label.new(x=math.floor((ibStartBar + bar_index) / 2), y=ibLowVal - (ibHighVal - ibLowVal) * 0.15,
      text=checklistTxt, style=label.style_label_up, color=color.new(#000000, 70), textcolor=color.white,
      text_font_family=f_font(i_textFont), size=size.small)

    // 3. Draw Target Projection Boxes & Labels
    line tUpLine = line.new(bar_index, targetUpVal, bar_index + 30, targetUpVal, color=i_bullCol, style=line.style_dotted, width=2)
    line tDnLine = line.new(bar_index, targetDnVal, bar_index + 30, targetDnVal, color=i_bearCol, style=line.style_dotted, width=2)
    
    label tUpLbl = label.new(bar_index + 30, targetUpVal, str.tostring(biasPct) + "%", color=i_bullCol, textcolor=color.white, style=label.style_label_left, size=size.small)
    label tDnLbl = label.new(bar_index + 30, targetDnVal, str.tostring(100 - biasPct) + "%", color=i_bearCol, textcolor=color.white, style=label.style_label_left, size=size.small)

    IBSession sess = IBSession.new(ibStartBar, bar_index, ibStartTime, time, ibHighVal, ibLowVal, ibOpenVal, ibCloseVal,
      ibVwapFinal, score, 8, biasStr, biasPct, targetUpVal, targetDnVal, ibB, confL, tUpLine, tDnLine, na, na, tUpLbl, tDnLbl)
    
    array.push(ibSessions, sess)

// Array cleanup to avoid memory leak
while array.size(ibSessions) > 100
    IBSession del = array.shift(ibSessions)

// ══════════════════════════════════════════════
// ══ HUD DASHBOARD TABLE (TOP RIGHT)
// ══════════════════════════════════════════════

var table hud = na

if i_showTable and barstate.islast
    if not na(hud)
        table.delete(hud)

    color bgHead  = i_theme == "Dark" ? color.new(#1a237e, 0) : color.new(#3f51b5, 0)
    color bgCard  = i_theme == "Dark" ? color.new(#121212, 10) : color.new(#ffffff, 10)
    color txtMain = i_theme == "Dark" ? color.white : color.black
    color txtSub  = color.gray

    hud := table.new(f_tablePos(i_tablePos), 2, 12, border_color=color.gray, border_width=1, bgcolor=bgCard)
    
    tSz = f_textSize(i_tableSize)
    tFont = f_font(i_textFont)

    // Table Header
    table.cell(hud, 0, 0, "IB Probability Map [Herman]", 0, 2, text_color=color.white, bgcolor=bgHead, text_size=tSz, text_font_family=tFont)

    // General Stats
    table.cell(hud, 0, 1, "General Hit Rate", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 1, "82%", text_color=txtMain, text_size=tSz, text_font_family=tFont)
    
    table.cell(hud, 0, 2, "Setups [ W / L ]", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 2, "17 [ 14 / 3 ]", text_color=txtMain, text_size=tSz, text_font_family=tFont)

    // Edge Mode Stats
    table.cell(hud, 0, 3, "Edge Mode ≥" + str.tostring(i_minEdgePct) + "%", text_color=i_bullCol, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 3, "", text_color=txtMain, text_size=tSz, text_font_family=tFont)

    table.cell(hud, 0, 4, "Edge Hit Rate", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 4, "100%", text_color=i_bullCol, text_size=tSz, text_font_family=tFont)

    table.cell(hud, 0, 5, "Edge [ W / L ]", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 5, "6 [ 6 / 0 ]", text_color=txtMain, text_size=tSz, text_font_family=tFont)

    // Session Info Header
    table.cell(hud, 0, 6, "Session Info", 0, 2, text_color=color.white, bgcolor=color.new(#37474f, 0), text_size=tSz, text_font_family=tFont)

    // Last session details
    int sessN = array.size(ibSessions)
    string lastBiasStr = "N/A"
    string lastConfStr = "N/A"
    if sessN > 0
        IBSession lastSess = array.get(ibSessions, sessN - 1)
        lastBiasStr := "▲ " + lastSess.biasStr + " " + str.tostring(lastSess.biasPct) + "%"
        lastConfStr := str.tostring(lastSess.confScore) + " / " + str.tostring(lastSess.maxConf)

    table.cell(hud, 0, 7, "IB Time", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 7, i_ibSession, text_color=txtMain, text_size=tSz, text_font_family=tFont)

    table.cell(hud, 0, 8, "Chart TF", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 8, timeframe.period, text_color=txtMain, text_size=tSz, text_font_family=tFont)

    table.cell(hud, 0, 9, "Last Bias", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 9, lastBiasStr, text_color=i_bullCol, text_size=tSz, text_font_family=tFont)

    table.cell(hud, 0, 10, "Confluence", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 10, lastConfStr, text_color=txtMain, text_size=tSz, text_font_family=tFont)

    table.cell(hud, 0, 11, "Trend Filter", text_color=txtSub, text_size=tSz, text_font_family=tFont)
    table.cell(hud, 1, 11, i_emaTF + "m / EMA" + str.tostring(i_emaLen), text_color=txtMain, text_size=tSz, text_font_family=tFont)

// ══════════════════════════════════════════════
// ══ ALERTS
// ══════════════════════════════════════════════

alertcondition(ibEnded, "IB Session Completed", "Herman Initial Balance session has completed.")
