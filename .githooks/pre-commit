#!/bin/sh
# Block binary bloat from entering history.
#
# .gitignore already lists these, but `git add -f` walks straight past it --
# which is exactly how data/NQ1_1m.parquet reached 126 MB and made every push
# fail against GitHub's 100 MB limit for 202 commits. This hook is the part
# that cannot be bypassed by accident.
#
# Install (once per clone):  git config core.hooksPath .githooks
# Deliberate override:       ALLOW_BIG_FILES=1 git commit ...

BLOCKED_EXT='\.(parquet|m4a|mp3|mp4|wav|webm|mkv|mov|avi|flac|ogg|aac|wma)$'
MAX_BYTES=52428800   # 50 MB -- GitHub warns here and hard-rejects at 100 MB

if [ "$ALLOW_BIG_FILES" = "1" ]; then
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=AM)
[ -z "$staged" ] && exit 0

fail=0

# 1. Blocked extensions, regardless of size.
bad_ext=$(printf '%s\n' "$staged" | grep -iE "$BLOCKED_EXT")
if [ -n "$bad_ext" ]; then
    echo "BLOCKED: data/media files must not be committed." >&2
    echo "" >&2
    printf '%s\n' "$bad_ext" | sed 's/^/    /' >&2
    echo "" >&2
    echo "  These are regenerated or re-downloadable inputs, not source." >&2
    echo "  Unstage with:  git restore --staged <file>" >&2
    fail=1
fi

# 2. Anything oversized, whatever its extension.
big=$(printf '%s\n' "$staged" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    size=$(git cat-file -s "$(git rev-parse ":$f" 2>/dev/null)" 2>/dev/null) || continue
    [ "$size" -gt "$MAX_BYTES" ] && printf '%s (%s MB)\n' "$f" "$((size / 1048576))"
done)
if [ -n "$big" ]; then
    echo "BLOCKED: files over 50 MB (GitHub rejects at 100 MB)." >&2
    echo "" >&2
    printf '%s\n' "$big" | sed 's/^/    /' >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "  If you are certain, re-run with:  ALLOW_BIG_FILES=1 git commit ..." >&2
    exit 1
fi

exit 0
