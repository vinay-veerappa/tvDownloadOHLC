<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <DefineConstants>TESTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude stray strategy source folders auto-globbed from the project directory. -->
    <Compile Remove="Strategies\**\*.cs" />
    <!-- Include all addon .cs files EXCEPT McpBridgeAddOn.cs (WPF dependencies break test build).
         This matches the old behavior when files were in this directory and auto-globbed. -->
    <Compile Include="..\scripts\ninjatrader\addons\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Remove="..\scripts\ninjatrader\addons\McpBridgeAddOn.cs" />
    <Compile Remove="..\scripts\ninjatrader\addons\RiskManagerAddOn.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
