// Returns map of all contextual price models
// Key format: SESSION_CTX1_CTX2_OUTCOME (L1), SESSION_F_CTX_OUTCOME (L2), SESSION_B_OUTCOME (L3)
// Value format: 'high:low,high:low,...' (5-min buckets, % from session open)
export f_get_models() =>
    m = map.new<string, string>()
    f_add_chunk_1(m)
    f_add_chunk_2(m)
    f_add_chunk_3(m)
    f_add_chunk_4(m)
    f_add_chunk_5(m)
    f_add_chunk_6(m)
    f_add_chunk_7(m)
    m
