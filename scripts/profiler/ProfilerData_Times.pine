export get_lod_time() =>
    var int[] arr = array.new_int(0)
    if barstate.isfirst
        array.concat(arr, _get_lod_time_0())
        array.concat(arr, _get_lod_time_1())
        array.concat(arr, _get_lod_time_2())
    arr