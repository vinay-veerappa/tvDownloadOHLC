    table.cell(dash, 2, 15, str.tostring(stat.z6_reach, "#.#") + "%", bgcolor=c_light, text_color=color.black, text_size=sz)
    table.cell(dash, 3, 15, str.tostring(stat.z6_win, "#.#") + "%", bgcolor=c_light, text_color=color.black, text_size=sz)
    table.cell(dash, 4, 15, str.tostring(stat.z6_dens, "#.#") + "%", bgcolor=c_light, text_color=color.black, text_size=sz)
    table.cell(dash, 5, 15, "GRAVEYARD", bgcolor=c_light, text_color=color.black, text_size=sz)
    
    // Footer (Merged)
    table.cell(dash, 0, 16, "HARD SESSION STOP: " + stat.hard_stop_time, bgcolor=color.new(color.red, 85), text_color=color.red, text_size=sz)
    table.merge_cells(dash, 0, 16, 5, 16)
