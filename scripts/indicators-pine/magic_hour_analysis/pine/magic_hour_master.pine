//@version=6
indicator("VxV::Dokakuri's Magic Hours: Master Playbook", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================================================================
// 1. STRATEGY CONSTANTS & DATA
// =============================================================================

// Strategy IDs
S_0700 = "RANK #1: 07:00 (Golden Hour)"
S_0800 = "RANK #2: 08:00 (Continuation)"
S_0600 = "RANK #3: 06:00 (Pre-Market)"
S_0000 = "RANK #4: 00:00 (Asia Open)"
S_0100 = "RANK #5: 01:00 (Asia Cont.)"
S_0200 = "RANK #6: 02:00 (London Pre)"
S_2300 = "RANK #7: 23:00 (Asia Pre-Game)"

// Group Headings
GRP_PRE = "--- PRE-MARKET / NY ---"
GRP_ASIA = "--- ASIA / LONDON ---"

// =============================================================================
// 2. INPUTS
// =============================================================================

grp_strat = "STRATEGY SELECTION"
selectedStrategy = input.string(S_0800, "Select Strategy", options=[GRP_PRE, S_0700, S_0800, S_0600, GRP_ASIA, S_0000, S_0100, S_0200, S_2300], group=grp_strat)
tzInput = input.string("America/New_York", "Timezone", group=grp_strat)

grp_dash = "MASTER DASHBOARD"
showDash = input.bool(true, "Show Unified Dashboard", group=grp_dash)
posInput = input.string("Top Right", "Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_dash)
textSizeInput = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_dash)
textAlignInput = input.string("Right", "Zone Text Alignment", options=["Left", "Center", "Right"], group=grp_dash)

// Visuals
grp_vis = "VISUALS & COLORS"
baseTextColor = input.color(color.new(color.white, 0), "Base Text Color", group=grp_vis)
mhFillColor = input.color(color.new(color.gray, 85), "Magic Hour Fill", group=grp_vis)
mhLabelColor = input.color(color.new(#d16d1d, 0), "Magic Hour Label Color", group=grp_vis) // Brown/Orange
neutralLineColor = input.color(color.new(color.gray, 50), "Neutral High/Low Line", group=grp_vis)
breakColor = input.color(color.new(#2962ff, 0), "Break Color", group=grp_vis) // Blue
midlineColor = input.color(color.new(#d42cff, 0), "Midline Color", group=grp_vis) // Fuchsia
inactiveZoneFill = input.color(color.new(color.gray, 95), "Inactive Zone Fill", group=grp_vis)
showMidlineProp = input.bool(true, "Show Midline", group=grp_vis)

// =============================================================================
// 3. STATISTICAL DATA STORE
// =============================================================================

// Struct to hold Strategy Data
type StrategyData
    string name
    int startHour
    int endHour // Analysis window end, roughly
    // Dashboard Stats
    int total_sessions
    float win_rate
    float avg_mae
    string time_fast
    string time_med
    string time_slow
    // Runner Conversion
    float run_75
    float run_100
    float run_125
    float run_150
    float run_200
    // Zone Stats (Reach, Win, Density)
    float z1_reach
    float z1_win
    float z1_dens
    float z2_reach
    float z2_win
    float z2_dens
    float z3_reach
    float z3_win
    float z3_dens
    float z4_reach
    float z4_win
    float z4_dens
    float z5_reach
    float z5_win
    float z5_dens
    float z6_reach
    float z6_win
    float z6_dens
    // Logic
    float inv_level // Invalidation Level (e.g. 100 or 75)
    string hard_stop_time

// Function to populate data based on selection
get_strategy_data(string sel) =>
    StrategyData d = StrategyData.new()
    
    // Default to Null if header selected
    if sel == GRP_PRE or sel == GRP_ASIA
        d.name := "INVALID SELECTION"
    
