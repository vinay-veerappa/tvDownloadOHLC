//@version=6
indicator(title = 'HR', overlay = true, max_lines_count = 200)

ticker = syminfo.ticker

timezone = 'America/Chicago'
gapTime = '1600-0400'
gap2Time = '0930-0945,1000-1100'

hideGap = input.bool(true, 'Hide Gaps 0400-1600')
hideGap2 = input.bool(true, 'Hide Intra Gaps Berween Macros')


// InSession() returns 'true' when the current bar happens inside
// the specified session, corrected for the given time zone (optional).
// Returns 'false' when the bar doesn't happen in that time period,
// or when the chart's time frame is 1 day or higher. 
InSession(sessionTime, sessionTimeZone = syminfo.timezone, exact = false) =>
    if exact
        not na(time('1', sessionTime, sessionTimeZone))
    else
        not na(time(timeframe.period, sessionTime, sessionTimeZone))


duringGap = InSession(gapTime, timezone)
duringGap2 = InSession(gap2Time, timezone)

// plotcandle(open, high, low, close, title='Hidden bar color', color=duringGap and hideGap ? color.new(#131722, 0) : na, wickcolor = duringGap and hideGap ? color.new(#131722, 0) : na, bordercolor=duringGap and hideGap ? color.new(#131722,0) : na, display = display.all)
plotcandle(open, high, low, close, title = 'Hidden bar color', color = duringGap and hideGap ? chart.bg_color : na, wickcolor = duringGap and hideGap ? chart.bg_color : na, bordercolor = duringGap and hideGap ? chart.bg_color : na, display = display.all)
plotcandle(open, high, low, close, title = 'Hidden bar color', color = duringGap2 and hideGap2 ? chart.bg_color : na, wickcolor = duringGap2 and hideGap2 ? chart.bg_color : na, bordercolor = duringGap2 and hideGap2 ? chart.bg_color : na, display = display.all)
// Overnight session

// STEP 1:
// Define custom session trading times with inputs
// ONsessionTime = input.session("0400-0815", title="Session time")
showONSession = input.bool(true, 'ONS', group = 'Overnight Session')

ONsessionTime = '0400-0815'
ONsessionZone = timezone

// Other inputs for the boxes' visual appearance
ONSessionBorderSize = input.int(1, title = 'ONS Border Size', minval = 0, group = 'Overnight Session')
ONSessionBgColor = input.color(color.new(#868686, 100), title = 'Overnight Session Background Color', group = 'Overnight Session')
ONSessionBorderColor = input.color(color.rgb(0, 0, 0), title = 'ONS Border', group = 'Overnight Session')
ONSessionAvgLineColor = input.color(color.rgb(0, 0, 0), title = 'ONS EQ', group = 'Overnight Session')
// Create variables
var ONsessionHighPrice = 0.0
var ONsessionLowPrice = 0.0
var ONsessionOpenPrice = 0.0
var ONSessionAvgPrice = 0.0
var ONSessionPipCount = 0.0
var box ONsessionBox = na
var line ONSessionAvgLine = na
var label ONSessionAvgLabel = na
var label ONSessionLabel = na
// var table testtable = na 

// STEP 2:
// See if the session is currently active and just started
inONSession = InSession(ONsessionTime, ONsessionZone) and timeframe.isintraday
ONsessionStart = inONSession and not inONSession[1]

// STEP 3:
// When a new session starts, set the session high and low to the data
// of the bar in the session.
if ONsessionStart
    ONsessionHighPrice := high
    ONsessionLowPrice := low
    ONsessionOpenPrice := open
    ONSessionAvgPrice := (ONsessionHighPrice + ONsessionLowPrice) / 2
    ONSessionPipCount := math.abs((ONsessionHighPrice - ONsessionLowPrice) / syminfo.mintick)
    ONSessionPipCount

// Else, during the session, track the highest high and lowest low
else if inONSession
    ONsessionHighPrice := math.max(ONsessionHighPrice, high)
    ONsessionLowPrice := math.min(ONsessionLowPrice, low)
    ONSessionAvgPrice := (ONsessionHighPrice + ONsessionLowPrice) / 2
    ONSessionPipCount := math.abs((ONsessionHighPrice - ONsessionLowPrice) / 10 / syminfo.mintick)
    ONSessionPipCount
    //ONSessionPipCount for Indicies
    //ONSessionPipCount  := math.abs(((ONsessionHighPrice - ONsessionLowPrice) / 4) / syminfo.mintick)

// STEP 4:
// When a session begins, make a new box for that session
if ONsessionStart and showONSession
    ONsessionBox := box.new(left = bar_index, top = na, right = na, bottom = na, border_style = line.style_dashed, border_width = ONSessionBorderSize)
    // ONSessionAvgLine := line.new(bar_index, ONSessionAvgPrice, bar_index + 1, ONSessionAvgPrice, color = color.navy, width = 3)
    tsStart = timestamp(timezone, year(time), month(time), dayofmonth(time), 04, 00)
    tsEnd = timestamp(timezone, year(time), month(time), dayofmonth(time), 16, 00)
    ONSessionAvgLine := line.new(tsStart, ONSessionAvgPrice, tsEnd, ONSessionAvgPrice, color = ONSessionAvgLineColor, width = 2, xloc = xloc.bar_time, style = line.style_dotted)
    ONSessionAvgLabel := label.new(tsEnd - 3000000, ONSessionAvgPrice * 0.99998, 'ONS EQ', xloc = xloc.bar_time, style = label.style_none, textcolor = ONSessionAvgLineColor, size = size.small, textalign = text.align_left)
    ONSessionLabel := label.new(tsStart + 1000000, ONsessionHighPrice, str.tostring(ONSessionPipCount) + ' pts', xloc = xloc.bar_time, style = label.style_none, textcolor = ONSessionBorderColor, size = size.small, textalign = text.align_right)
    ONSessionLabel
    // line.set_color()
    // testtable := table.new(position.bottom_right,1,1)
    // table.cell(testtable, 1,1, "aaa")



// STEP 5:
// During the session, update that session's existing box
if inONSession and showONSession
    box.set_top(ONsessionBox, ONsessionHighPrice)
    box.set_bottom(ONsessionBox, ONsessionLowPrice)

    box.set_right(ONsessionBox, bar_index + 1)

    line.set_y1(ONSessionAvgLine, ONSessionAvgPrice)
    line.set_y2(ONSessionAvgLine, ONSessionAvgPrice)
    label.set_y(ONSessionAvgLabel, ONSessionAvgPrice)
    label.set_y(ONSessionLabel, ONsessionHighPrice)

    label.set_text(ONSessionLabel, str.tostring(ONSessionPipCount) + ' pts')
    label.set_y(ONSessionLabel, ONsessionHighPrice)
    // line.set_xy1(ONSessionAvgLine, bar_index + 1, ONSessionAvgPrice)
    // line.set_y2(ONSessionAvgLine, ONSessionAvgPrice)
    // l = label.new(bar_index, close, str.tostring(ONSessionAvgPrice))

    // See if bar closed higher than session open. When it did, make
    // box green (and use red otherwise).
    box.set_bgcolor(ONsessionBox, ONSessionBgColor)
    box.set_border_color(ONsessionBox, ONSessionBorderColor)
    // if close > ONsessionOpenPrice
    //     box.set_bgcolor(ONsessionBox, upBoxColor)
    //     box.set_border_color(ONsessionBox, upBorderColor)
    // else
    //     box.set_bgcolor(ONsessionBox, downBoxColor)
    //     box.set_border_color(ONsessionBox, downBorderColor)
    // avgPrice = math.abs(ONsessionHighPrice - ONsessionLowPrice) / 2


// ONLiqHunt

ONLiqHuntTime = '0815-0930'
showONLiqHuntTime = input.bool(true, 'Liquidity Hunt', group = 'Overnight Session')


ONLiqHuntBorderSize = input.int(1, title = 'Liquidity Hunt Border Size', minval = 0, group = 'Overnight Session')
ONLiqHuntBgColor = input.color(color.new(#415781, 100), title = 'Liquidity Hunt Background Color', group = 'Overnight Session')
ONLiqHuntBorderColor = input.color(color.rgb(0, 0, 0), title = 'Liquidity Hunt Border Color', group = 'Overnight Session')

// Create variables
var ONLiqHuntHighPrice = 0.0
var ONLiqHuntLowPrice = 0.0
var ONLiqHuntOpenPrice = 0.0
var box ONLiqHuntBox = na
// var label ONLiqLabel = na

inONLiqHunt = InSession(ONLiqHuntTime, timezone) and timeframe.isintraday
ONLiqHuntStart = inONLiqHunt and not inONLiqHunt[1]

// When a new session starts, set the session high and low to the data
// of the bar in the session.
if ONLiqHuntStart
    ONLiqHuntHighPrice := high
    ONLiqHuntLowPrice := low
    ONLiqHuntOpenPrice := open
    ONLiqHuntOpenPrice
    // Else, during the session, track the highest high and lowest low
else if inONLiqHunt
    ONLiqHuntHighPrice := math.max(ONLiqHuntHighPrice, high)
    ONLiqHuntLowPrice := math.min(ONLiqHuntLowPrice, low)
    ONLiqHuntLowPrice

// When a session begins, make a new box for that session
if ONLiqHuntStart and showONLiqHuntTime
    ONLiqHuntBox := box.new(left = bar_index, top = na, right = na, bottom = na, border_style = line.style_dashed, border_width = ONLiqHuntBorderSize)
    tsStart = timestamp(timezone, year(time), month(time), dayofmonth(time), 08, 15)
    tsStart
    // ONLiqLabel    := label.new(tsStart+300000, ONLiqHuntHighPrice, "Liquidity Hunt", xloc = xloc.bar_time, style = label.style_none, textcolor = ONLiqHuntBorderColor, size = size.small, textalign = text.align_right)

// During the session, update that session's existing box
if inONLiqHunt and showONLiqHuntTime
    box.set_top(ONLiqHuntBox, ONLiqHuntHighPrice)
    box.set_bottom(ONLiqHuntBox, ONLiqHuntLowPrice)

    box.set_right(ONLiqHuntBox, bar_index + 1)

    box.set_bgcolor(ONLiqHuntBox, ONLiqHuntBgColor)
    box.set_border_color(ONLiqHuntBox, ONLiqHuntBorderColor)
    // label.set_y(ONLiqLabel,ONLiqHuntHighPrice)


// offset time

// STEP 1:
// Define custom session trading times with inputs
showOffsetTime = input.bool(true, 'Offset', group = 'Overnight Session')

OffsetTime = '0945-1000'

// Other inputs for the boxes' visual appearance
