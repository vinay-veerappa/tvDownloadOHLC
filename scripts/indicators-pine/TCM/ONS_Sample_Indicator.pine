// Open Price 4pm

var dayinms = 86400000

var tsEnd = 0


show4pmPrice = input.bool(false, 'Show 4pm price', group = 'Opening Price')
fourPMPriceColor = input.color(#00ced1, '4pm price color', group = 'Opening Price')
if show4pmPrice
    fourPM2fourPM = '1600-1530'

    var fourPM2fourPMOpeningPrice = 0.0
    // var fourPM2fourPMtime = 0
    // var box fourPM2fourPMBox = na
    var line fourPM2fourPMLine = na

    infourPM2fourPM = InSession(fourPM2fourPM, timezone) and timeframe.isintraday
    fourPM2fourPMStart = infourPM2fourPM and not infourPM2fourPM[1]

// tsStart = timestamp(timezone, year(time),month(time),dayofmonth(time),16,00)
// tsSince = timestamp(timezone, year(time),month(time),dayofmonth(time - 1 * dayinms),00,00)

    if fourPM2fourPMStart
        fourPM2fourPMOpeningPrice := open
        // fourPM2fourPMtime := time
        tsStart = timestamp(timezone, year(time), month(time), dayofmonth(time), 16, 00)
        if dayofweek(time, timezone) == dayofweek.friday
            tsEnd := timestamp(timezone, year(time), month(time), dayofmonth(time + 3 * dayinms), 16, 00)
            tsEnd
        else
            tsEnd := timestamp(timezone, year(time), month(time), dayofmonth(time + dayinms), 16, 00)
            tsEnd
        fourPM2fourPMLine := line.new(tsStart, fourPM2fourPMOpeningPrice, tsEnd, fourPM2fourPMOpeningPrice, xloc = xloc.bar_time)
        line.set_color(fourPM2fourPMLine, fourPMPriceColor)
        label.new(tsEnd - 3000000, fourPM2fourPMOpeningPrice * 0.99998, '4pm', xloc = xloc.bar_time, style = label.style_none, textcolor = fourPMPriceColor, size = size.small, textalign = text.align_left)

// Open Price 4 am

show4amPrice = input.bool(false, 'Show 4am price', group = 'Opening Price')
fourAMPriceColor = input.color(#2962ff, '4am price color', group = 'Opening Price')

if show4amPrice
    fourAM2fourPM = '0400-1600'

    var fourAM2fourPMOpeningPrice = 0.0
    var box fourAM2fourPMBox = na
    var line fourAM2fourPMLine = na

    infourAM2fourPM = InSession(fourAM2fourPM, timezone) and timeframe.isintraday
    fourAM2fourPMStart = infourAM2fourPM and not infourAM2fourPM[1]

    tsStart = timestamp(timezone, year(time), month(time), dayofmonth(time), 04, 00)

    if fourAM2fourPMStart
        fourAM2fourPMOpeningPrice := open
        tsStart := timestamp(timezone, year(time), month(time), dayofmonth(time), 04, 00)
        tsEnd := timestamp(timezone, year(time), month(time), dayofmonth(time), 16, 00)
        fourAM2fourPMLine := line.new(tsStart, fourAM2fourPMOpeningPrice, tsEnd, fourAM2fourPMOpeningPrice, xloc = xloc.bar_time)
        line.set_color(fourAM2fourPMLine, fourAMPriceColor)
        label.new(tsEnd - 3000000, fourAM2fourPMOpeningPrice * 0.99998, '4am', xloc = xloc.bar_time, style = label.style_none, textcolor = fourAMPriceColor, size = size.small, textalign = text.align_left)

open1 = request.security_lower_tf(syminfo.tickerid, '1', open)
time1 = request.security_lower_tf(syminfo.tickerid, '1', minute(time))

// Open Price 815

show815amPrice = input.bool(false, 'Show 8h15 am price', group = 'Opening Price')
eight15AMPriceColor = input.color(#2962ff, '8h15am price color', group = 'Opening Price')

if show815amPrice
    eight15AM2930 = '0815-0930'

    var eight15AM2930OpeningPrice = 0.0
    var box eight15AM2930Box = na
    var line eight15AM2930Line = na

    ineight15AM2930 = InSession(eight15AM2930, timezone) and timeframe.isintraday
    eight15AM2930Start = ineight15AM2930 and not ineight15AM2930[1]


    var lastopentime = 0
    var array<float> lastOpen1 = na
    var array<int> lastTime1 = na

    isInBefore = 0

    if eight15AM2930Start
        if array.size(lastOpen1) > 0
            for i = 0 to array.size(lastOpen1) - 1 by 1
                if array.get(lastTime1, i) == 15
                    eight15AM2930OpeningPrice := array.get(lastOpen1, i)
                    isInBefore := 1
                    isInBefore
        if array.size(open1) > 0 and isInBefore == 0
            for i = 0 to array.size(open1) - 1 by 1
                if array.get(time1, i) == 15
                    eight15AM2930OpeningPrice := array.get(open1, i)
                    eight15AM2930OpeningPrice


    if lastopentime < time
        lastopentime := time
        lastOpen1 := open1
        lastTime1 := time1
        lastTime1

    if eight15AM2930Start
        tsStart = timestamp(timezone, year(lastopentime), month(lastopentime), dayofmonth(lastopentime), 08, 15)
        tsEnd := timestamp(timezone, year(time), month(time), dayofmonth(time), 16, 00)
        eight15AM2930Line := line.new(tsStart, eight15AM2930OpeningPrice, tsEnd, eight15AM2930OpeningPrice, xloc = xloc.bar_time)

        line.set_color(eight15AM2930Line, eight15AMPriceColor)
        label.new(tsEnd - 3000000, eight15AM2930OpeningPrice * 0.99998, '8h15am', xloc = xloc.bar_time, style = label.style_none, textcolor = eight15AMPriceColor, size = size.small, textalign = text.align_left)

f_strMid(_str, _from, _to) =>
    array<string> _chars = str.split(_str, '')
    int _len = array.size(_chars)
    int _beg = math.min(_len - 1, math.max(0, _from))
    int _end = math.min(_len, math.max(0, _to + 1))
    array<string> _substr = array.new_string(0)
    if _beg <= _end
        _substr := array.slice(_chars, _beg, _end)
        _substr
    string _return = array.join(_substr, '')
    _return

f_strLeft(_str, _n) =>
    array<string> _chars = str.split(_str, '')
    int _len = array.size(_chars)
    int _end = math.min(_len, math.max(0, _n))
    array<string> _substr = array.new_string(0)
    if _end <= _len
        _substr := array.slice(_chars, 0, _end)
        _substr
    string _return = array.join(_substr, '')
    _return
