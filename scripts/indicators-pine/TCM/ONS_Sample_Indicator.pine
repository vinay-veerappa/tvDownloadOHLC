var OffsetLowPrice = 0.0
var OffsetOpenPrice = 0.0
var box OffsetBox = na

// STEP 2:
// See if the session is currently active and just started
inOffset = InSession(OffsetTime, timezone) and timeframe.isintraday
OffsetStart = inOffset and not inOffset[1]

// STEP 3:
// When a new session starts, set the session high and low to the data
// of the bar in the session.
if OffsetStart
    OffsetHighPrice := high
    OffsetLowPrice := low
    OffsetOpenPrice := open
    OffsetOpenPrice
    // Else, during the session, track the highest high and lowest low
else if inOffset
    OffsetHighPrice := math.max(OffsetHighPrice, high)
    OffsetLowPrice := math.min(OffsetLowPrice, low)
    OffsetLowPrice

// STEP 4:
// When a session begins, make a new box for that session
if OffsetStart and showOffsetTime
    OffsetBox := box.new(left = bar_index, top = na, right = na, bottom = na, border_style = line.style_dashed, border_width = OffsetBorderSize)
    OffsetBox

// STEP 5:
// During the session, update that session's existing box
if inOffset and showOffsetTime
    box.set_top(OffsetBox, OffsetHighPrice)
    box.set_bottom(OffsetBox, OffsetLowPrice)

    box.set_right(OffsetBox, bar_index + 1)

    box.set_bgcolor(OffsetBox, OffsetBgColor)
    box.set_border_color(OffsetBox, OffsetBorderColor)

