//@version=6
indicator("[VxV]Probability Engine v5", shorttitle="[VxV]ProbMap", overlay=true,
     max_boxes_count=50, max_lines_count=100, max_labels_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
//  PROBABILITY ENGINE v5 — Full Refactor
// ═══════════════════════════════════════════════════════════════════════════════
//
// REFACTOR NOTES (v5 from v4):
// ─────────────────────────────────────────────────────────────────────────────
// 1. [BUG]  clearLabels() now deletes label objects (stale label fix)
// 2. [BUG]  lblDayH/lblDayL cleaned up on new day
// 3. [BUG]  Sigma label offset typo fixed via extendLevel()
// 4. [BUG]  Stray row += 1 in PM dashboard section removed
// 5. [ARCH] Probability lookups compressed via _gp/_gp_global/_gsp helpers
// 6. [ARCH] get72ScenarioProb() rewritten with instrument-param helper
// 7. [ARCH] extendLevel() replaces 66 lines of line/label extension
// 8. [ARCH] checkHit() replaces 20+ inline hit-check blocks
// 9. [ARCH] addDashRow() replaces ~180 lines of dashboard boilerplate
// 10.[ARCH] resetAllHits() eliminates duplicated hit-reset blocks
// 11.[ARCH] Hit reset consolidated to single trigger point
//
// Based on 5,165 NQ trading days (2006-2026)
// ═══════════════════════════════════════════════════════════════════════════════

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  INPUTS                                                                     │
// └─────────────────────────────────────────────────────────────────────────────┘

grp_s = "Sessions"
i_tz = input.string("America/New_York", "Timezone", options=["America/New_York","America/Chicago"], group=grp_s)

grp_t = "═══════ Theme ═══════"
i_theme    = input.string("Dark", "Chart Theme", options=["Dark","Light","Auto"], group=grp_t)
i_dashOpac = input.int(10, "Dashboard Background Opacity", minval=0, maxval=100, group=grp_t)

grp_d = "═══════ Dashboard ═══════"
i_showDash = input.bool(true, "Show Dashboard", group=grp_d)
i_dashPos  = input.string("Top Right", "Dashboard Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grp_d)
i_dashSz   = input.string("Small", "Dashboard Size", options=["Tiny","Small","Normal","Huge"], group=grp_d)

grp_l = "═══════ Lines ═══════"
i_showLevels = input.bool(true, "Show All Levels", group=grp_l)

i_showLondon = input.bool(true, "  Show London H/L/Mid", group=grp_l, inline="lon")
i_londonW    = input.int(2, "Width", minval=1, maxval=5, group=grp_l, inline="lon")
i_londonSty  = input.string("Solid", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="lon")

i_showAsia = input.bool(true, "  Show Asia H/L/Mid", group=grp_l, inline="asia")
i_asiaW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="asia")
i_asiaSty  = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="asia")

i_show78Mid = input.bool(true, "  Show 7-8 AM Mid", group=grp_l, inline="78")
i_78W       = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="78")
i_78Sty     = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="78")

i_show730 = input.bool(true, "  Show 07:30 Open", group=grp_l, inline="730")
i_730W    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="730")
i_730Sty  = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="730")

i_showMN = input.bool(true, "  Show Midnight Open", group=grp_l, inline="mn")
i_mnW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="mn")
i_mnSty  = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="mn")

i_showONMid = input.bool(true, "  Show ON Mid", group=grp_l, inline="onm")
i_onmW      = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="onm")
i_onmSty    = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="onm")

i_showOTE = input.bool(false, "  Show OTE Zones", group=grp_l, inline="ote")
i_oteW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="ote")
i_oteSty  = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="ote")

i_showGlx = input.bool(true, "  Show Globex Open", group=grp_l, inline="glx")
i_glxW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="glx")
i_glxSty  = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="glx")

i_showPDC = input.bool(true, "  Show Settlement/PDC", group=grp_l, inline="pdc")
i_pdcW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="pdc")
i_pdcSty  = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="pdc")

i_showPDHL = input.bool(true, "  Show PDH/PDL", group=grp_l, inline="pdhl")
i_pdhlW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="pdhl")
i_pdhlSty  = input.string("Solid", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="pdhl")

i_showSigma = input.bool(true, "  Show CBDR Sigma", group=grp_l, inline="sig")
i_sigW      = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="sig")
i_sigSty    = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="sig")

i_showAM = input.bool(true, "  Show AM H/L (PM only)", group=grp_l, inline="am")
i_amW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="am")
i_amSty  = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="am")

i_showLch = input.bool(true, "  Show Lunch H/L (PM only)", group=grp_l, inline="lch")
i_lchW    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="lch")
i_lchSty  = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="lch")

i_showP12 = input.bool(true, "  Show P12 H/L/Mid", group=grp_l, inline="p12")
i_p12W    = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="p12")
i_p12Sty  = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="p12")

i_lvlW = input.int(1, "Default Level Width", minval=1, maxval=5, group=grp_l)

grp_lb = "═══════ Labels ═══════"
i_showLabels = input.bool(true, "Show Level Labels", group=grp_lb)
i_labelSize  = input.string("Small", "Label Size", options=["Tiny","Small","Normal","Huge"], group=grp_lb)
i_labelOff   = input.int(12, "Label Offset (bars)", minval=0, maxval=50, group=grp_lb)
i_lineOff    = input.int(10, "Line Offset (bars)", minval=0, maxval=50, group=grp_lb)

grp_c = "═══════ Colors ═══════"
i_cLondon  = input.color(#ef4444, "London Levels", group=grp_c)
i_cAsia    = input.color(#3b82f6, "Asia Levels", group=grp_c)
i_cIntra   = input.color(#10b981, "Intraday Levels", group=grp_c)
i_cON      = input.color(#f59e0b, "Overnight Levels", group=grp_c)
i_cPrior   = input.color(#f97316, "Prior Day Levels", group=grp_c)
i_cSigUp   = input.color(#16a34a, "Sigma Upside", group=grp_c)
i_cSigDn   = input.color(#dc2626, "Sigma Downside", group=grp_c)

grp_b = "═══════ Session Boxes ═══════"
i_showBoxes = input.bool(true, "Show Session Boxes", group=grp_b)
i_boxTr     = input.int(93, "Box Transparency", minval=80, maxval=98, group=grp_b)

grp_r = "═══════ Range Stats ═══════"
i_rngLB = input.int(50, "Range Percentile Lookback", minval=5, maxval=100, group=grp_r)

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  TYPES                                                                      │
// └─────────────────────────────────────────────────────────────────────────────┘

type ThemePalette
    color bg_primary
    color bg_secondary
    color bg_border
    color text_primary
    color text_secondary
    color text_dim
    color asia_primary
    color london_primary
    color ny_primary
    color overnight_primary
    color prior_primary
    color bullish
    color bearish
    color neutral
    color caution
    color confirm
    color header_bg
    color header_text
    color validated_bg
    color validated_text
    color pending_bg
    color pending_text
    color skip_bg
    color skip_text
    int line_tr1
    int line_tr2
    int label_tr

type LabelStack
    array<float> prices
    array<label> labels

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  THEME PALETTES                                                             │
// └─────────────────────────────────────────────────────────────────────────────┘

getDarkPalette() =>
    ThemePalette.new(
     color.new(#0f172a,0), color.new(#1e293b,0), color.new(#334155,60),
     color.new(#f1f5f9,0), color.new(#cbd5e1,0), color.new(#94a3b8,0),
     color.new(#0ea5e9,0), color.new(#ef4444,0), color.new(#10b981,0),
     color.new(#f59e0b,0), color.new(#f97316,0),
     color.new(#22c55e,0), color.new(#ef4444,0), color.new(#6b7280,0),
     color.new(#f59e0b,0), color.new(#8b5cf6,0),
     color.new(#1e3a5f,0), color.new(#60a5fa,0),
     color.new(#166534,0), color.new(#dcfce7,0),
     color.new(#92400e,0), color.new(#fef3c7,0),
     color.new(#7f1d1d,0), color.new(#fecaca,0),
     25, 40, 0)

getLightPalette() =>
    ThemePalette.new(
     color.new(#ffffff,0), color.new(#f8fafc,0), color.new(#cbd5e1,60),
     color.new(#0f172a,0), color.new(#475569,0), color.new(#78716c,0),
     color.new(#0369a1,0), color.new(#dc2626,0), color.new(#059669,0),
     color.new(#d97706,0), color.new(#ea580c,0),
     color.new(#16a34a,0), color.new(#dc2626,0), color.new(#6b7280,0),
     color.new(#ea580c,0), color.new(#7c3aed,0),
     color.new(#e0f2fe,0), color.new(#0369a1,0),
     color.new(#dcfce7,0), color.new(#166534,0),
     color.new(#fef3c7,0), color.new(#92400e,0),
     color.new(#fee2e2,0), color.new(#991b1b,0),
     35, 50, 0)

isDark = i_theme == "Dark" or i_theme == "Auto"
getPal() => isDark ? getDarkPalette() : getLightPalette()

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  UTILITY FUNCTIONS                                                          │
// └─────────────────────────────────────────────────────────────────────────────┘

getSz(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Huge"   => size.huge
        "Normal" => size.normal
        => size.normal

getLnSty(string s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

getPos(string s) =>
    switch s
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

probClr(float p) => p >= 75 ? color.new(#16a34a,0) : p >= 60 ? color.new(#f59e0b,0) : color.new(#6b7280,0)

// Check if price was hit on current bar
checkHit(float price) => not na(price) and low <= price and price <= high

// Extend a line + its label to current bar
extendLevel(line ln, label lbl) =>
    if not na(ln)
        line.set_x2(ln, bar_index + i_lineOff)
        if i_showLabels and not na(lbl)
            label.set_x(lbl, bar_index + i_labelOff)

// Dashboard row helper — returns next row index
addRow(table t, int r, string name, color clr, float prob, bool hit, string sz, ThemePalette pal) =>
    table.cell(t, 0, r, name, text_color=clr, bgcolor=pal.bg_secondary, text_size=sz)
    table.cell(t, 1, r, str.tostring(prob, "#.0") + "%", text_color=probClr(prob), bgcolor=pal.bg_secondary, text_size=sz)
    color hBg = hit ? pal.validated_bg : pal.pending_bg
    color hTx = hit ? pal.validated_text : pal.pending_text
    table.cell(t, 2, r, hit ? "✓ Hit" : "Pending", bgcolor=hBg, text_color=hTx, text_size=sz)
    r + 1

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  LABEL STACK (anti-overlap system)                                          │
// └─────────────────────────────────────────────────────────────────────────────┘

var LStack = LabelStack.new(array.new_float(), array.new_label())

method drawLevelLabel(LabelStack self, float y, string txt, color clr, string szStr) =>
    if not na(y)
        int idx = -1
        if self.prices.size() > 0
            for i = 0 to self.prices.size() - 1
                if math.abs(self.prices.get(i) - y) < syminfo.mintick * 2
                    idx := i
                    break
        if idx == -1
            self.prices.push(y)
            lbl = label.new(bar_index + i_labelOff, y, txt, style=label.style_none, textcolor=clr, size=getSz(i_labelSize), text_font_family=font.family_monospace)
            self.labels.push(lbl)
            lbl
        else
            label lbl = self.labels.get(idx)
            label.set_text(lbl, label.get_text(lbl) + " + " + txt)
            lbl
    else
        label(na)

method clearAll(LabelStack self) =>
    if self.labels.size() > 0
        for i = 0 to self.labels.size() - 1
            label.delete(self.labels.get(i))
    self.prices.clear()
    self.labels.clear()

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  TICKER DETECTION                                                           │
// └─────────────────────────────────────────────────────────────────────────────┘

r = syminfo.root
is_nq  = str.contains(r,"NQ") or str.contains(r,"MNQ")
is_es  = str.contains(r,"ES") or str.contains(r,"MES")
is_rty = str.contains(r,"RTY") or str.contains(r,"M2K")
is_ym  = str.contains(r,"YM") or str.contains(r,"MYM")
is_cl  = str.contains(r,"CL") or str.contains(r,"MCL")
is_gc  = str.contains(r,"GC") or str.contains(r,"MGC")
is_commodity = is_cl or is_gc

// Instrument index for probability lookups: NQ=0 ES=1 RTY=2 YM=3 CL=4 GC=5
int IX = is_nq ? 0 : is_es ? 1 : is_rty ? 2 : is_ym ? 3 : is_cl ? 4 : is_gc ? 5 : 0

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  TIME HELPERS & SESSION DETECTION                                           │
// └─────────────────────────────────────────────────────────────────────────────┘

curH = hour(time, i_tz)
curM = minute(time, i_tz)
hhmm = curH * 100 + curM
curDay = dayofmonth(time, i_tz)
curDOW = dayofweek(time, i_tz)

inAsia   = hhmm >= 1930 or hhmm < 230
inLondon = hhmm >= 230 and hhmm < 800
inPreMkt = hhmm >= 800 and hhmm < 930
inNYAM   = hhmm >= 930 and hhmm < 1200
inLunch  = hhmm >= 1200 and hhmm < 1330
inNYPM   = hhmm >= 1330 and hhmm < 1600
inP12    = hhmm >= 1800 or hhmm < 600
inNY     = inNYAM or inLunch or inNYPM  // convenience

string curSession = inAsia ? "ASIA" : inLondon ? "LONDON" : inPreMkt ? "PRE-MKT" : inNYAM ? "NY AM" : inLunch ? "LUNCH" : inNYPM ? "NY PM" : "CLOSED"

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  SESSION STATE                                                              │
// └─────────────────────────────────────────────────────────────────────────────┘

var float asiaH = na, var float asiaL = na, var float asiaMid = na
var float lonH  = na, var float lonL  = na, var float lonMid = na
var float amH   = na, var float amL   = na, var float amMid  = na
var float lchH  = na, var float lchL  = na, var float lchMid = na
var float pmH   = na, var float pmL   = na
var float onH   = na, var float onL   = na, var float onMid  = na
var float p12H  = na, var float p12L  = na, var float p12Mid = na
var float h78H  = na, var float h78L  = na
var float glxOpen = na, var float mnOpen = na, var float o730 = na
var float rthOpen = na, var float pmOpen = na
var int asiaBar0 = na, var int lonBar0 = na, var int amBar0 = na

// Gap tracking
var float rthGap = na, var string gapDir = "—"
var bool gapChasing = false, var float gapPts = na

// London sweep order (Judas detection)
var int lonHighTime = na, var int lonLowTime = na
var int lonHighFirst = 0
var bool isJudas = false

// Daily high/low
var float dayH = na, var float dayL = na
var int dayHH = na, var int dayHM = na, var int dayLH = na, var int dayLM = na

// Range percentile arrays
var array<float> asiaRanges   = array.new_float()
var array<float> londonRanges = array.new_float()
var array<float> nyRanges     = array.new_float()

// Daily data
[pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)
[vvixH, vvixL, vvixC] = request.security("VVIX", "D", [high, low, close], barmerge.gaps_off, barmerge.lookahead_on)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  HIT TRACKING                                                               │
// └─────────────────────────────────────────────────────────────────────────────┘

var bool hitLonH = false, var bool hitLonL = false, var bool hitLonMid = false
var bool hitAsiaH = false, var bool hitAsiaL = false, var bool hitAsiaMid = false
var bool hitOnMid = false, var bool hit78Mid = false
var bool hitMnOpen = false, var bool hit730 = false
var bool hitOTEBull = false, var bool hitOTEBear = false
var bool hitGlx = false, var bool hitPDC = false
var bool hitPDH = false, var bool hitPDL = false
var bool hitSig1P = false, var bool hitSig1N = false
var bool hitSig2P = false, var bool hitSig2N = false
var bool hitAMH = false, var bool hitAML = false
var bool hitLchH = false, var bool hitLchL = false
var bool hitP12H = false, var bool hitP12L = false, var bool hitP12Mid = false
var bool londonClosed = false

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  LINE / LABEL STATE                                                         │
// └─────────────────────────────────────────────────────────────────────────────┘

var line lnLonH = na, var line lnLonL = na, var line lnLonMid = na
var line lnAsiaH = na, var line lnAsiaL = na, var line lnAsiaMid = na
var line ln78Mid = na, var line ln730 = na, var line lnMnOpen = na
var line lnOnMid = na, var line lnOTEBull = na, var line lnOTEBear = na
var line lnGlx = na
var line lnPDC = na, var line lnPDH = na, var line lnPDL = na
var line lnSig1P = na, var line lnSig1N = na, var line lnSig2P = na, var line lnSig2N = na
var line lnAMH = na, var line lnAML = na
var line lnLchH = na, var line lnLchL = na
var line lnP12H = na, var line lnP12L = na, var line lnP12Mid = na

var label lblLonH = na, var label lblLonL = na, var label lblLonMid = na
var label lblAsiaH = na, var label lblAsiaL = na, var label lblAsiaMid = na
var label lbl78Mid = na, var label lbl730 = na, var label lblMnOpen = na
var label lblOnMid = na, var label lblOTEBull = na, var label lblOTEBear = na
var label lblGlx = na
var label lblPDC = na, var label lblPDH = na, var label lblPDL = na
var label lblSig1P = na, var label lblSig1N = na, var label lblSig2P = na, var label lblSig2N = na
var label lblAMH = na, var label lblAML = na
var label lblLchH = na, var label lblLchL = na
var label lblP12H = na, var label lblP12L = na, var label lblP12Mid = na
var label lblDayH = na, var label lblDayL = na

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  NEW DAY RESET                                                              │
// └─────────────────────────────────────────────────────────────────────────────┘

var int lastDay = -1
isNewDay = false
if hhmm >= 1700 and hhmm < 1801 and curDay != lastDay
    isNewDay := true
    lastDay  := curDay

if isNewDay
    // Session prices
    asiaH := na
    asiaL := na
    asiaMid := na
    lonH  := na
    lonL  := na
    lonMid := na
    amH   := na
    amL   := na
    amMid  := na
    lchH  := na
    lchL  := na
    lchMid := na
    pmH   := na
    pmL   := na
    onH   := na
    onL   := na
    onMid  := na
    p12H  := na
    p12L  := na
    p12Mid := na
    h78H  := na
    h78L  := na
    glxOpen := open
    mnOpen := na
    o730 := na
    rthOpen := na
    pmOpen := na
    asiaBar0 := na
    lonBar0 := na
    amBar0 := na
    // Daily H/L
    dayH := na
    dayL := na
    dayHH := na
    dayHM := na
    dayLH := na
    dayLM := na
    // Gap / Judas
    rthGap := na
    gapDir := "—"
    gapChasing := false
    gapPts := na
    lonHighTime := na
    lonLowTime := na
    lonHighFirst := 0
    isJudas := false
    londonClosed := false
    // Labels — delete Day H/L labels explicitly (they bypass LabelStack)
    label.delete(lblDayH)
    label.delete(lblDayL)
    LStack.clearAll()

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  SESSION TRACKING                                                           │
// └─────────────────────────────────────────────────────────────────────────────┘

// Asia
if inAsia
    if na(asiaBar0)
        asiaBar0 := bar_index
    asiaH := na(asiaH) ? high : math.max(asiaH, high)
    asiaL := na(asiaL) ? low  : math.min(asiaL, low)
    asiaMid := (asiaH + asiaL) / 2.0

if not inAsia and inAsia[1] and not na(asiaH) and not na(asiaL)
    asiaRanges.push(asiaH - asiaL)
    if asiaRanges.size() > i_rngLB
        asiaRanges.shift()

// London (with sweep order tracking)
if inLondon
    if na(lonBar0)
        lonBar0 := bar_index
    if not na(asiaH) and high > asiaH and na(lonHighTime)
        lonHighTime := time
    if not na(asiaL) and low < asiaL and na(lonLowTime)
        lonLowTime  := time
    lonH   := na(lonH) ? high : math.max(lonH, high)
    lonL   := na(lonL) ? low  : math.min(lonL, low)
    lonMid := (lonH + lonL) / 2.0

if not inLondon and inLondon[1]
    londonClosed := true
    if not na(lonH) and not na(lonL)
        londonRanges.push(lonH - lonL)
        if londonRanges.size() > i_rngLB
            londonRanges.shift()
        // Sweep order
        if not na(lonHighTime) and not na(lonLowTime)
            lonHighFirst := lonHighTime < lonLowTime ? 1 : -1
        else if not na(lonHighTime)
            lonHighFirst := 1
        else if not na(lonLowTime)
            lonHighFirst := -1
        else
            lonHighFirst := 0

// NY AM
if inNYAM
    if na(amBar0)
        amBar0 := bar_index
    amH   := na(amH) ? high : math.max(amH, high)
    amL   := na(amL) ? low  : math.min(amL, low)
    amMid := (amH + amL) / 2.0

// Lunch
if inLunch
    lchH   := na(lchH) ? high : math.max(lchH, high)
    lchL   := na(lchL) ? low  : math.min(lchL, low)
    lchMid := (lchH + lchL) / 2.0

// NY PM
if inNYPM
    pmH := na(pmH) ? high : math.max(pmH, high)
    pmL := na(pmL) ? low  : math.min(pmL, low)

// NY range capture at 4PM
is_4pm = hhmm >= 1600 and hhmm < 1615
if is_4pm and not is_4pm[1] and not na(amH) and not na(pmL)
    nyRanges.push(math.max(amH, nz(pmH, amH)) - math.min(amL, nz(pmL, amL)))
    if nyRanges.size() > i_rngLB
        nyRanges.shift()

// Overnight
if hhmm >= 1800 or hhmm < 930
    onH   := na(onH) ? high : math.max(onH, high)
    onL   := na(onL) ? low  : math.min(onL, low)
    onMid := (onH + onL) / 2.0

// 7-8 AM range
if curH == 7
    h78H := na(h78H) ? high : math.max(h78H, high)
    h78L := na(h78L) ? low  : math.min(h78L, low)

// Key opens
if curH == 0 and curM == 0 and na(mnOpen)
    mnOpen  := open
if curH == 7 and curM == 30 and na(o730)
    o730    := open
if curH == 9 and curM == 30 and na(rthOpen)
    rthOpen := open
    rthGap  := open - pdC
    gapPts  := math.abs(rthGap)
    gapDir  := rthGap > 5 ? "UP" : rthGap < -5 ? "DOWN" : "FLAT"
if curH == 13 and curM == 30 and na(pmOpen)
    pmOpen := open

// P12 (18:00 to 06:00)
if inP12
    p12H   := na(p12H) ? high : math.max(p12H, high)
    p12L   := na(p12L) ? low  : math.min(p12L, low)
    p12Mid := (p12H + p12L) / 2.0

// Daily H/L
if hhmm >= 1800 or hhmm < 1600
    if na(dayH) or high > dayH
        dayH := high
        dayHH := hour(time, i_tz)
        dayHM := minute(time, i_tz)
    if na(dayL) or low < dayL
        dayL := low
        dayLH := hour(time, i_tz)
        dayLM := minute(time, i_tz)

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  PERCENTILE / CLASSIFICATION                                                │
// └─────────────────────────────────────────────────────────────────────────────┘

pctRank(float val, array<float> arr) =>
    if arr.size() < 2 or na(val)
        50.0
    else
        int below = 0
        for i = 0 to arr.size() - 1
            if arr.get(i) < val
                below += 1
        float(below) / float(arr.size()) * 100.0

float asiaPctl = not na(asiaH) and not na(asiaL) ? pctRank(asiaH - asiaL, asiaRanges) : na
float lonPctl  = not na(lonH) and not na(lonL)   ? pctRank(lonH - lonL, londonRanges)  : na
float nyRng    = not na(amH) and not na(amL) ? math.max(amH, nz(pmH, amH)) - math.min(amL, nz(pmL, amL)) : na
float nyPctl   = not na(nyRng) ? pctRank(nyRng, nyRanges) : na

sizeLabel(float pctl) => na(pctl) ? "—" : pctl < 25 ? "SMALL" : pctl < 50 ? "MED" : pctl < 75 ? "MED-LG" : "LARGE"
string asiaSize   = sizeLabel(asiaPctl)
string londonSize = sizeLabel(lonPctl)

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  PATTERN / MANIPULATION / JUDAS                                             │
// └─────────────────────────────────────────────────────────────────────────────┘

var string pattern      = "—"
var string manipulation = "NONE"
var string nyPos        = "—"
var string bias         = "WAITING"
var float  biasPct      = 0.0
var bool   isAligned    = false
var bool   isMisaligned = false

if not na(lonH) and not na(asiaH) and not na(asiaL)
    bool swH = lonH > asiaH, bool swL = lonL < asiaL
    if swH and not swL
        pattern := "PARTIAL UP"
        manipulation := "BEARISH"
    else if swL and not swH
        pattern := "PARTIAL DN"
        manipulation := "BULLISH"
    else if swH and swL
        pattern := "ENGULFS"
        manipulation := close > (asiaH + asiaL) / 2.0 ? "BEARISH" : "BULLISH"
    else
        pattern := "INSIDE"
        manipulation := "NONE"
    // Judas: faked one direction, committed opposite
    isJudas := (manipulation == "BULLISH" and lonHighFirst == 1) or
               (manipulation == "BEARISH" and lonHighFirst == -1)

if not na(lonMid)
    nyPos := close > lonMid ? "ABOVE" : "BELOW"

// Gap confluence
gapChasing := (manipulation == "BULLISH" and gapDir == "UP") or
              (manipulation == "BEARISH" and gapDir == "DOWN")

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  PROBABILITY ENGINE — Compressed Lookup Tables                              │
// └─────────────────────────────────────────────────────────────────────────────┘

// Pick value by instrument index (0=NQ,1=ES,2=RTY,3=YM,4=CL,5=GC)
_byIx(float a, float b, float c, float d, float e, float f) =>
    IX == 0 ? a : IX == 1 ? b : IX == 2 ? c : IX == 3 ? d : IX == 4 ? e : f

// Pattern+Position grid helper: 4 patterns × 2 positions = 8 values
_gp(float p1a, float p1b, float p2a, float p2b, float p3a, float p3b, float p4a, float p4b, string pat, string pos) =>
    bool above = pos == "ABOVE"
    if pat == "PARTIAL DN"
        above ? p1a : p1b
    else if pat == "PARTIAL UP"
        above ? p2a : p2b
    else if pat == "ENGULFS"
        above ? p3a : p3b
    else
        above ? p4a : p4b

// ── 72-Scenario Probability (refactored) ──────────────────────────────────────

get72ScenarioProb(string pat, string pos, string aSz, string lSz) =>
    float result = 50.0
    
    if is_commodity
        // Commodities: continuation model (trade WITH manipulation)
        float bullAbove = _byIx(50.0, 50.0, 50.0, 50.0, 58.0, 56.0)
        float bullBelow = _byIx(50.0, 50.0, 50.0, 50.0, 46.0, 47.0)
        float bearBelow = _byIx(50.0, 50.0, 50.0, 50.0, 57.0, 55.0)
        float bearAbove = _byIx(50.0, 50.0, 50.0, 50.0, 45.0, 46.0)
        float smAdj     = _byIx(0.0,  0.0,  0.0,  0.0,  3.0,  2.0)
        if manipulation == "BULLISH"
            result := pos == "ABOVE" ? bullAbove : bullBelow
            if aSz == "SMALL"
                result += smAdj
        else if manipulation == "BEARISH"
            result := pos == "BELOW" ? bearBelow : bearAbove
            if aSz == "SMALL"
                result += smAdj
    else
        // Equities: reversal model
        bool aligned    = (pat == "PARTIAL DN" and pos == "ABOVE") or (pat == "PARTIAL UP" and pos == "BELOW")
        bool misaligned = (pat == "PARTIAL DN" and pos == "BELOW") or (pat == "PARTIAL UP" and pos == "ABOVE")
        
        if aligned
            result := _byIx(84.0, 82.0, 80.0, 81.0, 50.0, 50.0)
            // Asia size adjustment
            if aSz == "SMALL"
                result += 4.0
            else if aSz == "MED"
                result -= 2.0
            else if aSz == "LARGE" or aSz == "MED-LG"
                result -= _byIx(6.0, 5.0, 4.0, 5.0, 0.0, 0.0)
            // London size adjustment
            if lSz == "SMALL"
                result += _byIx(3.0, 2.0, 2.0, 2.0, 0.0, 0.0)
            else if lSz == "LARGE" or lSz == "MED-LG"
                result -= _byIx(5.0, 4.0, 3.0, 4.0, 0.0, 0.0)
        
        else if misaligned
            result := _byIx(52.0, 51.0, 50.0, 51.0, 50.0, 50.0)
            if aSz == "SMALL"
                result += 2.0
            if lSz == "SMALL"
                result += 2.0
        
        else if pat == "ENGULFS"
            result := pos == "ABOVE" ? _byIx(68.0, 66.0, 64.0, 65.0, 50.0, 50.0) : _byIx(66.0, 64.0, 62.0, 63.0, 50.0, 50.0)
            if aSz == "SMALL"
                result += _byIx(3.0, 2.0, 2.0, 2.0, 0.0, 0.0)
            if lSz == "LARGE"
                result -= _byIx(4.0, 4.0, 3.0, 3.0, 0.0, 0.0)
        
        else  // INSIDE
            result := 50.0
    result

// ── Adjustment Factors ────────────────────────────────────────────────────────

getDOWAdj() =>
    curDOW == dayofweek.tuesday ? 1.05 : curDOW == dayofweek.wednesday ? 1.03 : curDOW == dayofweek.monday ? 0.96 : curDOW == dayofweek.friday ? 0.98 : 1.0

// ── Conditional Level Probabilities ───────────────────────────────────────────

getCondProbLonH(string pat, string pos) =>
    if is_nq
        _gp(77.9,17.4, 77.2,18.5, 74.9,16.1, 80.4,21.8, pat,pos)
    else if is_es
        _gp(79.3,17.1, 79.7,20.9, 77.4,13.5, 79.0,23.3, pat,pos)
    else if is_rty
        _gp(76.8,19.2, 75.4,20.8, 73.6,17.9, 78.1,24.2, pat,pos)
    else if is_ym
        _gp(78.2,18.1, 77.8,19.4, 75.9,15.8, 79.5,22.7, pat,pos)
    else if is_cl
        _gp(71.2,24.6, 70.5,26.1, 68.8,22.4, 73.4,28.9, pat,pos)
    else if is_gc
        _gp(69.4,26.8, 68.1,28.3, 66.7,24.9, 71.2,31.1, pat,pos)
    else
        50.0

