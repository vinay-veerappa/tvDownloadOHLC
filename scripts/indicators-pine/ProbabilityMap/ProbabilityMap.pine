getCondProbMN(string pat, string pos) =>
    if is_nq
        _gp(86.3,63.1, 62.6,87.8, 77.9,81.1, 71.2,76.8, pat,pos)
    else if is_es
        _gp(84.7,61.8, 60.9,86.2, 76.4,79.6, 69.8,75.1, pat,pos)
    else if is_rty
        _gp(82.4,59.6, 58.2,83.9, 74.1,77.3, 67.5,72.8, pat,pos)
    else if is_ym
        _gp(83.8,60.4, 59.7,85.1, 75.6,78.2, 68.4,73.9, pat,pos)
    else if is_cl
        _gp(74.2,56.8, 55.4,75.6, 68.1,70.9, 62.3,66.4, pat,pos)
    else if is_gc
        _gp(71.6,54.2, 52.8,72.9, 65.4,68.1, 59.7,63.8, pat,pos)
    else
        73.0

getP12H() => _byIx(67.4, 63.5, 65.1, 61.1, 51.4, 42.6)
getP12L() => _byIx(61.1, 58.4, 61.9, 57.5, 51.8, 42.1)
getP12M() => _byIx(72.7, 70.7, 70.8, 68.6, 60.5, 54.9)

// Global level probabilities
_gpg(float a, float b, float c, float d, float e, float f, float g, float h, float i2, float j, float k, float l, string lev) =>
    switch lev
        "07:30"       => a
        "ON Mid"      => b
        "OTE Bull"    => c
        "OTE Bear"    => d
        "Globex"      => e
        "Settlement"  => f
        "PDH"         => g
        "PDL"         => h
        "PM Hit AMH"  => i2
        "PM Hit AML"  => j
        "PM Hit LchH" => k
        "PM Hit LchL" => l
        => 50.0

getGlobalProb(string lev) =>
    if is_nq
        _gpg(79.8,77.6,78.3,76.1,63.9,63.6,47.1,40.0,41.1,33.2,62.3,54.4, lev)
    else if is_es
        _gpg(79.3,76.1,76.2,73.9,62.1,61.7,46.2,39.5,42.6,34.6,65.1,56.1, lev)
    else if is_rty
        _gpg(79.3,76.3,75.5,75.7,63.1,63.0,44.7,42.7,33.4,29.4,57.9,52.4, lev)
    else if is_ym
        _gpg(78.3,74.5,74.5,72.8,61.5,60.8,44.1,40.0,39.1,33.1,63.0,55.6, lev)
    else if is_cl
        _gpg(69.2,69.5,68.4,68.3,53.0,52.7,39.7,38.6,31.1,28.1,52.8,48.7, lev)
    else if is_gc
        _gpg(63.2,62.9,62.3,61.8,45.7,46.4,36.1,33.3,25.2,24.0,46.5,46.2, lev)
    else
        50.0

// Sigma probabilities: +1σ, -1σ, +2σ, -2σ × BEARISH/BULLISH/NEUTRAL
_gsp(float a,float b,float c, float d,float e,float f, float g,float h,float i2, float j,float k,float l, string sig, string man) =>
    int m = man == "BEARISH" ? 0 : man == "BULLISH" ? 1 : 2
    if sig == "+1"
        m == 0 ? a : m == 1 ? b : c
    else if sig == "-1"
        m == 0 ? d : m == 1 ? e : f
    else if sig == "+2"
        m == 0 ? g : m == 1 ? h : i2
    else
        m == 0 ? j : m == 1 ? k : l

getSigmaProb(string sig, string man) =>
    if is_nq
        _gsp(71.4,41.2,61.0, 43.7,73.1,56.2, 56.8,25.6,41.8, 27.2,58.3,40.7, sig,man)
    else if is_es
        _gsp(69.8,39.4,59.2, 41.8,71.2,54.6, 54.1,23.8,39.4, 25.4,55.6,38.2, sig,man)
    else if is_rty
        _gsp(68.2,40.6,58.4, 42.4,69.8,53.8, 52.4,24.9,38.6, 26.7,54.1,37.4, sig,man)
    else if is_ym
        _gsp(70.1,40.2,59.8, 42.1,71.6,55.2, 54.8,24.2,40.1, 25.8,56.2,38.9, sig,man)
    else if is_cl
        _gsp(62.4,44.8,54.6, 46.2,64.1,52.8, 46.8,28.4,36.2, 29.8,48.2,35.4, sig,man)
    else if is_gc
        _gsp(59.8,46.2,52.4, 47.8,61.4,51.2, 44.2,30.1,34.8, 31.4,45.6,33.6, sig,man)
    else
        50.0

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  BIAS CALCULATION                                                           │
// └─────────────────────────────────────────────────────────────────────────────┘

if not na(lonMid) and manipulation != "NONE"
    float baseProb = get72ScenarioProb(pattern, nyPos, asiaSize, londonSize)
    float adj = baseProb * getDOWAdj() * (gapChasing ? 1.12 : 1.0) * (isJudas ? 1.08 : 1.0)
    adj := math.max(math.min(adj, 95.0), 35.0)
    
    isAligned    := (manipulation == "BULLISH" and nyPos == "ABOVE") or (manipulation == "BEARISH" and nyPos == "BELOW")
    isMisaligned := (manipulation == "BULLISH" and nyPos == "BELOW") or (manipulation == "BEARISH" and nyPos == "ABOVE")
    
    if is_commodity
        bias    := manipulation == "BULLISH" ? "LONG (CONT)" : "SHORT (CONT)"
        biasPct := adj
    else
        if isAligned
            bias    := manipulation == "BULLISH" ? "LONG" : "SHORT"
            biasPct := adj
        else if isMisaligned
            bias    := "⚠ SKIP"
            biasPct := adj
        else
            bias    := "NEUTRAL"
            biasPct := 50.0

if manipulation == "NONE"
    bias := "NO SETUP"
    biasPct := 0.0
    isAligned := false
    isMisaligned := false

if isNewDay
    pattern := "—"
    manipulation := "NONE"
    nyPos := "—"
    bias := "WAITING"
    biasPct := 0.0
    isAligned := false
    isMisaligned := false

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  QUALITY SCORE                                                              │
// └─────────────────────────────────────────────────────────────────────────────┘

var int    qualityScore = 0
var string qualityTxt   = "—"

if not na(lonH) and not na(asiaH) and manipulation != "NONE"
    qualityScore := 0
    if isAligned
        qualityScore += 2
    if isJudas
        qualityScore += 1
    if gapChasing
        qualityScore += 1
    if curDOW == dayofweek.tuesday or curDOW == dayofweek.wednesday
        qualityScore += 1
    if asiaSize == "SMALL"
        qualityScore += 1
    if londonSize == "SMALL"
        qualityScore += 1
    if londonSize == "LARGE" or londonSize == "MED-LG"
        qualityScore -= 1
    if curDOW == dayofweek.monday
        qualityScore -= 1
    if isMisaligned
        qualityScore -= 2
    
    qualityTxt := qualityScore >= 5 ? "★★★★★" : qualityScore >= 4 ? "★★★★" : qualityScore >= 3 ? "★★★" : qualityScore >= 2 ? "★★" : qualityScore >= 1 ? "★" : "—"

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  REVERSAL TIMING                                                            │
// └─────────────────────────────────────────────────────────────────────────────┘

var string timingPhase = "—"
var float  timingPct   = 0.0
var string timingWarn  = ""

if inNY
    if hhmm < 1000
        timingPhase := "OPENING"
        timingPct := 60.6
        timingWarn := ""
    else if hhmm < 1030
        timingPhase := "MID-MORN"
        timingPct := 12.8
        timingWarn := ""
    else if hhmm < 1100
        timingPhase := "LATE-MORN"
        timingPct := 6.8
        timingWarn := "74% complete"
    else if hhmm < 1200
        timingPhase := "CLOSING"
        timingPct := 7.3
        timingWarn := "⚠ 81% complete"
    else if hhmm < 1330
        timingPhase := "LUNCH"
        timingPct := 5.4
        timingWarn := "⚠ 88% complete"
    else
        timingPhase := "PM"
        timingPct := 6.8
        timingWarn := "⚠ MANAGE ONLY"
else
    timingPhase := "—"
    timingPct := 0.0
    timingWarn := ""

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  HIT TRACKING — Reset & Check                                               │
// └─────────────────────────────────────────────────────────────────────────────┘

// Single reset point: NY AM open (covers both pre-market and AM)
if isNewDay and not isNewDay[1]
    hitLonH    := false
    hitLonL    := false
    hitLonMid  := false
    hitAsiaH   := false
    hitAsiaL   := false
    hitAsiaMid := false
    hitOnMid   := false
    hit78Mid   := false
    hitMnOpen  := false
    hit730     := false
    hitOTEBull := false
    hitOTEBear := false
    hitGlx     := false
    hitPDC     := false
    hitPDH     := false
    hitPDL     := false
    hitSig1P   := false
    hitSig1N   := false
    hitSig2P   := false
    hitSig2N   := false
    hitAMH     := false
    hitAML     := false
    hitLchH    := false
    hitLchL    := false
    hitP12H    := false
    hitP12L    := false
    hitP12Mid  := false

if inNYAM or inLunch or inNYPM or inPreMkt
    if londonClosed
        if checkHit(lonH)
            hitLonH := true
        if checkHit(lonL)
            hitLonL := true
        if checkHit(lonMid)
            hitLonMid := true
    
    if checkHit(asiaH)
        hitAsiaH  := true
    if checkHit(asiaL)
        hitAsiaL  := true
    if checkHit(asiaMid)
        hitAsiaMid := true
    if checkHit(onMid)
        hitOnMid  := true
    if checkHit(p12H)
        hitP12H   := true
    if checkHit(p12L)
        hitP12L   := true
    if checkHit(p12Mid)
        hitP12Mid := true
    
    float v78m = not na(h78H) and not na(h78L) ? (h78H + h78L) / 2.0 : na
    if checkHit(v78m)
        hit78Mid  := true
    if checkHit(mnOpen)
        hitMnOpen := true
    if checkHit(o730)
        hit730    := true
    
    float vOB = not na(onH) and not na(onL) ? onL + (onH - onL) * 0.62 : na
    float vOE = not na(onH) and not na(onL) ? onH - (onH - onL) * 0.62 : na
    if checkHit(vOB)
        hitOTEBull := true
    if checkHit(vOE)
        hitOTEBear := true
    if checkHit(glxOpen)
        hitGlx := true
    if checkHit(pdC)
        hitPDC := true
    if checkHit(pdH)
        hitPDH := true
    if checkHit(pdL)
        hitPDL := true
    
    float cbdr = not na(asiaH) and not na(asiaL) ? asiaH - asiaL : na
    if not na(cbdr) and cbdr > 0
        if checkHit(asiaH + cbdr)
            hitSig1P := true
        if checkHit(asiaL - cbdr)
            hitSig1N := true
        if checkHit(asiaH + 2*cbdr)
            hitSig2P := true
        if checkHit(asiaL - 2*cbdr)
            hitSig2N := true
    
    if (inLunch or inNYPM) and not na(amH)
        if checkHit(amH)
            hitAMH := true
        if checkHit(amL)
            hitAML := true
    
    if inNYPM and not na(lchH)
        if checkHit(lchH)
            hitLchH := true
        if checkHit(lchL)
            hitLchL := true

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  DRAWING — Level Lines & Labels                                             │
// └─────────────────────────────────────────────────────────────────────────────┘

p = getPal()

// London levels (drawn when London closes)
if i_showLevels and i_showLondon and not inLondon and inLondon[1] and not na(lonH)
    line.delete(lnLonH)
    line.delete(lnLonL)
    line.delete(lnLonMid)
    float pLH = getCondProbLonH(pattern, nyPos)
    float pLL = getCondProbLonL(pattern, nyPos)
    lnLonH   := line.new(lonBar0, lonH, bar_index + i_lineOff, lonH, color=color.new(i_cLondon, p.line_tr1), style=getLnSty(i_londonSty), width=i_londonW)
    lnLonL   := line.new(lonBar0, lonL, bar_index + i_lineOff, lonL, color=color.new(i_cLondon, p.line_tr1), style=getLnSty(i_londonSty), width=i_londonW)
    lnLonMid := line.new(lonBar0, lonMid, bar_index + i_lineOff, lonMid, color=color.new(p.caution, p.line_tr2), style=line.style_dotted, width=1)
    if i_showLabels
        lblLonH   := LStack.drawLevelLabel(lonH, str.format("Lon H: {0,number,#.#}%", pLH), i_cLondon, i_labelSize)
        lblLonL   := LStack.drawLevelLabel(lonL, str.format("Lon L: {0,number,#.#}%", pLL), i_cLondon, i_labelSize)
        lblLonMid := LStack.drawLevelLabel(lonMid, str.format("Lon Mid: {0,number,#.#}%", getCondProbLonMid(pattern, nyPos)), p.caution, i_labelSize)

// Asia levels (drawn when Asia closes)
if i_showLevels and i_showAsia and not inAsia and inAsia[1] and not na(asiaH)
    line.delete(lnAsiaH)
    line.delete(lnAsiaL)
    line.delete(lnAsiaMid)
    lnAsiaH := line.new(asiaBar0, asiaH, bar_index + i_lineOff, asiaH, color=color.new(i_cAsia, p.line_tr2), style=getLnSty(i_asiaSty), width=i_asiaW)
    lnAsiaL := line.new(asiaBar0, asiaL, bar_index + i_lineOff, asiaL, color=color.new(i_cAsia, p.line_tr2), style=getLnSty(i_asiaSty), width=i_asiaW)
    lnAsiaMid := line.new(asiaBar0, asiaMid, bar_index + i_lineOff, asiaMid, color=color.new(i_cAsia, p.line_tr2), style=line.style_dotted, width=1)
    if i_showLabels
        lblAsiaH := LStack.drawLevelLabel(asiaH, str.format("Asia H: {0,number,#.#}%", getCondProbAsiaH(pattern, nyPos)), i_cAsia, i_labelSize)
        lblAsiaL := LStack.drawLevelLabel(asiaL, str.format("Asia L: {0,number,#.#}%", getCondProbAsiaL(pattern, nyPos)), i_cAsia, i_labelSize)
        lblAsiaMid := LStack.drawLevelLabel(asiaMid, str.format("Asia Mid: {0,number,#.#}%", getCondProbAsiaMid(pattern, nyPos)), i_cAsia, i_labelSize)

// P12 levels (drawn when P12 closes)
if i_showLevels and i_showP12 and not inP12 and inP12[1] and not na(p12H)
    line.delete(lnP12H)
    line.delete(lnP12L)
    line.delete(lnP12Mid)
    lnP12H   := line.new(bar_index - 1, p12H, bar_index + i_lineOff, p12H, color=color.new(i_cON, p.line_tr2), style=getLnSty(i_p12Sty), width=i_p12W)
    lnP12L   := line.new(bar_index - 1, p12L, bar_index + i_lineOff, p12L, color=color.new(i_cON, p.line_tr2), style=getLnSty(i_p12Sty), width=i_p12W)
    lnP12Mid := line.new(bar_index - 1, p12Mid, bar_index + i_lineOff, p12Mid, color=color.new(p.caution, p.line_tr2), style=line.style_dotted, width=1)
    if i_showLabels
        lblP12H   := LStack.drawLevelLabel(p12H, str.format("P12 H: {0,number,#.#}%", getP12H()), i_cON, i_labelSize)
        lblP12L   := LStack.drawLevelLabel(p12L, str.format("P12 L: {0,number,#.#}%", getP12L()), i_cON, i_labelSize)
        lblP12Mid := LStack.drawLevelLabel(p12Mid, str.format("P12 Mid: {0,number,#.#}%", getP12M()), p.caution, i_labelSize)

// Intraday levels (drawn at pre-market open)
if i_showLevels and inPreMkt and not inPreMkt[1]
    // 7-8 Mid
    float v78 = not na(h78H) and not na(h78L) ? (h78H + h78L) / 2.0 : na
    if i_show78Mid and not na(v78)
        line.delete(ln78Mid)
        ln78Mid := line.new(bar_index, v78, bar_index + i_lineOff, v78, color=color.new(p.confirm, p.line_tr1), style=getLnSty(i_78Sty), width=i_78W)
        if i_showLabels
            lbl78Mid := LStack.drawLevelLabel(v78, str.format("78 Mid: {0,number,#.#}%", getCondProb78Mid()), p.confirm, i_labelSize)
    
    // 07:30 Open
    if i_show730 and not na(o730)
        line.delete(ln730)
        ln730 := line.new(bar_index, o730, bar_index + i_lineOff, o730, color=color.new(p.caution, p.line_tr1), style=getLnSty(i_730Sty), width=i_730W)
        if i_showLabels
            lbl730 := LStack.drawLevelLabel(o730, str.format("07:30: {0,number,#.#}%", getGlobalProb("07:30")), p.caution, i_labelSize)
    
    // Midnight Open
    if i_showMN and not na(mnOpen)
        line.delete(lnMnOpen)
        lnMnOpen := line.new(bar_index, mnOpen, bar_index + i_lineOff, mnOpen, color=color.new(p.text_primary, p.line_tr2), style=getLnSty(i_mnSty), width=i_mnW)
        if i_showLabels
            lblMnOpen := LStack.drawLevelLabel(mnOpen, str.format("MN: {0,number,#.#}%", getCondProbMN(pattern, nyPos)), p.text_primary, i_labelSize)
    
    // ON Mid
    if i_showONMid and not na(onMid)
        line.delete(lnOnMid)
        lnOnMid := line.new(bar_index, onMid, bar_index + i_lineOff, onMid, color=color.new(p.confirm, p.line_tr2), style=getLnSty(i_onmSty), width=i_onmW)
        if i_showLabels
            lblOnMid := LStack.drawLevelLabel(onMid, str.format("ON Mid: {0,number,#.#}%", getGlobalProb("ON Mid")), p.confirm, i_labelSize)
    
    // OTE Zones
    float vOB = not na(onH) and not na(onL) ? onL + (onH - onL) * 0.62 : na
    float vOE = not na(onH) and not na(onL) ? onH - (onH - onL) * 0.62 : na
    if i_showOTE and not na(vOB)
        line.delete(lnOTEBull)
        lnOTEBull := line.new(bar_index, vOB, bar_index + i_lineOff, vOB, color=color.new(p.bullish, p.line_tr2), style=getLnSty(i_oteSty), width=i_oteW)
        if i_showLabels
            lblOTEBull := LStack.drawLevelLabel(vOB, str.format("OTE Bull: {0,number,#.#}%", getGlobalProb("OTE Bull")), p.bullish, i_labelSize)
    if i_showOTE and not na(vOE)
        line.delete(lnOTEBear)
        lnOTEBear := line.new(bar_index, vOE, bar_index + i_lineOff, vOE, color=color.new(p.bearish, p.line_tr2), style=getLnSty(i_oteSty), width=i_oteW)
        if i_showLabels
            lblOTEBear := LStack.drawLevelLabel(vOE, str.format("OTE Bear: {0,number,#.#}%", getGlobalProb("OTE Bear")), p.bearish, i_labelSize)
    
    // Globex Open
    if i_showGlx and not na(glxOpen)
        line.delete(lnGlx)
        lnGlx := line.new(bar_index, glxOpen, bar_index + i_lineOff, glxOpen, color=color.new(p.neutral, p.line_tr2), style=getLnSty(i_glxSty), width=i_glxW)
        if i_showLabels
            lblGlx := LStack.drawLevelLabel(glxOpen, str.format("Globex: {0,number,#.#}%", getGlobalProb("Globex")), p.neutral, i_labelSize)
    
    // Settlement/PDC
    if i_showPDC and not na(pdC)
        line.delete(lnPDC)
        lnPDC := line.new(bar_index, pdC, bar_index + i_lineOff, pdC, color=color.new(i_cPrior, p.line_tr1), style=getLnSty(i_pdcSty), width=i_pdcW)
        if i_showLabels
            lblPDC := LStack.drawLevelLabel(pdC, str.format("Settlement: {0,number,#.#}%", getGlobalProb("Settlement")), i_cPrior, i_labelSize)
    
    // PDH / PDL
    if i_showPDHL and not na(pdH)
        line.delete(lnPDH)
        lnPDH := line.new(bar_index, pdH, bar_index + i_lineOff, pdH, color=color.new(i_cPrior, p.line_tr1), style=getLnSty(i_pdhlSty), width=i_pdhlW)
        if i_showLabels
            lblPDH := LStack.drawLevelLabel(pdH, str.format("PDH: {0,number,#.#}%", getGlobalProb("PDH")), i_cPrior, i_labelSize)
    if i_showPDHL and not na(pdL)
        line.delete(lnPDL)
        lnPDL := line.new(bar_index, pdL, bar_index + i_lineOff, pdL, color=color.new(i_cPrior, p.line_tr1), style=getLnSty(i_pdhlSty), width=i_pdhlW)
        if i_showLabels
            lblPDL := LStack.drawLevelLabel(pdL, str.format("PDL: {0,number,#.#}%", getGlobalProb("PDL")), i_cPrior, i_labelSize)
    
    // CBDR Sigma levels
    float cbdr = not na(asiaH) and not na(asiaL) ? asiaH - asiaL : na
    if i_showSigma and not na(cbdr) and cbdr > 0
        line.delete(lnSig1P)
        line.delete(lnSig1N)
        line.delete(lnSig2P)
        line.delete(lnSig2N)
        lnSig1P := line.new(bar_index, asiaH + cbdr,     bar_index + i_lineOff, asiaH + cbdr,     color=color.new(i_cSigUp, p.line_tr2), style=getLnSty(i_sigSty), width=i_sigW)
        lnSig1N := line.new(bar_index, asiaL - cbdr,     bar_index + i_lineOff, asiaL - cbdr,     color=color.new(i_cSigDn, p.line_tr2), style=getLnSty(i_sigSty), width=i_sigW)
        lnSig2P := line.new(bar_index, asiaH + 2*cbdr,   bar_index + i_lineOff, asiaH + 2*cbdr,   color=color.new(i_cSigUp, p.line_tr2), style=getLnSty(i_sigSty), width=i_sigW)
        lnSig2N := line.new(bar_index, asiaL - 2*cbdr,   bar_index + i_lineOff, asiaL - 2*cbdr,   color=color.new(i_cSigDn, p.line_tr2), style=getLnSty(i_sigSty), width=i_sigW)
        if i_showLabels
            lblSig1P := LStack.drawLevelLabel(asiaH + cbdr,   str.format("+1σ: {0,number,#.#}%", getSigmaProb("+1", manipulation)), i_cSigUp, i_labelSize)
            lblSig1N := LStack.drawLevelLabel(asiaL - cbdr,   str.format("-1σ: {0,number,#.#}%", getSigmaProb("-1", manipulation)), i_cSigDn, i_labelSize)
            lblSig2P := LStack.drawLevelLabel(asiaH + 2*cbdr, str.format("+2σ: {0,number,#.#}%", getSigmaProb("+2", manipulation)), i_cSigUp, i_labelSize)
            lblSig2N := LStack.drawLevelLabel(asiaL - 2*cbdr, str.format("-2σ: {0,number,#.#}%", getSigmaProb("-2", manipulation)), i_cSigDn, i_labelSize)

// ── Extend all lines during NY ──────────────────────────────────────────────
if i_showLevels and inNY
    extendLevel(lnLonH, lblLonH)
    extendLevel(lnLonL, lblLonL)
    extendLevel(lnLonMid, lblLonMid)
    extendLevel(lnAsiaH, lblAsiaH)
    extendLevel(lnAsiaL, lblAsiaL)
    extendLevel(lnAsiaMid, lblAsiaMid)
    extendLevel(ln78Mid, lbl78Mid)
    extendLevel(ln730, lbl730)
    extendLevel(lnMnOpen, lblMnOpen)
    extendLevel(lnOnMid, lblOnMid)
    extendLevel(lnOTEBull, lblOTEBull)
    extendLevel(lnOTEBear, lblOTEBear)
    extendLevel(lnGlx, lblGlx)
    extendLevel(lnPDC, lblPDC)
    extendLevel(lnPDH, lblPDH)
    extendLevel(lnPDL, lblPDL)
    extendLevel(lnSig1P, lblSig1P)
    extendLevel(lnSig1N, lblSig1N)
    extendLevel(lnSig2P, lblSig2P)
    extendLevel(lnSig2N, lblSig2N)
    extendLevel(lnP12H, lblP12H)
    extendLevel(lnP12L, lblP12L)
    extendLevel(lnP12Mid, lblP12Mid)

// AM H/L (drawn at lunch start)
if i_showLevels and i_showAM and inLunch and not inLunch[1] and not na(amH)
    line.delete(lnAMH)
    line.delete(lnAML)
    lnAMH := line.new(amBar0, amH, bar_index + i_lineOff, amH, color=color.new(p.bullish, p.line_tr2), style=getLnSty(i_amSty), width=i_amW)
    lnAML := line.new(amBar0, amL, bar_index + i_lineOff, amL, color=color.new(p.bearish, p.line_tr2), style=getLnSty(i_amSty), width=i_amW)
    if i_showLabels
        lblAMH := LStack.drawLevelLabel(amH, str.format("AM H: {0,number,#.#}%", getGlobalProb("PM Hit AMH")), p.bullish, i_labelSize)
        lblAML := LStack.drawLevelLabel(amL, str.format("AM L: {0,number,#.#}%", getGlobalProb("PM Hit AML")), p.bearish, i_labelSize)

// Lunch H/L (drawn at PM start)
if i_showLevels and i_showLch and inNYPM and not inNYPM[1] and not na(lchH)
    line.delete(lnLchH)
    line.delete(lnLchL)
    lnLchH := line.new(bar_index - 10, lchH, bar_index + i_lineOff, lchH, color=color.new(p.text_dim, p.line_tr2), style=getLnSty(i_lchSty), width=i_lchW)
    lnLchL := line.new(bar_index - 10, lchL, bar_index + i_lineOff, lchL, color=color.new(p.text_dim, p.line_tr2), style=getLnSty(i_lchSty), width=i_lchW)
    if i_showLabels
        lblLchH := LStack.drawLevelLabel(lchH, str.format("Lunch H: {0,number,#.#}%", getGlobalProb("PM Hit LchH")), p.text_dim, i_labelSize)
        lblLchL := LStack.drawLevelLabel(lchL, str.format("Lunch L: {0,number,#.#}%", getGlobalProb("PM Hit LchL")), p.text_dim, i_labelSize)

// Extend AM/Lunch during PM
if i_showLevels and (inLunch or inNYPM)
    extendLevel(lnAMH, lblAMH)
    extendLevel(lnAML, lblAML)
if i_showLevels and inNYPM
    extendLevel(lnLchH, lblLchH)
    extendLevel(lnLchL, lblLchL)

// Daily H/L labels (outside LabelStack — managed explicitly)
if i_showLevels and (hhmm >= 1800 or hhmm < 1600)
    if not na(dayH) and not na(dayHH) and dayH != dayH[1]
        label.delete(lblDayH)
        lblDayH := label.new(time, dayH, xloc=xloc.bar_time, text=str.format("{0,number,#.#} ({1,number,00}:{2,number,00})", dayH, dayHH, dayHM), style=label.style_label_down, textcolor=p.bullish, color=color.new(p.bullish, 80), size=getSz(i_labelSize), text_font_family=font.family_monospace)
    if not na(dayL) and not na(dayLH) and dayL != dayL[1]
        label.delete(lblDayL)
        lblDayL := label.new(time, dayL, xloc=xloc.bar_time, text=str.format("{0,number,#.#} ({1,number,00}:{2,number,00})", dayL, dayLH, dayLM), style=label.style_label_up, textcolor=p.bearish, color=color.new(p.bearish, 80), size=getSz(i_labelSize), text_font_family=font.family_monospace)

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  SESSION BOXES                                                              │
// └─────────────────────────────────────────────────────────────────────────────┘

var box asiaBox = na, var box lonBox = na

if i_showBoxes
    if inAsia and not na(asiaH)
        box.delete(asiaBox)
        asiaBox := box.new(nz(asiaBar0, bar_index), asiaH, bar_index, asiaL, border_color=color.new(p.asia_primary, 50), bgcolor=color.new(p.asia_primary, 93), border_width=1)
    if inLondon and not na(lonH)
        box.delete(lonBox)
        lonBox := box.new(nz(lonBar0, bar_index), lonH, bar_index, lonL, border_color=color.new(p.london_primary, 50), bgcolor=color.new(p.london_primary, 93), border_width=1)

// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  DASHBOARD                                                                  │
// └─────────────────────────────────────────────────────────────────────────────┘

var table tbl = na

if i_showDash and barstate.islast
    if not na(tbl)
        table.delete(tbl)
    tbl := table.new(getPos(i_dashPos), 3, 55, bgcolor=color.new(p.bg_primary, i_dashOpac), border_width=1, border_color=p.bg_border)
    sz = getSz(i_dashSz)
    int row = 0
    
    // ── Header ──
    table.cell(tbl, 0, row, "PROB ENGINE v5", text_color=p.header_text, bgcolor=p.header_bg, text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    // ── Session / Ticker ──
    sesClr = inNYAM ? p.ny_primary : inLondon ? p.london_primary : inAsia ? p.asia_primary : inNYPM ? p.caution : p.neutral
    table.cell(tbl, 0, row, "Session", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, curSession, text_color=sesClr, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, syminfo.root + (is_commodity ? " (CONT)" : ""), text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // ── Pattern / Manipulation ──
    patClr = manipulation == "BULLISH" ? p.bullish : manipulation == "BEARISH" ? p.bearish : p.neutral
    table.cell(tbl, 0, row, "Pattern", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, pattern, text_color=patClr, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, manipulation, text_color=patClr, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // ── Judas Sweep ──
    if lonHighFirst != 0
        table.cell(tbl, 0, row, "Sweep", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, lonHighFirst == 1 ? "H→L" : "L→H", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, isJudas ? "✓ JUDAS" : "Standard", text_color=isJudas ? p.bullish : p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    // ── Bias ──
    biasClr = bias == "LONG" or bias == "LONG (CONT)" ? p.bullish : bias == "SHORT" or bias == "SHORT (CONT)" ? p.bearish : bias == "⚠ SKIP" ? p.skip_text : p.neutral
    biasBg  = bias == "⚠ SKIP" ? p.skip_bg : p.bg_secondary
    table.cell(tbl, 0, row, "BIAS", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, bias, text_color=biasClr, bgcolor=biasBg, text_size=sz)
    table.cell(tbl, 2, row, biasPct > 0 ? str.tostring(biasPct, "#.0") + "%" : "—", text_color=probClr(biasPct), bgcolor=biasBg, text_size=sz)
    row += 1
    
    // ── Quality ──
    table.cell(tbl, 0, row, "Quality", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, qualityTxt, text_color=qualityScore >= 4 ? p.bullish : qualityScore >= 2 ? p.caution : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, str.tostring(qualityScore) + " pts", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // ── Gap ──
    if gapDir != "—"
        table.cell(tbl, 0, row, "Gap", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, gapDir + " " + str.tostring(gapPts, "#") + "pt", text_color=gapDir == "UP" ? p.bullish : gapDir == "DOWN" ? p.bearish : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, gapChasing ? "CHASE +" : "FADE", text_color=gapChasing ? p.bullish : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    // ── Timing ──
    if timingPct > 0
        table.cell(tbl, 0, row, "Timing", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, timingPhase, text_color=p.confirm, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, timingWarn != "" ? timingWarn : str.tostring(timingPct, "#.0") + "%", text_color=str.contains(timingWarn, "⚠") ? p.caution : p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    // ── RANGES section ──
    table.cell(tbl, 0, row, "── RANGES ──", text_color=p.asia_primary, bgcolor=color.new(p.asia_primary, 85), text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    if not na(asiaH) and not na(asiaL)
        table.cell(tbl, 0, row, "Asia", text_color=p.asia_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(asiaH - asiaL, "#.0") + " pts", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, asiaSize + " " + (na(asiaPctl) ? "" : str.tostring(asiaPctl, "#") + "th"), text_color=asiaSize == "SMALL" ? p.bullish : asiaSize == "LARGE" ? p.bearish : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    if not na(lonH) and not na(lonL)
        table.cell(tbl, 0, row, "London", text_color=p.london_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(lonH - lonL, "#.0") + " pts", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, londonSize + " " + (na(lonPctl) ? "" : str.tostring(lonPctl, "#") + "th"), text_color=londonSize == "SMALL" ? p.bullish : londonSize == "LARGE" ? p.bearish : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    if not na(nyRng)
        table.cell(tbl, 0, row, "NY", text_color=p.ny_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(nyRng, "#.0") + " pts", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, na(nyPctl) ? "(live)" : str.tostring(nyPctl, "#") + "th", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    dowNames = array.from("Sun","Mon","Tue","Wed","Thu","Fri","Sat")
    dowClr = curDOW == dayofweek.tuesday or curDOW == dayofweek.wednesday ? p.bullish : curDOW == dayofweek.monday ? p.bearish : p.neutral
    table.cell(tbl, 0, row, "DOW", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, array.get(dowNames, curDOW - 1), text_color=dowClr, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, curDOW == dayofweek.tuesday ? "+5%" : curDOW == dayofweek.wednesday ? "+3%" : curDOW == dayofweek.monday ? "-4%" : "—", text_color=dowClr, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // ── NY LEVELS section ──
    table.cell(tbl, 0, row, "── NY LEVELS ──", text_color=p.confirm, bgcolor=color.new(p.confirm, 85), text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    table.cell(tbl, 0, row, "Level", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, "Hit %", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, "Status", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    if not na(h78H) and not na(h78L)
        row := addRow(tbl, row, "7-8 Mid", p.confirm, getCondProb78Mid(), hit78Mid, sz, p)
    if not na(p12H)
        row := addRow(tbl, row, "P12 High", p.overnight_primary, getP12H(), hitP12H, sz, p)
        row := addRow(tbl, row, "P12 Low",  p.overnight_primary, getP12L(), hitP12L, sz, p)
        row := addRow(tbl, row, "P12 Mid",  p.caution,           getP12M(), hitP12Mid, sz, p)
    if not na(o730)
        row := addRow(tbl, row, "07:30", p.caution, getGlobalProb("07:30"), hit730, sz, p)
    if not na(onH) and not na(onL) and i_showOTE
        row := addRow(tbl, row, "OTE Bull", p.bullish, getGlobalProb("OTE Bull"), hitOTEBull, sz, p)
    if not na(onMid)
        row := addRow(tbl, row, "ON Mid", p.confirm, getGlobalProb("ON Mid"), hitOnMid, sz, p)
    if not na(lonH)
        row := addRow(tbl, row, "Lon H", p.london_primary, getCondProbLonH(pattern, nyPos), hitLonH, sz, p)
    if not na(lonL)
        row := addRow(tbl, row, "Lon L", p.london_primary, getCondProbLonL(pattern, nyPos), hitLonL, sz, p)
    if not na(lonMid)
        row := addRow(tbl, row, "Lon Mid", p.london_primary, getCondProbLonMid(pattern, nyPos), hitLonMid, sz, p)
    if not na(asiaMid)
        row := addRow(tbl, row, "Asia Mid", p.asia_primary, getCondProbAsiaMid(pattern, nyPos), hitAsiaMid, sz, p)
    if not na(asiaH)
        row := addRow(tbl, row, "Asia H", p.asia_primary, getCondProbAsiaH(pattern, nyPos), hitAsiaH, sz, p)
    if not na(asiaL)
        row := addRow(tbl, row, "Asia L", p.asia_primary, getCondProbAsiaL(pattern, nyPos), hitAsiaL, sz, p)
    if not na(pdC)
        row := addRow(tbl, row, "Settlement", i_cPrior, getGlobalProb("Settlement"), hitPDC, sz, p)
    if not na(glxOpen)
        row := addRow(tbl, row, "Globex", p.neutral, getGlobalProb("Globex"), hitGlx, sz, p)
    if not na(mnOpen)
        row := addRow(tbl, row, "MN Open", p.text_primary, getCondProbMN(pattern, nyPos), hitMnOpen, sz, p)
    if not na(pdH)
        row := addRow(tbl, row, "PDH", i_cPrior, getGlobalProb("PDH"), hitPDH, sz, p)
    if not na(pdL)
        row := addRow(tbl, row, "PDL", i_cPrior, getGlobalProb("PDL"), hitPDL, sz, p)
    
    float cbdr = not na(asiaH) and not na(asiaL) ? asiaH - asiaL : na
    if not na(cbdr) and cbdr > 0
        row := addRow(tbl, row, "+1σ", i_cSigUp, getSigmaProb("+1", manipulation), hitSig1P, sz, p)
        row := addRow(tbl, row, "-1σ", i_cSigDn, getSigmaProb("-1", manipulation), hitSig1N, sz, p)
        row := addRow(tbl, row, "+2σ", i_cSigUp, getSigmaProb("+2", manipulation), hitSig2P, sz, p)
        row := addRow(tbl, row, "-2σ", i_cSigDn, getSigmaProb("-2", manipulation), hitSig2N, sz, p)
    
    // ── PM section ──
    if (inNYPM or inLunch) and not na(amH)
        table.cell(tbl, 0, row, "── PM ──", text_color=p.caution, bgcolor=color.new(p.caution, 85), text_size=sz)
        table.merge_cells(tbl, 0, row, 2, row)
        row += 1
        
        table.cell(tbl, 0, row, "Mode", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "MANAGE", text_color=p.caution, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, "No new entries", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
        
        row := addRow(tbl, row, "AM H", p.bullish, getGlobalProb("PM Hit AMH"), hitAMH, sz, p)
        if not na(amL)
            row := addRow(tbl, row, "AM L", p.bearish, getGlobalProb("PM Hit AML"), hitAML, sz, p)
        if inNYPM and not na(lchH)
            row := addRow(tbl, row, "Lunch H", p.text_dim, getGlobalProb("PM Hit LchH"), hitLchH, sz, p)
            row := addRow(tbl, row, "Lunch L", p.text_dim, getGlobalProb("PM Hit LchL"), hitLchL, sz, p)
    
    // ── Daily H/L section ──
    table.cell(tbl, 0, row, "── DAILY ──", text_color=p.confirm, bgcolor=color.new(p.confirm, 85), text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    if not na(dayH) and not na(dayHH)
        table.cell(tbl, 0, row, "Day H", text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(dayH, "#.#"), text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, str.format("{0,number,00}:{1,number,00}", dayHH, dayHM), text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    if not na(dayL) and not na(dayLH)
        table.cell(tbl, 0, row, "Day L", text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(dayL, "#.#"), text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, str.format("{0,number,00}:{1,number,00}", dayLH, dayLM), text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1

    // ── VVIX H/L section ──
    table.cell(tbl, 0, row, "── VVIX ──", text_color=p.confirm, bgcolor=color.new(p.confirm, 85), text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    if not na(vvixH) //and not na(dayHH)
        table.cell(tbl, 0, row, "VVIX H", text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(vvixH, "#.#"), text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
       // table.cell(tbl, 2, row, str.format("{0,number,00}:{1,number,00}", dayHH, dayHM), text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    if not na(vvixL) //and not na(dayLH)
        table.cell(tbl, 0, row, "VVIX L", text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(vvixL, "#.#"), text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
       // table.cell(tbl, 2, row, str.format("{0,number,00}:{1,number,00}", dayLH, dayLM), text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    if not na(vvixC) //and not na(dayLH)
        table.cell(tbl, 0, row, "VVIX Close", text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(vvixC, "#.#"), text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
        //table.cell(tbl, 2, row, str.format("{0,number,00}:{1,number,00}", dayLH, dayLM), text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
// ┌─────────────────────────────────────────────────────────────────────────────┐
// │  ALERTS                                                                     │
// └─────────────────────────────────────────────────────────────────────────────┘

alertcondition(bias == "LONG",              "Long Bias Confirmed",  "Prob Engine: LONG bias confirmed")
alertcondition(bias == "SHORT",             "Short Bias Confirmed", "Prob Engine: SHORT bias confirmed")
alertcondition(bias == "⚠ SKIP",            "Misaligned - Skip",    "Prob Engine: Misaligned setup - SKIP")
alertcondition(isJudas and isAligned,       "Judas + Aligned",      "Prob Engine: JUDAS sweep + aligned!")
alertcondition(gapChasing and isAligned,    "Gap Chase + Aligned",  "Prob Engine: Gap CHASING + aligned!")
alertcondition(qualityScore >= 5,           "High Quality Setup",   "Prob Engine: Quality 5+ setup!")
