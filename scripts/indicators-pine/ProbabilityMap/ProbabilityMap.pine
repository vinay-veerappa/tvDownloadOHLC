        _gp(82.3, 50.6, 49.2, 82.3, 72.3, 73.6, 71.5, 82.2, pat, pos)
    else if is_cl
        _gp(76.6, 35.8, 39.6, 75.6, 61.7, 64.6, 73.3, 63.2, pat, pos)
    else if is_gc
        _gp(71.9, 28.5, 31.6, 72.3, 59.4, 55.8, 58.6, 61.3, pat, pos)
    else
        70.0

