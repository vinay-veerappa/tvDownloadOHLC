getCondProbAsiaL(string pat, string pos) =>
    if is_nq
        _gp(77.0, 69.8, 43.3, 71.1, 64.4, 82.1, 45.5, 72.8, pat, pos)
    else if is_es
        _gp(75.9, 68.7, 36.9, 74.4, 58.0, 82.8, 37.6, 74.9, pat, pos)
    else if is_rty
        _gp(79.8, 66.5, 42.7, 76.3, 54.4, 82.4, 51.1, 80.0, pat, pos)
    else if is_ym
        _gp(76.0, 68.1, 34.0, 71.1, 58.0, 80.6, 41.9, 74.3, pat, pos)
    else if is_cl
        _gp(69.4, 53.4, 26.9, 67.5, 46.3, 72.1, 34.7, 71.6, pat, pos)
    else if is_gc
        _gp(60.2, 50.9, 15.8, 51.6, 43.2, 67.9, 32.0, 55.8, pat, pos)
    else
