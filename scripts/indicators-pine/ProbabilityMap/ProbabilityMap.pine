    else if is_ym
        _gp(16.2,75.1, 14.5,77.3, 18.1,78.6, 11.8,71.2, pat,pos)
    else if is_cl
        _gp(22.8,68.4, 24.1,66.9, 20.6,70.2, 26.4,64.8, pat,pos)
    else if is_gc
        _gp(25.2,66.1, 27.4,64.3, 23.1,67.8, 29.6,62.4, pat,pos)
    else
        50.0

getCondProb78Mid() => _byIx(80.6, 79.5, 80.1, 78.6, 69.7, 64.6)

getCondProbLonMid(string pat, string pos) =>
    if is_nq
        _gp(78.8, 75.1, 74.0, 84.1, 79.3, 79.4, 76.2, 83.0, pat, pos)
    else if is_es
        _gp(79.1, 73.0, 72.6, 81.8, 73.8, 78.5, 69.3, 76.5, pat, pos)
    else if is_rty
        _gp(81.7, 73.2, 78.5, 79.0, 71.6, 77.4, 79.5, 77.3, pat, pos)
    else if is_ym
        _gp(79.7, 71.6, 69.5, 79.7, 74.7, 76.6, 74.3, 82.7, pat, pos)
    else if is_cl
        _gp(71.2, 62.1, 63.8, 69.1, 64.7, 67.6, 72.0, 64.2, pat, pos)
    else if is_gc
        _gp(66.5, 56.5, 57.7, 67.8, 62.6, 61.5, 60.5, 63.6, pat, pos)
    else
        78.0

