  + "02004D0750000115402008U1000500152702009U100050012330200aU1001000146404001D1000500165604002D10010001050"
  + "04003D1001000121704005D0800500154704008D100000012330400aU1000330195806003D0900670206506004D08300001354"
  + "06005U1001000121706008U0831000165608004D0890750196808005U1000400126708008D0751000153308009U08805001471"
  + "0800aU0750860238310001D1000670135410002D1000670154710003D1001000121710005D1000330104010006D07507501040"
  + "10008U080100010601000aU0861000146412002D1001000183312004D1001000192112007U0750000134612009U10010001839"
  + "1200aU1001000163114001D1001000145014002D1000800165014003D1001000121714004D0860860125814007U08305001553"
  + "14008U0751000185016001D1001000116416002D1001000142916005D1000000122516009U100100013151600aU10010001331"
  + "1800aU100080010801800bU0801000145020001D1001000135420002D0860000108020008U0710670147120009U08610001267"
  + "2000aU1001000176522001D1001000117322002D1001000123322003D1001000133122004U1000000133122008U10000001118"
  + "22009U083000016442200aU10010002232"

D240_GC = "02001D0800500145002002D0750750155302003D0860860135402005U1000000112702006U0750330116402007D07506701547"
  + "02008U1000500105002009U100100010100200aU0831000125806002D0800000174106003D0830330136906009U08010001450"
  + "10001D1000750155310003D1001000131510008U0861000155310009U071100018501000aU1001000154014001D10010001060"
  + "14002D1001000173514003D1001000154714004D1001000152014006D1001000111814008U1001000131514009U08010001644"
  + "18004D1000600116418005U0750000137718007D1000330128318009U100067010801800aU0750750104022001D10010001146"
  + "22003D1001000134622005D0751000133822006D0750000143622009U075075011362200aU10007502650"


// Select active dataset based on activeAsset
getDatasets(string asset) =>
    asset == "NQ" ? array.from(D15_NQ, D30_NQ, D60_NQ, D120_NQ, D240_NQ) :
     asset == "ES" ? array.from(D15_ES, D30_ES, D60_ES, D120_ES, D240_ES) :
     asset == "YM" ? array.from(D15_YM, D30_YM, D60_YM, D120_YM, D240_YM) :
     asset == "RTY" ? array.from(D15_RTY, D30_RTY, D60_RTY, D120_RTY, D240_RTY) :
     asset == "CL" ? array.from(D15_CL, D30_CL, D60_CL, D120_CL, D240_CL) :
     asset == "GC" ? array.from(D15_GC, D30_GC, D60_GC, D120_GC, D240_GC) :
     array.from(D15_NQ, D30_NQ, D60_NQ, D120_NQ, D240_NQ)

// Populate LUT map
var map<string, string> LUT = map.new<string, string>()
if barstate.isfirst
    activeDatasets = getDatasets(activeAsset)
    for ti = 0 to 4
        D = activeDatasets.get(ti)
        if str.length(D) >= 17
            for i = 0 to math.floor(str.length(D) / 17) - 1
                rec = str.substring(D, i * 17, i * 17 + 17)
                LUT.put(str.tostring(ti) + str.substring(rec, 0, 5), str.substring(rec, 5))

// ------------------------------------------------------------ range clock ---
tfIdx = tfSel == "15" ? 0 : tfSel == "30" ? 1 : tfSel == "60" ? 2 : tfSel == "120" ? 3 : 4
tfM  = math.round(str.tonumber(tfSel))
tfMs = tfM * 60000

etMins      = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
sinceAnchor = (etMins - anchorH * 60 + 1440) % 1440
rIdx        = math.floor(sinceAnchor / tfM)
rStart      = time - (sinceAnchor % tfM) * 60000
newRange    = ta.change(rIdx) != 0 or barstate.isfirst

// ------------------------------------------------------------ range state ---
var float curO = na
var float curH = na
var float curL = na
var int   curStart = na
var float prvH = na
var float prvL = na
var int   prvStart = na
var box   bx = na
var array<box> boxes = array.new<box>()
var box   prevBx = na
var box   bandBx = na
var array<line> grid = array.new<line>()
var line   lnHi = na
var line   lnMid = na
var line   lnLo = na
var label  lbHi = na
var label  lbMid = na
var label  lbLo = na
var string sKey = ""

// rolling window of calls this chart has actually made
var array<float> tClaim  = array.new_float()
var array<float> tOK     = array.new_float()
var array<float> tResOK  = array.new_float()
var array<float> tResCl  = array.new_float()

var string sSlot   = ""
var float  sOP     = na
var string sBucket = ""
var string sDir    = ""
var float  sProb   = na
var float  sTest   = na
var int    sN      = 0
var float  sRes    = na
var bool   sHit    = false
var bool   sAdj    = false

pad2(int v) =>
    (v < 10 ? "0" : "") + str.tostring(v)

bChar(int i) =>
    str.substring("0123456789ab", i, i + 1)

bName(int i) =>
    i == 0  ? "below prev low" :
     i == 11 ? "at/above prev high" :
     str.tostring((i - 1) / 10.0, "0.0") + " - " + str.tostring(i / 10.0, "0.0")

if newRange
    pc = close[1]
    wasUp  = not na(curO) and not na(prvH) and pc > prvH
    wasDn  = not na(curO) and not na(prvL) and pc < prvL
    wasRes = wasUp or wasDn

    if showLive and sHit and not na(curO)
        tResOK.push(wasRes ? 1 : 0)
        tResCl.push(sRes)
        tClaim.push(sProb)
        tOK.push(not wasRes ? na : (sDir == "U" ? wasUp : wasDn) ? 1 : 0)
        while tClaim.size() > trackN
            tClaim.shift()
            tOK.shift()
            tResOK.shift()
            tResCl.shift()

    if showBox and not na(bx)
        box.set_bgcolor(bx, wasUp ? colUp : wasDn ? colDn : colIn)

    if not na(curO)
        prvH := curH
        prvL := curL
        prvStart := curStart

    curO := open
    curH := high
    curL := low
    curStart := rStart

    sHit := false
    sProb := na
    sTest := na
    sN := 0
    sRes := na
    sOP := na
    sBucket := ""
    sDir := ""
    sAdj := not na(prvStart) and (curStart - prvStart) >= math.round(tfMs * 0.9) and (curStart - prvStart) <= math.round(tfMs * 1.5)
    sSlot := pad2(hour(curStart, "America/New_York")) + pad2(minute(curStart, "America/New_York"))

    if sAdj and not na(prvH) and prvH > prvL
        sOP := (curO - prvL) / (prvH - prvL)
        bi = sOP < 0 ? 0 : sOP >= 1.0 ? 11 : math.min(10, math.floor(sOP * 10) + 1)
        sBucket := bName(bi)
        sKey := str.tostring(tfIdx) + sSlot + bChar(bi)
        if LUT.contains(sKey)
            v = LUT.get(sKey)
            sDir  := str.substring(v, 0, 1)
            sProb := str.tonumber(str.substring(v, 1, 4))
            sTest := str.tonumber(str.substring(v, 4, 7))
            sN    := math.round(str.tonumber(str.substring(v, 7, 10)))
            sRes  := str.tonumber(str.substring(v, 10, 12))
            sHit  := true

    if showBox
        bx := box.new(curStart, curH, curStart + tfMs, curL, xloc = xloc.bar_time,
             bgcolor = colLive, border_color = color.new(color.gray, 55), border_width = 1)
        boxes.push(bx)
        while boxes.size() > keepN
            box.delete(boxes.shift())

    if sHit and showMarker
        label.new(bar_index, sDir == "U" ? low : high,
             (sDir == "U" ? "▲ " : "▼ ") + str.tostring(sProb, "#") + "%",
             style = sDir == "U" ? label.style_label_up : label.style_label_down,
             color = color.new(sDir == "U" ? color.teal : color.maroon, 20),
             textcolor = color.white, size = size.tiny)

    if sHit and useAlerts and barstate.isconfirmed
        alert(activeAsset + " " + tfSel + "M " + str.substring(sSlot, 0, 2) + ":" + str.substring(sSlot, 2, 4) +
             " ET opened at " + str.tostring(sOP, "0.00") + " " +
             (sDir == "U" ? "closes ABOVE high " : "closes BELOW low ") +
             str.tostring(sProb, "#") + "% (" + str.tostring(sRes, "#") + "% res)", alert.freq_once_per_bar_close)
else
    curH := math.max(curH, high)
    curL := math.min(curL, low)

if showBox and not na(bx) and not na(curStart)
    box.set_top(bx, curH)
    box.set_bottom(bx, curL)
    box.set_right(bx, math.min(curStart + tfMs, time + timeframe.in_seconds() * 1000))

// -------------------------------------------- parallel range scanner ---
TFLIST = array.from(15, 30, 60, 120, 240)
TFNAME = array.from("15M", "30M", "60M", "120M", "240M")

var array<float>  kPH = array.new_float(5, na)
var array<float>  kPL = array.new_float(5, na)
var array<float>  kCH = array.new_float(5, na)
var array<float>  kCL = array.new_float(5, na)
var array<float>  kCO = array.new_float(5, na)
var array<int>    kCS = array.new_int(5, na)
var array<int>    kPS = array.new_int(5, na)
var array<int>    kIX = array.new_int(5, -999)
var array<float>  kPr = array.new_float(5, na)
var array<float>  kRs = array.new_float(5, na)
var array<string> kDr = array.new_string(5, "")

if showOthers
    for i = 0 to 4
        tfi  = TFLIST.get(i)
        tfiMs = tfi * 60000
        idx  = math.floor(sinceAnchor / tfi)
        st   = time - (sinceAnchor % tfi) * 60000
        if idx != kIX.get(i)
            if not na(kCO.get(i))
                kPH.set(i, kCH.get(i))
                kPL.set(i, kCL.get(i))
                kPS.set(i, kCS.get(i))
            kCO.set(i, open)
            kCH.set(i, high)
            kCL.set(i, low)
            kCS.set(i, st)
            kIX.set(i, idx)
            kPr.set(i, na)
            kRs.set(i, na)
            kDr.set(i, "")
            ph = kPH.get(i)
            pl = kPL.get(i)
            ps = kPS.get(i)
            if not na(ph) and not na(ps) and ph > pl and (st - ps) == tfiMs
                o  = (open - pl) / (ph - pl)
                bb = o < 0 ? 0 : o >= 1.0 ? 11 : math.min(10, math.floor(o * 10) + 1)
                kk = str.tostring(i) + pad2(hour(st, "America/New_York")) +
                     pad2(minute(st, "America/New_York")) + bChar(bb)
                if LUT.contains(kk)
                    vv = LUT.get(kk)
                    kDr.set(i, str.substring(vv, 0, 1))
                    kPr.set(i, str.tonumber(str.substring(vv, 1, 4)))
                    kRs.set(i, str.tonumber(str.substring(vv, 10, 12)))
        else
            kCH.set(i, math.max(kCH.get(i), high))
            kCL.set(i, math.min(kCL.get(i), low))

// ------------------------------------------------------- visual levels & grid -----
if barstate.isfirst
    for i = 0 to 10
        grid.push(line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.none))
    lnHi  := line.new(na, na, na, na, xloc = xloc.bar_time, width = 2)
    lnMid := line.new(na, na, na, na, xloc = xloc.bar_time, width = 1, style = line.style_dashed)
    lnLo  := line.new(na, na, na, na, xloc = xloc.bar_time, width = 2)
    lbHi  := label.new(na, na, "", xloc = xloc.bar_time, style = label.style_none, size = size.small)
    lbMid := label.new(na, na, "", xloc = xloc.bar_time, style = label.style_none, size = size.small)
    lbLo  := label.new(na, na, "", xloc = xloc.bar_time, style = label.style_none, size = size.small)

if newRange and not na(prvH) and not na(prvStart) and prvH > prvL
    xL = prvStart
    xR = curStart + tfMs
    rng = prvH - prvL

    if showPrev
        if na(prevBx)
            prevBx := box.new(xL, prvH, prvStart + tfMs, prvL, xloc = xloc.bar_time,
                 bgcolor = color.new(color.gray, 100), border_color = colGrid,
                 border_width = 2, border_style = line.style_solid)
        else
            box.set_lefttop(prevBx, xL, prvH)
            box.set_rightbottom(prevBx, prvStart + tfMs, prvL)

    xEnd = curStart + tfMs * (1 + extendN)
    for [k, ln] in array.from(lnHi, lnMid, lnLo)
        y = k == 0 ? prvH : k == 1 ? (prvH + prvL) / 2 : prvL
        line.set_xy1(ln, xL, y)
        line.set_xy2(ln, xEnd, y)
        line.set_extend(ln, extend.none)
        line.set_color(ln, not showHML ? color.new(color.gray, 100) : k == 1 ? colMidL : colHML)
        line.set_width(ln, k == 1 ? wMid : wHL)
    if showHMLlb
        for [k, lb] in array.from(lbHi, lbMid, lbLo)
            y = k == 0 ? prvH : k == 1 ? (prvH + prvL) / 2 : prvL
            label.set_xy(lb, xEnd, y)
            label.set_text(lb, not showHML ? "" :
                 activeAsset + " " + tfSel + (k == 0 ? " HIGH" : k == 1 ? " MID" : " LOW"))
            label.set_textcolor(lb, colHMLlb)
            label.set_style(lb, label.style_label_left)
            label.set_color(lb, color.new(color.gray, 100))

    for i = 0 to 10
        ln = grid.get(i)
        y = prvL + rng * i / 10.0
        edge = i == 0 or i == 10
        line.set_xy1(ln, xL, y)
        line.set_xy2(ln, xR, y)
        line.set_color(ln, showGrid or edge ? colGrid : color.new(color.gray, 100))
        line.set_width(ln, wGrid)
        line.set_style(ln, edge ? line.style_solid : i == 5 ? line.style_dashed : line.style_dotted)

    if showBand and not na(sOP) and sOP >= 0 and sOP < 1.0
        k = math.floor(sOP * 10)
        yb = prvL + rng * k / 10.0
        yt = prvL + rng * (k + 1) / 10.0
        if na(bandBx)
            bandBx := box.new(curStart, yt, xR, yb, xloc = xloc.bar_time,
                 bgcolor = colBand, border_color = color.new(color.gray, 100))
        else
            box.set_lefttop(bandBx, curStart, yt)
            box.set_rightbottom(bandBx, xR, yb)
    else if not na(bandBx)
        box.set_lefttop(bandBx, curStart, prvL)
        box.set_rightbottom(bandBx, curStart, prvL)

// ---------------------------------------------------------------- table -----
posOf(string s) =>
    s == "Top left"      ? position.top_left :
     s == "Bottom right" ? position.bottom_right :
     s == "Bottom left"  ? position.bottom_left :
     s == "Middle right" ? position.middle_right : position.top_right

sizeOf(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

pc(float v) =>
    na(v) ? "—" : str.tostring(v, "0.#") + "%"

pc2(float v) =>
    na(v) ? "—" : str.tostring(v, "0") + "%"

var table tb = table.new(posOf(tblPos), 2, 22, border_width = 1,
     frame_color = color.new(color.gray, 55), frame_width = 1,
     border_color = color.new(color.gray, 85))

if showTbl and barstate.islast
    ts  = sizeOf(tblSize)
    tx  = chart.fg_color
    dim = color.new(chart.fg_color, 45)
    hdr = color.new(color.gray, 88)
    sec = color.new(color.gray, 92)
    tooHigh = timeframe.in_seconds() > tfM * 60
    sigCol  = not sHit ? dim : sDir == "U" ? color.teal : color.maroon
    upCol   = sHit and sDir == "U" ? color.teal : dim
    dnCol   = sHit and sDir == "D" ? color.maroon : dim

    pUpCond = na(sProb) ? na : sDir == "U" ? sProb : 100 - sProb
    uAbove  = na(sRes)  ? na : pUpCond * sRes / 100.0
    uBelow  = na(sRes)  ? na : (100 - pUpCond) * sRes / 100.0
    uInside = na(sRes)  ? na : 100 - sRes

    dirTxt = not sAdj ? "no adjacent previous range" :
              sHit    ? (sDir == "U" ? "closes ABOVE previous high" : "closes BELOW previous low") :
              "nothing at or above 70%"
    foot = showDebug ? "Asset: " + activeAsset + " | Cells: " + str.tostring(LUT.size()) :
             tooHigh  ? "chart timeframe is above range size" :
             "range close only — wicks do not count"
    detL = showDetail ? "train / test  ·  sample" : ""
    detR = not showDetail ? "" : sHit ? str.tostring(sProb, "0") + " / " +
             str.tostring(sTest, "0") + "  ·  " + str.tostring(sN) : "—"

    table.cell(tb, 0, 0, activeAsset + " · " + tfSel + "M", text_color = tx, text_size = ts, bgcolor = hdr, text_halign = text.align_left)
    table.cell(tb, 1, 0, sSlot == "" ? "" : str.substring(sSlot, 0, 2) + ":" + str.substring(sSlot, 2, 4) + " ET", text_color = tx, text_size = ts, bgcolor = hdr, text_halign = text.align_right)

    table.cell(tb, 0, 1, "opened at", text_color = dim, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 1, na(sOP) ? "—" : str.tostring(sOP, "0.00"), text_color = tx, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 2, "bucket", text_color = dim, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 2, sBucket == "" ? "—" : sBucket, text_color = tx, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 3, "IF IT CLOSES OUTSIDE PREV RANGE", text_color = dim, text_size = ts, bgcolor = sec, text_halign = text.align_left)
    table.cell(tb, 1, 3, "", text_size = ts, bgcolor = sec)

    table.cell(tb, 0, 4, dirTxt, text_color = sigCol, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 4, sHit ? pc(sProb) : "—", text_color = sigCol, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 5, "…and it closes outside", text_color = dim, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 5, sHit ? pc(sRes) + " of the time" : "—", text_color = dim, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 6, "OUT OF EVERY 100 RANGES HERE", text_color = dim, text_size = ts, bgcolor = sec, text_halign = text.align_left)
    table.cell(tb, 1, 6, "", text_size = ts, bgcolor = sec)

    table.cell(tb, 0, 7, "close above previous high", text_color = upCol, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 7, pc(uAbove), text_color = sHit and sDir == "U" ? color.teal : tx, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 8, "close below previous low", text_color = dnCol, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 8, pc(uBelow), text_color = sHit and sDir == "D" ? color.maroon : tx, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 9, "close inside — no result", text_color = dim, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 9, pc(uInside), text_color = tx, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 10, detL, text_color = dim, text_size = ts, text_halign = text.align_left)
    table.cell(tb, 1, 10, detR, text_color = dim, text_size = ts, text_halign = text.align_right)

    table.cell(tb, 0, 11, foot, text_color = tooHigh and not showDebug ? color.new(color.orange, 10) : dim, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tb, 1, 11, "", text_size = size.tiny)

    if showOthers
        live = 0
        for i = 0 to 4
            if i != tfIdx and not na(kPr.get(i))
                live += 1
        table.cell(tb, 0, 12, "OTHER RANGE SIZES, LIVE NOW", text_color = dim, text_size = ts, bgcolor = sec, text_halign = text.align_left)
        table.cell(tb, 1, 12, live == 0 ? "none" : str.tostring(live), text_color = dim, text_size = ts, bgcolor = sec, text_halign = text.align_right)
        r = 13
        for i = 0 to 4
            if i != tfIdx
                pr  = kPr.get(i)
                dr  = kDr.get(i)
                rs  = kRs.get(i)
                on  = not na(pr)
                col = not on ? dim : dr == "U" ? color.teal : color.maroon
                txt = not on ? "—" : (dr == "U" ? "▲ " : "▼ ") + str.tostring(pr, "0") + "% · " + str.tostring(rs, "0") + "% res"
                table.cell(tb, 0, r, TFNAME.get(i) + (on ? (dr == "U" ? " above prev high" : " below prev low") : ""), text_color = col, text_size = ts, text_halign = text.align_left)
                table.cell(tb, 1, r, txt, text_color = col, text_size = ts, text_halign = text.align_right)
                r += 1

    if showLive
        nCalls = tClaim.size()
        sumCl  = 0.0
        sumOK  = 0.0
        nRes   = 0
        sumRCl = 0.0
        sumRes = 0.0
        for i = 0 to (nCalls > 0 ? nCalls - 1 : 0)
            if nCalls > 0
                sumRCl += tResCl.get(i)
                sumRes += tResOK.get(i)
                if not na(tOK.get(i))
                    sumCl += tClaim.get(i)
                    sumOK += tOK.get(i)
                    nRes  += 1
        claimAvg = nRes > 0 ? sumCl / nRes : na
        liveAvg  = nRes > 0 ? 100 * sumOK / nRes : na
        gap      = na(liveAvg) ? na : liveAvg - claimAvg
        rClaim   = nCalls > 0 ? sumRCl / nCalls : na
        rLive    = nCalls > 0 ? 100 * sumRes / nCalls : na
        gapCol   = na(gap) ? dim : gap >= -2 ? color.teal : gap >= -7 ? color.new(color.orange, 10) : color.maroon

        table.cell(tb, 0, 17, "ON THIS CHART, LAST " + str.tostring(trackN) + " CALLS", text_color = dim, text_size = ts, bgcolor = sec, text_halign = text.align_left)
        table.cell(tb, 1, 17, str.tostring(nCalls) + " made", text_color = dim, text_size = ts, bgcolor = sec, text_halign = text.align_right)

        table.cell(tb, 0, 18, "resolved / unresolved", text_color = dim, text_size = ts, text_halign = text.align_left)
        table.cell(tb, 1, 18, nCalls == 0 ? "—" : str.tostring(nRes) + " / " + str.tostring(nCalls - nRes), text_color = tx, text_size = ts, text_halign = text.align_right)

        table.cell(tb, 0, 19, "claimed vs actual", text_color = dim, text_size = ts, text_halign = text.align_left)
        table.cell(tb, 1, 19, nRes == 0 ? "—" : pc2(claimAvg) + " vs " + pc2(liveAvg), text_color = tx, text_size = ts, text_halign = text.align_right)

        table.cell(tb, 0, 20, "drift", text_color = dim, text_size = ts, text_halign = text.align_left)
        table.cell(tb, 1, 20, na(gap) ? "—" : (gap >= 0 ? "+" : "") + str.tostring(gap, "0.#") + " pts", text_color = gapCol, text_size = ts, text_halign = text.align_right)

        table.cell(tb, 0, 21, "resolve rate, claimed vs actual", text_color = dim, text_size = ts, text_halign = text.align_left)
        table.cell(tb, 1, 21, nCalls == 0 ? "—" : pc2(rClaim) + " vs " + pc2(rLive), text_color = dim, text_size = ts, text_halign = text.align_right)
