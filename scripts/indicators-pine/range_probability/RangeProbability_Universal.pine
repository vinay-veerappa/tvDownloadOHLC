// Range Probability  -  Universal Multi-Asset Engine
// Generated by Antigravity Range Probability Engine
//@version=6
indicator("Range Probability  -  Universal", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------- inputs ----
g0 = "Asset Selection"
assetSel = input.string("Auto", "Lookup Matrix Asset", options = ['Auto', 'NQ', 'ES', 'YM', 'RTY', 'CL', 'GC', 'SPY', 'QQQ', 'AAPL', 'NVDA', 'TSLA'], group = g0, tooltip = "Choose Auto to detect from chart symbol, or select a specific asset matrix.")

g1 = "Range"
tfSel   = input.string("60", "Range size (minutes)", options = ["15", "30", "60", "120", "240"], group = g1)
anchorH = input.int(18, "Session anchor hour (ET)", minval = 0, maxval = 23, group = g1, tooltip = "Ranges are measured from this hour in New York time. 18:00 matches standard futures session open.")
keepN   = input.int(20, "Ranges to keep on chart", minval = 1, maxval = 400, group = g1)

g2 = "Box"
showBox  = input.bool(true,  "Draw range boxes", group = g2)
colLive  = input.color(color.new(#787b86, 75), "Forming", group = g2)
colUp    = input.color(color.new(#26a69a, 80), "Closed above previous high", group = g2)
colDn    = input.color(color.new(#ef5350, 80), "Closed below previous low", group = g2)
colIn    = input.color(color.new(#787b86, 90), "Closed inside", group = g2)

g5 = "Levels"
showHML   = input.bool(true,  "High / mid / low lines from the previous range", group = g5)
extendN   = input.int(0, "Extend them this many ranges ahead", minval = 0, maxval = 50, group = g5)
showHMLlb = input.bool(true,  "Label them", group = g5)
showPrev  = input.bool(true,  "Outline the previous range", group = g5)
showGrid  = input.bool(false, "Open-position levels (0.0 - 1.0)", group = g5)
showBand  = input.bool(true,  "Shade the bucket the range opened in", group = g5)
colHML    = input.color(#4a4d55, "High / low colour", group = g5)
colMidL   = input.color(color.new(#787b86, 25), "Mid colour", group = g5)
colHMLlb  = input.color(color.new(#787b86, 20), "Label colour", group = g5)
wHL       = input.int(1, "High / low thickness", minval = 1, maxval = 5, group = g5)
wMid      = input.int(1, "Mid thickness", minval = 1, maxval = 5, group = g5)
wGrid     = input.int(1, "Open-position level thickness", minval = 1, maxval = 5, group = g5)
colGrid   = input.color(color.new(#787b86, 65), "Open-position level colour", group = g5)
colBand   = input.color(color.new(#787b86, 88), "Bucket shading", group = g5)

g3 = "Table"
showTbl    = input.bool(true, "Show table", group = g3)
tblPos     = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = g3)
tblSize    = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = g3)
showDetail = input.bool(true, "Show test outcome and sample size", group = g3)

g4 = "Signals"
showMarker = input.bool(true,  "Label the chart when a cell qualifies", group = g4)
useAlerts  = input.bool(false, "Fire an alert when a cell qualifies", group = g4)
showOthers = input.bool(true,  "Scan the other range sizes for live signals", group = g4)

g6 = "Live tracker"
showLive = input.bool(true, "Track how the calls are doing on this chart", group = g6)
trackN   = input.int(100, "Calls to keep in the window", minval = 10, maxval = 1000, group = g6)
showDebug  = input.bool(false, "Show lookup diagnostics in the table", group = g4)

// ------------------------------------------------------------ active asset detection ---
currTicker = syminfo.ticker
detectAsset() =>
    str.contains(currTicker, "NQ") or str.contains(currTicker, "MNQ") or str.contains(currTicker, "USTEC") ? "NQ" :
     str.contains(currTicker, "ES") or str.contains(currTicker, "MES") or str.contains(currTicker, "SPX") or str.contains(currTicker, "US500") ? "ES" :
     str.contains(currTicker, "YM") or str.contains(currTicker, "MYM") or str.contains(currTicker, "US30") ? "YM" :
     str.contains(currTicker, "RTY") or str.contains(currTicker, "M2K") or str.contains(currTicker, "US2000") ? "RTY" :
     str.contains(currTicker, "CL") or str.contains(currTicker, "MCL") or str.contains(currTicker, "OIL") ? "CL" :
     str.contains(currTicker, "GC") or str.contains(currTicker, "MGC") or str.contains(currTicker, "GOLD") ? "GC" :
     str.contains(currTicker, "SPY") ? "SPY" :
     str.contains(currTicker, "QQQ") ? "QQQ" :
     str.contains(currTicker, "AAPL") ? "AAPL" :
     str.contains(currTicker, "NVDA") ? "NVDA" :
     str.contains(currTicker, "TSLA") ? "TSLA" : "NQ"

activeAsset = assetSel == "Auto" ? detectAsset() : assetSel

