//@version=6
strategy("Institutional Master Model (First FVG · SMT · 1H Trend · Pack · Trap)", 
  shorttitle="Master_Institutional_Strategy", 
  overlay=true, 
  pyramiding=2, 
  default_qty_type=strategy.fixed, 
  default_qty_value=2, 
  initial_capital=50000, 
  currency=currency.USD,
  margin_long=0,
  margin_short=0,
  commission_type=strategy.commission.cash_per_contract, 
  commission_value=0.52, 
  max_boxes_count=500, 
  max_lines_count=500, 
  max_labels_count=500, 
  max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════
// SECTION 1 — CONFIGURATION & PARAMETERS
// ═══════════════════════════════════════════════════════════════════
var string GRP_LIQ = "1. Liquidity & HTF Trend Engine"
i_enableHtfTrend  = input.bool(true, "Enable 1H Trend Alignment (EMA 20/50)", group=GRP_LIQ)
i_minDispBps      = input.float(3.0, "Min Displacement Body (Basis Points)", step=0.5, group=GRP_LIQ)
i_checkPdhPdl     = input.bool(true, "Track Daily Liquidity (PDH / PDL)", group=GRP_LIQ)
i_checkLocalSw    = input.bool(true, "Track Intraday Swing High/Low Sweeps", group=GRP_LIQ)
i_sweepLookback   = input.int(20, "Max Bars Since Liquidity Sweep", minval=5, maxval=50, group=GRP_LIQ)

var string GRP_ENTRY = "2. Execution & Risk Parameters"
i_maxRiskBps      = input.float(12.0, "Hard Risk Ceiling (Basis Points)", step=1.0, group=GRP_ENTRY, tooltip="Skips setup if SL distance > 12 bps.")
i_maxEntryWait    = input.int(15, "Max Bars Waiting for Retest", minval=3, maxval=30, group=GRP_ENTRY)
i_enableTrap      = input.bool(true, "Enable Failed CISD Trap Breakout (Alpha 1)", group=GRP_ENTRY)

// Pure Basis Points Target Matrix (1 bps = 0.01% of entry price)
var string GRP_TP = "3. Basis Points Targets"
i_tp1QueenBps     = input.float(10.0, "Target 1: Cover The Queen (Basis Points)", step=1.0, group=GRP_TP, tooltip="10 bps quick scale-out to make trade risk-free.")
i_tp2AmBps        = input.float(40.0, "Target 2: AM Macro Expansion (Basis Points)", step=5.0, group=GRP_TP)
i_tp2PmBps        = input.float(60.0, "Target 2: PM Macro Expansion (Basis Points)", step=5.0, group=GRP_TP)

var string GRP_SESS = "4. Session Windows"
i_sessionAm       = input.session("0950-1115:23456", "AM Macro Window", group=GRP_SESS)
i_sessionPm       = input.session("1330-1515:23456", "PM Macro Window", group=GRP_SESS)
i_eodFlatten      = input.bool(true, "Force EOD Flatten at 15:55 ET", group=GRP_SESS)
i_maxDailyTrades  = input.int(3, "Max Trades Per Day", minval=1, maxval=10, group=GRP_SESS)

// ═══════════════════════════════════════════════════════════════════
// SECTION 2 — HTF ORDER FLOW & LIQUIDITY LEVELS
// ═══════════════════════════════════════════════════════════════════
// 1-Hour HTF EMA 20/50 (Shifted by 1 bar for zero lookahead)
[h1_ema20, h1_ema50] = request.security(syminfo.tickerid, "60", [ta.ema(close, 20)[1], ta.ema(close, 50)[1]], lookahead=barmerge.lookahead_on)
bool bullHtf = not i_enableHtfTrend or (h1_ema20 >= h1_ema50)
bool bearHtf = not i_enableHtfTrend or (h1_ema20 <= h1_ema50)

// Daily PDH / PDL
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Intraday 3-Bar Fractal Swings
swH = ta.pivothigh(high, 3, 3)
swL = ta.pivotlow(low, 3, 3)
var float[] bslList = array.new<float>()
var float[] sslList = array.new<float>()

if not na(swH)
    array.push(bslList, swH)
    if array.size(bslList) > 10
        array.shift(bslList)

if not na(swL)
    array.push(sslList, swL)
    if array.size(sslList) > 10
        array.shift(sslList)

// ═══════════════════════════════════════════════════════════════════
// SECTION 3 — SWEEP DETECTION & CANONICAL CISD
// ═══════════════════════════════════════════════════════════════════
bool bslSwept = false
bool sslSwept = false
float currentSweepExtreme = na

if i_checkPdhPdl
    if high > pdh and (close < pdh or open < pdh)
        bslSwept := true, currentSweepExtreme := high
    if low < pdl and (close > pdl or open > pdl)
        sslSwept := true, currentSweepExtreme := low

if i_checkLocalSw
    if array.size(bslList) > 0 and not bslSwept
        for b = 0 to array.size(bslList) - 1
            float lvl = array.get(bslList, b)
            if high > lvl and close < lvl
                bslSwept := true, currentSweepExtreme := high
                break

    if array.size(sslList) > 0 and not sslSwept
        for s = 0 to array.size(sslList) - 1
            float lvl = array.get(sslList, s)
            if low < lvl and close > lvl
                sslSwept := true, currentSweepExtreme := low
                break

var bool  hasActiveBullSweep = false
var bool  hasActiveBearSweep = false
var float activeBullSweepLow = na
var float activeBearSweepHigh = na
var int   bullSweepBar = -9999
var int   bearSweepBar = -9999

if sslSwept
    hasActiveBullSweep := true
    activeBullSweepLow := not na(currentSweepExtreme) ? currentSweepExtreme : low
    bullSweepBar       := bar_index

if bslSwept
    hasActiveBearSweep  := true
    activeBearSweepHigh := not na(currentSweepExtreme) ? currentSweepExtreme : high
    bearSweepBar        := bar_index

if (bar_index - bullSweepBar) > i_sweepLookback
    hasActiveBullSweep := false

if (bar_index - bearSweepBar) > i_sweepLookback
    hasActiveBearSweep := false

// Canonical Backward-Walking CISD
var bool  armedBullCisd     = false
var bool  armedBearCisd     = false
var float armedBullHigh     = na
var float armedBearLow      = na
var float armedCisdOriginSL = na

if hasActiveBullSweep and (sslSwept or ta.change(hasActiveBullSweep))
    float sHigh = math.max(open[0], close[0])
    float sLow  = math.min(open[0], close[0])
    
    for i = 1 to math.min(20, bar_index)
        if close[i] <= open[i]
            sHigh := math.max(sHigh, math.max(open[i], close[i]))
            sLow  := math.min(sLow,  math.min(open[i], close[i]))
        else
            break
            
    armedBullCisd     := true
    armedBullHigh     := sHigh
    armedCisdOriginSL := sLow

if hasActiveBearSweep and (bslSwept or ta.change(hasActiveBearSweep))
    float sHigh = math.max(open[0], close[0])
    float sLow  = math.min(open[0], close[0])
    
    for i = 1 to math.min(20, bar_index)
        if close[i] >= open[i]
            sHigh := math.max(sHigh, math.max(open[i], close[i]))
            sLow  := math.min(sLow,  math.min(open[i], close[i]))
        else
            break
            
    armedBearCisd     := true
    armedBearLow      := sLow
    armedCisdOriginSL := sHigh

// Displacement Verification
float bodyBps = (math.abs(close - open) / close) * 10000.0
float volSma  = ta.sma(volume, 20)
bool passesDisp = (bodyBps >= i_minDispBps) and (volume >= 1.1 * volSma)

bool bullCisdTrigger = false
bool bearCisdTrigger = false

if armedBullCisd and not na(armedBullHigh) and close > armedBullHigh
    armedBullCisd      := false
    hasActiveBullSweep := false
    if passesDisp and bullHtf
        bullCisdTrigger := true

if armedBearCisd and not na(armedBearLow) and close < armedBearLow
    armedBearCisd      := false
    hasActiveBearSweep := false
    if passesDisp and bearHtf
        bearCisdTrigger := true

// ═══════════════════════════════════════════════════════════════════
// SECTION 4 — FIRST PRESENTED FVG RETEST ARMING
// ═══════════════════════════════════════════════════════════════════
type PendingEntryZone
    int   dir
    float entryLevel
    float structStopLoss
    int   armedBar
    bool  isFilled
    box   boxObj

var PendingEntryZone activeLongZone  = na
var PendingEntryZone activeShortZone = na

bool newBullFvg = low[0] > high[2]
bool newBearFvg = high[0] < low[2]

// Arm ONLY the First Presented FVG immediately following confirmed CISD
if bullCisdTrigger and na(activeLongZone) and strategy.position_size == 0
    float zTop   = newBullFvg ? low[0] : armedBullHigh
    float zBot   = newBullFvg ? high[2] : (armedBullHigh - (syminfo.mintick * 4))
    float zCE    = (zTop + zBot) / 2.0
    float eLevel = zCE
    
    float slPrice = not na(armedCisdOriginSL) ? armedCisdOriginSL - (2 * syminfo.mintick) : low[1] - (2 * syminfo.mintick)
    if slPrice >= eLevel
        slPrice := math.min(low[0], math.min(low[1], low[2])) - (2 * syminfo.mintick)

    float riskBps = ((eLevel - slPrice) / eLevel) * 10000.0
    if riskBps > 0 and riskBps <= i_maxRiskBps
        box bObj = box.new(left=bar_index, top=zTop, right=bar_index + 15, bottom=zBot, bgcolor=color.new(#26a69a, 80), border_color=color.teal)
        activeLongZone := PendingEntryZone.new(dir=1, entryLevel=eLevel, structStopLoss=slPrice, armedBar=bar_index, isFilled=false, boxObj=bObj)

if bearCisdTrigger and na(activeShortZone) and strategy.position_size == 0
    float zTop   = newBearFvg ? low[2] : (armedBearLow + (syminfo.mintick * 4))
    float zBot   = newBearFvg ? high[0] : armedBearLow
    float zCE    = (zTop + zBot) / 2.0
    float eLevel = zCE
    
    float slPrice = not na(armedCisdOriginSL) ? armedCisdOriginSL + (2 * syminfo.mintick) : high[1] + (2 * syminfo.mintick)
    if slPrice <= eLevel
        slPrice := math.max(high[0], math.max(high[1], high[2])) + (2 * syminfo.mintick)

    float riskBps = ((slPrice - eLevel) / eLevel) * 10000.0
    if riskBps > 0 and riskBps <= i_maxRiskBps
        box bObj = box.new(left=bar_index, top=zTop, right=bar_index + 15, bottom=zBot, bgcolor=color.new(#ef5350, 80), border_color=color.maroon)
        activeShortZone := PendingEntryZone.new(dir=-1, entryLevel=eLevel, structStopLoss=slPrice, armedBar=bar_index, isFilled=false, boxObj=bObj)

// ═══════════════════════════════════════════════════════════════════
// SECTION 5 — EXECUTION & 2-CONTRACT PACK MANAGEMENT
// ═══════════════════════════════════════════════════════════════════
inAmMacro    = not na(time(timeframe.period, i_sessionAm, "America/New_York"))
inPmMacro    = not na(time(timeframe.period, i_sessionPm, "America/New_York"))
inSession    = inAmMacro or inPmMacro
isEodBar     = not na(time(timeframe.period, "1555-1600:23456", "America/New_York"))

var int dailyTrades = 0
if ta.change(time("D")) != 0
    dailyTrades := 0

canTrade = inSession and (dailyTrades < i_maxDailyTrades) and (strategy.position_size == 0)

calcBpsDistance(float price, float bps) =>
    math.round((price * (bps / 10000.0)) / syminfo.mintick) * syminfo.mintick

var float activeEntryPrice = na
var float activeStopLoss   = na
var float activeTP1_Queen  = na
var float activeTP2_Runner = na

// Long Entry Fill (Next-Bar Anti-Repainting Execution)
if not na(activeLongZone) and not activeLongZone.isFilled and canTrade
    if (bar_index > activeLongZone.armedBar) and ((bar_index - activeLongZone.armedBar) <= i_maxEntryWait)
        if low <= activeLongZone.entryLevel
            activeEntryPrice := activeLongZone.entryLevel
            activeStopLoss   := activeLongZone.structStopLoss
            
            float curRunnerBps  = inPmMacro ? i_tp2PmBps : i_tp2AmBps
            float distQueen     = calcBpsDistance(activeEntryPrice, i_tp1QueenBps)
            float distRunner    = calcBpsDistance(activeEntryPrice, curRunnerBps)
            
            activeTP1_Queen  := activeEntryPrice + distQueen
            activeTP2_Runner := activeEntryPrice + distRunner
            dailyTrades      += 1

            strategy.entry("Long_Queen", strategy.long, qty=1, limit=activeEntryPrice, comment="L Queen (10bps)")
            strategy.entry("Long_Runner", strategy.long, qty=1, limit=activeEntryPrice, comment="L Runner (" + str.tostring(curRunnerBps, "#") + "bps)")
            strategy.exit("Exit_Queen", from_entry="Long_Queen", limit=activeTP1_Queen, stop=activeStopLoss, comment="Queen Hit")
            strategy.exit("Exit_Runner", from_entry="Long_Runner", limit=activeTP2_Runner, stop=activeStopLoss, comment="Runner Target")
            activeLongZone.isFilled := true
    else if (bar_index - activeLongZone.armedBar) > i_maxEntryWait
        box.delete(activeLongZone.boxObj)
        activeLongZone := na

// Short Entry Fill (Next-Bar Anti-Repainting Execution)
if not na(activeShortZone) and not activeShortZone.isFilled and canTrade
    if (bar_index > activeShortZone.armedBar) and ((bar_index - activeShortZone.armedBar) <= i_maxEntryWait)
        if high >= activeShortZone.entryLevel
            activeEntryPrice := activeShortZone.entryLevel
            activeStopLoss   := activeShortZone.structStopLoss
            
            float curRunnerBps  = inPmMacro ? i_tp2PmBps : i_tp2AmBps
            float distQueen     = calcBpsDistance(activeEntryPrice, i_tp1QueenBps)
            float distRunner    = calcBpsDistance(activeEntryPrice, curRunnerBps)
            
            activeTP1_Queen  := activeEntryPrice - distQueen
            activeTP2_Runner := activeEntryPrice - distRunner
            dailyTrades      += 1

            strategy.entry("Short_Queen", strategy.short, qty=1, limit=activeEntryPrice, comment="S Queen (10bps)")
            strategy.entry("Short_Runner", strategy.short, qty=1, limit=activeEntryPrice, comment="S Runner (" + str.tostring(curRunnerBps, "#") + "bps)")
            strategy.exit("Exit_Queen", from_entry="Short_Queen", limit=activeTP1_Queen, stop=activeStopLoss, comment="Queen Hit")
            strategy.exit("Exit_Runner", from_entry="Short_Runner", limit=activeTP2_Runner, stop=activeStopLoss, comment="Runner Target")
            activeShortZone.isFilled := true
    else if (bar_index - activeShortZone.armedBar) > i_maxEntryWait
        box.delete(activeShortZone.boxObj)
        activeShortZone := na

// Breakeven Stop Adjustment on Runner Once Queen is Covered
if strategy.position_size > 0 and high >= activeTP1_Queen
    strategy.exit("Exit_Runner_BE", from_entry="Long_Runner", limit=activeTP2_Runner, stop=activeEntryPrice, comment="Runner Breakeven")

if strategy.position_size < 0 and low <= activeTP1_Queen
    strategy.exit("Exit_Runner_BE", from_entry="Short_Runner", limit=activeTP2_Runner, stop=activeEntryPrice, comment="Runner Breakeven")

// Hard EOD Flatten (15:55 ET)
if i_eodFlatten and isEodBar and strategy.position_size != 0
    strategy.close_all(comment="EOD 15:55 Flat")

// ═══════════════════════════════════════════════════════════════════
// SECTION 6 — VISUAL PLOTS
// ═══════════════════════════════════════════════════════════════════
plot(strategy.position_size != 0 ? activeStopLoss : na, "Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeTP1_Queen : na, "Queen TP1 (10 bps)", color=color.green, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeTP2_Runner : na, "Runner TP2", color=color.teal, style=plot.style_linebr, linewidth=2)
