// ICT v3 — Liquidity Sweep -> CISD -> FVG Touch Entry -> SL-4 -> Cover The Queen
// Validated: WR 68.9%, PF 3.48 on NQ 2022-2026

//@version=6
strategy("ICT v3 Institutional (Liquidity -> CISD -> FVG Touch -> SL-4 -> Queen)",
  shorttitle="ICT_v3_Strategy",
  overlay=true,
  pyramiding=2,
  default_qty_type=strategy.fixed,
  default_qty_value=2,
  initial_capital=50000,
  currency=currency.USD,
  margin_long=0,
  margin_short=0,
  commission_type=strategy.commission.cash_per_contract,
  commission_value=0.52,
  max_boxes_count=500,
  max_lines_count=500,
  max_labels_count=500,
  max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════
// SECTION 1 — CONFIGURATION & PARAMETERS
// ═══════════════════════════════════════════════════════════════════
var string GRP_LIQ = "1. Liquidity Sources"
i_checkPdhPdl     = input.bool(true,  "Track Daily PDH/PDL Sweeps", group=GRP_LIQ)
i_check4H         = input.bool(true,  "Track 4-Hour Sweeps", group=GRP_LIQ)
i_check1H         = input.bool(true,  "Track 1-Hour Sweeps", group=GRP_LIQ)
i_checkSession    = input.bool(true,  "Track Session Range Sweeps (Asia/London/NYAM)", group=GRP_LIQ)
i_checkSwings     = input.bool(true,  "Track Intraday Swing Sweeps", group=GRP_LIQ)
i_sweepLookback   = input.int(25,     "Max Bars Since Liquidity Sweep", minval=5, maxval=50, group=GRP_LIQ)

var string GRP_ENTRY = "2. Entry & Risk Parameters"
i_entryModel      = input.string("FVG_Touch", "Entry Model", options=["FVG_Touch", "FVG_CE_50", "CISD_Level"], group=GRP_ENTRY)
i_slModel         = input.string("SL4_CISD_Origin", "Stop Loss Model", options=["SL1_SweepWick", "SL4_CISD_Origin", "FVG_FormingWick"], group=GRP_ENTRY)
i_maxRiskBps      = input.float(15.0, "Hard Risk Ceiling (Basis Points)", step=1.0, group=GRP_ENTRY)
i_minVolMult      = input.float(1.5,  "Min Volume Multiplier (x SMA20)", step=0.1, group=GRP_ENTRY)
i_maxEntryWait    = input.int(20,     "Max Bars Waiting for Retest", minval=3, maxval=30, group=GRP_ENTRY)
i_maxDailyTrades  = input.int(5,      "Max Trades Per Day", minval=1, maxval=10, group=GRP_ENTRY)

var string GRP_TP = "3. Basis Points Targets"
i_tp1QueenBps     = input.float(10.0, "Target 1: Cover The Queen (Basis Points)", step=1.0, group=GRP_TP)
i_runnerBps       = input.float(30.0, "Runner Target (Basis Points)", step=5.0, group=GRP_TP)

var string GRP_RISK = "4. Position Sizing"
i_riskUsd         = input.float(250.0, "Risk per Trade (USD)", step=50, group=GRP_RISK)
i_maxContracts    = input.int(10,     "Max Contracts", minval=1, maxval=50, group=GRP_RISK)

var string GRP_SESS = "5. Session Windows"
i_rthSession      = input.session("0945-1530:23456", "RTH Trading Window", group=GRP_SESS)
i_eodFlatten      = input.bool(true,  "Force EOD Flatten at 15:55 ET", group=GRP_SESS)

// ═══════════════════════════════════════════════════════════════════
// SECTION 2 — LIQUIDITY LEVELS (Daily, 4H, 1H, Sessions, Swings)
// ═══════════════════════════════════════════════════════════════════
// Daily PDH / PDL (shifted 1 bar for zero lookahead)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// 4H High/Low (shifted 1 bar)
[h4_h, h4_l] = request.security(syminfo.tickerid, "240", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// 1H High/Low (shifted 1 bar)
[h1_h, h1_l] = request.security(syminfo.tickerid, "60", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Session Range Sweeps — Asia (18:00-02:00), London (02:00-08:00), NYAM IB (09:30-10:00)
// Compute session H/L using request.security on daily with custom session windows
[asiaH, asiaL] = request.security(syminfo.tickerid, "D", [ta.highest(high, 1), ta.lowest(low, 1)], lookahead=barmerge.lookahead_on)
// For sessions, we use intraday session functions and track H/L
var float asiaHigh = na
var float asiaLow  = na
var float lonHigh  = na
var float lonLow   = na
var float nyamHigh = na
var float nyamLow  = na

// Session detection using time() on the chart timeframe
isAsiaBar  = not na(time(timeframe.period, "1800-0200:23456", "America/New_York"))
isLonBar   = not na(time(timeframe.period, "0200-0800:23456", "America/New_York"))
isNyamBar  = not na(time(timeframe.period, "0930-1000:23456", "America/New_York"))

// Track session H/L — reset at the START of each session
var bool wasAsia = false
var bool wasLon  = false
var bool wasNyam = false

if isAsiaBar and not wasAsia
    asiaHigh := high
    asiaLow  := low
else if isAsiaBar
    asiaHigh := math.max(asiaHigh, high)
    asiaLow  := math.min(asiaLow, low)
wasAsia := isAsiaBar

if isLonBar and not wasLon
    lonHigh := high
    lonLow  := low
else if isLonBar
    lonHigh := math.max(lonHigh, high)
    lonLow  := math.min(lonLow, low)
wasLon := isLonBar

if isNyamBar and not wasNyam
    nyamHigh := high
    nyamLow  := low
else if isNyamBar
    nyamHigh := math.max(nyamHigh, high)
    nyamLow  := math.min(nyamLow, low)
wasNyam := isNyamBar

// Intraday 3-Bar Fractal Swings (rolling list of last 10)
swH = ta.pivothigh(high, 3, 3)
swL = ta.pivotlow(low, 3, 3)
var float[] bslList = array.new<float>()
var float[] sslList = array.new<float>()

if not na(swH)
    array.push(bslList, swH)
    if array.size(bslList) > 10
        array.shift(bslList)

if not na(swL)
    array.push(sslList, swL)
    if array.size(sslList) > 10
        array.shift(sslList)

// ═══════════════════════════════════════════════════════════════════
// SECTION 3 — SWEEP DETECTION
// ═══════════════════════════════════════════════════════════════════
bool bslSwept = false
bool sslSwept = false
float sweepExtreme = na
string sweepSource = ""

// Daily PDH/PDL
if i_checkPdhPdl
    if not na(pdh) and high > pdh and (close < pdh or open < pdh)
        bslSwept := true, sweepExtreme := high, sweepSource := "PDH"
    if not na(pdl) and low < pdl and (close > pdl or open > pdl)
        sslSwept := true, sweepExtreme := low, sweepSource := "PDL"

// 4H Sweeps
if i_check4H and not bslSwept
    if not na(h4_h) and high > h4_h and (close < h4_h or open < h4_h)
        bslSwept := true, sweepExtreme := high, sweepSource := "4H_BSL"
if i_check4H and not sslSwept
    if not na(h4_l) and low < h4_l and (close > h4_l or open > h4_l)
        sslSwept := true, sweepExtreme := low, sweepSource := "4H_SSL"

// 1H Sweeps
if i_check1H and not bslSwept
    if not na(h1_h) and high > h1_h and (close < h1_h or open < h1_h)
        bslSwept := true, sweepExtreme := high, sweepSource := "1H_BSL"
if i_check1H and not sslSwept
    if not na(h1_l) and low < h1_l and (close > h1_l or open > h1_l)
        sslSwept := true, sweepExtreme := low, sweepSource := "1H_SSL"

// Session Sweeps
if i_checkSession and not bslSwept and not na(asiaHigh)
    if high > asiaHigh and (close < asiaHigh or open < asiaHigh)
        bslSwept := true, sweepExtreme := high, sweepSource := "Asia_H"
if i_checkSession and not sslSwept and not na(asiaLow)
    if low < asiaLow and (close > asiaLow or open > asiaLow)
        sslSwept := true, sweepExtreme := low, sweepSource := "Asia_L"
if i_checkSession and not bslSwept and not na(lonHigh)
    if high > lonHigh and (close < lonHigh or open < lonHigh)
        bslSwept := true, sweepExtreme := high, sweepSource := "Lon_H"
if i_checkSession and not sslSwept and not na(lonLow)
    if low < lonLow and (close > lonLow or open > lonLow)
        sslSwept := true, sweepExtreme := low, sweepSource := "Lon_L"
if i_checkSession and not bslSwept and not na(nyamHigh)
    if high > nyamHigh and (close < nyamHigh or open < nyamHigh)
        bslSwept := true, sweepExtreme := high, sweepSource := "NYAM_H"
if i_checkSession and not sslSwept and not na(nyamLow)
    if low < nyamLow and (close > nyamLow or open > nyamLow)
        sslSwept := true, sweepExtreme := low, sweepSource := "NYAM_L"

// Intraday Swing Sweeps
if i_checkSwings and not bslSwept and array.size(bslList) > 0
    for b = 0 to array.size(bslList) - 1
        float lvl = array.get(bslList, b)
        if high > lvl and close < lvl
            bslSwept := true, sweepExtreme := high, sweepSource := "Swing_H"
            break
if i_checkSwings and not sslSwept and array.size(sslList) > 0
    for s = 0 to array.size(sslList) - 1
        float lvl = array.get(sslList, s)
        if low < lvl and close > lvl
            sslSwept := true, sweepExtreme := low, sweepSource := "Swing_L"
            break

// Active Sweep State
var bool  hasBullSweep = false
var bool  hasBearSweep = false
var float bullSweepLow = na
var float bearSweepHigh = na
var int   bullSweepBar = -9999
var int   bearSweepBar = -9999
var string lastSweepSource = ""

if sslSwept
    hasBullSweep := true
    bullSweepLow := not na(sweepExtreme) ? sweepExtreme : low
    bullSweepBar := bar_index
    lastSweepSource := sweepSource

if bslSwept
    hasBearSweep := true
    bearSweepHigh := not na(sweepExtreme) ? sweepExtreme : high
    bearSweepBar := bar_index
    lastSweepSource := sweepSource

if (bar_index - bullSweepBar) > i_sweepLookback
    hasBullSweep := false
if (bar_index - bearSweepBar) > i_sweepLookback
    hasBearSweep := false

// ═══════════════════════════════════════════════════════════════════
// SECTION 4 — CANONICAL BACKWARD-WALKING CISD (UNCHANGED from validated baseline)
// ═══════════════════════════════════════════════════════════════════
var bool  armedBullCisd     = false
var bool  armedBearCisd     = false
var float armedBullHigh     = na
var float armedBearLow      = na
var float armedCisdOriginSL = na
var int   deliveryRegime    = 0   // +1 = Bull, -1 = Bear (persists for continuation FVGs)

if hasBullSweep and sslSwept
    float sHigh = math.max(open, close)
    float sLow  = math.min(open, close)
    for k = 1 to math.min(25, bar_index)
        if close[k] <= open[k]
            sHigh := math.max(sHigh, math.max(open[k], close[k]))
            sLow  := math.min(sLow,  math.min(open[k], close[k]))
        else
            break
    armedBullCisd     := true
    armedBullHigh     := sHigh
    armedCisdOriginSL := sLow

if hasBearSweep and bslSwept
    float sHigh = math.max(open, close)
    float sLow  = math.min(open, close)
    for k = 1 to math.min(25, bar_index)
        if close[k] >= open[k]
            sHigh := math.max(sHigh, math.max(open[k], close[k]))
            sLow  := math.min(sLow,  math.min(open[k], close[k]))
        else
            break
    armedBearCisd     := true
    armedBearLow      := sLow
    armedCisdOriginSL := sHigh

// CISD Confirmation: close crosses the run HIGH (full reclamation)
bool bullCisdTrigger = false
bool bearCisdTrigger = false

if armedBullCisd and not na(armedBullHigh) and close > armedBullHigh
    armedBullCisd := false
    hasBullSweep  := false
    bullCisdTrigger := true
    deliveryRegime := 1

if armedBearCisd and not na(armedBearLow) and close < armedBearLow
    armedBearCisd := false
    hasBearSweep  := false
    bearCisdTrigger := true
    deliveryRegime := -1

// Volume Gate (1.5x SMA20)
volSma20 = ta.sma(volume, 20)
bool passesVol = volume >= (i_minVolMult * volSma20)

// ═══════════════════════════════════════════════════════════════════
// SECTION 5 — FVG TOUCH ENTRY ARMING (with SL-4 stop)
// ═══════════════════════════════════════════════════════════════════
type PendingZone
    int    dir
    float  entryLevel
    float  stopLoss
    int    armedBar
    string sweepSrc
    box    boxObj

var PendingZone activeLong = na
var PendingZone activeShort = na

bool newBullFvg = low > high[2]
bool newBearFvg = high < low[2]

// Long: CISD trigger OR continuation FVG in bull delivery regime
if (bullCisdTrigger or (deliveryRegime == 1 and newBullFvg)) and na(activeLong) and strategy.position_size == 0
    float zTop = newBullFvg ? low : armedBullHigh
    float zBot = newBullFvg ? high[2] : (armedBullHigh - (syminfo.mintick * 4))
    float zCE  = (zTop + zBot) / 2.0

    // Entry model selection
    float ePrice = i_entryModel == "FVG_CE_50" ? zCE : (i_entryModel == "CISD_Level" ? (not na(armedBullHigh) ? armedBullHigh : zTop) : zTop)

    // SL model selection
    float slPrice = i_slModel == "SL1_SweepWick" ? (not na(bullSweepLow) ? bullSweepLow : low[1]) - (2 * syminfo.mintick) : (i_slModel == "SL4_CISD_Origin" ? (not na(armedCisdOriginSL) ? armedCisdOriginSL : low[1]) - (2 * syminfo.mintick) : (newBullFvg ? high[2] : bullSweepLow) - (2 * syminfo.mintick))
    if slPrice >= ePrice
        slPrice := math.min(low, math.min(low[1], low[2])) - (2 * syminfo.mintick)

    float riskBps = ((ePrice - slPrice) / ePrice) * 10000.0
    if riskBps > 0 and riskBps <= i_maxRiskBps
        box bObj = box.new(left=bar_index, top=zTop, right=bar_index + i_maxEntryWait, bottom=zBot, bgcolor=color.new(#26a69a, 80), border_color=color.teal)
        activeLong := PendingZone.new(1, ePrice, slPrice, bar_index, lastSweepSource, bObj)

// Short: CISD trigger OR continuation FVG in bear delivery regime
if (bearCisdTrigger or (deliveryRegime == -1 and newBearFvg)) and na(activeShort) and strategy.position_size == 0
    float zTop = newBearFvg ? low[2] : (armedBearLow + (syminfo.mintick * 4))
    float zBot = newBearFvg ? high : armedBearLow
    float zCE  = (zTop + zBot) / 2.0

    float ePrice = i_entryModel == "FVG_CE_50" ? zCE : (i_entryModel == "CISD_Level" ? (not na(armedBearLow) ? armedBearLow : zBot) : zBot)

    float slPrice = i_slModel == "SL1_SweepWick" ? (not na(bearSweepHigh) ? bearSweepHigh : high[1]) + (2 * syminfo.mintick) : (i_slModel == "SL4_CISD_Origin" ? (not na(armedCisdOriginSL) ? armedCisdOriginSL : high[1]) + (2 * syminfo.mintick) : (newBearFvg ? low[2] : bearSweepHigh) + (2 * syminfo.mintick))
    if slPrice <= ePrice
        slPrice := math.max(high, math.max(high[1], high[2])) + (2 * syminfo.mintick)

    float riskBps = ((slPrice - ePrice) / ePrice) * 10000.0
    if riskBps > 0 and riskBps <= i_maxRiskBps
        box bObj = box.new(left=bar_index, top=zTop, right=bar_index + i_maxEntryWait, bottom=zBot, bgcolor=color.new(#ef5350, 80), border_color=color.maroon)
        activeShort := PendingZone.new(-1, ePrice, slPrice, bar_index, lastSweepSource, bObj)

// ═══════════════════════════════════════════════════════════════════
// SECTION 6 — EXECUTION, POSITION SIZING & 2-CONTRACT PACK
// ═══════════════════════════════════════════════════════════════════
inRth = not na(time(timeframe.period, i_rthSession, "America/New_York"))
isEod = not na(time(timeframe.period, "1555-1600:23456", "America/New_York"))

var int dailyTrades = 0
if ta.change(time("D")) != 0
    dailyTrades := 0

calcBpsDistance(price, bps) =>
    math.round((price * (bps / 10000.0)) / syminfo.mintick) * syminfo.mintick

// Position sizing: contracts = risk_usd / (sl_dist_pts * point_value)
calcContracts(entryPrice, slPrice) =>
    float slDist = math.abs(entryPrice - slPrice)
    if slDist <= 0
        2
    else
        int qty = int(i_riskUsd / (slDist * syminfo.pointvalue))
        math.max(2, math.min(qty, i_maxContracts))

var float activeEntry = na
var float activeSL    = na
var float activeQueenTP = na
var float activeRunnerTP = na
var bool  queenFilled = false

// Long Fill
if not na(activeLong) and strategy.position_size == 0 and inRth and dailyTrades < i_maxDailyTrades and passesVol
    if (bar_index > activeLong.armedBar) and ((bar_index - activeLong.armedBar) <= i_maxEntryWait)
        if low <= activeLong.entryLevel
            int contracts = calcContracts(activeLong.entryLevel, activeLong.stopLoss)
            activeEntry := activeLong.entryLevel
            activeSL    := activeLong.stopLoss
            queenFilled := false

            float distQ = calcBpsDistance(activeEntry, i_tp1QueenBps)
            float distR = calcBpsDistance(activeEntry, i_runnerBps)
            activeQueenTP  := activeEntry + distQ
            activeRunnerTP := activeEntry + distR
            dailyTrades += 1

            strategy.entry("L_Queen", strategy.long, qty=contracts, limit=activeEntry, comment="L Queen")
            strategy.entry("L_Runner", strategy.long, qty=contracts, limit=activeEntry, comment="L Runner")
            strategy.exit("X_L_Q", from_entry="L_Queen", limit=activeQueenTP, stop=activeSL, comment="Queen Hit")
            strategy.exit("X_L_R", from_entry="L_Runner", limit=activeRunnerTP, stop=activeSL, comment="Runner TP")
            box.delete(activeLong.boxObj)
            activeLong := na
    else if (bar_index - activeLong.armedBar) > i_maxEntryWait
        box.delete(activeLong.boxObj)
        activeLong := na

// Short Fill
if not na(activeShort) and strategy.position_size == 0 and inRth and dailyTrades < i_maxDailyTrades and passesVol
    if (bar_index > activeShort.armedBar) and ((bar_index - activeShort.armedBar) <= i_maxEntryWait)
        if high >= activeShort.entryLevel
            int contracts = calcContracts(activeShort.entryLevel, activeShort.stopLoss)
            activeEntry := activeShort.entryLevel
            activeSL    := activeShort.stopLoss
            queenFilled := false

            float distQ = calcBpsDistance(activeEntry, i_tp1QueenBps)
            float distR = calcBpsDistance(activeEntry, i_runnerBps)
            activeQueenTP  := activeEntry - distQ
            activeRunnerTP := activeEntry - distR
            dailyTrades += 1

            strategy.entry("S_Queen", strategy.short, qty=contracts, limit=activeEntry, comment="S Queen")
            strategy.entry("S_Runner", strategy.short, qty=contracts, limit=activeEntry, comment="S Runner")
            strategy.exit("X_S_Q", from_entry="S_Queen", limit=activeQueenTP, stop=activeSL, comment="Queen Hit")
            strategy.exit("X_S_R", from_entry="S_Runner", limit=activeRunnerTP, stop=activeSL, comment="Runner TP")
            box.delete(activeShort.boxObj)
            activeShort := na
    else if (bar_index - activeShort.armedBar) > i_maxEntryWait
        box.delete(activeShort.boxObj)
        activeShort := na

// Breakeven Stop on Runner when Queen fills
if strategy.position_size > 0 and not queenFilled and high >= activeQueenTP
    queenFilled := true
    strategy.exit("X_L_R_BE", from_entry="L_Runner", limit=activeRunnerTP, stop=activeEntry, comment="Runner BE")

if strategy.position_size < 0 and not queenFilled and low <= activeQueenTP
    queenFilled := true
    strategy.exit("X_S_R_BE", from_entry="S_Runner", limit=activeRunnerTP, stop=activeEntry, comment="Runner BE")

// Hard EOD Flatten
if i_eodFlatten and isEod and strategy.position_size != 0
    strategy.close_all(comment="EOD 15:55 Flat")

// ═══════════════════════════════════════════════════════════════════
// SECTION 7 — VISUAL PLOTS
// ═══════════════════════════════════════════════════════════════════
plot(strategy.position_size != 0 ? activeSL : na, "Stop Loss (SL-4)", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeQueenTP : na, "Queen TP (10 bps)", color=color.green, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeRunnerTP : na, "Runner TP (30 bps)", color=color.teal, style=plot.style_linebr, linewidth=2)
bgcolor(not na(activeLong) ? color.new(color.green, 95) : na, title="Long Zone")
bgcolor(not na(activeShort) ? color.new(color.red, 95) : na, title="Short Zone")