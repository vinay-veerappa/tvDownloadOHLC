// Canonical ICT CISD / iFVG / BPR Multi-Variant Strategy & Visualization Engine

//@version=6
strategy("ICT CISD / iFVG / BPR Multi-Variant Strategy",
  shorttitle="ICT_CISD_Strategy",
  overlay=true,
  pyramiding=2,
  default_qty_type=strategy.fixed,
  default_qty_value=2,
  initial_capital=50000,
  currency=currency.USD,
  margin_long=0,
  margin_short=0,
  commission_type=strategy.commission.cash_per_contract,
  commission_value=0.52,
  max_boxes_count=500,
  max_lines_count=500,
  max_labels_count=500,
  max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════
// SECTION 1 — CONFIGURATION & PARAMETERS
// ═══════════════════════════════════════════════════════════════════
var string GRP_VAR = "1. Strategy Variant"
i_variant         = input.string("Variant 2: [No IFVG + 2x FVG] @ 2nd FVG Entry (CISD Low/High Stop)", "Strategy Variant", 
  options=[
    "Baseline: IFVG + CISD (ATR Stop)", 
    "Variant 1: [BPR or (IFVG+FVG)] @ CISD Entry (CISD Low/High Stop)", 
    "Variant 2: [No IFVG + 2x FVG] @ 2nd FVG Entry (CISD Low/High Stop)"
  ], group=GRP_VAR)

var string GRP_RISK = "2. Risk & Position Management"
i_rMultTP1        = input.float(1.0, "Queen Target R-Multiplier (TP1 50%)", step=0.1, group=GRP_RISK)
i_rMultTP2        = input.float(2.5, "Runner Target R-Multiplier (TP2 50%)", step=0.5, group=GRP_RISK)
i_stopLossBps     = input.float(5.0, "Stop Loss (Basis Points)", step=0.5, group=GRP_RISK, tooltip="5.0 bps stop covers entire FVG on limit pullback entry.")
i_minRiskBps      = input.float(2.0, "Min Risk (Basis Points)", step=0.5, group=GRP_RISK, tooltip="1 bps = 0.01% of price. Skip if risk below this.")
i_maxRiskBps      = input.float(15.0, "Max Risk Ceiling (Basis Points)", step=1.0, group=GRP_RISK, tooltip="Prop firm limit. Skip if structural risk above this.")
i_maxDailyTrades  = input.int(5, "Max Trades Per Day", minval=1, maxval=10, group=GRP_RISK)

var string GRP_SESS = "3. Session Windows"
i_rthSession      = input.session("0945-1600:23456", "Trading Session Window (09:45 Turnaround)", group=GRP_SESS, tooltip="Filters out 09:30-09:45 Judas trap; starts at 09:45 turnaround.")
i_filterLunch     = input.bool(false, "Exclude Lunch Lull (11:30 - 13:30)", group=GRP_SESS)
i_eodFlatten      = input.bool(true, "Force EOD Flatten at 15:55 ET", group=GRP_SESS)

var string GRP_ENTRY = "3b. Entry Mechanism"
i_entryMech       = input.string("FVG Limit", "Entry Mechanism",
  options=["Market", "FVG Limit", "CISD Limit", "Breakout"], group=GRP_ENTRY)

var string GRP_VIS = "4. Visual Drawings & Annotations"
i_drawFvg         = input.bool(true,  "Draw FVG Boxes with C.E. 50% Line", group=GRP_VIS)
i_drawCisd        = input.bool(true,  "Draw CISD Lines & Labels", group=GRP_VIS)
i_drawSignals     = input.bool(true,  "Show Entry & Exit Markers", group=GRP_VIS)
i_extendFvgBars   = input.int(10,     "FVG Box Projection Length (Bars)", minval=1, maxval=50, group=GRP_VIS)
i_boxTransparency = input.int(80,     "Box Transparency %", minval=0, maxval=100, group=GRP_VIS)

// Visual Palette
color c_bullFvgFill   = color.new(#00BCD4, i_boxTransparency)
color c_bullFvgBorder = color.new(#00BCD4, 30)
color c_bearFvgFill   = color.new(#FF5252, i_boxTransparency)
color c_bearFvgBorder = color.new(#FF5252, 30)
color c_cisdLine      = color.new(#2962FF, 0)
color c_ceMidLine     = color.new(#9E9E9E, 40)

float atr14 = ta.atr(14)

// Managed Drawing Collections (FIFO to prevent TradingView 500-limit garbage collection glitches)
var box[]   fvgBoxes   = array.new_box()
var line[]  fvgLines   = array.new_line()
var line[]  cisdLines  = array.new_line()
var label[] cisdLabels = array.new_label()

// ═══════════════════════════════════════════════════════════════════
// SECTION 2 — FAIR VALUE GAPS (FVG), iFVG & BPR DETECTION
// ═══════════════════════════════════════════════════════════════════
// Pure 3-bar ICT imbalance definition (Independent of bar 0 candle color!)
bool isBullFvg = (low > high[2])
bool isBearFvg = (high < low[2])

var float[] bullFvgTops = array.new_float()
var float[] bullFvgBots = array.new_float()
var float[] bearFvgTops = array.new_float()
var float[] bearFvgBots = array.new_float()

// Merged FVG boundaries (this bar) for unmitigated leg tracking
var float lastBullFvgBot = na
var float lastBearFvgTop = na

bool isBullBpr = false
bool isBearBpr = false

// Render Bullish FVG
if isBullFvg
    float gTop = low
    float gBot = high[2]

    // Canonical ICT body-gap merging: gaps between candle bodies 1-2 and/or 2-3
    // within the 3-candle FVG formation expand the FVG zone.
    float bodyTop2 = math.max(open[2], close[2])
    float bodyBot1 = math.min(open[1], close[1])
    if (bodyBot1 > bodyTop2) and (high[2] >= low[1]) and (bodyTop2 <= gTop) and (bodyBot1 >= gBot)
        gTop := math.max(gTop, bodyBot1)
        gBot := math.min(gBot, bodyTop2)

    float bodyTop1 = math.max(open[1], close[1])
    float bodyBot0 = math.min(open, close)
    if (bodyBot0 > bodyTop1) and (high[1] >= low) and (bodyTop1 <= gTop) and (bodyBot0 >= gBot)
        gTop := math.max(gTop, bodyBot0)
        gBot := math.min(gBot, bodyTop1)

    float gMid = (gTop + gBot) / 2.0

    // Check BPR Overlap
    if array.size(bearFvgTops) > 0
        for b = array.size(bearFvgTops) - 1 to 0
            float ovTop = math.min(gTop, array.get(bearFvgTops, b))
            float ovBot = math.max(gBot, array.get(bearFvgBots, b))
            if ovTop > ovBot
                isBullBpr := true
                break

    array.push(bullFvgTops, gTop)
    array.push(bullFvgBots, gBot)
    if array.size(bullFvgTops) > 50
        array.shift(bullFvgTops)
        array.shift(bullFvgBots)
    lastBullFvgBot := gBot

    if i_drawFvg
        bx = box.new(left=bar_index - 2, top=gTop, right=bar_index + i_extendFvgBars, bottom=gBot,
          border_color=c_bullFvgBorder, border_width=1, bgcolor=c_bullFvgFill)
        ln = line.new(x1=bar_index - 2, y1=gMid, x2=bar_index + i_extendFvgBars, y2=gMid,
          color=c_ceMidLine, style=line.style_dashed, width=1)
        array.push(fvgBoxes, bx)
        array.push(fvgLines, ln)
        if array.size(fvgBoxes) > 80
            box.delete(array.shift(fvgBoxes))
            line.delete(array.shift(fvgLines))

// Render Bearish FVG
if isBearFvg
    float gTop = low[2]
    float gBot = high

    // Canonical ICT body-gap merging: gaps between candle bodies 1-2 and/or 2-3
    // within the 3-candle FVG formation expand the FVG zone.
    float bodyBot2 = math.min(open[2], close[2])
    float bodyTop1 = math.max(open[1], close[1])
    if (bodyTop1 < bodyBot2) and (low[2] <= high[1]) and (bodyBot2 >= gBot) and (bodyTop1 <= gTop)
        gBot := math.min(gBot, bodyTop1)
        gTop := math.max(gTop, bodyBot2)

    float bodyBot1 = math.min(open[1], close[1])
    float bodyTop0 = math.max(open, close)
    if (bodyTop0 < bodyBot1) and (low[1] <= high) and (bodyBot1 >= gBot) and (bodyTop0 <= gTop)
        gBot := math.min(gBot, bodyTop0)
        gTop := math.max(gTop, bodyBot1)

    float gMid = (gTop + gBot) / 2.0

    // Check BPR Overlap
    if array.size(bullFvgTops) > 0
        for b = array.size(bullFvgTops) - 1 to 0
            float ovTop = math.min(gTop, array.get(bullFvgTops, b))
            float ovBot = math.max(gBot, array.get(bullFvgBots, b))
            if ovTop > ovBot
                isBearBpr := true
                break

    array.push(bearFvgTops, gTop)
    array.push(bearFvgBots, gBot)
    if array.size(bearFvgTops) > 50
        array.shift(bearFvgTops)
        array.shift(bearFvgBots)
    lastBearFvgTop := gTop

    if i_drawFvg
        bx = box.new(left=bar_index - 2, top=gTop, right=bar_index + i_extendFvgBars, bottom=gBot,
          border_color=c_bearFvgBorder, border_width=1, bgcolor=c_bearFvgFill)
        ln = line.new(x1=bar_index - 2, y1=gMid, x2=bar_index + i_extendFvgBars, y2=gMid,
          color=c_ceMidLine, style=line.style_dashed, width=1)
        array.push(fvgBoxes, bx)
        array.push(fvgLines, ln)
        if array.size(fvgBoxes) > 80
            box.delete(array.shift(fvgBoxes))
            line.delete(array.shift(fvgLines))

// Inversion FVG Check
bool isBullIfvg = false
bool isBearIfvg = false

if array.size(bearFvgTops) > 0
    for b = array.size(bearFvgTops) - 1 to 0
        if close > array.get(bearFvgTops, b) and close[1] <= array.get(bearFvgTops, b)
            isBullIfvg := true
            break

if array.size(bullFvgBots) > 0
    for b = array.size(bullFvgBots) - 1 to 0
        if close < array.get(bullFvgBots, b) and close[1] >= array.get(bullFvgBots, b)
            isBearIfvg := true
            break

// ═══════════════════════════════════════════════════════════════════
// SECTION 3 — CANONICAL INSTITUTIONAL CISD ENGINE (tncylyv extreme-open model)
// ═══════════════════════════════════════════════════════════════════
// One continuous level per regime; extreme open of the delivery run;
// re-anchors on every new bias-direction extreme; fires on close cross.
// See docs/strategies/ifvg_cisd/CISD_ENGINE_AUDIT.md

consult_the_crystal_ball(int bias) =>
    int temporal_shift = 0
    float extreme = open[0]
    int candle_attitude = close[0] > open[0] ? 1 : close[0] < open[0] ? -1 : 0
    if candle_attitude == 0 or candle_attitude != bias
        [extreme, bar_index]
    for i = 1 to 500
        candle_attitude := close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
        if candle_attitude == 0
            continue
        if candle_attitude != bias
            break
        temporal_shift := i
        if bias == 1
            if open[i] < extreme
                extreme := open[i]
        else
            if open[i] > extreme
                extreme := open[i]
    int extreme_shift = na
    for k = 0 to temporal_shift
        if open[k] == extreme
            extreme_shift := k
            break
    [extreme, bar_index - extreme_shift]

archaeologist_jones(int bias) =>
    int i = 1
    bool artifact_found = false
    int max_shift = na
    float extreme = na
    for j = 1 to 500
        i := j
        int candle_attitude = close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
        if candle_attitude == 0
            continue
        bool is_correct_era = candle_attitude == bias
        if not artifact_found
            if is_correct_era
                artifact_found := true
                max_shift := i
                extreme := open[i]
        else
            if not is_correct_era
                break
            max_shift := i
            if bias == 1
                if open[i] < extreme
                    extreme := open[i]
            else
                if open[i] > extreme
                    extreme := open[i]
    int extreme_shift = na
    for k = 1 to max_shift
        if open[k] == extreme
            extreme_shift := k
            break
    [extreme, bar_index - extreme_shift]

var int   vibes              = 0
var float bagholderEntry      = na
var int   timeMachineSetting  = na
var float painThreshold       = na
var int   bullMoveFvgCount    = 0
var int   bearMoveFvgCount    = 0

int candlePersonality = close > open ? 1 : close < open ? -1 : 0

// --- Init ---
if vibes == 0 and bar_index > 10
    int firstImpression = candlePersonality
    if firstImpression == 0
        for k = 1 to 50
            firstImpression := close[k] > open[k] ? 1 : close[k] < open[k] ? -1 : 0
            if firstImpression != 0
                break
    if firstImpression != 0
        vibes := firstImpression
        [origin_price, origin_time] = consult_the_crystal_ball(firstImpression)
        bagholderEntry     := origin_price
        timeMachineSetting := origin_time
        painThreshold      := firstImpression == 1 ? high : low

// --- Re-anchor on new extreme ---
if vibes == 1 and high > painThreshold
    painThreshold := high
    float p1 = na
    int   b1 = na
    if candlePersonality == 1
        [p1, b1] = consult_the_crystal_ball(1)
    else
        [p1, b1] = archaeologist_jones(1)
    if not na(p1)
        bagholderEntry     := p1
        timeMachineSetting := b1
else if vibes == -1 and low < painThreshold
    painThreshold := low
    float p1 = na
    int   b1 = na
    if candlePersonality == -1
        [p1, b1] = consult_the_crystal_ball(-1)
    else
        [p1, b1] = archaeologist_jones(-1)
    if not na(p1)
        bagholderEntry     := p1
        timeMachineSetting := b1

// --- Flip detection ---
bool shortsSqueezed = vibes == -1 and close > bagholderEntry
bool longsRekt      = vibes == 1 and close < bagholderEntry

// Leg Trackers
var bool  legHasBpr        = false
var bool  legHasIfvg       = false
var float legOriginLow     = na    // crossed CISD level (structural stop for LONG)
var float legOriginHigh    = na    // crossed CISD level (structural stop for SHORT)
var float legCisdLevel     = na    // new armed CISD level (entry price)
var float legCrossedLevel  = na    // the old regime's level that was breached
var bool  v2TriggeredInLeg = false

// Unmitigated FVG tracking for the active leg (V2 displacement proxy)
var float[] legBullFvgBots = array.new_float()
var float[] legBearFvgTops = array.new_float()

// Prior leg flags (snapshot before reset at CISD flip)
var bool  priorLegHasBpr = false
var bool  priorLegHasIfvg = false
var int   priorBullFvgSnap = 0
var int   priorBearFvgSnap = 0
var int   priorBullFvgUnmitigated = 0
var int   priorBearFvgUnmitigated = 0

bool bullCisdTrigger = false
bool bearCisdTrigger = false

// Snapshot the crossed level BEFORE re-arming
float crossedLevelSnapshot = bagholderEntry

// Snapshot prior leg flags BEFORE reset
priorLegHasBpr := legHasBpr
priorLegHasIfvg := legHasIfvg
priorBullFvgSnap := bullMoveFvgCount
priorBearFvgSnap := bearMoveFvgCount
priorBullFvgUnmitigated := array.size(legBullFvgBots)
priorBearFvgUnmitigated := array.size(legBearFvgTops)

if shortsSqueezed
    bullCisdTrigger  := true
    vibes            := 1
    legCrossedLevel  := crossedLevelSnapshot
    legOriginLow     := crossedLevelSnapshot  // structural stop = crossed bear CISD level
    legOriginHigh    := na
    [reset_price, reset_time] = consult_the_crystal_ball(1)
    legCisdLevel     := reset_price             // entry = new armed CISD level
    legHasBpr        := false                   // reset for new leg
    legHasIfvg       := false
    v2TriggeredInLeg := false
    bullMoveFvgCount := 0
    array.clear(legBullFvgBots)
    array.clear(legBearFvgTops)

    if i_drawCisd
        ln = line.new(x1=timeMachineSetting, y1=bagholderEntry, x2=bar_index + 4, y2=bagholderEntry,
          color=c_cisdLine, width=2)
        lb = label.new(x=bar_index, y=bagholderEntry, text="+CISD", color=color.new(color.green, 100),
          textcolor=c_cisdLine, style=label.style_label_left, size=size.small)
        array.push(cisdLines, ln)
        array.push(cisdLabels, lb)
        if array.size(cisdLines) > 30
            line.delete(array.shift(cisdLines))
            label.delete(array.shift(cisdLabels))

    bagholderEntry     := reset_price
    timeMachineSetting := reset_time
    painThreshold      := high

else if longsRekt
    bearCisdTrigger   := true
    vibes             := -1
    legCrossedLevel   := crossedLevelSnapshot
    legOriginLow      := na
    legOriginHigh     := crossedLevelSnapshot  // structural stop = crossed bull CISD level
    [reset_price2, reset_time2] = consult_the_crystal_ball(-1)
    legCisdLevel      := reset_price2            // entry = new armed CISD level
    legHasBpr         := false                   // reset for new leg
    legHasIfvg        := false
    v2TriggeredInLeg  := false
    bearMoveFvgCount  := 0
    array.clear(legBullFvgBots)
    array.clear(legBearFvgTops)

    if i_drawCisd
        ln = line.new(x1=timeMachineSetting, y1=bagholderEntry, x2=bar_index + 4, y2=bagholderEntry,
          color=c_cisdLine, width=2)
        lb = label.new(x=bar_index, y=bagholderEntry, text="-CISD", color=color.new(color.red, 100),
          textcolor=c_cisdLine, style=label.style_label_left, size=size.small)
        array.push(cisdLines, ln)
        array.push(cisdLabels, lb)
        if array.size(cisdLines) > 30
            line.delete(array.shift(cisdLines))
            label.delete(array.shift(cisdLabels))

    bagholderEntry     := reset_price2
    timeMachineSetting := reset_time2
    painThreshold      := low

// Accumulate FVGs in the active move + set leg flags (mirrors Python kernel)
if vibes == 1 and isBullFvg
    bullMoveFvgCount += 1
    array.push(legBullFvgBots, lastBullFvgBot)
if vibes == -1 and isBearFvg
    bearMoveFvgCount += 1
    array.push(legBearFvgTops, lastBearFvgTop)
if isBullBpr or isBearBpr
    legHasBpr := true
if (isBullIfvg and vibes == 1) or (isBearIfvg and vibes == -1)
    legHasIfvg := true

// Mitigation: remove filled leg FVGs (bull filled when low <= bot, bear when high >= top)
if array.size(legBullFvgBots) > 0
    for b = array.size(legBullFvgBots) - 1 to 0
        if low <= array.get(legBullFvgBots, b)
            array.remove(legBullFvgBots, b)
if array.size(legBearFvgTops) > 0
    for b = array.size(legBearFvgTops) - 1 to 0
        if high >= array.get(legBearFvgTops, b)
            array.remove(legBearFvgTops, b)

// ═══════════════════════════════════════════════════════════════════
// SECTION 4 — VARIANT SIGNAL LOGIC (ICT-corrected)
// ═══════════════════════════════════════════════════════════════════
// All variants: entry at CISD level, stop at crossed CISD level (SL-4),
// risk in basis points (prop firm compatible). Skip if risk outside limits.

bool signalLong = false
bool signalShort = false
float entryPrice = close
float stopPrice = na
string signalTag = ""

// Bps risk limits: min_risk = price * min_bps / 10000, max_risk = price * max_bps / 10000
float priceRef = close
float minRiskPts = priceRef * i_minRiskBps / 10000.0
float maxRiskPts = priceRef * i_maxRiskBps / 10000.0

if i_variant == "Baseline: IFVG + CISD (ATR Stop)"
    if vibes == 1 and isBullIfvg
        signalLong  := true
        entryPrice  := close
        float risk  = math.max(minRiskPts, math.min(maxRiskPts, atr14 * 1.8))
        stopPrice   := entryPrice - risk
        signalTag   := "Baseline IFVG"
    else if vibes == -1 and isBearIfvg
        signalShort := true
        entryPrice  := close
        float risk  = math.max(minRiskPts, math.min(maxRiskPts, atr14 * 1.8))
        stopPrice   := entryPrice + risk
        signalTag   := "Baseline IFVG"

else if i_variant == "Variant 1: [BPR or (IFVG+FVG)] @ CISD Entry (CISD Low/High Stop)"
    // V1 uses PRIOR leg flags. The prior leg's BPR or IFVG is the reversal
    // evidence; no FVG-count AND.
    if bullCisdTrigger and (priorLegHasBpr or priorLegHasIfvg)
        entryPrice  := not na(legCisdLevel) ? legCisdLevel : close
        float rawStop = not na(legOriginLow) ? (legOriginLow - syminfo.mintick * 2) : (low - syminfo.mintick * 2)
        if rawStop >= entryPrice
            rawStop := low - syminfo.mintick * 2
        float risk  = math.abs(entryPrice - rawStop)
        if risk >= minRiskPts and risk <= maxRiskPts
            signalLong  := true
            stopPrice   := rawStop
            signalTag   := "V1: CISD Entry"
    else if bearCisdTrigger and (priorLegHasBpr or priorLegHasIfvg)
        entryPrice  := not na(legCisdLevel) ? legCisdLevel : close
        float rawStop = not na(legOriginHigh) ? (legOriginHigh + syminfo.mintick * 2) : (high + syminfo.mintick * 2)
        if rawStop <= entryPrice
            rawStop := high + syminfo.mintick * 2
        float risk  = math.abs(rawStop - entryPrice)
        if risk >= minRiskPts and risk <= maxRiskPts
            signalShort := true
            stopPrice   := rawStop
            signalTag   := "V1: CISD Entry"

else if i_variant == "Variant 2: [No IFVG + 2x FVG] @ 2nd FVG Entry (CISD Low/High Stop)"
    // ICT-corrected: CISD trigger bar only + 2+ UNMITIGATED FVGs from the
    // OPPOSING delivery run (the delivery that got reversed).
    if bullCisdTrigger and not v2TriggeredInLeg and priorBearFvgUnmitigated >= 2
        entryPrice  := not na(legCisdLevel) ? legCisdLevel : close
        float rawStop = not na(legOriginLow) ? (legOriginLow - syminfo.mintick * 2) : (low - syminfo.mintick * 2)
        if rawStop >= entryPrice
            rawStop := low - syminfo.mintick * 2
        float risk  = math.abs(entryPrice - rawStop)
        if risk >= minRiskPts and risk <= maxRiskPts
            signalLong  := true
            stopPrice   := rawStop
            v2TriggeredInLeg := true
            signalTag   := "V2: CISD+2FVG"
    else if bearCisdTrigger and not v2TriggeredInLeg and priorBullFvgUnmitigated >= 2
        entryPrice  := not na(legCisdLevel) ? legCisdLevel : close
        float rawStop = not na(legOriginHigh) ? (legOriginHigh + syminfo.mintick * 2) : (high + syminfo.mintick * 2)
        if rawStop <= entryPrice
            rawStop := high + syminfo.mintick * 2
        float risk  = math.abs(rawStop - entryPrice)
        if risk >= minRiskPts and risk <= maxRiskPts
            signalShort := true
            stopPrice   := rawStop
            v2TriggeredInLeg := true
            signalTag   := "V2: CISD+2FVG"

// ═══════════════════════════════════════════════════════════════════
// SECTION 5 — EXECUTION & POSITION MANAGEMENT
// ═══════════════════════════════════════════════════════════════════
bool inRth = not na(time(timeframe.period, i_rthSession, "America/New_York"))
bool inLunch = i_filterLunch and not na(time(timeframe.period, "1130-1330:23456", "America/New_York"))
bool canTrade = inRth and not inLunch

var int dailyTrades = 0
bool isNewDay = not na(ta.change(time("D"))) and ta.change(time("D")) != 0
if isNewDay
    dailyTrades := 0

var float activeEntry = na
var float activeSL    = na
var float activeTP1   = na
var float activeTP2   = na
var bool  tp1Hit      = false

// Execute Entry
if canTrade and dailyTrades < i_maxDailyTrades and strategy.position_size == 0
    if signalLong and not na(stopPrice)
        float orderEntry = entryPrice
        if i_entryMech == "Breakout"
            orderEntry := high
        float riskPts = orderEntry - stopPrice
        activeEntry := orderEntry
        activeSL    := stopPrice
        activeTP1   := orderEntry + (riskPts * i_rMultTP1)
        activeTP2   := orderEntry + (riskPts * i_rMultTP2)
        tp1Hit      := false

        if i_entryMech == "CISD Limit"
            strategy.entry("Queen", strategy.long, qty=1, limit=orderEntry)
            strategy.entry("Runner", strategy.long, qty=1, limit=orderEntry)
        else if i_entryMech == "Breakout"
            strategy.entry("Queen", strategy.long, qty=1, stop=orderEntry)
            strategy.entry("Runner", strategy.long, qty=1, stop=orderEntry)
        else
            strategy.entry("Queen", strategy.long, qty=1)
            strategy.entry("Runner", strategy.long, qty=1)
        dailyTrades += 1

        if i_drawSignals
            label.new(x=bar_index, y=low - (riskPts * 0.3), text="BUY (" + signalTag + ")\nSL: " + str.tostring(stopPrice, "#.##"),
              color=color.green, textcolor=color.white, style=label.style_label_up, size=size.normal)

    else if signalShort and not na(stopPrice)
        float orderEntry = entryPrice
        if i_entryMech == "Breakout"
            orderEntry := low
        float riskPts = stopPrice - orderEntry
        activeEntry := orderEntry
        activeSL    := stopPrice
        activeTP1   := orderEntry - (riskPts * i_rMultTP1)
        activeTP2   := orderEntry - (riskPts * i_rMultTP2)
        tp1Hit      := false

        if i_entryMech == "CISD Limit"
            strategy.entry("Queen", strategy.short, qty=1, limit=orderEntry)
            strategy.entry("Runner", strategy.short, qty=1, limit=orderEntry)
        else if i_entryMech == "Breakout"
            strategy.entry("Queen", strategy.short, qty=1, stop=orderEntry)
            strategy.entry("Runner", strategy.short, qty=1, stop=orderEntry)
        else
            strategy.entry("Queen", strategy.short, qty=1)
            strategy.entry("Runner", strategy.short, qty=1)
        dailyTrades += 1

        if i_drawSignals
            label.new(x=bar_index, y=high + (riskPts * 0.3), text="SELL (" + signalTag + ")\nSL: " + str.tostring(stopPrice, "#.##"),
              color=color.red, textcolor=color.white, style=label.style_label_down, size=size.normal)

// Manage Active Positions (Cover The Queen scale out + BE Lock)
string lossComment = tp1Hit ? "BE Hit" : "SL Hit"

if strategy.position_size > 0
    if not tp1Hit and high >= activeTP1
        tp1Hit := true
        activeSL := activeEntry // Breakeven lock

    strategy.exit("Exit Queen", "Queen", limit=activeTP1, stop=activeSL, comment_profit="TP1 (Queen)", comment_loss=lossComment)
    strategy.exit("Exit Runner", "Runner", limit=activeTP2, stop=activeSL, comment_profit="TP2 (Runner)", comment_loss=lossComment)

else if strategy.position_size < 0
    if not tp1Hit and low <= activeTP1
        tp1Hit := true
        activeSL := activeEntry // Breakeven lock

    strategy.exit("Exit Queen", "Queen", limit=activeTP1, stop=activeSL, comment_profit="TP1 (Queen)", comment_loss=lossComment)
    strategy.exit("Exit Runner", "Runner", limit=activeTP2, stop=activeSL, comment_profit="TP2 (Runner)", comment_loss=lossComment)

// EOD Flatten (15:55 ET)
if i_eodFlatten and not na(time(timeframe.period, "1555-1600:23456", "America/New_York"))
    strategy.close_all("EOD Flatten")

// Visual Annotations for active brackets
plot(strategy.position_size != 0 ? activeSL : na, "Active Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeTP1 : na, "Target 1 (Queen)", color=color.green, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeTP2 : na, "Target 2 (Runner)", color=color.teal, style=plot.style_linebr, linewidth=2)