// IB Sweep Fade Strategy — FVG Displacement Edition
// Matches Python benchmark_range_regime_fvg.py and NT8 IBFadeBot (Enhanced)
//
// Edge: 87% WR, PF 9.4, $60K net over 5 years (2021-2026) on ES/NQ
//
// Logic:
//   1. Build 60-min Initial Balance (09:30-10:30 ET)
//   2. Filter: IB range < 0.40 × ATR(10) — compressed = mean-reverting regime
//   3. Scan 5m bars during Midday/PM (11:30-16:00) for:
//      a. Sweep of IB High/Low (wick beyond boundary)
//      b. Close back inside IB on the sweep bar
//      c. 5m FVG displacement (b0.low - b2.high >= min_fvg for shorts)
//   4. Entry: FVG edge (limit), Stop: 2 ticks beyond sweep wick
//   5. TP1: IB midpoint (50% scale, move stop to BE)
//   6. TP2: Opposite IB boundary (50% runner)
//
// Diagnostic CSV: use the table output to compare signals with Python/NT8

//@version=6
strategy("IB Sweep Fade — FVG Displacement",
  shorttitle="IB_Sweep_Fade",
  overlay=true,
  pyramiding=2,
  default_qty_type=strategy.fixed,
  default_qty_value=2,
  initial_capital=50000,
  currency=currency.USD,
  commission_type=strategy.commission.cash_per_contract,
  commission_value=1.20,
  max_boxes_count=500,
  max_lines_count=500,
  max_labels_count=500,
  max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════
// PARAMETERS
// ═══════════════════════════════════════════════════════════════════

g1 = "IB Settings"
ibStart    = input.session("0930-1030", "Initial Balance Window", group=g1)
ibEndMin   = input.int(30, "IB Duration (minutes)", minval=5, maxval=120, group=g1)

g2 = "Sweep Fade Filters"
minFvgSz   = input.float(0.75, "Min FVG Size (pts)", step=0.25, group=g2, tooltip="Minimum 3-bar FVG gap. ES=0.75, NQ=3.5, YM=5.0")
ibCompRatio = input.float(0.40, "IB Compression Max ATR Ratio", step=0.05, group=g2, tooltip="Only trade when IB range < this × ATR. 0.40 = mean-reverting regime.")
stopTicks  = input.int(2, "Stop Ticks Beyond Wick", minval=1, maxval=10, group=g2)
maxRiskAtr = input.float(0.30, "Max Risk ATR Fraction", step=0.05, group=g2, tooltip="Skip if risk > this × ATR")

g3 = "Session Window"
middayStart = input.session("1130-1600", "Trading Session (Midday+PM)", group=g3)
flattenTime = input.session("1555-1600", "EOD Flatten Window", group=g3)

g4 = "Position Management"
useTwoLeg  = input.bool(true, "2-Leg Scaling (50% TP1 + 50% TP2)", group=g4)
tp1Frac    = input.float(0.50, "TP1 Fraction of IB Range", step=0.05, group=g4, tooltip="0.50 = IB midpoint")

g5 = "ATR Settings"
atrPeriod  = input.int(10, "ATR Period (daily)", minval=1, maxval=50, group=g5)

g6 = "Diagnostics"
showDiag   = input.bool(true, "Show Diagnostic Table", group=g6)
showBoxes  = input.bool(true, "Draw IB + Sweep + FVG Boxes", group=g6)

// ═══════════════════════════════════════════════════════════════════
// TIME HELPERS
// ═══════════════════════════════════════════════════════════════════

// Convert exchange time to ET (CME futures are CT)
etTime(dt) =>
    // TradingView chart timezone is set by the user — assume ET for futures charts
    dt

inIBWindow = time(timeframe.period, ibStart, "America/New_York")
inTradeSession = time(timeframe.period, middayStart, "America/New_York")
inFlatten = time(timeframe.period, flattenTime, "America/New_York")

// ═══════════════════════════════════════════════════════════════════
// DAILY ATR (from daily bars)
// ═══════════════════════════════════════════════════════════════════

dailyHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
dailyLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
dailyClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)

dailyTR = math.max(dailyHigh - dailyLow, math.max(math.abs(dailyHigh - dailyClose), math.abs(dailyLow - dailyClose)))
dailyATR = ta.sma(dailyTR, atrPeriod)

// ═══════════════════════════════════════════════════════════════════
// INITIAL BALANCE (09:30-10:30 ET)
// ═══════════════════════════════════════════════════════════════════

var float ibHigh = na
var float ibLow = na
var float ibMid = na
var float ibRange = na
var bool ibComplete = false
var int ibCompleteBar = na
var float ibOpen = na

// Reset IB at start of each new day
isNewDay = ta.change(time("D", "America/New_York")) != 0
if isNewDay
    ibHigh := na
    ibLow := na
    ibMid := na
    ibRange := na
    ibComplete := false
    ibCompleteBar := na
    ibOpen := na

// Build IB during 09:30-10:30
if not na(inIBWindow) and not ibComplete and inIBWindow != 0
    if na(ibHigh)
        ibHigh := high
        ibLow := low
        ibOpen := open
    else
        ibHigh := math.max(ibHigh, high)
        ibLow := math.min(ibLow, low)

// Finalize IB at 10:30
ibEndTime = timestamp("America/New_York", year, month, dayofmonth, 9, 30 + ibEndMin)
if not ibComplete and time >= ibEndTime and not na(ibHigh)
    ibComplete := true
    ibCompleteBar := bar_index
    ibRange := ibHigh - ibLow
    ibMid := (ibHigh + ibLow) / 2.0

// ═══════════════════════════════════════════════════════════════════
// 5-MINUTE FVG DETECTION (built from chart timeframe)
// Requires chart to be set to 1-minute timeframe for accurate 5m reconstruction.
// If chart is 5-minute, FVG detection works directly.
// ═══════════════════════════════════════════════════════════════════

// 3-bar FVG pattern (works on any timeframe, but designed for 5m)
// b0 = bar[i-2], b1 = bar[i-1], b2 = bar[i]
bullFvg = low > high[2]           // bullish: gap between b0.high and b2.low
bearFvg = high < low[2]           // bearish: gap between b0.low and b2.high

// FVG size
bullFvgSize = low - high[2]
bearFvgSize = low[2] - high

// ═══════════════════════════════════════════════════════════════════
// SWEEP + FVG SIGNAL DETECTION
// ═══════════════════════════════════════════════════════════════════

// Sweep conditions (on the current 5m bar = b2)
sweptHigh = (high[1] > ibHigh or high > ibHigh)     // b1 or b2 swept IB high
sweptLow  = (low[1] < ibLow or low < ibLow)          // b1 or b2 swept IB low

// Close back inside + directional candle
closedInsideHigh = close < ibHigh and close < open   // bearish close back below IB high
closedInsideLow  = close > ibLow and close > open     // bullish close back above IB low

// FVG displacement
bearFvgValid = (low[2] - high) >= minFvgSz           // b0.low - b2.high >= min
bullFvgValid = (low - high[2]) >= minFvgSz           // b2.low - b0.high >= min

// IB compression filter
ibCompressed = ibComplete and not na(ibRange) and not na(dailyATR) and ibRange < ibCompRatio * dailyATR

// Active session
inSession = not na(inTradeSession)

// Combined signals
shortSignal = ibComplete and ibCompressed and inSession and sweptHigh and closedInsideHigh and bearFvgValid
longSignal  = ibComplete and ibCompressed and inSession and sweptLow and closedInsideLow and bullFvgValid

// Stop and targets
sweepExtremeShort = math.max(high[1], high)
sweepExtremeLong  = math.min(low[1], low)

shortEntry = high                    // FVG edge (b2 high)
shortStop  = sweepExtremeShort + stopTicks * syminfo.mintick
shortTP1   = ibMid
shortTP2   = ibLow

longEntry  = low                     // FVG edge (b2 low)
longStop   = sweepExtremeLong - stopTicks * syminfo.mintick
longTP1    = ibMid
longTP2    = ibHigh

// Risk validation
shortRisk = shortStop - shortEntry
longRisk  = longEntry - longStop

shortValid = shortRisk > 0 and shortRisk < maxRiskAtr * dailyATR and shortTP1 < shortEntry
longValid  = longRisk > 0 and longRisk < maxRiskAtr * dailyATR and longTP1 > longEntry

// ═══════════════════════════════════════════════════════════════════
// EXECUTION
// ═══════════════════════════════════════════════════════════════════

// EOD Flatten
if not na(inFlatten) and inFlatten != 0 and strategy.position_size != 0
    strategy.close_all("EOD Flatten")

// One entry per direction per day
var bool longTakenToday = false
var bool shortTakenToday = false
if isNewDay
    longTakenToday := false
    shortTakenToday := false

// Short entry (sweep IB high + bearish FVG)
if shortSignal and shortValid and not shortTakenToday and strategy.position_size == 0
    if useTwoLeg
        qtyPerLeg = strategy.default_qty_type == strategy.fixed ? 1 : math.max(1, int(strategy.default_qty_value / 2))
        strategy.entry("ShortLeg1", strategy.short, qty=qtyPerLeg, limit=shortEntry)
        strategy.entry("ShortLeg2", strategy.short, qty=qtyPerLeg, limit=shortEntry)
        strategy.exit("ExitShort1", "ShortLeg1", limit=shortTP1, stop=shortStop)
        strategy.exit("ExitShort2", "ShortLeg2", limit=shortTP2, stop=shortStop)
    else
        strategy.entry("Short", strategy.short, limit=shortEntry)
        strategy.exit("ExitShort", "Short", limit=shortTP2, stop=shortStop)
    shortTakenToday := true

// Long entry (sweep IB low + bullish FVG)
if longSignal and longValid and not longTakenToday and strategy.position_size == 0
    if useTwoLeg
        qtyPerLeg = strategy.default_qty_type == strategy.fixed ? 1 : math.max(1, int(strategy.default_qty_value / 2))
        strategy.entry("LongLeg1", strategy.long, qty=qtyPerLeg, limit=longEntry)
        strategy.entry("LongLeg2", strategy.long, qty=qtyPerLeg, limit=longEntry)
        strategy.exit("ExitLong1", "LongLeg1", limit=longTP1, stop=longStop)
        strategy.exit("ExitLong2", "LongLeg2", limit=longTP2, stop=longStop)
    else
        strategy.entry("Long", strategy.long, limit=longEntry)
        strategy.exit("ExitLong", "Long", limit=longTP2, stop=longStop)
    longTakenToday := true

// Move Leg 2 stop to breakeven when Leg 1 fills (TP1 hit)
// Detect: position size decreased from 2 legs to 1
var float entryPriceTracker = na
if strategy.position_size != 0 and na(entryPriceTracker)
    entryPriceTracker := strategy.position_avg_price

if strategy.position_size != 0 and not na(entryPriceTracker)
    // If one leg closed (position halved), move the other to BE
    if useTwoLeg and math.abs(strategy.position_size) <= 1 and strategy.position_size != 0
        if strategy.position_size > 0
            strategy.exit("ExitLong2_BE", "LongLeg2", stop=entryPriceTracker)
        else
            strategy.exit("ExitShort2_BE", "ShortLeg2", stop=entryPriceTracker)

if strategy.position_size == 0
    entryPriceTracker := na

// ═══════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════

color ibColor = color.new(#2962FF, 70)
color ibBorderColor = #2962FF
color sweepColor = color.new(#FF5252, 60)
color fvgColor = color.new(#00BCD4, 70)

// Draw IB box
if showBoxes and ibComplete and bar_index == ibCompleteBar
    box.new(ibCompleteBar, ibHigh, bar_index + 100, ibLow, border_color=ibBorderColor, bgcolor=ibColor, text="IB", text_size=size.tiny)
    line.new(ibCompleteBar, ibMid, bar_index + 100, ibMid, color=color.gray, style=line.style_dotted)

// Draw sweep + FVG on signal bars
if showBoxes
    if shortSignal and shortValid
        box.new(bar_index - 2, high[2], bar_index + 50, high, border_color=sweepColor, bgcolor=fvgColor, text="SWEEP+FVG SHORT", text_size=size.tiny)
        label.new(bar_index, high, "S", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
    if longSignal and longValid
        box.new(bar_index - 2, low, bar_index + 50, low[2], border_color=sweepColor, bgcolor=fvgColor, text="SWEEP+FVG LONG", text_size=size.tiny)
        label.new(bar_index, low, "L", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
// DIAGNOSTIC TABLE (for parity comparison with Python/NT8)
// ═══════════════════════════════════════════════════════════════════

if showDiag and barstate.islast
    var table diagTable = table.new(position.top_right, 4, 12, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)

    table.cell(diagTable, 0, 0, "IB Sweep Fade", text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(diagTable, 0, 1, "Time", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 1, str.tostring(time, "HH:mm"), text_color=color.white, text_size=size.tiny)
    table.cell(diagTable, 0, 2, "IB High", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 2, str.tostring(ibHigh, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(diagTable, 0, 3, "IB Low", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 3, str.tostring(ibLow, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(diagTable, 0, 4, "IB Range", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 4, str.tostring(ibRange, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(diagTable, 0, 5, "Daily ATR", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 5, str.tostring(dailyATR, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(diagTable, 0, 6, "IB Compressed", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 6, ibCompressed ? "YES" : "NO", text_color=ibCompressed ? color.green : color.red, text_size=size.tiny)
    table.cell(diagTable, 0, 7, "In Session", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 7, inSession ? "YES" : "NO", text_color=inSession ? color.green : color.red, text_size=size.tiny)
    table.cell(diagTable, 0, 8, "Bear FVG Size", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 8, str.tostring(bearFvgSize, "#.##"), text_color=bearFvgSize >= minFvgSz ? color.green : color.red, text_size=size.tiny)
    table.cell(diagTable, 0, 9, "Bull FVG Size", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 9, str.tostring(bullFvgSize, "#.##"), text_color=bullFvgSize >= minFvgSz ? color.green : color.red, text_size=size.tiny)
    table.cell(diagTable, 0, 10, "Position", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 10, str.tostring(strategy.position_size), text_color=color.white, text_size=size.tiny)
    table.cell(diagTable, 0, 11, "Net Profit", text_color=color.gray, text_size=size.tiny)
    table.cell(diagTable, 1, 11, "$" + str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════

alertcondition(shortSignal and shortValid, title="IB Sweep Fade SHORT", message="IB Sweep Fade SHORT: swept IB high + bearish FVG. Entry={{ticker}} @ {{close}}")
alertcondition(longSignal and longValid, title="IB Sweep Fade LONG", message="IB Sweep Fade LONG: swept IB low + bullish FVG. Entry={{ticker}} @ {{close}}")