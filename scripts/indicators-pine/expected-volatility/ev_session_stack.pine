// = die%, back%. Sentinel -1 renders as dash. Gates: LDN zones draw only
// where the session verdict is CAL (same rule as its ladder).
var array<float> ldnExt  = array.from(0.118, 0.243, 0.384, 0.159, 0.308, 0.530, 0.108, 0.241, 0.377, 0.161, 0.327, 0.572, 0.117, 0.224, 0.386, 0.167, 0.335, 0.662, 0.120, 0.222, 0.523, 0.191, 0.378, 0.701, 0.132, 0.231, 0.413, 0.166, 0.299, 0.519, 0.125, 0.249, 0.390, 0.143, 0.303, 0.602, 0.096, 0.222, 0.535, 0.142, 0.315, 0.585, 0.126, 0.242, 0.574, 0.165, 0.404, 0.597, 0.123, 0.249, 0.391, 0.164, 0.323, 0.623, 0.113, 0.230, 0.402, 0.152, 0.299, 0.596, 0.121, 0.231, 0.503, 0.157, 0.370, 0.672, 0.118, 0.246, 0.542, 0.178, 0.394, 0.770, 0.168, 0.348, 0.634, 0.170, 0.350, 0.612, 0.179, 0.350, 0.715, 0.173, 0.365, 0.621, 0.172, 0.395, 0.728, 0.200, 0.413, 0.764, 0.183, 0.482, 0.765, 0.190, 0.395, 0.924, 0.200, 0.384, 0.619, 0.186, 0.366, 0.606, 0.186, 0.346, 0.582, 0.190, 0.366, 0.634, 0.184, 0.355, 0.527, 0.196, 0.361, 0.719, 0.166, 0.334, 0.513, 0.160, 0.396, 0.651)
var array<float> ldnRate = array.from(28.6, 26.4, 28.6, 35.4, 40.1, 20.7, 40.1, 28.8, 33.1, 18.1, 33.1, 20.3, 49.4, 14.6, 49.4, 18.0, 28.5, 25.5, 28.5, 35.4, 39.8, 18.1, 39.8, 26.9, 33.1, 15.4, 33.1, 19.2, 49.4, 16.1, 49.4, 19.5, 28.4, 27.4, 28.4, 31.8, 40.2, 22.9, 40.2, 23.4, 32.8, 17.2, 32.8, 21.1, 50.0, 16.3, 50.0, 14.0, 28.4, 28.4, 28.4, 30.4, 40.2, 23.4, 40.2, 22.4, 32.8, 18.0, 32.8, 17.2, 50.0, 19.8, 50.0, 14.0, 28.4, 25.1, 28.4, 31.1, 39.7, 16.4, 39.7, 21.0, 33.3, 8.5, 33.3, 14.7, 50.0, 7.0, 50.0, 11.6)
var array<float> asiExt  = array.from(0.095, 0.185, 0.329, 0.117, 0.218, 0.376, 0.087, 0.184, 0.345, 0.098, 0.214, 0.379, 0.085, 0.197, 0.371, 0.103, 0.229, 0.355, 0.091, 0.229, 0.397, 0.108, 0.242, 0.463, 0.106, 0.218, 0.373, 0.125, 0.250, 0.394, 0.106, 0.211, 0.365, 0.126, 0.239, 0.398, 0.106, 0.229, 0.393, 0.118, 0.221, 0.406, 0.094, 0.216, 0.439, 0.118, 0.239, 0.481, 0.082, 0.163, 0.305, 0.103, 0.206, 0.354, 0.086, 0.179, 0.372, 0.092, 0.193, 0.347, 0.078, 0.190, 0.356, 0.109, 0.220, 0.447, 0.095, 0.263, 0.372, 0.111, 0.226, 0.522, 0.088, 0.203, 0.318, 0.099, 0.224, 0.415, 0.094, 0.205, 0.322, 0.102, 0.229, 0.387, 0.110, 0.196, 0.416, 0.130, 0.288, 0.420, 0.116, 0.197, 0.453, 0.148, 0.236, 0.513, 0.157, 0.321, 0.623, 0.151, 0.328, 0.632, 0.150, 0.351, 0.646, 0.156, 0.354, 0.635, 0.167, 0.385, 0.691, 0.195, 0.414, 0.668, 0.210, 0.435, 0.659, 0.203, 0.423, 0.647)
var array<float> asiRate = array.from(28.6, 25.7, 28.6, 31.8, 40.1, 16.7, 40.1, 21.6, 33.1, 9.8, 33.1, 12.0, 49.4, 10.1, 49.4, 10.1, 28.5, 21.9, 28.5, 32.8, 39.8, 15.7, 39.8, 22.7, 33.1, 11.5, 33.1, 15.4, 49.4, 9.2, 49.4, 14.9, 28.4, 31.1, 28.4, 35.4, 40.2, 24.8, 40.2, 23.8, 32.8, 18.8, 32.8, 19.5, 50.0, 12.8, 50.0, 12.8, 28.4, 28.1, 28.4, 34.4, 40.2, 22.4, 40.2, 23.4, 32.8, 12.5, 32.8, 14.8, 50.0, 12.8, 50.0, 15.1, 28.4, 24.8, 28.4, 32.4, 39.7, 19.2, 39.7, 26.6, 33.3, 14.0, 33.3, 20.2, 50.0, 14.0, 50.0, 20.9)
// zones §5.5 TRAIN fold n>=30: 8 rows/symbol (35..10, 5% excluded)
// die@zone undefined there. revExt [slot*24 + row*3 + k];
// revRate [slot*16 + row*2 + k] = die%, back%.
var array<float> revExt  = array.from(0.199, 0.404, 0.593, 0.299, 0.577, 0.904, 0.208, 0.398, 0.660, 0.282, 0.526, 0.870, 0.195, 0.319, 0.668, 0.273, 0.550, 0.892, 0.171, 0.401, 0.634, 0.239, 0.477, 0.862, 0.234, 0.418, 0.708, 0.291, 0.625, 0.941, 0.212, 0.390, 0.615, 0.261, 0.568, 0.955, 0.183, 0.366, 0.624, 0.295, 0.534, 0.980, 0.192, 0.358, 0.637, 0.229, 0.540, 0.943, 0.256, 0.449, 0.765, 0.275, 0.548, 0.922, 0.225, 0.396, 0.708, 0.300, 0.576, 0.907, 0.202, 0.413, 0.660, 0.300, 0.574, 0.848, 0.193, 0.434, 0.731, 0.291, 0.540, 0.996, 0.262, 0.478, 0.745, 0.292, 0.526, 0.861, 0.232, 0.453, 0.804, 0.278, 0.489, 0.783, 0.205, 0.415, 0.802, 0.231, 0.436, 0.787, 0.238, 0.507, 0.883, 0.210, 0.451, 0.760, 0.214, 0.422, 0.648, 0.207, 0.445, 0.633, 0.204, 0.388, 0.620, 0.215, 0.414, 0.700, 0.187, 0.361, 0.640, 0.216, 0.369, 0.782, 0.198, 0.353, 0.696, 0.175, 0.416, 0.816)
var array<float> revRate = array.from(29.0, 19.5, 28.6, 25.7, 39.5, 11.5, 40.1, 14.4, 32.6, 5.3, 33.1, 6.0, 49.4, 4.5, 49.4, 1.1, 28.5, 19.8, 28.6, 21.3, 39.4, 11.7, 39.5, 12.1, 33.3, 7.0, 33.1, 4.6, 48.8, 4.7, 49.4, 3.5, 28.7, 18.9, 28.9, 28.2, 38.9, 11.4, 39.6, 17.9, 33.3, 7.8, 33.6, 8.6, 50.0, 2.3, 49.4, 4.7, 28.3, 24.9, 28.4, 17.1, 39.4, 15.5, 39.7, 9.8, 33.3, 9.3, 33.3, 1.6, 50.0, 7.0, 50.0, 2.3, 28.7, 22.7, 28.8, 26.1, 39.7, 14.0, 39.4, 14.1, 33.3, 9.3, 33.3, 7.0, 50.0, 7.0, 50.0, 3.5)
// per-slot vol index (auto-selected by chart symbol) + session verdicts
var array<string> VOLS    = array.from("CBOE:VIX", "CBOE:VXN", "CBOE:VXD", "CBOE:RVX", "CBOE:GVZ")
var array<string> LDNVERD = array.from("CAL", "CAL", "REFIT", "REFIT", "REFIT")
var array<string> ASIVERD = array.from("NOMINAL", "NOMINAL", "NOMINAL", "NOMINAL", "NOMINAL")

// ── symbol slot resolution ─────────────────────────────────────────
// Matches big futures, micros, CME codes, cash indexes and unlevered
// ETFs to their family slot (MES->ES, SPY/QQQ/DIA/IWM->index slots,
// XAU/GLD->GC). Leveraged ETFs are deliberately unsupported: a 3x
// daily-reset product changes the EV structure, and the family
// probabilities would be wrong on it. slotSafe keeps every array.get
// in bounds even on an unmatched symbol.
f_slot() =>
    string t = syminfo.ticker
    int s = -1
    if str.startswith(t, "ES") or str.startswith(t, "MES") or str.startswith(t, "SPX") or str.startswith(t, "SPY") or str.startswith(t, "XSP") or str.startswith(t, "VOO")
        s := 0
    else if str.startswith(t, "NQ") or str.startswith(t, "MNQ") or str.startswith(t, "NDX") or str.startswith(t, "QQQ")
        s := 1
    else if str.startswith(t, "YM") or str.startswith(t, "MYM") or str.startswith(t, "DJI") or str.startswith(t, "DIA") or str.startswith(t, "DJ")
        s := 2
    else if str.startswith(t, "RTY") or str.startswith(t, "RUT") or str.startswith(t, "M2K") or str.startswith(t, "IWM")
        s := 3
    else if str.startswith(t, "GC") or str.startswith(t, "MGC") or str.startswith(t, "XAU") or str.startswith(t, "GLD")
        s := 4
    s

int slot = f_slot()
bool supported = slot >= 0
int slotSafe = math.max(slot, 0)
string volSym = array.get(VOLS, slotSafe)
string ldnVerd = array.get(LDNVERD, slotSafe)
string asiVerd = array.get(ASIVERD, slotSafe)
bool ldnOn = showLondon and supported and ldnVerd == "CAL"
bool asiOn = showAsia and supported

// ── helpers ─────────────────────────────────────────────────────────
NY_TZ = "America/New_York"
// median first-touch minute from the 09:30 open -> ET wall clock.
// m is INT (arrMed is array<int>): keeps timestamp()+m*60000 a series
// int — str.format_time requires int (CE10123 otherwise).
f_med2clock(int m) =>
    m < 0 ? "—" : str.format_time(timestamp(NY_TZ, year(time, NY_TZ), month(time, NY_TZ), dayofmonth(time, NY_TZ), 9, 30) + m * 60000, "HH:mm", NY_TZ)

// session-local clock: LONDON anchored 03:00, ASIA anchored 18:00
f_med2clockS(string kind, int m) =>
    int hh = kind == "LONDON" ? 3 : 18
    m < 0 ? "—" : str.format_time(timestamp(NY_TZ, year(time, NY_TZ), month(time, NY_TZ), dayofmonth(time, NY_TZ), hh, 0) + m * 60000, "HH:mm", NY_TZ)

f_pos(s) =>
    s == "Top Left" ? position.top_left : s == "Bottom Right" ? position.bottom_right : s == "Bottom Left" ? position.bottom_left : position.top_right

f_tsz(s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

f_clearLn(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
    array.clear(arr)

f_clearLb(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
    array.clear(arr)

f_clearBx(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box.delete(array.get(arr, i))
    array.clear(arr)

// label text: P(touch) · median arrival · cum (clock anchored per session)
// NOTE: composed from locals — expression continuations at 4-space indent
// parse as new statements in Pine v6 (server CE: 'Syntax error at input').
f_rungLbl(float p, int med, float cum15) =>
    string sP = str.tostring(p * 100, "#") + "%"
    string sM = med >= 0 ? " · med " + f_med2clock(med) : ""
    string sC = cum15 >= 0 ? " · " + str.tostring(cum15, "#.#") + "%" : ""
    sP + sM + sC

// session-anchored variant: anchorHH 3 (London), 18 (Asia)
f_rungLblT(float p, int med, float cum15, int anchorHH) =>
    string sP = str.tostring(p * 100, "#") + "%"
    string medTxt = str.format_time(timestamp(NY_TZ, year(time, NY_TZ), month(time, NY_TZ), dayofmonth(time, NY_TZ), anchorHH, 0) + med * 60000, "HH:mm", NY_TZ)
    string sM = med >= 0 ? " · med " + medTxt : ""
    string sC = cum15 >= 0 ? " · " + str.tostring(cum15, "#.#") + "%" : ""
    sP + sM + sC

// ── state ───────────────────────────────────────────────────────────
var array<line>  lnRTH  = array.new<line>()
var array<label> lbRTH  = array.new<label>()
var array<box>   zbxRTH = array.new<box>()
var array<label> zlbRTH = array.new<label>()
var array<line>  lnLDN  = array.new<line>()
var array<label> lbLDN  = array.new<label>()
var array<box>   zbxLDN = array.new<box>()
var array<label> zlbLDN = array.new<label>()
var array<line>  lnASA  = array.new<line>()
var array<label> lbASA  = array.new<label>()
var array<box>   zbxASA = array.new<box>()
var array<label> zlbASA = array.new<label>()
var float rthOpen = na
var float ldnOpen = na
var float asiOpen = na
var float rthEV   = na
var float ldnEV   = na
var float asiEV   = na

// ── runtime reads ───────────────────────────────────────────────────
vixPrev = request.security(volSym, "1D", close[1], lookahead = barmerge.lookahead_off)
int nyHour = hour(time, NY_TZ)
int nyMin  = minute(time, NY_TZ)
int nyDow  = dayofweek(time, NY_TZ)
bool inRTH    = (nyHour == 9 and nyMin >= 30) or (nyHour >= 10 and nyHour < 16)
bool inLondon = nyHour >= 3 and nyHour < 9
bool inAsia   = nyHour >= 18 or nyHour < 3
bool rthStart = inRTH and not inRTH[1]
bool ldnStart = inLondon and not inLondon[1]
bool asiStart = inAsia and not inAsia[1]

// tEnd for the NY session (today 16:00 ET)
f_tEndRTH() => timestamp(NY_TZ, year(time, NY_TZ), month(time, NY_TZ), dayofmonth(time, NY_TZ), 16, 0)

// ── drawing primitives ──────────────────────────────────────────────
// one rung: line + probability label; returns the level
f_rung(S, EV, c, pTxt, side, col, sty, wid, tEnd) =>
    float lvl = side == "up" ? S + EV * c : S - EV * c
    array.push(lnRTH, line.new(time, lvl, tEnd, lvl, xloc = xloc.bar_time, color = col, style = sty, width = wid))
    array.push(lbRTH, label.new(tEnd, lvl, pTxt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = col, size = size.tiny))
    lvl

// the session anchor: THE reference every rung of that session is
// measured from. Solid bright line, session-colored, price in label.
f_anchor(pArr, pLbl, S, col, tEnd, tag) =>
    array.push(pArr, line.new(time, S, tEnd, S, xloc = xloc.bar_time, color = col, style = line.style_solid, width = 3))
    array.push(pLbl, label.new(tEnd, S, tag + " OPEN " + str.tostring(S, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(col, 25), textcolor = color.white, size = size.tiny))

// extension zones behind a rung (TYPICAL/DEEP/STRETCH), one side.
// Zone boxes go to the caller's array so every session shares this.
f_zone(bxArr, lbArr, S, EV, c, e50, e75, e90, isUp, tEnd) =>
    float sgn  = isUp ? 1.0 : -1.0
    float base = S + sgn * EV * c
    float z1 = base + sgn * EV * e50
    float z2 = base + sgn * EV * e75
    float z3 = base + sgn * EV * e90
    array.push(bxArr, box.new(time, math.max(base, z1), tEnd, math.min(base, z1), xloc = xloc.bar_time, bgcolor = color.new(#9e9e9e, 78), border_color = color.new(#9e9e9e, 45)))
    array.push(bxArr, box.new(time, math.max(z1, z2), tEnd, math.min(z1, z2), xloc = xloc.bar_time, bgcolor = color.new(#2196f3, 78), border_color = color.new(#2196f3, 45)))
    array.push(bxArr, box.new(time, math.max(z2, z3), tEnd, math.min(z2, z3), xloc = xloc.bar_time, bgcolor = color.new(#ff9800, 78), border_color = color.new(#ff9800, 45)))
    if zoneLbls
        array.push(lbArr, label.new(tEnd, (base + z1) / 2, "TYPICAL", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = #9e9e9e, size = size.tiny))
        array.push(lbArr, label.new(tEnd, (z1 + z2) / 2, "DEEP",     xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = #2196f3, size = size.tiny))
        array.push(lbArr, label.new(tEnd, (z2 + z3) / 2, "STRETCH",  xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = #ff9800, size = size.tiny))

// ── NY (RTH) session build ──────────────────────────────────────────
if rthStart and showRTH and supported
    f_clearLn(lnRTH)
    f_clearLb(lbRTH)
    f_clearBx(zbxRTH)
    f_clearLb(zlbRTH)
    rthOpen := open
    rthEV   := open * vixPrev / math.sqrt(252) / 100.0
    if not na(rthEV) and rthEV > 0
        int tEnd = f_tEndRTH()
        int dIdx = nyDow == dayofweek.monday ? 0 : nyDow == dayofweek.tuesday ? 1 : nyDow == dayofweek.wednesday ? 2 : nyDow == dayofweek.thursday ? 3 : 4
        int base8 = slot * 8
        int base5 = slot * 5
        int aBase = slot * 16
        int cBase = slot * 80
        int eBase = slot * 24
        float wU = dowAdjust ? array.get(wUpDOW, base5 + dIdx) : 1.0
        float wD = dowAdjust ? array.get(wDnDOW, base5 + dIdx) : 1.0
        // zones behind the 35% rung: zone rows 0 (up) and 1 (dn)
        if showZones and showWork
            float c35u = array.get(cUpRTH, base8 + 3) * wU
            float c35d = array.get(cDnRTH, base8 + 3) * wD
            f_zone(zbxRTH, zlbRTH, rthOpen, rthEV, c35u, array.get(revExt, eBase + 0), array.get(revExt, eBase + 1), array.get(revExt, eBase + 2), true, tEnd)
            f_zone(zbxRTH, zlbRTH, rthOpen, rthEV, c35d, array.get(revExt, eBase + 3), array.get(revExt, eBase + 4), array.get(revExt, eBase + 5), false, tEnd)
        // rungs — EVERY rung now has an arrival row (16 rows = 8 rungs x 2),
        // so all labels carry median arrival + by-15:00 cumulative
        for j = 0 to 7
            bool inner = j <= 2
            bool work = j == 3 or j == 4
            bool tail = j >= 5
            bool want = (inner and showInner) or (work and showWork) or (tail and showTails)
            if want
                float p = array.get(PROBS, j)
                float cu = array.get(cUpRTH, base8 + j) * wU
                float cd_ = array.get(cDnRTH, base8 + j) * wD
                int aRow = j * 2
                int medU = array.get(arrMed, aBase + aRow)
                int medD = array.get(arrMed, aBase + aRow + 1)
                float cumU = array.get(arrCum, cBase + aRow * 5 + 4)
                float cumD = array.get(arrCum, cBase + (aRow + 1) * 5 + 4)
                color colU = inner ? #1b7f4b : work ? #0d5c33 : color.new(#0d5c33, 25)
                color colD = inner ? #b3341f : work ? #8f1f14 : color.new(#8f1f14, 25)
                int wid = work ? 2 : 1
                string sty = inner or tail ? line.style_dotted : line.style_solid
                f_rung(rthOpen, rthEV, cu, f_rungLbl(p, medU, cumU), "up", colU, sty, wid, tEnd)
                f_rung(rthOpen, rthEV, cd_, f_rungLbl(p, medD, cumD), "dn", colD, sty, wid, tEnd)
        // the anchor: where the whole ladder is measured from
        f_anchor(lnRTH, lbRTH, rthOpen, #1565c0, tEnd, "RTH 09:30")
        // the session frame: shade between the 80% rungs (up vs dn) —
        // the band ~80% of days live inside. This is the 'typical day'
        // zone a trader reads first; extension zones (35%+) are the tail.
        if showZones
            float p80u = array.get(cUpRTH, base8) * wU
            float p80d = array.get(cDnRTH, base8) * wD
            float frU = rthOpen + rthEV * p80u
            float frD = rthOpen - rthEV * p80d
            array.push(zbxRTH, box.new(time, frU, tEnd, frD, xloc = xloc.bar_time, bgcolor = color.new(#1565c0, 92), border_color = color.new(#1565c0, 30)))

// ── London / Asia anchors ───────────────────────────────────────────
if ldnStart
    f_clearLn(lnLDN)
    f_clearLb(lbLDN)
    f_clearBx(zbxLDN)
    f_clearLb(zlbLDN)
    ldnOpen := open
    ldnEV   := open * vixPrev / math.sqrt(252) / 100.0
if asiStart
    f_clearLn(lnASA)
    f_clearLb(lbASA)
    f_clearBx(zbxASA)
    f_clearLb(zlbASA)
    asiOpen := open
    asiEV   := open * vixPrev / math.sqrt(252) / 100.0

// draw London FULL ladder — only where CALIBRATED, with per-session timing
if ldnOn and ldnStart and not na(ldnEV) and ldnEV > 0
    int tEndL = timestamp(NY_TZ, year(time, NY_TZ), month(time, NY_TZ), dayofmonth(time, NY_TZ), 9, 30)
    int aBaseL = slot * 16
    int cBaseL = slot * 80
    int eBaseL = slot * 24
    f_anchor(lnLDN, lbLDN, ldnOpen, #5d8aa8, tEndL, "LDN 03:00")
    if showZones
        float p80uL = array.get(cUpLDN, slot * 8)
        float p80dL = array.get(cDnLDN, slot * 8)
        array.push(zbxLDN, box.new(time, ldnOpen + ldnEV * p80uL, tEndL, ldnOpen - ldnEV * p80dL, xloc = xloc.bar_time, bgcolor = color.new(#5d8aa8, 92), border_color = color.new(#5d8aa8, 30)))
    // extension zones behind the 35% rung (rows 0 up / 1 dn)
    if showZones and showWork
        float c35uL = array.get(cUpLDN, slot * 8 + 3)
        float c35dL = array.get(cDnLDN, slot * 8 + 3)
        f_zone(zbxLDN, zlbLDN, ldnOpen, ldnEV, c35uL, array.get(ldnExt, eBaseL + 0), array.get(ldnExt, eBaseL + 1), array.get(ldnExt, eBaseL + 2), true, tEndL)
        f_zone(zbxLDN, zlbLDN, ldnOpen, ldnEV, c35dL, array.get(ldnExt, eBaseL + 3), array.get(ldnExt, eBaseL + 4), array.get(ldnExt, eBaseL + 5), false, tEndL)
    for j = 0 to 7
        bool inner = j <= 2
        bool work = j == 3 or j == 4
        bool tail = j >= 5
        bool want = (inner and showInner) or (work and showWork) or (tail and showTails)
        if want
            float p = array.get(PROBS, j)
            int aRowL = j * 2
            int medU_L = array.get(ldnMed, aBaseL + aRowL)
            int medD_L = array.get(ldnMed, aBaseL + aRowL + 1)
            float cumU_L = array.get(ldnCum, cBaseL + aRowL * 5 + 4)
            float cumD_L = array.get(ldnCum, cBaseL + (aRowL + 1) * 5 + 4)
            float lvlU = ldnOpen + ldnEV * array.get(cUpLDN, slot * 8 + j)
            float lvlD = ldnOpen - ldnEV * array.get(cDnLDN, slot * 8 + j)
            color colU = inner ? #2e6da4 : work ? #2e6da4 : color.new(#2e6da4, 20)
            color colD = inner ? #a85643 : work ? #a85643 : color.new(#a85643, 25)
            int widL = work ? 2 : 1
            string styL = inner or tail ? line.style_dotted : line.style_dashed
            array.push(lnLDN, line.new(time, lvlU, tEndL, lvlU, xloc = xloc.bar_time, color = colU, style = styL, width = widL))
            array.push(lbLDN, label.new(tEndL, lvlU, "LDN " + f_rungLblT(p, medU_L, cumU_L, 3), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = colU, size = size.tiny))
            array.push(lnLDN, line.new(time, lvlD, tEndL, lvlD, xloc = xloc.bar_time, color = colD, style = styL, width = widL))
            array.push(lbLDN, label.new(tEndL, lvlD, "LDN " + f_rungLblT(p, medD_L, cumD_L, 3), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = colD, size = size.tiny))

// draw Asia FULL ladder (NOMINAL — indicative), with per-session timing.
// Asia opens 18:00 ET, runs to 03:00 next day; anchor-18:00 + 9h avoids
// a calendar-date+1 that can overflow the month.
if asiOn and asiStart and not na(asiEV) and asiEV > 0
    int tEndA = timestamp(NY_TZ, year(time, NY_TZ), month(time, NY_TZ), dayofmonth(time, NY_TZ), 18, 0) + 9 * 3600000
    int aBaseA = slot * 16
    int cBaseA = slot * 80
    int eBaseA = slot * 24
    f_anchor(lnASA, lbASA, asiOpen, #7c7c1e, tEndA, "ASIA 18:00")
    if showZones
        float p80uA = array.get(cUpASA, slot * 8)
        float p80dA = array.get(cDnASA, slot * 8)
        array.push(zbxASA, box.new(time, asiOpen + asiEV * p80uA, tEndA, asiOpen - asiEV * p80dA, xloc = xloc.bar_time, bgcolor = color.new(#7c7c1e, 92), border_color = color.new(#7c7c1e, 30)))
    // extension zones behind the 35% rung (rows 0 up / 1 dn) — NOMINAL,
    // indicative only, per the Asia verdict
    if showZones and showWork
        float c35uA = array.get(cUpASA, slot * 8 + 3)
        float c35dA = array.get(cDnASA, slot * 8 + 3)
        f_zone(zbxASA, zlbASA, asiOpen, asiEV, c35uA, array.get(asiExt, eBaseA + 0), array.get(asiExt, eBaseA + 1), array.get(asiExt, eBaseA + 2), true, tEndA)
        f_zone(zbxASA, zlbASA, asiOpen, asiEV, c35dA, array.get(asiExt, eBaseA + 3), array.get(asiExt, eBaseA + 4), array.get(asiExt, eBaseA + 5), false, tEndA)
    for j = 0 to 7
        bool inner = j <= 2
        bool work = j == 3 or j == 4
        bool tail = j >= 5
        bool want = (inner and showInner) or (work and showWork) or (tail and showTails)
        if want
            float p = array.get(PROBS, j)
            int aRowA = j * 2
            int medU_A = array.get(asiMed, aBaseA + aRowA)
            int medD_A = array.get(asiMed, aBaseA + aRowA + 1)
            float cumU_A = array.get(asiCum, cBaseA + aRowA * 5 + 4)
            float cumD_A = array.get(asiCum, cBaseA + (aRowA + 1) * 5 + 4)
            color colU = inner ? #8d8a1e : work ? #6e6c14 : color.new(#6e6c1e, 20)
            color colD = inner ? #8d8a1e : work ? #6e6c1e : color.new(#6e6c1e, 20)
            int widA = work ? 2 : 1
            float lvlU = asiOpen + asiEV * array.get(cUpASA, slot * 8 + j)
            float lvlD = asiOpen - asiEV * array.get(cDnASA, slot * 8 + j)
            array.push(lnASA, line.new(time, lvlU, tEndA, lvlU, xloc = xloc.bar_time, color = colU, style = line.style_dotted, width = widA))
            array.push(lbASA, label.new(tEndA, lvlU, "ASIA* " + f_rungLblT(p, medU_A, cumU_A, 18), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = colU, size = size.tiny))
            array.push(lnASA, line.new(time, lvlD, tEndA, lvlD, xloc = xloc.bar_time, color = colD, style = line.style_dotted, width = widA))
            array.push(lbASA, label.new(tEndA, lvlD, "ASIA* " + f_rungLblT(p, medD_A, cumD_A, 18), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = colD, size = size.tiny))

// ── dashboard ────────────────────────────────────────────────────────
var table tbl = na
if showTable and barstate.islast
    if not na(tbl)
        table.delete(tbl)
    // rows: 3 (title+VIX+header) + 16 arrival rows + 2 (verdict+disclaimer)
    tbl := table.new(f_pos(tblPos), 7, 21, bgcolor = color.new(color.black, 30), border_color = color.new(color.gray, 70), frame_color = color.new(color.gray, 50), frame_width = 1)
    if supported
        int row = 0
        table.cell(tbl, 0, row, "EV STACK · " + syminfo.ticker + " · " + str.format_time(time, "EEE HH:mm", NY_TZ), text_color = color.white, text_size = f_tsz(tblSizeIn))
        table.merge_cells(tbl, 0, row, 6, row)
        row += 1
        string evS = na(rthEV) or rthEV <= 0 ? "—" : str.tostring(rthEV, format.mintick)
        table.cell(tbl, 0, row, "VIX " + (na(vixPrev) ? "—" : str.tostring(vixPrev, "#.##")) + " → EV " + evS + " pts" + (dowAdjust ? " · dow-adj" : ""), text_color = color.silver, text_size = f_tsz(tblSizeIn))
        table.merge_cells(tbl, 0, row, 6, row)
        row += 1
        string[] hdr = array.from("rung", "med arr", "by 11", "by 13:30", "by 15", "die@", "back@")
        for c = 0 to 6
            table.cell(tbl, c, row, array.get(hdr, c), text_color = color.gray, text_size = f_tsz(tblSizeIn))
        row += 1
        // arrival rows: 16 per symbol, rung-major (80up,80dn,65up,65dn,...,5dn)
        int aBase = slot * 16
        int cBase = slot * 80
        int rBase = slot * 16
        for ai = 0 to 16 - 1
            int j = ai / 2   // rung index 0..7, up then dn per rung
            string side = ai % 2 == 0 ? "up" : "dn"
            float p = array.get(PROBS, j)
            string medS = f_med2clock(array.get(arrMed, aBase + ai))
            string c11 = str.tostring(array.get(arrCum, cBase + ai * 5 + 1), "#.#") + "%"
            string c1330 = str.tostring(array.get(arrCum, cBase + ai * 5 + 3), "#.#") + "%"
            string c15 = str.tostring(array.get(arrCum, cBase + ai * 5 + 4), "#.#") + "%"
            // die/back: zone rows are priority rungs only (j 3..6); inner
            // (j<3) and the 5% tail (j==7) have no zone row — show dash.
            string dieS = "—"
            string backS = "—"
            if j >= 3 and j < 7
                int rr = (j - 3) * 2 + ai % 2
                float dv = array.get(revRate, rBase + rr * 2)
                float bv = array.get(revRate, rBase + rr * 2 + 1)
                if dv >= 0
                    dieS := str.tostring(dv, "#") + "%"
                if bv >= 0
                    backS := str.tostring(bv, "#") + "%"
            color tc = side == "up" ? #26a69a : #ef5350
            table.cell(tbl, 0, row, str.tostring(p * 100, "#") + "% " + (side == "up" ? "▲" : "▼"), text_color = tc, text_size = f_tsz(tblSizeIn))
            table.cell(tbl, 1, row, medS,  text_color = color.white, text_size = f_tsz(tblSizeIn))
            table.cell(tbl, 2, row, c11,   text_color = color.white, text_size = f_tsz(tblSizeIn))
            table.cell(tbl, 3, row, c1330, text_color = color.white, text_size = f_tsz(tblSizeIn))
            table.cell(tbl, 4, row, c15,   text_color = color.white, text_size = f_tsz(tblSizeIn))
            table.cell(tbl, 5, row, dieS, text_color = color.white, text_size = f_tsz(tblSizeIn))
            table.cell(tbl, 6, row, backS, text_color = color.white, text_size = f_tsz(tblSizeIn))
            row += 1
        table.cell(tbl, 0, row, "NY CAL · LONDON " + ldnVerd + " · ASIA " + asiVerd, text_color = color.silver, text_size = f_tsz(tblSizeIn))
        table.merge_cells(tbl, 0, row, 6, row)
        row += 1
        table.cell(tbl, 0, row, "historical probabilities · not a signal", text_color = color.gray, text_size = f_tsz(tblSizeIn))
        table.merge_cells(tbl, 0, row, 6, row)
    else
        table.cell(tbl, 0, 0, "EV Stack: unsupported symbol (ES/NQ/YM/RTY/GC)", text_color = color.orange, text_size = f_tsz(tblSizeIn))
        table.merge_cells(tbl, 0, 0, 6, 0)
