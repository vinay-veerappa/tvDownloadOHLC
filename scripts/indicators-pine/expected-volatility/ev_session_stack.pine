// ─────────────────────────────────────────────────────────────────────
//  EV Session Stack — probability·distance·time map (GENERATED)
//  ONE indicator, multi-symbol: ES / NQ / YM / RTY / GC.
//  Source of truth: scripts/expected_volatility/ + RESEARCH_REPORT.md
//  DO NOT hand-edit the data blocks — regenerate with gen_pine_multi.py.
//
//  Per-symbol holdout verdicts (rendered in the dashboard footer):
//  ES: London CAL, Asia NOMINAL | NQ: London CAL, Asia NOMINAL | YM: London REFIT, Asia NOMINAL | RTY: London REFIT, Asia NOMINAL | GC: London REFIT, Asia NOMINAL
//  London draws ONLY where CAL (ES/NQ); REFIT sessions stay blank rather
//  than render drifted levels. Historical probabilities — a description
//  of past sessions, NOT a forecast, and NOT an entry signal (§3.1/§3.2).
// ─────────────────────────────────────────────────────────────────────
//@version=6
indicator("EV Session Stack", "EV-Stack", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ── inputs ──────────────────────────────────────────────────────────
grpS = "Sessions"
showRTH    = input.bool(true, "NY (RTH) — CALIBRATED",              group = grpS)
showLondon = input.bool(true, "London 03:00-09:30 (draws only where CAL)", group = grpS)
showAsia   = input.bool(true, "Asia 18:00-03:00 — NOMINAL (indicative)", group = grpS)
grpL = "Rungs"
showInner  = input.bool(true,  "Inner rungs 80/65/50 (session frame)", group = grpL)
showWork   = input.bool(true,  "Work rungs 35/25 (primary)",        group = grpL)
showTails  = input.bool(true,  "Tail rungs 15/10/5 (dotted)",       group = grpL)
dowAdjust  = input.bool(true,  "Weekday width adjustment (§4.9)",   group = grpL)
grpT = "Table"
showTable  = input.bool(true,  "Show dashboard",                     group = grpT)
tblPos     = input.string("Top Right", "Position", options = ["Top Right","Top Left","Bottom Right","Bottom Left"], group = grpT)
tblSizeIn  = input.string("Small", "Size", options = ["Tiny","Small","Normal"], group = grpT)
grpZ = "Zones (behind 35% rung)"
showZones  = input.bool(true, "Extension zones",                     group = grpZ)
zoneLbls   = input.bool(true, "Zone labels",                         group = grpZ)

