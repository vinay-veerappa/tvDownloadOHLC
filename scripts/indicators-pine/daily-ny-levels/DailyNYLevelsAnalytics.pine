// ============================================================================
var array<RSL.RangeSpec> specs = array.new<RSL.RangeSpec>(0)
var array<RSL.RangeState> states = array.new<RSL.RangeState>(0)
var array<STL.ExcursionHistory> histories = array.new<STL.ExcursionHistory>(0)
var array<Core.PineDrawingState> drawings = array.new<Core.PineDrawingState>(0)
var array<int> primary_breakout_sides = array.new_int(0)

f_in_session_pine_robust(string session_str, string tz, int t) =>
    if na(t) or na(session_str)
        false
    else
        int colon_idx = str.pos(session_str, ":")
        int dash_idx = str.pos(session_str, "-")
        if na(colon_idx) or na(dash_idx) or colon_idx <= dash_idx or dash_idx < 4
            false
        else
            string start_hhmm = str.substring(session_str, 0, dash_idx)
            string end_hhmm = str.substring(session_str, dash_idx + 1, colon_idx)
            string days = str.substring(session_str, colon_idx + 1)
            
            int start_min = int(str.tonumber(str.substring(start_hhmm, 0, 2))) * 60 + int(str.tonumber(str.substring(start_hhmm, 2, 4)))
            int end_min = int(str.tonumber(str.substring(end_hhmm, 0, 2))) * 60 + int(str.tonumber(str.substring(end_hhmm, 2, 4)))
            
            int m = RSL.f_mins_of_day(t, tz)
            int dow = dayofweek(t, tz)
            bool crosses_midnight = end_min < start_min
            
            bool in_time = false
            int start_dow = dow
            
            if not crosses_midnight
                in_time := (m >= start_min and m < end_min)
                start_dow := dow
            else
                if m >= start_min
                    in_time := true
                    start_dow := dow
                else if m < end_min
                    in_time := true
                    start_dow := (dow == 1 ? 7 : dow - 1)
                    
            bool in_day = in_time and (str.length(days) == 0 or str.pos(days, str.tostring(start_dow)) >= 0)
            in_day

f_init_runtime() =>
    array.clear(specs)
    array.clear(states)
    array.clear(histories)
    array.clear(drawings)
    array.clear(primary_breakout_sides)

    array<RSL.RangeSpec> resolved = RSL.f_resolve_preset(i_preset, i_custom_start, i_custom_end, i_custom_cutoff, i_timezone)
    int n = array.size(resolved)
    // log.info("RUNTIME INIT - Preset: {0} | Resolved {1} specs", i_preset, n)
    if n > 0
        for i = 0 to n - 1
            RSL.RangeSpec sp = array.get(resolved, i)
            array.push(specs, sp)
            array.push(states, RSL.f_new_range_state(sp))
            array.push(histories, STL.f_new_excursion_history(sp.name))
            array.push(drawings, Core.f_new_drawing_state())
            array.push(primary_breakout_sides, 0)

if barstate.isfirst
    f_init_runtime()

// Lower timeframe cache once per bar.
[ltf_open_arr, ltf_high_arr, ltf_low_arr, ltf_close_arr, ltf_time_arr] = request.security_lower_tf(syminfo.tickerid, "1", [open, high, low, close, time])
int ny_dow = dayofweek(time, i_timezone)

// ============================================================================
// Formatting helpers
// ============================================================================

f_or_color(int idx, string state) =>
    // Consume module-level resolved base colors — do not re-resolve here.
    color base = idx % 2 == 0 ? r_bull_color : r_bear_color
    int alpha = math.min(15 + idx * 10, 75)
    if state == "forming"
        alpha := math.min(alpha + 20, 95)
    color.new(base, alpha)



f_fmt_avg_text(string name, string line_name, float pct_value) =>
    name + " " + line_name + " " + STL.f_pct_fmt(pct_value)

f_fmt_med_text(string name, float pct_value) =>
    name + " Med " + STL.f_pct_fmt(pct_value)

// Emphasis logic helper for side-aware styling
f_get_side_styles(int side, int active_side, bool enabled, color base_clr) =>
    bool is_active = active_side == 0 or side == active_side
    color res_clr = enabled and not is_active ? color.new(base_clr, math.min(color.t(base_clr) + 40, 95)) : base_clr
    int res_width = enabled and not is_active ? 1 : 2
    [res_clr, res_width]


f_fmt_percentile_text(float pct_value) =>
    str.tostring(int(math.round(pct_value))) + "th"

// Shared rendering geometry so OR box, lines/labels, and histogram width stay in sync.
f_render_geometry(RSL.RangeSpec sp, RSL.RangeState st, int tf_min) =>
    int total_mins_to_cutoff = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
    int bars_to_cutoff = int(math.max(1.0, math.ceil(float(total_mins_to_cutoff) / float(tf_min))))
    int start_bar = na(st.or_start_bar) ? bar_index : st.or_start_bar
    int cutoff_bar = start_bar + bars_to_cutoff
    int render_end_bar = cutoff_bar
    int profile_width = math.max(10, bars_to_cutoff)
    [bars_to_cutoff, cutoff_bar, render_end_bar, profile_width]

// f_near_any removed in favor of Registry-based priority resolution

// ============================================================================
// Session tracking (unchanged from Phase 2 source)
// ============================================================================

f_process_price_update(RSL.RangeState st, STL.ExcursionHistory hist, RSL.RangeSpec sp, float h, float l, float c, int mins) =>
    [nb, ns, nbp, nsp] = STL.f_track_mfe(h, l, mins, st.bull_ref, st.bear_ref, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bull_peak_min, st.daily_bear_peak_min)
    st.daily_bull_mfe := nb, st.daily_bear_mfe := ns, st.daily_bull_peak_min := nbp, st.daily_bear_peak_min := nsp
    
    [mab, mas] = STL.f_track_mae_abs(h, l, st.or_high, st.or_low, st.daily_mae_bull_abs, st.daily_mae_bear_abs)
    st.daily_mae_bull_abs := mab, st.daily_mae_bear_abs := mas
    
    bool is_peak_hit_bull = mins == st.daily_bull_peak_min
    bool is_peak_hit_bear = mins == st.daily_bear_peak_min
    
    float b_peak_px = st.bull_ref * (1.0 + st.daily_bull_mfe / 100.0)
    float s_peak_px = st.bear_ref * (1.0 - st.daily_bear_mfe / 100.0)
    
    [mpb, mps] = STL.f_track_mae_pullback(
      bar_h=h, 
      bar_l=l, 
      or_high=st.or_high, 
      or_low=st.or_low, 
      entry_triggered_bull=st.entry_triggered_bull, 
      entry_triggered_bear=st.entry_triggered_bear, 
      is_bull_peak=is_peak_hit_bull, 
      is_bear_peak=is_peak_hit_bear, 
      bull_peak_price=b_peak_px,
      bear_peak_price=s_peak_px,
      prev_bull_pb=st.daily_mae_bull_pb, 
      prev_bear_pb=st.daily_mae_bear_pb
    )
    st.daily_mae_bull_pb := mpb
    st.daily_mae_bear_pb := mps
    

    if st.sig_breakout_side != 0
        float base_stats = st.sig_breakout_px
        if st.sig_breakout_side == STL.SIDE_BULL
            if h > base_stats
                st.daily_bo_mfe_bull := math.max(nz(st.daily_bo_mfe_bull, 0.0), (h - base_stats) / base_stats * 100.0)
            if l < base_stats
                st.daily_bo_mae_bull := math.max(nz(st.daily_bo_mae_bull, 0.0), (base_stats - l) / base_stats * 100.0)
        else if st.sig_breakout_side == STL.SIDE_BEAR
            if l < base_stats
                st.daily_bo_mfe_bear := math.max(nz(st.daily_bo_mfe_bear, 0.0), (base_stats - l) / base_stats * 100.0)
            if h > base_stats
                st.daily_bo_mae_bear := math.max(nz(st.daily_bo_mae_bear, 0.0), (h - base_stats) / base_stats * 100.0)
        

    array.push(st.data_mins, mins)
    array.push(st.data_highs, h)
    array.push(st.data_lows, l)
    
    // Track midpoint touch post-breakout for successful pullback verification
    if st.sig_breakout_side == STL.SIDE_BULL
        if l <= st.or_mid
            st.mid_hit_bull := true
    else if st.sig_breakout_side == STL.SIDE_BEAR
        if h >= st.or_mid
            st.mid_hit_bear := true
    
    if h > st.bull_ref
        st.entry_triggered_bull := true
    if l < st.bear_ref
        st.entry_triggered_bear := true
        
    st.close_at_cutoff := c




// Helper to handle signal latching, outcome tracking, and pullback activation.
f_process_signal_logic(RSL.RangeState st, STL.ExcursionHistory hist, RSL.RangeSpec sp, float c, float h, float l) =>
    if i_show_debug
        log.info("SIG_EVAL [{0}] c={1} or_h={2} or_l={3} sig_side={4} sig_outcome={5} sig_bo_side={6}", sp.name, c, st.or_high, st.or_low, st.sig_side, st.sig_outcome, st.sig_breakout_side)
    bool is_breakout_bar = false
    // First breakout is canonical for the session; do not relatch after fakeout.
    if st.sig_side == STL.SIDE_NONE
        bool bull_bo = c > st.or_high
        bool bear_bo = c < st.or_low
        
        if bull_bo or bear_bo
            // 1. Latch Signal and Base Price (using breakout bar close for momentum-relative levels)
            st.sig_side          := bull_bo ? STL.SIDE_BULL : STL.SIDE_BEAR
            st.sig_breakout_side := st.sig_side
            st.sig_breakout_px   := c
            st.sig_breakout_bar  := bar_index
            st.sig_outcome       := 0
            is_breakout_bar      := true
            if i_show_debug
                log.info("BO_LATCH [{0}] side={1} px={2} c={3} or_h={4} or_l={5}", sp.name, st.sig_side, st.sig_breakout_px, c, st.or_high, st.or_low)
            
            // 2. Seed Trigger-bar Excursion (Measured from breakout close price to align with breakout activation)
            st.daily_bo_mfe_bull := st.sig_side == STL.SIDE_BULL ? math.max(0.0, (h - st.sig_breakout_px) / st.sig_breakout_px * 100.0) : na
            st.daily_bo_mae_bull := st.sig_side == STL.SIDE_BULL ? math.max(0.0, (st.sig_breakout_px - l) / st.sig_breakout_px * 100.0) : na
            st.daily_bo_mfe_bear := st.sig_side == STL.SIDE_BEAR ? math.max(0.0, (st.sig_breakout_px - l) / st.sig_breakout_px * 100.0) : na
            st.daily_bo_mae_bear := st.sig_side == STL.SIDE_BEAR ? math.max(0.0, (h - st.sig_breakout_px) / st.sig_breakout_px * 100.0) : na
            
            int side = st.sig_side
            
            // 3. Build filtered histories for evaluation levels only (invalidation)
            array<float> bo_mae_wins = STL.f_filter_breakout_wins(side == STL.SIDE_BULL ? hist.bo_mae_bull : hist.bo_mae_bear, hist.sig_side, hist.sig_outcome, side)
            array<float> bo_mae_all  = STL.f_filter_breakout_all(side == STL.SIDE_BULL ? hist.bo_mae_bull : hist.bo_mae_bear, hist.sig_side, hist.sig_outcome, side)
            
            // 4. Compute evaluation percentiles and prices with robust cold-start fallbacks
            float p80_mae_fallback = STL.f_get_pct_fallback(bo_mae_all, 80, 0.5)
            float p80_mae = STL.f_get_pct_fallback(bo_mae_all, 80, p80_mae_fallback)
            
            st.sig_target_px  := st.sig_breakout_px * (side == STL.SIDE_BULL ? 1.0 + i_ev_target_pct / 100.0 : 1.0 - i_ev_target_pct / 100.0)
            st.sig_invalid_px := st.sig_breakout_px * (side == STL.SIDE_BULL ? 1.0 - p80_mae / 100.0 : 1.0 + p80_mae / 100.0)
            
            if i_show_debug
                log.info("BO_EVAL_LATCH [{0}] side={1} tgt={2} inv={3} ev_tgt={4} p80_mae={5}", sp.name, side, st.sig_target_px, st.sig_invalid_px, i_ev_target_pct, p80_mae)
                label.new(bar_index, high, "LATCH: BO=" + str.tostring(st.sig_breakout_px) + " S=" + str.tostring(st.sig_side), color=color.blue, textcolor=color.white, style=label.style_label_down)
    
    // Evaluation logic (using latched values)
    // VERIFIED RULE: Invalidation wick-touch is the ONLY classification criterion.
    //   WIN  (1) = breakout occurred AND no invalidation wick-touch before cutoff (finalized at commit)
    //   LOSS (-1) = invalidation wick-touch hit
    //   FAKE (2)  = invalidation hit AND opposite OR wick cross (deeper loss; populates fakeout arrays)
    // EV target is a display level only — NOT a classification criterion.
    if st.sig_side != STL.SIDE_NONE and st.sig_outcome <= 0 and not is_breakout_bar
        // 1. Invalidation wick-touch — primary classification criterion (FAILED)
        if not na(st.sig_invalid_px) and (st.sig_side == STL.SIDE_BULL ? l <= st.sig_invalid_px : h >= st.sig_invalid_px)
            st.sig_outcome := STL.OUTCOME_LOSS // Straight Loss
        // 2. Fakeout — opposite OR wick cross (deeper than invalidation; overrides -1 -> 2 so
        //    f_commit_daily populates fake_mfe/fake_mae/fakeout_reversal arrays for
        //    Pivot / Confirm / Reversal Zone levels. No new variable needed.
        bool crossed_opposite = st.sig_side == STL.SIDE_BULL ? l < st.or_low : h > st.or_high
        if crossed_opposite
            st.sig_outcome := STL.OUTCOME_FAKE // Fakeout (deep loss; preserves fakeout-dependent levels)

f_track_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    bool in_or = f_in_session_pine_robust(sp.session_or, sp.tz, time)
    bool in_data = f_in_session_pine_robust(sp.session_data, sp.tz, time)
    bool is_new_session = in_or and not st.prev_in_or
    
    // 1. Daily Commitment (End of previous session logic)
    // Refactored to ensure we commit even if the session ended exactly at the last bar of history
    if is_new_session and not st.is_committed and st.ref_set and not na(st.bull_ref)
        float mfe_b_comm = not na(st.daily_bull_mfe) ? st.daily_bull_mfe : na
        float mfe_s_comm = not na(st.daily_bear_mfe) ? st.daily_bear_mfe : na
        float bo_mfe_b_comm = st.sig_side == STL.SIDE_BULL ? st.daily_bo_mfe_bull : na
        float bo_mfe_s_comm = st.sig_side == STL.SIDE_BEAR ? st.daily_bo_mfe_bear : na
        float bo_mae_b_comm = st.sig_side == STL.SIDE_BULL ? st.daily_bo_mae_bull : na
        float bo_mae_s_comm = st.sig_side == STL.SIDE_BEAR ? st.daily_bo_mae_bear : na
        float mae_abs_b_comm = st.entry_triggered_bull ? st.daily_mae_bull_abs : na
        float mae_abs_s_comm = st.entry_triggered_bear ? st.daily_mae_bear_abs : na
        float pb_bull = (na(st.daily_mae_bull_pb) or (not st.entry_triggered_bull)) ? na : st.daily_mae_bull_pb
        float pb_bear = (na(st.daily_mae_bear_pb) or (not st.entry_triggered_bear)) ? na : st.daily_mae_bear_pb

        // Fix: Cutoff finalization — no invalidation = WIN (FULL). Previously PENDING (0)
        // sessions were silently dropped from win-rate stats (o != 0 filter).
        if st.sig_side != STL.SIDE_NONE and st.sig_outcome == 0
            st.sig_outcome := STL.OUTCOME_WIN // WIN (FULL) — no invalidation wick-touch before cutoff
        bool mid_hit_b_comm = st.sig_side == STL.SIDE_BULL and st.mid_hit_bull and st.sig_outcome == 1
        bool mid_hit_s_comm = st.sig_side == STL.SIDE_BEAR and st.mid_hit_bear and st.sig_outcome == 1
        STL.f_commit_daily(hist, mfe_b_comm, mfe_s_comm, bo_mfe_b_comm, bo_mfe_s_comm, st.daily_bull_peak_min, st.daily_bear_peak_min, mae_abs_b_comm, mae_abs_s_comm, pb_bull, pb_bear, bo_mae_b_comm, bo_mae_s_comm, mid_hit_b_comm, mid_hit_s_comm, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.sig_side, st.sig_outcome)
        st.is_committed := true

    if is_new_session
        if i_show_debug
            log.info("RESET_DAILY [{0}] {1} bar_index={2} in_or={3} prev_in_or={4}", idx, sp.name, bar_index, in_or, st.prev_in_or)
        RSL.f_reset_daily(st)
        array.set(primary_breakout_sides, idx, 0)

    st.prev_in_or := in_or

    // 2. Core Price Processing (LTF or Current)
    int ltf_count = array.size(ltf_time_arr)
    bool or_processed = false
    bool data_processed = false

    if ltf_count > 0
        for j = 0 to ltf_count - 1
            int m = RSL.f_mins_of_day(array.get(ltf_time_arr, j), sp.tz)
            float o = array.get(ltf_open_arr, j), h = array.get(ltf_high_arr, j), l = array.get(ltf_low_arr, j), c = array.get(ltf_close_arr, j)
            
            bool is_in_or_mins = RSL.f_in_session_minutes(m, sp.or_start_min, sp.or_end_min, sp.or_end_min < sp.or_start_min)
            bool is_in_data_mins = RSL.f_in_session_minutes(m, sp.or_end_min, sp.cutoff_min, sp.cutoff_min < sp.or_end_min)

            // OR Building
            if is_in_or_mins
                if not st.or_building
                    st.session_open := o, st.or_high := h, st.or_low := l, st.or_last_close := c, st.or_building := true, st.or_start_bar := bar_index
                else
                    st.or_high := math.max(st.or_high, h), st.or_low := math.min(st.or_low, l), st.or_last_close := c
                // Ensure refs are available during building for live rendering
                st.bull_ref := st.or_high, st.bear_ref := st.or_low, st.or_mid := (st.or_high + st.or_low) / 2.0
                or_processed := true
            
            // Immediate transition from OR to Data
            if not is_in_or_mins and st.or_building
                st.or_complete := true
                st.bull_ref := st.or_high, st.bear_ref := st.or_low, st.or_mid := (st.or_high + st.or_low) / 2.0, st.ref_set := true
                st.or_building := false
            // log.info("LIFECYCLE - {0} | OR Complete (LTF) at min {1} | High: {2}, Low: {3}", sp.name, m, st.or_high, st.or_low)

            // We want to capture data using the Charts Timeframe and not LTF because of pinescript limitations wrt the amount of data on LTF
        

    // Main bar fallbacks (if LTF data missed something or isn't available)
    if in_or and not or_processed
        if not st.or_building
            st.session_open := open, st.or_high := high, st.or_low := low, st.or_last_close := close, st.or_building := true, st.or_start_bar := bar_index
        else
            st.or_high := math.max(st.or_high, high), st.or_low := math.min(st.or_low, low), st.or_last_close := close
        // Ensure refs are available during building for live rendering
        st.bull_ref := st.or_high, st.bear_ref := st.or_low, st.or_mid := (st.or_high + st.or_low) / 2.0
        or_processed := true

    if not in_or and st.or_building and not or_processed
        st.or_complete := true
        st.bull_ref := st.or_high, st.bear_ref := st.or_low, st.or_mid := (st.or_high + st.or_low) / 2.0, st.ref_set := true
        st.or_building := false
    // log.info("LIFECYCLE - {0} | OR Complete (Main) | High: {1}, Low: {2}", sp.name, st.or_high, st.or_low)

    if in_data and not data_processed and st.ref_set
        if i_show_debug
            log.info("DATA_GATE [{0}] {1} close={2} or_h={3} ref_set={4} in_data={5}", idx, sp.name, close, st.or_high, st.ref_set, in_data)
        int mins_s = RSL.f_mins_since(RSL.f_mins_of_day(time, sp.tz), sp.or_start_min)
        f_process_price_update(st, hist, sp, high, low, close, mins_s)
        f_process_signal_logic(st, hist, sp, close, high, low)
        data_processed := true

    // 3. Lifecycle Transitions (Final cleanup)
    if st.or_building and not st.or_complete and not in_or and not or_processed
        st.or_complete := true

    if st.or_complete and not st.ref_set and not na(st.or_high)
        st.bull_ref := st.or_high, st.bear_ref := st.or_low, st.or_mid := (st.or_high + st.or_low) / 2.0, st.ref_set := true

    bool effective_in_data = in_data or data_processed
    bool data_just_ended = st.prev_in_data and not effective_in_data
    st.prev_in_data := effective_in_data

    if data_just_ended and not st.is_committed and st.ref_set
        float mfe_b_comm = not na(st.daily_bull_mfe) ? st.daily_bull_mfe : na
        float mfe_s_comm = not na(st.daily_bear_mfe) ? st.daily_bear_mfe : na
        float bo_mfe_b_comm = st.sig_side == STL.SIDE_BULL ? st.daily_bo_mfe_bull : na
        float bo_mfe_s_comm = st.sig_side == STL.SIDE_BEAR ? st.daily_bo_mfe_bear : na
        float bo_mae_b_comm = st.sig_side == STL.SIDE_BULL ? st.daily_bo_mae_bull : na
        float bo_mae_s_comm = st.sig_side == STL.SIDE_BEAR ? st.daily_bo_mae_bear : na
        float mae_abs_b_comm = st.entry_triggered_bull ? st.daily_mae_bull_abs : na
        float mae_abs_s_comm = st.entry_triggered_bear ? st.daily_mae_bear_abs : na
        float pb_bull = (na(st.daily_mae_bull_pb) or (not st.entry_triggered_bull)) ? na : st.daily_mae_bull_pb
        float pb_bear = (na(st.daily_mae_bear_pb) or (not st.entry_triggered_bear)) ? na : st.daily_mae_bear_pb

        // Fix: Cutoff finalization — no invalidation = WIN (FULL). Previously PENDING (0)
        // sessions were silently dropped from win-rate stats (o != 0 filter).
        if st.sig_side != STL.SIDE_NONE and st.sig_outcome == 0
            st.sig_outcome := STL.OUTCOME_WIN // WIN (FULL) — no invalidation wick-touch before cutoff
        bool mid_hit_b_comm = st.sig_side == STL.SIDE_BULL and st.mid_hit_bull and st.sig_outcome == 1
        bool mid_hit_s_comm = st.sig_side == STL.SIDE_BEAR and st.mid_hit_bear and st.sig_outcome == 1
        STL.f_commit_daily(hist, mfe_b_comm, mfe_s_comm, bo_mfe_b_comm, bo_mfe_s_comm, st.daily_bull_peak_min, st.daily_bear_peak_min, mae_abs_b_comm, mae_abs_s_comm, pb_bull, pb_bear, bo_mae_b_comm, bo_mae_s_comm, mid_hit_b_comm, mid_hit_s_comm, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.sig_side, st.sig_outcome)
        st.is_committed := true


    if i_show_debug and is_new_session
        Markers.f_draw_text_marker(array.get(drawings, idx), bar_index, high, "NEW: " + sp.name, debug_text_color_resolved, "down", "Normal")

    if array.get(primary_breakout_sides, idx) == 0 and st.sig_side != STL.SIDE_NONE
        array.set(primary_breakout_sides, idx, st.sig_side)

    array.set(states, idx, st)
    array.set(histories, idx, hist)
    if barstate.islast and i_show_debug
        log.info("FINAL_STATE [{0}] {1} sig_side={2} sig_bo_side={3} sig_outcome={4} sig_bo_px={5} in_data={6} ref_set={7}", idx, sp.name, st.sig_side, st.sig_breakout_side, st.sig_outcome, st.sig_breakout_px, in_data, st.ref_set)

if array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_track_range(i)

// ============================================================================
// Rendering Helpers
// ============================================================================

f_render_dist_histogram_internal(Core.PineDrawingState ds, Core.LabelRegistry lbl_reg, float anchor_px, array<float> data_filtered, int direction, color base_color, int x1, int max_width, string lc_state, string profile_label_size, color stat_label_color, int hist_pct_start, int hist_pct_end, int hist_pct_step, bool show_labels, string label_strategy, string sp_name) =>
    int hist_bin_count = math.max(0, int(math.ceil(float(hist_pct_end - hist_pct_start) / float(hist_pct_step))))
    
    if array.size(data_filtered) > 0 and hist_bin_count > 0
        array<float> val_los = array.new_float(0)
        array<float> val_his = array.new_float(0)
        array<float> densities = array.new_float(0)
        array<float> pct_los = array.new_float(0)
        
        for b = 0 to hist_bin_count - 1
            float p_lo = hist_pct_start + float(hist_pct_step * b)
            float p_hi = math.min(hist_pct_end, p_lo + hist_pct_step)
            float v_lo = array.percentile_nearest_rank(data_filtered, p_lo)
            float v_hi = array.percentile_nearest_rank(data_filtered, p_hi)
            float band_span = math.max(v_hi - v_lo, 0.0001)
            int count = 0
            for s = 0 to array.size(data_filtered) - 1
                float val = array.get(data_filtered, s)
                if val >= v_lo and (b == hist_bin_count - 1 ? val <= v_hi : val < v_hi)
                    count += 1
            array.push(val_los, v_lo)
            array.push(val_his, v_hi)
            array.push(densities, float(count) / band_span)
            array.push(pct_los, p_lo)
            
        // P20 Density Flattening (prevents thin long tails from becoming massive boxes)
        float p20_density = na
        for b = 0 to hist_bin_count - 1
            if array.get(pct_los, b) >= 20.0 and na(p20_density)
                p20_density := array.get(densities, b)
        if not na(p20_density)
            for b = 0 to hist_bin_count - 1
                if array.get(pct_los, b) < 20.0
                    array.set(densities, b, math.min(array.get(densities, b), p20_density))
                    
        float max_density = 0.0
        for b = 0 to hist_bin_count - 1
            max_density := math.max(max_density, array.get(densities, b))
            
        for b = 0 to hist_bin_count - 1
            float v_lo = array.get(val_los, b)
            float v_hi = array.get(val_his, b)
            float density = array.get(densities, b)
            float p_lo = array.get(pct_los, b)
            float width_normalized = max_density > 0 ? density / max_density : 0.0
            
            // Apply slight shaping for Bear/Bear consistency if needed? 
            // Previous code had sqrt for bear but not bull, let's normalize to standard linear or sqrt if preferred.
            // Linear looks cleaner for comparisons.
            int box_width = math.max(2, int(math.round(width_normalized * float(max_width))))
            
            if v_hi >= v_lo
                float y1 = anchor_px * (1.0 + (float(direction) * v_lo / 100.0))
                float y2 = anchor_px * (1.0 + (float(direction) * v_hi / 100.0))
                Zones.f_draw_hist_band(ds, x1, y1, y2, box_width, base_color, 58)
                if show_labels
                    Core.f_label_registry_push_ex(lbl_reg, (y1 + y2) / 2.0, f_fmt_percentile_text(p_lo), stat_label_color, x1 - 1, label_strategy, 10, sp_name + "_hist_bin", "right", profile_label_size, "Label", "", 0, lc_state)


// ============================================================================
// Rendering
// ============================================================================

f_render_session_instance(int idx, RSL.RangeSpec sp, RSL.RangeState st, STL.ExcursionHistory hist, Core.PineDrawingState ds, Core.LabelRegistry lbl_reg) =>
    int tf_min = timeframe.isintraday ? timeframe.multiplier : 1
    [bars_to_cutoff, cutoff_bar, line_render_end, max_profile_width] = f_render_geometry(sp, st, tf_min)
    int bo_bar = not na(st.sig_breakout_bar) ? st.sig_breakout_bar : st.or_start_bar

    // Lifecycle state for this render pass
    string lc_state = st.or_building and not st.or_complete ? "forming" : st.or_complete ? "finalized" : "inactive"

    // Display Profile scaling
    string profile_label_size = Core.f_display_profile_label_size(i_label_size, i_display_profile)
    int    profile_line_width = Core.f_display_profile_width(1, i_display_profile)

    // Palette consumers
    color bull_color              = r_bull_color
    color bear_color              = r_bear_color
    color stat_label_color        = r_stat_label_color
    color stat_median_color       = r_stat_median_color
    color stat_avg_color          = r_stat_avg_color
    color stat_stretch_color      = r_stat_stretch_color
    color mid_line_color          = r_mid_line_color
    color time_title_color        = r_time_title_color
    color bo_cashflow_color       = r_bo_cashflow_color
    color bo_confirm_color        = r_bo_confirm_color
    color pivot_color             = r_pivot_color
    color reversal_zone_color     = r_reversal_zone_color
    color max_reversal_color      = r_max_reversal_color
    color invalidation_line_color = r_invalidation_color
    color breakout_activation_color = r_breakout_act_color
    color pullback_activation_color = r_pullback_act_color
    color pb_not_armed_color      = r_pb_not_armed_color

    string strat = str.lower(i_label_strategy)
    
    // Resolve side and anchor for this specific instance (works for live and historical)
    int render_side = st.sig_breakout_side != 0 ? st.sig_breakout_side : st.sig_side
    
    float render_px = not na(st.sig_breakout_px) ? st.sig_breakout_px : (render_side == STL.SIDE_BULL ? st.or_high : render_side == STL.SIDE_BEAR ? st.or_low : na)

    
    // OR box
    if st.or_building and not na(st.or_start_bar)
        Zones.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx, lc_state), i_box_style, i_box_width)
    else if st.or_complete and not na(st.or_start_bar)
        Zones.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx, lc_state), i_box_style, i_box_width)

    // ========================================================================
    // Unified Technical & Statistical Levels
    // ========================================================================
    // 1. Pre-build filtered histories for stats and rendering
    array<float> mfe_b = STL.f_build_filtered(hist.mfe_bull)
    array<float> mfe_s = STL.f_build_filtered(hist.mfe_bear)

    // HARM DEBUG: Raw array sizes
    log.info("HARM_ARRAYS [{0}] mfe_bull={1} mfe_bear={2} bo_mfe_bull={3} bo_mfe_bear={4} bo_mae_bull={5} bo_mae_bear={6} mae_bull_abs={7} mae_bear_abs={8} sig_side={9} sig_outcome={10}", sp.name, array.size(hist.mfe_bull), array.size(hist.mfe_bear), array.size(hist.bo_mfe_bull), array.size(hist.bo_mfe_bear), array.size(hist.bo_mae_bull), array.size(hist.bo_mae_bear), array.size(hist.mae_bull_abs), array.size(hist.mae_bear_abs), array.size(hist.sig_side), array.size(hist.sig_outcome))

    // Rendering Gate: Allow rendering during OR building or once refs are set
    if (st.ref_set or st.or_building) and not na(st.bull_ref)
        if i_show_debug
            log.info("RENDERING BLOCK REACHED [{0}] {1}: ref_set={2}, bull_ref={3}", idx, sp.name, st.ref_set, st.bull_ref)
        int ln_end = line_render_end
        int label_x = ln_end + i_label_gap_bars
        string m_group = "unified-levels-" + str.tostring(idx)

        // OR boundaries (always drawn once OR starts building or completes)
        if not na(st.or_high)
            HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, st.or_high, "OR High" + lb_sfx, breakout_activation_color, 92, m_group + "_or_h", 0, strat)
        if not na(st.or_low)
            HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, st.or_low, "OR Low" + lb_sfx, breakout_activation_color, 92, m_group + "_or_l", 0, strat)

        // [Optimized] Tactical histories removed as levels are now state-latched in f_process_signal_logic

        // 2. Multi-excursion Statistical Levels (Optimized side-aware loop)
        int primary_side = array.get(primary_breakout_sides, idx)
        bool draw_bull = i_show_stat_lines and (i_stat_side_strategy == "Both" or (i_stat_side_strategy == "Active Only" and (render_side == STL.SIDE_BULL or render_side == 0)) or (i_stat_side_strategy == "Primary Only" and (primary_side == STL.SIDE_BULL or primary_side == 0)))
        bool draw_bear = i_show_stat_lines and (i_stat_side_strategy == "Both" or (i_stat_side_strategy == "Active Only" and (render_side == STL.SIDE_BEAR or render_side == 0)) or (i_stat_side_strategy == "Primary Only" and (primary_side == STL.SIDE_BEAR or primary_side == 0)))

        // side_arr: Using array.from for v6 compatibility
        for i = 0 to 1
            int side = i == 0 ? 1 : -1
            bool should_draw = side == STL.SIDE_BULL ? draw_bull : draw_bear
            array<float> src_data = side == STL.SIDE_BULL ? mfe_b : mfe_s
            float ref_px = side == STL.SIDE_BULL ? st.bull_ref : st.bear_ref
            string side_group = m_group + (side == STL.SIDE_BULL ? "_b" : "_s")
            
            if should_draw
                // Resolved emphasis styles for this side
                [c_med, w_med] = f_get_side_styles(side, render_side, i_emphasize_active_side, stat_median_color)
                [c_avg, w_avg] = f_get_side_styles(side, render_side, i_emphasize_active_side, stat_avg_color)
                [c_str, w_str] = f_get_side_styles(side, render_side, i_emphasize_active_side, r_stat_stretch_color)

                // MED/MAX MFE: Use Green (FULL/winning) sessions from BO px — verified 2026-06-30
                array<float> green_mfe = STL.f_filter_breakout_wins(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side)
                float green_bo_px = not na(st.sig_breakout_px) and st.sig_breakout_side == side ? st.sig_breakout_px : (side == STL.SIDE_BULL ? st.or_high : st.or_low)
                
                if array.size(green_mfe) > 0
                    float p_med = array.percentile_nearest_rank(green_mfe, 50)
                    float p_avg = array.avg(green_mfe)
                    float p_str = array.percentile_nearest_rank(green_mfe, 75)
                    
                    float y_med = green_bo_px * (1.0 + (side * p_med / 100.0))
                    float y_avg = green_bo_px * (1.0 + (side * p_avg / 100.0))
                    float y_str = green_bo_px * (1.0 + (side * p_str / 100.0))
                    
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, y_med, "MED MFE " + STL.f_pct_fmt(p_med) + lb_sfx, c_med, 42, side_group, 0, strat, "MED MFE — p50 MFE of Green zone sessions")
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, y_avg, "AVG " + STL.f_pct_fmt(p_avg) + lb_sfx, c_avg, 43, side_group, 0, strat, "AVG — average MFE of Green zone sessions")
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, y_str, "MAX MFE P75 " + STL.f_pct_fmt(p_str) + lb_sfx, c_str, 50, side_group, 0, strat, "MAX MFE — p75 Green")

        // 3. Tactical Directional Levels (Respect side strategy and suppress pre-breakout)
        bool has_breakout = (render_side != 0)
        bool draw_tac_bull = has_breakout and (i_stat_side_strategy == "Both" or (i_stat_side_strategy == "Active Only" and render_side == STL.SIDE_BULL) or (i_stat_side_strategy == "Primary Only" and primary_side == STL.SIDE_BULL))
        bool draw_tac_bear = has_breakout and (i_stat_side_strategy == "Both" or (i_stat_side_strategy == "Active Only" and render_side == STL.SIDE_BEAR) or (i_stat_side_strategy == "Primary Only" and primary_side == STL.SIDE_BEAR))

        for i = 0 to 1
            int side = i == 0 ? 1 : -1
            bool should_draw_tac = side == STL.SIDE_BULL ? draw_tac_bull : draw_tac_bear
            
            if i_show_debug
                log.info("DEBUG BO ACT [" + str.tostring(idx) + "] " + sp.name + " Side=" + str.tostring(side) + ": should_draw=" + (should_draw_tac ? "true" : "false") + ", render_side=" + str.tostring(render_side))
            
            if not should_draw_tac
                continue

            bool is_active_side = (side == render_side)
            string side_label = render_side == 0 ? (side == STL.SIDE_BULL ? "Bull " : "Bear ") : ""
            string side_group = m_group + (side == STL.SIDE_BULL ? "_b" : "_s")
            
            // Reference price for this side's breakout (use latched px if active, else OR boundary)
            float t_render_px = is_active_side and not na(st.sig_breakout_px) ? st.sig_breakout_px : (side == STL.SIDE_BULL ? st.or_high : st.or_low)
            
            if i_show_debug
                log.info("TACTICAL LOOP [" + str.tostring(idx) + "] " + sp.name + " Side=" + str.tostring(side) + ": is_active=" + (is_active_side ? "true" : "false") + ", t_render_px=" + str.tostring(t_render_px))
            
            if not na(t_render_px)
                // Percentile stats (single source of truth — always from history)
                float p50_bo   = STL.f_get_pct_fallback(STL.f_filter_breakout_wins(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side), 50)
                // Cashflow uses WINS (Green/FULL sessions) — verified 2026-06-30 via Python + Gunship comparison
                float p20_bo   = STL.f_get_pct_fallback(STL.f_filter_breakout_wins(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side), 20)
                float p50_fake = STL.f_get_pct_fallback(STL.f_filter_fakeout_mfe(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side), 50)
                float p75_fake = STL.f_get_pct_fallback(STL.f_filter_fakeout_mfe(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side), 75)
                
                // MAE stats (Invalidation/Pullback) with robust cold-start fallbacks
                float p80_mae_losses = STL.f_get_pct_fallback(STL.f_build_filtered_by_outcome(side == STL.SIDE_BULL ? hist.bo_mae_bull : hist.bo_mae_bear, hist.sig_side, hist.sig_outcome, side, STL.OUTCOME_NON_WIN), 80, 0.5)
                float p80_mae_wins   = STL.f_get_pct_fallback(STL.f_build_filtered_by_outcome(side == STL.SIDE_BULL ? hist.bo_mae_bull : hist.bo_mae_bear, hist.sig_side, hist.sig_outcome, side, STL.OUTCOME_WIN), 80, p80_mae_losses)
                // Pullback uses WINS (Green/FULL sessions) — verified 2026-06-30 via Python + Gunship comparison
                float p25_mae        = STL.f_get_pct_fallback(STL.f_filter_breakout_wins(side == STL.SIDE_BULL ? hist.bo_mae_bull : hist.bo_mae_bear, hist.sig_side, hist.sig_outcome, side), 25, 0.15)

                // Derived prices (single source of truth — always from t_render_px)
                float target_px        = t_render_px * (side == STL.SIDE_BULL ? 1.0 + i_ev_target_pct / 100.0 : 1.0 - i_ev_target_pct / 100.0)
                float pivot_px         = t_render_px * (side == STL.SIDE_BULL ? 1.0 + p50_fake / 100.0 : 1.0 - p50_fake / 100.0)
                float invalid_px_wins  = t_render_px * (side == STL.SIDE_BULL ? 1.0 - p80_mae_wins / 100.0 : 1.0 + p80_mae_wins / 100.0)
                float invalid_px_losses = t_render_px * (side == STL.SIDE_BULL ? 1.0 - p80_mae_losses / 100.0 : 1.0 + p80_mae_losses / 100.0)
                float pullback_px      = t_render_px * (side == STL.SIDE_BULL ? 1.0 - p25_mae / 100.0 : 1.0 + p25_mae / 100.0)
                
                float rev_p25 = STL.f_get_pct_fallback(STL.f_filter_fakeout_mae(side == STL.SIDE_BULL ? hist.mae_bull_abs : hist.mae_bear_abs, hist.sig_side, hist.sig_outcome, side), 25)
                float rev_p50 = STL.f_get_pct_fallback(STL.f_filter_fakeout_mae(side == STL.SIDE_BULL ? hist.mae_bull_abs : hist.mae_bear_abs, hist.sig_side, hist.sig_outcome, side), 50)
                float rev_p75 = STL.f_get_pct_fallback(STL.f_filter_fakeout_mae(side == STL.SIDE_BULL ? hist.mae_bull_abs : hist.mae_bear_abs, hist.sig_side, hist.sig_outcome, side), 75)

                // HARM DEBUG: Percentile values and array sizes for this side
                array<float> bo_mfe_all_arr = STL.f_filter_breakout_all(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side)
                array<float> bo_mfe_win_arr = STL.f_filter_breakout_wins(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side)
                array<float> fake_mfe_arr = STL.f_filter_fakeout_mfe(side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, side)
                array<float> fake_mae_arr = STL.f_filter_fakeout_mae(side == STL.SIDE_BULL ? hist.mae_bull_abs : hist.mae_bear_abs, hist.sig_side, hist.sig_outcome, side)
                array<float> mfe_filtered = STL.f_build_filtered(side == STL.SIDE_BULL ? hist.mfe_bull : hist.mfe_bear)
                log.info("HARM_PCT [{0}] Side={1} | bo_mfe_all N={2} p20={3} | bo_mfe_win N={4} p50={5} | fake_mfe N={6} p50={7} p75={8} | fake_mae N={9} p25={10} p50={11} | mfe_all N={12} p50={13} p90={14} | t_render_px={15}", sp.name, side, array.size(bo_mfe_all_arr), p20_bo, array.size(bo_mfe_win_arr), p50_bo, array.size(fake_mfe_arr), p50_fake, p75_fake, array.size(fake_mae_arr), rev_p25, rev_p50, array.size(mfe_filtered), array.size(mfe_filtered) > 0 ? array.percentile_nearest_rank(mfe_filtered, 50) : na, array.size(mfe_filtered) > 0 ? array.percentile_nearest_rank(mfe_filtered, 90) : na, t_render_px)

                // Resolved emphasis styles for tactical side
                [c_bo_act, w_bo_act] = f_get_side_styles(side, render_side, i_emphasize_active_side, breakout_activation_color)
                [c_pb_act, w_pb_act] = f_get_side_styles(side, render_side, i_emphasize_active_side, pullback_activation_color)
                [c_inv, w_inv]       = f_get_side_styles(side, render_side, i_emphasize_active_side, invalidation_line_color)
                [c_tgt, w_tgt]       = f_get_side_styles(side, render_side, i_emphasize_active_side, stat_median_color)
                [c_cash, w_cash]     = f_get_side_styles(side, render_side, i_emphasize_active_side, bo_cashflow_color)
                [c_conf, w_conf]     = f_get_side_styles(side, render_side, i_emphasize_active_side, bo_confirm_color)
                [c_tpiv, w_tpiv]     = f_get_side_styles(side, render_side, i_emphasize_active_side, pivot_color)

                // Core tactical lines: Invalidation, Pullback
                if not na(pullback_px)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", bo_bar, ln_end, pullback_px, side_label + "PB Entry " + STL.f_pct_fmt(p25_mae) + lb_sfx, c_pb_act, 85, side_group, 0, strat, "PB entry — p25 MAE")

                if not na(invalid_px_wins)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", bo_bar, ln_end, invalid_px_wins, side_label + "PB/BO Inval " + lb_sfx, color.new(c_inv, 30), 94, side_group + "_wins", 0, strat, "PB/BO Invalidation — p80 MAE from breakout")

                if not na(invalid_px_losses)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", bo_bar, ln_end, invalid_px_losses, side_label + "PB Inval Losses P80" + lb_sfx, c_inv, 95, side_group + "_losses", 0, strat, "PB Invalidation Losses — p80 MAE from breakout (losses only)")

                // Targets & Cashflow
                if not na(target_px)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", bo_bar, ln_end, target_px, side_label + "Target BO EV Target " + STL.f_pct_fmt(i_ev_target_pct) + lb_sfx, c_tgt, 78, side_group, 0, strat, "Target — EV target " + STL.f_pct_fmt(i_ev_target_pct) + " from breakout")

                float y_cash = t_render_px * (side == STL.SIDE_BULL ? 1.0 + p20_bo / 100.0 : 1.0 - p20_bo / 100.0)
                if not na(y_cash)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", bo_bar, ln_end, y_cash, side_label + "BO Cashflow " + STL.f_pct_fmt(p20_bo) + lb_sfx, c_cash, 80, side_group, 0, strat, "BO Cashflow — p20 MFE from breakout (" + STL.f_pct_fmt(p20_bo) + "). 80% of sessions reached this level.")

                float y_conf = t_render_px * (side == STL.SIDE_BULL ? 1.0 + p75_fake / 100.0 : 1.0 - p75_fake / 100.0)
                if not na(y_conf)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", bo_bar, ln_end, y_conf, side_label + "BO Confirm " + STL.f_pct_fmt(p75_fake) + lb_sfx, c_conf, 75, side_group, 0, strat, "BO Confirm — p75 MFE of fakes")

                // Pivot (P50 of Fakes MFE)
                if not na(pivot_px)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", bo_bar, ln_end, pivot_px, side_label + "Pivot " + STL.f_pct_fmt(p50_fake) + lb_sfx, c_tpiv, 70, side_group, 0, strat, "Pivot — p50 MFE of fakes")

                // Reversal Zone — Fix 1+2: Anchor at OR High/Low, range P25-P50 (per Gunship tooltip)
                if not na(rev_p25) and not na(rev_p50) and rev_p25 > 0
                    float y_rev25 = side == STL.SIDE_BULL ? st.or_high * (1.0 - rev_p25 / 100.0) : st.or_low * (1.0 + rev_p25 / 100.0)
                    float y_rev50 = side == STL.SIDE_BULL ? st.or_high * (1.0 - rev_p50 / 100.0) : st.or_low * (1.0 + rev_p50 / 100.0)
                    float z_top = math.max(y_rev25, y_rev50), z_bot = math.min(y_rev25, y_rev50)
                    int z_w = math.max(2, ln_end - bo_bar)
                    Zones.f_draw_hist_band(ds, bo_bar, z_top, z_bot, z_w, r_reversal_zone_color, i_zone_transparency)
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", bo_bar, bo_bar + z_w, y_rev50, side_label + "Reversal Zone " + lb_sfx, c_conf, 55, side_group, 0, strat, "Reversal Zone — p25-p50 MAE of fakes")

                // Draw breakout activation only if this side is the active breakout side and breakout px is valid.
                if is_active_side and not na(st.sig_breakout_px)
                    if i_show_debug
                        log.info("  -> DRAWING BO ACT: bar=" + str.tostring(bo_bar) + ", price=" + str.tostring(st.sig_breakout_px) + ", side=" + str.tostring(side))
                    HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", bo_bar, ln_end, st.sig_breakout_px, "BO Entry" + lb_sfx, c_bo_act, 90, side_group + "_bo", 0, strat, "Breakout close at range high")

        // 4. Shared Midpoint Logic
        int n_m = math.min(array.size(hist.mid_hit_bull), array.size(hist.mid_hit_bear)), m_h = 0
        int n_wins = 0
        if n_m > 0
            for k = 0 to n_m - 1
                if array.get(hist.sig_outcome, k) == 1
                    n_wins += 1
                    if array.get(hist.mid_hit_bull, k) or array.get(hist.mid_hit_bear, k)
                        m_h += 1
        float m_pct = n_wins == 0 ? na : (float(m_h) / float(n_wins)) * 100.0
        HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, st.or_mid, "Midpoint " + STL.f_pct_fmt(m_pct) + lb_sfx, r_mid_line_color, 50, sp.name + "_mid", 0, strat, "Range Midpoint (Hit rate " + STL.f_pct_fmt(m_pct) + ")")

        // 5. Histograms
        if i_show_histogram
            f_render_dist_histogram_internal(ds, lbl_reg, st.bull_ref, mfe_b, 1, bull_color, st.or_start_bar, max_profile_width, lc_state, profile_label_size, stat_label_color, i_hist_start_pct, i_hist_end_pct, i_hist_pct_step, i_show_hist_bin_labels, str.lower(i_label_strategy), sp.name)
            f_render_dist_histogram_internal(ds, lbl_reg, st.bear_ref, mfe_s, -1, bull_color, st.or_start_bar, max_profile_width, lc_state, profile_label_size, stat_label_color, i_hist_start_pct, i_hist_end_pct, i_hist_pct_step, i_show_hist_bin_labels, str.lower(i_label_strategy), sp.name)

        if i_show_bo_histogram and render_side != 0 and not na(render_px)
            array<float> bo_mfe_win = STL.f_filter_breakout_wins(render_side == STL.SIDE_BULL ? hist.bo_mfe_bull : hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, render_side)
            array<float> bo_mae_win = STL.f_filter_breakout_wins(render_side == STL.SIDE_BULL ? hist.bo_mae_bull : hist.bo_mae_bear, hist.sig_side, hist.sig_outcome, render_side)

            int bo_x1 = bo_bar + int(math.round(float(max_profile_width) * i_bo_hist_offset_mult))
            float bo_anchor = render_px
            f_render_dist_histogram_internal(ds, lbl_reg, bo_anchor, bo_mfe_win, render_side, bull_color, bo_x1, max_profile_width, lc_state, profile_label_size, stat_label_color, i_hist_start_pct, i_hist_end_pct, i_hist_pct_step, i_show_hist_bin_labels, str.lower(i_label_strategy), sp.name + "_bo_mfe")
            f_render_dist_histogram_internal(ds, lbl_reg, bo_anchor, bo_mae_win, -render_side, color.new(render_side == STL.SIDE_BULL ? bear_color : bull_color, 75), bo_x1, max_profile_width, lc_state, profile_label_size, stat_label_color, i_hist_start_pct, i_hist_end_pct, i_hist_pct_step, i_show_hist_bin_labels, str.lower(i_label_strategy), sp.name + "_bo_mae")

    // 6. Time Distribution
    if i_show_time_dist and st.ref_set and not na(st.or_start_bar)
        int time_data_dur = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
        if time_data_dur > 0
            float bars_per_min = 1.0 / float(tf_min)
            // Calculate base_y to be below the Bear Price Histogram if it's shown
            float bear_mfe_p90 = array.size(mfe_s) > 0 ? array.percentile_nearest_rank(mfe_s, 90) : 0.0
            float hist_offset = (bear_mfe_p90 / 100.0) * st.or_low
            float base_y = st.or_low - hist_offset - syminfo.mintick * float(i_time_offset_ticks)
            int num_bins = int(math.ceil(float(time_data_dur) / float(i_time_bucket_mins)))
            int max_t_count = 1
            array<int> bull_cnt = array.new_int(num_bins, 0)
            array<int> bear_cnt = array.new_int(num_bins, 0)
            
            for bi = 0 to num_bins - 1
                int bs = bi * i_time_bucket_mins, be = bs + i_time_bucket_mins, cb = 0, cs = 0
                if array.size(hist.peak_time_bull) > 0
                    for j = 0 to array.size(hist.peak_time_bull) - 1
                        if array.get(hist.peak_time_bull, j) >= bs and array.get(hist.peak_time_bull, j) < be and array.get(hist.mfe_bull, j) > 0
                            cb += 1
                if array.size(hist.peak_time_bear) > 0
                    for j = 0 to array.size(hist.peak_time_bear) - 1
                        if array.get(hist.peak_time_bear, j) >= bs and array.get(hist.peak_time_bear, j) < be and array.get(hist.mfe_bear, j) > 0
                            cs += 1
                array.set(bull_cnt, bi, cb), array.set(bear_cnt, bi, cs)
                max_t_count := math.max(max_t_count, math.max(cb, cs))

            float prof_h = syminfo.mintick * float(i_time_offset_ticks) * 0.4
            float line_h = prof_h * 1.2
            
            int title_x = st.or_start_bar + int(float(time_data_dur / 2) * bars_per_min)
            Core.f_label_registry_push_ex(lbl_reg, base_y + syminfo.mintick * 80.0, sp.name + " Time Dist" + lb_sfx, color.new(time_title_color, 50), title_x, "off", 100, "", "down", profile_label_size, "Label", "", 0, lc_state)

            for bi = 0 to num_bins - 1
                int x_l = st.or_start_bar + int(float(bi * i_time_bucket_mins) * bars_per_min)
                int x_r = x_l + math.max(1, int(float(i_time_bucket_mins) * bars_per_min))
                int cb = array.get(bull_cnt, bi), cs = array.get(bear_cnt, bi)
                if cb > 0
                    float h = float(cb) / float(max_t_count) * prof_h
                    Zones.f_draw_time_bar(ds, x_l, x_r, base_y + h, base_y, color.new(bull_color, 80))
                if cs > 0
                    float h = float(cs) / float(max_t_count) * prof_h
                    Zones.f_draw_time_bar(ds, x_l, x_r, base_y, base_y - h, color.new(bear_color, 80))

            // Time Distribution Averages/Medians
            array<int> b_t_nz = array.new_int(0), s_t_nz = array.new_int(0)
            if array.size(hist.peak_time_bull) > 0
                for j = 0 to array.size(hist.peak_time_bull) - 1
                    if array.get(hist.mfe_bull, j) > 0
                        array.push(b_t_nz, array.get(hist.peak_time_bull, j))
            if array.size(hist.peak_time_bear) > 0
                for j = 0 to array.size(hist.peak_time_bear) - 1
                    if array.get(hist.mfe_bear, j) > 0
                        array.push(s_t_nz, array.get(hist.peak_time_bear, j))

            if array.size(b_t_nz) > 0
                float avg_t = array.avg(b_t_nz), med_t = array.median(b_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min), x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    Core.f_draw_vline(ds, x_avg, base_y + line_h, base_y, stat_avg_color, "Dashed", profile_line_width)
                    Core.f_label_registry_push_ex(lbl_reg, base_y + line_h, "Bull AVG" + lb_sfx, stat_avg_color, x_avg, str.lower(i_label_strategy), 40, sp.name + "_time_dist", "down", profile_label_size, "Label", "", 0, lc_state)
                if i_show_time_med
                    Core.f_draw_vline(ds, x_med, base_y + line_h * 0.8, base_y, stat_median_color, "Dashed", profile_line_width)
                    Core.f_label_registry_push_ex(lbl_reg, base_y + line_h * 0.8, "Bull MED" + lb_sfx, stat_median_color, x_med, str.lower(i_label_strategy), 35, sp.name + "_time_dist", "down", profile_label_size, "Label", "", 0, lc_state)

            if array.size(s_t_nz) > 0
                float avg_t = array.avg(s_t_nz), med_t = array.median(s_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min), x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    Core.f_draw_vline(ds, x_avg, base_y, base_y - line_h, stat_avg_color, "Dashed", profile_line_width)
                    Core.f_label_registry_push_ex(lbl_reg, base_y - line_h, "Bear AVG" + lb_sfx, stat_avg_color, x_avg, str.lower(i_label_strategy), 40, sp.name + "_time_dist", "up", profile_label_size, "Label", "", 0, lc_state)
                if i_show_time_med
                    Core.f_draw_vline(ds, x_med, base_y, base_y - line_h * 0.8, stat_median_color, "Dashed", profile_line_width)
                    Core.f_label_registry_push_ex(lbl_reg, base_y - line_h * 0.8, "Bear MED" + lb_sfx, stat_median_color, x_med, str.lower(i_label_strategy), 35, sp.name + "_time_dist", "up", profile_label_size, "Label", "", 0, lc_state)

    // Label registry will be flushed by the caller (f_render_range) to ensure all session instances are staggered together

f_render_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)
    Core.PineDrawingState ds = array.get(drawings, idx)

    Core.f_clear_all(ds)
    string profile_label_size = Core.f_display_profile_label_size(i_label_size, i_display_profile)
    Core.LabelRegistry lbl_reg = Core.f_label_registry_begin()

    // Render current session
    f_render_session_instance(idx, sp, st, hist, ds, lbl_reg)

    float merge_thr_manual = syminfo.mintick * float(i_label_merge_threshold_ticks)
    float merge_thr_auto = Core.f_merge_threshold_for_symbol(syminfo.ticker, syminfo.mintick)
    float merge_thr = math.max(merge_thr_manual, merge_thr_auto)
    Core.f_label_registry_flush(ds, lbl_reg, merge_thr, profile_label_size, i_label_stagger_bars)

if barstate.islast and array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_render_range(i)
        
    // Final diagnostic summary
    for i = 0 to array.size(specs) - 1
        RSL.RangeSpec sp = array.get(specs, i)
        STL.ExcursionHistory hist = array.get(histories, i)
        // HARM DEBUG: Session classification breakdown
        int sig_n = array.size(hist.sig_side)
        int bull_trig = 0, bear_trig = 0, bull_win = 0, bear_win = 0, bull_loss = 0, bear_loss = 0, bull_fake = 0, bear_fake = 0, bull_pend = 0, bear_pend = 0
        if sig_n > 0
            for j = 0 to sig_n - 1
                int s = array.get(hist.sig_side, j)
                int o = array.get(hist.sig_outcome, j)
                if s == 1
                    bull_trig += 1
                    if o == 1
                        bull_win += 1
                    else if o == -1
                        bull_loss += 1
                    else if o == 2
                        bull_fake += 1
                    else
                        bull_pend += 1
                else if s == -1
                    bear_trig += 1
                    if o == 1
                        bear_win += 1
                    else if o == -1
                        bear_loss += 1
                    else if o == 2
                        bear_fake += 1
                    else
                        bear_pend += 1
        log.info("HARM_CLASSIFY [{0}] N={1} | Bull: trig={2} win={3} loss={4} fake={5} pend={6} | Bear: trig={7} win={8} loss={9} fake={10} pend={11} | Total: win={12} fail={13} pend={14}", sp.name, sig_n, bull_trig, bull_win, bull_loss, bull_fake, bull_pend, bear_trig, bear_win, bear_loss, bear_fake, bear_pend, bull_win + bear_win, bull_loss + bear_loss + bull_fake + bear_fake, bull_pend + bear_pend)

// ============================================================================
// Tables
// ============================================================================

f_focus_idx() =>
    int focus = array.size(specs) > 0 ? array.size(specs) - 1 : 0
    if array.size(specs) > 0
        for i = 0 to array.size(specs) - 1
            RSL.RangeSpec sp = array.get(specs, i)
            RSL.RangeState st = array.get(states, i)
            bool in_or = f_in_session_pine_robust(sp.session_or, sp.tz, time)
            bool in_data = f_in_session_pine_robust(sp.session_data, sp.tz, time)
            if in_or or in_data or st.or_building
                focus := i
                break
    focus

// ----------------------------------------------------------------------------
// Combined Summary Table (includes UP/DOWN breakdown, streaks, after-streak,
// rolling windows). 3-column layout: Metric | UP | DOWN.
// ----------------------------------------------------------------------------

// Helper: draw section header row spanning all 3 columns
f_summary_section_header(table t, int row, string title, color bg, color fg, string hdr_sz) =>
    Tables.f_draw_header_cell(t, 0, row, title, color.new(bg, 80), fg, hdr_sz, 3, text.align_center)

// Helper: draw a row with metric label (col 0) and aggregate value spanning cols 1-2
f_summary_aggregate_row(table t, int row, string label, string value, color label_bg, color label_fg, color value_fg, string cell_sz) =>
    Tables.f_draw_value_cell(t, 0, row, label, label_bg, label_fg, cell_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 1, row, value, label_bg, value_fg, cell_sz, 2, text.align_left)

// Helper: draw a row with metric label (col 0), UP value (col 1), DOWN value (col 2)
f_summary_split_row(table t, int row, string label, string up_val, string down_val, color bg, color label_fg, color up_fg, color down_fg, string cell_sz) =>
    Tables.f_draw_value_cell(t, 0, row, label, bg, label_fg, cell_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 1, row, up_val, bg, up_fg, cell_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 2, row, down_val, bg, down_fg, cell_sz, 1, text.align_left)

f_draw_summary_table(int idx, string pos, color bg, color border, color header_bg, color header_txt, color body_txt, color bull_clr, color bear_clr, string hdr_sz, string body_sz) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    // Unified Signal Statistics
    int sig_n = array.size(hist.sig_side)
    int sig_bull_trig = 0
    int sig_bear_trig = 0
    int sig_bull_wins = 0
    int sig_bear_wins = 0
    int sig_bull_losses = 0
    int sig_bear_losses = 0
    array<bool> sig_bull_win_bools = array.new_bool(0)
    array<bool> sig_bear_win_bools = array.new_bool(0)
    array<bool> sig_ag_win_bools   = array.new_bool(0)

    if sig_n > 0
        for i = 0 to sig_n - 1
            int s = array.get(hist.sig_side, i)
            int o = array.get(hist.sig_outcome, i)
            if s == 1
                sig_bull_trig += 1
                if o != 0
                    array.push(sig_bull_win_bools, o == 1)
                    if o == 1
                        sig_bull_wins += 1
                    else
                        sig_bull_losses += 1
            else if s == -1
                sig_bear_trig += 1
                if o != 0
                    array.push(sig_bear_win_bools, o == 1)
                    if o == 1
                        sig_bear_wins += 1
                    else
                        sig_bear_losses += 1
                
            // Aggregated chronological signal series
            if s != 0 and o != 0
                array.push(sig_ag_win_bools, o == 1)
                
    // log.info("TABLE STATS - {0} | Total Hist: {1} | Bull Trig/Win: {2}/{3} | Bear Trig/Win: {4}/{5} | Aggr Count: {6}", sp.name, sig_n, sig_bull_trig, sig_bull_wins, sig_bear_trig, sig_bear_wins, array.size(sig_ag_win_bools))

    float bull_rate = sig_bull_trig > 0 ? (float(sig_bull_wins) / float(sig_bull_trig)) * 100.0 : na
    float bear_rate = sig_bear_trig > 0 ? (float(sig_bear_wins) / float(sig_bear_trig)) * 100.0 : na

    int n_total_signals = array.size(sig_ag_win_bools)

    array<float> bo_mfe_b_wins = STL.f_filter_breakout_wins(hist.bo_mfe_bull, hist.sig_side, hist.sig_outcome, 1)
    array<float> bo_mfe_s_wins = STL.f_filter_breakout_wins(hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, -1)

    // Streak stats — 3 scopes: UP Signal, DOWN Signal, Aggregated Signals
    [cs_up, cw_up, bw_up, wf_up, aw_up, af_up] = STL.f_streak_stats(sig_bull_win_bools)
    [cs_dn, cw_dn, bw_dn, wf_dn, aw_dn, af_dn] = STL.f_streak_stats(sig_bear_win_bools)
    [cs_ag, cw_ag, bw_ag, wf_ag, aw_ag, af_ag] = STL.f_streak_stats(sig_ag_win_bools)

    // After-streak probabilities (on aggregated signals)
    float p_f1 = STL.f_prob_after_streak(sig_ag_win_bools, false, 1)
    float p_f2 = STL.f_prob_after_streak(sig_ag_win_bools, false, 2)
    float p_f3 = STL.f_prob_after_streak(sig_ag_win_bools, false, 3)
    float p_w1 = STL.f_prob_after_streak(sig_ag_win_bools, true, 1)
    float p_w2 = STL.f_prob_after_streak(sig_ag_win_bools, true, 2)
    float p_w3 = STL.f_prob_after_streak(sig_ag_win_bools, true, 3)

    // Rolling win rates (UP | DOWN | Aggregated)
    float r5_up  = STL.f_rolling_win_rate(sig_bull_win_bools, 5)
    float r5_dn  = STL.f_rolling_win_rate(sig_bear_win_bools, 5)
    float r5_ag  = STL.f_rolling_win_rate(sig_ag_win_bools, 5)
    float r10_up = STL.f_rolling_win_rate(sig_bull_win_bools, 10)
    float r10_dn = STL.f_rolling_win_rate(sig_bear_win_bools, 10)
    float r10_ag = STL.f_rolling_win_rate(sig_ag_win_bools, 10)
    float r20_up = STL.f_rolling_win_rate(sig_bull_win_bools, 20)
    float r20_dn = STL.f_rolling_win_rate(sig_bear_win_bools, 20)
    float r20_ag = STL.f_rolling_win_rate(sig_ag_win_bools, 20)

    // Table size: header(1) + SUMMARY(12) + LIVE(7) + STREAKS_UP(6) + STREAKS_DN(6) + STREAKS_AGG(6) + FRONTRUN(6) + AFTER(7) + ROLLING(4) = ~60 rows
    int n_rows = 70
    int n_cols = 3
    table t = Tables.f_new_table(pos, n_cols, n_rows, color.new(bg, 90), color.new(border, 75), 1)
    color cell_bg = color.new(bg, 85)
    color section_bg = color.new(header_bg, 90)

    int r = 0

    // Title row (spans 3 cols)
    Tables.f_draw_header_cell(t, 0, r, "♦ " + sp.name + " ♦", color.new(header_bg, 70), header_txt, hdr_sz, 3, text.align_center)
    r += 1

    // ====== SUMMARY section (directional split) ======
    f_summary_section_header(t, r, "♦ SUMMARY ♦", header_bg, header_txt, hdr_sz)
    r += 1
    Tables.f_draw_header_cell(t, 0, r, "Metric", cell_bg, header_txt, body_sz, 1, text.align_left)
    Tables.f_draw_header_cell(t, 1, r, "↑ UP", cell_bg, bull_clr, body_sz, 1, text.align_center)
    Tables.f_draw_header_cell(t, 2, r, "↓ DOWN", cell_bg, bear_clr, body_sz, 1, text.align_center)
    r += 1
    f_summary_split_row(t, r, "› Signal Trig", str.tostring(sig_bull_trig), str.tostring(sig_bear_trig), cell_bg, body_txt, body_txt, body_txt, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Signal Win", str.tostring(sig_bull_wins), str.tostring(sig_bear_wins), cell_bg, body_txt, bull_clr, bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Signal Loss", str.tostring(sig_bull_losses), str.tostring(sig_bear_losses), cell_bg, body_txt, bear_clr, bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Signal Rate", STL.f_pct_fmt(bull_rate), STL.f_pct_fmt(bear_rate), cell_bg, body_txt, not na(bull_rate) and bull_rate >= 50 ? bull_clr : bear_clr, not na(bear_rate) and bear_rate >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› p20 MFE %", STL.f_pct_fmt(array.size(bo_mfe_b_wins) > 0 ? array.percentile_nearest_rank(bo_mfe_b_wins, 20) : na), STL.f_pct_fmt(array.size(bo_mfe_s_wins) > 0 ? array.percentile_nearest_rank(bo_mfe_s_wins, 20) : na), cell_bg, body_txt, bull_clr, bull_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› p50 MFE %", STL.f_pct_fmt(array.size(bo_mfe_b_wins) > 0 ? array.percentile_nearest_rank(bo_mfe_b_wins, 50) : na), STL.f_pct_fmt(array.size(bo_mfe_s_wins) > 0 ? array.percentile_nearest_rank(bo_mfe_s_wins, 50) : na), cell_bg, body_txt, bull_clr, bull_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› p75 MFE %", STL.f_pct_fmt(array.size(bo_mfe_b_wins) > 0 ? array.percentile_nearest_rank(bo_mfe_b_wins, 75) : na), STL.f_pct_fmt(array.size(bo_mfe_s_wins) > 0 ? array.percentile_nearest_rank(bo_mfe_s_wins, 75) : na), cell_bg, body_txt, bull_clr, bull_clr, body_sz)
    r += 1
    r += 1
    f_summary_split_row(t, r, "› p50 MAE %", STL.f_pct_fmt(array.size(hist.mae_bull_abs) > 0 ? array.percentile_nearest_rank(hist.mae_bull_abs, 50) : na), STL.f_pct_fmt(array.size(hist.mae_bear_abs) > 0 ? array.percentile_nearest_rank(hist.mae_bear_abs, 50) : na), cell_bg, body_txt, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› N (sessions)", str.tostring(n_total_signals), cell_bg, body_txt, body_txt, body_sz)
    r += 1

    // ====== LIVE SESSION section ======
    f_summary_section_header(t, r, "♦ LIVE SESSION ♦", header_bg, header_txt, hdr_sz)
    r += 1
    string status_txt = st.or_building ? "Building" : st.or_complete ? "Active" : "Wait"
    f_summary_aggregate_row(t, r, "› Status", status_txt, cell_bg, body_txt, body_txt, body_sz)
    r += 1
    int live_side = st.sig_side
    string bearing_txt = live_side == STL.SIDE_BULL ? "UP" : live_side == STL.SIDE_BEAR ? "DOWN" : "NEUTRAL"
    color bearing_clr = live_side == STL.SIDE_BULL ? bull_clr : live_side == STL.SIDE_BEAR ? bear_clr : body_txt
    f_summary_aggregate_row(t, r, "› Sig Side", bearing_txt, cell_bg, body_txt, bearing_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› FR Zone", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› FR Price", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    // Fix: Result now reflects verified classification (sig_outcome) instead of session MFE vs EV target.
    bool is_full = st.sig_outcome == 1
    string res_txt = st.sig_outcome == -1 ? "FAILED" : is_full ? "FULL" : "PENDING"
    color res_clr = is_full ? bull_clr : st.sig_outcome == -1 ? bear_clr : body_txt
    f_summary_aggregate_row(t, r, "› Result", res_txt, cell_bg, body_txt, res_clr, body_sz)
    r += 1
    float entry_px = st.sig_breakout_px
    string entry_txt = na(entry_px) ? "---" : str.tostring(entry_px, format.mintick)
    f_summary_aggregate_row(t, r, "› BO Price", entry_txt, cell_bg, body_txt, body_txt, body_sz)
    r += 1

    // ====== STREAKS (UP | DN) ======
    f_summary_section_header(t, r, "♦ STREAKS (UP | DN) ♦", header_bg, header_txt, hdr_sz)
    r += 1
    string cur_up_txt = str.tostring(cs_up) + (cw_up ? " Full" : " Fail")
    color cur_up_clr = cw_up ? bull_clr : bear_clr
    string cur_dn_txt = str.tostring(cs_dn) + (cw_dn ? " Full" : " Fail")
    color cur_dn_clr = cw_dn ? bull_clr : bear_clr
    f_summary_split_row(t, r, "› Current", cur_up_txt, cur_dn_txt, cell_bg, body_txt, cur_up_clr, cur_dn_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Best Full Run", str.tostring(bw_up), str.tostring(bw_dn), cell_bg, body_txt, bull_clr, bull_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Worst Fail Run", str.tostring(wf_up), str.tostring(wf_dn), cell_bg, body_txt, bear_clr, bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Avg Full Run", str.tostring(aw_up, "#.#"), str.tostring(aw_dn, "#.#"), cell_bg, body_txt, bull_clr, bull_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Avg Fail Run", str.tostring(af_up, "#.#"), str.tostring(af_dn, "#.#"), cell_bg, body_txt, bear_clr, bear_clr, body_sz)
    r += 1

    // ====== STREAKS — AGGREGATE ======
    f_summary_section_header(t, r, "♦ STREAKS — AGGREGATE ♦", header_bg, header_txt, hdr_sz)
    r += 1
    string cur_ag_txt = str.tostring(cs_ag) + (cw_ag ? " Full" : " Failed")
    color cur_ag_clr = cw_ag ? bull_clr : bear_clr
    f_summary_aggregate_row(t, r, "› Current", cur_ag_txt, cell_bg, body_txt, cur_ag_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Best Full Run", str.tostring(bw_ag), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Worst Fail Run", str.tostring(wf_ag), cell_bg, body_txt, bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Full Run", str.tostring(aw_ag, "#.#"), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Fail Run", str.tostring(af_ag, "#.#"), cell_bg, body_txt, bear_clr, body_sz)
    r += 1

    // ====== FRONT RUN (placeholder) ======
    f_summary_section_header(t, r, "♦ FRONT RUN ♦", header_bg, header_txt, hdr_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Current", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Best Full Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Worst Fail Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Full Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Fail Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1

    // ====== AFTER STREAK (aggregate on combined wins) ======
    f_summary_section_header(t, r, "♦ AFTER STREAK ♦", header_bg, header_txt, hdr_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 1 Fail", STL.f_pct_fmt(p_f1) + " nxt Full", cell_bg, body_txt, not na(p_f1) and p_f1 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 2 Fail", STL.f_pct_fmt(p_f2) + " nxt Full", cell_bg, body_txt, not na(p_f2) and p_f2 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 3+ Fail", STL.f_pct_fmt(p_f3) + " nxt Full", cell_bg, body_txt, not na(p_f3) and p_f3 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 1 Full", STL.f_pct_fmt(p_w1) + " nxt Full", cell_bg, body_txt, not na(p_w1) and p_w1 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 2 Full", STL.f_pct_fmt(p_w2) + " nxt Full", cell_bg, body_txt, not na(p_w2) and p_w2 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 3+ Full", STL.f_pct_fmt(p_w3) + " nxt Full", cell_bg, body_txt, not na(p_w3) and p_w3 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1

    // ====== ROLLING (UP | DOWN | Combined) ======
    f_summary_section_header(t, r, "♦ ROLLING (Full %) ♦", header_bg, header_txt, hdr_sz)
    r += 1
    Tables.f_draw_header_cell(t, 0, r, "Window", cell_bg, header_txt, body_sz, 1, text.align_left)
    Tables.f_draw_header_cell(t, 1, r, "UP", cell_bg, bull_clr, body_sz, 1, text.align_center)
    Tables.f_draw_header_cell(t, 2, r, "DOWN", cell_bg, bear_clr, body_sz, 1, text.align_center)
    r += 1
    f_summary_split_row(t, r, "› Last 5", STL.f_pct_fmt(r5_up), STL.f_pct_fmt(r5_dn), cell_bg, body_txt, not na(r5_up) and r5_up >= 50 ? bull_clr : bear_clr, not na(r5_dn) and r5_dn >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Last 10", STL.f_pct_fmt(r10_up), STL.f_pct_fmt(r10_dn), cell_bg, body_txt, not na(r10_up) and r10_up >= 50 ? bull_clr : bear_clr, not na(r10_dn) and r10_dn >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Last 20", STL.f_pct_fmt(r20_up), STL.f_pct_fmt(r20_dn), cell_bg, body_txt, not na(r20_up) and r20_up >= 50 ? bull_clr : bear_clr, not na(r20_dn) and r20_dn >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    // Combined row spanning cols 1-2
    Tables.f_draw_value_cell(t, 0, r, "› Combined 5/10/20", cell_bg, body_txt, body_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 1, r, STL.f_pct_fmt(r5_ag) + " / " + STL.f_pct_fmt(r10_ag) + " / " + STL.f_pct_fmt(r20_ag), cell_bg, body_txt, body_sz, 2, text.align_center)

// ----------------------------------------------------------------------------
// DOW Diagnostic — MFE/MAE percentiles per weekday, split by direction (▲/▼)
// ----------------------------------------------------------------------------

f_draw_dow_table(int idx, string pos, color bg, color border, color header_bg, color header_txt, color body_txt, color bull_clr, color bear_clr, string hdr_sz, string body_sz) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    // Layout: 7 cols (Metric | SUN..FRI). Rows: Title(1) + ColHeader(1) + 8 metrics = 10 rows
    int n_cols = 7
    int n_rows = 10
    table t = Tables.f_new_table(pos, n_cols, n_rows, color.new(bg, 90), color.new(border, 75), 1)
    color cell_bg = color.new(bg, 85)

    int r = 0
    // Title spans 7 cols
    Tables.f_draw_header_cell(t, 0, r, "♦ " + sp.name + " — DAY OF WEEK ♦", color.new(header_bg, 70), header_txt, hdr_sz, 7, text.align_center)
    r += 1

    // Column headers: METRIC | SUN | MON | TUE | WED | THU | FRI
    Tables.f_draw_header_cell(t, 0, r, "METRIC", color.new(header_bg, 80), header_txt, body_sz, 1, text.align_left)
    array<string> dow_labels = array.from("SUN", "MON", "TUE", "WED", "THU", "FRI")
    for d_idx = 0 to 5
        Tables.f_draw_header_cell(t, d_idx + 1, r, array.get(dow_labels, d_idx), color.new(header_bg, 80), header_txt, body_sz, 1, text.align_center)
    r += 1

    // Single-pass data aggregation for O(N) performance
    array<float> mfe_bucket_sun = array.new_float(0), mfe_bucket_mon = array.new_float(0), mfe_bucket_tue = array.new_float(0), mfe_bucket_wed = array.new_float(0), mfe_bucket_thu = array.new_float(0), mfe_bucket_fri = array.new_float(0)
    array<float> mae_bucket_sun = array.new_float(0), mae_bucket_mon = array.new_float(0), mae_bucket_tue = array.new_float(0), mae_bucket_wed = array.new_float(0), mae_bucket_thu = array.new_float(0), mae_bucket_fri = array.new_float(0)
    
    array<int> win_cnt = array.new_int(6, 0), tot_cnt = array.new_int(6, 0)

    int n_all = array.size(hist.dow)
    if n_all > 0
        for i = 0 to n_all - 1
            int d = array.get(hist.dow, i)
            int di = d - 1 // 1=SUN -> 0, 6=FRI -> 5
            if di < 0 or di > 5
                continue
            
            // MFE (using Breakout MFE with Session MFE fallback for historical compatibility)
            float mfe_b_raw = array.get(hist.bo_mfe_bull, i)
            float mfe_b = nz(mfe_b_raw, array.get(hist.sig_side, i) == 1 ? array.get(hist.mfe_bull, i) : na)
            float mfe_s_raw = array.get(hist.bo_mfe_bear, i)
            float mfe_s = nz(mfe_s_raw, array.get(hist.sig_side, i) == -1 ? array.get(hist.mfe_bear, i) : na)
            
            float mfe_val = na
            if not na(mfe_b)
                mfe_val := mfe_b
            else if not na(mfe_s)
                mfe_val := mfe_s
            else if array.get(hist.sig_side, i) == 1
                mfe_val := array.get(hist.mfe_bull, i)
            else if array.get(hist.sig_side, i) == -1
                mfe_val := array.get(hist.mfe_bear, i)

            if not na(mfe_val)
                array<float> b = di == 0 ? mfe_bucket_sun : di == 1 ? mfe_bucket_mon : di == 2 ? mfe_bucket_tue : di == 3 ? mfe_bucket_wed : di == 4 ? mfe_bucket_thu : mfe_bucket_fri
                array.push(b, mfe_val)
                array.set(tot_cnt, di, array.get(tot_cnt, di) + 1)
                if array.get(hist.sig_outcome, i) == 1
                    array.set(win_cnt, di, array.get(win_cnt, di) + 1)

            // MAE (Adverse MFE during trade)
            float mae_b_raw = array.get(hist.bo_mae_bull, i)
            float mae_b = nz(mae_b_raw, array.get(hist.sig_side, i) == 1 ? array.get(hist.mae_bull_abs, i) : na)
            float mae_s_raw = array.get(hist.bo_mae_bear, i)
            float mae_s = nz(mae_s_raw, array.get(hist.sig_side, i) == -1 ? array.get(hist.mae_bear_abs, i) : na)
            
            float mae_val = na
            if not na(mae_b)
                mae_val := mae_b
            else if not na(mae_s)
                mae_val := mae_s

            if not na(mae_val)
                array<float> b = di == 0 ? mae_bucket_sun : di == 1 ? mae_bucket_mon : di == 2 ? mae_bucket_tue : di == 3 ? mae_bucket_wed : di == 4 ? mae_bucket_thu : mae_bucket_fri
                array.push(b, mae_val)

    // Render Rows
    Tables.f_draw_value_cell(t, 0, r, "› N", cell_bg, body_txt, body_sz, 1, text.align_left)
    for di = 0 to 5
        Tables.f_draw_value_cell(t, di + 1, r, str.tostring(array.get(tot_cnt, di)), cell_bg, body_txt, body_sz, 1, text.align_center)
    r += 1
    
    Tables.f_draw_value_cell(t, 0, r, "› Full%", cell_bg, bull_clr, body_sz, 1, text.align_left)
    for di = 0 to 5
        float rate = array.get(tot_cnt, di) > 0 ? (float(array.get(win_cnt, di)) / float(array.get(tot_cnt, di))) * 100.0 : na
        Tables.f_draw_value_cell(t, di + 1, r, na(rate) ? "---" : str.tostring(rate, "#.#") + "%", cell_bg, not na(rate) and rate >= 50 ? bull_clr : bear_clr, body_sz, 1, text.align_center)
    r += 1

    // MAE Percentiles
    Tables.f_draw_value_cell(t, 0, r, "› p50 MAE", cell_bg, body_txt, "Tiny", 1, text.align_left)
    for di = 0 to 5
        array<float> arr = di == 0 ? mae_bucket_sun : di == 1 ? mae_bucket_mon : di == 2 ? mae_bucket_tue : di == 3 ? mae_bucket_wed : di == 4 ? mae_bucket_thu : mae_bucket_fri
        float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, 50) : na
        Tables.f_draw_value_cell(t, di + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, body_txt, "Tiny", 1, text.align_center)
    r += 1
    
    Tables.f_draw_value_cell(t, 0, r, "› p75 MAE", cell_bg, body_txt, "Tiny", 1, text.align_left)
    for di = 0 to 5
        array<float> arr = di == 0 ? mae_bucket_sun : di == 1 ? mae_bucket_mon : di == 2 ? mae_bucket_tue : di == 3 ? mae_bucket_wed : di == 4 ? mae_bucket_thu : mae_bucket_fri
        float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, 75) : na
        Tables.f_draw_value_cell(t, di + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, body_txt, "Tiny", 1, text.align_center)
    r += 1

    Tables.f_draw_value_cell(t, 0, r, "› p90 MAE", cell_bg, body_txt, "Tiny", 1, text.align_left)
    for di = 0 to 5
        array<float> arr = di == 0 ? mae_bucket_sun : di == 1 ? mae_bucket_mon : di == 2 ? mae_bucket_tue : di == 3 ? mae_bucket_wed : di == 4 ? mae_bucket_thu : mae_bucket_fri
        float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, 90) : na
        Tables.f_draw_value_cell(t, di + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, bear_clr, "Tiny", 1, text.align_center)
    r += 1

    // MFE Percentiles
    color mfe_clr = color.aqua
    Tables.f_draw_value_cell(t, 0, r, "› p25 MFE", cell_bg, body_txt, "Tiny", 1, text.align_left)
    for di = 0 to 5
        array<float> arr = di == 0 ? mfe_bucket_sun : di == 1 ? mfe_bucket_mon : di == 2 ? mfe_bucket_tue : di == 3 ? mfe_bucket_wed : di == 4 ? mfe_bucket_thu : mfe_bucket_fri
        float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, 25) : na
        Tables.f_draw_value_cell(t, di + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, mfe_clr, "Tiny", 1, text.align_center)
    r += 1

    Tables.f_draw_value_cell(t, 0, r, "› p50 MFE", cell_bg, body_txt, "Tiny", 1, text.align_left)
    for di = 0 to 5
        array<float> arr = di == 0 ? mfe_bucket_sun : di == 1 ? mfe_bucket_mon : di == 2 ? mfe_bucket_tue : di == 3 ? mfe_bucket_wed : di == 4 ? mfe_bucket_thu : mfe_bucket_fri
        float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, 50) : na
        Tables.f_draw_value_cell(t, di + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, mfe_clr, "Tiny", 1, text.align_center)
    r += 1

    Tables.f_draw_value_cell(t, 0, r, "› p75 MFE", cell_bg, body_txt, "Tiny", 1, text.align_left)
    for di = 0 to 5
        array<float> arr = di == 0 ? mfe_bucket_sun : di == 1 ? mfe_bucket_mon : di == 2 ? mfe_bucket_tue : di == 3 ? mfe_bucket_wed : di == 4 ? mfe_bucket_thu : mfe_bucket_fri
        float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, 75) : na
        Tables.f_draw_value_cell(t, di + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, mfe_clr, "Tiny", 1, text.align_center)
    r += 1


// ----------------------------------------------------------------------------
// Legacy table views: MFE / MAE / DOW (simple) / Fakeout
// ----------------------------------------------------------------------------

f_draw_legacy_table(int idx, string pos, color bg, color border, color header_bg, color header_txt, color body_txt, color bull_clr, color bear_clr, string view, string hdr_sz, string body_sz) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    if view == "MFE & MAE View"
        int n_cols_mfe = 9
        int n_rows_mfe = 4
        table t_mfe = Tables.f_new_table(pos, n_cols_mfe, n_rows_mfe, color.new(bg, 85), color.new(border, 70), 1)
        
        Tables.f_draw_header_cell(t_mfe, 0, 0, sp.name + " - MFE & MAE", h_bg, header_txt, hdr_sz, 9, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 0, 1, "Side", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 1, 1, "N", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 2, 1, "MFE p50", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 3, 1, "MFE p75", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 4, 1, "MFE p90", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 5, 1, "MAE p50", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 6, 1, "MAE p75", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 7, 1, "PB p50", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t_mfe, 8, 1, "R-Mult", h_bg, header_txt, hdr_sz, 1, text.align_center)
        
        array<float> bull = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear = STL.f_build_filtered(hist.mfe_bear)
        array<float> mab = STL.f_build_filtered(hist.mae_bull_abs)
        array<float> mas = STL.f_build_filtered(hist.mae_bear_abs)
        array<float> mpb = STL.f_build_filtered(hist.mae_bull_pb)
        array<float> mps = STL.f_build_filtered(hist.mae_bear_pb)
        
        float rb = array.size(hist.r_multiple_bull) > 0 ? array.avg(hist.r_multiple_bull) : na
        float rs = array.size(hist.r_multiple_bear) > 0 ? array.avg(hist.r_multiple_bear) : na
        
        // Bull Row
        Tables.f_draw_value_cell(t_mfe, 0, 2, "Bull", cell_bg, bull_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 1, 2, str.tostring(array.size(bull)), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 2, 2, STL.f_pct_fmt(array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 3, 2, STL.f_pct_fmt(array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 75) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 4, 2, STL.f_pct_fmt(array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 90) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 5, 2, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 6, 2, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 75) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 7, 2, STL.f_pct_fmt(array.size(mpb) > 0 ? array.percentile_nearest_rank(mpb, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 8, 2, na(rb) ? "n/a" : str.tostring(rb, "#.##"), cell_bg, body_txt, body_sz, 1, text.align_center)
        
        Tables.f_draw_value_cell(t_mfe, 0, 3, "Bear", cell_bg, bear_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 1, 3, str.tostring(array.size(bear)), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 2, 3, STL.f_pct_fmt(array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 3, 3, STL.f_pct_fmt(array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 75) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 4, 3, STL.f_pct_fmt(array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 90) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 5, 3, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 6, 3, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 75) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 7, 3, STL.f_pct_fmt(array.size(mps) > 0 ? array.percentile_nearest_rank(mps, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t_mfe, 8, 3, na(rs) ? "n/a" : str.tostring(rs, "#.##"), cell_bg, body_txt, body_sz, 1, text.align_center)
        
    else if view == "Fakeout View"
        int n_cols = 6
        int n_rows = 3
        table t = Tables.f_new_table(pos, n_cols, n_rows, color.new(bg, 85), color.new(border, 70), 1)
        
        Tables.f_draw_header_cell(t, 0, 0, sp.name + " - Fakeout View", color.new(header_bg, 70), header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 1, 0, "Count", color.new(header_bg, 70), header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 2, 0, "P50", color.new(header_bg, 70), header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 3, 0, "P75", color.new(header_bg, 70), header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 4, 0, "P90", color.new(header_bg, 70), header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 5, 0, "Rate", color.new(header_bg, 70), header_txt, hdr_sz, 1, text.align_center)
        
        array<float> fmb = STL.f_build_filtered_by_outcome(hist.bo_mfe_bull, hist.sig_side, hist.sig_outcome, 1, 2)
        array<float> fms = STL.f_build_filtered_by_outcome(hist.bo_mfe_bear, hist.sig_side, hist.sig_outcome, -1, 2)
        array<float> rfb = STL.f_build_filtered_by_outcome(hist.mae_bull_abs, hist.sig_side, hist.sig_outcome, 1, 2)
        array<float> rfs = STL.f_build_filtered_by_outcome(hist.mae_bear_abs, hist.sig_side, hist.sig_outcome, -1, 2)
        float b50 = array.size(fmb) > 0 ? array.percentile_nearest_rank(fmb, 50) : na
        float b75 = array.size(fmb) > 0 ? array.percentile_nearest_rank(fmb, 75) : na
        float s50 = array.size(fms) > 0 ? array.percentile_nearest_rank(fms, 50) : na
        float s75 = array.size(fms) > 0 ? array.percentile_nearest_rank(fms, 75) : na
        float rb50 = array.size(rfb) > 0 ? array.percentile_nearest_rank(rfb, 50) : na
        float rb90 = array.size(rfb) > 0 ? array.percentile_nearest_rank(rfb, 90) : na
        float rs50 = array.size(rfs) > 0 ? array.percentile_nearest_rank(rfs, 50) : na
        float rs90 = array.size(rfs) > 0 ? array.percentile_nearest_rank(rfs, 90) : na
        float dbr = STL.f_double_break_rate(hist.double_break, hist.entry_triggered_bull, hist.entry_triggered_bear)
        
        Tables.f_draw_value_cell(t, 0, 1, "Bull Fake", cell_bg, bull_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 1, STL.f_pct_fmt(b50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 1, STL.f_pct_fmt(b75), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 1, STL.f_pct_fmt(rb50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 1, STL.f_pct_fmt(rb90), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 1, STL.f_pct_fmt(dbr), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 0, 2, "Bear Fake", cell_bg, bear_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 2, STL.f_pct_fmt(s50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 2, STL.f_pct_fmt(s75), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 2, STL.f_pct_fmt(rs50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 2, STL.f_pct_fmt(rs90), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 2, STL.f_pct_fmt(dbr), cell_bg, body_txt, body_sz, 1, text.align_center)


// ----------------------------------------------------------------------------
// Table dispatcher
// ----------------------------------------------------------------------------

if barstate.islast and i_show_table and array.size(specs) > 0
    int idx = f_focus_idx()
    string pos_resolved = Tables.f_table_pos(i_table_pos)

    if i_table_view == "Summary"
        f_draw_summary_table(idx, pos_resolved, table_bg_color_resolved, table_border_color_resolved, table_header_bg_color_resolved, table_header_text_color_resolved, table_body_text_color_resolved, table_bull_color, table_bear_color, r_tbl_hdr_size, r_tbl_body_size)
    else if i_table_view == "DOW Diagnostic"
        f_draw_dow_table(idx, pos_resolved, table_bg_color_resolved, table_border_color_resolved, table_header_bg_color_resolved, table_header_text_color_resolved, table_body_text_color_resolved, table_bull_color, table_bear_color, r_tbl_hdr_size, r_tbl_body_size)
    else
        f_draw_legacy_table(idx, pos_resolved, table_bg_color_resolved, table_border_color_resolved, table_header_bg_color_resolved, table_header_text_color_resolved, table_body_text_color_resolved, table_bull_color, table_bear_color, i_table_view, r_tbl_hdr_size, r_tbl_body_size)
