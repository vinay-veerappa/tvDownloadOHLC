//@version=6
library("PineDrawingTables", overlay=true)

// ============================================================================
// PineDrawingTables v4.0 — Dashboard & Metric Visualizers
// ============================================================================
// Depends on: PineDrawingCore/3 (internally v4.0)
// Purpose: Provides high-level table "genres" (Stats, Narrative Dashboard,
//          Hit Rate, Distribution, Outcome) per spec §9.1 through §9.5.
// ============================================================================

import vveerappa/PineDrawingCore/3 as Core

/// Resolve a table position string token to Pine position constant.
/// Delegates to Core token mapping ("Top Left", "Middle Center", etc.).
/// Parameters:
///   - s: Position string token
/// Returns: position.* constant
export f_table_pos(string s) =>
    Core.f_table_pos(s)

/// Create a table with semantic position resolution and standard styling inputs.
/// Parameters:
///   - pos_token: Position string token
///   - cols, rows: Table dimensions
///   - bg: Background color
///   - border_color: Border color
///   - border_width: Border width
export f_new_table(string pos_token, int cols, int rows, color bg, color border_color, int border_width) =>
    table.new(f_table_pos(pos_token), cols, rows, bgcolor=bg, border_color=border_color, border_width=border_width)

/// Render a header cell with specified styling. Supports column-spanning via merge_cells.
/// Parameters:
///   - t: Table object
///   - col, row: Cell coordinates
///   - text_value: Cell text
///   - bg: Background color
///   - text_color: Text color
///   - text_size: Size token ("Tiny", "Small", "Normal", "Large", "Huge")
///   - col_span: Column span (default 1 = no merge)
///   - text_halign: Text horizontal alignment (default text.align_center)
export f_draw_header_cell(table t, int col, int row, string text_value, color bg, color text_color, string text_size, int col_span = 1, string text_halign = text.align_center) =>
    table.cell(t, col, row, text_value, text_color=text_color, bgcolor=bg, text_size=Core.f_text_size(text_size), text_halign=text_halign)
    if col_span > 1
        table.merge_cells(t, col, row, col + col_span - 1, row)

/// Render a body/value cell with specified styling. Supports column-spanning via merge_cells.
/// Parameters:
///   - t: Table object
///   - col, row: Cell coordinates
///   - text_value: Cell text
///   - bg: Background color
///   - text_color: Text color
///   - text_size: Size token ("Tiny", "Small", "Normal", "Large", "Huge")
///   - col_span: Column span (default 1 = no merge)
///   - text_halign: Text horizontal alignment (default text.align_center)
export f_draw_value_cell(table t, int col, int row, string text_value, color bg, color text_color, string text_size, int col_span = 1, string text_halign = text.align_center) =>
    table.cell(t, col, row, text_value, text_color=text_color, bgcolor=bg, text_size=Core.f_text_size(text_size), text_halign=text_halign)
    if col_span > 1
        table.merge_cells(t, col, row, col + col_span - 1, row)

/// Render a key/value metric row (two-column layout: metric name | metric value).
/// Parameters:
///   - t: Table object
///   - row: Row index
///   - metric_name: Name/label text (column 0)
///   - metric_value: Value text (column 1)
///   - name_bg, value_bg: Background colors for each column
///   - name_color, value_color: Text colors for each column
///   - text_size: Size token ("Tiny", "Small", "Normal", "Large", "Huge")
export f_draw_metric_row(table t, int row, string metric_name, string metric_value, color name_bg, color value_bg, color name_color, color value_color, string text_size) =>
    f_draw_value_cell(t, 0, row, metric_name, name_bg, name_color, text_size, 1, text.align_left)
    f_draw_value_cell(t, 1, row, metric_value, value_bg, value_color, text_size, 1, text.align_left)

// ============================================================================
// Table Genres (Spec VISUAL_TEMPLATES §9)
// ============================================================================

// --- 9.1 Stats Table --------------------------------------------------------
// Position default: top_right

/// Draw a sub-header row for section dividers in a stats table.
/// Parameters:
///   - t: Table object
///   - col, row: Cell coordinates
///   - text_value: Sub-header text
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
///   - text_halign: Text alignment (default text.align_left)
export f_draw_stats_sub_header(table t, int col, int row, string text_value, string theme_mode = "Dark", string text_size = "Normal", string text_halign = text.align_left) =>
    color bg = Core.f_theme_color("header_bg", theme_mode)
    color fg = Core.f_theme_color("header_text", theme_mode)
    f_draw_value_cell(t, col, row, text_value, bg, fg, text_size, 1, text_halign)

/// Draw the header row for a stats table by populating col_names across the top.
/// Parameters:
///   - t: Table object
///   - row: Row index (typically 0)
///   - col_names: Array of column header texts
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
export f_draw_stats_header_row(table t, int row, array<string> col_names, string theme_mode = "Dark", string text_size = "Normal") =>
    color bg = Core.f_theme_color("header_bg", theme_mode)
    color fg = Core.f_theme_color("header_text", theme_mode)
    int n = array.size(col_names)
    if n > 0
        for i = 0 to n - 1
            f_draw_header_cell(t, i, row, array.get(col_names, i), bg, fg, text_size, 1, text.align_center)

// --- 9.2 Narrative Dashboard ------------------------------------------------
// Position default: top_left

/// Render a semantic status cell (validated / pending / skip).
/// Unknown tokens render in neutral colors.
/// Parameters:
///   - t: Table object
///   - col, row: Cell coordinates
///   - text_value: Cell text
///   - status_token: "validated", "pending", or "skip" (anything else → neutral)
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
export f_draw_narrative_status_cell(table t, int col, int row, string text_value, string status_token, string theme_mode = "Dark", string text_size = "Normal") =>
    color bg = switch status_token
        "validated" => Core.f_theme_color("validated_bg", theme_mode)
        "pending" => Core.f_theme_color("pending_bg", theme_mode)
        "skip" => Core.f_theme_color("skip_bg", theme_mode)
        => Core.f_theme_color("bg_secondary", theme_mode)
    color fg = switch status_token
        "validated" => Core.f_theme_color("validated_text", theme_mode)
        "pending" => Core.f_theme_color("pending_text", theme_mode)
        "skip" => Core.f_theme_color("skip_text", theme_mode)
        => Core.f_theme_color("text_secondary", theme_mode)
    f_draw_value_cell(t, col, row, text_value, bg, fg, text_size, 1, text.align_center)

/// Render a semantic bias cell with text colored by bias direction.
/// Parameters:
///   - t: Table object
///   - col, row: Cell coordinates
///   - text_value: Cell text
///   - bias_token: "bull", "bear", "neutral" (any palette color token)
///   - bg: Background color (caller supplies — usually bg_secondary or validated_bg)
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
export f_draw_narrative_bias_cell(table t, int col, int row, string text_value, string bias_token, color bg, string theme_mode = "Dark", string text_size = "Normal") =>
    color fg = Core.f_theme_color(bias_token, theme_mode)
    f_draw_value_cell(t, col, row, text_value, bg, fg, text_size, 1, text.align_center)

// --- 9.3 Hit Rate Table -----------------------------------------------------
// Position default: middle_right

/// Draw a hit-rate row: Level | Rate% | Count | Streak | Max Up | Max Down.
/// Rate is colored by threshold: >=high_threshold = bull, <low_threshold = bear, mid = caution.
/// Streak uses ↑/↓ glyphs colored bull/bear.
/// Parameters:
///   - t: Table object
///   - row: Row index
///   - level_name: Level label (column 0)
///   - rate_pct: Hit rate 0-100
///   - days_count: Number of days in sample
///   - streak_count: Positive = up streak, negative = down streak, 0 = none
///   - max_up, max_down: Max up/down counts in sample
///   - high_threshold, low_threshold: Rate cutoffs for color (defaults 60/40)
///   - header_bg: Row background (default bg_secondary)
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
export f_draw_hit_rate_row(table t, int row, string level_name, float rate_pct, int days_count, int streak_count, int max_up, int max_down, float high_threshold = 60.0, float low_threshold = 40.0, color header_bg = na, string theme_mode = "Dark", string text_size = "Normal") =>
    color rate_col = rate_pct >= high_threshold ? Core.f_theme_color("bull", theme_mode) : rate_pct < low_threshold ? Core.f_theme_color("bear", theme_mode) : Core.f_theme_color("caution", theme_mode)
    color streak_col = streak_count > 0 ? Core.f_theme_color("bull", theme_mode) : streak_count < 0 ? Core.f_theme_color("bear", theme_mode) : Core.f_theme_color("neutral", theme_mode)
    string streak_display = streak_count > 0 ? "↑" + str.tostring(streak_count) : streak_count < 0 ? "↓" + str.tostring(math.abs(streak_count)) : "-"
    
    color bg = na(header_bg) ? Core.f_theme_color("bg_secondary", theme_mode) : header_bg
    // C0: Level name
    f_draw_value_cell(t, 0, row, level_name, bg, Core.f_theme_color("text_primary", theme_mode), text_size, 1, text.align_left)
    // C1: Rate %
    f_draw_value_cell(t, 1, row, str.tostring(rate_pct, "#.0") + "%", bg, rate_col, text_size, 1, text.align_right)
    // C2: Count
    f_draw_value_cell(t, 2, row, str.tostring(days_count), bg, Core.f_theme_color("text_dim", theme_mode), text_size, 1, text.align_right)
    // C3: Streak
    f_draw_value_cell(t, 3, row, streak_display, bg, streak_col, text_size, 1, text.align_right)
    // C4/C5: Max Up/Down
    f_draw_value_cell(t, 4, row, str.tostring(max_up), bg, Core.f_theme_color("bull", theme_mode), text_size, 1, text.align_right)
    f_draw_value_cell(t, 5, row, str.tostring(max_down), bg, Core.f_theme_color("bear", theme_mode), text_size, 1, text.align_right)

// --- 9.4 Distribution Table -------------------------------------------------
// Position default: bottom_right
// Uses Core.f_unicode_bar for inline data viz.

/// Draw a bucket row: Range | Count | % | Unicode Bar.
/// Buckets in the auto-zone are highlighted with the confirm color.
/// Parameters:
///   - t: Table object
///   - row: Row index
///   - bucket_range: e.g., "10-20"
///   - count: Bucket count
///   - max_count: Max count in group (denominator for bar)
///   - pct: Bucket percentage (0-100)
///   - in_zone: Whether this bucket is inside the highlighted zone
///   - bg: Row background
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
export f_draw_distribution_bucket_row(table t, int row, string bucket_range, float count, float max_count, float pct, bool in_zone, color bg, string theme_mode = "Dark", string text_size = "Normal") =>
    color name_col = in_zone ? Core.f_theme_color("confirm", theme_mode) : Core.f_theme_color("text_primary", theme_mode)
    color pct_col = in_zone ? Core.f_theme_color("confirm", theme_mode) : Core.f_theme_color("text_dim", theme_mode)
    // Core.f_unicode_bar expects (cnt, max_cnt, max_width) and computes ratio internally
    string bar_str = Core.f_unicode_bar(count, max_count, 8)
    
    f_draw_value_cell(t, 0, row, bucket_range, bg, name_col, text_size, 1, text.align_left)
    f_draw_value_cell(t, 1, row, str.tostring(count, "#.##"), bg, Core.f_theme_color("text_primary", theme_mode), text_size, 1, text.align_right)
    f_draw_value_cell(t, 2, row, str.tostring(pct, "#.0") + "%", bg, pct_col, text_size, 1, text.align_right)
    f_draw_value_cell(t, 3, row, bar_str, bg, name_col, text_size, 1, text.align_left)

/// Draw a footer summary row for a grouped zone: "Zone: <Range>", sum count, % coverage.
/// Parameters:
///   - t: Table object
///   - row: Row index
///   - range_str: Zone range text (e.g., "30-60")
///   - total_count: Sum of counts in the zone
///   - zone_pct: Zone's percentage of total (0-100)
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
export f_draw_distribution_summary_row(table t, int row, string range_str, float total_count, float zone_pct, string theme_mode = "Dark", string text_size = "Normal") =>
    color bg = Core.f_theme_color("validated_bg", theme_mode)
    color fg = Core.f_theme_color("validated_text", theme_mode)
    f_draw_value_cell(t, 0, row, "Zone: " + range_str, bg, fg, text_size, 1, text.align_left)
    f_draw_value_cell(t, 1, row, str.tostring(total_count, "#.##"), bg, fg, text_size, 1, text.align_right)
    f_draw_value_cell(t, 2, row, str.tostring(zone_pct, "#.0") + "%", bg, fg, text_size, 1, text.align_right)
    f_draw_value_cell(t, 3, row, "", bg, fg, text_size, 1, text.align_left)

// --- 9.5 Outcome Table ------------------------------------------------------
// Position default: bottom_left

/// Draw a row in a wide multi-column cross-reference outcome table.
/// Parameters:
///   - t: Table object
///   - row: Row index
///   - outcome_name: Outcome label (column 0) — e.g., "Long True"
///   - outcome_bg, outcome_fg: Colors for outcome label cell
///   - target_values: Per-column numeric values
///   - target_colors: Per-column text colors (parallel to target_values)
///   - theme_mode: "Dark" or "Light"
///   - text_size: Size token (default "Normal")
export f_draw_outcome_target_row(table t, int row, string outcome_name, color outcome_bg, color outcome_fg, array<float> target_values, array<color> target_colors, string theme_mode = "Dark", string text_size = "Normal") =>
    color bg_sec = Core.f_theme_color("bg_secondary", theme_mode)
    f_draw_value_cell(t, 0, row, outcome_name, outcome_bg, outcome_fg, text_size, 1, text.align_left)
    if target_values.size() > 0
        int size = target_values.size()
        for i = 0 to size - 1
            float val = target_values.get(i)
            color tc = target_colors.get(i)
            f_draw_value_cell(t, i + 1, row, str.tostring(val, "#.##"), bg_sec, tc, text_size, 1, text.align_right)

// ============================================================================
// Canonical Table Wrappers (Spec §9 genres)
// ============================================================================

/// Stats Table wrapper (§9.1). Default position: top_right.
/// Parameters:
///   - pos_token: Position string token (default callers should use "Top Right")
///   - cols, rows: Table dimensions
///   - border_color: Border color
///   - border_width: Border width
///   - theme_mode: "Dark" or "Light"
export f_draw_stats_table(string pos_token, int cols, int rows, color border_color, int border_width, string theme_mode = "Dark") =>
    f_new_table(pos_token, cols, rows, Core.f_theme_color("bg_secondary", theme_mode), border_color, border_width)

/// Narrative Dashboard / Bias Table wrapper (§9.2). Default position: top_left.
/// Parameters:
///   - pos_token: Position string token
///   - cols, rows: Table dimensions
///   - border_color: Border color
///   - border_width: Border width
///   - theme_mode: "Dark" or "Light"
export f_draw_bias_table(string pos_token, int cols, int rows, color border_color, int border_width, string theme_mode = "Dark") =>
    f_new_table(pos_token, cols, rows, Core.f_theme_color("bg_primary", theme_mode), border_color, border_width)

/// Scenarios/Outcome Table wrapper (§9.5). Default position: bottom_left.
/// Parameters:
///   - pos_token: Position string token
///   - cols, rows: Table dimensions
///   - border_color: Border color
///   - border_width: Border width
///   - theme_mode: "Dark" or "Light"
export f_draw_scenarios_table(string pos_token, int cols, int rows, color border_color, int border_width, string theme_mode = "Dark") =>
    f_new_table(pos_token, cols, rows, Core.f_theme_color("bg_secondary", theme_mode), border_color, border_width)
