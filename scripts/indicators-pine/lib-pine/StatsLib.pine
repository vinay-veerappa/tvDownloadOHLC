//@version=6
library("StatsLib", overlay=true)
// Trade Outcome Constants
export const int OUTCOME_ANY     =  0
export const int OUTCOME_WIN     =  1
export const int OUTCOME_LOSS    = -1
export const int OUTCOME_FAKE    =  2
export const int OUTCOME_NON_WIN = -2

// Trade Side / Bias Constants
export const int SIDE_BULL       =  1
export const int SIDE_BEAR       = -1
export const int SIDE_NONE       =  0


export type ExcursionHistory
    string range_name
    array<float> mfe_bull
    array<float> mfe_bear
    array<float> bo_mfe_bull
    array<float> bo_mfe_bear
    array<int> peak_time_bull
    array<int> peak_time_bear
    array<float> mae_bull_abs
    array<float> mae_bear_abs
    array<float> mae_bull_pb
    array<float> mae_bear_pb
    array<float> bo_mae_bull
    array<float> bo_mae_bear
    array<bool> mid_hit_bull
    array<bool> mid_hit_bear
    array<float> or_range_pct
    array<int> dow
    array<float> r_multiple_bull
    array<float> r_multiple_bear
    array<bool> entry_triggered_bull
    array<bool> entry_triggered_bear
    array<bool> double_break
    array<int> sig_side        // Added in v4
    array<int> sig_outcome     // Added in v4

export f_new_excursion_history(string name) =>
    ExcursionHistory.new(
        name,
        array.new_float(0), array.new_float(0), array.new_float(0), array.new_float(0),
        array.new_int(0), array.new_int(0),
        array.new_float(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_float(0),
        array.new_bool(0), array.new_bool(0),
        array.new_float(0),
        array.new_int(0),
        array.new_float(0), array.new_float(0),
        array.new_bool(0), array.new_bool(0),
        array.new_bool(0),
        array.new_int(0), array.new_int(0)
    )

export f_build_filtered(array<float> src) =>
    array<float> out = array.new_float(0)
    if array.size(src) > 0
        for i = 0 to array.size(src) - 1
            float v = array.get(src, i)
            if not na(v) and v > 0 // Exclude non-excursions from distribution
                array.push(out, v)
    out
    
export f_build_filtered_by_outcome(array<float> src, array<int> side_hist, array<int> outcome_hist, int target_side, int target_outcome) =>
    array<float> out = array.new_float(0)
    int n = math.min(array.size(src), math.min(array.size(side_hist), array.size(outcome_hist)))
    int match_count = 0
    if n > 0
        int src_off = array.size(src) - n
        int side_off = array.size(side_hist) - n
        int outcome_off = array.size(outcome_hist) - n
        for i = 0 to n - 1
            float val = array.get(src, src_off + i)
            int s = array.get(side_hist, side_off + i)
            int o = array.get(outcome_hist, outcome_off + i)
            // Filter: Must match side, and (either match outcome OR target_outcome is OUTCOME_ANY OR target_outcome is OUTCOME_NON_WIN)
            bool side_match = s == target_side
            bool outcome_match = (target_outcome == OUTCOME_ANY) or (target_outcome == OUTCOME_NON_WIN and o != OUTCOME_WIN) or (o == target_outcome)
            if not na(val) and side_match and outcome_match
                array.push(out, val)
                match_count += 1
    
    if n == 0
        log.warning("STL FILTER - Empty arrays! src: {0}, side: {1}, out: {2}", array.size(src), array.size(side_hist), array.size(outcome_hist))
    out

export f_get_pct_fallback(array<float> arr, float pct, float def = 0.0) =>
    array.size(arr) > 0 ? array.percentile_nearest_rank(arr, pct) : def

export f_filter_breakout_wins(array<float> bo_data, array<int> sig_sides, array<int> sig_outcomes, int side) =>
    f_build_filtered_by_outcome(bo_data, sig_sides, sig_outcomes, side, OUTCOME_WIN)

export f_filter_breakout_all(array<float> bo_data, array<int> sig_sides, array<int> sig_outcomes, int side) =>
    f_build_filtered_by_outcome(bo_data, sig_sides, sig_outcomes, side, OUTCOME_ANY)

export f_filter_fakeout_mfe(array<float> bo_mfe_data, array<int> sig_sides, array<int> sig_outcomes, int side) =>
    f_build_filtered_by_outcome(bo_mfe_data, sig_sides, sig_outcomes, side, OUTCOME_FAKE)

export f_filter_fakeout_mae(array<float> mae_abs_data, array<int> sig_sides, array<int> sig_outcomes, int side) =>
    f_build_filtered_by_outcome(mae_abs_data, sig_sides, sig_outcomes, side, OUTCOME_FAKE)

// Now accepts a secondary session-wide fallback array to handle historical compatibility for newly added BO metrics.
export f_filter_tactical(array<float> bo_data, array<float> session_data, array<int> sig_sides, array<int> sig_outcomes, int side, int target_outcome) =>
    array<float> out_data = f_build_filtered_by_outcome(bo_data, sig_sides, sig_outcomes, side, target_outcome)
    // Hybrid logic: If breakout-specific data is sparse (< 20 samples), use session-wide data as the statistical base.
    if array.size(out_data) < 20
        out_data := f_build_filtered_by_outcome(session_data, sig_sides, sig_outcomes, side, target_outcome)
    out_data


export f_track_mfe(float bar_h, float bar_l, int bar_mins_since_or, float bull_ref, float bear_ref, float prev_bull_mfe, float prev_bear_mfe, int prev_bull_peak, int prev_bear_peak) =>
    float nb = prev_bull_mfe
    float ns = prev_bear_mfe
    int nbp = prev_bull_peak
    int nsp = prev_bear_peak
    if bar_h > bull_ref
        float ext_b = (bar_h - bull_ref) / bull_ref * 100.0
        if na(nb) or ext_b > nb
            nb := ext_b
            nbp := bar_mins_since_or
    if bar_l < bear_ref
        float ext_s = (bear_ref - bar_l) / bear_ref * 100.0
        if na(ns) or ext_s > ns
            ns := ext_s
            nsp := bar_mins_since_or
    //if not na(nb) and nb != prev_bull_mfe
        //log.info("STL MFE BULL UPDATE - Ref: {0}, H: {1}, New: {2}, Peak: {3}", bull_ref, bar_h, nb, nbp)
    //if not na(ns) and ns != prev_bear_mfe
        //log.info("STL MFE BEAR UPDATE - Ref: {0}, L: {1}, New: {2}, Peak: {3}", bear_ref, bar_l, ns, nsp)
    [nb, ns, nbp, nsp]

export f_track_mae_abs(float bar_h, float bar_l, float or_high, float or_low, float prev_bull_abs, float prev_bear_abs) =>
    // Adverse Excursion for Bull direction is how far price goes BELOW the entry boundary (OR High)
    float bull_ae = (or_high - bar_l) / or_high * 100.0
    // Adverse Excursion for Bear direction is how far price goes ABOVE the entry boundary (OR Low)
    float bear_ae = (bar_h - or_low) / or_low * 100.0
    
    float nb = (bull_ae > 0) ? (na(prev_bull_abs) ? bull_ae : math.max(prev_bull_abs, bull_ae)) : prev_bull_abs
    float ns = (bear_ae > 0) ? (na(prev_bear_abs) ? bear_ae : math.max(prev_bear_abs, bear_ae)) : prev_bear_abs
    
    //if not na(nb) and nb != prev_bull_abs
        //log.info("STL MAE ABS BULL UPDATE - Ref: {0}, L: {1}, New: {2}", or_high, bar_l, nb)
    //if not na(ns) and ns != prev_bear_abs
        //log.info("STL MAE ABS BEAR UPDATE - Ref: {0}, H: {1}, New: {2}", or_low, bar_h, ns)
    [nb, ns]

export f_track_mae_pullback(float bar_h, float bar_l, float or_high, float or_low, bool entry_triggered_bull, bool entry_triggered_bear, bool is_bull_peak, bool is_bear_peak, float bull_peak_price, float bear_peak_price, float prev_bull_pb, float prev_bear_pb) =>
    float bull_pb = (entry_triggered_bull and not na(bull_peak_price)) ? (bull_peak_price - bar_l) / or_high * 100.0 : na
    float bear_pb = (entry_triggered_bear and not na(bear_peak_price)) ? (bar_h - bear_peak_price) / or_low * 100.0 : na
    
    // Result variables initialized to previous values
    float nb = prev_bull_pb
    float ns = prev_bear_pb

    // Pullback for Bull direction: Measured from Peak High down to current Bar Low
    if entry_triggered_bull
        // We only update the max pullback if this is NOT a peak bar (at peak, pullback resets or is minimal)
        // and if the current bar's pullback is greater than the previous maximum.
        if not is_bull_peak and not na(bull_pb) and bull_pb > 0
            nb := na(prev_bull_pb) ? bull_pb : math.max(prev_bull_pb, bull_pb)
        
       // if not na(nb)
            //log.info("STL TRACK PB BULL - PeakPx: {0}, L: {1}, PB: {2}, Prev: {3}, New: {4}, Peak: {5}", bull_peak_price, bar_l, bull_pb, prev_bull_pb, nb, is_bull_peak)

    // Pullback for Bear direction: Measured from Peak Low up to current Bar High
    if entry_triggered_bear
        if not is_bear_peak and not na(bear_pb) and bear_pb > 0
            ns := na(prev_bear_pb) ? bear_pb : math.max(prev_bear_pb, bear_pb)

        //if not na(ns)
            //log.info("STL TRACK PB BEAR - PeakPx: {0}, H: {1}, PB: {2}, Prev: {3}, New: {4}, Peak: {5}", bear_peak_price, bar_h, bear_pb, prev_bear_pb, ns, is_bear_peak)

    [nb, ns]

export f_track_mid_hit(float bar_h, float bar_l, float or_mid, bool prev_bull_hit, bool prev_bear_hit) =>
    [prev_bull_hit or bar_h >= or_mid, prev_bear_hit or bar_l <= or_mid]


export f_compute_r_multiple(float mfe, float mae_abs) =>
    na(mae_abs) or mae_abs <= 0 ? na : mfe / mae_abs

export f_compute_mfe_efficiency(float mfe, float mae_abs) =>
    float den = mfe + mae_abs
    den <= 0 ? na : mfe / den

export f_classify_fakeout(bool trig_bull, bool trig_bear, float close_at_cutoff, float or_high, float or_low) =>
    bool fb = trig_bull and close_at_cutoff <= or_high
    bool fs = trig_bear and close_at_cutoff >= or_low
    [fb, fs, trig_bull and trig_bear]

export f_fakeout_reversal_depth(bool fakeout_bull, bool fakeout_bear, float session_low_data, float session_high_data, float or_high, float or_low) =>
    float rb = fakeout_bull ? math.max(0.0, (or_high - session_low_data) / or_high * 100.0) : na
    float rs = fakeout_bear ? math.max(0.0, (session_high_data - or_low) / or_low * 100.0) : na
    [rb, rs]

export f_conditional_prob(array<float> data, float lower_threshold, float upper_threshold) =>
    int lower_hits = 0
    int both_hits = 0
    if array.size(data) > 0
        for i = 0 to array.size(data) - 1
            float v = array.get(data, i)
            if v >= lower_threshold
                lower_hits += 1
                if v >= upper_threshold
                    both_hits += 1
    lower_hits == 0 ? na : (float(both_hits) / float(lower_hits)) * 100.0

export f_count_at_or_above(array<float> arr, float threshold) =>
    int c = 0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if array.get(arr, i) >= threshold
                c += 1
    c

export f_compute_streak(array<float> arr, float threshold) =>
    int streak = 0
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            if array.get(arr, i) >= threshold
                streak += 1
            else
                break
    streak

export f_compute_max_streak(array<float> arr, float threshold) =>
    int best = 0
    int cur = 0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if array.get(arr, i) >= threshold
                cur += 1
                best := math.max(best, cur)
            else
                cur := 0
    best

export f_double_break_rate(array<bool> double_break, array<bool> trig_bull, array<bool> trig_bear) =>
    int denom = 0
    int num = 0
    int n = math.min(array.size(double_break), math.min(array.size(trig_bull), array.size(trig_bear)))
    if n > 0
        for i = 0 to n - 1
            bool t = array.get(trig_bull, i) or array.get(trig_bear, i)
            if t
                denom += 1
                if array.get(double_break, i)
                    num += 1
    denom == 0 ? na : (float(num) / float(denom)) * 100.0




export f_commit_daily(
    ExcursionHistory hist,
    float bull_mfe,
    float bear_mfe,
    float bo_mfe_bull,
    float bo_mfe_bear,
    int bull_peak,
    int bear_peak,
    float mae_bull_abs,
    float mae_bear_abs,
    float mae_bull_pb,
    float mae_bear_pb,
    float bo_mae_bull,
    float bo_mae_bear,
    bool mid_hit_bull,
    bool mid_hit_bear,
    float or_high,
    float or_low,
    int dow,
    bool trig_bull,
    bool trig_bear,
    float close_at_cutoff,
    int sig_side = 0,
    int sig_outcome = 0
) =>
    float r_bull = f_compute_r_multiple(bull_mfe, mae_bull_abs)
    float r_bear = f_compute_r_multiple(bear_mfe, mae_bear_abs)
    int dir = bull_mfe > bear_mfe ? 1 : bear_mfe > bull_mfe ? -1 : 0
    array<float> bull_hist = f_build_filtered(hist.mfe_bull)
    array<float> bear_hist = f_build_filtered(hist.mfe_bear)
    float p50_bull = array.size(bull_hist) > 0 ? array.percentile_nearest_rank(bull_hist, 50) : na
    float p50_bear = array.size(bear_hist) > 0 ? array.percentile_nearest_rank(bear_hist, 50) : na
    [_, _, db] = f_classify_fakeout(trig_bull, trig_bear, close_at_cutoff, or_high, or_low)

    //log.info("STL COMMIT START - Range: {0} | MFE B/S: {1}/{2} | BO MFE B/S: {3}/{4} | MAE Abs B/S: {5}/{6} | PB B/S: {7}/{8} | Side: {9}, Outcome: {10}", hist.range_name, bull_mfe, bear_mfe, bo_mfe_bull, bo_mfe_bear, mae_bull_abs, mae_bear_abs, mae_bull_pb, mae_bear_pb, sig_side, sig_outcome)
    array.push(hist.mfe_bull, bull_mfe)
    array.push(hist.mfe_bear, bear_mfe)
    array.push(hist.bo_mfe_bull, bo_mfe_bull)
    array.push(hist.bo_mfe_bear, bo_mfe_bear)
    array.push(hist.peak_time_bull, bull_peak)
    array.push(hist.peak_time_bear, bear_peak)

    array.push(hist.mae_bull_abs, mae_bull_abs)
    array.push(hist.mae_bear_abs, mae_bear_abs)
    array.push(hist.mae_bull_pb, mae_bull_pb)
    array.push(hist.mae_bear_pb, mae_bear_pb)
    array.push(hist.bo_mae_bull, bo_mae_bull)
    array.push(hist.bo_mae_bear, bo_mae_bear)
    array.push(hist.mid_hit_bull, mid_hit_bull)
    array.push(hist.mid_hit_bear, mid_hit_bear)
    array.push(hist.or_range_pct, math.max(0.0, (or_high - or_low) / or_low * 100.0))
    array.push(hist.dow, dow)
    array.push(hist.r_multiple_bull, r_bull)
    array.push(hist.r_multiple_bear, r_bear)
    array.push(hist.entry_triggered_bull, trig_bull)
    array.push(hist.entry_triggered_bear, trig_bear)
    array.push(hist.double_break, db)
    array.push(hist.sig_side, sig_side)
    array.push(hist.sig_outcome, sig_outcome)

export f_day_full(int dow) =>
    switch dow
        1 => "SUN"
        2 => "MON"
        3 => "TUE"
        4 => "WED"
        5 => "THU"
        6 => "FRI"
        7 => "SAT"
        => ""

export f_pct_fmt(float v) =>
    na(v) ? "n/a" : str.tostring(v, "#.##") + "%"

// ============================================================================
// v3 Additions — Boolean-outcome streak and rolling-window statistics.
// These helpers are generic across indicators that track daily binary outcomes
// (win/fail, hit/miss, fired/skipped) and replace per-indicator implementations.
// ============================================================================

/// Compute comprehensive streak statistics from a boolean wins array.
/// Parameters:
///   - wins: chronological array of boolean outcomes (true = win, false = fail)
/// Returns tuple [current_streak, current_is_win, best_win_streak, worst_fail_streak, avg_win_streak, avg_fail_streak]
///   - current_streak: length of the streak at the end of the array
///   - current_is_win: whether that trailing streak is wins (true) or fails (false)
///   - best_win_streak: longest consecutive run of wins ever
///   - worst_fail_streak: longest consecutive run of fails ever
///   - avg_win_streak: mean length of all completed win streaks (includes final if present)
///   - avg_fail_streak: mean length of all completed fail streaks
/// Empty input returns all zeros with current_is_win=false.
export f_streak_stats(array<bool> wins) =>
    int n = array.size(wins)
    int current = 0
    bool current_is_win = false
    int best_win = 0
    int worst_fail = 0
    int total_win_streaks = 0
    int total_fail_streaks = 0
    int sum_win_streak = 0
    int sum_fail_streak = 0
    
    if n > 0
        bool prev = array.get(wins, 0)
        int cur_streak = 1
        if n > 1
            for i = 1 to n - 1
                bool val = array.get(wins, i)
                if val == prev
                    cur_streak += 1
                else
                    if prev
                        best_win := math.max(best_win, cur_streak)
                        total_win_streaks += 1
                        sum_win_streak += cur_streak
                    else
                        worst_fail := math.max(worst_fail, cur_streak)
                        total_fail_streaks += 1
                        sum_fail_streak += cur_streak
                    cur_streak := 1
                    prev := val
        
        // Final streak
        if prev
            best_win := math.max(best_win, cur_streak)
            total_win_streaks += 1
            sum_win_streak += cur_streak
        else
            worst_fail := math.max(worst_fail, cur_streak)
            total_fail_streaks += 1
            sum_fail_streak += cur_streak
        
        current := cur_streak
        current_is_win := prev

    float avg_win = total_win_streaks > 0 ? float(sum_win_streak) / float(total_win_streaks) : 0.0
    float avg_fail = total_fail_streaks > 0 ? float(sum_fail_streak) / float(total_fail_streaks) : 0.0
    [current, current_is_win, best_win, worst_fail, avg_win, avg_fail]

/// Conditional probability P(next = win | preceding N values = preceding_value).
/// Given a chronological boolean array, looks at every position where the
/// trailing streak_len entries all equal preceding_value, then reports how often
/// the entry after that sequence was a win.
/// Parameters:
///   - wins: chronological boolean outcomes array
///   - preceding_value: the value the preceding streak must equal (true or false)
///   - streak_len: how many consecutive entries must equal preceding_value
/// Returns: probability percentage (0-100), or na if no matching positions found.
export f_prob_after_streak(array<bool> wins, bool preceding_value, int streak_len) =>
    int n = array.size(wins)
    int count_condition = 0
    int count_success = 0
    if n > streak_len and streak_len >= 1
        for i = 0 to n - (streak_len + 1)
            bool match = true
            for j = 0 to streak_len - 1
                if array.get(wins, i + j) != preceding_value
                    match := false
                    break
            if match
                count_condition += 1
                if array.get(wins, i + streak_len) == true
                    count_success += 1
    count_condition == 0 ? na : (float(count_success) / float(count_condition)) * 100.0

/// Rolling win rate over the last N outcomes.
/// Parameters:
///   - wins: chronological boolean outcomes array
///   - window: look back at the last `window` entries
/// Returns: win rate percentage (0-100), or na if wins is empty or window <= 0.
/// If the array is shorter than window, computes over all available entries.
export f_rolling_win_rate(array<bool> wins, int window) =>
    int n = array.size(wins)
    float result = na
    if n > 0 and window > 0
        int start_idx = math.max(0, n - window)
        int count = n - start_idx
        int hits = 0
        for i = start_idx to n - 1
            if array.get(wins, i)
                hits += 1
        result := (float(hits) / float(count)) * 100.0
    result

/// Element-wise boolean OR of two parallel arrays (useful for combining per-direction
/// outcomes into a combined-outcome series). If array sizes differ, uses the minimum.
export f_combine_bool_or(array<bool> a, array<bool> b) =>
    array<bool> out = array.new_bool(0)
    int n = math.min(array.size(a), array.size(b))
    if n > 0
        for i = 0 to n - 1
            array.push(out, array.get(a, i) or array.get(b, i))
    out

/// Element-wise boolean AND of two parallel arrays (complementary to f_combine_bool_or).
export f_combine_bool_and(array<bool> a, array<bool> b) =>
    array<bool> out = array.new_bool(0)
    int n = math.min(array.size(a), array.size(b))
    if n > 0
        for i = 0 to n - 1
            array.push(out, array.get(a, i) and array.get(b, i))
    out
