    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + 2, strategy, 40, tag, lookback)

export f_draw_target_level_p75(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string qualifier = "", string basis = "", string value_str = "", string unit = "", string tag = "", int lookback = 0, string strategy = "merge") =>
    int width = tier == "P" ? 2 : 1
