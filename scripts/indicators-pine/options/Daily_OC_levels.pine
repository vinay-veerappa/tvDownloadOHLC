    bool        fib9
    float       fib9_level
    color       fib9_color
    string      fib9_style
    int         fib9_size

type fib
    float       level
    float       price
    color       color
    string      style
    int         size
    line        ln
    label       lbl
    linefill    fl

type DailyEM
    array<fib>  fibs
    float       price
    float       EM
    int         time
    int         time_last
    string      txt

mirror = true
