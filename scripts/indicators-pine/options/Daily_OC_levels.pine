type fib
    float       level
    float       price
    color       color
    string      style
    int         size
    line        ln
    label       lbl
    linefill    fl

type DailyEM
    array<fib>  fibs
    float       price
    float       EM
    int         time
    int         time_last
    string      txt

mirror = true
