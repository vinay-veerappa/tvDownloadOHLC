color color_transparent = #00000000

var array<DailyEM> daily      = array.new<DailyEM>()
var array<DailyEM> dailyClose = array.new<DailyEM>()

// } inputs

lineStyle(string style) =>
    out = switch style
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid
    out

method swap(array<fib> this, int i, int j) =>
    temp = this.get(i)
    this.set(i, this.get(j))
    this.set(j, temp)

method sort(array<fib> this) =>
    size = this.size()
    for i = 0 to size - 2
        for j = 0 to size - 2 - i
            if this.get(j).level > this.get(j + 1).level
                this.swap(j, j + 1)

getFibLevel(float level, float _price, color _color, string _style, int _size) =>
    fib f           = fib.new()
    f.level         := level
    f.color         := _color
    f.price         := _price
    f.style         := _style
    f.size          := _size
    f.ln            := line.new(na, _price, na, _price, color=_color, style=lineStyle(f.style), xloc=xloc.bar_time, width = f.size)
    f.lbl           := label.new(na, f.price, '', style = label.style_label_left, textcolor =  _color, color = color_transparent, size=fiblevels.label_size, xloc=xloc.bar_time)
    f

method calcFibs(DailyEM this, float price, float stdDev) =>
    if this.fibs.size() == 0
        if fiblevels.fib1
            this.fibs.unshift(getFibLevel(fiblevels.fib1_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib1_level))) : price+(stdDev*fiblevels.fib1_level), fiblevels.fib1_color, fiblevels.fib1_style, fiblevels.fib1_size))
            if mirror and fiblevels.fib1_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib1_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib1_level)))) : price+(-1*(stdDev*fiblevels.fib1_level)), fiblevels.fib1_color, fiblevels.fib1_style, fiblevels.fib1_size))      
        if fiblevels.fib2
            this.fibs.unshift(getFibLevel(fiblevels.fib2_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib2_level))) : price+(stdDev*fiblevels.fib2_level), fiblevels.fib2_color, fiblevels.fib2_style, fiblevels.fib2_size))
            if mirror and fiblevels.fib2_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib2_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib2_level)))) : price+(-1*(stdDev*fiblevels.fib2_level)), fiblevels.fib2_color, fiblevels.fib2_style, fiblevels.fib2_size))
        if fiblevels.fib3
            this.fibs.unshift(getFibLevel(fiblevels.fib3_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib3_level))) : price+(stdDev*fiblevels.fib3_level), fiblevels.fib3_color, fiblevels.fib3_style, fiblevels.fib3_size))
            if mirror and fiblevels.fib3_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib3_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib3_level)))) : price+(-1*(stdDev*fiblevels.fib3_level)), fiblevels.fib3_color, fiblevels.fib3_style, fiblevels.fib3_size))
        if fiblevels.fib4
            this.fibs.unshift(getFibLevel(fiblevels.fib4_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib4_level))) : price+(stdDev*fiblevels.fib4_level), fiblevels.fib4_color, fiblevels.fib4_style, fiblevels.fib4_size))
            if mirror and fiblevels.fib4_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib4_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib4_level)))) : price+(-1*(stdDev*fiblevels.fib4_level)), fiblevels.fib4_color, fiblevels.fib4_style, fiblevels.fib4_size))
        if fiblevels.fib5
            this.fibs.unshift(getFibLevel(fiblevels.fib5_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib5_level))) : price+(stdDev*fiblevels.fib5_level), fiblevels.fib5_color, fiblevels.fib5_style, fiblevels.fib5_size))
            if mirror and fiblevels.fib5_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib5_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib5_level)))) : price+(-1*(stdDev*fiblevels.fib5_level)), fiblevels.fib5_color, fiblevels.fib5_style, fiblevels.fib5_size))
        if fiblevels.fib6
            this.fibs.unshift(getFibLevel(fiblevels.fib6_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib6_level))) : price+(stdDev*fiblevels.fib6_level), fiblevels.fib6_color, fiblevels.fib6_style, fiblevels.fib6_size))
            if mirror and fiblevels.fib6_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib6_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib6_level)))) : price+(-1*(stdDev*fiblevels.fib6_level)), fiblevels.fib6_color, fiblevels.fib6_style, fiblevels.fib6_size))
        if fiblevels.fib7
            this.fibs.unshift(getFibLevel(fiblevels.fib7_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib7_level))) : price+(stdDev*fiblevels.fib7_level), fiblevels.fib7_color, fiblevels.fib7_style, fiblevels.fib7_size))
            if mirror and fiblevels.fib7_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib7_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib7_level)))) : price+(-1*(stdDev*fiblevels.fib7_level)), fiblevels.fib7_color, fiblevels.fib7_style, fiblevels.fib7_size))
        if fiblevels.fib8
            this.fibs.unshift(getFibLevel(fiblevels.fib8_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib8_level))) : price+(stdDev*fiblevels.fib8_level), fiblevels.fib8_color, fiblevels.fib8_style, fiblevels.fib8_size))
            if mirror and fiblevels.fib8_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib8_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib8_level)))) : price+(-1*(stdDev*fiblevels.fib8_level)), fiblevels.fib8_color, fiblevels.fib8_style, fiblevels.fib8_size))
        if fiblevels.fib9
            this.fibs.unshift(getFibLevel(fiblevels.fib9_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib9_level))) : price+(stdDev*fiblevels.fib9_level), fiblevels.fib9_color, fiblevels.fib9_style, fiblevels.fib9_size))
            if mirror and fiblevels.fib9_level != 0
                this.fibs.unshift(getFibLevel(-1*fiblevels.fib9_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib9_level)))) : price+(-1*(stdDev*fiblevels.fib9_level)), fiblevels.fib9_color, fiblevels.fib9_style, fiblevels.fib9_size))
    this.fibs.sort()
    this

method fibAlert(DailyEM this) =>
    for f in this.fibs
        if f.level < 0 and ta.crossunder(low, f.price)
            alert('Price crossed below StDev ' + str.tostring(f.level) + ' [' + syminfo.ticker + ']')
            break
        if f.level > 1 and ta.crossover(high, f.level)
            alert('Price crossed above below StDev ' + str.tostring(f.level) + ' [' + syminfo.ticker + ']')
            break

method drawFibs(DailyEM this, int idx) =>
    if this.fibs.size() > 0
        for i=0 to this.fibs.size()-1
            fib f = this.fibs.get(i)
            string txt          = ''
            string space_s      = ' '
            string space_e      = ''
            int    padded       = this.time_last+(fiblevels.padding*(time-time[1]))
        
            if fiblevels.show_level 
                txt :=  this.txt+ space_s + str.tostring(f.level) 
                space_s := ' ('
                space_e := ')'

            if fiblevels.show_price
                txt := txt + space_s + str.format('{0,number,#,###.00}', f.price) + space_e

            f.ln.set_color(f.color)
            f.lbl.set_xy(padded, f.price)
            if idx == 0
                f.ln.set_xy1(this.time, f.price)
                f.ln.set_xy2(padded, f.price)
                f.lbl.set_text(txt)
                if fiblevels.use_background 
                    fib pf = this.fibs.get(i-1)
                    f.fl := linefill.new(pf.ln, f.ln, color.new(f.color, fiblevels.fill_percent))
            else
                f.ln.set_x1(this.time)
                f.ln.set_x2(this.time_last+(time-time[1]))
                f.lbl.set_x(this.time_last)
    this

method delete(array<fib> this) =>
    for f in this
        f.ln.delete()
        f.lbl.delete()
        f.fl.delete()

method add(array<DailyEM> this, float price, int _time, float stdDev, bool isClose) =>
    DailyEM d     = DailyEM.new()
    d.price     := price
    d.EM     := stdDev
    d.time      := _time
    d.time_last := _time
    d.fibs      := array.new<fib>()
    d.txt       := isClose?"EM Close": "EM Open"
    d.calcFibs(price, stdDev)
    this.unshift(d)

    if this.size() > 1
        DailyEM temp = this.pop()
        temp.fibs.delete()

method update(array<DailyEM> this, int _time) =>
    if this.size() > 0
        DailyEM f = this.first()
        f.time_last := _time

/// END Fadi Fibs Code

type OptionsData
    string optionsSymbol
    float  strike

// { funcs
getContractCost(_sym, _isClose) => 
    // Fetch both open and close simultaneously using a tuple on the current timeframe.
    // This perfectly dodges the mutable variable hoisting bug and "1D" forming bar issues.
    [o, c] = request.security(_sym,  timeframe.period, [open, close], ignore_invalid_symbol=true,lookahead =  barmerge.lookahead_off)
    
    // Return the correct value based on the flag
    _isClose ? c : o

// Calculates exact 3rd Friday timestamp for a given year/month safely using timestamp()
getThirdFridayTime(int yearVal, int monthVal) =>
    // 1. Get timestamp for the 1st day of the target month at 09:30 AM
    int firstDayTime = timestamp("America/New_York", yearVal, monthVal, 1, 9, 30, 0)
    
    // 2. Determine day of week for the 1st
    int dow = dayofweek(firstDayTime)
    
    // 3. Find days until the 1st Friday
    int daysToFirstFri = dayofweek.friday - dow
    if daysToFirstFri < 0
        daysToFirstFri := daysToFirstFri + 7
        
    // 4. 3rd Friday is 14 days after the 1st Friday
    int thirdFriTime = firstDayTime + ((daysToFirstFri + 14) * 86400000)
    thirdFriTime

// Returns MAX 2 candidate date strings: [Upcoming Friday, Monthly 3rd Friday]
// Returns candidate expiration dates, taking into account whether we are at OPEN or CLOSE
getCandidateExpirationDates(string symbolRoot, int barTime, bool isClose) =>
    array<string> dates = array.new<string>()
    int ms_per_day = 86400000

    // If it's a CLOSE trigger (e.g. 15:55), shift target time forward by 1 day (or 3 days on Friday)
    int targetTime = barTime
    if isClose
        int dow = dayofweek(barTime)
        int daysShift = (dow == dayofweek.friday) ? 3 : (dow == dayofweek.saturday) ? 2 : 1
        targetTime := barTime + (daysShift * ms_per_day)

    bool is_0dte = str.contains(symbolRoot, "SPX") or str.contains(symbolRoot, "NDX") or str.contains(symbolRoot, "QQQ") or str.contains(symbolRoot, "SPY") or str.contains(symbolRoot, "IWM")

    if is_0dte
        // Primary Candidate: Target time (Today if Open, Tomorrow if Close)
        array.push(dates, str.format("{0,date,yyMMdd}", targetTime))
        
        // Secondary Backup: Next day (in case today's 0DTE is halted/settled)
        int dow = dayofweek(targetTime)
        int daysShift = (dow == dayofweek.friday) ? 3 : 1
        array.push(dates, str.format("{0,date,yyMMdd}", targetTime + (daysShift * ms_per_day)))
    else
        // Standard Stocks: Target upcoming Friday relative to targetTime
        int dow = dayofweek(targetTime)
        int daysToFriday = dayofweek.friday - dow
        if daysToFriday < 0
            daysToFriday := daysToFriday + 7
            
        int targetFriTime = targetTime + (daysToFriday * ms_per_day)
        string weeklyDate = str.format("{0,date,yyMMdd}", targetFriTime)
        array.push(dates, weeklyDate)

        // Monthly Expiration Backup
        int currentYr  = year(targetTime)
        int currentMth = month(targetTime)
        int thirdFriTime = getThirdFridayTime(currentYr, currentMth)

        if targetTime >= thirdFriTime
            currentMth := currentMth + 1
            if currentMth > 12
                currentMth := 1
                currentYr  := currentYr + 1
            thirdFriTime := getThirdFridayTime(currentYr, currentMth)

        string monthlyDate = str.format("{0,date,yyMMdd}", thirdFriTime)
        if weeklyDate != monthlyDate
            array.push(dates, monthlyDate)

    dates

// Helper to request a contract cost and safely catch `na`
// Formats strikes to match OPRA string rules (e.g. 200 -> "200.0", 205.5 -> "205.5")
formatOPRAStrike(float strikeVal) =>
    string result = ""
    if strikeVal == math.floor(strikeVal)
        // Whole integer strikes get explicit .0 suffix
        result := str.tostring(strikeVal, "#") + ".0"
    else
        // Fractional strikes keep their exact decimal (e.g. 202.5 or 137.25)
        result := str.tostring(strikeVal, "#.##")
    result

// 1. Safe helper for OPRA option cost requests
getValidContractCost(string optSym, bool isClose) =>
    string targetSym = optSym
    // Prepend OPRA: prefix if missing and ticker isn't index like SPX/NDX
    if not str.contains(optSym, ":") and not str.contains(optSym, "SPX") and not str.contains(optSym, "NDX")
        targetSym := "OPRA:" + optSym

    [o, c] = request.security(targetSym, timeframe.period, [open, close], ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off)
    isClose ? c : o

// 2. Main fallback engine configured for OPRA:TICKER YYMMDD C/P STRIKE.0
getAtmWithFallback(string underlyingSym, float anchorPrice, OptionsData opts, bool isClose) =>
    array<float> testSpacings = array.new<float>()
    
    if str.contains(underlyingSym, "SPX") or str.contains(underlyingSym, "NDX")
        array.push(testSpacings, 5.0)
        array.push(testSpacings, 25.0)
    else if str.contains(underlyingSym, "SPY") or str.contains(underlyingSym, "QQQ") or str.contains(underlyingSym, "IWM") or str.contains(underlyingSym, "DIA")
        array.push(testSpacings, 1.0)
        array.push(testSpacings, 0.5)
    else
        if anchorPrice > 300.0
            array.push(testSpacings, 5.0)
            array.push(testSpacings, 2.5)
        else if anchorPrice >= 100.0 and anchorPrice <= 300.0
            array.push(testSpacings, 1.0)
            array.push(testSpacings, 2.5)
            array.push(testSpacings, 5.0)
        else
            array.push(testSpacings, 1.0)
            array.push(testSpacings, 0.5)

    // Preserve 1-letter single-stock tickers (e.g. "Q", "F", "C", "V")
    string cleanRoot = (str.length(opts.optionsSymbol) > 0) ? opts.optionsSymbol : syminfo.ticker

    // Fetch Candidate Dates: ["260724", "260821"]
    array<string> expDates = getCandidateExpirationDates(cleanRoot, time,  isClose)

    float validCallCost  = na
    float validPutCost   = na
    float selectedStrike = na
    float chosenSpacing  = na
    string finalCallSym  = ""
    string finalPutSym   = ""

    for d = 0 to array.size(expDates) - 1
        if na(validCallCost)
            string dateStr = array.get(expDates, d)

            for i = 0 to array.size(testSpacings) - 1
                if na(validCallCost)
                    float spacing = array.get(testSpacings, i)
                    float candidateCenter = math.round(anchorPrice / spacing) * spacing
                    
                    string strikeStr = formatOPRAStrike(candidateCenter)
                    string callSym   = cleanRoot + dateStr + C_CONTRACT_SIDE_CALL + strikeStr
                    string putSym    = cleanRoot + dateStr + C_CONTRACT_SIDE_PUT  + strikeStr
                    
                    float cCost = getValidContractCost(callSym, isClose)
                    float pCost = getValidContractCost(putSym, isClose)

                    if iDebug
                        log.info("PROBING TICKER=" + callSym + " | DATE=" + dateStr + " | CALL_COST=" + str.tostring(cCost))

                    if not na(cCost) and not na(pCost)
                        validCallCost  := cCost
                        validPutCost   := pCost
                        selectedStrike := candidateCenter
                        chosenSpacing  := spacing
                        finalCallSym   := callSym
                        finalPutSym    := putSym

    opts.strike := chosenSpacing
    [selectedStrike, validCallCost, validPutCost, finalCallSym, finalPutSym]

calcEM(bool isClose, OptionsData opts, string underlyingSym, bool useETFConv) =>
    float etfAnchor = getContractCost(underlyingSym, isClose)
    
    float r = 1.0
    if useETFConv
        float fut = getContractCost(syminfo.ticker, true)
        r := fut / etfAnchor
        
    // Round to nearest dynamic strike interval
    [center, callCost, putCost, atmCall, atmPut] = getAtmWithFallback(underlyingSym, etfAnchor, opts, isClose)    
    
    float futAnchor = etfAnchor
    if syminfo.type == "futures"
        futAnchor := math.round_to_mintick(getContractCost(syminfo.ticker, isClose))
        
    float em = na
    if not na(callCost) and not na(putCost)
        em := useETFConv ? math.round_to_mintick((callCost + putCost) * r) : math.round_to_mintick(callCost + putCost)
        
    if iDebug
        log.info("EM [" + (isClose ? "CLOSE" : "OPEN") + "] " +
             "anchor=" + str.tostring(futAnchor) +
             " ratio=" + str.tostring(r) +
             " strike=" + str.tostring(center) +
             " call=" + atmCall + "@" + str.tostring(callCost) +
             " put="  + atmPut  + "@" + str.tostring(putCost) +
             " etfEM=" + str.tostring(callCost + putCost) +
             " finalEM=" + str.tostring(em))
    [futAnchor, em]

// { logic
bool is_recent = time >= (timenow - (86400000 * 4)) // Keeping 4 days to allow for long weekends

// Define the underlying equity ticker based on your futures contract
var string equity_ref = str.contains(syminfo.ticker, "NQ")  ? "QQQ" : 
                         str.contains(syminfo.ticker, "ES")  ? "SPY" : 
                         str.contains(syminfo.ticker, "YM")  ? "DIA" : 
                         str.contains(syminfo.ticker, "RTY") ? "IWM" : 
                         str.contains(syminfo.ticker, "SPX") ? "AMEX:SPY" : syminfo.ticker

// Request the exact RTH session states from the underlying equity index
[eq_open, eq_close] = request.security(equity_ref, timeframe.period, [session.isfirstbar_regular, session.islastbar_regular], gaps = barmerge.gaps_on)

var bool can_calculate = false
var int last_open_time = 0
var int last_close_time = 0

var bool calcOpen  = false
var bool calcClose = false

if is_recent and eq_open and time != last_open_time
    last_open_time := time
    calcOpen := true
    if iDebug
        log.info(">>> OPEN trigger @ " + str.format_time(time))
    label.new(bar_index, high, "Open", color=color.green, textcolor=color.white, style=label.style_label_down)

if is_recent and eq_close and time != last_close_time
    last_close_time := time
    calcClose := true
    if iDebug
        log.info(">>> CLOSE trigger @ " + str.format_time(time))
    label.new(bar_index, high, "Close", color=color.green, textcolor=color.white, style=label.style_label_down)


var useETFConv = false
var underlyingSym = syminfo.ticker
var OptionsData current_symbol_options = OptionsData.new(syminfo.ticker, 1)

if barstate.isfirst
    current_symbol_options.optionsSymbol := syminfo.ticker
    
    // Default strike spacing
    current_symbol_options.strike := 1.0

    if str.contains(syminfo.ticker, "NQ")       
        underlyingSym := "QQQ"
        current_symbol_options.optionsSymbol := "QQQ"
        current_symbol_options.strike := 1.0
        useETFConv := true
        
    else if str.contains(syminfo.ticker, "ES") 
        underlyingSym := useSPX ? 'CBOE:SPX' : "SPY"
        current_symbol_options.optionsSymbol := useSPX ? 'SPXW' : "SPY"
        current_symbol_options.strike := useSPX ? 5.0 : 1.0
        useETFConv := not useSPX
        
    else if str.contains(syminfo.ticker, "NDX")
        underlyingSym := "NDX"
        current_symbol_options.optionsSymbol := "NDXP"
        current_symbol_options.strike := 25.0

    else if str.contains(syminfo.ticker, "SPX")
        underlyingSym := "SPX"
        current_symbol_options.optionsSymbol := "SPXW"
        current_symbol_options.strike := 5.0
        
    else if str.contains(syminfo.ticker, "YM")  
        underlyingSym := 'DIA'
        current_symbol_options.optionsSymbol := 'DIA'
        current_symbol_options.strike := 1.0
        useETFConv := true
        
    else if str.contains(syminfo.ticker, "RTY") or str.contains(syminfo.ticker, "M2K")  
        underlyingSym := 'IWM'
        current_symbol_options.optionsSymbol := 'IWM'
        current_symbol_options.strike := 1.0
        useETFConv := true

    else if  str.contains(syminfo.ticker, "VIX") 
        current_symbol_options.strike := 2.5
        
    //else if str.contains(syminfo.ticker, "AAPL") or str.contains(syminfo.ticker, "NFLX") or str.contains(syminfo.ticker, "AMZN") or str.contains(syminfo.ticker, "COIN") or str.contains(syminfo.ticker, "BA") or str.contains(syminfo.ticker, "QCOM") or str.contains(syminfo.ticker, "GOOG")
    //    current_symbol_options.strike := 5.0
        
    else if str.contains(syminfo.ticker, "NIO") or str.contains(syminfo.ticker, "BILI") 
        current_symbol_options.strike := 0.5

    else if (close > 200 and syminfo.type == "stock")  
        current_symbol_options.strike := 2.5

if calcOpen
    calcOpen := false
    [aOpen, emOpen] = calcEM(false, current_symbol_options, underlyingSym, useETFConv)
    if not na(emOpen) and emOpen > 0
        daily.add(aOpen, time, emOpen,false)

if calcClose
    calcClose := false
    [aClose, emClose] = calcEM(true, current_symbol_options, underlyingSym, useETFConv)
    if not na(emClose) and emClose > 0
        dailyClose.add(aClose, time, emClose,true)


if barstate.islast 
    if daily.size() > 0 and iDisplayOpen
        daily.update(time)
        daily.first().drawFibs(0)
        daily.first().fibAlert()
    if dailyClose.size()  > 0 and iDisplayClose
        dailyClose.update(time)
        dailyClose.first().drawFibs(0)
        dailyClose.first().fibAlert()
// } logic


// { Table 
var table displayTable = table.new(
     position.bottom_right, columns = 6, rows = 3, border_color = chart.fg_color, border_width = 2
 )

tableRow(int row, string c0, string c1, string c2, string c3, string c4, color titleColor = #9b27b066, color infoColor = na) =>
    displayTable.cell(0, row, c0, bgcolor = titleColor, text_color = chart.fg_color)
    displayTable.cell(1, row, c1, bgcolor = infoColor, text_color = chart.fg_color)
    displayTable.cell(2, row, c2, bgcolor = infoColor, text_color = chart.fg_color)
    displayTable.cell(3, row, c3, bgcolor = infoColor, text_color = chart.fg_color)
    displayTable.cell(4, row, c4, bgcolor = infoColor, text_color = chart.fg_color)

if barstate.islast and iTable
    tableRow(0, "TYPE", "ANCHOR", "EM", "EM High", "EM Low", #9b27b066)
    
    
    if daily.size() > 0
        DailyEM d = daily.first()
        //tableRow(1, "OPEN", str.tostring(d.EM), str.tostring(d.price + d.EM), str.tostring(d.price - d.EM))
        tableRow(1, "OPEN",  str.tostring(d.price), str.tostring(d.EM), str.tostring(d.price + d.EM), str.tostring(d.price - d.EM))
    if dailyClose.size() > 0
        DailyEM c = dailyClose.first()
        //tableRow(2, "CLOSE", str.tostring(c.EM), str.tostring(c.price + c.EM), str.tostring(c.price - c.EM))
        tableRow(2, "CLOSE", str.tostring(c.price), str.tostring(c.EM), str.tostring(c.price + c.EM), str.tostring(c.price - c.EM))
                
// } Table