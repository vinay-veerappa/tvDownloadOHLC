    color       fib2_color
    string      fib2_style
    int         fib2_size
    bool        fib3
    float       fib3_level
    color       fib3_color
    string      fib3_style
    int         fib3_size
    bool        fib4
    float       fib4_level
    color       fib4_color
    string      fib4_style
    int         fib4_size
    bool        fib5
    float       fib5_level
    color       fib5_color
    string      fib5_style
    int         fib5_size
    bool        fib6
    float       fib6_level
    color       fib6_color
    string      fib6_style
    int         fib6_size
    bool        fib7
    float       fib7_level
    color       fib7_color
    string      fib7_style
