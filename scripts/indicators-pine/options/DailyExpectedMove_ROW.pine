            this.fibs.push(getFibLevel(fiblevels.fib8_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib8_level))) : price+(stdDev*fiblevels.fib8_level), fiblevels.fib8_color, fiblevels.fib8_style, fiblevels.fib8_size))
            if mirror and fiblevels.fib8_level != 0
                this.fibs.push(getFibLevel(-1*fiblevels.fib8_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib8_level)))) : price+(-1*(stdDev*fiblevels.fib8_level)), fiblevels.fib8_color, fiblevels.fib8_style, fiblevels.fib8_size))

        if fiblevels.fib9
            this.fibs.push(getFibLevel(fiblevels.fib9_level, fiblevels.useLog ? math.exp(math.log(price+(stdDev*fiblevels.fib9_level))) : price+(stdDev*fiblevels.fib9_level), fiblevels.fib9_color, fiblevels.fib9_style, fiblevels.fib9_size))
            if mirror and fiblevels.fib9_level != 0
                this.fibs.push(getFibLevel(-1*fiblevels.fib9_level, fiblevels.useLog ? math.exp(math.log(price+(-1*(stdDev*fiblevels.fib9_level)))) : price+(-1*(stdDev*fiblevels.fib9_level)), fiblevels.fib9_color, fiblevels.fib9_style, fiblevels.fib9_size))
    //this.fibs.sort()
    this

method fibAlert(DailyEM this) =>
    for f in this.fibs
        if f.level < 0 and ta.crossunder(low, f.price)
            alert('Price crossed below StDev ' + str.tostring(f.level) + ' [' + syminfo.ticker + ']')
            break
        if f.level > 1 and ta.crossover(high, f.level)
            alert('Price crossed above below StDev ' + str.tostring(f.level) + ' [' + syminfo.ticker + ']')
            break

method drawFibs(DailyEM this, int idx) =>
    if this.fibs.size() > 0
        tDate = array.get(targetDates, idx)
        for i=0 to this.fibs.size()-1
            fib f = this.fibs.get(i)
            string txt          = ''
            string space_s      = ''
            string space_e      = ''
            int visibleStart    = this.time == time ? time - (BI_OFFSET * (time - time[1])) : this.time
            int    padded       = this.time_last+(fiblevels.padding*(time-time[1]))
        
            if fiblevels.show_level 
                txt := i == 0? str.tostring(f.level) + (useClose?"  PD Close ": "  RTH Open ") : formatLabelText(tDate, useClose?"EM Close ": "EM Open ", f.level) //useClose?"EM Close "+ str.tostring(f.level): "EM Open "+ str.tostring(f.level) 
                space_s := ' ('
                space_e := ')'

            if fiblevels.show_price
                txt := txt + space_s + str.format('{0,number,#,###.00}', f.price) + space_e
            //log.info(txt + "Idx = " + str.tostring(idx))

            f.ln.set_color(f.color)
            f.lbl.set_xy(padded, f.price)
            if true //idx == 0
                f.ln.set_xy1(visibleStart, f.price)
                f.ln.set_xy2(padded, f.price)
                f.lbl.set_text(txt)
                if fiblevels.use_background 
                    fib pf = this.fibs.get(i-1)
                    f.fl := linefill.new(pf.ln, f.ln, color.new(f.color, fiblevels.fill_percent))
            else
                f.ln.set_x1(visibleStart)
                f.ln.set_x2(this.time_last+(time-time[1]))
                f.lbl.set_x(this.time_last)
    this



// Don't need this for a one off
method delete(array<fib> this) =>
    for f in this
        f.ln.delete()
        f.lbl.delete()
        f.fl.delete()

method add(array<DailyEM> this, float price, int _time, float ExpectedMove) =>
    DailyEM d     = DailyEM.new()
    d.price     := price
    d.EM        := ExpectedMove
    d.time      := _time
    d.time_last := _time
    d.fibs      := array.new<fib>()
    d.calcFibs(price, ExpectedMove)
    this.push(d) // add to end of the array and not beginning

    if this.size() > 5  // Max days until friday
        DailyEM temp = this.pop()
        temp.fibs.delete()

method update(array<DailyEM> this, int _time) =>
    if this.size() > 0
        for [i, day] in daily
            //DailyEM f = this.first()
            day.time_last := _time

varip bool done = false
var float factor = 0
var float day_open = 0
var int   day_time = 0


/// END Fadi Fibs Code



// { funcs
roundToNearest(float value, float nearest) => math.round(value / nearest) * nearest

f_custom_round(n) =>
    // Calculate nearest multiple of 10
    nearest_10 = math.round(n / 10) * 10
    // Calculate nearest multiple of 25
    nearest_25 = math.round(n / 25) * 25
    // Calculate distances
    dist_to_10 = math.abs(n - nearest_10)
    dist_to_25 = math.abs(n - nearest_25)
    // If nearest_25 is a multiple of 100, prefer nearest_10
    result = nearest_25 % 100 == 0 ? nearest_10 : dist_to_25 < dist_to_10 ? nearest_25 : nearest_10
    result


// Function to format the date YYMMDD
format_date(year, month, day) =>
    year_str = str.tostring(year % 100)
    month_str = month < 10 ? '0' + str.tostring(month) : str.tostring(month)
    day_str = day < 10 ? '0' + str.tostring(day) : str.tostring(day)
    year_str + month_str + day_str

// Function to get days in month
days_in_month(y, m) =>
    m == 2 ? y % 4 == 0 and y % 100 != 0 or y % 400 == 0 ? 29 : 28 : m == 4 or m == 6 or m == 9 or m == 11 ? 30 : 31

// Function to add days to a date, handles month/year rollovers
add_days(y, m, d, numDays) =>
    currentTimestamp = timenow // Use timenow for date calculations independent of bar time
    targetTimestamp = timestamp(y, m, d, 0, 0, 0) + numDays * 86400 * 1000 // Add days in milliseconds
    [year(targetTimestamp), month(targetTimestamp), dayofmonth(targetTimestamp)]

getDoWforStock() =>
   // Find the next Friday
    expiry_day = dayofmonth
    days_until_friday = 6 - dayofweek // Calculate days until Friday (0-6, Mon-Sun)
    if days_until_friday == 0
        days_until_friday := 7 // If it's Friday, use next Friday
    expiry_day := dayofmonth + days_until_friday + (iMonHoliday?1:0)
    expiry_day

// --- NEW: Function to get the Mon-Fri dates for the relevant week ---
getWeekTradingDays(currentTime) =>
    currentDow = dayofweek(currentTime) // 1=Sun, 2=Mon, ..., 7=Sat
    int h = hour(currentTime, "America/New_York")
    int mn = minute(currentTime, "America/New_York")

    // Determine days to subtract to get to the *previous* Sunday (start of week boundary)
    daysToSubtract =  currentDow - 1

    // If today is Fri AFTER 16:15, Sat, or Sun, we want *next* week's dates
    startOffset = (currentDow == dayofweek.friday and (h > 16 or (h == 16 and mn >= 15))) or (currentDow == dayofweek.saturday) ? 7 : 0

    // Calculate timestamp for the Sunday *before* the target week starts
    startSundayTs = timestamp(year(currentTime), month(currentTime), dayofmonth(currentTime), 0, 0, 0) - daysToSubtract * 86400 * 1000

    // Calculate the 5 target dates (Mon-Fri) relative to that Sunday
    dates = array.new<TargetDate>(5)
    for i = 1 to 5 by 1 // 1=Mon offset, 5=Fri offset
        dayOffset = startOffset + i
        targetTs = startSundayTs + dayOffset * 86400 * 1000
        targetY = year(targetTs)
        targetM = month(targetTs)
        targetD = dayofmonth(targetTs)
        targetDow = dayofweek(targetTs)
        array.set(dates, i - 1, TargetDate.new(targetY, targetM, targetD, targetDow))

    dates // Return array of TargetDate objects


getContractCost(_sym, _useClose) => 
    request.security((_sym), _useClose ? "1D" : tf, _useClose ? close : open, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_on)


getContractSym(_underlyingSym, _strike, _side,OptionsData current_symbol_options) =>
    
    // Determine the expiration date
    expiry_year = year
    expiry_month = month
    expiry_day = useClose?  dayofmonth + 1 : dayofmonth // Default to next day

    optionChainSymbol = current_symbol_options.optionsSymbol

    //if (dayofweek == dayofweek.thursday or dayofweek == dayofweek.monday ) and iFriHoliday  /// Not sure of this. If its Thu and current week friday is a holiday then it should go to monday, not sure why I also put nonday in the same calculation.
    //    expiry_day := dayofmonth + 4
    if dayofweek == dayofweek.friday and useClose
        expiry_day := dayofmonth + 3 + (iMonHoliday?1:0) // Monday's date

    if syminfo.type ==  "stock" or syminfo.type ==  "dr"  or str.contains(optionChainSymbol,"DIA" )  or str.contains(optionChainSymbol,"BOIL" ) // These are weekly expiry and not 0DTE  or str.contains(syminfo.ticker,"NDX" )  NDX is not weekly expiry...
        // Calculate the date of the next Friday
        days_until_friday = 6 - dayofweek // Calculate days until Friday (0-6, Mon-Sun)
        if days_until_friday < 0
            days_until_friday := days_until_friday + 7 // Adjust for Sunday (0)
        if days_until_friday == 0
            days_until_friday := 7 // If it's Friday, use next Friday
        expiry_day := dayofmonth + days_until_friday  - (iFriHoliday?1:0)  // This may not work unless it is a friday holdiay. Do we care about monday?

        // Handle month and year rollovers
        max_days = days_in_month(expiry_year, expiry_month)
        if expiry_day > max_days
            expiry_month := month + 1
            expiry_day := expiry_day - max_days
            if expiry_month > 12
                expiry_month := 1
                expiry_year := year + 1

    strike =  str.contains(syminfo.ticker,"NDX" ) ?f_custom_round(_strike) :roundToNearest(_strike, current_symbol_options.strike)
                                                                                                        // This part is still iffy. If it is 2.5 then U use that, there is no 0
    optionChainSymbol  + format_date(expiry_year, expiry_month, expiry_day) + _side + str.tostring(strike, '#') + (syminfo.type ==  "stock"?".0": ".0")

getAtmContracts(_underlyingSym, _strike,OptionsData current_symbol_options) =>
    [getContractSym(_underlyingSym, _strike, C_CONTRACT_SIDE_CALL,current_symbol_options), getContractSym(_underlyingSym, _strike, C_CONTRACT_SIDE_PUT,current_symbol_options)]

// --- MODIFIED: Takes explicit target date ---
getContractSym_New(_strike, _side, OptionsData current_symbol_options, int expYear, int expMonth, int expDay) =>
    optionChainSymbol = current_symbol_options.optionsSymbol
    calculated_strike = _strike

    // Round strike based on specific rules if needed (e.g., NDX)
    if str.contains(current_symbol_options.symbol, 'NDX')
        calculated_strike := f_custom_round(_strike)
        calculated_strike
    else
        calculated_strike := roundToNearest(_strike, current_symbol_options.strike)
        calculated_strike

    strike_str = str.tostring(calculated_strike)
    needs_decimal_zero = true //(syminfo.type == "stock" or syminfo.type == "index" or str.contains(optionChainSymbol, "SPX") or str.contains(optionChainSymbol, "NDX")) ? true:false

    if not str.contains(strike_str, '.') and needs_decimal_zero
        strike_str := strike_str + '.0'
        strike_str

    // Construct the symbol using the provided expiration date
    optionChainSymbol + format_date(expYear, expMonth, expDay) + _side + strike_str

// --- NEW: Function to calculate EM for a specific day ---
calculateDailyEM(int targetY, int targetM, int targetD, float anchorPrice, float centerStrike, OptionsData current_symbol_options) =>
    callSym = getContractSym_New(centerStrike, C_CONTRACT_SIDE_CALL, current_symbol_options, targetY, targetM, targetD)
    putSym = getContractSym_New(centerStrike, C_CONTRACT_SIDE_PUT, current_symbol_options, targetY, targetM, targetD)

    // Fetch option costs (use close price near the start of *our current* calculation period)
    // False indicates fetching option price, not anchor
    callCost = getContractCost(callSym, false)
    putCost = getContractCost(putSym, false)
    //callCost = 100
    //putCost = 120

    float emValue = na
    if not na(callCost) and not na(putCost)
        emValue := callCost + putCost
        log.info(str.format('EM Calc for {0}-{1}-{2}: Call={3}({4}), Put={5}({6}), EM={7}', str.tostring(targetY), str.tostring(targetM), str.tostring(targetD), callSym, str.tostring(callCost), putSym, str.tostring(putCost), str.tostring(emValue)))
    else
        log.warning(str.format('Failed EM Calc for {0}-{1}-{2}: CallSym={3}, PutSym={4}. Costs: C={5}, P={6}', str.tostring(targetY), str.tostring(targetM), str.tostring(targetD), callSym, putSym, str.tostring(callCost), str.tostring(putCost)))

    math.round_to_mintick(emValue) // Return EM or na, rounded


