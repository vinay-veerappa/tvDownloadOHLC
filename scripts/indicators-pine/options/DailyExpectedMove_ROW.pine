  //  anchorOpen := close


var useETFConv = false

var  ratio = 0.0 


// TOS Expected Move from straddle price (no IV input needed).
// Derivation: Brenner-Subrahmanyam ATM straddle ≈ Price × IV × √(2×DTE/(365π))
// Combined with calibrated EM = Price × IV × √((0.637×DTE + intercept)/365),
// the IV cancels: EM = Straddle × √(π × (0.637×DTE + intercept) / (2×DTE))
//
// Validated 2026-05-09 against SPY/NVDA (eq) and /ES/NQ (fut). Match: <0.1%.
f_tos_em_from_straddle(straddle, dte, asset_class) =>
    a = asset_class == "futures"   ?  1.090 :
         asset_class == "stock"     ?  1.074 :
                                      1.106  // equity_etf default
    b = asset_class == "futures"   ? -0.114 :
         asset_class == "stock"     ?  0.145 :
                                      0.135  // equity_etf default
    multiplier = a + b / dte
    straddle * multiplier

f_center_strike(spot, strike_width) =>
    math.round(spot / strike_width) * strike_width


