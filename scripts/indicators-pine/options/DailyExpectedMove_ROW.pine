days_to_subtract = switch current_day
    dayofweek.saturday  => 1 // On Saturday, subtract 1 day to get Friday
    dayofweek.sunday    => 2 // On Sunday, subtract 2 days to get Friday
    dayofweek.monday    => 3 // On Monday, subtract 3 days to get Friday
    dayofweek.tuesday    => 4 // On Monday, subtract 3 days to get Friday
    dayofweek.wednesday    => 5 // On Monday, subtract 3 days to get Friday
    dayofweek.thursday    => 6 // On Monday, subtract 3 days to get Friday
    //dayofweek.friday    => 7 // On Monday, subtract 3 days to get Friday
    => 1 // For Tuesday-Friday, just subtract 1 day
if iPrevFriHoliday 
    days_to_subtract := days_to_subtract+1   // If Friday is a holiday or short day

