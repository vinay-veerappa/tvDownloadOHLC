// ExecutionHUD.pine v1.0
// ======================
// Elite visual execution framework using plain-English commands, shaded bands, ghost lines, and an interactive 4-column HUD.

//@version=6
indicator("Execution HUD and Visual Plan", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════

var string GRP_DATA = "Data Buffers"
i_pastedScored  = input.text_area("", "Paste Unified Levels (unified_levels.txt recommended)", group = GRP_DATA)

var string GRP_MATCH = "Symbol Matching"
i_familyPref    = input.string("Auto", "Family Source Preference", options = ["Auto", "Prefer Index", "Prefer ETF"], group = GRP_MATCH)
i_overrideExact = input.bool(false, "Override Exact Match With Family Preference", group = GRP_MATCH)

var string GRP_CONV = "Futures Conversion"
i_applyConv = input.string("Auto", "Apply Futures Conversion", options = ["Auto", "Always", "Never"], group = GRP_CONV, tooltip = "Auto applies the ratio/basis only if the current chart is a Futures chart.")

var string GRP_FILT = "Level Filters"
i_proxFilter        = input.float(0.0, "Hide Levels > X% Away (0=Off)", step=0.5, group=GRP_FILT, tooltip="Applies to all levels. Levels further than X% from close are hidden.")

var string GRP_LABELS = "Label Collision & Display"
i_showLabels        = input.bool(true, "Show Labels", group = GRP_LABELS)
i_showPriceInLabel  = input.bool(true, "Show Price In Label", group = GRP_LABELS)
i_labelSize         = input.string("tiny", "Label Size", options = ["tiny", "small", "normal", "large"], group = GRP_LABELS)
i_labelOffset       = input.int(2, "Label Offset", minval = 0, maxval = 50, group = GRP_LABELS)
i_labelBgOpacity    = input.int(90, "Label Bg Opacity", minval = 0, maxval = 100, group = GRP_LABELS)
i_labelCollision    = input.string("Stagger", "Collision Mode", options = ["Stagger", "Hide", "Off"], group = GRP_LABELS)
i_maxLabelCols      = input.int(4, "Max Columns", minval = 1, maxval = 10, group = GRP_LABELS)
i_columnStepBars    = input.int(2, "Column Step Bars", minval = 1, maxval = 20, group = GRP_LABELS)
i_minLabelGapTicks  = input.int(40, "Min Gap (ticks)", minval = 1, maxval = 500, group = GRP_LABELS)

var string GRP_DASH = "Dashboard HUD"
i_showDash          = input.bool(true, "Show Dashboard", group = GRP_DASH)
i_dashPos           = input.string("Bottom Right", "Position", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = GRP_DASH)
i_dashSize          = input.string("small", "Text Size", options = ["tiny", "small", "normal", "large"], group = GRP_DASH)
i_dashBgOpacity     = input.int(90, "Bg Opacity", minval = 0, maxval = 100, group = GRP_DASH)

var string GRP_DEBUG = "Debug"
i_debugLogs         = input.bool(false, "Enable Debug Logs", group = GRP_DEBUG)

// ═══════════════════════════════════════════════════════════════════════
// THEME-AGNOSTIC COLOR SYSTEM & HELPERS
// ═══════════════════════════════════════════════════════════════════════

// Core Palette
color C_BULL          = #10B981
color C_BEAR          = #EF4444
color C_TARGET        = #06B6D4
color C_INVALIDATION  = #F97316
color C_OGT           = #A855F7
color C_MAGNET        = #EC4899
color C_NEUTRAL       = #94A3B8
color C_GHOST         = #787B86

// Fixed Dark Label Badge Background
color C_LABEL_BG      = #1E222D

f_labelSize(string s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : size.large

f_dbg(string msg) =>
    if i_debugLogs
        log.info(msg)

f_pos(string s) =>
    s == "Top Left" ? position.top_left : s == "Top Center" ? position.top_center : s == "Top Right" ? position.top_right :
     s == "Middle Left" ? position.middle_left : s == "Middle Center" ? position.middle_center : s == "Middle Right" ? position.middle_right :
     s == "Bottom Left" ? position.bottom_left : s == "Bottom Center" ? position.bottom_center : position.bottom_right

f_norm(string v) => str.upper(str.trim(v))

f_stripPrefix(string v) =>
    t = f_norm(v)
    str.startswith(t, "/") ? str.substring(t, 1, str.length(t)) : t

f_stripContinuousSuffix(string v) =>
    c = f_stripPrefix(v)
    l = str.length(c)
    l > 2 and str.endswith(c, "!") ? str.substring(c, 0, l - 2) : c

f_primarySymbol() =>
    r = f_stripPrefix(syminfo.root)
    t = f_stripPrefix(syminfo.ticker)
    str.length(r) > 0 ? r : t

f_canonicalSymbol(string s) =>
    c = f_stripContinuousSuffix(s)
    c == "MES" ? "ES" : c == "MNQ" ? "NQ" : c == "MYM" ? "YM" : c == "M2K" ? "RTY" : c == "MGC" ? "GC" : c == "SIL" ? "SI" : c == "MCL" ? "CL" : c == "MHG" ? "HG" : c == "M6E" ? "6E" : c == "M6A" ? "6A" : c == "M6B" ? "6B" : c == "M6J" ? "6J" : c

f_symbolFamilyKey(string s) =>
    c = f_canonicalSymbol(s)
    r = c
    if c == "ES" or c == "SPX" or c == "SPY"
        r := "ES_FAMILY"
    else if c == "NQ" or c == "NDX" or c == "QQQ"
        r := "NQ_FAMILY"
    else if c == "YM" or c == "DJX" or c == "DJI" or c == "US30" or c == "DOW" or c == "DIA"
        r := "YM_FAMILY"
    else if c == "RTY" or c == "RUT" or c == "IWM"
        r := "RTY_FAMILY"
    r

f_sourceKind(string s) =>
    c = f_canonicalSymbol(s)
    c == "SPX" or c == "NDX" or c == "DJX" or c == "DJI" or c == "RUT" ? "INDEX" : c == "SPY" or c == "QQQ" or c == "DIA" or c == "IWM" ? "ETF" : "OTHER"

f_isOvernightFutures(string s) =>
    c = f_canonicalSymbol(s)
    c == "ES" or c == "NQ" or c == "YM" or c == "RTY" or c == "CL" or c == "GC" or c == "SI" or c == "HG" or c == "6E" or c == "6A" or c == "6B" or c == "6J" or c == "ZN" or c == "ZB"

f_matchScore(string assetTag) =>
    asset = f_canonicalSymbol(assetTag)
    aFam = f_symbolFamilyKey(asset)
    primary = f_canonicalSymbol(f_primarySymbol())
    pFam = f_symbolFamilyKey(primary)
    ticker = f_canonicalSymbol(syminfo.ticker)
    tFam = f_symbolFamilyKey(ticker)
    root = f_canonicalSymbol(syminfo.root)
    rFam = f_symbolFamilyKey(root)
    exact = asset == ticker or asset == root or asset == primary
    family = aFam == tFam or aFam == rFam or aFam == pFam
    eBase = i_overrideExact and i_familyPref != "Auto" ? 120 : 200
    fBase = family ? 100 : 0
    boost = 0
    if family and i_familyPref != "Auto"
        k = f_sourceKind(asset)
        if i_familyPref == "Prefer ETF" and k == "ETF"
            boost := 30
        else if i_familyPref == "Prefer Index" and k == "INDEX"
            boost := 30
    exact ? eBase : (fBase + boost)

f_num(float v) => na(v) ? "—" : str.tostring(v, "#.##")

f_isNear(float value, float ref, float thr) => not na(value) and not na(ref) and math.abs(value - ref) <= thr

f_assignLabelColumn(float level, array<float> cols, float gap, int maxC) =>
    int a = -1
    if i_labelCollision == "Off"
        a := 0
    else
        if array.size(cols) > 0
            for c = 0 to array.size(cols) - 1
                if math.abs(level - array.get(cols, c)) >= gap
                    a := c
                    break
        if a == -1
            if array.size(cols) < maxC
                array.push(cols, level)
                a := array.size(cols) - 1
            else if i_labelCollision == "Hide"
                a := -1
            else
                bG = -1.0
                bC = 0
                for c = 0 to array.size(cols) - 1
                    g = math.abs(level - array.get(cols, c))
                    if g > bG
                        bG := g
                        bC := c
                a := bC
    if a >= 0
        if a >= array.size(cols)
            array.push(cols, level)
        else
            array.set(cols, a, level)
    a

f_extractAssetTag(string lineText) =>
    tokens = str.split(lineText, ",")
    asset = ""
    if array.size(tokens) > 0
        fp = str.split(str.trim(array.get(tokens, 0)), ":")
        if array.size(fp) >= 3
            asset := f_stripPrefix(array.get(fp, 0))
    asset

f_findMatchingLine(string blob) =>
    string mL = ""
    string mA = ""
    int bs = 0
    rows = str.split(blob, "\n")
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            row = str.trim(array.get(rows, i))
            if str.length(row) > 0 and str.contains(row, ",")
                a = f_extractAssetTag(row)
                sc = f_matchScore(a)
                if str.length(a) > 0 and sc > bs
                    mL := row
                    mA := a
                    bs := sc
    [mL, mA]

f_parseScoredLevels(string lineText, array<float> prices, array<string> filters, array<string> sigs, array<string> labels) =>
    array.clear(prices)
    array.clear(filters)
    array.clear(sigs)
    array.clear(labels)
    tokens = str.split(lineText, ",")
    if array.size(tokens) > 0
        for i = 0 to array.size(tokens) - 1
            token = str.trim(array.get(tokens, i))
            parts = str.split(token, ":")
            string px = ""
            string raw_label = ""
            if i == 0
                if array.size(parts) >= 3
                    px := str.trim(array.get(parts, 1))
                    raw_label := str.trim(array.get(parts, 2))
            else
                if array.size(parts) >= 2
                    px := str.trim(array.get(parts, 0))
                    raw_label := str.trim(array.get(parts, 1))
            lv = math.round_to_mintick(str.tonumber(px))
            if not na(lv) and str.length(raw_label) > 0
                meta = str.split(raw_label, "|")
                if array.size(meta) >= 3
                    array.push(prices, lv)
                    array.push(filters, str.trim(array.get(meta, 0)))
                    array.push(sigs, str.trim(array.get(meta, 1)))
                    array.push(labels, str.trim(array.get(meta, 2)))

// ── Global Parsed Data Caches ──
var array<float> cached_sPrices = array.new_float()
var array<string> cached_sFilters = array.new_string()
var array<string> cached_sSigs = array.new_string()
var array<string> cached_sLabels = array.new_string()

// State management variables
var string st_Regime = "NEUTRAL"
var string st_Bias = "NEUTRAL"
var string st_Note = ""
var float st_ShortTrig = na
var float st_LongTrig = na
var float st_ShortTgt = na
var float st_LongTgt = na
var float st_ShortInv = na
var float st_LongInv = na
var float st_OGT = na
var float st_MAG = na
var float st_PIN = na
var float st_ZG = na
var float st_ZG_DA = na
var float st_CW = na
var float st_PW = na
var float st_EU = na
var float st_EL = na
var float st_GFU = na
var float st_GFL = na
var float st_GCU = na
var float st_GCD = na
var float st_CW0 = na
var float st_PW0 = na
var float st_MP = na
var float st_HW = na
var float st_LCN = na
var float st_LPN = na
var float st_DCN = na
var float st_DPN = na
var float st_FuturesBasis = na
var float st_FuturesRatio = na

var string TZ = "America/New_York"
f_sessionKey() => dayofmonth(time, TZ) + month(time, TZ) * 31 + year(time, TZ) * 400
isNewSession = ta.change(f_sessionKey()) != 0
var int sessionStartBar = 0
if barstate.isfirst 
    sessionStartBar := bar_index

bool is_recent = time >= (timenow - (86400000 * 4))

var string equity_ref = str.contains(syminfo.ticker, "NQ")  ? "QQQ" : 
                         str.contains(syminfo.ticker, "ES")  ? "SPY" : 
                         str.contains(syminfo.ticker, "YM")  ? "DIA" : 
                         str.contains(syminfo.ticker, "RTY") ? "IWM" : 
                         str.contains(syminfo.ticker, "SPX") ? "AMEX:SPY" : syminfo.ticker

[eq_open, eq_close] = request.security(equity_ref, timeframe.period, [session.isfirstbar_regular, session.islastbar_regular], gaps = barmerge.gaps_on)

var bool can_calculate = false
var int last_open_time = 0
var int last_close_time = 0
var string rawScored = ""
var string matchScored = ""

if is_recent and eq_open and time != last_open_time
    last_open_time := time
    can_calculate := true
    sessionStartBar := bar_index

if is_recent and eq_close and time != last_close_time
    last_close_time := time
    can_calculate := true
    sessionStartBar := bar_index

if barstate.isfirst
    [rS, mS] = f_findMatchingLine(i_pastedScored)
    rawScored := rS
    matchScored := mS
    if matchScored != ""
        f_parseScoredLevels(rawScored, cached_sPrices, cached_sFilters, cached_sSigs, cached_sLabels)
        can_calculate := true
        sessionStartBar := bar_index

    // --- Metadata Parsing ---
    if matchScored != ""
        tokens = str.split(rawScored, ",")
        if array.size(tokens) > 0
            for i = 0 to array.size(tokens) - 1
                token = str.trim(array.get(tokens, i))
                parts = str.split(token, ":")
                string ti = ""
                if i == 0
                    if array.size(parts) >= 3
                        ti := str.trim(array.get(parts, 2))
                else
                    if array.size(parts) >= 2
                        ti := str.trim(array.get(parts, 1))

                if str.contains(ti, "|")
                    meta_parts = str.split(ti, "|")
                    if array.size(meta_parts) >= 3
                        ti := str.trim(array.get(meta_parts, 2))

                if str.startswith(ti, "META_")
                    if str.startswith(ti, "META_REGIME_")
                        st_Regime := str.replace(ti, "META_REGIME_", "")
                    else if str.startswith(ti, "META_BIAS_")
                        st_Bias := str.replace(ti, "META_BIAS_", "")
                    else if str.startswith(ti, "META_NOTE_")
                        st_Note := str.replace(ti, "META_NOTE_", "")
                    else if str.startswith(ti, "META_S_TRIG_")
                        st_ShortTrig := str.tonumber(str.replace(ti, "META_S_TRIG_", ""))
                    else if str.startswith(ti, "META_L_TRIG_")
                        st_LongTrig := str.tonumber(str.replace(ti, "META_L_TRIG_", ""))
                    else if str.startswith(ti, "META_S_TGT_")
                        st_ShortTgt := str.tonumber(str.replace(ti, "META_S_TGT_", ""))
                    else if str.startswith(ti, "META_L_TGT_")
                        st_LongTgt := str.tonumber(str.replace(ti, "META_L_TGT_", ""))
                    else if str.startswith(ti, "META_S_INV_")
                        st_ShortInv := str.tonumber(str.replace(ti, "META_S_INV_", ""))
                    else if str.startswith(ti, "META_L_INV_")
                        st_LongInv := str.tonumber(str.replace(ti, "META_L_INV_", ""))
                    else if str.startswith(ti, "META_OGT_")
                        st_OGT := str.tonumber(str.replace(ti, "META_OGT_", ""))
                    else if str.startswith(ti, "META_FUTURES_BASIS_")
                        st_FuturesBasis := str.tonumber(str.replace(ti, "META_FUTURES_BASIS_", ""))
                    else if str.startswith(ti, "META_FUTURES_RATIO_")
                        st_FuturesRatio := str.tonumber(str.replace(ti, "META_FUTURES_RATIO_", ""))

        // ── Apply Static Futures Translation ──
        bool doConversion = (i_applyConv == "Auto" and syminfo.type == "futures") or (i_applyConv == "Always")
        if doConversion and array.size(cached_sPrices) > 0
            if not na(st_FuturesBasis) and math.abs(st_FuturesBasis) > 0.001
                for k = 0 to array.size(cached_sPrices) - 1
                    array.set(cached_sPrices, k, array.get(cached_sPrices, k) + st_FuturesBasis)
                if not na(st_ShortTrig)
                    st_ShortTrig := st_ShortTrig + st_FuturesBasis
                if not na(st_LongTrig)
                    st_LongTrig := st_LongTrig + st_FuturesBasis
                if not na(st_ShortTgt)
                    st_ShortTgt := st_ShortTgt + st_FuturesBasis
                if not na(st_LongTgt)
                    st_LongTgt := st_LongTgt + st_FuturesBasis
                if not na(st_ShortInv)
                    st_ShortInv := st_ShortInv + st_FuturesBasis
                if not na(st_LongInv)
                    st_LongInv := st_LongInv + st_FuturesBasis
                if not na(st_OGT)
                    st_OGT := st_OGT + st_FuturesBasis
            else if not na(st_FuturesRatio) and math.abs(st_FuturesRatio - 1.0) > 0.000001
                for k = 0 to array.size(cached_sPrices) - 1
                    array.set(cached_sPrices, k, array.get(cached_sPrices, k) * st_FuturesRatio)
                if not na(st_ShortTrig)
                    st_ShortTrig := st_ShortTrig * st_FuturesRatio
                if not na(st_LongTrig)
                    st_LongTrig := st_LongTrig * st_FuturesRatio
                if not na(st_ShortTgt)
                    st_ShortTgt := st_ShortTgt * st_FuturesRatio
                if not na(st_LongTgt)
                    st_LongTgt := st_LongTgt * st_FuturesRatio
                if not na(st_ShortInv)
                    st_ShortInv := st_ShortInv * st_FuturesRatio
                if not na(st_LongInv)
                    st_LongInv := st_LongInv * st_FuturesRatio
                if not na(st_OGT)
                    st_OGT := st_OGT * st_FuturesRatio


// Drawing storage arrays
var array<line> allLines = array.new_line()
var array<label> allLabels = array.new_label()
var array<int> labelCols = array.new_int()
var array<float> colLastPrices = array.new_float()
var array<bool> dyn_isTactical = array.new_bool()
var array<color> dyn_lineColor = array.new_color()
var array<bool> dyn_lblTactical = array.new_bool()
var array<color> dyn_lblTextColor = array.new_color()
var array<color> dyn_lblBgColor = array.new_color()

f_clearAll() =>
    while array.size(allLines) > 0
        line.delete(array.shift(allLines))
    while array.size(allLabels) > 0
        label.delete(array.shift(allLabels))
    array.clear(labelCols)
    array.clear(colLastPrices)
    array.clear(dyn_isTactical)
    array.clear(dyn_lineColor)
    array.clear(dyn_lblTactical)
    array.clear(dyn_lblTextColor)
    array.clear(dyn_lblBgColor)

// ── Shaded Bands Helper Function ──
f_drawExecutionBand(float val, string title, color bandColor, string tooltipText) =>
    if not na(val)
        float emVal = not na(st_EU) and not na(st_EL) ? (st_EU - st_EL) / 2.0 : na
        float offset = not na(emVal) ? emVal * 0.015 : val * 0.0003
        float upper = val + offset
        float lower = val - offset
        
        line lnUpper = line.new(sessionStartBar, upper, bar_index, upper, color = color.new(bandColor, 40), width = 2, style = line.style_solid)
        line lnLower = line.new(sessionStartBar, lower, bar_index, lower, color = color.new(bandColor, 40), width = 2, style = line.style_solid)
        line lnMid   = line.new(sessionStartBar, val, bar_index, val, color = color.new(bandColor, 30), width = 1, style = line.style_solid)
        linefill.new(lnUpper, lnLower, color.new(bandColor, 88))
        
        array.push(allLines, lnUpper)
        array.push(allLines, lnLower)
        array.push(allLines, lnMid)
        array.push(dyn_isTactical, false)
        array.push(dyn_isTactical, false)
        array.push(dyn_isTactical, false)
        array.push(dyn_lineColor, color.new(bandColor, 40))
        array.push(dyn_lineColor, color.new(bandColor, 40))
        array.push(dyn_lineColor, color.new(bandColor, 20))
        
        if i_showLabels
            mg = syminfo.mintick * i_minLabelGapTicks
            lc = f_assignLabelColumn(val, colLastPrices, mg, i_maxLabelCols)
            if lc >= 0
                dispTxt = title
                if i_showPriceInLabel
                    dispTxt := dispTxt + " (" + str.tostring(val, "#.##") + ")"
                lblBg = color.new(C_LABEL_BG, 100 - i_labelBgOpacity)
                lb = label.new(bar_index + i_labelOffset, val, dispTxt, 
                    textcolor = color.new(bandColor, 0), 
                    color = lblBg, 
                    style = label.style_label_left, 
                    size = f_labelSize(i_labelSize),
                    tooltip = tooltipText)
                array.push(allLabels, lb)
                array.push(labelCols, lc)
                array.push(dyn_lblTactical, false)
                array.push(dyn_lblTextColor, color.new(bandColor, 0))
                array.push(dyn_lblBgColor, lblBg)

// Main Redraw Execution
if can_calculate
    can_calculate := false
    f_clearAll()
    st_ZG := na, st_ZG_DA := na, st_MAG := na, st_PIN := na
    st_CW := na, st_PW := na, st_EU := na, st_EL := na
    st_GFU := na, st_GFL := na, st_GCU := na, st_GCD := na
    st_CW0 := na, st_PW0 := na, st_MP := na, st_HW := na
    st_LCN := na, st_LPN := na, st_DCN := na, st_DPN := na

    if array.size(cached_sPrices) > 0
        sPrices = array.copy(cached_sPrices)
        sFilters = array.copy(cached_sFilters)
        sSigs = array.copy(cached_sSigs)
        sLabels = array.copy(cached_sLabels)

        // Metadata identification phase
        for i = 0 to array.size(sPrices) - 1
            s_lv = array.get(sPrices, i)
            s_flt = array.get(sFilters, i)
            s_lbl = array.get(sLabels, i)
            u_lbl = str.upper(s_lbl)
            
            if s_flt == "W"
                if str.contains(u_lbl, "DEX C")
                    st_DCN := s_lv
                else if str.contains(u_lbl, "DEX P")
                    st_DPN := s_lv
                else if str.contains(u_lbl, "LOC C")
                    st_LCN := s_lv
                else if str.contains(u_lbl, "LOC P")
                    st_LPN := s_lv
                else if str.contains(u_lbl, "HW")
                    st_PW := s_lv
                    st_HW := s_lv
                else if str.contains(u_lbl, "CW")
                    st_CW := s_lv
                else if str.contains(u_lbl, "PW")
                    st_PW := s_lv
            else if s_flt == "A"
                if str.contains(u_lbl, "PIN")
                    st_PIN := s_lv
                else if str.contains(u_lbl, "MAX")
                    st_MP := s_lv
            else if s_flt == "I"
                if str.contains(u_lbl, "ZERO")
                    if str.contains(u_lbl, "DA")
                        st_ZG_DA := s_lv
                    else if str.contains(u_lbl, "ADJ")
                        st_ZG_DA := s_lv
                    else
                        st_ZG := s_lv
                if str.contains(u_lbl, "MAGNET")
                    st_MAG := s_lv
                if str.contains(u_lbl, "FLIP UP")
                    st_GFU := s_lv
                if str.contains(u_lbl, "FLIP DN")
                    st_GFL := s_lv
                if str.contains(u_lbl, "CLIFF UP")
                    st_GCU := s_lv
                if str.contains(u_lbl, "CLIFF DN")
                    st_GCD := s_lv
            else if s_flt == "E"
                if str.contains(u_lbl, "EM HI")
                    if na(st_EU)
                        st_EU := s_lv
                if str.contains(u_lbl, "EM LO")
                    if na(st_EL)
                        st_EL := s_lv

        // Drawing Ghost Lines
        for i = 0 to array.size(sPrices) - 1
            s_lv = array.get(sPrices, i)
            s_flt = array.get(sFilters, i)
            s_sig = array.get(sSigs, i)
            s_lbl = array.get(sLabels, i)
            u_lbl = str.upper(s_lbl)
            
            // Check if level is too close to a core tactical plan band to avoid duplicates
            float emVal = not na(st_EU) and not na(st_EL) ? (st_EU - st_EL) / 2.0 : na
            float tol = not na(emVal) ? emVal * 0.01 : s_lv * 0.0001
            isCore = f_isNear(s_lv, st_ShortTrig, tol) or f_isNear(s_lv, st_LongTrig, tol) or 
                     f_isNear(s_lv, st_ShortTgt, tol)  or f_isNear(s_lv, st_LongTgt, tol)  or 
                     f_isNear(s_lv, st_ShortInv, tol)  or f_isNear(s_lv, st_LongInv, tol)  or 
                     f_isNear(s_lv, st_OGT, tol)
            
            if isCore
                continue
                
            isTactical = str.contains(u_lbl, "0D") or str.contains(u_lbl, "LOC") or str.contains(u_lbl, "DEX") or str.contains(u_lbl, "CLIFF")
            passProx = i_proxFilter <= 0.0 or ((math.abs(s_lv - close) / close) * 100.0 <= i_proxFilter)
            
            color ghostColor = C_GHOST
            color ghostTextColor = #CBD5E1
            ln = line.new(sessionStartBar, s_lv, bar_index, s_lv, color = passProx ? color.new(ghostColor, 60) : na, width = 1, style = line.style_dotted)
            array.push(allLines, ln)
            array.push(dyn_isTactical, isTactical)
            array.push(dyn_lineColor, ghostColor)

            if i_showLabels
                mg = syminfo.mintick * i_minLabelGapTicks
                lc = f_assignLabelColumn(s_lv, colLastPrices, mg, i_maxLabelCols)
                if lc >= 0
                    dispTxt = s_lbl
                    if i_showPriceInLabel
                        dispTxt := dispTxt + " (" + str.tostring(s_lv, "#.##") + ")"
                    lblBg = color.new(C_LABEL_BG, 100 - i_labelBgOpacity)
                    lb = label.new(bar_index + i_labelOffset, s_lv, dispTxt, 
                        textcolor = passProx ? ghostTextColor : na, 
                        color = passProx ? lblBg : na, 
                        style = label.style_label_left, 
                        size = f_labelSize(i_labelSize),
                        tooltip = "Secondary options open interest node. Acts as minor intraday friction or a speed-bump where a tracking move might briefly stall or bounce.")
                    array.push(allLabels, lb)
                    array.push(labelCols, lc)
                    array.push(dyn_lblTactical, isTactical)
                    array.push(dyn_lblTextColor, ghostTextColor)
                    array.push(dyn_lblBgColor, lblBg)

        // Draw Shaded Execution Bands explicitly with custom tooltips
        f_drawExecutionBand(st_ShortTrig, "► SHORT ENTRY TRIGGER (5-Min Acceptance)", C_BEAR, 
            "Price breaking below this band indicates sellers are seizing control. Look for a short entry if a 5-minute candle closes beneath this zone.")
        
        f_drawExecutionBand(st_LongTrig, "► LONG ENTRY TRIGGER (5-Min Acceptance)", C_BULL, 
            "Price breaking above this band indicates buyers are seizing control. Look for a long entry if a 5-minute candle closes over this zone.")
        
        f_drawExecutionBand(st_ShortTgt, "🎯 TARGET 1 (Scale / Take Profit)", C_TARGET, 
            "A primary institutional liquidity target. Expect profit-taking and counter-trend orders here. Scale out of active contracts immediately.")
        
        f_drawExecutionBand(st_LongTgt, "🎯 TARGET 1 (Scale / Take Profit)", C_TARGET, 
            "A primary institutional liquidity target. Expect profit-taking and counter-trend orders here. Scale out of active contracts immediately.")
        
        f_drawExecutionBand(st_ShortInv, "❌ INVALIDATION (Structure Broken - Exit Trade)", C_INVALIDATION, 
            "The structural boundary for active trades. If price trades past this marker, the day's trend thesis is mathematically proven wrong. Close losing positions immediately.")
        
        f_drawExecutionBand(st_LongInv, "❌ INVALIDATION (Structure Broken - Exit Trade)", C_INVALIDATION, 
            "The structural boundary for active trades. If price trades past this marker, the day's trend thesis is mathematically proven wrong. Close losing positions immediately.")
        
        f_drawExecutionBand(st_OGT, "🎯 OPENING GAP TARGET (Expect Reversal)", C_OGT, 
            "The institutional overnight delta imbalance settlement target. Price is mechanically pulled toward this band during the opening 30 minutes. High probability of reversal once touched.")

// Realtime Line / Label Extension
if barstate.islast
    if array.size(allLines) > 0
        for i = 0 to array.size(allLines) - 1
            ln = array.get(allLines, i)
            line.set_x2(ln, bar_index)
            if i_proxFilter > 0.0
                lv = line.get_y1(ln)
                passProx = ((math.abs(lv - close) / close) * 100.0 <= i_proxFilter)
                line.set_color(ln, passProx ? array.get(dyn_lineColor, i) : na)
            else
                line.set_color(ln, array.get(dyn_lineColor, i))
            
    if array.size(allLabels) > 0
        for i = 0 to array.size(allLabels) - 1
            lb = array.get(allLabels, i)
            c = i < array.size(labelCols) ? array.get(labelCols, i) : 0
            label.set_x(lb, bar_index + i_labelOffset + (c * i_columnStepBars))
            if i_proxFilter > 0.0
                lv = label.get_y(lb)
                passProx = ((math.abs(lv - close) / close) * 100.0 <= i_proxFilter)
                label.set_textcolor(lb, passProx ? array.get(dyn_lblTextColor, i) : na)
                label.set_color(lb, passProx ? array.get(dyn_lblBgColor, i) : na)
            else
                label.set_textcolor(lb, array.get(dyn_lblTextColor, i))
                label.set_color(lb, array.get(dyn_lblBgColor, i))

// ═══════════════════════════════════════════════════════════════════════
// HUD TABLE OVERHAUL
// ═══════════════════════════════════════════════════════════════════════

var table dash = na
if barstate.isfirst
    dash := table.new(f_pos(i_dashPos), 4, 5, bgcolor = color.new(#151924, 100 - i_dashBgOpacity), border_width = 1, border_color = #2A2E39)

if barstate.islast and i_showDash
    tSz = f_labelSize(i_dashSize)
    table.clear(dash, 0, 0, 3, 4)
    
    labelTxt = color.new(#9098AA, 0)
    
    // Row 0: Live State Banner (Spans all 4 columns)
    string bannerText = "🔄 MARKET IS BALANCED | CHOP RISK HIGH | SCALP ONLY"
    color bannerBg = color.new(#24324A, 30) // Slate
    
    if not na(st_ShortTrig) and close < st_ShortTrig
        bannerText := "🚨 SELLING EXPANSION ACTIVE | DO NOT BUY THE DIP | TREND-FOLLOW SHORT ONLY"
        bannerBg := color.new(#7F1D1D, 30)
    else if not na(st_LongTrig) and close > st_LongTrig
        bannerText := "🚀 BUYING EXPANSION ACTIVE | DO NOT SHORT THE RALLY | HOLD LONGS ONLY"
        bannerBg := color.new(#064E3B, 30)
        
    table.cell(dash, 0, 0, bannerText, text_color = color.white, text_size = tSz, bgcolor = bannerBg)
    table.merge_cells(dash, 0, 0, 3, 0)
    
    // Row 1: Short Trigger | Long Trigger
    table.cell(dash, 0, 1, "Short Trigger", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 1, 1, f_num(st_ShortTrig), text_color = C_BEAR, text_size = tSz)
    table.cell(dash, 2, 1, "Long Trigger", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 3, 1, f_num(st_LongTrig), text_color = C_BULL, text_size = tSz)
    
    // Row 2: Short Target | Long Target
    table.cell(dash, 0, 2, "Short Target", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 1, 2, f_num(st_ShortTgt), text_color = C_BEAR, text_size = tSz)
    table.cell(dash, 2, 2, "Long Target", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 3, 2, f_num(st_LongTgt), text_color = C_BULL, text_size = tSz)
    
    // Row 3: Short Invalidation | Long Invalidation
    table.cell(dash, 0, 3, "Short Invalidation", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 1, 3, f_num(st_ShortInv), text_color = C_BEAR, text_size = tSz)
    table.cell(dash, 2, 3, "Long Invalidation", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 3, 3, f_num(st_LongInv), text_color = C_BULL, text_size = tSz)
    
    // Row 4: Opening Gap Target | Gamma Magnet
    table.cell(dash, 0, 4, "Opening Gap Target", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 1, 4, f_num(st_OGT), text_color = C_OGT, text_size = tSz)
    table.cell(dash, 2, 4, "Gamma Magnet", text_color = labelTxt, text_size = tSz)
    table.cell(dash, 3, 4, f_num(st_MAG), text_color = C_MAGNET, text_size = tSz)

if barstate.islast and not i_showDash and not na(dash)
    table.clear(dash, 0, 0, 3, 4)
