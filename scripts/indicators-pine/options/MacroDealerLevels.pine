// MacroDealerLevels.pine v1.0
// ======================
// Superset of DealerLevels: Standard Dealer Levels + Weekly Macro HTF Levels.
// Dual text-area inputs with independent visibility toggles.

// Format: TICKER:STRIKE:FILTER|SIG|LABEL, STRIKE:FILTER|SIG|LABEL, ...
//   FILTER: W (Wall), A (Anchor), I (Inflection), X (Other)
//   SIG:    P (Primary), S (Secondary), C (Context)
//   LABEL:  Human-readable compact text

//@version=6
indicator("Macro Dealer Levels Auto", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

