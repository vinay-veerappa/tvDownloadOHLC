// ======================
// Scored/unified levels indicator.

// Format: TICKER:STRIKE:FILTER|SIG|LABEL, STRIKE:FILTER|SIG|LABEL, ...
//   FILTER: W (Wall), A (Anchor), I (Inflection), X (Other)
//   SIG:    P (Primary), S (Secondary), C (Context)
//   LABEL:  Human-readable compact text

//@version=6
indicator("Macro Dealer Levels Auto", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════

var string GRP_DATA = "Data Buffers"
i_pastedScored  = input.text_area("", "Paste Unified Levels (unified_levels.txt recommended)", group = GRP_DATA)


var string GRP_MATCH = "Symbol Matching"
i_familyPref    = input.string("Auto", "Family Source Preference", options = ["Auto", "Prefer Index", "Prefer ETF"], group = GRP_MATCH)
i_overrideExact = input.bool(false, "Override Exact Match With Family Preference", group = GRP_MATCH)

var string GRP_CONV = "ETF Conversion"
i_convCaptureMode = input.string("Both", "Capture ETF Ratio On", options = ["RTH Open", "RTH Close", "Both"], group = GRP_CONV, tooltip = "When to snapshot ETF->futures conversion ratio using ETF regular session events.")

var string GRP_FILT = "Level Filters"
i_proxFilter        = input.float(1.5, "Hide Tactical Levels > X% Away (0=Off)", step=0.5, group=GRP_FILT, tooltip="Applies to tactical scored levels (0D, LOC, DEX, CLIFF).")

var string GRP_LINES = "Line Style"
i_showEmFill        = input.bool(false, "Show EM Fill", group = GRP_LINES)
i_lineWidthPrimary  = input.int(2, "Primary Width", minval = 1, maxval = 4, group = GRP_LINES)
i_lineWidthSecondary= input.int(1, "Secondary Width", minval = 1, maxval = 4, group = GRP_LINES)
i_showGammaFlip     = input.bool(true, "Show Gamma Flip Fill", group = GRP_LINES)

var string GRP_COLORS = "Theme Colors (Light/Dark Ready)"
i_colUpperEM        = input.color(color.new(#00FFFF, 0), "Upper EM", group = GRP_COLORS) // Aqua
i_colZeroGamma      = input.color(color.new(#FFFF00, 0), "Zero Gamma", group = GRP_COLORS) // Yellow
i_colLowerEM        = input.color(color.new(#00FFFF, 0), "Lower EM", group = GRP_COLORS)
i_colGammaMagnet    = input.color(color.new(#EE82EE, 0), "Gamma Magnet", group = GRP_COLORS) // Violet
i_colPinStrike      = input.color(color.new(#EE82EE, 30), "Pin Strike", group = GRP_COLORS)
i_colEmFill         = input.color(color.new(#00FFFF, 92), "EM Fill", group = GRP_COLORS)
i_colGammaFlipFill  = input.color(color.new(#FFFF00, 92), "Gamma Flip Fill", group = GRP_COLORS)

// ─────────────────────────────────────────────────────────────────────
// 2. COLOR INPUTS — Add a new group after GRP_COLORS:
// ─────────────────────────────────────────────────────────────────────

var string GRP_SCORED = "Scored Level Theme"
i_colWallCall   = input.color(color.new(#00FF00, 0),  "Wall: Call Side",      group = GRP_SCORED)
i_colWallPut    = input.color(color.new(#FF4444, 0),  "Wall: Put Side",       group = GRP_SCORED)
i_colAnchor     = input.color(color.new(#FFD700, 0),  "Structural Anchor",    group = GRP_SCORED)
i_colAnchorCrit = input.color(color.new(#FF6600, 0),  "Anchor (Critical)",    group = GRP_SCORED)
i_colInflFlip   = input.color(color.new(#FFFFFF, 0),  "Inflection: Flip",     group = GRP_SCORED)
i_colInflCliff  = input.color(color.new(#008080, 0),  "Inflection: Cliff",    group = GRP_SCORED)
i_colInflVoid   = input.color(color.new(#9966FF, 0),  "Inflection: Void",     group = GRP_SCORED)
i_colInflMagnet = input.color(color.new(#EE82EE, 0),  "Inflection: Magnet",   group = GRP_SCORED)

var string GRP_LABELS = "Label Collision & Display"
i_showLabels        = input.bool(true, "Show Labels", group = GRP_LABELS)
i_showPriceInLabel  = input.bool(true, "Show Price In Label", group = GRP_LABELS)
i_compactLabels     = input.bool(true, "Compact Label Text", group = GRP_LABELS)
i_mergeSamePrice    = input.bool(true, "Merge Same-Price Labels", group = GRP_LABELS)
i_mergeTolerance    = input.float(1.0, "Merge Tolerance (Points)", step=0.5, group=GRP_LABELS, tooltip="Combines levels within this many points of each other.")
i_labelSize         = input.string("tiny", "Label Size", options = ["tiny", "small", "normal", "large"], group = GRP_LABELS)
i_labelOffset       = input.int(2, "Label Offset", minval = 0, maxval = 50, group = GRP_LABELS)
i_labelBgOpacity    = input.int(95, "Label Bg Opacity", minval = 0, maxval = 100, group = GRP_LABELS)
i_labelCollision    = input.string("Stagger", "Collision Mode", options = ["Stagger", "Hide", "Off"], group = GRP_LABELS)
i_maxLabelCols      = input.int(4, "Max Columns", minval = 1, maxval = 10, group = GRP_LABELS)
i_columnStepBars    = input.int(2, "Column Step Bars", minval = 1, maxval = 20, group = GRP_LABELS)
i_minLabelGapTicks  = input.int(40, "Min Gap (ticks)", minval = 1, maxval = 500, group = GRP_LABELS)

var string GRP_DASH = "Dashboard"
i_showDash          = input.bool(true, "Show Dashboard", group = GRP_DASH)
i_dashPos           = input.string("Bottom Right", "Position", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = GRP_DASH)
i_dashSize          = input.string("small", "Text Size", options = ["tiny", "small", "normal", "large"], group = GRP_DASH)
i_dashBgOpacity     = input.int(95, "Bg Opacity", minval = 0, maxval = 100, group = GRP_DASH)

var string GRP_VIS = "Level Filters"
i_showEM            = input.bool(true, "Show EM Levels", group = GRP_VIS)

var string GRP_DEBUG = "Debug"
i_debugLogs         = input.bool(false, "Enable Debug Logs", group = GRP_DEBUG)

// ═══════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════

f_labelSize(string s) => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : size.large
f_dbg(string msg) =>
    if i_debugLogs
        log.info(msg)

f_pos(string s) =>
    s == "Top Left" ? position.top_left : s == "Top Center" ? position.top_center : s == "Top Right" ? position.top_right :
     s == "Middle Left" ? position.middle_left : s == "Middle Center" ? position.middle_center : s == "Middle Right" ? position.middle_right :
     s == "Bottom Left" ? position.bottom_left : s == "Bottom Center" ? position.bottom_center : position.bottom_right

f_norm(string v) => str.upper(str.trim(v))

f_stripPrefix(string v) =>
    t = f_norm(v)
    str.startswith(t, "/") ? str.substring(t, 1, str.length(t)) : t

f_stripContinuousSuffix(string v) =>
    c = f_stripPrefix(v)
    l = str.length(c)
    l > 2 and str.endswith(c, "!") ? str.substring(c, 0, l - 2) : c

f_primarySymbol() =>
    r = f_stripPrefix(syminfo.root)
    t = f_stripPrefix(syminfo.ticker)
    str.length(r) > 0 ? r : t

f_canonicalSymbol(string s) =>
    c = f_stripContinuousSuffix(s)
    c == "MES" ? "ES" : c == "MNQ" ? "NQ" : c == "MYM" ? "YM" : c == "M2K" ? "RTY" : c == "MGC" ? "GC" : c == "SIL" ? "SI" : c == "MCL" ? "CL" : c == "MHG" ? "HG" : c == "M6E" ? "6E" : c == "M6A" ? "6A" : c == "M6B" ? "6B" : c == "M6J" ? "6J" : c

f_symbolFamilyKey(string s) =>
    c = f_canonicalSymbol(s)
    r = c
    if c == "ES" or c == "SPX" or c == "SPY"
        r := "ES_FAMILY"
    else if c == "NQ" or c == "NDX" or c == "QQQ"
        r := "NQ_FAMILY"
    else if c == "YM" or c == "DJX" or c == "DJI" or c == "US30" or c == "DOW" or c == "DIA"
        r := "YM_FAMILY"
    else if c == "RTY" or c == "RUT" or c == "IWM"
        r := "RTY_FAMILY"
    r

f_sourceKind(string s) =>
    c = f_canonicalSymbol(s)
    c == "SPX" or c == "NDX" or c == "DJX" or c == "DJI" or c == "RUT" ? "INDEX" : c == "SPY" or c == "QQQ" or c == "DIA" or c == "IWM" ? "ETF" : "OTHER"

f_isOvernightFutures(string s) =>
    c = f_canonicalSymbol(s)
    c == "ES" or c == "NQ" or c == "YM" or c == "RTY" or c == "CL" or c == "GC" or c == "SI" or c == "HG" or c == "6E" or c == "6A" or c == "6B" or c == "6J" or c == "ZN" or c == "ZB"

// Reusable ETF -> futures conversion utilities
f_getSessionAlignedPrice(string sym, bool useClose) =>
    request.security(sym, timeframe.period, useClose ? close : open, gaps = barmerge.gaps_on, ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

f_computeEtfToFuturesRatio(string futSym, string etfSym, bool useClose) =>
    futPx = f_getSessionAlignedPrice(futSym, useClose)
    etfPx = f_getSessionAlignedPrice(etfSym, useClose)
    not na(futPx) and not na(etfPx) and math.abs(etfPx) > syminfo.mintick ? (futPx / etfPx) : na

f_captureOnOpen() => i_convCaptureMode == "RTH Open" or i_convCaptureMode == "Both"
f_captureOnClose() => i_convCaptureMode == "RTH Close" or i_convCaptureMode == "Both"

f_matchScore(string assetTag) =>
    asset = f_canonicalSymbol(assetTag)
    aFam = f_symbolFamilyKey(asset)
    primary = f_canonicalSymbol(f_primarySymbol())
    pFam = f_symbolFamilyKey(primary)
    ticker = f_canonicalSymbol(syminfo.ticker)
    tFam = f_symbolFamilyKey(ticker)
    root = f_canonicalSymbol(syminfo.root)
    rFam = f_symbolFamilyKey(root)
    exact = asset == ticker or asset == root or asset == primary
    family = aFam == tFam or aFam == rFam or aFam == pFam
    eBase = i_overrideExact and i_familyPref != "Auto" ? 120 : 200
    fBase = family ? 100 : 0
    boost = 0
    if family and i_familyPref != "Auto"
        k = f_sourceKind(asset)
        if i_familyPref == "Prefer ETF" and k == "ETF"
            boost := 30
        else if i_familyPref == "Prefer Index" and k == "INDEX"
            boost := 30
    exact ? eBase : (fBase + boost)

f_num(float v) => na(v) ? "—" : str.tostring(v, "#.##")
f_dashNum(float v) =>
    av = math.abs(v)
    na(v) ? "—" :
     av >= 1000000000 ? str.tostring(v / 1000000000.0, "#.#") + "B" :
     av >= 1000000 ? str.tostring(v / 1000000.0, "#.#") + "M" :
     av >= 1000 ? str.tostring(v / 1000.0, "#.#") + "K" :
     str.tostring(v, "#.##")
f_wrapIndex(string src, int baseWidth) =>
    splitIdx = math.min(baseWidth, str.length(src))
    if str.length(src) > baseWidth
        window = str.substring(src, baseWidth, math.min(baseWidth + 24, str.length(src)))
        spacePos = str.pos(window, " ")
        if not na(spacePos)
            splitIdx := baseWidth + spacePos
    splitIdx
f_regimeShort(string regime) =>
    regime == "BATTLE_ZONE" ? "BATTLE ZONE" :
     regime == "PINNED" ? "PIN" :
     regime == "COILED" ? "COIL" :
     regime == "EXPANSION" ? "EXPANSION" : regime
f_biasShort(string bias) =>
    bias == "BULLISH" ? "BULLISH" : bias == "BEARISH" ? "BEARISH" : "NEUTRAL"
f_pick(float v1, float v2, float v3) => not na(v1) ? v1 : (not na(v2) ? v2 : v3)
f_isNear(float value, float ref, float thr) => not na(value) and not na(ref) and math.abs(value - ref) <= thr

f_nearestBelow(float ref, float v1, float v2, float v3) =>
    float b = na
    if not na(ref)
        if not na(v1) and v1 < ref and (na(b) or v1 > b)
            b := v1
        if not na(v2) and v2 < ref and (na(b) or v2 > b)
            b := v2
        if not na(v3) and v3 < ref and (na(b) or v3 > b)
            b := v3
    na(b) ? f_pick(v1, v2, v3) : b

f_nearestAbove(float ref, float v1, float v2, float v3) =>
    float b = na
    if not na(ref)
        if not na(v1) and v1 > ref and (na(b) or v1 < b)
            b := v1
        if not na(v2) and v2 > ref and (na(b) or v2 < b)
            b := v2
        if not na(v3) and v3 > ref and (na(b) or v3 < b)
            b := v3
    na(b) ? f_pick(v1, v2, v3) : b

f_bestShortTrigger(float spot, float thr, float v1, float v2, float v3, float v4, float v5) =>
    float b = na
    if f_isNear(v1, spot, thr) and (na(b) or v1 > b)
        b := v1
    if f_isNear(v2, spot, thr) and (na(b) or v2 > b)
        b := v2
    if f_isNear(v3, spot, thr) and (na(b) or v3 > b)
        b := v3
    if f_isNear(v4, spot, thr) and (na(b) or v4 > b)
        b := v4
    if f_isNear(v5, spot, thr) and (na(b) or v5 > b)
        b := v5
    na(b) ? f_pick(v1, v2, v3) : b

f_bestLongTrigger(float spot, float thr, float v1, float v2, float v3, float v4, float v5) =>
    float b = na
    if f_isNear(v1, spot, thr) and (na(b) or v1 < b)
        b := v1
    if f_isNear(v2, spot, thr) and (na(b) or v2 < b)
        b := v2
    if f_isNear(v3, spot, thr) and (na(b) or v3 < b)
        b := v3
    if f_isNear(v4, spot, thr) and (na(b) or v4 < b)
        b := v4
    if f_isNear(v5, spot, thr) and (na(b) or v5 < b)
        b := v5
    na(b) ? f_pick(v1, v2, v3) : b

f_extractAssetTag(string lineText) =>
    tokens = str.split(lineText, ",")
    asset = ""
    if array.size(tokens) > 0
        fp = str.split(str.trim(array.get(tokens, 0)), ":")
        if array.size(fp) >= 3
            asset := f_stripPrefix(array.get(fp, 0))
    asset

f_findMatchingLine(string blob) =>
    string mL = ""
    string mA = ""
    int bs = 0
    rows = str.split(blob, "\n")
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            row = str.trim(array.get(rows, i))
            if str.length(row) > 0 and str.contains(row, ",")
                a = f_extractAssetTag(row)
                sc = f_matchScore(a)
                if str.length(a) > 0 and sc > bs
                    mL := row
                    mA := a
                    bs := sc
    [mL, mA]

