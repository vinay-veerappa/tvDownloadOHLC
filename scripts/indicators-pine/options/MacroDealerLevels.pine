// ═══════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════

f_labelSize(string s) => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : size.large
f_lineStyle(string s) => s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted
f_pos(string s) =>
    s == "Top Left" ? position.top_left : s == "Top Center" ? position.top_center : s == "Top Right" ? position.top_right :
     s == "Middle Left" ? position.middle_left : s == "Middle Center" ? position.middle_center : s == "Middle Right" ? position.middle_right :
     s == "Bottom Left" ? position.bottom_left : s == "Bottom Center" ? position.bottom_center : position.bottom_right

f_norm(string v) => str.upper(str.trim(v))

f_stripPrefix(string v) =>
    t = f_norm(v)
    str.startswith(t, "/") ? str.substring(t, 1, str.length(t)) : t

f_stripContinuousSuffix(string v) =>
    c = f_stripPrefix(v)
    l = str.length(c)
    l > 2 and str.endswith(c, "!") ? str.substring(c, 0, l - 2) : c

f_primarySymbol() =>
    r = f_stripPrefix(syminfo.root)
    t = f_stripPrefix(syminfo.ticker)
    str.length(r) > 0 ? r : t

f_canonicalSymbol(string s) =>
    c = f_stripContinuousSuffix(s)
    c == "MES" ? "ES" : c == "MNQ" ? "NQ" : c == "MYM" ? "YM" : c == "M2K" ? "RTY" : c == "MGC" ? "GC" : c == "SIL" ? "SI" : c == "MCL" ? "CL" : c == "MHG" ? "HG" : c == "M6E" ? "6E" : c == "M6A" ? "6A" : c == "M6B" ? "6B" : c == "M6J" ? "6J" : c

f_symbolFamilyKey(string s) =>
    c = f_canonicalSymbol(s)
    r = c
    if c == "ES" or c == "SPX" or c == "SPY"
        r := "ES_FAMILY"
    else if c == "NQ" or c == "NDX" or c == "QQQ"
        r := "NQ_FAMILY"
    else if c == "YM" or c == "DJX" or c == "DJI" or c == "US30" or c == "DOW" or c == "DIA"
        r := "YM_FAMILY"
    else if c == "RTY" or c == "RUT" or c == "IWM"
        r := "RTY_FAMILY"
    r

f_sourceKind(string s) =>
    c = f_canonicalSymbol(s)
    c == "SPX" or c == "NDX" or c == "DJX" or c == "DJI" or c == "RUT" ? "INDEX" : c == "SPY" or c == "QQQ" or c == "DIA" or c == "IWM" ? "ETF" : "OTHER"

f_isOvernightFutures(string s) =>
    c = f_canonicalSymbol(s)
    c == "ES" or c == "NQ" or c == "YM" or c == "RTY" or c == "CL" or c == "GC" or c == "SI" or c == "HG" or c == "6E" or c == "6A" or c == "6B" or c == "6J" or c == "ZN" or c == "ZB"

f_matchScore(string assetTag) =>
    asset = f_canonicalSymbol(assetTag)
    aFam = f_symbolFamilyKey(asset)
    primary = f_canonicalSymbol(f_primarySymbol())
    pFam = f_symbolFamilyKey(primary)
    ticker = f_canonicalSymbol(syminfo.ticker)
    tFam = f_symbolFamilyKey(ticker)
    root = f_canonicalSymbol(syminfo.root)
    rFam = f_symbolFamilyKey(root)
    exact = asset == ticker or asset == root or asset == primary
    family = aFam == tFam or aFam == rFam or aFam == pFam
    eBase = i_overrideExact and i_familyPref != "Auto" ? 120 : 200
    fBase = family ? 100 : 0
    boost = 0
    if family and i_familyPref != "Auto"
        k = f_sourceKind(asset)
        if i_familyPref == "Prefer ETF" and k == "ETF"
            boost := 30
        else if i_familyPref == "Prefer Index" and k == "INDEX"
            boost := 30
    exact ? eBase : (fBase + boost)

f_num(float v) => na(v) ? "—" : str.tostring(v, "#.##")
f_pick(float v1, float v2, float v3) => not na(v1) ? v1 : (not na(v2) ? v2 : v3)
f_isNear(float value, float ref, float thr) => not na(value) and not na(ref) and math.abs(value - ref) <= thr

f_nearestBelow(float ref, float v1, float v2, float v3) =>
    float b = na
    if not na(ref)
        if not na(v1) and v1 < ref and (na(b) or v1 > b)
            b := v1
        if not na(v2) and v2 < ref and (na(b) or v2 > b)
            b := v2
        if not na(v3) and v3 < ref and (na(b) or v3 > b)
            b := v3
    na(b) ? f_pick(v1, v2, v3) : b

f_nearestAbove(float ref, float v1, float v2, float v3) =>
    float b = na
    if not na(ref)
        if not na(v1) and v1 > ref and (na(b) or v1 < b)
            b := v1
        if not na(v2) and v2 > ref and (na(b) or v2 < b)
            b := v2
        if not na(v3) and v3 > ref and (na(b) or v3 < b)
            b := v3
    na(b) ? f_pick(v1, v2, v3) : b

f_bestShortTrigger(float spot, float thr, float v1, float v2, float v3, float v4, float v5) =>
    float b = na
    if f_isNear(v1, spot, thr) and (na(b) or v1 > b)
        b := v1
    if f_isNear(v2, spot, thr) and (na(b) or v2 > b)
        b := v2
    if f_isNear(v3, spot, thr) and (na(b) or v3 > b)
        b := v3
    if f_isNear(v4, spot, thr) and (na(b) or v4 > b)
        b := v4
    if f_isNear(v5, spot, thr) and (na(b) or v5 > b)
        b := v5
    na(b) ? f_pick(v1, v2, v3) : b

f_bestLongTrigger(float spot, float thr, float v1, float v2, float v3, float v4, float v5) =>
    float b = na
    if f_isNear(v1, spot, thr) and (na(b) or v1 < b)
        b := v1
    if f_isNear(v2, spot, thr) and (na(b) or v2 < b)
        b := v2
    if f_isNear(v3, spot, thr) and (na(b) or v3 < b)
        b := v3
    if f_isNear(v4, spot, thr) and (na(b) or v4 < b)
        b := v4
    if f_isNear(v5, spot, thr) and (na(b) or v5 < b)
        b := v5
    na(b) ? f_pick(v1, v2, v3) : b

f_extractAssetTag(string lineText) =>
    tokens = str.split(lineText, ",")
    asset = ""
    if array.size(tokens) > 0
        fp = str.split(str.trim(array.get(tokens, 0)), ":")
        if array.size(fp) >= 3
            asset := f_stripPrefix(array.get(fp, 0))
    asset

f_findMatchingLine(string blob) =>
    string mL = ""
    string mA = ""
    int bs = 0
    rows = str.split(blob, "\n")
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            row = str.trim(array.get(rows, i))
            if str.length(row) > 0 and str.contains(row, ",")
                a = f_extractAssetTag(row)
                sc = f_matchScore(a)
                if str.length(a) > 0 and sc > bs
                    mL := row
                    mA := a
                    bs := sc
    [mL, mA]

var string st_Regime = "NEUTRAL"
var string st_Bias = "NEUTRAL"
var string st_Note = "No tactical briefing loaded."
var float st_ShortTrig = na
var float st_LongTrig = na
var float st_ShortTgt = na
var float st_LongTgt = na
var float st_ShortInv = na
var float st_LongInv = na
var float st_Vanna = 0.0
var float st_Speed = 0.0
var float st_Charm = 0.0
var float st_GEX_DA = 0.0
var float st_TotalGEX = 0.0
var float st_IV = 0.0
var float st_IVChg = 0.0
var float st_Skew = 0.0
var float st_Stability = 0.0
var float st_Integrity = 0.0
var float st_VolExpUp = na
var float st_VolExpDn = na



f_parseLevels(string lineText, array<float> prices, array<string> titles) =>
    array.clear(prices)
    array.clear(titles)
    tokens = str.split(lineText, ",")
    if array.size(tokens) > 0
        for i = 0 to array.size(tokens) - 1
            token = str.trim(array.get(tokens, i))
            parts = str.split(token, ":")
            string px = ""
            string ti = ""
            if i == 0
                if array.size(parts) >= 3
                    px := str.trim(array.get(parts, 1))
                    ti := str.trim(array.get(parts, 2))
            else
                if array.size(parts) >= 2
                    px := str.trim(array.get(parts, 0))
                    ti := str.trim(array.get(parts, 1))
            
            // Skip Metadata in levels arrays
            if str.startswith(ti, "META_")
                continue

            lv = math.round_to_mintick(str.tonumber(px))
            if not na(lv) and str.length(ti) > 0
                array.push(prices, lv)
                array.push(titles, ti)

f_parseScoredLevels(string lineText, 
    array<float> prices, array<string> filters, 
    array<string> sigs, array<string> labels) =>
    array.clear(prices)
    array.clear(filters)
    array.clear(sigs)
    array.clear(labels)
    tokens = str.split(lineText, ",")
    if array.size(tokens) > 0
        for i = 0 to array.size(tokens) - 1
            token = str.trim(array.get(tokens, i))
            parts = str.split(token, ":")
            string px = ""
            string raw_label = ""
            if i == 0
                // First token: TICKER:PRICE:FILTER|SIG|LABEL
                if array.size(parts) >= 3
                    px := str.trim(array.get(parts, 1))
                    raw_label := str.trim(array.get(parts, 2))
            else
                // Subsequent: PRICE:FILTER|SIG|LABEL
                if array.size(parts) >= 2
                    px := str.trim(array.get(parts, 0))
                    raw_label := str.trim(array.get(parts, 1))
            lv = math.round_to_mintick(str.tonumber(px))
            if not na(lv) and str.length(raw_label) > 0
                // Split FILTER|SIG|LABEL
                meta = str.split(raw_label, "|")
                if array.size(meta) >= 3
                    array.push(prices, lv)
                    array.push(filters, str.trim(array.get(meta, 0)))
                    array.push(sigs, str.trim(array.get(meta, 1)))
                    array.push(labels, str.trim(array.get(meta, 2)))



// ═══════════════════════════════════════════════════════════════════════
// STYLING & FILTERING
// ═══════════════════════════════════════════════════════════════════════

f_levelColor(string title) =>
    u = f_norm(title)
    str.contains(u, "UPPER EM") ? i_colUpperEM : 
     str.contains(u, "LOWER EM") ? i_colLowerEM : 
     u == "ZERO GAMMA" ? i_colZeroGamma :
     u == "MACRO CALL WALL" ? i_colMacroCall :
     u == "MACRO PUT WALL" ? i_colMacroPut :
     str.contains(u, "GOLDEN SWEEP") ? color.new(#FFD700, 0) :
     str.contains(u, "WHALE CALL") ? i_colWhaleCall :
     str.contains(u, "WHALE PUT") ? i_colWhalePut :
     u == "GAMMA FLIP UPPER" or u == "GAMMA FLIP LOWER" ? i_colGammaFlip :
     u == "GAMMA CLIFF UP" ? i_colGammaCliffUp : 
     u == "GAMMA CLIFF DOWN" ? i_colGammaCliffDn :
     u == "MAX PAIN" ? i_colMaxPain : 
     u == "HEDGE WALL" ? i_colHedge :
     u == "0DTE PUT WALL" ? i_col0DTEPut : u == "LOCAL PUT NODE" ? i_colLocalPut : u == "DEX PUT NODE" ? i_colDexPut :
     u == "0DTE CALL WALL" ? i_col0DTECall : u == "LOCAL CALL NODE" ? i_colLocalCall : u == "DEX CALL NODE" ? i_colDexCall :
     str.contains(u, "CALL ABS") or u == "ABSOLUTE CALL WALL" or str.contains(u, "MAJOR CALL") ? i_colAbsCall : 
     str.contains(u, "PUT ABS") or u == "ABSOLUTE PUT WALL" or str.contains(u, "MAJOR PUT") ? i_col0DTEPut :
     u == "GAMMA MAGNET" ? i_colGammaMagnet : 
     u == "PIN STRIKE" ? i_colPinStrike : 
     i_colFallback

f_levelStyle(string title) =>
    u = f_norm(title)
    str.contains(u, "GAMMA FLIP") ? line.style_dashed : 
     str.contains(u, "GAMMA CLIFF") ? line.style_dotted :
     str.contains(u, "WHALE") ? line.style_dashed :
     str.contains(u, "DEX") ? line.style_dashed : 
     u == "GAMMA MAGNET" or u == "PIN STRIKE" ? line.style_dotted :
     str.contains(u, "0DTE") ? f_lineStyle(i_lineStyle0DTE) : 
     str.contains(u, "EM") ? line.style_solid : 
     str.contains(u, "MACRO") ? f_lineStyle(i_lineStylePrimary) :
     str.contains(u, "LOCAL") ? f_lineStyle(i_lineStyleSecondary) : 
     f_lineStyle(i_lineStylePrimary)

f_levelWidth(string title) =>
    u = f_norm(title)
    isEm = str.contains(u, "EM")
    isPrimaryEm = u == "UPPER EM" or u == "LOWER EM"
    isMacro = str.contains(u, "MACRO") or str.contains(u, "MAJOR")
    str.contains(u, "WHALE") or str.contains(u, "0DTE") or str.contains(u, "LOCAL") or str.contains(u, "GAMMA FLIP") or str.contains(u, "GAMMA CLIFF") or str.contains(u, "DEX") or u == "GAMMA MAGNET" or u == "PIN STRIKE" or (isEm and not isPrimaryEm) ? i_lineWidthSecondary : (isMacro ? i_lineWidthPrimary : i_lineWidthPrimary)

f_compactTitle(string title) =>
    u = f_norm(title)
    res = title
    if str.contains(u, "UPPER EM")
        res := "EM+"
    else if str.contains(u, "LOWER EM")
        res := "EM-"
    else if str.contains(u, "MAJOR CALL NODE")
        res := str.replace(u, "MAJOR CALL NODE", "MAJ C")
    else if str.contains(u, "MAJOR PUT NODE")
        res := str.replace(u, "MAJOR PUT NODE", "MAJ P")
    else if u == "MACRO CALL WALL"
        res := "MAC CALL"
    else if u == "MACRO PUT WALL"
        res := "MAC PUT"
    else if str.contains(u, "GOLDEN SWEEP: LOCAL WHALE")
        res := str.replace(u, "GOLDEN SWEEP: LOCAL WHALE ", "GS-LW-")
    else if str.contains(u, "GOLDEN SWEEP: WHALE")
        res := str.replace(u, "GOLDEN SWEEP: WHALE ", "GS-W-")
    else if str.contains(u, "LOCAL WHALE")
        res := str.replace(u, "LOCAL WHALE ", "LW-")
    else if str.contains(u, "WHALE")
        res := str.replace(u, "WHALE ", "W-")
    else if u == "ABSOLUTE CALL WALL"
        res := "CALL ABS"
    else if u == "LOCAL CALL NODE"
        res := "CALL LOC"
    else if u == "0DTE CALL WALL"
        res := "CALL 0DTE"
    else if u == "DEX CALL NODE"
        res := "DEX C"
    else if u == "GAMMA FLIP UPPER"
        res := "GF U"
    else if u == "GAMMA FLIP LOWER"
        res := "GF L"
    else if u == "GAMMA CLIFF UP"
        res := "GC U"
    else if u == "ZERO GAMMA"
        res := "ZG"
    else if u == "GAMMA CLIFF DOWN"
        res := "GC D"
    else if u == "MAX PAIN"
        res := "MAX"
    else if u == "0DTE PUT WALL"
        res := "PUT 0DTE"
    else if u == "LOCAL PUT NODE"
        res := "PUT LOC"
    else if u == "DEX PUT NODE"
        res := "DEX P"
    else if u == "HEDGE WALL"
        res := "HEDGE"
    else if u == "GAMMA MAGNET"
        res := "MAG"
    else if u == "PIN STRIKE"
        res := "PIN"
    else if str.contains(u, "UPPER 85% STRADDLE")
        res :=  "EM+ 85%"
    else if str.contains(u, "LOWER 85% STRADDLE")
        res := "EM- 85%"
    //log.info("Found "+ u)
    res


f_isProtectedLevel(string title) =>
    u = f_norm(title)
    // These should remain visually distinct and should not be merged away.
    str.contains(u, "GAMMA FLIP") or str.contains(u, "GF U") or str.contains(u, "GF L") or
     str.contains(u, "GAMMA CLIFF") or str.contains(u, "GC U") or str.contains(u, "GC D")
    

f_showLevel(string title, float price) =>
    u = f_norm(title)
    bool show = true   //i_showStraddleEM
    
    // 1. Basic Type Filtering
    if str.contains(u, "EM") 
        show := i_showEM
        if show and i_maxEMDte > 0 and str.contains(u, "(") and str.contains(u, "D)")
            openParen = str.pos(u, "(")
            closeD = str.pos(u, "D)")
            if not na(openParen) and not na(closeD) and closeD > openParen + 1
                dteStr = str.substring(u, openParen + 1, closeD)
                dte = str.tonumber(dteStr)
                if not na(dte) and dte > i_maxEMDte
                    show := false
    else if str.contains(u, "STRADDLE") 
        show := i_showStraddleEM
        if show and i_maxEMDte > 0 and str.contains(u, "(") and str.contains(u, "D)")
            openParen = str.pos(u, "(")
            closeD = str.pos(u, "D)")
            if not na(openParen) and not na(closeD) and closeD > openParen + 1
                dteStr = str.substring(u, openParen + 1, closeD)
                dte = str.tonumber(dteStr)
                if not na(dte) and dte > i_maxEMDte
                    show := false        
    else if u == "GAMMA MAGNET"
        show := i_showMagnet
    else if u == "PIN STRIKE"
        show := i_showPin
    else if str.contains(u, "DEX CALL") or str.contains(u, "DEX PUT")
        show := i_showDex
    else if str.contains(u, "CALL")
        show := i_showCall
    else if str.contains(u, "PUT")
        show := i_showPut
    else if u == "ZERO GAMMA"
        show := i_showZeroGamma
    else if str.contains(u, "GAMMA FLIP")
        show := i_showGammaFlip
    else if str.contains(u, "GAMMA CLIFF")
        show := i_showGammaCliff
    else if u == "MAX PAIN"
        show := i_showMaxPain
    else if u == "HEDGE WALL"
        show := i_showHedge
        
    // 2. Smart Proximity Filtering (Only apply if the basic filter is true and setting > 0)
    if show and i_proxFilter > 0.0
        // Define what constitutes a "Tactical" level that should be hidden if far away
        isTactical = str.contains(u, "0DTE") or str.contains(u, "LOCAL") or str.contains(u, "DEX") or str.contains(u, "CLIFF")
        
        if isTactical
            // Calculate percentage distance from current spot price
            pctDistance = (math.abs(price - close) / close) * 100.0
            if pctDistance > i_proxFilter
                show := false

    show


f_scoredColor(string filter_code, string sig_code, string label_text) =>
    // Color is driven by FILTER TYPE (what kind of level)
    // plus context from the label for side detection
    u = str.upper(label_text)
    result = color.silver
    if filter_code == "W"
        // Wall: red for calls/resistance, green for puts/support
        is_put = str.contains(u, "PW") or str.contains(u, "PUT") or str.contains(u, "HW") or str.contains(u, "LOC P")
        result := is_put ? i_colWallPut : i_colWallCall
    else if filter_code == "A"
        // Anchor: gold normally, orange-red if CRIT in label
        result := str.contains(u, "CRIT") ? i_colAnchorCrit : i_colAnchor
    else if filter_code == "I"
        // Inflection: depends on inflection subtype
        result := str.contains(u, "ZERO") or str.contains(u, "FLIP") ? i_colInflFlip :
             str.contains(u, "CLIFF") ? i_colInflCliff :
             str.contains(u, "VOID") ? i_colInflVoid :
             str.contains(u, "MAGNET") ? i_colInflMagnet :
             color.white
    else if filter_code == "E"
        // Explicit expected move tracks
        is_hi = str.contains(u, "EM HI") or str.contains(u, "EM85 HI") or str.contains(u, "UPPER")
        result := is_hi ? i_colUpperEM : i_colLowerEM
    result

f_scoredStyle(string sig_code) =>
    // Style is driven by SIGNIFICANCE (how important)
    sig_code == "P" ? line.style_solid : 
     sig_code == "S" ? line.style_dashed : 
     line.style_dotted

f_scoredWidth(string sig_code) =>
    // Width is driven by SIGNIFICANCE
    sig_code == "P" ? i_lineWidthPrimary : i_lineWidthSecondary

f_scoredCompactLabel(string filter_code, string label_text) =>
    // Labels are already compact from the Python export.
    // Add a visual prefix based on filter type for quick scanning.
    prefix = filter_code == "W" ? "▌" : filter_code == "A" ? "⚓" : filter_code == "I" ? "◆" : filter_code == "E" ? "◈" : "•"
    u = str.upper(label_text)
    disp = label_text
    if str.contains(u, "EM HI")
        disp := str.replace(u, "EM HI", "EM+")
    else if str.contains(u, "EM LO")
        disp := str.replace(u, "EM LO", "EM-")
    else if str.contains(u, "EM85 HI")
        disp := str.replace(u, "EM85 HI", "EM85+")
    else if str.contains(u, "EM85 LO")
        disp := str.replace(u, "EM85 LO", "EM85-")
    prefix + " " + disp


f_assignLabelColumn(float level, array<float> cols, float gap, int maxC) =>
    int a = -1
    if i_labelCollision == "Off"
        a := 0
    else
        if array.size(cols) > 0
            for c = 0 to array.size(cols) - 1
                if math.abs(level - array.get(cols, c)) >= gap
                    a := c
                    break
        if a == -1
            if array.size(cols) < maxC
                array.push(cols, level)
                a := array.size(cols) - 1
            else if i_labelCollision == "Hide"
                a := -1
            else
                bG = -1.0
                bC = 0
                for c = 0 to array.size(cols) - 1
                    g = math.abs(level - array.get(cols, c))
                    if g > bG
                        bG := g
                        bC := c
                a := bC
    if a >= 0
        if a >= array.size(cols)
            array.push(cols, level)
        else
            array.set(cols, a, level)
    a

// ═══════════════════════════════════════════════════════════════════════
// STATE & EXECUTION
// ═══════════════════════════════════════════════════════════════════════

var string TZ = "America/New_York"
f_sessionKey() => dayofmonth(time, TZ) + month(time, TZ) * 31 + year(time, TZ) * 400
isNewSession = ta.change(f_sessionKey()) != 0
var int sessionStartBar = 0
if barstate.isfirst 
    sessionStartBar := bar_index


// { logic
bool is_recent = time >= (timenow - (86400000 * 2)) // Keeping 4 days to allow for long weekends

// Define the underlying equity ticker based on your futures contract
var string equity_ref = str.contains(syminfo.ticker, "NQ")  ? "QQQ" : 
                         str.contains(syminfo.ticker, "ES")  ? "SPY" : 
                         str.contains(syminfo.ticker, "YM")  ? "DIA" : 
                         str.contains(syminfo.ticker, "RTY") ? "IWM" : 
                         str.contains(syminfo.ticker, "SPX") ? "AMEX:SPY" : syminfo.ticker

f_getContractCost(_sym) => 
    request.security((_sym), "1D" , close, ignore_invalid_symbol=true,lookahead = barmerge.lookahead_off)


// Request the exact RTH session states from the underlying equity index
[eq_open, eq_close] = request.security(equity_ref, timeframe.period, [session.isfirstbar_regular, session.islastbar_regular], gaps = barmerge.gaps_on)

var bool can_calculate = false
var int last_open_time = 0
var int last_close_time = 0

// Trigger Open logic matching the exact equity open
if is_recent and eq_open and time != last_open_time
    last_open_time := time
    can_calculate  := true
    //useClose       := false
    sessionStartBar := bar_index
    label.new(bar_index, high, "Open", color=color.green, textcolor=color.white, style=label.style_label_down)

// Trigger Close logic matching the exact equity close
if is_recent and eq_close and time != last_close_time
    last_close_time := time
    //can_calculate   := true
    //useClose        := true
    sessionStartBar := bar_index
    label.new(bar_index, high, "Close", color=color.green, textcolor=color.white, style=label.style_label_down)



var array<line> allLines = array.new_line()
var array<label> allLabels = array.new_label()
var array<int> labelCols = array.new_int()
var array<float> colLastPrices = array.new_float()

// OPTIMIZATION: Parse pasted text only once when the script loads
var string rawDealer = ""
var string matchDealer = ""
var string rawMacro = ""
var string matchMacro = ""
var string rawScored = ""
var string matchScored = ""

// ── Global Parsed Data Caches ──
var array<float> cached_dPrices = array.new_float()
var array<string> cached_dTitles = array.new_string()

var array<float> cached_mPrices = array.new_float()
var array<string> cached_mTitles = array.new_string()

var array<float> cached_sPrices = array.new_float()
var array<string> cached_sFilters = array.new_string()
var array<string> cached_sSigs = array.new_string()
var array<string> cached_sLabels = array.new_string()


if barstate.isfirst
    [rD, mD] = f_findMatchingLine(i_pastedDealer)
    rawDealer := rD
    matchDealer := mD
    if matchDealer != "" and i_showDealer
        f_parseLevels(rawDealer, cached_dPrices, cached_dTitles)
    
    [rM, mM] = f_findMatchingLine(i_pastedMacro)
    rawMacro := rM
    matchMacro := mM
    if matchMacro != "" and i_showMacro
        f_parseLevels(rawMacro, cached_mPrices, cached_mTitles)

    [rS, mS] = f_findMatchingLine(i_pastedScored)
    rawScored := rS
    matchScored := mS
    if matchScored != "" and i_showScored
        f_parseScoredLevels(rawScored, cached_sPrices, cached_sFilters, cached_sSigs, cached_sLabels)

    // --- Metadata Parsing (Main Scope) ---
    if matchDealer != ""
        tokens = str.split(rawDealer, ",")
        if array.size(tokens) > 0
            for i = 0 to array.size(tokens) - 1
                token = str.trim(array.get(tokens, i))
                parts = str.split(token, ":")
                string ti = ""
                if i == 0
                    if array.size(parts) >= 3
                        ti := str.trim(array.get(parts, 2))
                else
                    if array.size(parts) >= 2
                        ti := str.trim(array.get(parts, 1))
                
                if str.startswith(ti, "META_")
                    if str.startswith(ti, "META_REGIME_")
                        st_Regime := str.replace(ti, "META_REGIME_", "")
                    else if str.startswith(ti, "META_BIAS_")
                        st_Bias := str.replace(ti, "META_BIAS_", "")
                    else if str.startswith(ti, "META_NOTE_")
                        st_Note := str.replace(ti, "META_NOTE_", "")
                    else if str.startswith(ti, "META_S_TRIG_")
                        st_ShortTrig := str.tonumber(str.replace(ti, "META_S_TRIG_", ""))
                    else if str.startswith(ti, "META_L_TRIG_")
                        st_LongTrig := str.tonumber(str.replace(ti, "META_L_TRIG_", ""))
                    else if str.startswith(ti, "META_S_TGT_")
                        st_ShortTgt := str.tonumber(str.replace(ti, "META_S_TGT_", ""))
                    else if str.startswith(ti, "META_L_TGT_")
                        st_LongTgt := str.tonumber(str.replace(ti, "META_L_TGT_", ""))
                    else if str.startswith(ti, "META_S_INV_")
                        st_ShortInv := str.tonumber(str.replace(ti, "META_S_INV_", ""))
                    else if str.startswith(ti, "META_L_INV_")
                        st_LongInv := str.tonumber(str.replace(ti, "META_L_INV_", ""))
                    else if str.startswith(ti, "META_VANNA_")
                        st_Vanna := str.tonumber(str.replace(ti, "META_VANNA_", ""))
                    else if str.startswith(ti, "META_SPEED_")
                        st_Speed := str.tonumber(str.replace(ti, "META_SPEED_", ""))
                    else if str.startswith(ti, "META_CHARM_")
                        st_Charm := str.tonumber(str.replace(ti, "META_CHARM_", ""))
                    else if str.startswith(ti, "META_GEX_DA_")
                        st_GEX_DA := str.tonumber(str.replace(ti, "META_GEX_DA_", ""))
                    else if str.startswith(ti, "META_GEX_TOTAL_")
                        st_TotalGEX := str.tonumber(str.replace(ti, "META_GEX_TOTAL_", ""))
                    else if str.startswith(ti, "META_IV_")
                        st_IV := str.tonumber(str.replace(ti, "META_IV_", ""))
                    else if str.startswith(ti, "META_IVCHG_")
                        st_IVChg := str.tonumber(str.replace(ti, "META_IVCHG_", ""))
                    else if str.startswith(ti, "META_SKEW_")
                        st_Skew := str.tonumber(str.replace(ti, "META_SKEW_", ""))
                    else if str.startswith(ti, "META_STABILITY_")
                        st_Stability := str.tonumber(str.replace(ti, "META_STABILITY_", ""))
                    else if str.startswith(ti, "META_INTEGRITY_")
                        st_Integrity := str.tonumber(str.replace(ti, "META_INTEGRITY_", ""))
                    else if str.startswith(ti, "META_VOL_EXPANSION_UP_")
                        st_VolExpUp := str.tonumber(str.replace(ti, "META_VOL_EXPANSION_UP_", ""))
                    else if str.startswith(ti, "META_VOL_EXPANSION_DN_")
                        st_VolExpDn := str.tonumber(str.replace(ti, "META_VOL_EXPANSION_DN_", ""))

// Redraw / Calculation State
var float st_ZG = na, var float st_MAG = na, var float st_PIN = na
var float st_CW = na, var float st_PW = na, var float st_EU = na, var float st_EL = na
var float st_GFU = na, var float st_GFL = na, var float st_GCU = na, var float st_GCD = na
var float st_CW0 = na, var float st_PW0 = na, var float st_MP = na, var float st_HW = na
var float st_LCN = na, var float st_LPN = na, var float st_DCN = na, var float st_DPN = na
var string st_Asset = ""
var float st_ANCHOR = na
var string st_ANCHOR_LABEL = ""

// Global line vars for EM and Gamma Flip fills (must be global to be used outside if blocks)
var line line_emUp = na
var line line_emDn = na
var line line_gcUp = na
var line line_gcDn = na
var bool etfConversion = false

f_clearAll() =>
    while array.size(allLines) > 0
        line.delete(array.shift(allLines))
    while array.size(allLabels) > 0
        label.delete(array.shift(allLabels))
    array.clear(labelCols)
    array.clear(colLastPrices)



var s_flt = ""
var s_sig = ""
if can_calculate
    can_calculate := false
    f_clearAll()
    st_ZG := na, st_MAG := na, st_PIN := na, st_ANCHOR := na
    st_ANCHOR_LABEL := ""
    st_CW := na, st_PW := na, st_EU := na, st_EL := na
    st_GFU := na, st_GFL := na, st_GCU := na, st_GCD := na
    st_CW0 := na, st_PW0 := na, st_MP := na, st_HW := na
    st_LCN := na, st_LPN := na, st_DCN := na, st_DPN := na
    st_ShortTrig := na, st_LongTrig := na, st_ShortInv := na, st_LongInv := na
    st_ShortTgt := na, st_LongTgt := na
    st_VolExpUp := na, st_VolExpDn := na
    st_Asset := matchDealer != "" ? matchDealer : matchMacro
    line_emUp := na
    line_emDn := na
    line_gcUp := na
    line_gcDn := na
    etfConversion := false

    // Arrays to process both sources
    srcRaw = array.new_string()
    srcShow = array.new_bool()
    if matchDealer != ""
        array.push(srcRaw, rawDealer)
        array.push(srcShow, i_showDealer)
    if matchMacro != ""
        array.push(srcRaw, rawMacro)
        array.push(srcShow, i_showMacro)
    
    if array.size(srcRaw) > 0
        for sIdx = 0 to array.size(srcRaw) - 1
            if not array.get(srcShow, sIdx)
                continue
            
            // Get cached data
            cachePrices = (array.get(srcRaw, sIdx) == rawDealer ) ? cached_dPrices : cached_mPrices 
            cacheTitles = (array.get(srcRaw, sIdx) == rawDealer ) ? cached_dTitles : cached_mTitles
            
            // ── Create local copies for this bar's processing ──
            pPrices = array.copy(cachePrices)
            pTitles = array.copy(cacheTitles)
            
            // ── Futures Anchor Scaling ──
            sC = f_canonicalSymbol(array.get(srcRaw, sIdx) == rawDealer ? matchDealer : matchMacro)
            pC = f_canonicalSymbol(f_primarySymbol())
            sF = f_symbolFamilyKey(sC)
            cF = f_symbolFamilyKey(pC)
            sFut = f_isOvernightFutures(sC)
            cFut = f_isOvernightFutures(pC)

            if cFut and sF == cF and not sFut
                // We are on a futures ticker but data is from Spot/ETF
                anc = sC == "ES" or sC == "SPX" or sC == "SPY" ? "ES" : sC == "NQ" or sC == "NDX" or sC == "QQQ" ? "NQ" : sC == "YM" or sC == "DJI" or sC == "DIA" ? "YM" : sC == "RTY" or sC == "RUT" or sC == "IWM" ? "RTY" : ""
                if anc != ""
                    if array.size(pPrices) > 0
                        sR = array.get(pPrices, 0)
                        if math.abs(sR) > syminfo.mintick
                            fs = f_getContractCost(syminfo.main_tickerid) / f_getContractCost(sC)
                            if math.abs(fs - 1.0) > 0.001 
                                for k = 0 to array.size(pPrices) - 1
                                    array.set(pPrices, k, array.get(pPrices, k) * fs)
                                etfConversion := true
            
            if array.size(pPrices) > 0
                // Temporary arrays for aggregated levels
                aggPrices = array.new_float()
                aggTitles = array.new_string()
                aggColors = array.new_color()
                aggStyles = array.new_string()
                aggWidths = array.new_int()

                // Step 1: Filter, Merge, and Track Dashboard State
                for i = 0 to array.size(pPrices) - 1
                    float lv = array.get(pPrices, i)
                    string ti = array.get(pTitles, i)
                    
                    // --- Dashboard Tracking (Must stay inside this loop!) ---
                    u = f_norm(ti)
                    if u == "ZERO GAMMA" or u == "MACRO ZERO GAMMA" 
                        st_ZG := lv
                    if u == "GAMMA FLIP UPPER"
                        st_GFU := lv
                    if u == "GAMMA FLIP LOWER"
                        st_GFL := lv
                    if u == "GAMMA CLIFF UP"
                        st_GCU := lv
                    if u == "GAMMA CLIFF DOWN"
                        st_GCD := lv
                    if u == "MAX PAIN"
                        st_MP := lv
                    if u == "GAMMA MAGNET" 
                        st_MAG := lv
                    if u == "PIN STRIKE"  
                        st_PIN := lv
                    if u == "ABSOLUTE CALL WALL" or u == "MACRO CALL WALL"  
                        st_CW := lv
                    if u == "0DTE CALL WALL"
                        st_CW0 := lv
                    if u == "0DTE PUT WALL"
                        st_PW0 := lv
                    if u == "LOCAL CALL NODE"
                        st_LCN := lv
                    if u == "LOCAL PUT NODE"
                        st_LPN := lv
                    if u == "DEX CALL NODE"
                        st_DCN := lv
                    if u == "DEX PUT NODE"
                        st_DPN := lv
                    if u == "HEDGE WALL" or u == "MACRO PUT WALL"  
                        st_PW := lv
                        st_HW := lv
                    if u == "UPPER EM"  
                        st_EU := lv
                    if u == "LOWER EM"  
                        st_EL := lv

                    // --- Smart Proximity & Merging ---
                    isTactical = str.contains(f_norm(ti), "0DTE") or str.contains(f_norm(ti), "LOCAL") or str.contains(f_norm(ti), "DEX") or str.contains(f_norm(ti), "CLIFF")
                    pctDistance = (math.abs(lv - close) / close) * 100.0   
                    passedProx = (i_proxFilter == 0.0) or (not isTactical) or (pctDistance <= i_proxFilter)
                    
                    // Make sure to pass BOTH arguments to f_showLevel
                    if f_showLevel(ti, lv) and passedProx
                        clr = f_levelColor(ti)
                        stl = f_levelStyle(ti)
                        wid = f_levelWidth(ti)
                        txt = i_compactLabels ? f_compactTitle(ti) : ti
                        canMergeCurrent = not f_isProtectedLevel(txt)
                        
                        merged = false
                        if i_mergeSamePrice and canMergeCurrent and array.size(aggPrices) > 0
                            for j = 0 to array.size(aggPrices) - 1
                                existingTxt = array.get(aggTitles, j)
                                // Never merge into a protected level slot.
                                if f_isProtectedLevel(existingTxt)
                                    continue
                                if math.abs(array.get(aggPrices, j) - lv) <= i_mergeTolerance
                                    // Append text if it's not already there
                                    if not str.contains(existingTxt, txt)
                                        array.set(aggTitles, j, existingTxt + " + " + txt)
                                    // Promote the line width if this new level is structurally thicker
                                    if wid > array.get(aggWidths, j)
                                        array.set(aggWidths, j, wid)
                                        array.set(aggColors, j, clr)
                                    merged := true
                                    break
                                    
                        if not merged
                            array.push(aggPrices, lv)
                            array.push(aggTitles, txt)
                            array.push(aggColors, clr)
                            array.push(aggStyles, stl)
                            array.push(aggWidths, wid)

                // Step 2: Draw the Merged Levels
                if array.size(aggPrices) > 0
                    for a = 0 to array.size(aggPrices) - 1
                        a_lv = array.get(aggPrices, a)
                        a_ti = array.get(aggTitles, a)
                        a_cl = array.get(aggColors, a)
                        a_st = f_lineStyle(array.get(aggStyles, a))
                        a_wi = array.get(aggWidths, a)
                        
                        line ln = na
                        ln := line.new(sessionStartBar, a_lv, bar_index, a_lv, color=a_cl, width=a_wi, style=a_st)
                        array.push(allLines, ln)

                        u_ti = f_norm(a_ti)
                        
                        // Capture EM lines for fills (from the merged output)
                        if str.contains(u_ti, "EM+") or str.contains(u_ti, "UPPER EM")
                            line_emUp := ln
                        if str.contains(u_ti, "EM-") or str.contains(u_ti, "LOWER EM")
                            line_emDn := ln
                        
                        // Capture EM lines for fills (from the merged output)
                        if str.contains(u_ti, "GF U") or str.contains(u_ti, "GAMMA FLIP UPPER")
                            line_gcUp := ln
                        if str.contains(u_ti, "GF L") or str.contains(u_ti, "GAMMA FLIP LOWER")
                            line_gcDn := ln

                        
                        if i_showLabels
                            mg = syminfo.mintick * i_minLabelGapTicks
                            lc = f_assignLabelColumn(a_lv, colLastPrices, mg, i_maxLabelCols)
                            if lc >= 0
                                dispTxt = i_showPriceInLabel ? a_ti + " (" + str.tostring(a_lv, "#.##") + ")" : a_ti
                                lb = label.new(bar_index + i_labelOffset, a_lv, dispTxt, textcolor=a_cl, color=color.new(#131722, 100 - i_labelBgOpacity), style=label.style_label_left, size=f_labelSize(i_labelSize))
                                array.push(allLabels, lb)
                                array.push(labelCols, lc)

    if i_showScored and str.length(rawScored) > 0
        sPrices  = array.new_float()
        sFilters = array.new_string()
        sSigs    = array.new_string()
        sLabels  = array.new_string()
        f_parseScoredLevels(rawScored, sPrices, sFilters, sSigs, sLabels)

    
        if array.size(sPrices) > 0
            // ── Apply Futures Anchor Scaling for Scored Levels ──
            sC = f_canonicalSymbol(matchScored)
            pC = f_canonicalSymbol(f_primarySymbol())
            sF = f_symbolFamilyKey(sC)
            cF = f_symbolFamilyKey(pC)
            sFut = f_isOvernightFutures(sC)
            cFut = f_isOvernightFutures(pC)

            if cFut and sF == cF and not sFut
                // We are on a futures ticker but data is from Spot/ETF
                anc = sC == "ES" or sC == "SPX" or sC == "SPY" ? "ES" : sC == "NQ" or sC == "NDX" or sC == "QQQ" ? "NQ" : sC == "YM" or sC == "DJI" or sC == "DIA" ? "YM" : sC == "RTY" or sC == "RUT" or sC == "IWM" ? "RTY" : ""
                if anc != ""
                    sR = array.get(sPrices, 0)
                    if math.abs(sR) > syminfo.mintick
                        fs = f_getContractCost(syminfo.main_tickerid) / f_getContractCost(sC)
                        if math.abs(fs - 1.0) > 0.001 
                            for k = 0 to array.size(sPrices) - 1
                                array.set(sPrices, k, array.get(sPrices, k) * fs)
            
            for i = 0 to array.size(sPrices) - 1
                s_lv  = array.get(sPrices, i)
                s_flt := array.get(sFilters, i)
                s_sig := array.get(sSigs, i)
                s_lbl = array.get(sLabels, i)
                
                s_clr = f_scoredColor(s_flt, s_sig, s_lbl)
                s_sty = f_scoredStyle(s_sig)
                s_wid = f_scoredWidth(s_sig)
                
                ln = line.new(sessionStartBar, s_lv, bar_index, s_lv, 
                    color=s_clr, width=s_wid, style=s_sty)
                array.push(allLines, ln)

                if str.contains(str.upper(s_lbl), "EM HI")
                    line_emUp := ln
                if str.contains(str.upper(s_lbl), "EM LO")
                    line_emDn := ln
                
                if i_showLabels
                    mg = syminfo.mintick * i_minLabelGapTicks
                    lc = f_assignLabelColumn(s_lv, colLastPrices, mg, i_maxLabelCols)
                    if lc >= 0
                        dispTxt = f_scoredCompactLabel(s_flt, s_lbl)
                        if i_showPriceInLabel
                            dispTxt := dispTxt + " (" + str.tostring(s_lv, "#.##") + ")"
                        lb = label.new(bar_index + i_labelOffset, s_lv, dispTxt, 
                            textcolor=s_clr, 
                            color=color.new(#131722, 100 - i_labelBgOpacity), 
                            style=label.style_label_left, 
                            size=f_labelSize(i_labelSize))
                        array.push(allLabels, lb)
                        array.push(labelCols, lc)

            // ── Dashboard Tracking for Scored Levels ──
            for i = 0 to array.size(sPrices) - 1
                s_flt := array.get(sFilters, i)
                s_sig := array.get(sSigs, i)
                s_lbl = array.get(sLabels, i)
                s_lv  = array.get(sPrices, i)
                u_lbl = str.upper(s_lbl)
                
                // Walls → override CW/PW
                if s_flt == "W"
                    if str.contains(u_lbl, "CW") and not str.contains(u_lbl, "0D")
                        st_CW := s_lv
                    if str.contains(u_lbl, "PW") or str.contains(u_lbl, "HW")
                        st_PW := s_lv
                        st_HW := s_lv
                
                // Anchors → track st_ANCHOR
                if s_flt == "A" and na(st_ANCHOR)
                    st_ANCHOR := s_lv
                    st_ANCHOR_LABEL := s_lbl
                
                // Inflections → override ZG/MAG
                if s_flt == "I"
                    if str.contains(u_lbl, "ZERO")
                        st_ZG := s_lv
                    if str.contains(u_lbl, "MAGNET")
                        st_MAG := s_lv
                    if str.contains(u_lbl, "CLIFF UP")
                        st_GCU := s_lv
                    if str.contains(u_lbl, "CLIFF DN")
                        st_GCD := s_lv

                // Expected move tracks from explicit EM filter
                if s_flt == "E"
                    if str.contains(u_lbl, "EM HI")
                        st_EU := s_lv
                    if str.contains(u_lbl, "EM LO")
                        st_EL := s_lv


    
    // OPTIMIZATION: Apply linefills immediately after line creation
    if i_showEmFill and not na(line_emUp) and not na(line_emDn)
        linefill.new(line_emUp, line_emDn, i_colEmFill)
    if i_showGammaFlip and not na(line_gcUp) and not na(line_gcDn)
        linefill.new(line_gcUp, line_gcDn, i_colGammaFlipFill)
    

// ── OPTIMIZED Realtime Extension ──
// By wrapping this in barstate.islast, we prevent the script from trying 
// to extend lines on thousands of historical bars.
if barstate.islast
    if array.size(allLines) > 0
        for i = 0 to array.size(allLines) - 1
            line.set_x2(array.get(allLines, i), bar_index)
            
    if array.size(allLabels) > 0
        for i = 0 to array.size(allLabels) - 1
            c = i < array.size(labelCols) ? array.get(labelCols, i) : 0
            label.set_x(array.get(allLabels, i), bar_index + i_labelOffset + (c * i_columnStepBars))

// ═══════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════

var table dash = na

if barstate.isfirst
    dash := table.new(f_pos(i_dashPos), 2, 30, bgcolor=color.new(#131722, 100 - i_dashBgOpacity), border_width=0)


if barstate.islast and i_showDash
    tSz = f_labelSize(i_dashSize)
    
    // ── Derived metrics ──
    emV = not na(st_EU) and not na(st_EL) ? (st_EU - st_EL) / 2.0 : na
    wSep = not na(st_CW) and not na(st_PW) ? math.abs(st_CW - st_PW) : na
    // ── Regime + Direction from Metadata ──
    regime = st_Regime
    biasLabel = st_Bias
    
    lE = (regime == "PINNED" or regime == "BATTLE_ZONE") ? "🟢" : 
         (regime == "COILED" or regime == "NEUTRAL") ? "🟡" : "🔴"
    
    biasArrow = biasLabel == "BULLISH" ? " ↑" : biasLabel == "BEARISH" ? " ↓" : " ↔"
    biasClr = biasLabel == "BULLISH" ? color.lime : biasLabel == "BEARISH" ? color.red : color.gray

    // ── Proximity triggers ──
    emV2 = not na(emV) ? emV : 50.0
    thr = emV2 * 3.0
    // Use metadata triggers if available, fallback to internal logic
    sTrig = not na(st_ShortTrig) ? st_ShortTrig : f_bestShortTrigger(close, thr, st_GFL, st_PW, st_LPN, st_HW, st_ZG)
    lTrig = not na(st_LongTrig) ? st_LongTrig : f_bestLongTrigger(close, thr, st_CW, st_GFU, st_CW0, st_LCN, st_ZG)
    sTgt = not na(st_ShortTgt) ? st_ShortTgt : f_nearestBelow(sTrig, st_PW, st_HW, st_EL)
    sInv = not na(st_ShortInv) ? st_ShortInv : f_nearestAbove(sTrig, st_CW, st_GFU, st_EU)
    lTgt = not na(st_LongTgt) ? st_LongTgt : f_nearestAbove(lTrig, st_MP, st_EU, st_GFU)
    lInv = not na(st_LongInv) ? st_LongInv : f_nearestBelow(lTrig, st_ZG, st_GFL, st_PW)

    primary = f_primarySymbol()
    resolved = str.length(st_Asset) > 0 ? st_Asset : "—"
    modeText = f_isOvernightFutures(primary) ? "Globex" : "Calendar"

    row = 0
    // Row  0: Header
    table.cell(dash, 0, row, primary + " | " + modeText, text_color = color.white, text_size = tSz)
    table.cell(dash, 1, row, "Loaded: " + resolved + (etfConversion ? " (Scaled)" : ""), text_color = str.length(st_Asset) > 0 ? color.lime : color.red, text_size = tSz)
    // Row  1: Regime + Direction
    row := row+1
    table.cell(dash, 0, row, "REGIME", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, lE + " " + regime + biasArrow + " " + biasLabel, text_color = biasClr, text_size = tSz)

    // Row  2: Market structure
    row := row+1
    table.cell(dash, 0, row, "MAGNET", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, f_num(st_MAG), text_color = i_colGammaMagnet, text_size = tSz)
    // Row  3: Pin
    row := row+1
    table.cell(dash, 0, row, "PIN", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, f_num(st_PIN), text_color = i_colPinStrike, text_size = tSz)
    // Row  4: Separation + EM + GEX
    row := row+1
    table.cell(dash, 0, row, "SEP | EM± | GEX Σ", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, f_num(wSep) + " | " + f_num(emV) + " | " + f_num(st_TotalGEX), text_color = color.white, text_size = tSz)

    // Row 4.1: Integrity & Stability (New)
    row := row+1
    integClr = st_Integrity < 0.6 ? color.yellow : color.white
    stabClr  = st_Stability > 0.6 ? color.orange : color.white
    table.cell(dash, 0, row, "INTEGRITY | STAB", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, (st_Integrity < 0.6 ? "🕳️ " : "🧱 ") + str.tostring(st_Integrity * 100, "0") + "% | " + (st_Stability > 0.6 ? "⚠️ " : "✅ ") + str.tostring(st_Stability * 100, "0") + "%", text_color = color.white, text_size = tSz)

    // Row  5: ZG
    row := row+1
    table.cell(dash, 0, row, "ZERO γ", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, f_num(st_ZG), text_color = i_colZeroGamma, text_size = tSz)
    // Row  6: Cliffs
    row := row+1
    table.cell(dash, 0, row, "CLIFFS", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, "↓" + f_num(st_GCD) + " | ↑" + f_num(st_GCU), text_color = color.teal, text_size = tSz)

    // Row 6.1: Vol Expansion Triggers (New)
    row := row+1
    table.cell(dash, 0, row, "VOL EXPANSION", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, "↓" + f_num(st_VolExpDn) + " | ↑" + f_num(st_VolExpUp), text_color = color.new(#FF00FF, 0), text_size = tSz)

    //if s_flt == "A" and s_sig == "P" and na(st_ANCHOR)
    //    st_ANCHOR := s_lv
    //    st_ANCHOR_LABEL := array.get(sLabels, i)

    // New dashboard row (insert before PLAN row):
    row := row+1
    table.cell(dash, 0, row, "ANCHOR", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, na(st_ANCHOR) ? "—" : f_num(st_ANCHOR) + " " + st_ANCHOR_LABEL, text_color = i_colAnchor, text_size = tSz)

    // --- Institutional Flows (Greeks) ---
    row := row+1
    table.cell(dash, 0, row, "GREEKS", text_color = color.white, text_size = tSz)
    
    vannaIcon = st_Vanna > 1.5 ? "🌊" : st_Vanna < -1.5 ? "💨" : "•"
    vannaClr  = st_Vanna > 1.5 ? color.lime : st_Vanna < -1.5 ? color.red : color.gray
    charmIcon = st_Charm > 5.0 ? "⏳" : st_Charm < -5.0 ? "⚡" : "•"
    
    row := row+1
    table.cell(dash, 0, row, "VANNA | CHARM", text_color = color.gray, text_size = tSz)
    table.cell(dash, 1, row, vannaIcon + " " + f_num(st_Vanna) + " | " + charmIcon + " " + f_num(st_Charm), text_color = vannaClr, text_size = tSz)
    
    row := row+1
    table.cell(dash, 0, row, "SPEED (Γ-SENS)", text_color = color.gray, text_size = tSz)
    speedClr = math.abs(st_Speed) > 10.0 ? color.orange : color.gray
    table.cell(dash, 1, row, "🏎️ " + f_num(st_Speed), text_color = speedClr, text_size = tSz)

    // --- IV & Skew row ---
    row := row+1
    table.cell(dash, 0, row, "IV | SKEW", text_color = color.gray, text_size = tSz)
    ivIcon = st_IVChg > 0.01 ? "📈" : st_IVChg < -0.01 ? "📉" : "•"
    skewIcon = st_Skew > 0.05 ? "🛡️" : st_Skew < -0.05 ? "💎" : "•"
    ivClr = st_IVChg > 0.01 ? color.lime : st_IVChg < -0.01 ? color.red : color.gray
    skewClr = st_Skew > 0.05 ? color.orange : st_Skew < -0.05 ? color.aqua : color.gray
    table.cell(dash, 1, row, ivIcon + " " + str.tostring(st_IV * 100, "#.#") + "% (" + str.tostring(st_IVChg * 100, "+#.#") + "%) | " + skewIcon + " " + str.tostring(st_Skew * 100, "+#.#") + "%", text_color = color.white, text_size = tSz)


    // --- DEX Highlight Logic (Targeting) ---
    prox_thr = emV2 * 0.1 // 10% of EM as proximity
    isNearDCN = not na(st_DCN) and math.abs(close - st_DCN) < prox_thr
    isNearDPN = not na(st_DPN) and math.abs(close - st_DPN) < prox_thr
    
    // Row  7: Separator
    row := row+1
    table.cell(dash, 0, row, "", text_size = size.tiny)
    table.cell(dash, 1, row, "", text_size = size.tiny)
    // Row  8: Narrative header
    row := row+1
    table.cell(dash, 0, row, "PLAN", text_color = color.white, text_size = tSz)
    dexInfo = ""
    if not na(st_DPN) or not na(st_DCN)
        dexInfo := (isNearDPN ? "🎯 " : "") + "DEX " + f_num(st_DPN) + " / " + (isNearDCN ? "🎯 " : "") + f_num(st_DCN)
    row := row+1
    table.cell(dash, 1, row, dexInfo, text_color = (isNearDCN or isNearDPN) ? color.yellow : color.white, text_size = tSz)
    // Row  9: Short
    row := row+1
    sZ = ""
    if not na(st_GCD)
        sZ := "GC↓" + f_num(st_GCD) + " "
    if not na(st_DPN)
        sZ := sZ + "DEX " + f_num(st_DPN)
    table.cell(dash, 0, row, "SHORT", text_color = color.red, text_size = tSz)
    table.cell(dash, 1, row, "< " + f_num(sTrig) + " → " + f_num(sTgt) + " inv > " + f_num(sInv), text_color = color.red, text_size = tSz)
    // Row 10: Short zones
    row := row+1
    table.cell(dash, 0, row, "", text_size = size.tiny)
    table.cell(dash, 1, row, str.length(sZ) > 0 ? sZ : "", text_color = color.new(color.red, 40), text_size = tSz)
    // Row 11: Long
    row := row+1
    lZ = ""
    if not na(st_GCU)
        lZ := "GC↑" + f_num(st_GCU) + " "
    if not na(st_DCN)
        lZ := lZ + "DEX " + f_num(st_DCN)
    table.cell(dash, 0, row, "LONG", text_color = color.lime, text_size = tSz)
    table.cell(dash, 1, row, "> " + f_num(lTrig) + " → " + f_num(lTgt) + " inv < " + f_num(lInv), text_color = color.lime, text_size = tSz)
    // Row 12: Long zones
    row := row+1
    table.cell(dash, 0, row, "", text_size = size.tiny)
    table.cell(dash, 1, row, str.length(lZ) > 0 ? lZ : "", text_color = color.new(color.lime, 40), text_size = tSz)
    // Row 13: EM
    row := row+1
    table.cell(dash, 0, row, "EM", text_color = color.aqua, text_size = tSz)
    table.cell(dash, 1, row, f_num(st_EL) + " ↔ " + f_num(st_EU), text_color = color.aqua, text_size = tSz)
    
    // Row 14: Coach's Note (with wrapping)
    row := row+1
    table.cell(dash, 0, row, "NOTE", text_color = color.orange, text_size = tSz)
    if str.length(st_Note) > 60
        // Find a space to split near 60 chars — scan substring window for a space
        splitIdx = 60
        window = str.substring(st_Note, 60, math.min(81, str.length(st_Note)))
        spacePos = str.pos(window, " ")
        if not na(spacePos)
            splitIdx := 60 + spacePos
        
        note1 = str.substring(st_Note, 0, splitIdx)
        note2 = str.substring(st_Note, splitIdx)
        table.cell(dash, 1, row, note1, text_color = color.white, text_size = tSz, text_halign = text.align_left)
        row := row + 1
        table.cell(dash, 0, row, "", text_size = tSz)
        table.cell(dash, 1, row, note2, text_color = color.white, text_size = tSz, text_halign = text.align_left)
    else
        table.cell(dash, 1, row, st_Note, text_color = color.white, text_size = tSz, text_halign = text.align_left)

if barstate.islast and not i_showDash and not na(dash)
    table.clear(dash, 0, 0, 1, 16)