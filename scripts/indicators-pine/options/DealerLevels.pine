indicator("Dealer Levels Auto", overlay = true, max_lines_count = 200, max_labels_count = 200, max_bars_back = 5000)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════

var string grp_data = "Dealer Levels"
pastedData = input.text_area("", "Paste Dealer Levels", group = grp_data, tooltip = "Paste formatted lines from daily_levels.txt")
familySourcePreference = input.string("Auto", "Family Source Preference", options = ["Auto", "Prefer Index", "Prefer ETF"], group = grp_data)
overrideExactWithFamilyPreference = input.bool(false, "Override Exact Match With Family Preference", group = grp_data)
variantPreference = input.string("Auto", "Macro Variant Preference", options = ["Auto", "Direct [D]", "Mapped [M]"], group = grp_data, tooltip="Which data variant to prefer when multiple exist (e.g. /NQ[D] vs /NQ[M])")

var string grp_lines = "Line Style"
showEmFill = input.bool(true, "Show EM Fill", group = grp_lines)
lineWidthPrimary = input.int(2, "Primary Width", minval = 1, maxval = 4, group = grp_lines)
lineWidthSecondary = input.int(1, "Secondary Width", minval = 1, maxval = 4, group = grp_lines)
lineStylePrimaryInp = input.string("Solid", "Primary Style", options = ["Solid", "Dashed", "Dotted"], group = grp_lines)
lineStyleSecondaryInp = input.string("Dashed", "Secondary Style", options = ["Solid", "Dashed", "Dotted"], group = grp_lines)
lineStyle0DTEInp = input.string("Dotted", "0DTE Style", options = ["Solid", "Dashed", "Dotted"], group = grp_lines)

var string grp_colors = "Colors"
colUpperEM = input.color(color.new(color.aqua, 0), "Upper EM", group = grp_colors)
colAbsCall = input.color(color.new(color.lime, 0), "Absolute Call Wall", group = grp_colors)
colLocalCall = input.color(color.new(color.lime, 30), "Local Call Node", group = grp_colors)
col0DTECall = input.color(color.new(color.lime, 60), "0DTE Call Wall", group = grp_colors)
colDexCall = input.color(color.new(color.lime, 15), "DEX Call Node", group = grp_colors)
colGammaCliffUp = input.color(color.new(color.teal, 20), "Gamma Cliff Up", group = grp_colors)
colZeroGamma = input.color(color.new(color.yellow, 0), "Zero Gamma", group = grp_colors)
colZeroGammaDA = input.color(color.new(color.orange, 0), "Zero Gamma DA", group = grp_colors)
colGammaFlip = input.color(color.new(color.yellow, 45), "Gamma Flip Zone", group = grp_colors)
colGammaCliffDown = input.color(color.new(color.teal, 20), "Gamma Cliff Down", group = grp_colors)
colMaxPain = input.color(color.new(color.orange, 0), "Max Pain", group = grp_colors)
col0DTEPut = input.color(color.new(color.red, 60), "0DTE Put Wall", group = grp_colors)
colLocalPut = input.color(color.new(color.red, 30), "Local Put Node", group = grp_colors)
colDexPut = input.color(color.new(color.red, 15), "DEX Put Node", group = grp_colors)
colHedge = input.color(color.new(color.red, 0), "Hedge Wall", group = grp_colors)
colLowerEM = input.color(color.new(color.aqua, 0), "Lower EM", group = grp_colors)
colGammaMagnet = input.color(color.new(color.fuchsia, 0), "Gamma Magnet", group = grp_colors)
colPinStrike = input.color(color.new(color.fuchsia, 30), "Pin Strike", group = grp_colors)
colFallback = input.color(color.new(color.white, 0), "Fallback", group = grp_colors)
colEmFill = input.color(color.new(color.aqua, 88), "EM Fill", group = grp_colors)
colGammaFlipFill = input.color(color.new(color.yellow, 88), "Gamma Flip Fill", group = grp_colors)

var string grp_labels = "Labels"
showLabels = input.bool(true, "Show Labels", group = grp_labels)
showPriceInLabel = input.bool(true, "Show Price In Label", group = grp_labels)
compactLabels = input.bool(true, "Compact Label Text", group = grp_labels)
mergeSamePriceLabels = input.bool(true, "Merge Same-Price Labels", group = grp_labels)
labelSizeInp = input.string("tiny", "Label Size", options = ["tiny", "small", "normal", "large"], group = grp_labels)
labelOffset = input.int(2, "Label Offset", minval = 0, maxval = 50, group = grp_labels)
labelBgOpacity = input.int(85, "Label Background Opacity", minval = 0, maxval = 100, group = grp_labels)
labelCollisionMode = input.string("Stagger", "Label Collision", options = ["Stagger", "Hide", "Off"], group = grp_labels)
maxLabelColumns = input.int(4, "Max Label Columns", minval = 1, maxval = 10, group = grp_labels)
columnStepBars = input.int(2, "Column Step (bars)", minval = 1, maxval = 20, group = grp_labels)
minLabelGapTicks = input.int(40, "Min Gap (ticks)", minval = 1, maxval = 500, group = grp_labels)

var string grp_dashboard = "Dashboard"
showDashboard = input.bool(true, "Show Dashboard", group = grp_dashboard)
dashPosition = input.string("Bottom Right", "Dashboard Position", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = grp_dashboard)
dashTextSize = input.string("small", "Dashboard Text Size", options = ["tiny", "small", "normal", "large"], group = grp_dashboard)
dashBgOpacity = input.int(82, "Dashboard Background Opacity", minval = 0, maxval = 100, group = grp_dashboard)

var string grp_visibility = "Level Visibility"
showEMLevels = input.bool(true, "Show EM Levels", group = grp_visibility)
maxEMDte = input.int(7, "Max EM DTE to Show", minval = 0, maxval = 15, group = grp_visibility, tooltip = "Only show EM levels for expiries within this many days. 0 = show all.")
showCallLevels = input.bool(true, "Show Call Levels", group = grp_visibility)
showPutLevels = input.bool(true, "Show Put Levels", group = grp_visibility)
showZeroGammaLevel = input.bool(true, "Show Zero Gamma", group = grp_visibility)
showZeroGammaDALevel = input.bool(true, "Show Zero Gamma DA", group = grp_visibility)
showGammaFlipLevels = input.bool(true, "Show Gamma Flip Zone", group = grp_visibility)
showGammaCliffLevels = input.bool(true, "Show Gamma Cliffs", group = grp_visibility)
showMaxPainLevel = input.bool(true, "Show Max Pain", group = grp_visibility)
showHedgeLevel = input.bool(true, "Show Hedge Wall", group = grp_visibility)
showDexLevels = input.bool(true, "Show DEX Nodes", group = grp_visibility)
showGammaMagnet = input.bool(true, "Show Gamma Magnet", group = grp_visibility)
showPinStrike = input.bool(true, "Show Pin Strike", group = grp_visibility)

// ═══════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════
f_label_size(string s) => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : size.large
f_line_style(string s) => s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted
f_position(string s) =>
    s == "Top Left" ? position.top_left : s == "Top Center" ? position.top_center : s == "Top Right" ? position.top_right :
     s == "Middle Left" ? position.middle_left : s == "Middle Center" ? position.middle_center : s == "Middle Right" ? position.middle_right :
     s == "Bottom Left" ? position.bottom_left : s == "Bottom Center" ? position.bottom_center : position.bottom_right
f_norm(string v) => str.upper(str.trim(v))
f_strip_prefix(string v) =>
    t = f_norm(v)
    str.startswith(t, "/") ? str.substring(t, 1, str.length(t)) : t
f_strip_continuous_suffix(string v) =>
    c = f_strip_prefix(v)
    l = str.length(c)
    // 1. Strip [D] or [M] suffixes first
    if l > 3
        if str.endswith(c, "[D]") or str.endswith(c, "[M]")
            c := str.substring(c, 0, l - 3)
            l := str.length(c)
    // 2. Strip continuous ! suffix
    l > 2 and str.endswith(c, "!") ? str.substring(c, 0, l - 2) : c
f_primary_symbol() =>
    r = f_strip_prefix(syminfo.root)
    t = f_strip_prefix(syminfo.ticker)
    str.length(r) > 0 ? r : t
f_canonical_symbol(string s) =>
    c = f_strip_continuous_suffix(s)
    c == "MES" ? "ES" : c == "MNQ" ? "NQ" : c == "MYM" ? "YM" : c == "M2K" ? "RTY" : c == "MGC" ? "GC" : c == "SIL" ? "SI" : c == "MCL" ? "CL" : c == "MHG" ? "HG" : c == "M6E" ? "6E" : c == "M6A" ? "6A" : c == "M6B" ? "6B" : c == "M6J" ? "6J" : c
f_symbol_family_key(string s) =>
    c = f_canonical_symbol(s)
    r = c
    if c == "ES" or c == "SPX" or c == "SPY"
        r := "ES_FAMILY"
    else if c == "NQ" or c == "NDX" or c == "QQQ"
        r := "NQ_FAMILY"
    else if c == "YM" or c == "DJX" or c == "DJI" or c == "US30" or c == "DOW" or c == "DIA"
        r := "YM_FAMILY"
    else if c == "RTY" or c == "RUT" or c == "IWM"
        r := "RTY_FAMILY"
    r
f_source_kind(string s) =>
    c = f_canonical_symbol(s)
    c == "SPX" or c == "NDX" or c == "DJX" or c == "DJI" or c == "RUT" ? "INDEX" : c == "SPY" or c == "QQQ" or c == "DIA" or c == "IWM" ? "ETF" : "OTHER"
f_is_overnight_futures(string s) =>
    c = f_canonical_symbol(s)
    c == "ES" or c == "NQ" or c == "YM" or c == "RTY" or c == "CL" or c == "GC" or c == "SI" or c == "HG" or c == "6E" or c == "6A" or c == "6B" or c == "6J" or c == "ZN" or c == "ZB"
f_match_score(string assetTag) =>
    asset = f_canonical_symbol(assetTag)
    aFam = f_symbol_family_key(asset)
    primary = f_canonical_symbol(f_primary_symbol())
    pFam = f_symbol_family_key(primary)
    ticker = f_canonical_symbol(syminfo.ticker)
    tFam = f_symbol_family_key(ticker)
    root = f_canonical_symbol(syminfo.root)
    rFam = f_symbol_family_key(root)
    exact = asset == ticker or asset == root or asset == primary
    family = aFam == tFam or aFam == rFam or aFam == pFam
    eBase = overrideExactWithFamilyPreference and familySourcePreference != "Auto" ? 120 : 200
    fBase = family ? 100 : 0
    boost = 0
    if family and familySourcePreference != "Auto"
        k = f_source_kind(asset)
        if familySourcePreference == "Prefer ETF" and k == "ETF"
            boost := 30
        else if familySourcePreference == "Prefer Index" and k == "INDEX"
            boost := 30

    // Add variant preference boost
    vBoost = 0
    if variantPreference != "Auto"
        if variantPreference == "Direct [D]" and str.endswith(f_norm(assetTag), "[D]")
            vBoost := 50
        else if variantPreference == "Mapped [M]" and str.endswith(f_norm(assetTag), "[M]")
            vBoost := 50

    exact ? (eBase + vBoost) : (fBase + boost + vBoost)

f_num(float v) => na(v) ? "—" : str.tostring(v, "#.##")
f_pick(float v1, float v2, float v3) => not na(v1) ? v1 : (not na(v2) ? v2 : v3)
f_is_near(float value, float ref, float thr) => not na(value) and not na(ref) and math.abs(value - ref) <= thr

f_nearest_below(float ref, float v1, float v2, float v3) =>
    float b = na
    if not na(ref)
        if not na(v1) and v1 < ref and (na(b) or v1 > b)
            b := v1
        if not na(v2) and v2 < ref and (na(b) or v2 > b)
            b := v2
        if not na(v3) and v3 < ref and (na(b) or v3 > b)
            b := v3
    na(b) ? f_pick(v1, v2, v3) : b

f_nearest_above(float ref, float v1, float v2, float v3) =>
    float b = na
    if not na(ref)
        if not na(v1) and v1 > ref and (na(b) or v1 < b)
            b := v1
        if not na(v2) and v2 > ref and (na(b) or v2 < b)
            b := v2
        if not na(v3) and v3 > ref and (na(b) or v3 < b)
            b := v3
    na(b) ? f_pick(v1, v2, v3) : b

f_is_em_upper(string title) =>
    u = f_norm(title)
    str.contains(u, "UPPER EM") or str.contains(u, "EM HI")

f_is_em_lower(string title) =>
    u = f_norm(title)
    str.contains(u, "LOWER EM") or str.contains(u, "EM LO")

f_is_em85_upper(string title) =>
    u = f_norm(title)
    str.contains(u, "UPPER 85% STRADDLE") or str.contains(u, "EM85 HI")

f_is_em85_lower(string title) =>
    u = f_norm(title)
    str.contains(u, "LOWER 85% STRADDLE") or str.contains(u, "EM85 LO")

f_best_short_trigger(float spot, float thr, float v1, float v2, float v3, float v4, float v5) =>
    float b = na
    if f_is_near(v1, spot, thr) and (na(b) or v1 > b)
        b := v1
    if f_is_near(v2, spot, thr) and (na(b) or v2 > b)
        b := v2
    if f_is_near(v3, spot, thr) and (na(b) or v3 > b)
        b := v3
    if f_is_near(v4, spot, thr) and (na(b) or v4 > b)
        b := v4
    if f_is_near(v5, spot, thr) and (na(b) or v5 > b)
        b := v5
    na(b) ? f_pick(v1, v2, v3) : b

f_best_long_trigger(float spot, float thr, float v1, float v2, float v3, float v4, float v5) =>
    float b = na
    if f_is_near(v1, spot, thr) and (na(b) or v1 < b)
        b := v1
    if f_is_near(v2, spot, thr) and (na(b) or v2 < b)
        b := v2
    if f_is_near(v3, spot, thr) and (na(b) or v3 < b)
        b := v3
    if f_is_near(v4, spot, thr) and (na(b) or v4 < b)
        b := v4
    if f_is_near(v5, spot, thr) and (na(b) or v5 < b)
        b := v5
    na(b) ? f_pick(v1, v2, v3) : b

// ═══════════════════════════════════════════════════════════════════════
// SYMBOL MATCHING & PARSING
// ═══════════════════════════════════════════════════════════════════════
f_extract_asset_tag(string lineText) =>
    tokens = str.split(lineText, ",")
    asset = ""
    if array.size(tokens) > 0
        fp = str.split(str.trim(array.get(tokens, 0)), ":")
        if array.size(fp) >= 3
            asset := f_strip_prefix(array.get(fp, 0))
    asset
f_find_matching_line(string blob) =>
    string mL = ""
    string mA = ""
    int bs = 0
    rows = str.split(blob, "\n")
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            row = str.trim(array.get(rows, i))
            if str.length(row) > 0 and str.contains(row, ",")
                a = f_extract_asset_tag(row)
                sc = f_match_score(a)
                if str.length(a) > 0 and sc > bs
                    mL := row
                    mA := a
                    bs := sc
    [mL, mA]
f_family_futures_anchor(string fk) => fk == "ES_FAMILY" ? "ES" : fk == "NQ_FAMILY" ? "NQ" : fk == "YM_FAMILY" ? "YM" : fk == "RTY_FAMILY" ? "RTY" : ""
f_find_asset_line(string blob, string target) =>
    string mL = ""
    t = f_canonical_symbol(target)
    rows = str.split(blob, "\n")
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            row = str.trim(array.get(rows, i))
            if str.length(row) > 0 and str.contains(row, ",")
                if f_canonical_symbol(f_extract_asset_tag(row)) == t
                    mL := row
                    break
    mL
f_parse_levels(string lineText, array<float> prices, array<string> titles) =>
    array.clear(prices)
    array.clear(titles)
    tokens = str.split(lineText, ",")
    if array.size(tokens) > 0
        for i = 0 to array.size(tokens) - 1
            token = str.trim(array.get(tokens, i))
            parts = str.split(token, ":")
            string px = ""
            string ti = ""
            if i == 0
                if array.size(parts) >= 3
                    px := str.trim(array.get(parts, 1))
                    ti := str.trim(array.get(parts, 2))
            else
                if array.size(parts) >= 2
                    px := str.trim(array.get(parts, 0))
                    ti := str.trim(array.get(parts, 1))

            // Support scored contract format: FILTER|SIG|LABEL
            // Keep only LABEL for styling and dashboard classification.
            if str.contains(ti, "|")
                meta = str.split(ti, "|")
                if array.size(meta) >= 3
                    ti := str.trim(array.get(meta, 2))
            lv = str.tonumber(px)
            if not na(lv) and str.length(ti) > 0
                array.push(prices, lv)
                array.push(titles, ti)

// ═══════════════════════════════════════════════════════════════════════
// LEVEL STYLING
// ═══════════════════════════════════════════════════════════════════════
f_level_color(string title) =>
    u = f_norm(title)
    f_is_em_upper(u) ? colUpperEM : f_is_em_lower(u) ? colLowerEM : f_is_em85_upper(u) ? colUpperEM : f_is_em85_lower(u) ? colLowerEM : (u == "ZERO GAMMA" or u == "ZERO GEX") ? colZeroGamma : (u == "ZERO GAMMA DA" or u == "ZERO GEX DA") ? colZeroGammaDA :
     u == "GAMMA FLIP UPPER" or u == "GAMMA FLIP LOWER" ? colGammaFlip :
     u == "GAMMA CLIFF UP" ? colGammaCliffUp : u == "GAMMA CLIFF DOWN" ? colGammaCliffDown :
     u == "MAX PAIN" ? colMaxPain : u == "HEDGE WALL" ? colHedge :
     u == "0DTE PUT WALL" ? col0DTEPut : u == "LOCAL PUT NODE" ? colLocalPut : u == "DEX PUT NODE" ? colDexPut :
     u == "0DTE CALL WALL" ? col0DTECall : u == "LOCAL CALL NODE" ? colLocalCall : u == "DEX CALL NODE" ? colDexCall :
     u == "ABSOLUTE CALL WALL" ? colAbsCall : u == "GAMMA MAGNET" ? colGammaMagnet : u == "PIN STRIKE" ? colPinStrike : colFallback
f_level_style(string title) =>
    u = f_norm(title)
    str.contains(u, "GAMMA FLIP") ? line.style_dashed : str.contains(u, "GAMMA CLIFF") ? line.style_dotted :
     str.contains(u, "DEX") ? line.style_dashed : u == "GAMMA MAGNET" or u == "PIN STRIKE" ? line.style_dotted :
     str.contains(u, "0DTE") ? f_line_style(lineStyle0DTEInp) : str.contains(u, "EM") ? line.style_solid : str.contains(u, "LOCAL") ? f_line_style(lineStyleSecondaryInp) : f_line_style(lineStylePrimaryInp)
f_level_width(string title) =>
    u = f_norm(title)
    isEm = str.contains(u, "EM")
    isPrimaryEm = f_is_em_upper(u) or f_is_em_lower(u)
    str.contains(u, "0DTE") or str.contains(u, "LOCAL") or str.contains(u, "GAMMA FLIP") or str.contains(u, "GAMMA CLIFF") or str.contains(u, "DEX") or u == "GAMMA MAGNET" or u == "PIN STRIKE" or (isEm and not isPrimaryEm) ? lineWidthSecondary : lineWidthPrimary
f_compact_title(string title) =>
    u = f_norm(title)
    res = title
    if f_is_em_upper(u)
        res := str.replace(u, "UPPER EM", "EM+")
        // Remove year for brevity if date present (e.g. 2026-03-23 -> 03-23)
        if str.startswith(res, "20") and str.substring(res, 4, 5) == "-"
            res := str.substring(res, 5)
        if str.contains(res, "EM HI")
            res := str.replace(res, "EM HI", "EM+")
    else if f_is_em_lower(u)
        res := str.replace(u, "LOWER EM", "EM-")
        if str.startswith(res, "20") and str.substring(res, 4, 5) == "-"
            res := str.substring(res, 5)
        if str.contains(res, "EM LO")
            res := str.replace(res, "EM LO", "EM-")
    else if f_is_em85_upper(u)
        res := str.replace(u, "UPPER 85% STRADDLE", "EM85+")
        if str.contains(res, "EM85 HI")
            res := str.replace(res, "EM85 HI", "EM85+")
    else if f_is_em85_lower(u)
        res := str.replace(u, "LOWER 85% STRADDLE", "EM85-")
        if str.contains(res, "EM85 LO")
            res := str.replace(res, "EM85 LO", "EM85-")
    else if u == "ABSOLUTE CALL WALL"
        res := "CALL ABS"
    else if u == "LOCAL CALL NODE"
        res := "CALL LOC"
    else if u == "0DTE CALL WALL"
        res := "CALL 0DTE"
    else if u == "DEX CALL NODE"
        res := "DEX C"
    else if u == "GAMMA FLIP UPPER"
        res := "GF U"
    else if u == "GAMMA CLIFF UP"
        res := "GC U"
    else if u == "ZERO GAMMA"
        res := "ZG"
    else if u == "GAMMA CLIFF DOWN"
        res := "GC D"
    else if u == "GAMMA FLIP LOWER"
        res := "GF L"
    else if u == "MAX PAIN"
        res := "MAX"
    else if u == "0DTE PUT WALL"
        res := "PUT 0DTE"
    else if u == "LOCAL PUT NODE"
        res := "PUT LOC"
    else if u == "DEX PUT NODE"
        res := "DEX P"
    else if u == "HEDGE WALL"
        res := "HEDGE"
    else if u == "GAMMA MAGNET"
        res := "MAG"
    else if u == "PIN STRIKE"
        res := "PIN"
    res
f_show_level(string title, string lineText) =>
    u = f_norm(title)
    bool show = true
    if str.contains(u, "EM")
        show := showEMLevels
        if show and maxEMDte > 0 and str.contains(u, "(") and str.contains(u, "D)")
            // Extract the DTE number between '(' and 'd)'
            openParen = str.pos(u, "(")
            closeD = str.pos(u, "D)")
            if not na(openParen) and not na(closeD) and closeD > openParen + 1
                dteStr = str.substring(u, openParen + 1, closeD)
                dte = str.tonumber(dteStr)
                if not na(dte) and dte > maxEMDte
                    show := false
    else if u == "GAMMA MAGNET"
        show := showGammaMagnet
    else if u == "PIN STRIKE"
        show := showPinStrike
    else if str.contains(u, "DEX CALL") or str.contains(u, "DEX PUT")
        show := showDexLevels
    else if str.contains(u, "CALL")
        show := showCallLevels
    else if str.contains(u, "PUT")
        show := showPutLevels
    else if u == "ZERO GAMMA" or u == "ZERO GEX"
        show := showZeroGammaLevel
    else if u == "ZERO GAMMA DA" or u == "ZERO GEX DA"
        show := showZeroGammaDALevel
    else if str.contains(u, "GAMMA FLIP")
        show := showGammaFlipLevels
    else if str.contains(u, "GAMMA CLIFF")
        show := showGammaCliffLevels
    else if u == "MAX PAIN"
        show := showMaxPainLevel
    else if u == "HEDGE WALL"
        show := showHedgeLevel
    show

f_parse_dte_from_title(string title) =>
    // Expected format: "2026-03-23 EM+" or "2026-03-23 UPPER EM"
    // We can't easily calculate DTE from a date string in Pine Script without heavy logic.
    // So we'll skip the DTE filter in the script for now and just show all if EM is on.
    // UNLESS we add DTE to the label in the python script.
    0

f_is_same_price(float l, float r) => math.abs(l - r) <= syminfo.mintick * 0.25
f_has_merged_token(string merged, string token) =>
    bool found = false
    toks = str.split(merged, "+")
    if array.size(toks) > 0
        for i = 0 to array.size(toks) - 1
            if f_norm(array.get(toks, i)) == f_norm(token)
                found := true
                break
    found
f_assign_label_column(float level, array<float> cols, float gap, int maxC, string mode) =>
    int a = -1
    if mode == "Off"
        a := 0
    else
        if array.size(cols) > 0
            for c = 0 to array.size(cols) - 1
                if math.abs(level - array.get(cols, c)) >= gap
                    a := c
                    break
        if a == -1
            if array.size(cols) < maxC
                array.push(cols, level)
                a := array.size(cols) - 1
            else if mode == "Hide"
                a := -1
            else
                bG = -1.0
                bC = 0
                for c = 0 to array.size(cols) - 1
                    g = math.abs(level - array.get(cols, c))
                    if g > bG
                        bG := g
                        bC := c
                a := bC
    if a >= 0
        if a >= array.size(cols)
            array.push(cols, level)
        else
            array.set(cols, a, level)
    a
f_clear_drawings(array<line> lns, array<label> lbs) =>
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
    array.clear(lns)
    array.clear(lbs)

// ═══════════════════════════════════════════════════════════════════════
// SESSION
// ═══════════════════════════════════════════════════════════════════════
var string TZ = "America/New_York"
var int SESSION_SHIFT_MS = 6 * 60 * 60 * 1000
f_session_key() =>
    rt = f_is_overnight_futures(f_primary_symbol()) ? time + SESSION_SHIFT_MS : time
    year(rt, TZ) * 10000 + month(rt, TZ) * 100 + dayofmonth(rt, TZ)
sessionKey = f_session_key()
isNewSession = ta.change(sessionKey) != 0
var int sessionStartBar = 0
if barstate.isfirst or isNewSession
    sessionStartBar := bar_index

// ═══════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════
var array<line> lvlLines = array.new_line()
var array<label> lvlLabels = array.new_label()
var array<int> lblCols = array.new_int()
var array<float> lblColLast = array.new_float()
var array<float> pPrices = array.new_float()
var array<string> pTitles = array.new_string()
// Unified dashboard table — created dynamically based on position input
var table dashTbl = na
var line emUF = na
var line emLF = na
var linefill emBF = na
var line gfUF = na
var line gfLF = na
var linefill gfBF = na
var float pZG = na
var float pZG_DA = na
var float pGFU = na
var float pGFL = na
var float pGCU = na
var float pGCD = na
var float pCW = na
var float pCW0 = na
var float pPW0 = na
var float pLCN = na
var float pLPN = na
var float pDCN = na
var float pDPN = na
var float pHW = na
var float pMP = na
var float pEU = na
var float pEL = na
var float pMAG = na
var float pPIN = na
var string lastSL = ""
var string lastMA = ""
var string lastFSP = ""
var bool lastOE = false
var string selLine = ""
var string mAsset = ""
lblSize = f_label_size(labelSizeInp)
dashSize = f_label_size(dashTextSize)

// Recreate table if position changed
if barstate.isfirst
    dashTbl := table.new(f_position(dashPosition), 2, 15, bgcolor = color.new(color.black, dashBgOpacity), border_width = 0)

selUpd = barstate.isfirst or familySourcePreference != lastFSP or overrideExactWithFamilyPreference != lastOE
if selUpd
    [nl, na2] = f_find_matching_line(pastedData)
    selLine := nl
    mAsset := na2

needsDraw = barstate.isfirst or isNewSession or selUpd or selLine != lastSL or mAsset != lastMA

if needsDraw
    f_clear_drawings(lvlLines, lvlLabels)
    array.clear(lblCols)
    array.clear(lblColLast)
    line.delete(emUF)
    line.delete(emLF)
    linefill.delete(emBF)
    line.delete(gfUF)
    line.delete(gfLF)
    linefill.delete(gfBF)
    emUF := na
    emLF := na
    emBF := na
    gfUF := na
    gfLF := na
    gfBF := na
    pZG := na
    pZG_DA := na
    pGFU := na
    pGFL := na
    pGCU := na
    pGCD := na
    pCW := na
    pCW0 := na
    pPW0 := na
    pLCN := na
    pLPN := na
    pDCN := na
    pDPN := na
    pHW := na
    pMP := na
    pEU := na
    pEL := na
    pMAG := na
    pPIN := na

    if str.length(selLine) > 0
        f_parse_levels(selLine, pPrices, pTitles)

        sC = f_canonical_symbol(mAsset)
        pC = f_canonical_symbol(f_primary_symbol())
        sF = f_symbol_family_key(sC)
        cF = f_symbol_family_key(pC)
        sFut = f_is_overnight_futures(sC)
        cFut = f_is_overnight_futures(pC)

        if cFut and sF == cF and not sFut
            anc = f_family_futures_anchor(cF)
            aLine = f_find_asset_line(pastedData, anc)
            bool conv = false
            if str.length(aLine) > 0
                rP = array.new_float()
                rT = array.new_string()
                f_parse_levels(aLine, rP, rT)
                if array.size(rP) > 0 and array.size(pPrices) > 0
                    sR = array.get(pPrices, 0)
                    aR = array.get(rP, 0)
                    if math.abs(sR) > syminfo.mintick
                        sc2 = aR / sR
                        for i = 0 to array.size(pPrices) - 1
                            array.set(pPrices, i, array.get(pPrices, i) * sc2)
                        conv := true
                    if not conv
                        ba = aR - sR
                        for i = 0 to array.size(pPrices) - 1
                            array.set(pPrices, i, array.get(pPrices, i) + ba)
                        conv := true
            if not conv and array.size(pPrices) > 0
                sR = array.get(pPrices, 0)
                if math.abs(sR) > syminfo.mintick
                    fs = close / sR
                    for i = 0 to array.size(pPrices) - 1
                        array.set(pPrices, i, array.get(pPrices, i) * fs)

        float eUP = na
        float eLP = na
        float gUP = na
        float gLP = na
        uL = array.new_float()
        uT = array.new_string()
        uC = array.new_color()
        uW = array.new_int()
        uS = array.new_string()

        if array.size(pPrices) > 0
            for idx = 0 to array.size(pPrices) - 1
                lv = array.get(pPrices, idx)
                ti = array.get(pTitles, idx)
                show = f_show_level(ti, selLine)
                if show
                    ct = compactLabels ? f_compact_title(ti) : ti
                    ei = -1
                    if mergeSamePriceLabels and array.size(uL) > 0
                        for u = 0 to array.size(uL) - 1
                            if f_is_same_price(lv, array.get(uL, u))
                                ei := u
                                break
                    if ei >= 0
                        mt = array.get(uT, ei)
                        nm = f_has_merged_token(mt, ct) ? mt : mt + " + " + ct
                        array.set(uT, ei, nm)
                    else
                        array.push(uL, lv)
                        array.push(uT, ct)
                        array.push(uC, f_level_color(ti))
                        array.push(uW, f_level_width(ti))
                        sk = str.contains(f_norm(ti), "0DTE") ? lineStyle0DTEInp : str.contains(f_norm(ti), "LOCAL") ? lineStyleSecondaryInp : lineStylePrimaryInp
                        array.push(uS, sk)

                tn = f_norm(ti)
                if f_is_em_upper(tn)
                    eUP := lv
                    pEU := lv
                if f_is_em_lower(tn)
                    eLP := lv
                    pEL := lv
                if tn == "ZERO GAMMA" or tn == "ZERO GEX"
                    pZG := lv
                if tn == "ZERO GAMMA DA" or tn == "ZERO GEX DA"
                    pZG_DA := lv
                if tn == "GAMMA FLIP UPPER"
                    gUP := lv
                    pGFU := lv
                if tn == "GAMMA FLIP LOWER"
                    gLP := lv
                    pGFL := lv
                if tn == "GAMMA CLIFF UP"
                    pGCU := lv
                if tn == "GAMMA CLIFF DOWN"
                    pGCD := lv
                if tn == "ABSOLUTE CALL WALL"
                    pCW := lv
                if tn == "0DTE CALL WALL"
                    pCW0 := lv
                if tn == "0DTE PUT WALL"
                    pPW0 := lv
                if tn == "LOCAL CALL NODE"
                    pLCN := lv
                if tn == "LOCAL PUT NODE"
                    pLPN := lv
                if tn == "DEX CALL NODE"
                    pDCN := lv
                if tn == "DEX PUT NODE"
                    pDPN := lv
                if tn == "HEDGE WALL"
                    pHW := lv
                if tn == "MAX PAIN"
                    pMP := lv
                if tn == "GAMMA MAGNET"
                    pMAG := lv
                if tn == "PIN STRIKE"
                    pPIN := lv

        if array.size(uL) > 0
            for u = 0 to array.size(uL) - 1
                dl = array.get(uL, u)
                dc = array.get(uC, u)
                dw = array.get(uW, u)
                ds = f_line_style(array.get(uS, u))
                dt = array.get(uT, u)
                ll = line.new(sessionStartBar, dl, bar_index + 1, dl, color = dc, width = dw, style = ds, extend = extend.none)
                array.push(lvlLines, ll)
                if showLabels
                    mg = syminfo.mintick * minLabelGapTicks
                    lc = f_assign_label_column(dl, lblColLast, mg, maxLabelColumns, labelCollisionMode)
                    if lc >= 0
                        lx = bar_index + labelOffset + (lc * columnStepBars)
                        txt = showPriceInLabel ? dt + "  " + str.tostring(dl, "#.##") : dt
                        lb = label.new(lx, dl, txt, textcolor = dc, color = color.new(color.black, labelBgOpacity), style = label.style_label_left, size = lblSize)
                        array.push(lvlLabels, lb)
                        array.push(lblCols, lc)

        if showEmFill and not na(eUP) and not na(eLP)
            emUF := line.new(sessionStartBar, eUP, bar_index + 1, eUP, color = color.new(color.aqua, 95), width = 1)
            emLF := line.new(sessionStartBar, eLP, bar_index + 1, eLP, color = color.new(color.aqua, 95), width = 1)
            emBF := linefill.new(emUF, emLF, colEmFill)
        if showGammaFlipLevels and not na(gUP) and not na(gLP)
            gfUF := line.new(sessionStartBar, gUP, bar_index + 1, gUP, color = color.new(color.yellow, 95), width = 1)
            gfLF := line.new(sessionStartBar, gLP, bar_index + 1, gLP, color = color.new(color.yellow, 95), width = 1)
            gfBF := linefill.new(gfUF, gfLF, colGammaFlipFill)

    lastSL := selLine
    lastMA := mAsset
    lastFSP := familySourcePreference
    lastOE := overrideExactWithFamilyPreference

// ── Extend lines ──
if array.size(lvlLines) > 0
    for i = 0 to array.size(lvlLines) - 1
        line.set_x2(array.get(lvlLines, i), bar_index)
if not na(emUF)
    line.set_x2(emUF, bar_index)
if not na(emLF)
    line.set_x2(emLF, bar_index)
if not na(gfUF)
    line.set_x2(gfUF, bar_index)
if not na(gfLF)
    line.set_x2(gfLF, bar_index)
if array.size(lvlLabels) > 0
    for i = 0 to array.size(lvlLabels) - 1
        c = i < array.size(lblCols) ? array.get(lblCols, i) : 0
        label.set_x(array.get(lvlLabels, i), bar_index + labelOffset + (c * columnStepBars))

// ═══════════════════════════════════════════════════════════════════════
// UNIFIED DASHBOARD
// ═══════════════════════════════════════════════════════════════════════
if barstate.islast and showDashboard and not na(dashTbl)
    // ── Derived metrics ──
    emV = not na(pEU) and not na(pEL) ? (pEU - pEL) / 2.0 : na
    wSep = not na(pCW) and not na(pPW0) ? math.abs(pCW - pPW0) : na
    tight = not na(wSep) and not na(emV) and emV > 0 ? wSep < emV : false
    regime = tight ? "COILED / PINNED" : "TRENDING / BATTLE"
    lClr = tight ? color.yellow : color.lime
    lE = tight ? "🟡" : "🟢"

    // ── Directional bias: price vs magnet ──
    biasScore = 0
    if not na(pMAG) and close > pMAG
        biasScore -= 1
    if not na(pMAG) and close < pMAG
        biasScore += 1
    // Put wall below call wall = normal; if most gamma is put-side, bearish
    if not na(pPW0) and not na(pCW) and pPW0 < pCW
        biasScore -= 1
    biasArrow = biasScore <= -1 ? " ↓" : biasScore >= 1 ? " ↑" : " ↔"
    biasLabel = biasScore <= -1 ? "BEARISH" : biasScore >= 1 ? "BULLISH" : "NEUTRAL"
    biasClr = biasScore <= -1 ? color.red : biasScore >= 1 ? color.lime : color.gray

    // ── Proximity triggers ──
    emV2 = not na(emV) ? emV : 50.0
    thr = emV2 * 3.0
    sTrig = f_best_short_trigger(close, thr, pGFL, pPW0, pLPN, pHW, pZG)
    lTrig = f_best_long_trigger(close, thr, pCW, pGFU, pCW0, pLCN, pZG)
    sTgt = f_nearest_below(sTrig, pPW0, pHW, pEL)
    sInv = f_nearest_above(sTrig, pCW, pGFU, pEU)
    lTgt = f_nearest_above(lTrig, pMP, pEU, pGFU)
    lInv = f_nearest_below(lTrig, pZG, pGFL, pPW0)

    primary = f_primary_symbol()
    resolved = str.length(mAsset) > 0 ? mAsset : "—"
    modeText = f_is_overnight_futures(primary) ? "Globex" : "Calendar"

    // Row  0: Header
    table.cell(dashTbl, 0, 0, primary + " | " + modeText, text_color = color.white, text_size = dashSize)
    table.cell(dashTbl, 1, 0, "Loaded: " + resolved, text_color = str.length(mAsset) > 0 ? color.lime : color.red, text_size = dashSize)
    // Row  1: Regime + Direction
    table.cell(dashTbl, 0, 1, "REGIME", text_color = color.gray, text_size = dashSize)
    table.cell(dashTbl, 1, 1, lE + " " + regime + biasArrow + " " + biasLabel, text_color = biasClr, text_size = dashSize)
    // Row  2: Market structure
    table.cell(dashTbl, 0, 2, "MAGNET", text_color = color.gray, text_size = dashSize)
    table.cell(dashTbl, 1, 2, f_num(pMAG), text_color = colGammaMagnet, text_size = dashSize)
    // Row  3: Pin
    table.cell(dashTbl, 0, 3, "PIN", text_color = color.gray, text_size = dashSize)
    table.cell(dashTbl, 1, 3, f_num(pPIN), text_color = colPinStrike, text_size = dashSize)
    // Row  4: Separation + EM
    table.cell(dashTbl, 0, 4, "SEP | EM±", text_color = color.gray, text_size = dashSize)
    table.cell(dashTbl, 1, 4, f_num(wSep) + " | " + f_num(emV), text_color = color.white, text_size = dashSize)
    // Row  5: ZG
    table.cell(dashTbl, 0, 5, "ZERO γ", text_color = color.gray, text_size = dashSize)
    table.cell(dashTbl, 1, 5, f_num(pZG), text_color = colZeroGamma, text_size = dashSize)
    // Row  6: ZG DA
    table.cell(dashTbl, 0, 6, "ZERO γ DA", text_color = color.gray, text_size = dashSize)
    table.cell(dashTbl, 1, 6, f_num(pZG_DA), text_color = colZeroGammaDA, text_size = dashSize)
    // Row  7: Cliffs
    table.cell(dashTbl, 0, 7, "CLIFFS", text_color = color.gray, text_size = dashSize)
    table.cell(dashTbl, 1, 7, "↓" + f_num(pGCD) + " | ↑" + f_num(pGCU), text_color = color.teal, text_size = dashSize)
    // Row  8: Separator
    table.cell(dashTbl, 0, 8, "", text_size = size.tiny)
    table.cell(dashTbl, 1, 8, "", text_size = size.tiny)
    // Row  9: Narrative header
    table.cell(dashTbl, 0, 9, "PLAN", text_color = color.white, text_size = dashSize)
    dexInfo = ""
    if not na(pDPN) or not na(pDCN)
        dexInfo := "DEX " + f_num(pDPN) + "/" + f_num(pDCN)
    table.cell(dashTbl, 1, 9, dexInfo, text_color = color.white, text_size = dashSize)
    // Row 10: Short
    sZ = ""
    if not na(pGCD)
        sZ := "GC↓" + f_num(pGCD) + " "
    if not na(pDPN)
        sZ := sZ + "DEX " + f_num(pDPN)
    table.cell(dashTbl, 0, 10, "SHORT", text_color = color.red, text_size = dashSize)
    table.cell(dashTbl, 1, 10, "< " + f_num(sTrig) + " → " + f_num(sTgt) + " inv > " + f_num(sInv), text_color = color.red, text_size = dashSize)
    // Row 11: Short zones
    table.cell(dashTbl, 0, 11, "", text_size = size.tiny)
    table.cell(dashTbl, 1, 11, str.length(sZ) > 0 ? sZ : "", text_color = color.new(color.red, 40), text_size = dashSize)
    // Row 12: Long
    lZ = ""
    if not na(pGCU)
        lZ := "GC↑" + f_num(pGCU) + " "
    if not na(pDCN)
        lZ := lZ + "DEX " + f_num(pDCN)
    table.cell(dashTbl, 0, 12, "LONG", text_color = color.lime, text_size = dashSize)
    table.cell(dashTbl, 1, 12, "> " + f_num(lTrig) + " → " + f_num(lTgt) + " inv < " + f_num(lInv), text_color = color.lime, text_size = dashSize)
    // Row 13: Long zones
    table.cell(dashTbl, 0, 13, "", text_size = size.tiny)
    table.cell(dashTbl, 1, 13, str.length(lZ) > 0 ? lZ : "", text_color = color.new(color.lime, 40), text_size = dashSize)
    // Row 14: EM
    table.cell(dashTbl, 0, 14, "EM", text_color = color.aqua, text_size = dashSize)
    table.cell(dashTbl, 1, 14, f_num(pEL) + " ↔ " + f_num(pEU), text_color = color.aqua, text_size = dashSize)

if barstate.islast and not showDashboard and not na(dashTbl)
    table.clear(dashTbl, 0, 0, 1, 14)
