//@version=6
indicator('Daily Profile Classifier (R1, R2, DWP, DNP) v2', 'DP Classification v2', overlay = true, max_boxes_count = 498, max_lines_count = 166, max_labels_count = 500)

// ============================================================================
// SETTINGS & INPUTS
// ============================================================================
var string TIMEZONE = 'America/New_York'

// Input Settings
string i_group_display = "Display Settings"
bool i_debug = input.bool(defval = false, title = "Show Debug Info", group = i_group_display)
bool i_showHourlyBoxes = input.bool(defval = true, title = "Show Hourly Boxes", group = i_group_display)
bool i_showORBox = input.bool(defval = true, title = "Show Opening Range Box", group = i_group_display)
bool i_showVerticalLines = input.bool(defval = true, title = "Show Vertical Lines", group = i_group_display)
bool i_showTable = input.bool(defval = true, title = "Show Statistics Table", group = i_group_display)

string i_group_session = "Session Settings"
int i_sessionStartHour = input.int(defval = 9, title = "Session Start Hour", minval = 0, maxval = 23, group = i_group_session)
int i_sessionStartMin = input.int(defval = 30, title = "Session Start Minute", minval = 0, maxval = 59, group = i_group_session)
int i_sessionEndHour = input.int(defval = 15, title = "Session End Hour (Classification)", minval = 0, maxval = 23, group = i_group_session)
int i_returnWindowStartHour = input.int(defval = 11, title = "R2 Return Window Start Hour", minval = 0, maxval = 23, group = i_group_session)

string i_group_classification = "Classification Settings"
int i_minTouchesForR1 = input.int(defval = 4, title = "Min OR Touches for Range 1", minval = 2, maxval = 10, group = i_group_classification)
int i_minSeparationForR2 = input.int(defval = 1, title = "Min Hours Between Break & Return for R2", minval = 1, maxval = 5, group = i_group_classification)
float i_orTolerance = input.float(defval = 2.0, title = "OR Touch Tolerance (ticks)", minval = 0, maxval = 20, step = 0.5, group = i_group_classification, tooltip = "How close price needs to be to OR to count as a touch (in ticks)")

// ============================================================================
// COLORS
// ============================================================================
string i_group_colors = "Colors"
color i_hourlyBoxColor = input.color(defval = color.new(color.blue, 85), title = "Hourly Box", group = i_group_colors)
color i_orBoxColor = input.color(defval = color.new(color.green, 80), title = "Opening Range Box", group = i_group_colors)
color i_vlineColor = input.color(defval = color.new(#353533, 27), title = "Vertical Lines", group = i_group_colors)
color i_borderColor = input.color(defval = color.new(color.gray, 50), title = "Box Border", group = i_group_colors)
color i_labelBgColor = input.color(defval = color.new(color.black, 10), title = "Label Background", group = i_group_colors)
color i_labelTextColor = input.color(defval = color.white, title = "Label Text", group = i_group_colors)

// ============================================================================
// TIME CALCULATIONS
// ============================================================================
int hour_ny = hour(time, TIMEZONE)
int minute_ny = minute(time, TIMEZONE)
int day_ny = dayofmonth(time, TIMEZONE)
bool isNewDay = bool(ta.change(day_ny))

// Build session string dynamically
string sessionStr = str.format("{0,number,00}{1,number,00}-{2,number,00}00", i_sessionStartHour, i_sessionStartMin, i_sessionEndHour + 1)
bool inSession = not na(time(timeframe.period, sessionStr, TIMEZONE))
bool endOfSession = not inSession and inSession[1]

// ============================================================================
// DATA STRUCTURES
// ============================================================================
// Day analysis result type
type DayAnalysis
    bool broke_or = false
    int broke_or_index = -1
    bool broke_up = false
    bool returned_to_or = false
    int return_hour_index = -1
    int or_touch_count = 0
    bool has_pullback = false
    string debug_str = ""

// ============================================================================
// STATE VARIABLES
// ============================================================================
var float or_high = na
var float or_low = na

// Counters
var int r1_count = 0
var int r2_count = 0
var int dwp_count = 0
var int dnp_count = 0
var int unclassified_count = 0

// Daily variables
var string day_type_str = ''

// Arrays to store hourly range data for the day
var daily_hourly_highs = array.new_float()
var daily_hourly_lows = array.new_float()

// Box references
var box hourlyBox = na
var box orBox = na

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Check if an hourly candle touches the OR (overlaps with OR range, with tolerance)
touchesOR(float h_high, float h_low, float _or_high, float _or_low, float tolerance) =>
    h_high >= (_or_low - tolerance) and h_low <= (_or_high + tolerance)

// Check if an hourly candle is completely outside OR (broke away, with tolerance)
brokeOR(float h_high, float h_low, float _or_high, float _or_low, float tolerance) =>
    h_low > (_or_high + tolerance) or h_high < (_or_low - tolerance)

// Get hour index from array index (0 = 9:30 hour, 1 = 10:00 hour, 2 = 11:00 hour, etc.)
getHourFromIndex(int idx, int startHour) =>
    startHour + idx

// ============================================================================
// ANALYSIS FUNCTIONS
// ============================================================================

// Analyze the day's price action relative to OR
analyzeDayProfile(array<float> highs, array<float> lows, float _or_high, float _or_low, int returnWindowStartHour, int sessionStartHour, float tolerance) =>
    DayAnalysis result = DayAnalysis.new()
    int size = array.size(highs)
    
    if size < 2
        result
    else
        // Calculate the array index where the return window starts (11:00 by default)
        // Index 0 = 9:30 hour, Index 1 = 10:00 hour, Index 2 = 11:00 hour
        int returnWindowStartIndex = returnWindowStartHour - sessionStartHour
        
        // Step 1: Find where price first breaks OR and count initial touches
        for i = 0 to size - 1
            float h_high = array.get(highs, i)
            float h_low = array.get(lows, i)
            
            if brokeOR(h_high, h_low, _or_high, _or_low, tolerance)
                result.broke_or := true
                result.broke_or_index := i
                result.broke_up := h_low > (_or_high + tolerance)
                result.debug_str += "Broke OR at idx " + str.tostring(i) + " "
                break
            else if touchesOR(h_high, h_low, _or_high, _or_low, tolerance)
                result.or_touch_count += 1
        
        // Step 2: If broke OR, check for return to OR after the break
        if result.broke_or and result.broke_or_index < size - 1
            for i = result.broke_or_index + 1 to size - 1
                float h_high = array.get(highs, i)
                float h_low = array.get(lows, i)
                
                if touchesOR(h_high, h_low, _or_high, _or_low, tolerance)
                    result.returned_to_or := true
                    result.return_hour_index := i
                    result.or_touch_count += 1
                    result.debug_str += "Returned at idx " + str.tostring(i) + " "
                    break
        
        // Step 3: Check for pullbacks in directional moves (only if broke OR)
        // Only exclude the final hour (15:00) from pullback detection
        // pullbackEndIndex is the last index we check
        int pullbackEndIndex = size - 2
        
        // Only check for pullbacks if:
        // 1. We broke OR
        // 2. We have enough data points
        // 3. There's at least one candle between break and pullback end
        if result.broke_or and result.broke_or_index >= 0 and pullbackEndIndex > result.broke_or_index
            
            if result.broke_up
                // Uptrend (broke above OR): 
                // DNP = each hourly low is higher than or equal to all previous lows (higher lows)
                // DWP = at some point an hourly low goes BELOW a previous hourly low
                // Track the HIGHEST low seen - if current low drops below it, that's a pullback
                float highest_low = array.get(lows, result.broke_or_index)
                for i = result.broke_or_index + 1 to pullbackEndIndex
                    if i < size  // Extra bounds check
                        float current_low = array.get(lows, i)
                        if current_low < highest_low
                            result.has_pullback := true
                            result.debug_str += "Pullback (up) at idx " + str.tostring(i) + " "
                            break
                        highest_low := math.max(highest_low, current_low)
            else
                // Downtrend (broke below OR): 
                // DNP = each hourly high is lower than or equal to all previous highs (lower highs)
                // DWP = at some point an hourly high goes ABOVE a previous hourly high
                // Track the LOWEST high seen - if current high rises above it, that's a pullback
                float lowest_high = array.get(highs, result.broke_or_index)
                for i = result.broke_or_index + 1 to pullbackEndIndex
                    if i < size  // Extra bounds check
                        float current_high = array.get(highs, i)
                        if current_high > lowest_high
                            result.has_pullback := true
                            result.debug_str += "Pullback (dn) at idx " + str.tostring(i) + " "
                            break
                        lowest_high := math.min(lowest_high, current_high)
        
        result.debug_str += "Touches: " + str.tostring(result.or_touch_count) + " "
        result

// Classify the day based on analysis
classifyDay(DayAnalysis analysis, int minTouchesForR1, int minSeparationForR2, int returnWindowStartIndex) =>
    string classification = ""
    string debug = ""
    
    // Priority order for classification:
    // 1. Range 1: Price stayed near OR most of the day (4+ touches) - takes precedence if lots of OR interaction
    // 2. Range 2: Broke OR, then returned after 11:00 with sufficient separation (meaningful breakout then reversal)
    // 3. DWP: Broke OR (directional move with pullbacks)
    // 4. DNP: Broke OR (directional move without pullbacks)
    
    // Check if this qualifies as R2 (meaningful breakout followed by reversal)
    bool returnAfterWindow = analysis.return_hour_index >= returnWindowStartIndex
    int separation = analysis.return_hour_index - analysis.broke_or_index
    bool enoughSeparation = separation >= minSeparationForR2
    
    bool isR2Candidate = analysis.broke_or and analysis.returned_to_or and returnAfterWindow and enoughSeparation
    
    // R1 takes precedence if there are 4+ touches - this means price spent significant time at OR
    // regardless of whether it eventually broke out
    bool isR1Candidate = analysis.or_touch_count >= minTouchesForR1
    
    debug := "retIdx:" + str.tostring(analysis.return_hour_index) + 
             " winIdx:" + str.tostring(returnWindowStartIndex) + 
             " sep:" + str.tostring(separation) + 
             " R2?" + str.tostring(isR2Candidate) + " "
    
    // A day is directional ONLY if it broke OR AND doesn't qualify as R1 or R2
    bool isDirectionalDay = analysis.broke_or and not isR2Candidate and not isR1Candidate
    
    if isR1Candidate and not isR2Candidate
        // Range 1: Spent significant time testing OR (4+ touches)
        // This takes precedence over directional classification
        classification := "Range 1"
    else if isR2Candidate
        // Range 2: Broke away then returned after the specified window with enough separation
        classification := "Range 2"
    else if isDirectionalDay
        // Directional day - broke OR without significant OR interaction
        // Check for pullbacks to distinguish DWP from DNP
        if analysis.has_pullback
            classification := "DWP"
        else
            classification := "DNP"
    else if not analysis.broke_or
        // Never broke OR - default to Range 1
        classification := "Range 1"
    else
        // Fallback (shouldn't reach here)
        classification := "Range 1"
    
    [classification, debug]

// ============================================================================
// DAILY RESET
// ============================================================================
if isNewDay
    or_high := na
    or_low := na
    day_type_str := ''
    array.clear(daily_hourly_highs)
    array.clear(daily_hourly_lows)

// ============================================================================
// OPENING RANGE DETECTION
// ============================================================================
bool isFirstBarOfOR = hour_ny == i_sessionStartHour and minute_ny == i_sessionStartMin
[h_1m, l_1m] = request.security(syminfo.tickerid, '1', [high, low])

if isFirstBarOfOR and na(or_high)
    or_high := h_1m
    or_low := l_1m
    
    if i_showORBox
        orBox := box.new(
             timestamp(TIMEZONE, year, month, dayofmonth, i_sessionStartHour, i_sessionStartMin), 
             or_high, 
             timestamp(TIMEZONE, year, month, dayofmonth, i_sessionEndHour, 0), 
             or_low, 
             border_color = i_borderColor, 
             bgcolor = i_orBoxColor, 
             xloc = xloc.bar_time
             )

// ============================================================================
// HOURLY BOX TRACKING
// ============================================================================
bool isNewHour = inSession and bool(ta.change(hour_ny))

if isNewHour
    if i_showHourlyBoxes
        hourlyBox := box.new(bar_index, high, bar_index + 1, low, border_color = i_borderColor, bgcolor = i_hourlyBoxColor)
    
    // Add the first candle's high/low of the new hour to our daily arrays
    array.push(daily_hourly_highs, high)
    array.push(daily_hourly_lows, low)

if inSession and not isNewHour
    if i_showHourlyBoxes and not na(hourlyBox)
        box.set_right(hourlyBox, bar_index + 1)
        float new_high = math.max(high, box.get_top(hourlyBox))
        float new_low = math.min(low, box.get_bottom(hourlyBox))
        box.set_top(hourlyBox, new_high)
        box.set_bottom(hourlyBox, new_low)
    
    // Update the high/low for the current hour in our arrays
    if array.size(daily_hourly_highs) > 0
        float current_box_high = i_showHourlyBoxes and not na(hourlyBox) ? box.get_top(hourlyBox) : high
        float current_box_low = i_showHourlyBoxes and not na(hourlyBox) ? box.get_bottom(hourlyBox) : low
        
        // Recalculate properly if boxes aren't shown
        if not i_showHourlyBoxes
            current_box_high := math.max(high, array.get(daily_hourly_highs, array.size(daily_hourly_highs) - 1))
            current_box_low := math.min(low, array.get(daily_hourly_lows, array.size(daily_hourly_lows) - 1))
        
        array.set(daily_hourly_highs, array.size(daily_hourly_highs) - 1, current_box_high)
        array.set(daily_hourly_lows, array.size(daily_hourly_lows) - 1, current_box_low)

// ============================================================================
// END-OF-DAY CLASSIFICATION
// ============================================================================
if endOfSession and not na(or_high)
    // Calculate the return window start index
    int returnWindowStartIndex = i_returnWindowStartHour - i_sessionStartHour
    
    // Convert tolerance from ticks to price
    float tolerancePrice = i_orTolerance * syminfo.mintick
    
    // Analyze the day
    DayAnalysis analysis = analyzeDayProfile(
         daily_hourly_highs, 
         daily_hourly_lows, 
         or_high, 
         or_low, 
         i_returnWindowStartHour, 
         i_sessionStartHour,
         tolerancePrice
         )
    
    // Classify the day
    [day_type_str, classifyDebug] = classifyDay(analysis, i_minTouchesForR1, i_minSeparationForR2, returnWindowStartIndex)
    
    // Update counters
    switch day_type_str
        "Range 1" => r1_count += 1
        "Range 2" => r2_count += 1
        "DWP" => dwp_count += 1
        "DNP" => dnp_count += 1
        => unclassified_count += 1
    
    // Prepare display text
    string displayText = day_type_str + ' ' + str.format_time(time, 'MM/dd/yy', TIMEZONE)
    if i_debug
        displayText := analysis.debug_str + classifyDebug + " | " + displayText
    
    // Update OR box with classification
    if i_showORBox and not na(orBox)
        box.set_text(orBox, displayText)
        box.set_text_halign(orBox, text.align_right)
    
    // Draw vertical lines
    if i_showVerticalLines
        line.new(timestamp(TIMEZONE, year, month, dayofmonth, i_sessionStartHour, i_sessionStartMin), 0, 
                 timestamp(TIMEZONE, year, month, dayofmonth, i_sessionStartHour, i_sessionStartMin), 1, 
                 extend = extend.both, color = i_vlineColor, style = line.style_solid, xloc = xloc.bar_time)
        
        line.new(timestamp(TIMEZONE, year, month, dayofmonth, i_returnWindowStartHour, 0), 0, 
                 timestamp(TIMEZONE, year, month, dayofmonth, i_returnWindowStartHour, 0), 2, 
                 extend = extend.both, color = i_vlineColor, style = line.style_dotted, xloc = xloc.bar_time)
        
        line.new(timestamp(TIMEZONE, year, month, dayofmonth, i_sessionEndHour, 0), 0, 
                 timestamp(TIMEZONE, year, month, dayofmonth, i_sessionEndHour, 0), 1, 
                 extend = extend.both, color = i_vlineColor, style = line.style_solid, xloc = xloc.bar_time)

// ============================================================================
// STATISTICS TABLE
// ============================================================================
int dayCounter = r1_count + r2_count + dwp_count + dnp_count + unclassified_count

var table reportTable = table.new(position.top_right, 3, 8, border_width = 1)

if barstate.islast and i_showTable
    // Header
    table.cell(reportTable, 0, 0, 'Day Type', text_color = color.white, bgcolor = color.black)
    table.cell(reportTable, 1, 0, 'Count', text_color = color.white, bgcolor = color.black)
    table.cell(reportTable, 2, 0, '%', text_color = color.white, bgcolor = color.black)
    
    // Total Days
    table.cell(reportTable, 0, 1, 'Total Days', bgcolor = color.gray, text_color = color.white)
    table.cell(reportTable, 1, 1, str.tostring(dayCounter), bgcolor = color.gray, text_color = color.white)
    table.cell(reportTable, 2, 1, '100%', bgcolor = color.gray, text_color = color.white)
    
    // Range 1
    float r1_pct = dayCounter > 0 ? r1_count / dayCounter * 100 : 0
    table.cell(reportTable, 0, 2, 'Range 1', bgcolor = color.new(color.blue, 70))
    table.cell(reportTable, 1, 2, str.tostring(r1_count), bgcolor = color.new(color.blue, 70))
    table.cell(reportTable, 2, 2, str.tostring(r1_pct, '#.#') + '%', bgcolor = color.new(color.blue, 70))
    
    // Range 2
    float r2_pct = dayCounter > 0 ? r2_count / dayCounter * 100 : 0
    table.cell(reportTable, 0, 3, 'Range 2', bgcolor = color.new(color.purple, 70))
    table.cell(reportTable, 1, 3, str.tostring(r2_count), bgcolor = color.new(color.purple, 70))
    table.cell(reportTable, 2, 3, str.tostring(r2_pct, '#.#') + '%', bgcolor = color.new(color.purple, 70))
    
    // DWP
    float dwp_pct = dayCounter > 0 ? dwp_count / dayCounter * 100 : 0
    table.cell(reportTable, 0, 4, 'DWP', bgcolor = color.new(color.green, 70))
    table.cell(reportTable, 1, 4, str.tostring(dwp_count), bgcolor = color.new(color.green, 70))
    table.cell(reportTable, 2, 4, str.tostring(dwp_pct, '#.#') + '%', bgcolor = color.new(color.green, 70))
    
    // DNP
    float dnp_pct = dayCounter > 0 ? dnp_count / dayCounter * 100 : 0
    table.cell(reportTable, 0, 5, 'DNP', bgcolor = color.new(color.teal, 70))
    table.cell(reportTable, 1, 5, str.tostring(dnp_count), bgcolor = color.new(color.teal, 70))
    table.cell(reportTable, 2, 5, str.tostring(dnp_pct, '#.#') + '%', bgcolor = color.new(color.teal, 70))
    
    // Unclassified
    if unclassified_count > 0
        float unc_pct = dayCounter > 0 ? unclassified_count / dayCounter * 100 : 0
        table.cell(reportTable, 0, 6, 'Unclassified', bgcolor = color.new(color.orange, 70))
        table.cell(reportTable, 1, 6, str.tostring(unclassified_count), bgcolor = color.new(color.orange, 70))
        table.cell(reportTable, 2, 6, str.tostring(unc_pct, '#.#') + '%', bgcolor = color.new(color.orange, 70))
    
    // Directional vs Range Summary
    int range_total = r1_count + r2_count
    int directional_total = dwp_count + dnp_count
    float range_pct = dayCounter > 0 ? range_total / dayCounter * 100 : 0
    float dir_pct = dayCounter > 0 ? directional_total / dayCounter * 100 : 0
    
    table.cell(reportTable, 0, 7, 'Range/Dir', bgcolor = color.black, text_color = color.white)
    table.cell(reportTable, 1, 7, str.tostring(range_total) + '/' + str.tostring(directional_total), bgcolor = color.black, text_color = color.white)
    table.cell(reportTable, 2, 7, str.tostring(range_pct, '#') + '/' + str.tostring(dir_pct, '#') + '%', bgcolor = color.black, text_color = color.white)

// ============================================================================
// END OF SCRIPT
// ============================================================================
