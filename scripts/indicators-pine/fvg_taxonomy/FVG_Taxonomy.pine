//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  FVG Taxonomy — High-Probability Gap Qualifiers (HPG)
//  Companion to docs/trading/FVG_TAXONOMY.md
//
//  Qualifiers implemented:
//   SPATIAL   Breakaway gap (first FVG after BOS), Measuring gap (mid-trend)
//   ANATOMY   Overlapping-wick (OD) refinement, Opposite-direction candle 3
//   TIME      RTH First Presented FVG (9:30–10:00 NY), Midnight 1st FVG,
//             hourly 1st FVG, Friday/Monday First Presentation carry-forward
//   CONFLUENCE BPR (opposing FVG overlap), IFVG (with relevance filter),
//             MTF stack (LTF FVG inside HTF FVG, via request.security)
// ─────────────────────────────────────────────────────────────────────────────
indicator("FVG Taxonomy — HPG Qualifiers", "FVG-Tax", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ── Session / clock helpers (ET semantics; charts take UTC per ADR-001 — Pine handles via tz) ──
NY_TZ = "America/New York"
int nyHour   = hour(time, NY_TZ)
int nyMinute = minute(time, NY_TZ)
int nyDow    = dayofweek(time, NY_TZ)
bool newHour = nyHour != nyHour[1]
bool newDay  = ta.change(time("D")) != 0
bool newWeek = ta.change(time("W")) != 0

inRTHOpen(nyHour, nyMinute) =>
    (nyHour == 9 and nyMinute >= 30 and nyMinute <= 59) or (nyHour == 10 and nyMinute == 0)

// ── Inputs ──
grpQ = "Qualifiers"
showBreakaway  = input.bool(true, "Breakaway gap (first FVG after BOS)", group = grpQ)
showMeasuring  = input.bool(true, "Measuring gap (unfilled, mid-move)", group = grpQ)
showOD         = input.bool(true, "Overlapping-wick (OD) marker", group = grpQ)
showOppC3      = input.bool(true, "Opposite 3rd-candle marker", group = grpQ)
showFPFVG      = input.bool(true, "RTH First Presented FVG (9:30–10:00)", group = grpQ)
showMidnight   = input.bool(true, "Midnight 1st FVG", group = grpQ)
showHourly1st  = input.bool(true, "1st FVG of each hour", group = grpQ)
showFriMon     = input.bool(true, "Fri/Mon First Presentation carry-forward", group = grpQ)
showBPR        = input.bool(true, "BPR (opposing FVG overlap)", group = grpQ)
showIFVG       = input.bool(true, "IFVG (relevance-filtered)", group = grpQ)
showStack      = input.bool(true, "MTF stack (LTF FVG inside HTF FVG)", group = grpQ)

grpD = "Detection"
minGapTicks   = input.float(0.0, "Min gap size (ticks, 0 = off)", group = grpD)
bosLen        = input.int(5, "BOS pivot length (breakaway)", group = grpD)
htfTF         = input.timeframe("60", "HTF for stacking", group = grpD)
maxZones      = input.int(30, "Max active zones per side", group = grpD, minval = 5, maxval = 100)
extendZones   = input.bool(true, "Extend zones right until mitigated", group = grpD)

grpC = "Colors"
colBullFVG   = input.color(color.new(#26a69a, 80), "Bull FVG", group = grpC)
colBearFVG   = input.color(color.new(#ef5350, 80), "Bear FVG", group = grpC)
colBreakaway = input.color(color.new(#2196f3, 70), "Breakaway", group = grpC)
colMeasuring = input.color(color.new(#9c27b0, 75), "Measuring", group = grpC)
colTime      = input.color(color.new(#ffc107, 70), "Time-anchored", group = grpC)
colAnchor    = input.color(color.new(#ff9800, 55), "Fri/Mon anchor", group = grpC)
colBPR       = input.color(color.new(#7e57c2, 65), "BPR", group = grpC)
colIFVGBull  = input.color(color.new(#26a69a, 60), "Bull IFVG", group = grpC)
colIFVGBear  = input.color(color.new(#ef5350, 60), "Bear IFVG", group = grpC)

// ── Zone model ──
type Zone
    float top
    float bot
    int   startBar
    float ce          // consequent encroachment (gap midpoint)
    bool  isBull
    bool  isBreakaway = false
    bool  isMeasuring = false
    bool  isTime      = false  // FPFVG / midnight / hourly
    bool  isAnchor    = false  // Fri/Mon first presentation
    bool  hasOD       = false
    bool  oppC3       = false
    bool  mitigated   = false
    bool  inverted    = false
    bool  bprChecked  = false
    box   bx
    line  ceLn

var array<Zone> zones = array.new<Zone>()

// ── FVG detection (close-confirmed displacement, per house convention) ──
tickSize = syminfo.mintick
bool rawBull = low > high[2] and close > high[2]
bool rawBear = high < low[2] and close < low[2]
if minGapTicks > 0
    rawBull := rawBull and (low - high[2]) >= minGapTicks * tickSize
    rawBear := rawBear and (low[2] - high) >= minGapTicks * tickSize

// BOS detection via pivots (breakaway context)
float ph = ta.pivothigh(high, bosLen, bosLen)
float pl = ta.pivotlow(low, bosLen, bosLen)
var float lastSwingHigh = na
var float lastSwingLow  = na
var bool  bosUp   = false
var bool  bosDown = false
if not na(ph)
    lastSwingHigh := ph
    bosDown := false
if not na(pl)
    lastSwingLow := pl
    bosUp := false
// structure break: close beyond last swing
bosUp   := bosUp   or (not na(lastSwingHigh) and close > lastSwingHigh)
bosDown := bosDown or (not na(lastSwingLow)  and close < lastSwingLow)

// time-window flags for the *origin* of the gap (candle 2 of the 3) 
bool bullOriginInRTHOpen = inRTHOpen(nyHour[2], nyMinute[2])
bool bullStartNewHour    = nyHour[2] != nyHour[3]
bool bullOriginNearMid   = nyHour[2] == 0 and nyMinute[2] < 60
bool bearOriginInRTHOpen = inRTHOpen(nyHour[2], nyMinute[2])
bool bearStartNewHour    = nyHour[2] != nyHour[3]
bool bearOriginNearMid   = nyHour[2] == 0 and nyMinute[2] < 60

// ── Anchor store: Fri/Mon First Presentation carry-forward ──
type Anchor
    float top
    float bot
    float ce
    bool  isBull
    bool  active
    box   bx
var array<Anchor> anchors = array.new<Anchor>()

// remember first presented FVG on Friday and Monday (both sessions of those days)
if (nyDow == dayofweek.friday or nyDow == dayofweek.monday)
    if (rawBull or rawBear) and not newWeek
        bool have = false
        for a in anchors
            if dayofweek(time) == nyDow and math.abs(a.top - (rawBull ? low : low[2])) < tickSize * 2
                have := true
        if not have and anchors.size() < 12
            float aTop = rawBull ? low : low[2]
            float aBot = rawBull ? high[2] : high
            Anchor an = Anchor.new(aTop, aBot, (aTop + aBot) / 2, rawBull, true,
                 box.new(bar_index - 2, aTop, bar_index, aBot, bgcolor = na, border_color = na))
            array.push(anchors, an)
            box.set_bgcolor(an.bx, colAnchor)
            box.set_border_color(an.bx, colAnchor)

// ── OD (overlapping wick) detection helper ──
odCheck(float gTop, float gBot, bool isBull) =>
    // overlapping defense: candle 1 or candle 3 wick reaches back into the gap
    bool od = false
    if isBull
        od := high[2] > gBot and high[2] < gTop
    else
        od := low[2] < gTop and low[2] > gBot
    od

// opposite 3rd candle: candle 3 closes against displacement
bool bullOppC3 = rawBull and close[2] > close[1] // c1 bearish → c3 close above c1 close, weak-form check refined below
bool bearOppC3 = rawBear and close[2] < close[1]

// ── Create zones ──
addZone(bool isBull, float gTop, float gBot) =>
    bool isBreakaway = (isBull and bosUp and close[1] <= lastSwingHigh) or (not isBull and bosDown and close[1] >= lastSwingLow)
    bool isFirstHour  = bullStartNewHour or bearStartNewHour
    bool isTime = showFPFVG and inRTHOpen(nyHour[2], nyMinute[2])
    bool isMid  = (bullOriginNearMid or bearOriginNearMid)
    color zcol = isBull ? colBullFVG : colBearFVG
    if showBreakaway and isBreakaway
        zcol := colBreakaway
    if isTime or isMid or (showHourly1st and isFirstHour)
        zcol := colTime
    box bx = box.new(bar_index - 2, gTop, extendZones ? bar_index : bar_index, gBot,
         bgcolor = zcol, border_color = color.new(zcol, 40), extend = extendZones ? extend.right : extend.none)
    line cl = line.new(bar_index - 2, (gTop + gBot) / 2, bar_index, (gTop + gBot) / 2,
         color = color.new(color.purple, 30), style = line.style_dashed, extend = extendZones ? extend.right : extend.none)
    Zone z = Zone.new(gTop, gBot, bar_index - 2, (gTop + gBot) / 2, isBull,
         isBreakaway, false, isTime or isMid or (showHourly1st and isFirstHour), false,
         odCheck(gTop, gBot, isBull), isBull ? bullOppC3 : bearOppC3,
         false, false, false, bx, cl)
    if z.hasOD and showOD
        label.new(bar_index - 1, isBull ? gBot : gTop, "OD", style = label.style_label_left,
             color = color.new(color.blue, 60), textcolor = color.white, size = size.tiny)
    if z.oppC3 and showOppC3
        label.new(bar_index - 1, isBull ? gTop : gBot, "c3↓", style = label.style_label_left,
             color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)
    array.push(zones, z)
    if zones.size() > maxZones * 2
        Zone old = array.shift(zones)
        box.delete(old.bx)
        line.delete(old.ceLn)

if rawBull
    addZone(true, low, high[2])
if rawBear
    addZone(false, low[2], high)

// ── Mitigation / inversion / BPR over active zones ──
var float lastBullTop = na
var float lastBullBot = na
var float lastBearTop = na
var float lastBearBot = na

for i = zones.size() - 1 to 0
    if zones.size() == 0
        break
    Zone z = array.get(zones, i)
    if not z.mitigated
        bool touched = (z.isBull ? low <= z.ce and high >= z.bot : high >= z.ce and low <= z.top)
        bool closedThrough = (z.isBull ? close < z.bot : close > z.top)
        if closedThrough
            z.mitigated := true
            if showIFVG and z.isTime or showIFVG
                // IFVG: flip only if the gap was significant (time-anchored, breakaway, stacked or CE-tested)
                bool significant = z.isTime or z.isBreakaway or touched
                if significant
                    z.inverted := true
                    box.set_bgcolor(z.bx, z.isBull ? colIFVGBear : colIFVGBull)
                    box.set_extend(z.bx, extend.right)
            if extendZones
                box.set_extend(z.bx, extend.none)
                box.set_right(z.bx, bar_index)
                line.set_extend(z.ceLn, extend.none)
                line.set_x2(z.ceLn, bar_index)
        else if touched
            box.set_extend(z.bx, extend.none)
            box.set_right(z.bx, bar_index)
            line.set_extend(z.ceLn, extend.none)
            line.set_x2(z.ceLn, bar_index)
    // Measuring-gap classification: unfilled gap whose CE sits ~midway between origin swing and last swing
    if showMeasuring and not z.mitigated and not z.isMeasuring
        if not na(lastSwingHigh) and not na(lastSwingLow) and lastSwingHigh > lastSwingLow
            float mid = (lastSwingHigh + lastSwingLow) / 2
            if math.abs(z.ce - mid) <= (lastSwingHigh - lastSwingLow) * 0.15
                z.isMeasuring := true
                box.set_bgcolor(z.bx, colMeasuring)
    // BPR: overlap with last opposing FVG
    if showBPR and not z.bprChecked
        z.bprChecked := true
        if z.isBull and not na(lastBearTop)
            float oTop = math.min(z.top, lastBearTop)
            float oBot = math.max(z.bot, lastBearBot)
            if oTop > oBot
                box.new(bar_index - 2, oTop, bar_index + 10, oBot, bgcolor = colBPR,
                     border_color = color.new(colBPR, 30), extend = extend.right)
        if not z.isBull and not na(lastBullTop)
            float oTop = math.min(z.top, lastBullTop)
            float oBot = math.max(z.bot, lastBullBot)
            if oTop > oBot
                box.new(bar_index - 2, oTop, bar_index + 10, oBot, bgcolor = colBPR,
                     border_color = color.new(colBPR, 30), extend = extend.right)
    if z.isBull
        lastBullTop := z.top
        lastBullBot := z.bot
    else
        lastBearTop := z.top
        lastBearBot := z.bot

// ── MTF stacking: LTF zone inside HTF FVG ──
htfFVG() =>
    bool hBull = low > high[2] and close > high[2]
    bool hBear = high < low[2] and close < low[2]
    float hTop = hBull ? low : hBear ? low[2] : na
    float hBot = hBull ? high[2] : hBear ? high : na
    [hBull or hBear, hTop, hBot]
[htfHas, htfTop, htfBot] = request.security(syminfo.tickerid, htfTF, htfFVG(), lookahead = barmerge.lookahead_on)
if showStack and htfHas and zones.size() > 0
    for i = zones.size() - 1 to math.max(0, zones.size() - 4)
        Zone z = array.get(zones, i)
        if not na(htfTop) and z.top <= htfTop and z.bot >= htfBot
            label.new(bar_index, z.top, "⧉HTF", style = label.style_none, textcolor = color.new(colTime, 0), size = size.tiny)

// ── Fri/Mon anchor reaction markers: price returns into anchor CE ──
if showFriMon
    for a in anchors
        if a.active and low <= a.ce and high >= a.ce
            label.new(bar_index, a.ce, "⟲", style = label.style_label_up,
                 color = color.new(colAnchor, 20), textcolor = color.white, size = size.tiny)