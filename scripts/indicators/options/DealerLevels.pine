//
// DealerLevels.pine
// =================
// Draws institutional dealer-positioning levels (Call Wall, Put Wall, Zero Gamma,
// Expected Move) on the chart.  Levels are entered manually from the JSON output
// of the Dealer Levels Python pipeline (daily_levels.json).
//
// Usage
// ─────
//  1. Run the Python pipeline to generate data/daily_levels.json.
//  2. Open this indicator's settings and paste each level value into the
//     corresponding input field (ES or NQ group, depending on your chart).
//  3. Lines are drawn from the first bar of the current trading session and
//     extend to the right on every subsequent bar within that session.
//
// Lines are cleared and redrawn automatically at the start of each new day.
// Set any level to 0 to hide it.

//@version=6
indicator(
    title       = "Dealer Levels — GEX",
    overlay     = true,
    max_lines_count  = 200,
    max_labels_count = 100,
    max_bars_back    = 5000
)

// ═══════════════════════════════════════════════════════════════════════════════
// ── ES LEVELS ──────────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
var string grp_es = "ES Levels  (E-mini S&P 500)"

es_show       = input.bool  (true,      "Show ES Levels",   group = grp_es)
es_regime     = input.string("POSITIVE","Regime",
    options = ["POSITIVE", "NEGATIVE"],
    tooltip = "Set to match the GEX regime from the pipeline output",
    group   = grp_es)
es_callwall   = input.float (0.0, "Call Wall",   step = 0.25, group = grp_es)
es_putwall    = input.float (0.0, "Put Wall",    step = 0.25, group = grp_es)
es_zerogamma  = input.float (0.0, "Zero Gamma",  step = 0.25, group = grp_es)
es_em_upper   = input.float (0.0, "EM Upper",    step = 0.25, group = grp_es)
es_em_lower   = input.float (0.0, "EM Lower",    step = 0.25, group = grp_es)

// ═══════════════════════════════════════════════════════════════════════════════
// ── NQ LEVELS ──────────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
var string grp_nq = "NQ Levels  (E-mini Nasdaq-100)"

nq_show       = input.bool  (true,      "Show NQ Levels",   group = grp_nq)
nq_regime     = input.string("POSITIVE","Regime",
    options = ["POSITIVE", "NEGATIVE"],
    tooltip = "Set to match the GEX regime from the pipeline output",
    group   = grp_nq)
nq_callwall   = input.float (0.0, "Call Wall",   step = 1.0,  group = grp_nq)
nq_putwall    = input.float (0.0, "Put Wall",    step = 1.0,  group = grp_nq)
nq_zerogamma  = input.float (0.0, "Zero Gamma",  step = 1.0,  group = grp_nq)
nq_em_upper   = input.float (0.0, "EM Upper",    step = 1.0,  group = grp_nq)
nq_em_lower   = input.float (0.0, "EM Lower",    step = 1.0,  group = grp_nq)

// ═══════════════════════════════════════════════════════════════════════════════
// ── LINE STYLE ─────────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
var string grp_style = "Line Style"

c_call_wall  = input.color(color.new(#00E676, 0),   "Call Wall Colour",   group = grp_style)
c_put_wall   = input.color(color.new(#FF1744, 0),   "Put Wall Colour",    group = grp_style)
c_zero_gamma = input.color(color.new(#FFEA00, 0),   "Zero Gamma Colour",  group = grp_style)
c_em_band    = input.color(color.new(#00B8D4, 60),  "EM Band Colour",     group = grp_style)

line_width_cw = input.int(2, "Call/Put Wall Width", minval = 1, maxval = 4, group = grp_style)
line_width_zg = input.int(1, "Zero Gamma Width",    minval = 1, maxval = 4, group = grp_style)
line_width_em = input.int(1, "EM Band Width",       minval = 1, maxval = 4, group = grp_style)

es_line_style_inp = input.string("Solid",  "ES Line Style",
    options = ["Solid", "Dashed", "Dotted"], group = grp_style)
nq_line_style_inp = input.string("Dashed", "NQ Line Style",
    options = ["Solid", "Dashed", "Dotted"], group = grp_style)

// ═══════════════════════════════════════════════════════════════════════════════
// ── LABELS ─────────────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
var string grp_lbl = "Labels"

show_labels    = input.bool  (true,    "Show Labels",     group = grp_lbl)
show_price_lbl = input.bool  (true,    "Show Price in Label", group = grp_lbl)
lbl_size_inp   = input.string("small", "Label Size",
    options = ["tiny", "small", "normal", "large"], group = grp_lbl)
lbl_offset_inp = input.int(5, "Label Offset (bars right)", minval = 0, maxval = 50, group = grp_lbl)

// ═══════════════════════════════════════════════════════════════════════════════
// ── EM FILL ────────────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
var string grp_fill = "Expected-Move Fill"

show_es_fill = input.bool(true,  "Fill ES EM Band", group = grp_fill)
show_nq_fill = input.bool(false, "Fill NQ EM Band", group = grp_fill)

// ═══════════════════════════════════════════════════════════════════════════════
// ── HELPERS ────────────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

f_size(s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        =>          size.small

f_style(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        =>          line.style_solid

_lbl_size   = f_size(lbl_size_inp)
_es_style   = f_style(es_line_style_inp)
_nq_style   = f_style(nq_line_style_inp)

f_price_str(p) =>
    show_price_lbl ? "  " + str.tostring(p, "#.##") : ""

// ═══════════════════════════════════════════════════════════════════════════════
// ── SESSION TRACKING ───────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

// Detect the first bar of a new calendar day
is_new_day = ta.change(time("D")) != 0

var int session_start_bar = 0
if is_new_day or bar_index == 0
    session_start_bar := bar_index

// ═══════════════════════════════════════════════════════════════════════════════
// ── LINE & LABEL VARIABLES ─────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// One line + label variable per (asset × level-type).
// Lines are recreated each new day; labels track the right edge.

var line ln_es_cw   = na
var line ln_es_pw   = na
var line ln_es_zg   = na
var line ln_es_emu  = na
var line ln_es_eml  = na

var line ln_nq_cw   = na
var line ln_nq_pw   = na
var line ln_nq_zg   = na
var line ln_nq_emu  = na
var line ln_nq_eml  = na

var label lbl_es_cw  = na
var label lbl_es_pw  = na
var label lbl_es_zg  = na
var label lbl_es_emu = na
var label lbl_es_eml = na

var label lbl_nq_cw  = na
var label lbl_nq_pw  = na
var label lbl_nq_zg  = na
var label lbl_nq_emu = na
var label lbl_nq_eml = na

// EM fill lines (need a plot-based linefill; use line pairs)
var line ln_es_emu_fill = na
var line ln_es_eml_fill = na
var line ln_nq_emu_fill = na
var line ln_nq_eml_fill = na

var linefill lf_es_em = na
var linefill lf_nq_em = na

// ═══════════════════════════════════════════════════════════════════════════════
// ── DAY-START: DELETE OLD + CREATE NEW LINES ───────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

f_make_line(price, col, w, style) =>
    price != 0.0 ?
        line.new(bar_index, price, bar_index + 1, price,
            color = col, width = w, style = style, extend = extend.none) :
        na

f_make_label(price, txt, col, style_lbl) =>
    price != 0.0 and show_labels ?
        label.new(bar_index + lbl_offset_inp, price, txt,
            style     = style_lbl,
            color     = color.new(col, 80),
            textcolor = col,
            size      = _lbl_size) :
        na

if is_new_day or bar_index == 0

    // ── Teardown ─────────────────────────────────────────────────────────────
    line.delete(ln_es_cw)  ; line.delete(ln_es_pw)   ; line.delete(ln_es_zg)
    line.delete(ln_es_emu) ; line.delete(ln_es_eml)
    line.delete(ln_nq_cw)  ; line.delete(ln_nq_pw)   ; line.delete(ln_nq_zg)
    line.delete(ln_nq_emu) ; line.delete(ln_nq_eml)
    line.delete(ln_es_emu_fill) ; line.delete(ln_es_eml_fill)
    line.delete(ln_nq_emu_fill) ; line.delete(ln_nq_eml_fill)

    label.delete(lbl_es_cw)  ; label.delete(lbl_es_pw)   ; label.delete(lbl_es_zg)
    label.delete(lbl_es_emu) ; label.delete(lbl_es_eml)
    label.delete(lbl_nq_cw)  ; label.delete(lbl_nq_pw)   ; label.delete(lbl_nq_zg)
    label.delete(lbl_nq_emu) ; label.delete(lbl_nq_eml)

    linefill.delete(lf_es_em)
    linefill.delete(lf_nq_em)

    // ── ES Lines ─────────────────────────────────────────────────────────────
    if es_show
        es_regime_suffix = es_regime == "POSITIVE" ? " ✅" : " ⚠️"

        ln_es_cw  := f_make_line(es_callwall,  c_call_wall,  line_width_cw, _es_style)
        ln_es_pw  := f_make_line(es_putwall,   c_put_wall,   line_width_cw, _es_style)
        ln_es_zg  := f_make_line(es_zerogamma, c_zero_gamma, line_width_zg, _es_style)
        ln_es_emu := f_make_line(es_em_upper,  c_em_band,    line_width_em, _es_style)
        ln_es_eml := f_make_line(es_em_lower,  c_em_band,    line_width_em, _es_style)

        lbl_es_cw  := f_make_label(es_callwall,  "ES Call Wall"  + f_price_str(es_callwall)  + es_regime_suffix, c_call_wall,  label.style_label_left)
        lbl_es_pw  := f_make_label(es_putwall,   "ES Put Wall"   + f_price_str(es_putwall)   + es_regime_suffix, c_put_wall,   label.style_label_left)
        lbl_es_zg  := f_make_label(es_zerogamma, "ES Zero Gamma" + f_price_str(es_zerogamma) + es_regime_suffix, c_zero_gamma, label.style_label_left)
        lbl_es_emu := f_make_label(es_em_upper,  "ES EM+"        + f_price_str(es_em_upper),                     c_em_band,    label.style_label_left)
        lbl_es_eml := f_make_label(es_em_lower,  "ES EM-"        + f_price_str(es_em_lower),                     c_em_band,    label.style_label_left)

        // EM band fill — requires two non-na lines
        if show_es_fill and es_em_upper != 0.0 and es_em_lower != 0.0
            ln_es_emu_fill := line.new(bar_index, es_em_upper, bar_index + 1, es_em_upper, color = color.new(c_em_band, 95), width = 1)
            ln_es_eml_fill := line.new(bar_index, es_em_lower, bar_index + 1, es_em_lower, color = color.new(c_em_band, 95), width = 1)
            lf_es_em       := linefill.new(ln_es_emu_fill, ln_es_eml_fill, color.new(c_em_band, 85))

    // ── NQ Lines ─────────────────────────────────────────────────────────────
    if nq_show
        nq_regime_suffix = nq_regime == "POSITIVE" ? " ✅" : " ⚠️"

        ln_nq_cw  := f_make_line(nq_callwall,  c_call_wall,  line_width_cw, _nq_style)
        ln_nq_pw  := f_make_line(nq_putwall,   c_put_wall,   line_width_cw, _nq_style)
        ln_nq_zg  := f_make_line(nq_zerogamma, c_zero_gamma, line_width_zg, _nq_style)
        ln_nq_emu := f_make_line(nq_em_upper,  c_em_band,    line_width_em, _nq_style)
        ln_nq_eml := f_make_line(nq_em_lower,  c_em_band,    line_width_em, _nq_style)

        lbl_nq_cw  := f_make_label(nq_callwall,  "NQ Call Wall"  + f_price_str(nq_callwall)  + nq_regime_suffix, c_call_wall,  label.style_label_left)
        lbl_nq_pw  := f_make_label(nq_putwall,   "NQ Put Wall"   + f_price_str(nq_putwall)   + nq_regime_suffix, c_put_wall,   label.style_label_left)
        lbl_nq_zg  := f_make_label(nq_zerogamma, "NQ Zero Gamma" + f_price_str(nq_zerogamma) + nq_regime_suffix, c_zero_gamma, label.style_label_left)
        lbl_nq_emu := f_make_label(nq_em_upper,  "NQ EM+"        + f_price_str(nq_em_upper),                     c_em_band,    label.style_label_left)
        lbl_nq_eml := f_make_label(nq_em_lower,  "NQ EM-"        + f_price_str(nq_em_lower),                     c_em_band,    label.style_label_left)

        if show_nq_fill and nq_em_upper != 0.0 and nq_em_lower != 0.0
            ln_nq_emu_fill := line.new(bar_index, nq_em_upper, bar_index + 1, nq_em_upper, color = color.new(c_em_band, 95), width = 1)
            ln_nq_eml_fill := line.new(bar_index, nq_em_lower, bar_index + 1, nq_em_lower, color = color.new(c_em_band, 95), width = 1)
            lf_nq_em       := linefill.new(ln_nq_emu_fill, ln_nq_eml_fill, color.new(c_em_band, 85))

// ═══════════════════════════════════════════════════════════════════════════════
// ── INTRA-DAY: EXTEND ALL LINES TO CURRENT BAR ─────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

if not is_new_day
    // ES
    if not na(ln_es_cw)   line.set_x2(ln_es_cw,   bar_index)
    if not na(ln_es_pw)   line.set_x2(ln_es_pw,   bar_index)
    if not na(ln_es_zg)   line.set_x2(ln_es_zg,   bar_index)
    if not na(ln_es_emu)  line.set_x2(ln_es_emu,  bar_index)
    if not na(ln_es_eml)  line.set_x2(ln_es_eml,  bar_index)
    if not na(ln_es_emu_fill) line.set_x2(ln_es_emu_fill, bar_index)
    if not na(ln_es_eml_fill) line.set_x2(ln_es_eml_fill, bar_index)

    // NQ
    if not na(ln_nq_cw)   line.set_x2(ln_nq_cw,   bar_index)
    if not na(ln_nq_pw)   line.set_x2(ln_nq_pw,   bar_index)
    if not na(ln_nq_zg)   line.set_x2(ln_nq_zg,   bar_index)
    if not na(ln_nq_emu)  line.set_x2(ln_nq_emu,  bar_index)
    if not na(ln_nq_eml)  line.set_x2(ln_nq_eml,  bar_index)
    if not na(ln_nq_emu_fill) line.set_x2(ln_nq_emu_fill, bar_index)
    if not na(ln_nq_eml_fill) line.set_x2(ln_nq_eml_fill, bar_index)

    // Labels — keep anchored to current right edge of session
    if show_labels
        int lbl_x = bar_index + lbl_offset_inp
        if not na(lbl_es_cw)  label.set_x(lbl_es_cw,  lbl_x)
        if not na(lbl_es_pw)  label.set_x(lbl_es_pw,  lbl_x)
        if not na(lbl_es_zg)  label.set_x(lbl_es_zg,  lbl_x)
        if not na(lbl_es_emu) label.set_x(lbl_es_emu, lbl_x)
        if not na(lbl_es_eml) label.set_x(lbl_es_eml, lbl_x)
        if not na(lbl_nq_cw)  label.set_x(lbl_nq_cw,  lbl_x)
        if not na(lbl_nq_pw)  label.set_x(lbl_nq_pw,  lbl_x)
        if not na(lbl_nq_zg)  label.set_x(lbl_nq_zg,  lbl_x)
        if not na(lbl_nq_emu) label.set_x(lbl_nq_emu, lbl_x)
        if not na(lbl_nq_eml) label.set_x(lbl_nq_eml, lbl_x)
