// DealerLevels.pine
// =================
// Paste formatted dealer-level lines from data/daily_levels.txt into the text box.
// The indicator auto-detects the current chart symbol and draws the matching line.
//
// Supported workflow:
// 1. Run the Python dealer-level pipeline.
// 2. Copy one or more formatted lines, for example:
//    ES: 6715.91:Upper EM, 6713.21:Absolute Call Wall, ...
//    NQ: 24695.66:Upper EM, 24652.13:Absolute Call Wall, ...
// 3. Paste them into the input text area below.
// 4. The indicator selects the line matching the current chart symbol.
//
// Symbol matching:
// - Exact ticker match when pasted data exists for that ticker.
// - Canonical family matching for common micro/mini futures pairs.
//
// Session handling:
// - Overnight futures families reset on the trading-day boundary (18:00 ET).
// - Other symbols reset on the calendar-day boundary.

//@version=6
indicator("Dealer Levels Auto", overlay = true, max_lines_count = 200, max_labels_count = 200, max_bars_back = 5000)

var string grp_data = "Dealer Levels"
pastedData = input.text_area(
    "",
    "Paste Dealer Levels",
    group = grp_data,
    tooltip = "Paste one or more formatted lines from daily_levels.txt. Example:\nES: 6715.91:Upper EM, 6713.21:Absolute Call Wall, ...\nNQ: 24695.66:Upper EM, 24652.13:Absolute Call Wall, ..."
)
familySourcePreference = input.string(
    "Auto",
    "Family Source Preference",
    options = ["Auto", "Prefer Index", "Prefer ETF"],
    group = grp_data,
    tooltip = "For family matches (ES/SPX/SPY, NQ/NDX/QQQ, YM/DJX/DIA, RTY/RUT/IWM), prefer index or ETF lines."
)
overrideExactWithFamilyPreference = input.bool(
    false,
    "Override Exact Match With Family Preference",
    group = grp_data,
    tooltip = "When enabled, preferred family source can beat an exact line. Useful to compare SPY-vs-SPX style levels on ES family charts."
)

var string grp_lines = "Line Style"
showEmFill = input.bool(true, "Show EM Fill", group = grp_lines)
lineWidthPrimary = input.int(2, "Primary Width", minval = 1, maxval = 4, group = grp_lines)
lineWidthSecondary = input.int(1, "Secondary Width", minval = 1, maxval = 4, group = grp_lines)
lineStylePrimaryInp = input.string("Solid", "Primary Style", options = ["Solid", "Dashed", "Dotted"], group = grp_lines)
lineStyleSecondaryInp = input.string("Dashed", "Secondary Style", options = ["Solid", "Dashed", "Dotted"], group = grp_lines)
lineStyle0DTEInp = input.string("Dotted", "0DTE Style", options = ["Solid", "Dashed", "Dotted"], group = grp_lines)

var string grp_colors = "Colors"
colUpperEM = input.color(color.new(color.aqua, 0), "Upper EM", group = grp_colors)
colAbsCall = input.color(color.new(color.lime, 0), "Absolute Call Wall", group = grp_colors)
colLocalCall = input.color(color.new(color.lime, 30), "Local Call Node", group = grp_colors)
col0DTECall = input.color(color.new(color.lime, 60), "0DTE Call Wall", group = grp_colors)
colDexCall = input.color(color.new(color.lime, 15), "DEX Call Node", group = grp_colors)
colGammaCliffUp = input.color(color.new(color.teal, 20), "Gamma Cliff Up", group = grp_colors)
colZeroGamma = input.color(color.new(color.yellow, 0), "Zero Gamma", group = grp_colors)
colGammaFlip = input.color(color.new(color.yellow, 45), "Gamma Flip Zone", group = grp_colors)
colGammaCliffDown = input.color(color.new(color.teal, 20), "Gamma Cliff Down", group = grp_colors)
colMaxPain = input.color(color.new(color.orange, 0), "Max Pain", group = grp_colors)
col0DTEPut = input.color(color.new(color.red, 60), "0DTE Put Wall", group = grp_colors)
colLocalPut = input.color(color.new(color.red, 30), "Local Put Node", group = grp_colors)
colDexPut = input.color(color.new(color.red, 15), "DEX Put Node", group = grp_colors)
colHedge = input.color(color.new(color.red, 0), "Hedge Wall", group = grp_colors)
colLowerEM = input.color(color.new(color.aqua, 0), "Lower EM", group = grp_colors)
colFallback = input.color(color.new(color.white, 0), "Fallback", group = grp_colors)
colEmFill = input.color(color.new(color.aqua, 88), "EM Fill", group = grp_colors)
colGammaFlipFill = input.color(color.new(color.yellow, 88), "Gamma Flip Fill", group = grp_colors)

var string grp_labels = "Labels"
showLabels = input.bool(true, "Show Labels", group = grp_labels)
showPriceInLabel = input.bool(true, "Show Price In Label", group = grp_labels)
compactLabels = input.bool(true, "Compact Label Text", group = grp_labels)
mergeSamePriceLabels = input.bool(true, "Merge Same-Price Labels", group = grp_labels)
labelSizeInp = input.string("tiny", "Label Size", options = ["tiny", "small", "normal", "large"], group = grp_labels)
labelOffset = input.int(2, "Label Offset", minval = 0, maxval = 50, group = grp_labels)
labelBgOpacity = input.int(85, "Label Background Opacity", minval = 0, maxval = 100, group = grp_labels)
labelCollisionMode = input.string("Stagger", "Label Collision", options = ["Stagger", "Hide" , "Off"], group = grp_labels)
maxLabelColumns = input.int(4, "Max Label Columns", minval = 1, maxval = 10, group = grp_labels)
columnStepBars = input.int(2, "Column Step (bars)", minval = 1, maxval = 20, group = grp_labels)
minLabelGapTicks = input.int(40, "Min Gap (ticks)", minval = 1, maxval = 500, group = grp_labels)
showStatusTable = input.bool(true, "Show Status Table", group = grp_labels)
showNarrativeTable = input.bool(true, "Show Narrative Table", group = grp_labels)

var string grp_visibility = "Level Visibility"
showEMLevels = input.bool(true, "Show EM Levels", group = grp_visibility)
showCallLevels = input.bool(true, "Show Call Levels", group = grp_visibility)
showPutLevels = input.bool(true, "Show Put Levels", group = grp_visibility)
showZeroGammaLevel = input.bool(true, "Show Zero Gamma", group = grp_visibility)
showGammaFlipLevels = input.bool(true, "Show Gamma Flip Zone", group = grp_visibility)
showGammaCliffLevels = input.bool(true, "Show Gamma Cliffs", group = grp_visibility)
showMaxPainLevel = input.bool(true, "Show Max Pain", group = grp_visibility)
showHedgeLevel = input.bool(true, "Show Hedge Wall", group = grp_visibility)
showDexLevels = input.bool(true, "Show DEX Nodes", group = grp_visibility)

f_label_size(string sizeText) =>
    sizeText == "tiny" ? size.tiny :
     sizeText == "small" ? size.small :
     sizeText == "normal" ? size.normal :
     size.large

f_line_style(string styleText) =>
    styleText == "Solid" ? line.style_solid :
     styleText == "Dashed" ? line.style_dashed :
     line.style_dotted

f_norm(string value) =>
    str.upper(str.trim(value))

f_strip_prefix(string value) =>
    trimmed = f_norm(value)
    str.startswith(trimmed, "/") ? str.substring(trimmed, 1, str.length(trimmed)) : trimmed

f_strip_continuous_suffix(string value) =>
    cleaned = f_strip_prefix(value)
    len = str.length(cleaned)
    len > 2 and str.endswith(cleaned, "!") ? str.substring(cleaned, 0, len - 2) : cleaned

f_primary_symbol() =>
    root = f_strip_prefix(syminfo.root)
    ticker = f_strip_prefix(syminfo.ticker)
    str.length(root) > 0 ? root : ticker

f_canonical_symbol(string symbol) =>
    cleaned = f_strip_continuous_suffix(symbol)
    cleaned == "MES" ? "ES" :
     cleaned == "MNQ" ? "NQ" :
     cleaned == "MYM" ? "YM" :
     cleaned == "M2K" ? "RTY" :
     cleaned == "MGC" ? "GC" :
     cleaned == "SIL" ? "SI" :
     cleaned == "MCL" ? "CL" :
     cleaned == "MHG" ? "HG" :
     cleaned == "M6E" ? "6E" :
     cleaned == "M6A" ? "6A" :
     cleaned == "M6B" ? "6B" :
     cleaned == "M6J" ? "6J" :
     cleaned

f_symbol_family_key(string symbol) =>
    canonical = f_canonical_symbol(symbol)
    result = canonical
    if canonical == "ES" or canonical == "SPX" or canonical == "SPY"
        result := "ES_FAMILY"
    else if canonical == "NQ" or canonical == "NDX" or canonical == "QQQ"
        result := "NQ_FAMILY"
    else if canonical == "YM" or canonical == "DJX" or canonical == "DJI" or canonical == "US30" or canonical == "DOW" or canonical == "DIA"
        result := "YM_FAMILY"
    else if canonical == "RTY" or canonical == "RUT" or canonical == "IWM"
        result := "RTY_FAMILY"
    result

f_source_kind(string symbol) =>
    canonical = f_canonical_symbol(symbol)
    kind = "OTHER"
    if canonical == "SPX" or canonical == "NDX" or canonical == "DJX" or canonical == "DJI" or canonical == "RUT"
        kind := "INDEX"
    else if canonical == "SPY" or canonical == "QQQ" or canonical == "DIA" or canonical == "IWM"
        kind := "ETF"
    kind

f_is_overnight_futures(string symbol) =>
    canonical = f_canonical_symbol(symbol)
    canonical == "ES" or canonical == "NQ" or canonical == "YM" or canonical == "RTY" or canonical == "CL" or canonical == "GC" or canonical == "SI" or canonical == "HG" or canonical == "6E" or canonical == "6A" or canonical == "6B" or canonical == "6J" or canonical == "ZN" or canonical == "ZB"

f_match_score(string assetTag) =>
    asset = f_canonical_symbol(assetTag)
    assetFamily = f_symbol_family_key(asset)
    primary = f_canonical_symbol(f_primary_symbol())
    primaryFamily = f_symbol_family_key(primary)
    ticker = f_canonical_symbol(syminfo.ticker)
    tickerFamily = f_symbol_family_key(ticker)
    root = f_canonical_symbol(syminfo.root)
    rootFamily = f_symbol_family_key(root)

    exactMatch = asset == ticker or asset == root or asset == primary
    familyMatch = assetFamily == tickerFamily or assetFamily == rootFamily or assetFamily == primaryFamily

    exactBase = overrideExactWithFamilyPreference and familySourcePreference != "Auto" ? 120 : 200
    familyBase = familyMatch ? 100 : 0

    prefBoost = 0
    if familyMatch and familySourcePreference != "Auto"
        kind = f_source_kind(asset)
        if familySourcePreference == "Prefer ETF" and kind == "ETF"
            prefBoost := 30
        else if familySourcePreference == "Prefer Index" and kind == "INDEX"
            prefBoost := 30

    exactMatch ? exactBase : (familyBase + prefBoost)

f_symbol_matches(string assetTag) =>
    f_match_score(assetTag) > 0

f_extract_asset_tag(string lineText) =>
    tokens = str.split(lineText, ",")
    asset = ""
    if array.size(tokens) > 0
        firstToken = str.trim(array.get(tokens, 0))
        firstParts = str.split(firstToken, ":")
        if array.size(firstParts) >= 3
            asset := f_strip_prefix(array.get(firstParts, 0))
    asset

f_find_matching_line(string blob) =>
    string matchedLine = ""
    string matchedAsset = ""
    int bestScore = 0
    rows = str.split(blob, "\n")
    if array.size(rows) > 0
        for idx = 0 to array.size(rows) - 1
            row = str.trim(array.get(rows, idx))
            if str.length(row) > 0 and str.contains(row, ",")
                asset = f_extract_asset_tag(row)
                score = f_match_score(asset)
                if str.length(asset) > 0 and score > bestScore
                    matchedLine := row
                    matchedAsset := asset
                    bestScore := score
    [matchedLine, matchedAsset]

f_family_futures_anchor(string familyKey) =>
    familyKey == "ES_FAMILY" ? "ES" :
     familyKey == "NQ_FAMILY" ? "NQ" :
     familyKey == "YM_FAMILY" ? "YM" :
     familyKey == "RTY_FAMILY" ? "RTY" :
     ""

f_find_asset_line(string blob, string targetAsset) =>
    string matchedLine = ""
    target = f_canonical_symbol(targetAsset)
    rows = str.split(blob, "\n")
    if array.size(rows) > 0
        for idx = 0 to array.size(rows) - 1
            row = str.trim(array.get(rows, idx))
            if str.length(row) > 0 and str.contains(row, ",")
                asset = f_extract_asset_tag(row)
                if f_canonical_symbol(asset) == target
                    matchedLine := row
                    break
    matchedLine

f_parse_levels(string lineText, array<float> prices, array<string> titles) =>
    array.clear(prices)
    array.clear(titles)
    tokens = str.split(lineText, ",")
    if array.size(tokens) > 0
        for idx = 0 to array.size(tokens) - 1
            token = str.trim(array.get(tokens, idx))
            parts = str.split(token, ":")
            string priceText = ""
            string titleText = ""
            if idx == 0
                if array.size(parts) >= 3
                    priceText := str.trim(array.get(parts, 1))
                    titleText := str.trim(array.get(parts, 2))
            else
                if array.size(parts) >= 2
                    priceText := str.trim(array.get(parts, 0))
                    titleText := str.trim(array.get(parts, 1))
            level = str.tonumber(priceText)
            if not na(level) and str.length(titleText) > 0
                array.push(prices, level)
                array.push(titles, titleText)

f_level_color(string title) =>
    upperTitle = f_norm(title)
    upperTitle == "UPPER EM" ? colUpperEM :
     upperTitle == "LOWER EM" ? colLowerEM :
     upperTitle == "ZERO GAMMA" ? colZeroGamma :
     upperTitle == "GAMMA FLIP UPPER" or upperTitle == "GAMMA FLIP LOWER" ? colGammaFlip :
     upperTitle == "GAMMA CLIFF UP" ? colGammaCliffUp :
     upperTitle == "GAMMA CLIFF DOWN" ? colGammaCliffDown :
     upperTitle == "MAX PAIN" ? colMaxPain :
     upperTitle == "HEDGE WALL" ? colHedge :
     upperTitle == "0DTE PUT WALL" ? col0DTEPut :
     upperTitle == "LOCAL PUT NODE" ? colLocalPut :
     upperTitle == "DEX PUT NODE" ? colDexPut :
     upperTitle == "0DTE CALL WALL" ? col0DTECall :
     upperTitle == "LOCAL CALL NODE" ? colLocalCall :
     upperTitle == "DEX CALL NODE" ? colDexCall :
     upperTitle == "ABSOLUTE CALL WALL" ? colAbsCall :
     colFallback

f_level_style(string title) =>
    upperTitle = f_norm(title)
    str.contains(upperTitle, "GAMMA FLIP") ? line.style_dashed :
     str.contains(upperTitle, "GAMMA CLIFF") ? line.style_dotted :
     str.contains(upperTitle, "DEX") ? line.style_dashed :
     str.contains(upperTitle, "0DTE") ? f_line_style(lineStyle0DTEInp) :
     str.contains(upperTitle, "LOCAL") ? f_line_style(lineStyleSecondaryInp) :
     f_line_style(lineStylePrimaryInp)

f_level_width(string title) =>
    upperTitle = f_norm(title)
    str.contains(upperTitle, "0DTE") or str.contains(upperTitle, "LOCAL") or str.contains(upperTitle, "GAMMA FLIP") or str.contains(upperTitle, "GAMMA CLIFF") or str.contains(upperTitle, "DEX") ? lineWidthSecondary : lineWidthPrimary

f_compact_title(string title) =>
    upperTitle = f_norm(title)
    upperTitle == "UPPER EM" ? "EM+" :
     upperTitle == "LOWER EM" ? "EM-" :
     upperTitle == "ABSOLUTE CALL WALL" ? "CALL ABS" :
     upperTitle == "LOCAL CALL NODE" ? "CALL LOC" :
     upperTitle == "0DTE CALL WALL" ? "CALL 0DTE" :
     upperTitle == "DEX CALL NODE" ? "DEX C" :
     upperTitle == "GAMMA FLIP UPPER" ? "GF U" :
     upperTitle == "GAMMA CLIFF UP" ? "GC U" :
     upperTitle == "ZERO GAMMA" ? "ZG" :
     upperTitle == "GAMMA CLIFF DOWN" ? "GC D" :
     upperTitle == "GAMMA FLIP LOWER" ? "GF L" :
     upperTitle == "MAX PAIN" ? "MAX" :
     upperTitle == "0DTE PUT WALL" ? "PUT 0DTE" :
     upperTitle == "LOCAL PUT NODE" ? "PUT LOC" :
     upperTitle == "DEX PUT NODE" ? "DEX P" :
     upperTitle == "HEDGE WALL" ? "HEDGE" :
     title

f_show_level(string title) =>
    upperTitle = f_norm(title)
    upperTitle == "UPPER EM" or upperTitle == "LOWER EM" ? showEMLevels :
     str.contains(upperTitle, "DEX CALL") ? showDexLevels :
     str.contains(upperTitle, "DEX PUT") ? showDexLevels :
     str.contains(upperTitle, "CALL") ? showCallLevels :
     str.contains(upperTitle, "PUT") ? showPutLevels :
     upperTitle == "ZERO GAMMA" ? showZeroGammaLevel :
     str.contains(upperTitle, "GAMMA FLIP") ? showGammaFlipLevels :
     str.contains(upperTitle, "GAMMA CLIFF") ? showGammaCliffLevels :
     upperTitle == "MAX PAIN" ? showMaxPainLevel :
     upperTitle == "HEDGE WALL" ? showHedgeLevel :
     true

f_num(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.##")

// f_pick: return first non-na value (static priority fallback).
f_pick(float v1, float v2, float v3) =>
    not na(v1) ? v1 : (not na(v2) ? v2 : v3)

// f_nearest_below: return the highest value strictly below reference.
// Falls back to f_pick priority if nothing qualifies.
f_nearest_below(float reference, float v1, float v2, float v3) =>
    float best = na
    if not na(reference)
        if not na(v1) and v1 < reference
            if na(best) or v1 > best
                best := v1
        if not na(v2) and v2 < reference
            if na(best) or v2 > best
                best := v2
        if not na(v3) and v3 < reference
            if na(best) or v3 > best
                best := v3
    na(best) ? f_pick(v1, v2, v3) : best

// f_nearest_above: return the lowest value strictly above reference.
// Falls back to f_pick priority if nothing qualifies.
f_nearest_above(float reference, float v1, float v2, float v3) =>
    float best = na
    if not na(reference)
        if not na(v1) and v1 > reference
            if na(best) or v1 < best
                best := v1
        if not na(v2) and v2 > reference
            if na(best) or v2 < best
                best := v2
        if not na(v3) and v3 > reference
            if na(best) or v3 < best
                best := v3
    na(best) ? f_pick(v1, v2, v3) : best

f_label_text(string title, float level) =>
    titleText = compactLabels ? f_compact_title(title) : title
    showPriceInLabel ? titleText + "  " + str.tostring(level, "#.##") : titleText

f_is_same_price(float left, float right) =>
    math.abs(left - right) <= syminfo.mintick * 0.25

f_has_merged_token(string mergedTitle, string token) =>
    bool found = false
    tokens = str.split(mergedTitle, "+")
    if array.size(tokens) > 0
        for idx = 0 to array.size(tokens) - 1
            existing = f_norm(array.get(tokens, idx))
            if existing == f_norm(token)
                found := true
                break
    found

f_assign_label_column(float level, array<float> colLastLevels, float minGap, int maxCols, string mode) =>
    int assigned = -1
    if mode == "Off"
        assigned := 0
    else
        if array.size(colLastLevels) > 0
            for c = 0 to array.size(colLastLevels) - 1
                lastLevel = array.get(colLastLevels, c)
                if math.abs(level - lastLevel) >= minGap
                    assigned := c
                    break
        if assigned == -1
            if array.size(colLastLevels) < maxCols
                array.push(colLastLevels, level)
                assigned := array.size(colLastLevels) - 1
            else
                if mode == "Hide"
                    assigned := -1
                else
                    bestGap = -1.0
                    bestCol = 0
                    for c = 0 to array.size(colLastLevels) - 1
                        gap = math.abs(level - array.get(colLastLevels, c))
                        if gap > bestGap
                            bestGap := gap
                            bestCol := c
                    assigned := bestCol

    if assigned >= 0
        if assigned >= array.size(colLastLevels)
            array.push(colLastLevels, level)
        else
            array.set(colLastLevels, assigned, level)

    assigned

f_clear_drawings(array<line> linesRef, array<label> labelsRef) =>
    if array.size(linesRef) > 0
        for idx = 0 to array.size(linesRef) - 1
            line.delete(array.get(linesRef, idx))
    if array.size(labelsRef) > 0
        for idx = 0 to array.size(labelsRef) - 1
            label.delete(array.get(labelsRef, idx))
    array.clear(linesRef)
    array.clear(labelsRef)

var string TZ = "America/New_York"
var int SESSION_SHIFT_MS = 6 * 60 * 60 * 1000

f_session_key() =>
    referenceTime = f_is_overnight_futures(f_primary_symbol()) ? time + SESSION_SHIFT_MS : time
    year(referenceTime, TZ) * 10000 + month(referenceTime, TZ) * 100 + dayofmonth(referenceTime, TZ)

sessionKey = f_session_key()
isNewTradingSession = ta.change(sessionKey) != 0

var int sessionStartBar = 0
if barstate.isfirst or isNewTradingSession
    sessionStartBar := bar_index

var array<line> levelLines = array.new_line()
var array<label> levelLabels = array.new_label()
var array<int> labelColumns = array.new_int()
var array<float> labelColumnLastLevels = array.new_float()
var array<float> parsedPrices = array.new_float()
var array<string> parsedTitles = array.new_string()
var table statusTable = table.new(position.top_right, 1, 2, bgcolor = color.new(color.black, 80))
var table narrativeTable = table.new(position.bottom_right, 1, 6, bgcolor = color.new(color.black, 82))
var line emUpperFill = na
var line emLowerFill = na
var linefill emBandFill = na
var line gfUpperFill = na
var line gfLowerFill = na
var linefill gfBandFill = na
var string lastSelectedLine = ""
var string lastMatchedAsset = ""
// ── Narrative plan variables ────────────────────────────────────────────
var float planZeroGamma = na
var float planGammaFlipUpper = na
var float planGammaFlipLower = na
var float planGammaCliffUp = na
var float planGammaCliffDown = na
var float planCallWall = na
var float planCallWall0DTE = na
var float planPutWall0DTE = na
var float planLocalCallNode = na
var float planLocalPutNode = na
var float planDexCallNode = na
var float planDexPutNode = na
var float planHedgeWall = na
var float planMaxPain = na
var float planUpperEM = na
var float planLowerEM = na
var string lastFamilySourcePreference = ""
var bool lastOverrideExactWithFamilyPreference = false
var string selectedLine = ""
var string matchedAsset = ""
labelSize = f_label_size(labelSizeInp)

selectionNeedsUpdate = barstate.isfirst or familySourcePreference != lastFamilySourcePreference or overrideExactWithFamilyPreference != lastOverrideExactWithFamilyPreference
if selectionNeedsUpdate
    [nextSelectedLine, nextMatchedAsset] = f_find_matching_line(pastedData)
    selectedLine := nextSelectedLine
    matchedAsset := nextMatchedAsset

needsRedraw = barstate.isfirst or isNewTradingSession or selectionNeedsUpdate or selectedLine != lastSelectedLine or matchedAsset != lastMatchedAsset

if needsRedraw
    f_clear_drawings(levelLines, levelLabels)
    array.clear(labelColumns)
    array.clear(labelColumnLastLevels)
    line.delete(emUpperFill)
    line.delete(emLowerFill)
    linefill.delete(emBandFill)
    line.delete(gfUpperFill)
    line.delete(gfLowerFill)
    linefill.delete(gfBandFill)
    emUpperFill := na
    emLowerFill := na
    emBandFill := na
    gfUpperFill := na
    gfLowerFill := na
    gfBandFill := na
    planZeroGamma := na
    planGammaFlipUpper := na
    planGammaFlipLower := na
    planGammaCliffUp := na
    planGammaCliffDown := na
    planCallWall := na
    planCallWall0DTE := na
    planPutWall0DTE := na
    planLocalCallNode := na
    planLocalPutNode := na
    planDexCallNode := na
    planDexPutNode := na
    planHedgeWall := na
    planMaxPain := na
    planUpperEM := na
    planLowerEM := na

    if str.length(selectedLine) > 0
        f_parse_levels(selectedLine, parsedPrices, parsedTitles)

        selectedCanonical = f_canonical_symbol(matchedAsset)
        primaryCanonical = f_canonical_symbol(f_primary_symbol())
        selectedFamily = f_symbol_family_key(selectedCanonical)
        chartFamily = f_symbol_family_key(primaryCanonical)
        selectedIsFutures = f_is_overnight_futures(selectedCanonical)
        chartIsFutures = f_is_overnight_futures(primaryCanonical)

        if chartIsFutures and selectedFamily == chartFamily and not selectedIsFutures
            anchorAsset = f_family_futures_anchor(chartFamily)
            anchorLine = f_find_asset_line(pastedData, anchorAsset)
            bool convertedToFutures = false
            if str.length(anchorLine) > 0
                refPrices = array.new_float()
                refTitles = array.new_string()
                f_parse_levels(anchorLine, refPrices, refTitles)
                if array.size(refPrices) > 0 and array.size(parsedPrices) > 0
                    sourceRef = array.get(parsedPrices, 0)
                    anchorRef = array.get(refPrices, 0)
                    if math.abs(sourceRef) > syminfo.mintick
                        scale = anchorRef / sourceRef
                        for idx = 0 to array.size(parsedPrices) - 1
                            array.set(parsedPrices, idx, array.get(parsedPrices, idx) * scale)
                        convertedToFutures := true
                    if not convertedToFutures
                        basis = anchorRef - sourceRef
                        for idx = 0 to array.size(parsedPrices) - 1
                            array.set(parsedPrices, idx, array.get(parsedPrices, idx) + basis)
                        convertedToFutures := true

            if not convertedToFutures and array.size(parsedPrices) > 0
                sourceRef = array.get(parsedPrices, 0)
                if math.abs(sourceRef) > syminfo.mintick
                    fallbackScale = close / sourceRef
                    for idx = 0 to array.size(parsedPrices) - 1
                        array.set(parsedPrices, idx, array.get(parsedPrices, idx) * fallbackScale)

        float emUpperPrice = na
        float emLowerPrice = na
        float gammaFlipUpperPrice = na
        float gammaFlipLowerPrice = na

        uniqueLevels = array.new_float()
        uniqueTitles = array.new_string()
        uniqueColors = array.new_color()
        uniqueWidths = array.new_int()
        uniqueStyleKeys = array.new_string()

        if array.size(parsedPrices) > 0
            for idx = 0 to array.size(parsedPrices) - 1
                level = array.get(parsedPrices, idx)
                title = array.get(parsedTitles, idx)
                levelColor = f_level_color(title)
                levelStyle = f_level_style(title)
                levelWidth = f_level_width(title)
                shouldShowLevel = f_show_level(title)

                if shouldShowLevel
                    compactTitle = compactLabels ? f_compact_title(title) : title
                    existingIndex = -1

                    if mergeSamePriceLabels and array.size(uniqueLevels) > 0
                        for u = 0 to array.size(uniqueLevels) - 1
                            if f_is_same_price(level, array.get(uniqueLevels, u))
                                existingIndex := u
                                break

                    if existingIndex >= 0
                        mergedTitle = array.get(uniqueTitles, existingIndex)
                        appendToken = compactTitle
                        newMerged = f_has_merged_token(mergedTitle, appendToken) ? mergedTitle : mergedTitle + " + " + appendToken
                        array.set(uniqueTitles, existingIndex, newMerged)
                    else
                        array.push(uniqueLevels, level)
                        array.push(uniqueTitles, compactTitle)
                        array.push(uniqueColors, levelColor)
                        array.push(uniqueWidths, levelWidth)
                        styleKey = str.contains(f_norm(title), "0DTE") ? lineStyle0DTEInp : (str.contains(f_norm(title), "LOCAL") ? lineStyleSecondaryInp : lineStylePrimaryInp)
                        array.push(uniqueStyleKeys, styleKey)

                // ── Extract ALL narrative variables ─────────────────
                titleNorm = f_norm(title)
                if titleNorm == "UPPER EM"
                    emUpperPrice := level
                    planUpperEM := level
                if titleNorm == "LOWER EM"
                    emLowerPrice := level
                    planLowerEM := level
                if titleNorm == "ZERO GAMMA"
                    planZeroGamma := level
                if titleNorm == "GAMMA FLIP UPPER"
                    gammaFlipUpperPrice := level
                    planGammaFlipUpper := level
                if titleNorm == "GAMMA FLIP LOWER"
                    gammaFlipLowerPrice := level
                    planGammaFlipLower := level
                if titleNorm == "GAMMA CLIFF UP"
                    planGammaCliffUp := level
                if titleNorm == "GAMMA CLIFF DOWN"
                    planGammaCliffDown := level
                if titleNorm == "ABSOLUTE CALL WALL"
                    planCallWall := level
                if titleNorm == "0DTE CALL WALL"
                    planCallWall0DTE := level
                if titleNorm == "0DTE PUT WALL"
                    planPutWall0DTE := level
                if titleNorm == "LOCAL CALL NODE"
                    planLocalCallNode := level
                if titleNorm == "LOCAL PUT NODE"
                    planLocalPutNode := level
                if titleNorm == "DEX CALL NODE"
                    planDexCallNode := level
                if titleNorm == "DEX PUT NODE"
                    planDexPutNode := level
                if titleNorm == "HEDGE WALL"
                    planHedgeWall := level
                if titleNorm == "MAX PAIN"
                    planMaxPain := level

        if array.size(uniqueLevels) > 0
            for u = 0 to array.size(uniqueLevels) - 1
                drawLevel = array.get(uniqueLevels, u)
                drawColor = array.get(uniqueColors, u)
                drawWidth = array.get(uniqueWidths, u)
                drawStyle = f_line_style(array.get(uniqueStyleKeys, u))
                drawTitle = array.get(uniqueTitles, u)

                levelLine = line.new(sessionStartBar, drawLevel, bar_index + 1, drawLevel, color = drawColor, width = drawWidth, style = drawStyle, extend = extend.none)
                array.push(levelLines, levelLine)

                if showLabels
                    minGap = syminfo.mintick * minLabelGapTicks
                    labelCol = f_assign_label_column(drawLevel, labelColumnLastLevels, minGap, maxLabelColumns, labelCollisionMode)
                    if labelCol >= 0
                        labelX = bar_index + labelOffset + (labelCol * columnStepBars)
                        displayText = showPriceInLabel ? drawTitle + "  " + str.tostring(drawLevel, "#.##") : drawTitle
                        levelLabel = label.new(labelX, drawLevel, displayText, textcolor = drawColor, color = color.new(color.black, labelBgOpacity), style = label.style_label_left, size = labelSize)
                        array.push(levelLabels, levelLabel)
                        array.push(labelColumns, labelCol)

        if showEmFill and not na(emUpperPrice) and not na(emLowerPrice)
            emUpperFill := line.new(sessionStartBar, emUpperPrice, bar_index + 1, emUpperPrice, color = color.new(color.aqua, 95), width = 1, extend = extend.none)
            emLowerFill := line.new(sessionStartBar, emLowerPrice, bar_index + 1, emLowerPrice, color = color.new(color.aqua, 95), width = 1, extend = extend.none)
            emBandFill := linefill.new(emUpperFill, emLowerFill, colEmFill)

        if showGammaFlipLevels and not na(gammaFlipUpperPrice) and not na(gammaFlipLowerPrice)
            gfUpperFill := line.new(sessionStartBar, gammaFlipUpperPrice, bar_index + 1, gammaFlipUpperPrice, color = color.new(color.yellow, 95), width = 1, extend = extend.none)
            gfLowerFill := line.new(sessionStartBar, gammaFlipLowerPrice, bar_index + 1, gammaFlipLowerPrice, color = color.new(color.yellow, 95), width = 1, extend = extend.none)
            gfBandFill := linefill.new(gfUpperFill, gfLowerFill, colGammaFlipFill)

    lastSelectedLine := selectedLine
    lastMatchedAsset := matchedAsset
    lastFamilySourcePreference := familySourcePreference
    lastOverrideExactWithFamilyPreference := overrideExactWithFamilyPreference

if array.size(levelLines) > 0
    for idx = 0 to array.size(levelLines) - 1
        line.set_x2(array.get(levelLines, idx), bar_index)

if not na(emUpperFill)
    line.set_x2(emUpperFill, bar_index)
if not na(emLowerFill)
    line.set_x2(emLowerFill, bar_index)
if not na(gfUpperFill)
    line.set_x2(gfUpperFill, bar_index)
if not na(gfLowerFill)
    line.set_x2(gfLowerFill, bar_index)

if array.size(levelLabels) > 0
    for idx = 0 to array.size(levelLabels) - 1
        col = idx < array.size(labelColumns) ? array.get(labelColumns, idx) : 0
        labelX = bar_index + labelOffset + (col * columnStepBars)
        label.set_x(array.get(levelLabels, idx), labelX)

if barstate.islast and showStatusTable
    primary = f_primary_symbol()
    resolved = str.length(matchedAsset) > 0 ? matchedAsset : "NO MATCH"
    statusColor = str.length(matchedAsset) > 0 ? color.new(color.lime, 0) : color.new(color.red, 0)
    modeText = f_is_overnight_futures(primary) ? "Globex Day" : "Calendar Day"
    table.cell(statusTable, 0, 0, "Chart: " + primary + " | " + modeText, text_color = color.white)
    table.cell(statusTable, 0, 1, "Loaded: " + resolved, text_color = statusColor)
if barstate.islast and not showStatusTable
    table.clear(statusTable, 0, 0, 0, 1)

if barstate.islast and showNarrativeTable
    // ── Triggers: match Python's first_level fallback chain ────
    shortTrigger = f_pick(planZeroGamma, planGammaFlipLower, planCallWall)
    longTrigger = f_pick(planCallWall, planGammaFlipUpper, planZeroGamma)

    // ── Targets: match Python's nearest_below / nearest_above ──
    shortTarget = f_nearest_below(shortTrigger, planPutWall0DTE, planHedgeWall, planLowerEM)
    shortInvalid = f_nearest_above(shortTrigger, planCallWall, planGammaFlipUpper, planUpperEM)
    longTarget = f_nearest_above(longTrigger, planMaxPain, planUpperEM, planGammaFlipUpper)
    longInvalid = f_nearest_below(longTrigger, planZeroGamma, planGammaFlipLower, planPutWall0DTE)

    // ── Watch line includes DEX nodes ──────────────────────────
    watchParts = "Watch ZG " + f_num(planZeroGamma)
    if not na(planGammaFlipLower) and not na(planGammaFlipUpper)
        watchParts := watchParts + " | GF " + f_num(planGammaFlipLower) + "↔" + f_num(planGammaFlipUpper)
    if not na(planDexPutNode) or not na(planDexCallNode)
        watchParts := watchParts + " | DEX " + f_num(planDexPutNode) + "/" + f_num(planDexCallNode)

    // ── Reaction zones: Gamma Cliffs + DEX nodes ───────────────
    shortZones = ""
    if not na(planGammaCliffDown)
        shortZones := shortZones + "GC↓ " + f_num(planGammaCliffDown) + " "
    if not na(planDexPutNode)
        shortZones := shortZones + "DEX " + f_num(planDexPutNode)

    longZones = ""
    if not na(planGammaCliffUp)
        longZones := longZones + "GC↑ " + f_num(planGammaCliffUp) + " "
    if not na(planDexCallNode)
        longZones := longZones + "DEX " + f_num(planDexCallNode)

    shortText = "Short: < " + f_num(shortTrigger) + " → " + f_num(shortTarget) + " | inv > " + f_num(shortInvalid)
    if str.length(shortZones) > 0
        shortText := shortText + " | " + shortZones
    longText = "Long: > " + f_num(longTrigger) + " → " + f_num(longTarget) + " | inv < " + f_num(longInvalid)
    if str.length(longZones) > 0
        longText := longText + " | " + longZones

    table.cell(narrativeTable, 0, 0, "Narrative Plan", text_color = color.white)
    table.cell(narrativeTable, 0, 1, watchParts, text_color = color.new(color.white, 0))
    table.cell(narrativeTable, 0, 2, shortText, text_color = color.new(color.red, 0))
    table.cell(narrativeTable, 0, 3, longText, text_color = color.new(color.lime, 0))
    table.cell(narrativeTable, 0, 4, "EM: " + f_num(planLowerEM) + " ↔ " + f_num(planUpperEM), text_color = color.new(color.aqua, 0))
    // Row 5: Cliff zones quick reference
    cliffText = "Cliffs: ↓" + f_num(planGammaCliffDown) + " | ↑" + f_num(planGammaCliffUp)
    table.cell(narrativeTable, 0, 5, cliffText, text_color = color.new(color.teal, 0))

if barstate.islast and not showNarrativeTable
    table.clear(narrativeTable, 0, 0, 0, 5)
