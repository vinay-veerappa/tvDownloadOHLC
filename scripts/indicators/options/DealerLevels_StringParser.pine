//
// DealerLevels_StringParser.pine
// Paste a copy-ready line from data/daily_levels.txt into the input field.
// Format expected:
// [PRICE]:Upper EM, [PRICE]:Absolute Call Wall, [PRICE]:Local Call Node,
// [PRICE]:0DTE Call Wall, [PRICE]:Zero Gamma, [PRICE]:Max Pain,
// [PRICE]:0DTE Put Wall, [PRICE]:Local Put Node, [PRICE]:Hedge Wall,
// [PRICE]:Lower EM
//
// TradingView cannot read local files directly. Paste the line text manually.

//@version=6
indicator("Dealer Levels Parser (String)", overlay=true, max_lines_count=200, max_labels_count=200)

assetMode = input.string("Auto", "Asset", options=["Auto", "ES", "NQ"])
esString = input.string("", "ES String")
nqString = input.string("", "NQ String")

showLabels = input.bool(true, "Show Labels")
lineWidth = input.int(2, "Line Width", minval=1, maxval=4)

colUpperEM = input.color(color.new(color.aqua, 0), "Upper EM")
colAbsCall = input.color(color.new(color.green, 0), "Absolute Call Wall")
colLocalCall = input.color(color.new(color.green, 30), "Local Call Node")
col0dteCall = input.color(color.new(color.green, 60), "0DTE Call Wall")
colZeroGamma = input.color(color.new(color.yellow, 0), "Zero Gamma")
colMaxPain = input.color(color.new(color.orange, 0), "Max Pain")
col0dtePut = input.color(color.new(color.red, 60), "0DTE Put Wall")
colLocalPut = input.color(color.new(color.red, 30), "Local Put Node")
colHedge = input.color(color.new(color.red, 0), "Hedge Wall")
colLowerEM = input.color(color.new(color.aqua, 0), "Lower EM")

f_price(token) =>
    parts = str.split(str.trim(token), ":")
    array.size(parts) > 0 ? str.tonumber(array.get(parts, 0)) : na

f_parse_line(line) =>
    tokens = str.split(line, ",")
    ok = array.size(tokens) >= 10
    upperEm = ok ? f_price(array.get(tokens, 0)) : na
    absCall = ok ? f_price(array.get(tokens, 1)) : na
    localCall = ok ? f_price(array.get(tokens, 2)) : na
    dteCall = ok ? f_price(array.get(tokens, 3)) : na
    zeroGamma = ok ? f_price(array.get(tokens, 4)) : na
    maxPain = ok ? f_price(array.get(tokens, 5)) : na
    dtePut = ok ? f_price(array.get(tokens, 6)) : na
    localPut = ok ? f_price(array.get(tokens, 7)) : na
    hedgeWall = ok ? f_price(array.get(tokens, 8)) : na
    lowerEm = ok ? f_price(array.get(tokens, 9)) : na
    [upperEm, absCall, localCall, dteCall, zeroGamma, maxPain, dtePut, localPut, hedgeWall, lowerEm]

f_draw(level, title, col, style) =>
    if not na(level)
        line.new(bar_index, level, bar_index + 1, level, extend=extend.right, width=lineWidth, color=col, style=style)
        if showLabels
            label.new(bar_index, level, title + " " + str.tostring(level, "#.##"), textcolor=col, color=color.new(color.black, 90), style=label.style_label_left, size=size.tiny)

selected = assetMode
selected := selected == "Auto" ? (str.contains(syminfo.ticker, "NQ") ? "NQ" : "ES") : selected
raw = selected == "NQ" ? nqString : esString

[upperEm, absCall, localCall, dteCall, zeroGamma, maxPain, dtePut, localPut, hedgeWall, lowerEm] = f_parse_line(raw)

if barstate.isfirst and str.length(str.trim(raw)) > 0
    f_draw(upperEm, "Upper EM", colUpperEM, line.style_solid)
    f_draw(absCall, "Abs Call", colAbsCall, line.style_solid)
    f_draw(localCall, "Local Call", colLocalCall, line.style_dashed)
    f_draw(dteCall, "0DTE Call", col0dteCall, line.style_dotted)
    f_draw(zeroGamma, "Zero Gamma", colZeroGamma, line.style_solid)
    f_draw(maxPain, "Max Pain", colMaxPain, line.style_solid)
    f_draw(dtePut, "0DTE Put", col0dtePut, line.style_dotted)
    f_draw(localPut, "Local Put", colLocalPut, line.style_dashed)
    f_draw(hedgeWall, "Hedge Wall", colHedge, line.style_solid)
    f_draw(lowerEm, "Lower EM", colLowerEM, line.style_solid)
