//@version=6
indicator("Daily NY Levels VxV", overlay=true, max_bars_back=5000, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ==========================================
// --- INPUTS ---
// ==========================================
grp_general = "General Settings"
cutoffTime     = input.int(1200, "Cutoff Time (HHMM)", minval=0, maxval=2359, group=grp_general)

grp_style = "Style"
bullColor = input.color(color.blue, "Bullish Color", group=grp_style)
bearColor = input.color(color.red, "Bearish Color", group=grp_style)
boxColor0930 = input.color(color.yellow, "0930-0931 Box Color", group=grp_style)

grp_mfe = "MFE Distribution Profile"
refBaseMode      = input.string("09:31 Close", "Reference Base", options=["09:31 Close", "OR High/Low"], tooltip="Choose reference point for MFE calculation", group=grp_mfe)
percentileStep   = input.int(2, "Percentile Step", minval=1, maxval=10, group=grp_mfe)
startPercentile  = input.int(20, "Start Percentile", minval=1, maxval=99, group=grp_mfe)
endPercentile    = input.int(80, "End Percentile", minval=1, maxval=99, group=grp_mfe)
bullCenterColor  = input.color(color.new(color.green, 50), "Bullish Center Color", group=grp_mfe)
bullEdgeColor    = input.color(color.new(color.green, 100), "Bullish Edge Color", group=grp_mfe)
bearCenterColor  = input.color(color.new(color.red, 50), "Bearish Center Color", group=grp_mfe)
bearEdgeColor    = input.color(color.new(color.red, 100), "Bearish Edge Color", group=grp_mfe)
showPercentLabels = input.bool(true, "Show Percentile Labels", group=grp_mfe)
showAvgLine       = input.bool(true, "Show AVG Line", group=grp_mfe)
avgLineColor      = input.color(color.white, "AVG Line Color", group=grp_mfe)
histWidthScale    = input.int(50, "Histogram Width Scale", minval=1, maxval=500, group=grp_mfe)
binSize           = input.float(0.04, "Bin Size (%)", minval=0.01, maxval=0.10, step=0.01, tooltip="Size of each histogram bin in percentage", group=grp_mfe)
mfeLabelSize      = input.string("tiny", "Label Size", options=["auto", "tiny", "small", "normal", "large", "huge"], group=grp_mfe)
mfeDataLabelSize  = input.string("small", "Data Count Label Size", options=["auto", "tiny", "small", "normal", "large", "huge"], group=grp_mfe)
showDebugLabels   = input.bool(false, "Show Debug Labels", tooltip="Display labels when MFE data is committed at 12:00 PM", group=grp_mfe)


grp_time = "Hit Time Distribution"
showTimeDist     = input.bool(true, "Show Time Distribution", group=grp_time)
timeBucketMins   = input.int(5, "Time Bucket (minutes)", minval=1, maxval=60, group=grp_time)
profileHeight    = input.int(50, "Profile Height (points)", group=grp_time)
offsetBelowMFE   = input.int(200, "Offset Below MFE Bars (ticks)", group=grp_time)
showTimeAvg      = input.bool(true, "Show AVG Line", group=grp_time)
showTimeMed      = input.bool(true, "Show Median Line", group=grp_time)
timeAvgLineColor = input.color(color.yellow, "AVG Line Color", group=grp_time)
timeMedLineColor = input.color(color.aqua, "Median Line Color", group=grp_time)
timeBullColor    = input.color(color.new(color.green, 50), "Time Bullish Color", group=grp_time)
timeBearColor    = input.color(color.new(color.red, 50), "Time Bearish Color", group=grp_time)
timeLabelSize    = input.string("tiny", "Label Size", options=["auto", "tiny", "small", "normal", "large", "huge"], group=grp_time)

// --- 15-Minute Level Inputs ---
grp_15m = "15-Min Levels"
show15mLevels    = input.bool(true, "Show 15m Levels", group=grp_15m)
color15mBorder   = input.color(color.new(color.orange, 50), "15m Line Color", group=grp_15m)
calc15mMode      = input.string("Average", "Calculation Mode", options=["Average", "Median", "Percentile"], group=grp_15m)
calcPercentile   = input.float(50.0, "Percentile (for Mode)", minval=0.0, maxval=100.0, step=5.0, group=grp_15m)
calcSource       = input.string("Active Mode", "Level Source", options=["Active Mode", "Combined"], group=grp_15m, tooltip="Use 'Combined' to calculate the line level from all data (e.g. Combined Median) and see how often Bull/Bear days hit it.")
calcRef          = input.string("9:31 Close", "Reference Base", options=["9:31 Close", "Opening Range"], group=grp_15m)
displayStatsMode = input.string("Combined", "Display Stats", options=["Combined", "Bullish Days", "Bearish Days"], group=grp_15m)
show15mTooltips  = input.bool(true, "Show Tooltips", group=grp_15m)

// --- Types ---
type BucketHistory
    float[] bull_highs
    float[] bull_lows
    float[] bear_highs
    float[] bear_lows

// Helper: Get Bull/Bear/Combined stats
f_get_15m_stats(BucketHistory bh, string mode) =>
    float[] h = array.new_float(0)
    float[] l = array.new_float(0)
    if not na(bh)
        if mode == "Combined"
            h := array.concat(array.copy(bh.bull_highs), bh.bear_highs)
            l := array.concat(array.copy(bh.bull_lows), bh.bear_lows)
        else if mode == "Bullish Days"
            h := bh.bull_highs
            l := bh.bull_lows
        else // Bearish Days
            h := bh.bear_highs
            l := bh.bear_lows
    [h, l]

// Helper: Calculate hits >= level
f_calc_stats(float[] arr, float level) =>
    int total = array.size(arr)
    int hits = 0
    if total > 0
        for i = 0 to total - 1
            if array.get(arr, i) >= level
                hits += 1
    [total, hits]

// ==========================================
// --- CONSTANTS & LOGIC ---
// ==========================================
// Convert size strings to constants
f_size(s) =>
    s == "auto" ? size.auto : s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : s == "large" ? size.large : size.huge

mfe_size = f_size(mfeLabelSize)
mfe_data_size = f_size(mfeDataLabelSize)
time_size = f_size(timeLabelSize)

is_ny_session = time(timeframe.period, "0930-1600:1234567", "America/New_York")
is_before_cutoff = time(timeframe.period, "0930-" + str.format("{0,number,0000}", cutoffTime) + ":1234567", "America/New_York")

var float or_high = na
var float or_low = na
var float or_open = na

bool is_new_day = ta.change(time("D", "America/New_York")) != 0

if is_new_day
    or_high := na
    or_low := na
    or_open := na

// Capture 09:30-09:31 OR (1m) - for chart's native timeframe
// --- Daily tracking variables (Declared early for reset logic) ---
var float daily_max_bull_mfe = 0.0
var float daily_max_bear_mfe = 0.0
var int daily_bull_peak_time = 0
var int daily_bear_peak_time = 0
var bool is_committed_today = false

// --- Daily pivot tracking (for price histogram) ---
var float[] daily_pivot_bulls = array.new_float(0)
var float[] daily_pivot_bears = array.new_float(0)

is_0930 = hour(time, "America/New_York") == 9 and minute(time, "America/New_York") == 30

if is_0930
    or_high := high
    or_low := low
    or_open := open

// MTF Opening Range (Fetch 1m OR for consistency across all timeframes)
[m1_open, m1_high, m1_low, m1_time] = request.security(syminfo.tickerid, "1", [open, high, low, time], lookahead=barmerge.lookahead_on)
is_m1_0930 = hour(m1_time, "America/New_York") == 9 and minute(m1_time, "America/New_York") == 30

// Fetch 1-min intrabar data for MFE tracking (works on all timeframes)
// Returns arrays of 1-min bars within each chart bar
[ltf_high_arr, ltf_low_arr, ltf_time_arr] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, time])

var float active_or_high = na
var float active_or_low = na
var float active_or_open = na
var bool or_set_today = false

// Reset on new day
if is_new_day
    active_or_high := na
    active_or_low := na
    active_or_open := na
    or_set_today := false
    
    // Reset Daily MFE & Commit Flags (FIX for Accumulation Bug)
    daily_max_bull_mfe := 0.0
    daily_max_bear_mfe := 0.0
    daily_bull_peak_time := 0
    daily_bear_peak_time := 0
    is_committed_today := false
    array.clear(daily_pivot_bulls)
    array.clear(daily_pivot_bears)

// Set active_or from MTF 1m data (works on all timeframes)
var int or_bar_index = na  // Store the bar_index of 09:30 for histogram anchoring

if is_m1_0930 and not na(m1_high) and not or_set_today
    active_or_high := m1_high
    active_or_low  := m1_low
    active_or_open := m1_open
    or_set_today := true
    or_bar_index := bar_index  // Store 09:30 bar position
else if is_0930 and not or_set_today
    // Fallback to chart's native OR if MTF data not available
    active_or_high := or_high
    active_or_low  := or_low
    active_or_open := or_open
    or_set_today := true
    or_bar_index := bar_index  // Store 09:30 bar position

// Draw 09:30 Box using MTF data (works on all timeframes)
var box or_box = na
// Session start: first bar where we have active_or set and we're in session
bool is_session_start = or_set_today and not na(active_or_high) and (is_0930 or (is_m1_0930 and ta.change(or_set_today ? 1 : 0) != 0))

if is_session_start or (not na(active_or_high) and na(or_box) and not na(is_before_cutoff))
    or_box := box.new(bar_index, active_or_high, bar_index + 1, active_or_low, border_color=boxColor0930, bgcolor=color.new(boxColor0930, 80))
else if not na(or_box) and not na(is_before_cutoff)
    box.set_right(or_box, bar_index)


// ==========================================
// --- STATISTICAL ENGINE: MFE FROM 09:31 CLOSE ---
// ==========================================
// Uses 09:31 candle CLOSE ±0.01% as the reference base
// Only commits MFE for the WINNING direction at cutoff

// --- History Arrays (one value per winning day) ---
var float[] mfe_bull_history = array.new_float(0)
var float[] mfe_bear_history = array.new_float(0)
var int[] peak_time_bull_history = array.new_int(0)
var int[] peak_time_bear_history = array.new_int(0)

// --- Pivot-based History (for price histogram) ---
// Stores all pivot highs on LONG days (MFE > MAE)
// Stores all pivot lows on SHORT days (MAE > MFE)
var float[] pivot_bull_history = array.new_float(0)
var float[] pivot_bear_history = array.new_float(0)

// --- Reference base: set when OR is established ---
var float ref_close_0931 = na
var float bull_ref = na  // Reference for bull extension
var float bear_ref = na  // Reference for bear extension
var bool ref_set_today = false

// Fetch 09:31 candle close via MTF (for 09:31 Close mode on higher timeframes)
[m1_0931_close, m1_0931_time] = request.security(syminfo.tickerid, "1", [close, time], lookahead=barmerge.lookahead_on)
is_m1_0931 = hour(m1_0931_time, "America/New_York") == 9 and minute(m1_0931_time, "America/New_York") == 31

// Native 09:31 detection (only fires on 1-min chart)
is_0931 = hour(time, "America/New_York") == 9 and minute(time, "America/New_York") == 31

// Reset reference on new day
if is_new_day
    ref_close_0931 := na
    bull_ref := na
    bear_ref := na
    ref_set_today := false

// Set reference when OR is established and we haven't set it yet today
// This fires on the first bar >= 09:30 on any timeframe
var bool just_set_ref = false
just_set_ref := false  // Reset each bar

if or_set_today and not ref_set_today and not na(active_or_high)
    if refBaseMode == "09:31 Close"
        // Use MTF 09:31 close if available, otherwise use current close
        if is_m1_0931 and not na(m1_0931_close)
            ref_close_0931 := m1_0931_close
        else if is_0931
            ref_close_0931 := close
        else
            // On higher TF, use OR midpoint as fallback
            ref_close_0931 := (active_or_high + active_or_low) / 2
        bull_ref := ref_close_0931 * 1.0001  // +0.01%
        bear_ref := ref_close_0931 * 0.9999  // -0.01%
    else  // "OR High/Low"
        ref_close_0931 := (active_or_high + active_or_low) / 2  // Use OR midpoint for calculations
        bull_ref := active_or_high  // Use OR High as bull reference
        bear_ref := active_or_low   // Use OR Low as bear reference
    
    ref_set_today := true
    just_set_ref := true  // Flag for drawing histogram on this bar
    
    if showDebugLabels
        string mode_str = refBaseMode == "09:31 Close" ? "09:31 Close" : "OR H/L"
        label.new(bar_index, close, "REF (" + mode_str + ")\nBull: " + str.tostring(bull_ref, "#.##") + "\nBear: " + str.tostring(bear_ref, "#.##"), color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_right, size=size.tiny)


// --- Daily tracking variables ---
// MOVED TO TOP (Fix for initialization order)
// var float daily_max_bull_mfe = 0.0
// var float daily_max_bear_mfe = 0.0
// var int daily_bull_peak_time = 0
// var int daily_bear_peak_time = 0
// var bool is_committed_today = false

// --- Daily pivot tracking (for price histogram) ---
// MOVED TO TOP
// var float[] daily_pivot_bulls = array.new_float(0)
// var float[] daily_pivot_bears = array.new_float(0)

// --- 15-Minute Bucket Tracking ---
var float curr_15m_high = na
var float curr_15m_low = na
var int curr_15m_start_time = na
var int last_bucket_id = -1

// --- Historical 15-Minute Stats (Expanding Window) ---
// Max 20 buckets (5 hours * 4) covers enough
// --- Historical 15-Minute Stats (Expanding Window) ---
// Max 20 buckets. Using UDT to store full history for Median calc.
var BucketHistory[] bucket_stats = array.new<BucketHistory>(20)

// Initialize bucket stats on first run
if barstate.isfirst
    for i = 0 to 19
        array.set(bucket_stats, i, BucketHistory.new(array.new_float(0), array.new_float(0), array.new_float(0), array.new_float(0)))

// Buffer arrays for today's MFE values
var float[] today_15m_highs = array.new_float(20, na)
var float[] today_15m_lows = array.new_float(20, na)


// --- Helper: Calculate minutes since 09:30 ---
f_mins_since_or() =>
    (hour(time, "America/New_York") * 60 + minute(time, "America/New_York")) - (9 * 60 + 30)

// --- Reset DAILY tracking at 09:30 (start of new session) ---
// Note: ref_close_0931/bull_ref/bear_ref are reset by is_new_day and ref_set_today logic
if is_0930
    daily_max_bull_mfe := 0.0
    daily_max_bear_mfe := 0.0
    daily_bull_peak_time := 0
    daily_bear_peak_time := 0
    is_committed_today := false
    // Reset 15m tracking
    curr_15m_high := na
    curr_15m_low := na
    curr_15m_start_time := na
    curr_15m_start_time := na
    last_bucket_id := -1
    // Reset daily buffers
    array.fill(today_15m_highs, na)
    array.fill(today_15m_lows, na)
    // Clear daily pivot arrays (NOT history arrays)
    array.clear(daily_pivot_bulls)
    array.clear(daily_pivot_bears)


// --- Track MFE using 1-min intrabar data (consistent across all timeframes) ---
// Process each 1-min bar within the current chart bar
// On 1-min charts, ltf arrays will be empty - fallback to native OHLC
if not na(bull_ref) and not na(ref_close_0931)
    int num_ltf_bars = array.size(ltf_high_arr)
    
    // If on 1-min chart (no lower TF data), process native bar
    if num_ltf_bars == 0
        // Use native bar data (this is a 1-min chart)
        int bar_hour = hour(time, "America/New_York")
        int bar_min = minute(time, "America/New_York")
        int bar_hhmm = bar_hour * 100 + bar_min
        
        bool is_bar_0930 = bar_hour == 9 and bar_min == 30
        bool is_bar_after_cutoff = bar_hhmm >= cutoffTime
        bool is_bar_before_session = bar_hhmm < 931
        
        if not is_bar_0930 and not is_bar_after_cutoff and not is_bar_before_session
            // Bull MFE
            if high > bull_ref
                float ext_above = (high - bull_ref) / ref_close_0931 * 100
                if ext_above > daily_max_bull_mfe
                    daily_max_bull_mfe := ext_above
                    daily_bull_peak_time := (bar_hour * 60 + bar_min) - (9 * 60 + 30)
            
            // Bear MFE
            if low < bear_ref
                float ext_below = (bear_ref - low) / ref_close_0931 * 100
                if ext_below > daily_max_bear_mfe
                    daily_max_bear_mfe := ext_below
                    daily_bear_peak_time := (bar_hour * 60 + bar_min) - (9 * 60 + 30)
            
            // Pivot tracking
            if high > bull_ref
                array.push(daily_pivot_bulls, (high - bull_ref) / ref_close_0931 * 100)
            if low < bear_ref
                array.push(daily_pivot_bears, (bear_ref - low) / ref_close_0931 * 100)
                
            // --- 15-Minute Bucket Logic (Native) ---
            int mins_From_930 = (bar_hour * 60 + bar_min) - (9 * 60 + 30)
            if mins_From_930 >= 0
                int bucket_id = math.floor(mins_From_930 / 15)
                
                if bucket_id != last_bucket_id
                    // Close previous bucket
                    if last_bucket_id != -1 and not na(curr_15m_high) and show15mLevels
                        // 1. Get History (if any)
                        BucketHistory bh = last_bucket_id < 20 ? array.get(bucket_stats, last_bucket_id) : na
                        [h_arr, l_arr] = f_get_15m_stats(bh, displayStatsMode)
                        
                        // Fix for Tuple Ternary Error (Combined Stats)
                        float[] h_comb = na
                        float[] l_comb = na
                        if displayStatsMode == "Combined"
                            h_comb := h_arr
                            l_comb := l_arr
                        else
                            [hc, lc] = f_get_15m_stats(bh, "Combined")
                            h_comb := hc
                            l_comb := lc
                        
                        // Get Calculation Source Data (Active or Combined)
                        float[] h_calc = calcSource == "Combined" ? h_comb : h_arr
                        float[] l_calc = calcSource == "Combined" ? l_comb : l_arr

                        int hist_cnt = array.size(h_arr)
                        
                        // Define References based on Input
                        float ref_h = calcRef == "Opening Range" ? active_or_high : ref_close_0931
                        float ref_l = calcRef == "Opening Range" ? active_or_low : ref_close_0931

                        // 2. Draw Historical Level (if data exists)
                        if hist_cnt > 0 and not na(ref_h) and not na(ref_l)
                            // Calculate Level from Source Data (h_calc)
                            float avg_h_pct = calc15mMode == "Average" ? array.avg(h_calc) : calc15mMode == "Median" ? array.median(h_calc) : array.percentile_linear_interpolation(h_calc, calcPercentile)
                            float avg_l_pct = calc15mMode == "Average" ? array.avg(l_calc) : calc15mMode == "Median" ? array.median(l_calc) : array.percentile_linear_interpolation(l_calc, calcPercentile)
                            
                            // Calculate Hit Stats (Active Mode Data vs Level)
                            [tot_h, hits_h] = f_calc_stats(h_arr, avg_h_pct)
                            [tot_l, hits_l] = f_calc_stats(l_arr, avg_l_pct)
                            float pct_h = tot_h > 0 ? hits_h * 100.0 / tot_h : 0.0
                            float pct_l = tot_l > 0 ? hits_l * 100.0 / tot_l : 0.0
                            
                            // Convert PCT to Price for Plotting
                            float plot_h = ref_h * (1 + avg_h_pct)
                            float plot_l = ref_l * (1 - avg_l_pct)
                            
                            // Filter Drawing based on Mode
                            bool draw_h = displayStatsMode == "Combined" or displayStatsMode == "Bullish Days"
                            bool draw_l = displayStatsMode == "Combined" or displayStatsMode == "Bearish Days"
                            
                            if draw_h
                                line.new(curr_15m_start_time, plot_h, time, plot_h, xloc=xloc.bar_time, color=color15mBorder)
                            if draw_l
                                line.new(curr_15m_start_time, plot_l, time, plot_l, xloc=xloc.bar_time, color=color15mBorder)
                            
                            if show15mTooltips
                                string tt = str.format("15m {0} ({1})\nHigh: {2} sess, {3} hits ({4,number,#.##}%)\nLow: {5} sess, {6} hits ({7,number,#.##}%)", calc15mMode, displayStatsMode, tot_h, hits_h, pct_h, tot_l, hits_l, pct_l)
                                
                                // Append Combined Stats if separate
                                // Calculate Hit Stats (Combined Data vs Level)
                                if displayStatsMode != "Combined"
                                    [tot_h_c, hits_h_c] = f_calc_stats(h_comb, avg_h_pct)
                                    [tot_l_c, hits_l_c] = f_calc_stats(l_comb, avg_l_pct)
                                    float pct_h_c = tot_h_c > 0 ? hits_h_c * 100.0 / tot_h_c : 0.0
                                    float pct_l_c = tot_l_c > 0 ? hits_l_c * 100.0 / tot_l_c : 0.0
                                    tt := tt + str.format("\n\nCombined:\nHigh: {0} sess, {1} hits ({2,number,#.##}%)\nLow: {3} sess, {4} hits ({5,number,#.##}%)", tot_h_c, hits_h_c, pct_h_c, tot_l_c, hits_l_c, pct_l_c)
                                
                                if draw_h
                                    label.new(time, plot_h, "●", xloc=xloc.bar_time, style=label.style_none, textcolor=color15mBorder, size=size.tiny, tooltip=tt)
                                if draw_l
                                    label.new(time, plot_l, "●", xloc=xloc.bar_time, style=label.style_none, textcolor=color15mBorder, size=size.tiny, tooltip=tt)
                        
                        // 3. Update Stats (Buffer for End of Day) -> Store as PERCENTAGE
                        if last_bucket_id < 20 and not na(ref_h) and not na(ref_l)
                            float curr_h_pct = (curr_15m_high - ref_h) / ref_h
                            float curr_l_pct = (ref_l - curr_15m_low) / ref_l
                            array.set(today_15m_highs, last_bucket_id, curr_h_pct)
                            array.set(today_15m_lows, last_bucket_id, curr_l_pct)

                    // Start new bucket
                    curr_15m_high := high
                    curr_15m_low := low
                    curr_15m_start_time := time
                    last_bucket_id := bucket_id
                else
                    // Update current bucket
                    curr_15m_high := math.max(curr_15m_high, high)
                    curr_15m_low := math.min(curr_15m_low, low)
    else
        // Use lower timeframe data (this is a higher TF chart like 5m, 15m, etc.)
        for i = 0 to num_ltf_bars - 1
            float ltf_high = array.get(ltf_high_arr, i)
            float ltf_low = array.get(ltf_low_arr, i)
            int ltf_time = array.get(ltf_time_arr, i)
            
            int ltf_hour = hour(ltf_time, "America/New_York")
            int ltf_min = minute(ltf_time, "America/New_York")
            int ltf_hhmm = ltf_hour * 100 + ltf_min
            
            bool is_ltf_0930 = ltf_hour == 9 and ltf_min == 30
            bool is_after_cutoff = ltf_hhmm >= cutoffTime
            bool is_before_session = ltf_hhmm < 931
            
            if not is_ltf_0930 and not is_after_cutoff and not is_before_session
                // Bull MFE
                if ltf_high > bull_ref
                    float ext_above = (ltf_high - bull_ref) / ref_close_0931 * 100
                    if ext_above > daily_max_bull_mfe
                        daily_max_bull_mfe := ext_above
                        daily_bull_peak_time := (ltf_hour * 60 + ltf_min) - (9 * 60 + 30)
                
                // Bear MFE
                if ltf_low < bear_ref
                    float ext_below = (bear_ref - ltf_low) / ref_close_0931 * 100
                    if ext_below > daily_max_bear_mfe
                        daily_max_bear_mfe := ext_below
                        daily_bear_peak_time := (ltf_hour * 60 + ltf_min) - (9 * 60 + 30)
                
                // Pivot tracking
                if ltf_high > bull_ref
                    array.push(daily_pivot_bulls, (ltf_high - bull_ref) / ref_close_0931 * 100)
                if ltf_low < bear_ref
                    array.push(daily_pivot_bears, (bear_ref - ltf_low) / ref_close_0931 * 100)
                
                // --- 15-Minute Bucket Logic (MTF) ---
                int mins_From_930 = (ltf_hour * 60 + ltf_min) - (9 * 60 + 30)
                if mins_From_930 >= 0
                    int bucket_id = math.floor(mins_From_930 / 15)
                    
                    if bucket_id != last_bucket_id
                        if last_bucket_id != -1 and not na(curr_15m_high) and show15mLevels
                            // 1. Get History (if any)
                            BucketHistory bh = last_bucket_id < 20 ? array.get(bucket_stats, last_bucket_id) : na
                            [h_arr, l_arr] = f_get_15m_stats(bh, displayStatsMode)
                            
                            // Fix for Tuple Ternary Error (Combined Stats)
                            float[] h_comb = na
                            float[] l_comb = na
                            if displayStatsMode == "Combined"
                                h_comb := h_arr
                                l_comb := l_arr
                            else
                                [hc, lc] = f_get_15m_stats(bh, "Combined")
                                h_comb := hc
                                l_comb := lc
                            
                            // Get Calculation Source Data (Active or Combined)
                            float[] h_calc = calcSource == "Combined" ? h_comb : h_arr
                            float[] l_calc = calcSource == "Combined" ? l_comb : l_arr

                            int hist_cnt = array.size(h_arr)
                            
                            // Define References based on Input
                            float ref_h = calcRef == "Opening Range" ? active_or_high : ref_close_0931
                            float ref_l = calcRef == "Opening Range" ? active_or_low : ref_close_0931

                            // 2. Draw Historical Level (if data exists)
                            if hist_cnt > 0 and not na(ref_h) and not na(ref_l)
                                // Calculate Level from Source Data (h_calc)
                                float avg_h_pct = calc15mMode == "Average" ? array.avg(h_calc) : calc15mMode == "Median" ? array.median(h_calc) : array.percentile_linear_interpolation(h_calc, calcPercentile)
                                float avg_l_pct = calc15mMode == "Average" ? array.avg(l_calc) : calc15mMode == "Median" ? array.median(l_calc) : array.percentile_linear_interpolation(l_calc, calcPercentile)
                                
                                // Calculate Hit Stats (Active Mode)
                                [tot_h, hits_h] = f_calc_stats(h_arr, avg_h_pct)
                                [tot_l, hits_l] = f_calc_stats(l_arr, avg_l_pct)
                                float pct_h = tot_h > 0 ? hits_h * 100.0 / tot_h : 0.0
                                float pct_l = tot_l > 0 ? hits_l * 100.0 / tot_l : 0.0
                                
                                float plot_h = ref_h * (1 + avg_h_pct)
                                float plot_l = ref_l * (1 - avg_l_pct)
                                
                                // Filter Drawing based on Mode
                                bool draw_h = displayStatsMode == "Combined" or displayStatsMode == "Bullish Days"
                                bool draw_l = displayStatsMode == "Combined" or displayStatsMode == "Bearish Days"
                                
                                if draw_h
                                    line.new(curr_15m_start_time, plot_h, ltf_time, plot_h, xloc=xloc.bar_time, color=color15mBorder)
                                if draw_l
                                    line.new(curr_15m_start_time, plot_l, ltf_time, plot_l, xloc=xloc.bar_time, color=color15mBorder)
                                
                                if show15mTooltips
                                    string tt = str.format("15m {0} ({1})\nHigh: {2} sess, {3} hits ({4,number,#.##}%)\nLow: {5} sess, {6} hits ({7,number,#.##}%)", calc15mMode, displayStatsMode, tot_h, hits_h, pct_h, tot_l, hits_l, pct_l)
                                    
                                    // Append Combined Stats if separate
                                    if displayStatsMode != "Combined"
                                        [tot_h_c, hits_h_c] = f_calc_stats(h_comb, avg_h_pct)
                                        [tot_l_c, hits_l_c] = f_calc_stats(l_comb, avg_l_pct)
                                        float pct_h_c = tot_h_c > 0 ? hits_h_c * 100.0 / tot_h_c : 0.0
                                        float pct_l_c = tot_l_c > 0 ? hits_l_c * 100.0 / tot_l_c : 0.0
                                        tt := tt + str.format("\n\nCombined:\nHigh: {0} sess, {1} hits ({2,number,#.##}%)\nLow: {3} sess, {4} hits ({5,number,#.##}%)", tot_h_c, hits_h_c, pct_h_c, tot_l_c, hits_l_c, pct_l_c)
                                        
                                    if draw_h
                                        label.new(ltf_time, plot_h, "●", xloc=xloc.bar_time, style=label.style_none, textcolor=color15mBorder, size=size.tiny, tooltip=tt)
                                    if draw_l
                                        label.new(ltf_time, plot_l, "●", xloc=xloc.bar_time, style=label.style_none, textcolor=color15mBorder, size=size.tiny, tooltip=tt)
                            
                            // 3. Update Stats (Buffer for End of Day) -> Store as PERCENTAGE
                            if last_bucket_id < 20 and not na(ref_h) and not na(ref_l)
                                float curr_h_pct = (curr_15m_high - ref_h) / ref_h
                                float curr_l_pct = (ref_l - curr_15m_low) / ref_l
                                array.set(today_15m_highs, last_bucket_id, curr_h_pct)
                                array.set(today_15m_lows, last_bucket_id, curr_l_pct)
                        
                        // Start new bucket
                        curr_15m_high := ltf_high
                        curr_15m_low := ltf_low
                        curr_15m_start_time := ltf_time
                        last_bucket_id := bucket_id
                    else
                        // Update current bucket
                        curr_15m_high := math.max(curr_15m_high, ltf_high)
                        curr_15m_low := math.min(curr_15m_low, ltf_low)


// --- Commit BOTH directions at cutoff time ---
is_at_or_after_cutoff = (hour(time, "America/New_York") * 100 + minute(time, "America/New_York")) >= cutoffTime

if is_at_or_after_cutoff and not is_committed_today and not is_new_day and not na(bull_ref)
    // Commit BOTH bull and bear MFE if they have values (for time histogram)
    if daily_max_bull_mfe > 0
        array.push(mfe_bull_history, daily_max_bull_mfe)
        array.push(peak_time_bull_history, daily_bull_peak_time)
        if showDebugLabels
            label.new(bar_index, high, "▲COMMIT " + str.tostring(daily_max_bull_mfe, "#.##") + "%", color=color.new(color.lime, 30), textcolor=color.white, style=label.style_label_down, size=size.tiny)
    
    if daily_max_bear_mfe > 0
        array.push(mfe_bear_history, daily_max_bear_mfe)
        array.push(peak_time_bear_history, daily_bear_peak_time)
        if showDebugLabels
            label.new(bar_index, low, "▼COMMIT " + str.tostring(daily_max_bear_mfe, "#.##") + "%", color=color.new(color.maroon, 30), textcolor=color.white, style=label.style_label_up, size=size.tiny)
    
    // --- Commit PIVOTS based on day direction (for price histogram) ---
    // LONG day (MFE > MAE): commit all bull pivots
    // SHORT day (MAE > MFE): commit all bear pivots
    bool is_long_day = daily_max_bull_mfe > daily_max_bear_mfe
    
    if is_long_day
        if array.size(daily_pivot_bulls) > 0
            for i = 0 to array.size(daily_pivot_bulls) - 1
                array.push(pivot_bull_history, array.get(daily_pivot_bulls, i))
        if showDebugLabels
            label.new(bar_index, high + syminfo.mintick * 50, "LONG DAY: " + str.tostring(array.size(daily_pivot_bulls)) + " pivots", color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_down, size=size.tiny)
    else
        if array.size(daily_pivot_bears) > 0
            for i = 0 to array.size(daily_pivot_bears) - 1
                array.push(pivot_bear_history, array.get(daily_pivot_bears, i))
        if showDebugLabels
            label.new(bar_index, low - syminfo.mintick * 50, "SHORT DAY: " + str.tostring(array.size(daily_pivot_bears)) + " pivots", color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_up, size=size.tiny)
    
    // --- Force Close Last 15m Bucket at Cutoff ---
    if not na(curr_15m_high) and show15mLevels
        // 1. Get History (if any)
        BucketHistory bh = last_bucket_id < 20 ? array.get(bucket_stats, last_bucket_id) : na
        [h_arr, l_arr] = f_get_15m_stats(bh, displayStatsMode)
        
        // Fix for Tuple Ternary Error (Combined Stats)
        float[] h_comb = na
        float[] l_comb = na
        if displayStatsMode == "Combined"
            h_comb := h_arr
            l_comb := l_arr
        else
            [hc, lc] = f_get_15m_stats(bh, "Combined")
            h_comb := hc
            l_comb := lc
        
        // Get Calculation Source Data (Active or Combined)
        float[] h_calc = calcSource == "Combined" ? h_comb : h_arr
        float[] l_calc = calcSource == "Combined" ? l_comb : l_arr

        int hist_cnt = array.size(h_arr)
        
        // Define References based on Input
        float ref_h = calcRef == "Opening Range" ? active_or_high : ref_close_0931
        float ref_l = calcRef == "Opening Range" ? active_or_low : ref_close_0931

        // 2. Draw Historical Level (if data exists)
        if hist_cnt > 0 and not na(ref_h) and not na(ref_l)
            // Calculate Level from Source Data (h_calc)
            float avg_h_pct = calc15mMode == "Average" ? array.avg(h_calc) : calc15mMode == "Median" ? array.median(h_calc) : array.percentile_linear_interpolation(h_calc, calcPercentile)
            float avg_l_pct = calc15mMode == "Average" ? array.avg(l_calc) : calc15mMode == "Median" ? array.median(l_calc) : array.percentile_linear_interpolation(l_calc, calcPercentile)
            
            // Calculate Hit Stats (Active Mode)
            [tot_h, hits_h] = f_calc_stats(h_arr, avg_h_pct)
            [tot_l, hits_l] = f_calc_stats(l_arr, avg_l_pct)
            float pct_h = tot_h > 0 ? hits_h * 100.0 / tot_h : 0.0
            float pct_l = tot_l > 0 ? hits_l * 100.0 / tot_l : 0.0
            
            float plot_h = ref_h * (1 + avg_h_pct)
            float plot_l = ref_l * (1 - avg_l_pct)
            
            // Filter Drawing based on Mode
            bool draw_h = displayStatsMode == "Combined" or displayStatsMode == "Bullish Days"
            bool draw_l = displayStatsMode == "Combined" or displayStatsMode == "Bearish Days"
            
            if draw_h
                line.new(curr_15m_start_time, plot_h, time, plot_h, xloc=xloc.bar_time, color=color15mBorder)
            if draw_l
                line.new(curr_15m_start_time, plot_l, time, plot_l, xloc=xloc.bar_time, color=color15mBorder)
            
            if show15mTooltips
                string tt = str.format("15m {0} ({1})\nHigh: {2} sess, {3} hits ({4,number,#.##}%)\nLow: {5} sess, {6} hits ({7,number,#.##}%)", calc15mMode, displayStatsMode, tot_h, hits_h, pct_h, tot_l, hits_l, pct_l)
                
                // Append Combined Stats if separate
                if displayStatsMode != "Combined"
                    [tot_h_c, hits_h_c] = f_calc_stats(h_comb, avg_h_pct)
                    [tot_l_c, hits_l_c] = f_calc_stats(l_comb, avg_l_pct)
                    float pct_h_c = tot_h_c > 0 ? hits_h_c * 100.0 / tot_h_c : 0.0
                    float pct_l_c = tot_l_c > 0 ? hits_l_c * 100.0 / tot_l_c : 0.0
                    tt := tt + str.format("\n\nCombined:\nHigh: {0} sess, {1} hits ({2,number,#.##}%)\nLow: {3} sess, {4} hits ({5,number,#.##}%)", tot_h_c, hits_h_c, pct_h_c, tot_l_c, hits_l_c, pct_l_c)
                    
                if draw_h
                    label.new(time, plot_h, "●", xloc=xloc.bar_time, style=label.style_none, textcolor=color15mBorder, size=size.tiny, tooltip=tt)
                if draw_l
                    label.new(time, plot_l, "●", xloc=xloc.bar_time, style=label.style_none, textcolor=color15mBorder, size=size.tiny, tooltip=tt)
        
        // 3. Update Stats (Buffer for End of Day) -> Store as PERCENTAGE
        if last_bucket_id < 20 and not na(ref_h) and not na(ref_l)
            float curr_h_pct = (curr_15m_high - ref_h) / ref_h
            float curr_l_pct = (ref_l - curr_15m_low) / ref_l
            array.set(today_15m_highs, last_bucket_id, curr_h_pct)
            array.set(today_15m_lows, last_bucket_id, curr_l_pct)
    
    // --- Commit 15m Buffers to Directional History ---
    if is_long_day
        for i = 0 to 19
            if not na(array.get(today_15m_highs, i))
                BucketHistory bh_c = array.get(bucket_stats, i)
                array.push(bh_c.bull_highs, array.get(today_15m_highs, i))
                array.push(bh_c.bull_lows, array.get(today_15m_lows, i))
    else
        for i = 0 to 19
            if not na(array.get(today_15m_highs, i))
                BucketHistory bh_c = array.get(bucket_stats, i)
                array.push(bh_c.bear_highs, array.get(today_15m_highs, i))
                array.push(bh_c.bear_lows, array.get(today_15m_lows, i))
    
    is_committed_today := true

// --- Debug: Dump MFE history and Bucket Stats on last bar ---
if barstate.islast and showDebugLabels
    int total_bull = array.size(mfe_bull_history)
    int total_bear = array.size(mfe_bear_history)
    
    log.info("=== MFE HISTORY DUMP ===")
    log.info("Total Bull Days: {0}, Total Bear Days: {1}", total_bull, total_bear)
    
    // Debug Bucket 0 (09:30-09:45)
    BucketHistory b0 = array.get(bucket_stats, 0)
    if not na(b0)
        float avg_bull_h = array.size(b0.bull_highs) > 0 ? array.avg(b0.bull_highs) : na
        float avg_bear_l = array.size(b0.bear_lows) > 0 ? array.avg(b0.bear_lows) : na
        label.new(bar_index, high, str.format("B0 Stats:\nBull High Avg: {0,number,#.####}\nBear Low Avg: {1,number,#.####}\nBull Count: {2}\nBear Count: {3}", avg_bull_h, avg_bear_l, array.size(b0.bull_highs), array.size(b0.bear_lows)), color=color.black, textcolor=color.white)
    
    // Dump bull MFE values
    if total_bull > 0
        string bull_vals = ""
        for i = 0 to total_bull - 1
            bull_vals := bull_vals + str.tostring(array.get(mfe_bull_history, i), "#.###") + ", "
        log.info("Bull MFE: [{0}]", bull_vals)
        
        // Percentile values
        log.info("Bull P20={0}, P50={1}, P80={2}", 
            array.percentile_linear_interpolation(mfe_bull_history, 20),
            array.percentile_linear_interpolation(mfe_bull_history, 50),
            array.percentile_linear_interpolation(mfe_bull_history, 80))
    
    // Dump bear MFE values
    if total_bear > 0
        string bear_vals = ""
        for i = 0 to total_bear - 1
            bear_vals := bear_vals + str.tostring(array.get(mfe_bear_history, i), "#.###") + ", "
        log.info("Bear MFE: [{0}]", bear_vals)
        
        log.info("Bear P20={0}, P50={1}, P80={2}", 
            array.percentile_linear_interpolation(mfe_bear_history, 20),
            array.percentile_linear_interpolation(mfe_bear_history, 50),
            array.percentile_linear_interpolation(mfe_bear_history, 80))
    
    log.info("09:31 Ref Close: {0}", ref_close_0931)
    log.info("=== END DUMP ===")

// ==========================================
// --- VISUALIZATION: MFE FREQUENCY HISTOGRAMS ---
// ==========================================
var box[] mfe_hist_boxes = array.new_box(0)
var line[] mfe_avg_lines = array.new_line(0)
var label[] mfe_avg_labels = array.new_label(0)

// Clear previous day's drawings on new day
if is_new_day
    if array.size(mfe_hist_boxes) > 0
        for i = 0 to array.size(mfe_hist_boxes) - 1
            box.delete(array.get(mfe_hist_boxes, i))
    if array.size(mfe_avg_lines) > 0
        for i = 0 to array.size(mfe_avg_lines) - 1
            line.delete(array.get(mfe_avg_lines, i))
    if array.size(mfe_avg_labels) > 0
        for i = 0 to array.size(mfe_avg_labels) - 1
            label.delete(array.get(mfe_avg_labels, i))
    array.clear(mfe_hist_boxes)
    array.clear(mfe_avg_lines)
    array.clear(mfe_avg_labels)

// Draw levels when OR is established (works on all timeframes)
// Since histogram uses HISTORICAL data only, draw on last bar for reliable display
if barstate.islast and or_set_today and not na(bull_ref) and not na(or_bar_index)
    int anchor = or_bar_index  // Anchor histogram to 09:30 bar position
    
    // --- 1. MFE PRICE DISTRIBUTION (PIVOT-BASED, FIXED BINS) ---
    // Uses pivot highs/lows filtered by day direction (MFE > MAE)
    // Fixed bins based on binSize input (e.g., 0.04%)
    
    int total_pivot_bull = array.size(pivot_bull_history)
    int total_pivot_bear = array.size(pivot_bear_history)
    bool has_pivot_data = total_pivot_bull > 0 or total_pivot_bear > 0
    
    if has_pivot_data
        // Data Count Label
        array.push(mfe_avg_labels, label.new(anchor, active_or_low - (syminfo.mintick * offsetBelowMFE / 2), "Pivots: " + str.tostring(total_pivot_bull) + " Bull / " + str.tostring(total_pivot_bear) + " Bear", textcolor=color.new(color.white, 30), style=label.style_label_up, size=mfe_data_size, color=color.new(color.black, 100)))
        
        // Create fixed bins from 0% to max MFE
        // Increased cap to 5.0% to capture large volatility days
        float max_mfe = 5.0  
        int num_bins = int(max_mfe / binSize) + 1
        int[] bull_bin_counts = array.new_int(num_bins, 0)
        int[] bear_bin_counts = array.new_int(num_bins, 0)
        
        // Count pivots in each fixed bin
        if total_pivot_bull > 0
            for j = 0 to total_pivot_bull - 1
                float val = array.get(pivot_bull_history, j)
                int bin_idx = int(val / binSize)
                if bin_idx >= 0 and bin_idx < num_bins
                    array.set(bull_bin_counts, bin_idx, array.get(bull_bin_counts, bin_idx) + 1)
        
        if total_pivot_bear > 0
            for j = 0 to total_pivot_bear - 1
                float val = array.get(pivot_bear_history, j)
                int bin_idx = int(val / binSize)
                if bin_idx >= 0 and bin_idx < num_bins
                    array.set(bear_bin_counts, bin_idx, array.get(bear_bin_counts, bin_idx) + 1)
        
        // Find max count for normalization
        int max_count = 1
        for i = 0 to num_bins - 1
            if array.get(bull_bin_counts, i) > max_count
                max_count := array.get(bull_bin_counts, i)
            if array.get(bear_bin_counts, i) > max_count
                max_count := array.get(bear_bin_counts, i)
        
        // Calculate percentile-based MFE range for filtering
        float bull_pct_low = total_pivot_bull > 0 ? array.percentile_linear_interpolation(pivot_bull_history, startPercentile) : 0.0
        float bull_pct_high = total_pivot_bull > 0 ? array.percentile_linear_interpolation(pivot_bull_history, endPercentile) : 1.0
        float bear_pct_low = total_pivot_bear > 0 ? array.percentile_linear_interpolation(pivot_bear_history, startPercentile) : 0.0
        float bear_pct_high = total_pivot_bear > 0 ? array.percentile_linear_interpolation(pivot_bear_history, endPercentile) : 1.0
        
        // DEBUG: Check Min Pivot
        if showDebugLabels
            if total_pivot_bear > 0
                float min_bear = array.min(pivot_bear_history)
                label.new(anchor, active_or_low, "MinBear: " + str.tostring(min_bear, "#.####") + "\nPctLow: " + str.tostring(bear_pct_low, "#.####"), color=color.black, textcolor=color.white, style=label.style_label_up)
            if total_pivot_bull > 0
                float min_bull = array.min(pivot_bull_history)
                label.new(anchor, active_or_high, "MinBull: " + str.tostring(min_bull, "#.####") + "\nPctLow: " + str.tostring(bull_pct_low, "#.####"), color=color.black, textcolor=color.white, style=label.style_label_down)

        // Draw histogram bars with fixed bins (filtered by percentile range)
        // Use bull_ref as starting point for bull histogram, bear_ref for bear histogram
        for i = 0 to num_bins - 1
            float bin_low = i * binSize
            float bin_high = (i + 1) * binSize
            
            // Bull bars (above OR high) - only draw if within percentile range (OVERLAP check)
            int bull_count = array.get(bull_bin_counts, i)
            if bull_count > 0 and bin_high > bull_pct_low and bin_low < bull_pct_high
                float p_top = active_or_high + (ref_close_0931 * bin_high / 100)
                float p_bot = active_or_high + (ref_close_0931 * bin_low / 100)
                float norm_width = bull_count / max_count
                int w = int(norm_width * histWidthScale)
                if w > 0
                    array.push(mfe_hist_boxes, box.new(anchor, p_top, anchor + w, p_bot, border_color=bullEdgeColor, bgcolor=bullCenterColor))
            
            // Bear bars (below OR low) - only draw if within percentile range (OVERLAP check)
            int bear_count = array.get(bear_bin_counts, i)
            if bear_count > 0 and bin_high > bear_pct_low and bin_low < bear_pct_high
                float p_top = active_or_low - (ref_close_0931 * bin_low / 100)
                float p_bot = active_or_low - (ref_close_0931 * bin_high / 100)
                float norm_width = bear_count / max_count
                int w = int(norm_width * histWidthScale)
                if w > 0
                    array.push(mfe_hist_boxes, box.new(anchor, p_top, anchor + w, p_bot, border_color=bearEdgeColor, bgcolor=bearCenterColor))


    
    // Keep using daily MAX MFE for statistical lines
    bool has_data = array.size(mfe_bull_history) > 0 or array.size(mfe_bear_history) > 0

    // --- 2. STATISTICAL LINES ---
    if has_data
        // AVG Lines (using FULL dataset, not filtered)
        float avg_bull = array.avg(mfe_bull_history)
        float avg_bear = array.avg(mfe_bear_history)
        float p_avg_bull = bull_ref + (ref_close_0931 * avg_bull / 100)
        float p_avg_bear = bear_ref - (ref_close_0931 * avg_bear / 100)
        
        if showAvgLine
            array.push(mfe_avg_lines, line.new(anchor, p_avg_bull, anchor + 150, p_avg_bull, color=avgLineColor, style=line.style_dashed, width=1))
            array.push(mfe_avg_labels, label.new(anchor + 155, p_avg_bull, str.tostring(avg_bull, "#.##") + "% AVG", color=color.new(color.black, 100), textcolor=avgLineColor, style=label.style_label_left, size=mfe_size))
            
            array.push(mfe_avg_lines, line.new(anchor, p_avg_bear, anchor + 150, p_avg_bear, color=avgLineColor, style=line.style_dashed, width=1))
            array.push(mfe_avg_labels, label.new(anchor + 155, p_avg_bear, str.tostring(avg_bear, "#.##") + "% AVG", color=color.new(color.black, 100), textcolor=avgLineColor, style=label.style_label_left, size=mfe_size))

        // Dynamic Percentile Lines
        if showPercentLabels
            // Calculate how many percentile levels to show
            int num_levels = int((endPercentile - startPercentile) / percentileStep) + 1
            
            for i = 0 to num_levels - 1
                int pct = startPercentile + (i * percentileStep)
                if pct <= endPercentile
                    // Use FULL dataset for percentile calculations, not filtered
                    float pct_bull = array.percentile_linear_interpolation(mfe_bull_history, pct)
                    float pct_bear = array.percentile_linear_interpolation(mfe_bear_history, pct)
                    
                    float p_pct_bull = bull_ref + (ref_close_0931 * pct_bull / 100)
                    float p_pct_bear = bear_ref - (ref_close_0931 * pct_bear / 100)
                    
                    // Determine line style and length based on percentile
                    bool is_median = pct == 50
                    bool is_quartile = pct == 25 or pct == 75
                    int line_length = is_median ? 120 : is_quartile ? 100 : 80
                    string line_style_str = is_median ? line.style_solid : line.style_dotted
                    int transparency = is_median ? 30 : is_quartile ? 50 : 70
                    
                    // Draw bull percentile
                    array.push(mfe_avg_lines, line.new(anchor, p_pct_bull, anchor + line_length, p_pct_bull, color=color.new(avgLineColor, transparency), style=line_style_str))
                    array.push(mfe_avg_labels, label.new(anchor + line_length + 5, p_pct_bull, str.tostring(pct_bull, "#.##") + "% P" + str.tostring(pct), color=color.new(color.black, 100), textcolor=color.new(avgLineColor, transparency), style=label.style_label_left, size=mfe_size))
                    
                    // Draw bear percentile
                    array.push(mfe_avg_lines, line.new(anchor, p_pct_bear, anchor + line_length, p_pct_bear, color=color.new(avgLineColor, transparency), style=line_style_str))
                    array.push(mfe_avg_labels, label.new(anchor + line_length + 5, p_pct_bear, str.tostring(pct_bear, "#.##") + "% P" + str.tostring(pct), color=color.new(color.black, 100), textcolor=color.new(avgLineColor, transparency), style=label.style_label_left, size=mfe_size))

// ==========================================
// --- VISUALIZATION: TIME DISTRIBUTION (ANCHORED) ---
// ==========================================
var box[] time_hist_boxes = array.new_box(0)
var line[] time_stat_lines = array.new_line(0)
var label[] time_stat_labels = array.new_label(0)

// Clear previous day's time distribution on new day
if is_new_day
    if array.size(time_hist_boxes) > 0
        for i = 0 to array.size(time_hist_boxes) - 1
            box.delete(array.get(time_hist_boxes, i))
    if array.size(time_stat_lines) > 0
        for i = 0 to array.size(time_stat_lines) - 1
            line.delete(array.get(time_stat_lines, i))
    if array.size(time_stat_labels) > 0
        for i = 0 to array.size(time_stat_labels) - 1
            label.delete(array.get(time_stat_labels, i))
    array.clear(time_hist_boxes)
    array.clear(time_stat_lines)
    array.clear(time_stat_labels)

// Draw time distribution when OR is established (works on all timeframes)
if barstate.islast and or_set_today and showTimeDist and not na(or_bar_index)
    int t_anchor = or_bar_index  // Anchor to 09:30 bar position
    // Use active_or_low if available, otherwise use current low
    float base_y = not na(active_or_low) ? active_or_low - (syminfo.mintick * offsetBelowMFE) : low - (syminfo.mintick * offsetBelowMFE)
    
    // Draw vertical bins (Mirrored) - using 5-minute buckets
    // Bins start at minute 1 (not 0) since minute 0 is the OR candle itself
    // 31 bins cover minutes 1-155 (09:31 to 12:05) to include edge cases at cutoff
    for i = 0 to 30  // 31 bins: 1-5, 6-10, ... 151-155
        int bin_start = 1 + (i * 5)  // Start at minute 1, not minute 0
        int bin_end = bin_start + 5
        int c_bull = 0, c_bear = 0
        
        // Count bull peaks in this bin (separate loop since array sizes differ)
        if array.size(peak_time_bull_history) > 0
            for j = 0 to array.size(peak_time_bull_history) - 1
                int peak_bull = array.get(peak_time_bull_history, j)
                if peak_bull >= bin_start and peak_bull < bin_end
                    c_bull += 1
        
        // Count bear peaks in this bin (separate loop)
        if array.size(peak_time_bear_history) > 0
            for j = 0 to array.size(peak_time_bear_history) - 1
                int peak_bear = array.get(peak_time_bear_history, j)
                if peak_bear >= bin_start and peak_bear < bin_end
                    c_bear += 1
        
        float h_u = c_bull * 5.0
        float h_d = c_bear * 5.0
        
        if c_bull > 0
            array.push(time_hist_boxes, box.new(t_anchor + i*5, base_y + h_u, t_anchor + i*5 + 4, base_y, border_color=na, bgcolor=timeBullColor))
        if c_bear > 0
            array.push(time_hist_boxes, box.new(t_anchor + i*5, base_y, t_anchor + i*5 + 4, base_y - h_d, border_color=na, bgcolor=timeBearColor))
    // Vertical Statistical Lines (TIME)
    bool has_time_data = array.size(peak_time_bull_history) > 0
    
    if has_time_data
        // Bullish Stats
        float avg_t_bull = array.avg(peak_time_bull_history)
        float med_t_bull = array.median(peak_time_bull_history)
        int x_avg_bull = t_anchor + int(avg_t_bull)
        int x_med_bull = t_anchor + int(med_t_bull)
        
        if showTimeAvg
            array.push(time_stat_lines, line.new(x_avg_bull, base_y + 60, x_avg_bull, base_y, color=timeAvgLineColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_avg_bull, base_y + 65, "Bull AVG", color=color.new(color.black, 100), textcolor=timeAvgLineColor, style=label.style_label_down, size=time_size))
        
        if showTimeMed
            array.push(time_stat_lines, line.new(x_med_bull, base_y + 40, x_med_bull, base_y, color=timeMedLineColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_med_bull, base_y + 45, "Bull MED", color=color.new(color.black, 100), textcolor=timeMedLineColor, style=label.style_label_down, size=time_size))

        // Bearish Stats
        float avg_t_bear = array.avg(peak_time_bear_history)
        float med_t_bear = array.median(peak_time_bear_history)
        int x_avg_bear = t_anchor + int(avg_t_bear)
        int x_med_bear = t_anchor + int(med_t_bear)
        
        if showTimeAvg
            array.push(time_stat_lines, line.new(x_avg_bear, base_y, x_avg_bear, base_y - 60, color=timeAvgLineColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_avg_bear, base_y - 65, "Bear AVG", color=color.new(color.black, 100), textcolor=timeAvgLineColor, style=label.style_label_up, size=time_size))
        
        if showTimeMed
            array.push(time_stat_lines, line.new(x_med_bear, base_y, x_med_bear, base_y - 40, color=timeMedLineColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_med_bear, base_y - 45, "Bear MED", color=color.new(color.black, 100), textcolor=timeMedLineColor, style=label.style_label_up, size=time_size))

