//@version=6
indicator("Daily NY Levels v4.1", overlay=true, max_bars_back=5000, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ════════════════════════════════════════════════════════════════════════════
// MODULE 1: INPUTS
// ════════════════════════════════════════════════════════════════════════════

grp_session = "Session & Range"
i_rangeStart   = input.string("0930", "Range Start (HHMM)", tooltip="Start of the Opening Range window", group=grp_session)
i_rangeEnd     = input.string("0931", "Range End (HHMM)", tooltip="End of the Opening Range window. All bars between start and end define the OR high/low.", group=grp_session)
i_cutoff       = input.string("1200", "Cutoff (HHMM)", tooltip="Stop tracking MFE and commit data at this time.", group=grp_session)
i_timezone     = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "America/Denver", "US/Eastern", "US/Central", "UTC"], group=grp_session)
// NOTE: Bull/Bear reference is always OR High/Low — no input needed.

grp_style = "Style"
i_bullColor    = input.color(color.green, "Bullish Color", group=grp_style)
i_bearColor    = input.color(color.red, "Bearish Color", group=grp_style)
i_orBoxColor   = input.color(color.yellow, "OR Box Color", group=grp_style)
i_orBoxStyle   = input.string("Solid", "OR Box Style", options=["Solid", "Dashed", "Dotted"], group=grp_style)
i_orBoxWidth   = input.int(1, "OR Box Width", minval=1, maxval=5, group=grp_style)

grp_mfe = "MFE Distribution Profile"
i_showMFE        = input.bool(true, "Show MFE Distribution", group=grp_mfe)
i_pctStep        = input.int(2, "Percentile Step", minval=1, maxval=10, group=grp_mfe)
i_startPct       = input.int(20, "Start Percentile", minval=1, maxval=99, group=grp_mfe)
i_endPct         = input.int(80, "End Percentile", minval=1, maxval=99, group=grp_mfe)
i_showPctLabels  = input.bool(false, "Show Percentile Labels", group=grp_mfe)
i_showAvgLine    = input.bool(true, "Show AVG Line", group=grp_mfe)
i_avgLineColor   = input.color(color.orange, "AVG Line Color", group=grp_mfe)
i_showMedLine    = input.bool(true, "Show Median Line", group=grp_mfe)
i_medLineColor   = input.color(color.aqua, "Median Line Color", group=grp_mfe)
i_histWidthScale = input.int(50, "Histogram Width Scale", minval=1, maxval=500, group=grp_mfe)
i_mfeLabelSize   = input.string("tiny", "Label Size", options=["auto", "tiny", "small", "normal", "large", "huge"], group=grp_mfe)
i_mfeDataLblSize = input.string("small", "Data Count Label Size", options=["auto", "tiny", "small", "normal", "large", "huge"], group=grp_mfe)
i_levelDisplay   = input.string("Both", "Level Display Mode", options=["Both", "Bull Only", "Bear Only"], group=grp_mfe)

grp_time = "Hit Time Distribution"
i_showTimeDist   = input.bool(true, "Show Time Distribution", group=grp_time)
i_timeBucketMins = input.int(5, "Time Bucket (minutes)", minval=1, maxval=60, group=grp_time)
i_offsetBelowMFE = input.int(200, "Offset Below MFE (ticks)", group=grp_time)
i_showTimeAvg    = input.bool(true, "Show AVG Line", group=grp_time)
i_showTimeMed    = input.bool(true, "Show Median Line", group=grp_time)
i_timeAvgColor   = input.color(color.yellow, "AVG Line Color", group=grp_time)
i_timeMedColor   = input.color(color.aqua, "Median Line Color", group=grp_time)
i_timeBullColor  = input.color(color.new(color.green, 50), "Time Bull Color", group=grp_time)
i_timeBearColor  = input.color(color.new(color.red, 50), "Time Bear Color", group=grp_time)
i_timeLabelSize  = input.string("tiny", "Label Size", options=["auto", "tiny", "small", "normal", "large", "huge"], group=grp_time)

grp_sep = "Day Separators"
i_showSep        = input.bool(true, "Show Day Separators", group=grp_sep)
i_sepColor       = input.color(color.new(color.gray, 70), "Color", group=grp_sep)
i_sepStyleStr    = input.string("Dotted", "Style", options=["Dashed", "Dotted", "Solid"], group=grp_sep)
i_sepWidth       = input.int(1, "Width", minval=1, maxval=5, group=grp_sep)
i_showDayLabel   = input.bool(true, "Show Day Labels", group=grp_sep)
i_dayLabelColor  = input.color(color.new(color.gray, 30), "Label Color", group=grp_sep)

grp_info = "Info Box"
i_showInfoBox    = input.bool(true, "Show Info Box", group=grp_info)
i_infoAuthor     = input.string("Vinay", "Author", group=grp_info)
i_infoPos        = input.string("Top Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grp_info)
i_infoTextSize   = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_info)
i_infoBg         = input.color(color.new(color.gray, 80), "Background", group=grp_info)
i_infoTextClr    = input.color(color.silver, "Text", group=grp_info)
i_infoBorderClr  = input.color(color.new(color.gray, 50), "Border", group=grp_info)

grp_debug = "Debug"
i_showDebug      = input.bool(false, "Show Debug Labels", group=grp_debug)

grp_data = "Data Table"
i_showDataTable  = input.bool(true, "Show Data Table", group=grp_data)
i_dataTablePos   = input.string("Bottom Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grp_data)
i_dataTableSize  = input.string("Small", "Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_data)
i_dataStatsMode  = input.string("Overall", "Stats Mode", options=["Overall", "Both", "Bull Only", "Bear Only"], tooltip="Overall: max(bull,bear) per session. Both: bull and bear tables stacked. Bull/Bear: direction-specific.", group=grp_data)
i_dataRangeStart = input.int(10, "Range Start (%)", minval=1, maxval=99, group=grp_data)
i_dataRangeEnd   = input.int(50, "Range End (%)", minval=1, maxval=99, group=grp_data)
i_dataStep       = input.int(5, "Step", minval=1, maxval=20, group=grp_data)
i_dataHeaderClr  = input.color(color.new(color.gray, 50), "Header Color", group=grp_data)
i_dataOverallClr = input.color(color.orange, "Overall Color", group=grp_data)
i_dataBullClr    = input.color(color.green, "Bull Color", group=grp_data)
i_dataBearClr    = input.color(color.red, "Bear Color", group=grp_data)
i_dataBgClr      = input.color(color.new(color.gray, 85), "Background", group=grp_data)
i_dataBorderClr  = input.color(color.new(color.gray, 70), "Border", group=grp_data)


// ════════════════════════════════════════════════════════════════════════════
// MODULE 2: UTILITY FUNCTIONS
// ════════════════════════════════════════════════════════════════════════════

f_size(string s) =>
    switch s
        "auto"   => size.auto
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.normal

f_line_style(string s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

f_table_pos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_text_size(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge"  => size.huge
        => size.normal

f_day_full(int dow) =>
    switch dow
        1 => "SUNDAY"
        2 => "MONDAY"
        3 => "TUESDAY"
        4 => "WEDNESDAY"
        5 => "THURSDAY"
        6 => "FRIDAY"
        7 => "SATURDAY"
        => ""

f_tf_display() =>
    if timeframe.isseconds
        str.tostring(timeframe.multiplier) + "s"
    else if timeframe.isminutes
        str.tostring(timeframe.multiplier) + "m"
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier) + "M"
    else
        timeframe.period

f_mins_of_day(int t) =>
    hour(t, i_timezone) * 60 + minute(t, i_timezone)

// Parse "HHMM" string to minutes since midnight
f_parse_hhmm(string hhmm) =>
    int(str.tonumber(str.substring(hhmm, 0, 2))) * 60 + int(str.tonumber(str.substring(hhmm, 2, 4)))

// Check if minute-of-day falls within a range (handles cross-midnight)
f_in_range(int mins, int range_start, int range_end) =>
    if range_end > range_start
        mins >= range_start and mins < range_end
    else if range_end < range_start
        mins >= range_start or mins < range_end
    else
        false

// Duration in minutes (handles cross-midnight)
f_duration(int range_start, int range_end) =>
    if range_end > range_start
        range_end - range_start
    else if range_end < range_start
        (1440 - range_start) + range_end
    else
        0

// Minutes since a start time (handles cross-midnight)
f_mins_since(int mins, int start) =>
    if mins >= start
        mins - start
    else
        (1440 - start) + mins

// Precompute time boundaries
int RANGE_START = f_parse_hhmm(i_rangeStart)
int RANGE_END   = f_parse_hhmm(i_rangeEnd)
int CUTOFF      = f_parse_hhmm(i_cutoff)
int DATA_DURATION = f_duration(RANGE_START, CUTOFF)

f_clear_boxes(array<box> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box.delete(array.get(arr, i))
    array.clear(arr)

f_clear_lines(array<line> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
    array.clear(arr)

f_clear_labels(array<label> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
    array.clear(arr)

f_build_filtered(array<float> src) =>
    array<float> out = array.new_float(0)
    if array.size(src) > 0
        for i = 0 to array.size(src) - 1
            float v = array.get(src, i)
            if v > 0
                array.push(out, v)
    out


// ════════════════════════════════════════════════════════════════════════════
// MODULE 3: SESSION DETECTION (cross-midnight safe)
// ════════════════════════════════════════════════════════════════════════════

int bar_mins = f_mins_of_day(time)

bool in_or_range     = f_in_range(bar_mins, RANGE_START, RANGE_END)
bool in_data_session = f_in_range(bar_mins, RANGE_END, CUTOFF)

// New "day" = OR range starts
var bool prev_in_or = false
bool is_new_day = in_or_range and not prev_in_or
prev_in_or := in_or_range

// Calendar day change for separators
int nyDOW      = dayofweek(time, "America/New_York")
int nyDOW_prev = dayofweek(time[1], "America/New_York")
bool newDay    = nyDOW != nyDOW_prev and bar_index > 0

// MTF data — includes close for accurate OR Close reference
[ltf_high_arr, ltf_low_arr, ltf_close_arr, ltf_time_arr] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, close, time])


// ════════════════════════════════════════════════════════════════════════════
// MODULE 4: OPENING RANGE — MULTI-BAR RANGE
// ════════════════════════════════════════════════════════════════════════════

var float or_high      = na
var float or_low       = na
var float or_last_close = na
var bool  or_complete  = false
var bool  or_building  = false
var int   or_start_bar = na
var box   or_box       = na

// Forward declarations
var float bull_ref = na
var float bear_ref = na
var bool  ref_set  = false
var float daily_max_bull_mfe  = 0.0
var float daily_max_bear_mfe  = 0.0
var int   daily_bull_peak_min = 0
var int   daily_bear_peak_min = 0
var bool  is_committed        = false
var array<float> daily_pivot_bulls = array.new_float(0)
var array<float> daily_pivot_bears = array.new_float(0)
var array<float> mfe_bull_history       = array.new_float(0)
var array<float> mfe_bear_history       = array.new_float(0)
var array<int>   peak_time_bull_history = array.new_int(0)
var array<int>   peak_time_bear_history = array.new_int(0)
var array<float> pivot_bull_history     = array.new_float(0)
var array<float> pivot_bear_history     = array.new_float(0)

// CRITICAL: Before resetting, commit previous session if uncommitted
if is_new_day and not is_committed and ref_set and not na(bull_ref)
    if daily_max_bull_mfe > 0 or daily_max_bear_mfe > 0
        array.push(mfe_bull_history, daily_max_bull_mfe)
        array.push(mfe_bear_history, daily_max_bear_mfe)
        array.push(peak_time_bull_history, daily_bull_peak_min)
        array.push(peak_time_bear_history, daily_bear_peak_min)
    if daily_max_bull_mfe > daily_max_bear_mfe
        if array.size(daily_pivot_bulls) > 0
            for idx = 0 to array.size(daily_pivot_bulls) - 1
                array.push(pivot_bull_history, array.get(daily_pivot_bulls, idx))
    else
        if array.size(daily_pivot_bears) > 0
            for idx = 0 to array.size(daily_pivot_bears) - 1
                array.push(pivot_bear_history, array.get(daily_pivot_bears, idx))
    is_committed := true

if is_new_day
    or_high      := na
    or_low       := na
    or_last_close := na
    or_complete  := false
    or_building  := false
    or_start_bar := na
    or_box       := na

bool ltf_or_found = false
if array.size(ltf_high_arr) > 0
    for i = 0 to array.size(ltf_high_arr) - 1
        int ltf_mins = f_mins_of_day(array.get(ltf_time_arr, i))
        if f_in_range(ltf_mins, RANGE_START, RANGE_END)
            float ltf_h = array.get(ltf_high_arr, i)
            float ltf_l = array.get(ltf_low_arr, i)
            if not or_building
                or_high      := ltf_h
                or_low       := ltf_l
                or_building  := true
                or_start_bar := bar_index
                ltf_or_found := true
            else
                or_high := math.max(or_high, ltf_h)
                or_low  := math.min(or_low, ltf_l)
                ltf_or_found := true

if in_or_range and not ltf_or_found
    if not or_building
        or_high      := high
        or_low       := low
        or_last_close := close
        or_building  := true
        or_start_bar := bar_index
    else
        or_high      := math.max(or_high, high)
        or_low       := math.min(or_low, low)
        or_last_close := close

if ltf_or_found and array.size(ltf_time_arr) > 0
    for i = array.size(ltf_time_arr) - 1 to 0
        int ltf_mins = f_mins_of_day(array.get(ltf_time_arr, i))
        if f_in_range(ltf_mins, RANGE_START, RANGE_END)
            or_last_close := array.get(ltf_close_arr, i)
            break

if or_building and not or_complete
    if not in_or_range and not ltf_or_found
        or_complete := true
    else if ltf_or_found
        int tf_mins = timeframe.isminutes ? timeframe.multiplier : timeframe.isseconds ? 1 : 1440
        int bar_end_mins = bar_mins + tf_mins
        if bar_end_mins > 1440
            bar_end_mins := bar_end_mins - 1440
        if bar_end_mins >= RANGE_END or (RANGE_END > RANGE_START and bar_end_mins < RANGE_START)
            or_complete := true
    if or_complete and i_showDebug
        label.new(bar_index, or_high, "OR DONE\nH:" + str.tostring(or_high, "#.##") + "\nL:" + str.tostring(or_low, "#.##"), color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_down, size=size.tiny)

if not na(or_high) and not na(or_start_bar)
    if na(or_box) and or_building
        or_box := box.new(or_start_bar, or_high, bar_index, or_low, border_color=i_orBoxColor, bgcolor=color.new(i_orBoxColor, 80), border_style=f_line_style(i_orBoxStyle), border_width=i_orBoxWidth)
    else if not na(or_box) and (in_or_range or in_data_session)
        box.set_top(or_box, or_high)
        box.set_bottom(or_box, or_low)
        box.set_right(or_box, bar_index)


// ════════════════════════════════════════════════════════════════════════════
// MODULE 5: REFERENCE LEVELS
// ════════════════════════════════════════════════════════════════════════════
// Always uses OR High/Low as bull/bear reference.

if is_new_day
    bull_ref := na
    bear_ref := na
    ref_set  := false

if or_complete and not ref_set and not na(or_high)
    bull_ref := or_high
    bear_ref := or_low
    ref_set := true
    if i_showDebug
        label.new(bar_index, close, "REF\nBull: " + str.tostring(bull_ref, "#.##") + "\nBear: " + str.tostring(bear_ref, "#.##"), color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_right, size=size.tiny)


// ════════════════════════════════════════════════════════════════════════════
// MODULE 6: MFE TRACKING ENGINE
// ════════════════════════════════════════════════════════════════════════════

if is_new_day
    daily_max_bull_mfe  := 0.0
    daily_max_bear_mfe  := 0.0
    daily_bull_peak_min := 0
    daily_bear_peak_min := 0
    is_committed        := false
    array.clear(daily_pivot_bulls)
    array.clear(daily_pivot_bears)

f_track_mfe(float bar_h, float bar_l, int bar_t, float p_bull_ref, float p_bear_ref, float prev_bull, float prev_bear, int prev_bp, int prev_brp) =>
    float nb = prev_bull
    float nbe = prev_bear
    int nbp = prev_bp
    int nbrp = prev_brp
    int mins = f_mins_since(f_mins_of_day(bar_t), RANGE_START)
    if bar_h > p_bull_ref
        float ext = (bar_h - p_bull_ref) / p_bull_ref * 100.0
        if ext > nb
            nb  := ext
            nbp := mins
    if bar_l < p_bear_ref
        float ext = (p_bear_ref - bar_l) / p_bear_ref * 100.0
        if ext > nbe
            nbe  := ext
            nbrp := mins
    [nb, nbe, nbp, nbrp]

f_track_pivots(float bar_h, float bar_l, float p_bull_ref, float p_bear_ref, array<float> bulls, array<float> bears) =>
    if bar_h > p_bull_ref
        array.push(bulls, (bar_h - p_bull_ref) / p_bull_ref * 100.0)
    if bar_l < p_bear_ref
        array.push(bears, (p_bear_ref - bar_l) / p_bear_ref * 100.0)

bool ltf_is_in_data = false

if ref_set and not na(bull_ref) and not na(bear_ref)
    int num_ltf = array.size(ltf_high_arr)
    if num_ltf > 0
        for i = 0 to num_ltf - 1
            float ltf_h = array.get(ltf_high_arr, i)
            float ltf_l = array.get(ltf_low_arr, i)
            int   ltf_t = array.get(ltf_time_arr, i)
            int   ltf_mins = f_mins_of_day(ltf_t)
            if f_in_range(ltf_mins, RANGE_END, CUTOFF)
                ltf_is_in_data := true
                [nb, nbe, nbp, nbrp] = f_track_mfe(ltf_h, ltf_l, ltf_t, bull_ref, bear_ref, daily_max_bull_mfe, daily_max_bear_mfe, daily_bull_peak_min, daily_bear_peak_min)
                daily_max_bull_mfe  := nb
                daily_max_bear_mfe  := nbe
                daily_bull_peak_min := nbp
                daily_bear_peak_min := nbrp
                f_track_pivots(ltf_h, ltf_l, bull_ref, bear_ref, daily_pivot_bulls, daily_pivot_bears)
    else if in_data_session
        ltf_is_in_data := true
        [nb, nbe, nbp, nbrp] = f_track_mfe(high, low, time, bull_ref, bear_ref, daily_max_bull_mfe, daily_max_bear_mfe, daily_bull_peak_min, daily_bear_peak_min)
        daily_max_bull_mfe  := nb
        daily_max_bear_mfe  := nbe
        daily_bull_peak_min := nbp
        daily_bear_peak_min := nbrp
        f_track_pivots(high, low, bull_ref, bear_ref, daily_pivot_bulls, daily_pivot_bears)


// ════════════════════════════════════════════════════════════════════════════
// MODULE 7: DAILY COMMIT
// ════════════════════════════════════════════════════════════════════════════

var bool prev_in_data = false
bool effective_in_data = in_data_session or ltf_is_in_data
bool data_just_ended = prev_in_data and not effective_in_data
prev_in_data := effective_in_data


// ════════════════════════════════════════════════════════════════════════════
// MODULE 8: DAY SEPARATORS
// ════════════════════════════════════════════════════════════════════════════
// FIX: Use extend.none — extend.both was incorrectly drawing horizontal lines
// across the entire chart. A day separator should only be a vertical line,
// which in Pine Script is drawn using xloc.bar_index with a price range.

if i_showSep and newDay
    line.new(bar_index, high * 2.0, bar_index, low * 0.5, xloc=xloc.bar_index, color=i_sepColor, style=f_line_style(i_sepStyleStr), width=i_sepWidth, extend=extend.both)

var int dayStartBar    = 0
var int prevDayBars    = 0
var int currDayBars    = 0
var int labelTargetBar = -1
var int labelDOW       = -1
if newDay
    prevDayBars    := currDayBars > 0 ? currDayBars : prevDayBars
    currDayBars    := 0
    dayStartBar    := bar_index
    labelTargetBar := bar_index + math.floor(prevDayBars / 2)
    labelDOW       := nyDOW
currDayBars += 1

plotchar(i_showDayLabel and i_showSep and bar_index == labelTargetBar and labelDOW == 1, char=' ', text='SUN', color=color.new(i_dayLabelColor, 100), location=location.bottom, textcolor=i_dayLabelColor, size=size.small, editable=false)
plotchar(i_showDayLabel and i_showSep and bar_index == labelTargetBar and labelDOW == 2, char=' ', text='MON', color=color.new(i_dayLabelColor, 100), location=location.bottom, textcolor=i_dayLabelColor, size=size.small, editable=false)
plotchar(i_showDayLabel and i_showSep and bar_index == labelTargetBar and labelDOW == 3, char=' ', text='TUE', color=color.new(i_dayLabelColor, 100), location=location.bottom, textcolor=i_dayLabelColor, size=size.small, editable=false)
plotchar(i_showDayLabel and i_showSep and bar_index == labelTargetBar and labelDOW == 4, char=' ', text='WED', color=color.new(i_dayLabelColor, 100), location=location.bottom, textcolor=i_dayLabelColor, size=size.small, editable=false)
plotchar(i_showDayLabel and i_showSep and bar_index == labelTargetBar and labelDOW == 5, char=' ', text='THU', color=color.new(i_dayLabelColor, 100), location=location.bottom, textcolor=i_dayLabelColor, size=size.small, editable=false)
plotchar(i_showDayLabel and i_showSep and bar_index == labelTargetBar and labelDOW == 6, char=' ', text='FRI', color=color.new(i_dayLabelColor, 100), location=location.bottom, textcolor=i_dayLabelColor, size=size.small, editable=false)


// ════════════════════════════════════════════════════════════════════════════
// MODULE 9: INFO BOX
// ════════════════════════════════════════════════════════════════════════════
// FIX: Removed debug rows (d1/d2/d3) from the info box. Clean display only.

var table infoTable = table.new(f_table_pos(i_infoPos), 1, 4, bgcolor=i_infoBg, border_color=i_infoBorderClr, border_width=1, frame_color=i_infoBorderClr, frame_width=2)
if barstate.islast
    if i_showInfoBox
        string _sym  = syminfo.prefix + ":" + syminfo.ticker
        string _date = str.tostring(dayofmonth(time, i_timezone)) + "/" + str.tostring(month(time, i_timezone)) + "/" + str.tostring(year(time, i_timezone)) + "   " + f_day_full(dayofweek(time, i_timezone))
        string _sz   = f_text_size(i_infoTextSize)
        table.cell(infoTable, 0, 0, i_infoAuthor, text_color=i_infoTextClr, text_size=_sz)
        table.cell(infoTable, 0, 1, _sym, text_color=i_infoTextClr, text_size=size.large)
        table.cell(infoTable, 0, 2, f_tf_display() + " TIMEFRAME", text_color=i_infoTextClr, text_size=_sz)
        table.cell(infoTable, 0, 3, _date, text_color=i_infoTextClr, text_size=_sz)
    else
        for i = 0 to 3
            table.cell(infoTable, 0, i, "")


// ════════════════════════════════════════════════════════════════════════════
// MODULE 10: MFE PRICE DISTRIBUTION HISTOGRAM
// ════════════════════════════════════════════════════════════════════════════

var box[]   mfe_hist_boxes  = array.new_box(0)
var line[]  mfe_stat_lines  = array.new_line(0)
var label[] mfe_stat_labels = array.new_label(0)

if is_new_day
    f_clear_boxes(mfe_hist_boxes)
    f_clear_lines(mfe_stat_lines)
    f_clear_labels(mfe_stat_labels)

bool show_bull = i_levelDisplay == "Both" or i_levelDisplay == "Bull Only"
bool show_bear = i_levelDisplay == "Both" or i_levelDisplay == "Bear Only"

// Track the MFE histogram vertical extent so the data table can be placed below it
var float mfe_hist_bottom_price = na

if barstate.islast and i_showMFE and or_complete and not na(bull_ref) and not na(bear_ref) and not na(or_start_bar)
    int anchor = or_start_bar
    mfe_hist_bottom_price := na  // reset before redraw

    array<float> bull_mfe_nz = f_build_filtered(mfe_bull_history)
    array<float> bear_mfe_nz = f_build_filtered(mfe_bear_history)
    int n_bull = array.size(bull_mfe_nz)
    int n_bear = array.size(bear_mfe_nz)
    int num_all = array.size(mfe_bull_history)
    bool has_data = n_bull > 0 or n_bear > 0

    if has_data
        array.push(mfe_stat_labels, label.new(anchor, or_low - (syminfo.mintick * i_offsetBelowMFE / 2), "Sessions: " + str.tostring(n_bull) + " Bull / " + str.tostring(n_bear) + " Bear", textcolor=color.new(color.white, 30), style=label.style_label_up, size=f_size(i_mfeDataLblSize), color=color.new(color.black, 100)))

        int num_bands = int((i_endPct - i_startPct) / i_pctStep)
        if num_bands < 1
            num_bands := 1

        // Track lowest price drawn (bottom of bear histogram)
        float bear_hist_bottom = or_low

        // Bull bands
        if n_bull > 0 and show_bull
            array<float> bull_sorted = array.copy(bull_mfe_nz)
            bull_sorted.sort(order.ascending)
            for i = 0 to num_bands - 1
                int pct_lo = i_startPct + (i * i_pctStep)
                int pct_hi = pct_lo + i_pctStep
                if pct_hi > 100
                    pct_hi := 100
                float mfe_lo = array.percentile_linear_interpolation(bull_sorted, pct_lo)
                float mfe_hi = array.percentile_linear_interpolation(bull_sorted, pct_hi)
                float p_bot = bull_ref * (1.0 + mfe_lo / 100.0)
                float p_top = bull_ref * (1.0 + mfe_hi / 100.0)
                int days_hit = 0
                for k = 0 to num_all - 1
                    if array.get(mfe_bull_history, k) >= mfe_lo
                        days_hit += 1
                int w = math.max(1, int(float(days_hit) / float(num_all) * float(i_histWidthScale)))
                int transp = 30 + int(float(i) / float(num_bands) * 50.0)
                array.push(mfe_hist_boxes, box.new(anchor, p_top, anchor + w, p_bot, border_color=color.new(i_bullColor, transp + 20), bgcolor=color.new(i_bullColor, transp)))

        // Bear bands
        if n_bear > 0 and show_bear
            array<float> bear_sorted = array.copy(bear_mfe_nz)
            bear_sorted.sort(order.ascending)
            for i = 0 to num_bands - 1
                int pct_lo = i_startPct + (i * i_pctStep)
                int pct_hi = pct_lo + i_pctStep
                if pct_hi > 100
                    pct_hi := 100
                float mfe_lo = array.percentile_linear_interpolation(bear_sorted, pct_lo)
                float mfe_hi = array.percentile_linear_interpolation(bear_sorted, pct_hi)
                float p_top = bear_ref * (1.0 - mfe_lo / 100.0)
                float p_bot = bear_ref * (1.0 - mfe_hi / 100.0)
                int days_hit = 0
                for k = 0 to num_all - 1
                    if array.get(mfe_bear_history, k) >= mfe_lo
                        days_hit += 1
                int w = math.max(1, int(float(days_hit) / float(num_all) * float(i_histWidthScale)))
                int transp = 30 + int(float(i) / float(num_bands) * 50.0)
                array.push(mfe_hist_boxes, box.new(anchor, p_top, anchor + w, p_bot, border_color=color.new(i_bearColor, transp + 20), bgcolor=color.new(i_bearColor, transp)))
                // Track lowest price extent
                if p_bot < bear_hist_bottom
                    bear_hist_bottom := p_bot

        // Store the lowest drawn price for positioning elements below the histogram
        mfe_hist_bottom_price := bear_hist_bottom

    // --- Statistical lines ---
    int num_sessions = array.size(mfe_bull_history)
    bool has_mfe = num_sessions > 0
    if has_mfe
        float sum_bull = 0.0
        int cnt_bull = 0
        float sum_bear = 0.0
        int cnt_bear = 0
        array<float> mfe_bull_filtered = array.new_float(0)
        array<float> mfe_bear_filtered = array.new_float(0)
        for k = 0 to num_sessions - 1
            float bv = array.get(mfe_bull_history, k)
            float sv = array.get(mfe_bear_history, k)
            if bv > 0
                sum_bull += bv
                cnt_bull += 1
                array.push(mfe_bull_filtered, bv)
            if sv > 0
                sum_bear += sv
                cnt_bear += 1
                array.push(mfe_bear_filtered, sv)
        float avg_bull = cnt_bull > 0 ? sum_bull / float(cnt_bull) : na
        float avg_bear = cnt_bear > 0 ? sum_bear / float(cnt_bear) : na
        // End lines at the cutoff bar: anchor + bars spanning OR-end → cutoff
        float bars_per_min = timeframe.isminutes ? 1.0 / float(timeframe.multiplier) : timeframe.isseconds ? 60.0 / float(timeframe.multiplier) : 1.0 / 1440.0
        int line_end = anchor + math.max(1, int(float(DATA_DURATION) * bars_per_min))

        if i_showAvgLine
            if not na(avg_bull) and show_bull
                float p = bull_ref * (1.0 + avg_bull / 100.0)
                array.push(mfe_stat_lines, line.new(anchor, p, line_end, p, color=i_avgLineColor, style=line.style_dashed, width=1))
                array.push(mfe_stat_labels, label.new(line_end + 5, p, str.tostring(avg_bull, "#.##") + "% AVG", color=color.new(color.black, 100), textcolor=i_avgLineColor, style=label.style_label_left, size=f_size(i_mfeLabelSize)))
            if not na(avg_bear) and show_bear
                float p = bear_ref * (1.0 - avg_bear / 100.0)
                array.push(mfe_stat_lines, line.new(anchor, p, line_end, p, color=i_avgLineColor, style=line.style_dashed, width=1))
                array.push(mfe_stat_labels, label.new(line_end + 5, p, str.tostring(avg_bear, "#.##") + "% AVG", color=color.new(color.black, 100), textcolor=i_avgLineColor, style=label.style_label_left, size=f_size(i_mfeLabelSize)))

        if i_showMedLine
            float med_bull = array.size(mfe_bull_filtered) > 0 ? array.median(mfe_bull_filtered) : na
            float med_bear = array.size(mfe_bear_filtered) > 0 ? array.median(mfe_bear_filtered) : na
            if not na(med_bull) and show_bull
                float p = bull_ref * (1.0 + med_bull / 100.0)
                array.push(mfe_stat_lines, line.new(anchor, p, line_end, p, color=i_medLineColor, style=line.style_dashed, width=1))
                array.push(mfe_stat_labels, label.new(line_end + 5, p, str.tostring(med_bull, "#.##") + "% MED", color=color.new(color.black, 100), textcolor=i_medLineColor, style=label.style_label_left, size=f_size(i_mfeLabelSize)))
            if not na(med_bear) and show_bear
                float p = bear_ref * (1.0 - med_bear / 100.0)
                array.push(mfe_stat_lines, line.new(anchor, p, line_end, p, color=i_medLineColor, style=line.style_dashed, width=1))
                array.push(mfe_stat_labels, label.new(line_end + 5, p, str.tostring(med_bear, "#.##") + "% MED", color=color.new(color.black, 100), textcolor=i_medLineColor, style=label.style_label_left, size=f_size(i_mfeLabelSize)))

        // FIX: Percentile labels placed to the LEFT of the histogram (at anchor - 5)
        // so they don't overlap with the histogram boxes.
        if i_showPctLabels
            int num_levels = int((i_endPct - i_startPct) / i_pctStep) + 1
            for i = 0 to num_levels - 1
                int pct = i_startPct + (i * i_pctStep)
                if pct <= i_endPct
                    int transp = pct == 50 ? 30 : pct == 25 or pct == 75 ? 50 : 70
                    if array.size(mfe_bull_filtered) > 0 and show_bull
                        float pv = array.percentile_linear_interpolation(mfe_bull_filtered, pct)
                        float pp = bull_ref * (1.0 + pv / 100.0)
                        // Short tick line at the left edge of the histogram
                        array.push(mfe_stat_lines, line.new(anchor - 3, pp, anchor, pp, color=color.new(i_avgLineColor, transp), style=line.style_dotted))
                        // Label to the left of the histogram anchor
                        array.push(mfe_stat_labels, label.new(anchor - 4, pp, str.tostring(pv, "#.##") + "% P" + str.tostring(pct), color=color.new(color.black, 100), textcolor=color.new(i_avgLineColor, transp), style=label.style_label_right, size=f_size(i_mfeLabelSize)))
                    if array.size(mfe_bear_filtered) > 0 and show_bear
                        float pv = array.percentile_linear_interpolation(mfe_bear_filtered, pct)
                        float pp = bear_ref * (1.0 - pv / 100.0)
                        array.push(mfe_stat_lines, line.new(anchor - 3, pp, anchor, pp, color=color.new(i_avgLineColor, transp), style=line.style_dotted))
                        array.push(mfe_stat_labels, label.new(anchor - 4, pp, str.tostring(pv, "#.##") + "% P" + str.tostring(pct), color=color.new(color.black, 100), textcolor=color.new(i_avgLineColor, transp), style=label.style_label_right, size=f_size(i_mfeLabelSize)))


// ════════════════════════════════════════════════════════════════════════════
// MODULE 11: TIME DISTRIBUTION HISTOGRAM
// ════════════════════════════════════════════════════════════════════════════
// FIX: Time histogram is placed below the MFE histogram using mfe_hist_bottom_price
// as the reference, with i_offsetBelowMFE ticks of gap. No extra input needed.

var box[]   time_hist_boxes  = array.new_box(0)
var line[]  time_stat_lines  = array.new_line(0)
var label[] time_stat_labels = array.new_label(0)

if is_new_day
    f_clear_boxes(time_hist_boxes)
    f_clear_lines(time_stat_lines)
    f_clear_labels(time_stat_labels)

if barstate.islast and or_complete and i_showTimeDist and not na(or_start_bar)
    int t_anchor = or_start_bar

    // Anchor the time histogram below the MFE histogram.
    // If MFE hist bottom is known, use it; otherwise fall back to or_low.
    float base_y = na
    if not na(mfe_hist_bottom_price) and i_showMFE
        base_y := mfe_hist_bottom_price - (syminfo.mintick * i_offsetBelowMFE)
    else
        base_y := not na(or_low) ? or_low - (syminfo.mintick * i_offsetBelowMFE) : low - (syminfo.mintick * i_offsetBelowMFE)

    int num_time_bins = math.ceil(DATA_DURATION / i_timeBucketMins)
    float bars_per_min = timeframe.isminutes ? 1.0 / float(timeframe.multiplier) : timeframe.isseconds ? 60.0 / float(timeframe.multiplier) : 1.0 / 1440.0
    int min_box_width = math.max(1, int(float(i_timeBucketMins) * bars_per_min))

    int title_x = t_anchor + int(float(DATA_DURATION / 2) * bars_per_min)
    array.push(time_stat_labels, label.new(title_x, base_y + syminfo.mintick * 80, "MFE Time Distribution", color=color.new(color.black, 100), textcolor=color.new(color.white, 50), style=label.style_label_down, size=f_size(i_timeLabelSize)))

    int max_time_count = 1
    int[] bull_counts = array.new_int(num_time_bins, 0)
    int[] bear_counts = array.new_int(num_time_bins, 0)

    for i = 0 to num_time_bins - 1
        int bin_start = i * i_timeBucketMins
        int bin_end   = bin_start + i_timeBucketMins
        int cb = 0
        int cs = 0
        if array.size(peak_time_bull_history) > 0
            for j = 0 to array.size(peak_time_bull_history) - 1
                int pk = array.get(peak_time_bull_history, j)
                float bull_mfe_j = array.get(mfe_bull_history, j)
                if pk >= bin_start and pk < bin_end and bull_mfe_j > 0
                    cb += 1
        if array.size(peak_time_bear_history) > 0
            for j = 0 to array.size(peak_time_bear_history) - 1
                int pk = array.get(peak_time_bear_history, j)
                float bear_mfe_j = array.get(mfe_bear_history, j)
                if pk >= bin_start and pk < bin_end and bear_mfe_j > 0
                    cs += 1
        array.set(bull_counts, i, cb)
        array.set(bear_counts, i, cs)
        max_time_count := math.max(max_time_count, math.max(cb, cs))

    float profile_h = syminfo.mintick * i_offsetBelowMFE * 0.4

    for i = 0 to num_time_bins - 1
        int bin_start_mins = i * i_timeBucketMins
        int cb = array.get(bull_counts, i)
        int cs = array.get(bear_counts, i)

        int x_left  = t_anchor + int(float(bin_start_mins) * bars_per_min)
        int x_right = x_left + min_box_width
        if x_right <= x_left
            x_right := x_left + 1

        if cb > 0
            float h = float(cb) / float(max_time_count) * profile_h
            array.push(time_hist_boxes, box.new(x_left, base_y + h, x_right, base_y, border_color=na, bgcolor=i_timeBullColor))
        if cs > 0
            float h = float(cs) / float(max_time_count) * profile_h
            array.push(time_hist_boxes, box.new(x_left, base_y, x_right, base_y - h, border_color=na, bgcolor=i_timeBearColor))

    array<int> bull_times_nz = array.new_int(0)
    array<int> bear_times_nz = array.new_int(0)
    if array.size(peak_time_bull_history) > 0
        for j = 0 to array.size(peak_time_bull_history) - 1
            if array.get(mfe_bull_history, j) > 0
                array.push(bull_times_nz, array.get(peak_time_bull_history, j))
    if array.size(peak_time_bear_history) > 0
        for j = 0 to array.size(peak_time_bear_history) - 1
            if array.get(mfe_bear_history, j) > 0
                array.push(bear_times_nz, array.get(peak_time_bear_history, j))

    bool has_bull_time = array.size(bull_times_nz) > 0
    bool has_bear_time = array.size(bear_times_nz) > 0
    float line_h = profile_h * 1.2

    if has_bull_time
        float avg_t = array.avg(bull_times_nz)
        float med_t = array.median(bull_times_nz)
        int x_avg = t_anchor + int(avg_t * bars_per_min)
        int x_med = t_anchor + int(med_t * bars_per_min)
        if i_showTimeAvg
            array.push(time_stat_lines, line.new(x_avg, base_y + line_h, x_avg, base_y, color=i_timeAvgColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_avg, base_y + line_h, "Bull AVG", color=color.new(color.black, 100), textcolor=i_timeAvgColor, style=label.style_label_down, size=f_size(i_timeLabelSize)))
        if i_showTimeMed
            array.push(time_stat_lines, line.new(x_med, base_y + line_h * 0.8, x_med, base_y, color=i_timeMedColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_med, base_y + line_h * 0.8, "Bull MED", color=color.new(color.black, 100), textcolor=i_timeMedColor, style=label.style_label_down, size=f_size(i_timeLabelSize)))
    if has_bear_time
        float avg_t = array.avg(bear_times_nz)
        float med_t = array.median(bear_times_nz)
        int x_avg = t_anchor + int(avg_t * bars_per_min)
        int x_med = t_anchor + int(med_t * bars_per_min)
        if i_showTimeAvg
            array.push(time_stat_lines, line.new(x_avg, base_y, x_avg, base_y - line_h, color=i_timeAvgColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_avg, base_y - line_h, "Bear AVG", color=color.new(color.black, 100), textcolor=i_timeAvgColor, style=label.style_label_up, size=f_size(i_timeLabelSize)))
        if i_showTimeMed
            array.push(time_stat_lines, line.new(x_med, base_y, x_med, base_y - line_h * 0.8, color=i_timeMedColor, style=line.style_dashed))
            array.push(time_stat_labels, label.new(x_med, base_y - line_h * 0.8, "Bear MED", color=color.new(color.black, 100), textcolor=i_timeMedColor, style=label.style_label_up, size=f_size(i_timeLabelSize)))


// ════════════════════════════════════════════════════════════════════════════
// MODULE 12: MFE PERCENTILE DATA TABLE
// ════════════════════════════════════════════════════════════════════════════

var table dataTable = na

f_render_section(table tbl, array<float> filtered_arr, array<float> full_arr, int start_row, string title, color mode_clr, string tbl_sz, color hdr_clr) =>
    int n_filtered = array.size(filtered_arr)
    int n_full = array.size(full_arr)
    int row_offset = start_row
    table.cell(tbl, 0, row_offset, title, text_color=mode_clr, text_size=tbl_sz, text_halign=text.align_left)
    table.merge_cells(tbl, 0, row_offset, 5, row_offset)
    row_offset += 1
    table.cell(tbl, 0, row_offset, "Pctile", text_color=hdr_clr, text_size=tbl_sz)
    table.cell(tbl, 1, row_offset, "MFE%", text_color=hdr_clr, text_size=tbl_sz)
    table.cell(tbl, 2, row_offset, "Days", text_color=hdr_clr, text_size=tbl_sz)
    table.cell(tbl, 3, row_offset, "Prev", text_color=hdr_clr, text_size=tbl_sz)
    table.cell(tbl, 4, row_offset, "Streak", text_color=hdr_clr, text_size=tbl_sz)
    table.cell(tbl, 5, row_offset, "Max", text_color=hdr_clr, text_size=tbl_sz)
    row_offset += 1
    if n_filtered > 0 and n_full > 0
        array<float> sorted = array.copy(filtered_arr)
        sorted.sort(order.ascending)
        int num_rows = int((i_dataRangeEnd - i_dataRangeStart) / i_dataStep) + 1
        for r = 0 to num_rows - 1
            int pct = i_dataRangeStart + (r * i_dataStep)
            if pct <= i_dataRangeEnd
                float pct_val = array.percentile_linear_interpolation(sorted, pct)
                int days_hit = 0
                for k = 0 to n_full - 1
                    if array.get(full_arr, k) >= pct_val
                        days_hit += 1
                float last_mfe = array.get(full_arr, n_full - 1)
                bool prev_hit = last_mfe >= pct_val
                int streak = 0
                for k = n_full - 1 to 0
                    if array.get(full_arr, k) >= pct_val
                        streak += 1
                    else
                        break
                int max_streak = 0
                int cur_streak = 0
                for k = 0 to n_full - 1
                    if array.get(full_arr, k) >= pct_val
                        cur_streak += 1
                        if cur_streak > max_streak
                            max_streak := cur_streak
                    else
                        cur_streak := 0
                table.cell(tbl, 0, row_offset, str.tostring(pct) + "th", text_color=mode_clr, text_size=tbl_sz)
                table.cell(tbl, 1, row_offset, str.tostring(pct_val, "#.##") + "%", text_color=mode_clr, text_size=tbl_sz)
                table.cell(tbl, 2, row_offset, str.tostring(days_hit), text_color=color.white, text_size=tbl_sz)
                table.cell(tbl, 3, row_offset, prev_hit ? "✓" : "✗", text_color=prev_hit ? color.green : color.red, text_size=tbl_sz)
                table.cell(tbl, 4, row_offset, str.tostring(streak) + "d", text_color=streak > 0 ? color.yellow : color.white, text_size=tbl_sz)
                table.cell(tbl, 5, row_offset, str.tostring(max_streak) + "d", text_color=color.white, text_size=tbl_sz)
                row_offset += 1
    row_offset

if barstate.islast and i_showDataTable
    int num_sessions = array.size(mfe_bull_history)
    int num_pct_rows = int((i_dataRangeEnd - i_dataRangeStart) / i_dataStep) + 1
    string tbl_sz = f_text_size(i_dataTableSize)
    color hdr_clr = i_dataHeaderClr
    if num_sessions > 0
        if i_dataStatsMode == "Both"
            int total_rows = 2 * (2 + num_pct_rows)
            if not na(dataTable)
                table.delete(dataTable)
            dataTable := table.new(f_table_pos(i_dataTablePos), 6, total_rows, bgcolor=i_dataBgClr, border_color=i_dataBorderClr, border_width=1)
            array<float> bull_filtered = f_build_filtered(mfe_bull_history)
            array<float> bear_filtered = f_build_filtered(mfe_bear_history)
            int next_row = f_render_section(dataTable, bull_filtered, mfe_bull_history, 0, "MFE (" + str.tostring(num_sessions) + " days) - Bull", i_dataBullClr, tbl_sz, hdr_clr)
            f_render_section(dataTable, bear_filtered, mfe_bear_history, next_row, "MFE (" + str.tostring(num_sessions) + " days) - Bear", i_dataBearClr, tbl_sz, hdr_clr)
        else
            array<float> mfe_filtered = array.new_float(0)
            array<float> mfe_full = array.new_float(0)
            string mode_label = i_dataStatsMode
            color mode_clr = i_dataOverallClr
            if i_dataStatsMode == "Bull Only"
                mfe_filtered := f_build_filtered(mfe_bull_history)
                mfe_full := mfe_bull_history
                mode_clr := i_dataBullClr
            else if i_dataStatsMode == "Bear Only"
                mfe_filtered := f_build_filtered(mfe_bear_history)
                mfe_full := mfe_bear_history
                mode_clr := i_dataBearClr
            else
                for i = 0 to num_sessions - 1
                    float mx = math.max(array.get(mfe_bull_history, i), array.get(mfe_bear_history, i))
                    array.push(mfe_full, mx)
                    if mx > 0
                        array.push(mfe_filtered, mx)
            int total_rows = 2 + num_pct_rows
            if not na(dataTable)
                table.delete(dataTable)
            dataTable := table.new(f_table_pos(i_dataTablePos), 6, total_rows, bgcolor=i_dataBgClr, border_color=i_dataBorderClr, border_width=1)
            f_render_section(dataTable, mfe_filtered, mfe_full, 0, "MFE (" + str.tostring(num_sessions) + " days) - " + mode_label, mode_clr, tbl_sz, hdr_clr)


// ════════════════════════════════════════════════════════════════════════════
// MODULE 13: DEBUG DUMP
// ════════════════════════════════════════════════════════════════════════════

if barstate.islast and i_showDebug
    int tb  = array.size(mfe_bull_history)
    int tbe = array.size(mfe_bear_history)
    log.info("=== MFE HISTORY DUMP ===")
    log.info("Sessions: {0}", tb)
    log.info("State: or_building={0}, or_complete={1}, ref_set={2}, is_committed={3}", or_building, or_complete, ref_set, is_committed)
    log.info("Today: bull_mfe={0}, bear_mfe={1}, bull_peak={2}, bear_peak={3}", daily_max_bull_mfe, daily_max_bear_mfe, daily_bull_peak_min, daily_bear_peak_min)
    log.info("Pivot Bulls: {0}, Pivot Bears: {1}", array.size(pivot_bull_history), array.size(pivot_bear_history))
    log.info("RANGE_START={0}, RANGE_END={1}, CUTOFF={2}, DATA_DURATION={3}", RANGE_START, RANGE_END, CUTOFF, DATA_DURATION)

    int dbg_num_bins = math.ceil(DATA_DURATION / i_timeBucketMins)
    log.info("Time hist: num_bins={0}, bucket_mins={1}", dbg_num_bins, i_timeBucketMins)

    if tb > 0
        string bull_peaks = "Bull peak times: "
        string bear_peaks = "Bear peak times: "
        for k = 0 to tb - 1
            bull_peaks := bull_peaks + str.tostring(array.get(peak_time_bull_history, k)) + " "
            bear_peaks := bear_peaks + str.tostring(array.get(peak_time_bear_history, k)) + " "
        log.info(bull_peaks)
        log.info(bear_peaks)

        for i = 0 to math.min(dbg_num_bins - 1, 10)
            int bin_start = i * i_timeBucketMins
            int bin_end   = bin_start + i_timeBucketMins
            int cb = 0
            int cs = 0
            for j = 0 to tb - 1
                int pk_b = array.get(peak_time_bull_history, j)
                if pk_b >= bin_start and pk_b < bin_end and array.get(mfe_bull_history, j) > 0
                    cb += 1
                int pk_s = array.get(peak_time_bear_history, j)
                if pk_s >= bin_start and pk_s < bin_end and array.get(mfe_bear_history, j) > 0
                    cs += 1
            log.info("Bin {0}: mins {1}-{2}, bull={3}, bear={4}", i, bin_start, bin_end, cb, cs)

        string bull_vals = "Bull MFEs: "
        string bear_vals = "Bear MFEs: "
        for k = 0 to tb - 1
            bull_vals := bull_vals + str.tostring(array.get(mfe_bull_history, k), "#.####") + " "
            bear_vals := bear_vals + str.tostring(array.get(mfe_bear_history, k), "#.####") + " "
        log.info(bull_vals)
        log.info(bear_vals)
    log.info("OR High: {0}, OR Low: {1}", or_high, or_low)
    log.info("Bull Ref: {0}, Bear Ref: {1}", bull_ref, bear_ref)
    log.info("Range: {0}-{1}, Cutoff: {2}", i_rangeStart, i_rangeEnd, i_cutoff)
    log.info("bar_mins: {0}, in_or: {1}, in_data: {2}", bar_mins, in_or_range, in_data_session)
    log.info("=== END DUMP ===")
