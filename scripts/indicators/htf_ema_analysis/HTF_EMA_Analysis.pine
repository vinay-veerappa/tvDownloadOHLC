grp_stats = "Stats"
// User input for extension threshold (default 0.5%)
i_extensionThreshold = input.float(0.5, "Min Extension % for Stats (mode/median)", minval=0.0, maxval=5.0, step=0.1, group=grp_stats)
// Helper: filter array for values >= threshold (absolute value)
f_array_filter_threshold(array<float> arr, float threshold) =>
    array<float> filtered = array.new_float()
    int n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(arr, i)
            if math.abs(v) >= threshold
                array.push(filtered, v)
    filtered
