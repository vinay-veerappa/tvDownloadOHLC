// ============================================
// Helpers
// ============================================
f_line_style(string s) =>
    switch s
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

f_txt_size(string s) =>
    switch s
        "Tiny" => size.tiny
        "Small" => size.small
        "Large" => size.large
        => size.normal

f_table_pos(string s) =>
    switch s
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Middle Center" => position.middle_center
        "Middle Left" => position.middle_left
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right

f_table_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal

f_push_capped(array<float> arr, float value, int maxLen) =>
    array.push(arr, value)
    while array.size(arr) > maxLen
        array.shift(arr)

f_push_capped_bool(array<bool> arr, bool value, int maxLen) =>
    array.push(arr, value)
    while array.size(arr) > maxLen
        array.shift(arr)

f_array_filter_nonzero(array<float> arr) =>
    array<float> filtered = array.new_float()
    int n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(arr, i)
            if v > 0.001
                array.push(filtered, v)
    filtered

f_mean(array<float> arr) =>
    int n = array.size(arr)
    if n == 0
        na
    else
        float sum = 0.0
        for i = 0 to n - 1
            sum += array.get(arr, i)
        sum / n

f_median(array<float> arr) =>
    int n = array.size(arr)
    if n == 0
        na
    else
        array<float> cp = array.copy(arr)
        array.sort(cp)
        int mid = math.floor(n * 0.5)
        n % 2 == 1 ? array.get(cp, mid) : (array.get(cp, mid - 1) + array.get(cp, mid)) * 0.5

f_mode_bin_size(float rawBinSize) =>
    math.max(0.5, math.round(rawBinSize / 0.5) * 0.5)

f_mode_nearest_mean(array<float> arr, float binSize) =>
    int n = array.size(arr)
    if n == 0
        na
    else
        float bs = f_mode_bin_size(binSize)
        // Keeps historical behavior for weekly/range/all-level tables by ignoring near-zero values.
        array<float> filtered = f_array_filter_nonzero(arr)
        int fn = array.size(filtered)
        if fn == 0
            na
        else
            float mu = f_mean(filtered)
            array<float> bins = array.new_float()
            array<int> counts = array.new_int()
            for i = 0 to fn - 1
                float raw = array.get(filtered, i)
                float b = math.round(raw / bs) * bs
                int idx = -1
                int binsNLocal = array.size(bins)
                if binsNLocal > 0
                    for j = 0 to binsNLocal - 1
                        if math.abs(array.get(bins, j) - b) <= (bs * 0.25)
                            idx := j
                            break
                if idx == -1
                    array.push(bins, b)
                    array.push(counts, 1)
                else
                    array.set(counts, idx, array.get(counts, idx) + 1)
            int maxCount = 0
            int countsN = array.size(counts)
            if countsN > 0
                for k = 0 to countsN - 1
                    maxCount := math.max(maxCount, array.get(counts, k))

            float best = na
            float bestDist = 10e10
            int binsFinal = array.size(bins)
            int pairN = math.min(binsFinal, countsN)
            if pairN > 0
                for m = 0 to pairN - 1
                    if array.get(counts, m) == maxCount
                        float candidate = array.get(bins, m)
                        float dist = math.abs(candidate - mu)
                        if dist < bestDist
                            bestDist := dist
                            best := candidate
            best

f_mode_nearest_mean_all(array<float> arr, float binSize) =>
    int n = array.size(arr)
    if n == 0
        na
    else
        float bs = f_mode_bin_size(binSize)
        float mu = f_mean(arr)
        array<float> bins = array.new_float()
        array<int> counts = array.new_int()
        for i = 0 to n - 1
            float raw = array.get(arr, i)
            float b = math.round(raw / bs) * bs
            int idx = -1
            int binsNLocal = array.size(bins)
            if binsNLocal > 0
                for j = 0 to binsNLocal - 1
                    if math.abs(array.get(bins, j) - b) <= (bs * 0.25)
                        idx := j
                        break
            if idx == -1
                array.push(bins, b)
                array.push(counts, 1)
            else
                array.set(counts, idx, array.get(counts, idx) + 1)
        int maxCount = 0
        int countsN = array.size(counts)
        if countsN > 0
            for k = 0 to countsN - 1
                maxCount := math.max(maxCount, array.get(counts, k))

        float best = na
        float bestDist = 10e10
        int binsFinal = array.size(bins)
        int pairN = math.min(binsFinal, countsN)
        if pairN > 0
            for m = 0 to pairN - 1
                if array.get(counts, m) == maxCount
                    float candidate = array.get(bins, m)
                    float dist = math.abs(candidate - mu)
                    if dist < bestDist
                        bestDist := dist
                        best := candidate
        best

f_mode_bin(array<float> arr, float binSize, bool includeZeros) =>
    int n = array.size(arr)
    if n == 0
        na
    else
        float bs = f_mode_bin_size(binSize)
        array<float> bins = array.new_float()
        array<int> counts = array.new_int()
        array<float> vals = array.new_float()
        for i = 0 to n - 1
            float raw = array.get(arr, i)
            if includeZeros or raw > 0.001
                array.push(vals, raw)
                float b = math.floor(raw / bs) * bs
                int idx = -1
                int binsNLocal = array.size(bins)
                if binsNLocal > 0
                    for j = 0 to binsNLocal - 1
                        if array.get(bins, j) == b
                            idx := j
                            break
                if idx == -1
                    array.push(bins, b)
                    array.push(counts, 1)
                else
                    array.set(counts, idx, array.get(counts, idx) + 1)
        int binsN = array.size(bins)
        int countsN = array.size(counts)
        int pairN = math.min(binsN, countsN)
        if pairN == 0 or array.size(vals) == 0
            na
        else
            int maxCount = array.get(counts, 0)
            for k = 1 to pairN - 1
                maxCount := math.max(maxCount, array.get(counts, k))

            float center = f_median(vals)
            float bestBin = na
            float bestDist = 10e10
            for m = 0 to pairN - 1
                if array.get(counts, m) == maxCount
                    float candidate = array.get(bins, m)
                    float dist = math.abs(candidate - center)
                    if dist < bestDist or (dist == bestDist and (na(bestBin) or candidate < bestBin))
                        bestDist := dist
                        bestBin := candidate
            bestBin

f_hitrate_bool(array<bool> arr) =>
    int n = array.size(arr)
    if n == 0
        na
    else
        int hits = 0
        for i = 0 to n - 1
            if array.get(arr, i)
                hits += 1
        (hits * 100.0) / n

f_hitrate_level(array<float> arr, float level) =>
    int n = array.size(arr)
    if n == 0
        na
    else
        int hits = 0
        for i = 0 to n - 1
            if array.get(arr, i) >= level
                hits += 1
        (hits * 100.0) / n

f_hits_at_level(array<float> arr, float level) =>
    int n = array.size(arr)
    int hits = 0
    if n > 0
        for i = 0 to n - 1
            if array.get(arr, i) >= level
                hits += 1
    hits

f_status(float hitRate) =>
    if na(hitRate)
        "N/A"
    else
        hitRate >= 66.67 ? "Good" : hitRate >= 33.33 ? "Fair" : "Rare"

f_status_color(float hitRate) =>
    if na(hitRate)
        color.new(color.gray, 0)
    else
        hitRate >= 66.67 ? color.new(#16a34a, 0) : hitRate >= 33.33 ? color.new(#d97706, 0) : color.new(#dc2626, 0)

// Strict weekday mapping (Mon..Fri). Sunday is excluded from DOW stats.
f_day_idx(int dow) =>
    switch dow
        dayofweek.monday => 0
        dayofweek.tuesday => 1
        dayofweek.wednesday => 2
        dayofweek.thursday => 3
        dayofweek.friday => 4
        => -1

f_day_name_to_dow(string dayName) =>
    dayName == "Sunday" ? dayofweek.sunday :
      dayName == "Monday" ? dayofweek.monday :
      dayName == "Tuesday" ? dayofweek.tuesday :
      dayName == "Wednesday" ? dayofweek.wednesday :
      dayName == "Thursday" ? dayofweek.thursday :
      dayName == "Friday" ? dayofweek.friday : dayofweek.sunday

f_calendar_dow_from_ts(int ts) =>
    int y = year(ts, TZ)
    int m = month(ts, TZ)
    int d = dayofmonth(ts, TZ)
    dayofweek(timestamp(TZ, y, m, d, 12, 0), TZ)

f_hhmm_in_window(int hh, int mm, int sh, int sm, int eh, int em) =>
    int cur = hh * 60 + mm
    int st = sh * 60 + sm
    int en = eh * 60 + em
    en >= st ? (cur >= st and cur <= en) : (cur >= st or cur <= en)

f_update_level_line(line ln, bool show, float y, color c, int w, string style, int lookbackBars) =>
    line out = ln
    if show and not na(y)
        int x1 = math.max(0, bar_index - lookbackBars)
        int x2 = bar_index + 5
        if na(out)
            out := line.new(x1, y, x2, y, xloc=xloc.bar_index, extend=extend.none, color=c, width=w, style=f_line_style(style))
        else
            line.set_x1(out, x1)
            line.set_y1(out, y)
            line.set_x2(out, x2)
            line.set_y2(out, y)
            line.set_color(out, c)
            line.set_width(out, w)
            line.set_style(out, f_line_style(style))
    else if not na(out)
        line.delete(out)
        out := na
    out

f_update_segment_line(line ln, bool show, float y, int t1, int t2, color c, int w, string style) =>
    line out = ln
    if show and not na(y) and not na(t1) and not na(t2)
        if na(out)
            out := line.new(t1, y, t2, y, xloc=xloc.bar_time, extend=extend.none, color=c, width=w, style=f_line_style(style))
        else
            line.set_x1(out, t1)
            line.set_y1(out, y)
            line.set_x2(out, t2)
            line.set_y2(out, y)
            line.set_color(out, c)
            line.set_width(out, w)
            line.set_style(out, f_line_style(style))
    else if not na(out)
        line.delete(out)
        out := na
    out

// Creates a one-shot historical segment line (fire-and-forget).
f_draw_hist_segment(bool show, float price, int t1, int t2, color c, int w, string style) =>
    if show and not na(price) and not na(t1) and not na(t2)
        line.new(t1, price, t2, price, xloc=xloc.bar_time, color=c, width=w, style=f_line_style(style))

// Manages a single label: creates, updates, or deletes as needed.
f_update_label(label lbl, bool show, int x, float y, string txt, color txtColor, color bgColor, string sz) =>
    label out = lbl
    if show and not na(y)
        if na(out)
            out := label.new(x, y, txt, style=label.style_label_left, textcolor=txtColor, color=bgColor, size=f_txt_size(sz), text_font_family=font.family_monospace)
        else
            label.set_x(out, x)
            label.set_y(out, y)
            label.set_text(out, txt)
            label.set_textcolor(out, txtColor)
            label.set_color(out, bgColor)
    else if not na(out)
        label.delete(out)
        out := na
    out

f_tail_to_string(array<float> arr, int count) =>
    int n = array.size(arr)
    if n == 0
        "[]"
    else
        int start = math.max(0, n - count)
        string s = "["
        for i = start to n - 1
            if i > start
                s += ", "
            s += str.tostring(array.get(arr, i), "#.##")
        s + "]"

f_idx_to_day(int idx) =>
    idx == 0 ? "Mon" : idx == 1 ? "Tue" : idx == 2 ? "Wed" : idx == 3 ? "Thu" : idx == 4 ? "Fri" : "NA"

// ============================================
// Core Series
// NOTE: request.security "W" uses the exchange's native weekly candle.
// For NYMEX futures (CL), the week runs Sun 18:00 ET to Fri 17:00 ET.
// This is the exchange-defined boundary and cannot be changed in Pine.
// ============================================
[weeklyEma, prevWeeklyEma, prevWeekHigh, prevWeekLow, prevWeekOpen] = request.security(syminfo.tickerid, "W", [ta.ema(close, i_emaLength)[1], ta.ema(close, i_emaLength)[2], high[1], low[1], open[1]], lookahead=barmerge.lookahead_on)
float weeklyEmaStable = request.security(syminfo.tickerid, "W", ta.ema(close, i_emaLength)[1], lookahead=barmerge.lookahead_off)
[prevMonthHigh, prevMonthLow, currMonthHigh, currMonthLow] = request.security(syminfo.tickerid, "M", [high[1], low[1], high, low], lookahead=barmerge.lookahead_on)
[dHighPrevSec, dLowPrevSec, dHighSec, dLowSec, dTimeSec, dTimePrevSec, dTimeClosePrevSec] = request.security(syminfo.tickerid, "D", [high[1], low[1], high, low, time, time[1], time_close[1]], lookahead=barmerge.lookahead_off)
[currWeekHigh, currWeekLow] = request.security(syminfo.tickerid, "W", [high, low], lookahead=barmerge.lookahead_off)

float prevWeekMid = (prevWeekHigh + prevWeekLow) * 0.5
float prevWeek25 = prevWeekLow + (prevWeekHigh - prevWeekLow) * 0.25
float prevWeek75 = prevWeekLow + (prevWeekHigh - prevWeekLow) * 0.75
float prevMonthMid = (prevMonthHigh + prevMonthLow) * 0.5
float currMonth30 = currMonthLow + (currMonthHigh - currMonthLow) * 0.30

float pctDistance = ((close - weeklyEma) / weeklyEma) * 100.0
float upperZoneHi = weeklyEma * (1.0 + i_upperZoneHighPct / 100.0)
float upperZoneLo = weeklyEma * (1.0 + i_upperZoneLowPct / 100.0)
float lowerZoneHi = weeklyEma * (1.0 - i_lowerZoneHighPct / 100.0)
float lowerZoneLo = weeklyEma * (1.0 - i_lowerZoneLowPct / 100.0)

float upperProbZoneHi = weeklyEma * (1.0 + i_zoneStartPct / 100.0)
float upperProbZoneLo = weeklyEma * (1.0 + i_zoneEndPct / 100.0)
float lowerProbZoneHi = weeklyEma * (1.0 - i_zoneStartPct / 100.0)
float lowerProbZoneLo = weeklyEma * (1.0 - i_zoneEndPct / 100.0)



int monthKey = year(time_close, TZ) * 100 + month(time_close, TZ)
int dayKey = year(time_close, TZ) * 10000 + month(time_close, TZ) * 100 + dayofmonth(time_close, TZ)
bool isNewWeek = ta.change(time("W", TZ)) != 0
bool isNewMonth = ta.change(monthKey) != 0
bool isNewDay = ta.change(dayKey) != 0
bool tfIsIntraday = timeframe.isintraday
int curYear = year(timenow, TZ)
int curWeek = weekofyear(timenow, TZ)
int curMonth = month(timenow, TZ)
bool inCurrentWeek = year(time_close, TZ) == curYear and weekofyear(time_close, TZ) == curWeek
bool prevBarInCurrentWeek = year(time[1], TZ) == curYear and weekofyear(time[1], TZ) == curWeek
bool inCurrentMonth = year(time_close, TZ) == curYear and month(time_close, TZ) == curMonth
bool wkMask = not i_currentWeekOnly or inCurrentWeek
bool monMask = i_showHistoricalMonths or inCurrentMonth
int barDow = dayofweek(time, TZ)
int barHour = hour(time, TZ)
int barMin = minute(time, TZ)
int barYear = year(time, TZ)
int barMonth = month(time, TZ)
int barDom = dayofmonth(time, TZ)
bool inProbTime = f_hhmm_in_window(barHour, barMin, i_startHour, i_startMin, i_endHour, i_endMin)
bool probTimePass = not i_enableTimeFilter or inProbTime

/// ============================================
// Theme & Color Engine (Upgraded & Backwards-Compatible)
// ============================================
bool darkTheme = true

// Upgraded base colors mapped to your ORIGINAL variable names so existing tables don't break
color tblBg = na
color tblHeaderBg = na
color tblText = na
color tblTextMuted = na
color labelBg = na
color uiSubHead = na
color uiBorder = na

tblBg := color.new(#1f2430, 8)
tblHeaderBg := color.new(#2a3142, 0)
tblText := color.new(#e8ecf3, 0)
tblTextMuted := color.new(#b7c0d4, 0)
labelBg := color.new(#1f2430, 15)
uiSubHead := color.new(#323b50, 0)
uiBorder := color.new(#3d4760, 0)

color colUp        = color.new(#6ee787, 0) // High % Green
color colDn        = color.new(#ff7b72, 0) // Low % Red
color colUpHeaderBg = color.new(#1f3b2e, 0)
color colDnHeaderBg = color.new(#48272c, 0)
color colUpMuted   = color.new(#9adfb3, 0)
color colDnMuted   = color.new(#ffb3ad, 0)

// ============================================
// Statistical Storage
// ============================================
var array<float> weekUpPct = array.new_float()
var array<float> weekDownPct = array.new_float()
var array<bool> weekZoneHits = array.new_bool()

var array<bool> weekOpenAboveEma = array.new_bool()

// DOW Array Storage (Up/Down discrete tracking)
var array<float> monUp = array.new_float(), var array<float> monDn = array.new_float()
var array<float> tueUp = array.new_float(), var array<float> tueDn = array.new_float()
var array<float> wedUp = array.new_float(), var array<float> wedDn = array.new_float()
var array<float> thuUp = array.new_float(), var array<float> thuDn = array.new_float()
var array<float> friUp = array.new_float(), var array<float> friDn = array.new_float()
var array<float> monDnSigned = array.new_float(), var array<float> tueDnSigned = array.new_float()
var array<float> wedDnSigned = array.new_float(), var array<float> thuDnSigned = array.new_float()
var array<float> friDnSigned = array.new_float()

var array<float> rangePcts = array.new_float()
var array<bool> rangeZoneHits = array.new_bool()
var float activeRangeHigh = na
var float activeRangeLow = na
var float activeRangeOpen = na
var float activeRangeClose = na
var bool activeRangeTracking = false
var bool activeRangeDone = false

// Session box state
var box sundayBox = na
var box tuesdayBox = na
var int sundayBoxStartTime = na
var int tuesdayBoxStartTime = na
var float sundayHigh = na
var float sundayLow = na
var float tuesdayHigh = na
var float tuesdayLow = na
var bool sundayWindowOpen = false
var bool tuesdayWindowOpen = false
var int sundayEndTs = na
var int tuesdayEndTs = na
var int sundayBoxEndTime = na
var int tuesdayBoxEndTime = na

// Week tracking for zone boxes
var int weekStartTime = na
var int prevWeekStartTime = na
var int prevWeekEndTime = na
var box upperZoneBox = na
var box lowerZoneBox = na
var box upperProbZoneBox = na
var box lowerProbZoneBox = na

// NFP box 
var box nfpBox = na

// Current month 30% line object
var line lnCurrMonth30 = na

// Previous month carry-forward line objects
var line lnPmHighCarry = na
var line lnPmLowCarry = na
var line lnPmMidCarry = na

// Previous week line objects
var line lnPwHigh = na
var line lnPwLow = na
var line lnPw50 = na
var line lnPw25 = na
var line lnPw75 = na

// Label objects
var label lblPmHigh = na
var label lblPmLow = na
var label lblPmMid = na
var label lblMonth30 = na
var label lblNfp = na
var label lblPwHigh = na
var label lblPwLow = na
var label lblPw50 = na
var label lblPw25 = na
var label lblPw75 = na

// Month index tracking
var int currMonthStartTime = na
var int prevMonthStartTime = na
var int prevMonthEndTime = na



if barstate.isfirst
    currMonthStartTime := time
    weekStartTime := time

if isNewMonth
    // Finalize the just-ended month using that month's own H/L/M.
    if i_showHistoricalMonths and not na(currMonthStartTime) and not na(prevMonthHigh)
        int histEndTime = time[1]
        f_draw_hist_segment(i_showMonthHigh, prevMonthHigh, currMonthStartTime, histEndTime, i_cMonthHigh, i_histWidth, i_histStyle)
        f_draw_hist_segment(i_showMonthLow, prevMonthLow, currMonthStartTime, histEndTime, i_cMonthLow, i_histWidth, i_histStyle)
        f_draw_hist_segment(i_showMonthMid, prevMonthMid, currMonthStartTime, histEndTime, i_cMonthMid, i_histWidth, i_histStyle)
    prevMonthStartTime := currMonthStartTime
    prevMonthEndTime := time[1]
    currMonthStartTime := time

    
    

// ============================================
// Weekly data collection
// ============================================
if isNewWeek and not na(prevWeeklyEma) and not na(weeklyEma) and not na(prevWeekHigh) and not na(prevWeekLow) and not na(prevWeekOpen)
    // Distance and zone stats: prevWeeklyEma ([2] = prior week's closing EMA)
    // User confirmed [1] breaks the hitrates, proving [2] is fundamentally correct
    // CALCULATE DISTANCES
    float upPct = math.max(0.0, ((prevWeekHigh - prevWeeklyEma) / prevWeeklyEma) * 100)
    float dnPct = math.max(0.0, ((prevWeeklyEma - prevWeekLow) / prevWeeklyEma) * 100)
    float upperZoneLoBound = prevWeeklyEma * (1.0 + i_zoneStartPct / 100.0)
    float upperZoneHiBound = prevWeeklyEma * (1.0 + i_zoneEndPct / 100.0)
    float lowerZoneHiBound = prevWeeklyEma * (1.0 - i_zoneStartPct / 100.0)
    float lowerZoneLoBound = prevWeeklyEma * (1.0 - i_zoneEndPct / 100.0)
    // Upper zone hit: high reached into the upper zone band
    bool upperHit = prevWeekHigh >= upperZoneLoBound
    // Lower zone hit: low reached into the lower zone band
    bool lowerHit = prevWeekLow <= lowerZoneHiBound
    bool zoneHit = upperHit or lowerHit

    f_push_capped(weekUpPct, upPct, i_lookbackWeeks)
    f_push_capped(weekDownPct, dnPct, i_lookbackWeeks)
    f_push_capped_bool(weekZoneHits, zoneHit, i_lookbackWeeks)
    // Open comparison: prevWeeklyEma ([2] = prior week EMA), shorter window → 34/48=70.8%
    int openLookback = math.max(1, i_lookbackWeeks - 4)
    f_push_capped_bool(weekOpenAboveEma, prevWeekOpen >= prevWeeklyEma, openLookback)

// Draw fixed historical segments for the week that just ended.
// weekStartTime = start of just-ended week; time[1] = its last bar.
if isNewWeek and i_showPrevWeek and tfIsIntraday and not na(prevWeekHigh) and not na(prevWeekLow) and not na(weekStartTime)
    int histEnd = time[1]
    f_draw_hist_segment(i_showPwh, prevWeekHigh, weekStartTime, histEnd, i_cPwh, i_histWidth, i_histStyle)
    f_draw_hist_segment(i_showPwl, prevWeekLow, weekStartTime, histEnd, i_cPwl, i_histWidth, i_histStyle)
    f_draw_hist_segment(i_showPw50, prevWeekMid, weekStartTime, histEnd, i_cPwMid, i_histWidth, i_histStyle)
    f_draw_hist_segment(i_showPw25, prevWeek25, weekStartTime, histEnd, i_cPwQ, i_histWidth, i_histStyle)
    f_draw_hist_segment(i_showPw75, prevWeek75, weekStartTime, histEnd, i_cPwQ, i_histWidth, i_histStyle)

// Exclude partial days from the current active week to lock the 52-week lookback
bool isNewDailySec = ta.change(dTimeSec) != 0
int dDowTs = dTimeClosePrevSec
bool prevDailyInCurrentWeek = year(dDowTs, TZ) == curYear and weekofyear(dDowTs, TZ) == curWeek
if isNewDailySec and not na(weeklyEmaStable) and not prevDailyInCurrentWeek
    float dHighPrev = dHighPrevSec
    float dLowPrev = dLowPrevSec
    float dEmaRef = weeklyEmaStable
    int yDow = f_calendar_dow_from_ts(dDowTs)
    int idx = f_day_idx(yDow)
    
    if idx >= 0 and not na(dHighPrev) and not na(dLowPrev)
        // Calculate daily extension % from EMA
        float dUp = math.max(0.0, ((dHighPrev - dEmaRef) / dEmaRef) * 100.0)
        float dDnSigned = ((dEmaRef - dLowPrev) / dEmaRef) * 100.0
        float dDn = math.max(0.0, dDnSigned)
        
        // Exact 52-week cap per day
        int cap = i_lookbackWeeks 

        array<float> dayUpArr = switch idx
            0 => monUp
            1 => tueUp
            2 => wedUp
            3 => thuUp
            => friUp
        array<float> dayDnArr = switch idx
            0 => monDn
            1 => tueDn
            2 => wedDn
            3 => thuDn
            => friDn
        array<float> dayDnSignedArr = switch idx
            0 => monDnSigned
            1 => tueDnSigned
            2 => wedDnSigned
            3 => thuDnSigned
            => friDnSigned
        f_push_capped(dayUpArr, dUp, cap)
        f_push_capped(dayDnArr, dDn, cap)
        f_push_capped(dayDnSignedArr, dDnSigned, cap)

        if i_debugDowLog and (idx == 2 or idx == 3)
            array<float> dbgUpArr = dayUpArr
            array<float> dbgDnArr = dayDnArr
            array<float> dbgDnSignedArr = dayDnSignedArr
            string collectMsg = "DOW_COLLECT " + f_idx_to_day(idx) +
              " prevDTime=" + str.tostring(dDowTs) +
              " yDow=" + str.tostring(yDow) +
              " ema=" + str.tostring(dEmaRef, "#.####") +
              " dHighPrev=" + str.tostring(dHighPrev, "#.####") +
              " dLowPrev=" + str.tostring(dLowPrev, "#.####") +
              " up=" + str.tostring(dUp, "#.####") +
              " dnSigned=" + str.tostring(dDnSigned, "#.####") +
              " dnAbs=" + str.tostring(dDn, "#.####") +
              " N=" + str.tostring(array.size(dbgUpArr)) +
              " ModeUpAll=" + str.tostring(f_mode_nearest_mean_all(dbgUpArr, i_modeBinSize), "#.####") +
              " ModeDnAll=" + str.tostring(f_mode_nearest_mean_all(dbgDnArr, i_modeBinSize), "#.####") +
              " ModeUpNZ=" + str.tostring(f_mode_nearest_mean(dbgUpArr, i_modeBinSize), "#.####") +
              " ModeDnNZ=" + str.tostring(f_mode_nearest_mean(dbgDnArr, i_modeBinSize), "#.####") +
              " MdLo=" + str.tostring(f_median(dbgDnArr), "#.####") +
              " upTail=" + f_tail_to_string(dbgUpArr, 8) +
              " dnTail=" + f_tail_to_string(dbgDnArr, 8) +
              " dnSignedTail=" + f_tail_to_string(dbgDnSignedArr, 8)
            log.info(collectMsg)

// ============================================
// Range Analysis Engine
// ============================================
int targetDow = f_day_name_to_dow(i_rangeDow)
bool isTargetDay = barDow == targetDow
bool inRangeWindow = f_hhmm_in_window(barHour, barMin, i_rangeStartHour, i_rangeStartMin, i_rangeEndHour, i_rangeEndMin)

if isNewDay
    activeRangeTracking := false
    activeRangeDone := false
    activeRangeHigh := na
    activeRangeLow := na
    activeRangeOpen := na
    activeRangeClose := na

if i_showRangeAnalysis and isTargetDay and inRangeWindow
    if not activeRangeTracking
        activeRangeTracking := true
        activeRangeHigh := high
        activeRangeLow := low
        activeRangeOpen := open
    else
        activeRangeHigh := math.max(activeRangeHigh, high)
        activeRangeLow := math.min(activeRangeLow, low)
    activeRangeClose := close

// Locks range stats to historical completed weeks only
if i_showRangeAnalysis and activeRangeTracking and not activeRangeDone and not inRangeWindow and not inCurrentWeek
    float base = nz(activeRangeOpen, open)
    float rangePct = na
    float rangeBody = math.abs(nz(activeRangeClose, close) - activeRangeOpen)
    float rangeHL = activeRangeHigh - activeRangeLow
    if i_measurementType == "Body"
        rangePct := rangeBody / base * 100.0
    else if i_measurementType == "Wick"
        rangePct := (rangeHL - rangeBody) / base * 100.0
    else
        rangePct := rangeHL / base * 100.0

    if not na(rangePct)
        int cap = i_limitDays ? i_numberOfDays : 500
        f_push_capped(rangePcts, rangePct, cap)
        f_push_capped_bool(rangeZoneHits, rangePct >= i_rangeZoneFrom and rangePct <= i_rangeZoneTo, cap)
    activeRangeDone := true

/// ============================================
// NFP Detection (First Friday)
// ============================================
var float nfpHigh = na
var float nfpLow = na
var int activeNfpMonth = na

bool isNfpFriday = dayofweek(time_close, TZ) == dayofweek.friday and dayofmonth(time_close, TZ) <= 7
bool isFirstNfpBar = isNfpFriday and not isNfpFriday[1]

if i_showNfp
    // TOGGLE: Wipe the old NFP box the exact moment a new month begins if checked
    if isNewMonth and i_nfpCurrentMonthOnly
        if not na(nfpBox)
            box.delete(nfpBox)
            nfpBox := na
            log.info("Deleting Old NFP boxes 1")

    if isFirstNfpBar
        // Failsafe wipe if the toggle is ON before drawing the new one
        if i_nfpCurrentMonthOnly and not na(nfpBox)
            box.delete(nfpBox)
            log.info("Deleting Old NFP boxes 2")
        

        
        nfpHigh := high
        nfpLow := low
        activeNfpMonth := month(time_close, TZ)
        
        int yYear = year(time_close, TZ)
        int yDay = dayofmonth(time_close, TZ)
        int friMidnight = timestamp(TZ, yYear, activeNfpMonth, yDay, 0, 0)
        int nfpSessionStart = friMidnight - (6 * 60 * 60 * 1000) // Thursday 18:00 start
        
        // Create brand new box
        nfpBox := box.new(left=nfpSessionStart, top=nfpHigh, right=time_close, bottom=nfpLow, xloc=xloc.bar_time, border_color=color.new(i_cNfp, 30), bgcolor=color.new(i_cNfp, 86), border_width=1, border_style=line.style_dashed, text="NFP", text_color=i_cNfp, text_size=size.normal, text_halign=text.align_right, text_valign=text.align_center, text_font_family=font.family_monospace)
        
    else if isNfpFriday
        // We are actively inside the live NFP Friday session, expand the high/low
        nfpHigh := math.max(nfpHigh, high)
        nfpLow := math.min(nfpLow, low)
        if not na(nfpBox)
            box.set_top(nfpBox, nfpHigh)
            box.set_bottom(nfpBox, nfpLow)
            box.set_right(nfpBox, time_close)
            log.info("Setting  NFP boxes values")
            
    else if not na(nfpBox) and month(time_close, TZ) == activeNfpMonth
        // We are past NFP Friday, but still in the same month. Extend the right edge.
        box.set_right(nfpBox, time_close)
else
    // Clean up if the master display toggle is turned off entirely
    if not na(nfpBox)
        box.delete(nfpBox)
        nfpBox := na
        log.info("Deleting Old NFP boxes 3")

// Highlight every first-Friday NFP bar in yellow for quick visual identification.
bool isNfpDayBar = i_showNfp and isNfpFriday
barcolor(isNfpDayBar ? color.new(#facc15, 0) : na, title="NFP Day Highlight")

// ============================================
// Sunday and Tuesday Session Anchors
// ============================================
var bool sundaySet = false
var bool tuesdaySet = false

if isNewWeek
    sundaySet := false
    tuesdaySet := false
    sundayWindowOpen := false
    tuesdayWindowOpen := false
    
// Detach session box references so new ones are created (old ones remain on chart)
    sundayBox := na
    tuesdayBox := na
    prevWeekStartTime := weekStartTime
    prevWeekEndTime := time[1]
    weekStartTime := time

// Sunday: detect first bar in 18:xx hour on Sunday (flexible, works on any TF)
bool isSunday18 = barDow == dayofweek.sunday and barHour >= 18
bool tfLt60 = timeframe.isintraday and timeframe.in_seconds(timeframe.period) < 3600
// Tuesday: first bar at 9:30 (sub-60m) or 9:xx hour (>=60m)
bool isTuesday0930 = barDow == dayofweek.tuesday and barHour == 9 and barMin >= 30
bool isTuesdayHourBar = barDow == dayofweek.tuesday and barHour == 9

if not sundaySet and isSunday18
    sundaySet := true
    sundayHigh := high
    sundayLow := low
    sundayBoxStartTime := time
    sundayEndTs := timestamp(TZ, barYear, barMonth, barDom, 19, 0)
    sundayWindowOpen := true
    sundayBoxEndTime := sundayBoxStartTime

if not tuesdaySet and ((tfLt60 and isTuesday0930) or (not tfLt60 and isTuesdayHourBar))
    tuesdaySet := true
    tuesdayHigh := high
    tuesdayLow := low
    tuesdayBoxStartTime := time
    int tEndHour = 10
    int tEndMin = tfLt60 ? 30 : 0
    tuesdayEndTs := timestamp(TZ, barYear, barMonth, barDom, tEndHour, tEndMin)
    tuesdayWindowOpen := true
    tuesdayBoxEndTime := tuesdayBoxStartTime

if sundayWindowOpen and time <= sundayEndTs
    sundayHigh := math.max(sundayHigh, high)
    sundayLow := math.min(sundayLow, low)
    sundayBoxEndTime := time_close
else if sundayWindowOpen and time > sundayEndTs
    sundayWindowOpen := false

// Extend Sunday box right edge through the entire week
if sundaySet and not sundayWindowOpen
    sundayBoxEndTime := time_close

if tuesdayWindowOpen and time <= tuesdayEndTs
    tuesdayHigh := math.max(tuesdayHigh, high)
    tuesdayLow := math.min(tuesdayLow, low)
    tuesdayBoxEndTime := time_close
else if tuesdayWindowOpen and time > tuesdayEndTs
    tuesdayWindowOpen := false

// Extend Tuesday box right edge through the entire week
if tuesdaySet and not tuesdayWindowOpen
    tuesdayBoxEndTime := time_close

// Session box rendering (only on intraday timeframes)
if i_showSessionBoxes and tfIsIntraday
    if sundaySet and not na(sundayHigh) and not na(sundayLow)
        int sEndTime = nz(sundayBoxEndTime, time_close)
        if na(sundayBox)
            sundayBox := box.new(sundayBoxStartTime, sundayHigh, sEndTime, sundayLow, xloc=xloc.bar_time, border_color=color.new(i_cSunday, 0), bgcolor=color.new(i_cSunday, 85), border_width=1, text="Sunday", text_color=i_cSunday, text_size=f_table_size(i_allLevelsTableSize), text_halign=text.align_right, text_valign=text.align_center, text_font_family=font.family_monospace)
        else
            box.set_left(sundayBox, sundayBoxStartTime)
            box.set_right(sundayBox, sEndTime)
            box.set_top(sundayBox, sundayHigh)
            box.set_bottom(sundayBox, sundayLow)
    if tuesdaySet and not na(tuesdayHigh) and not na(tuesdayLow)
        int tEndTime = nz(tuesdayBoxEndTime, time_close)
        if na(tuesdayBox)
            tuesdayBox := box.new(tuesdayBoxStartTime, tuesdayHigh, tEndTime, tuesdayLow, xloc=xloc.bar_time, border_color=color.new(i_cTuesday, 0), bgcolor=color.new(i_cTuesday, 85), border_width=1, text="Tuesday", text_color=i_cTuesday, text_size=f_table_size(i_allLevelsTableSize), text_halign=text.align_right, text_valign=text.align_center, text_font_family=font.family_monospace)
        else
            box.set_left(tuesdayBox, tuesdayBoxStartTime)
            box.set_right(tuesdayBox, tEndTime)
            box.set_top(tuesdayBox, tuesdayHigh)
            box.set_bottom(tuesdayBox, tuesdayLow)
else
    if not na(sundayBox)
        box.delete(sundayBox)
        sundayBox := na
    if not na(tuesdayBox)
        box.delete(tuesdayBox)
        tuesdayBox := na

// ============================================
// EMA Zone Boxes (Current & Historical)
// ============================================
if i_showEmaZones and not na(weeklyEma)
    if isNewWeek
        // FIX: Snap the right edge of the OLD boxes to the exact end of the prior week.
        // This prevents them from overlapping into the new week horizontally.
        if not na(upperZoneBox)
            box.set_right(upperZoneBox, time[1])
        if not na(lowerZoneBox)
            box.set_right(lowerZoneBox, time[1])
        if i_showProbability
            if not na(upperProbZoneBox)
                box.set_right(upperProbZoneBox, time[1])
            if not na(lowerProbZoneBox)
                box.set_right(lowerProbZoneBox, time[1])

        // TOGGLE: If "Current Week Only" is ON, destroy the old boxes entirely
        if i_currentWeekOnly
            if not na(upperZoneBox)
                box.delete(upperZoneBox)
            if not na(lowerZoneBox)
                box.delete(lowerZoneBox)
            if not na(upperProbZoneBox)
                box.delete(upperProbZoneBox)
            if not na(lowerProbZoneBox)
                box.delete(lowerProbZoneBox)
        
        int zEndTime = time_close + (time_close - time) * 5
        int startT = na(weekStartTime) ? time : weekStartTime
        
        // Generate the NEW boxes for the incoming week
        upperZoneBox := box.new(startT, upperZoneHi, zEndTime, upperZoneLo, xloc=xloc.bar_time, border_color=color.new(i_cUpper, 60), bgcolor=color.new(i_cUpper, i_zoneFillOpacity), border_width=1)
        lowerZoneBox := box.new(startT, lowerZoneHi, zEndTime, lowerZoneLo, xloc=xloc.bar_time, border_color=color.new(i_cLower, 60), bgcolor=color.new(i_cLower, i_zoneFillOpacity), border_width=1)
        
        if i_showProbability
            upperProbZoneBox := box.new(startT, upperProbZoneHi, zEndTime, upperProbZoneLo, xloc=xloc.bar_time, border_color=color.new(i_cUpper, 60), bgcolor=color.new(i_cUpper, i_zoneFillOpacity), border_width=1)
            lowerProbZoneBox := box.new(startT, lowerProbZoneHi, zEndTime, lowerProbZoneLo, xloc=xloc.bar_time, border_color=color.new(i_cLower, 60), bgcolor=color.new(i_cLower, i_zoneFillOpacity), border_width=1)
    else
        // Mid-week updating: simply push the right edge forward with price
        int zEndTime = time_close + (time_close - time) * 5
        if not na(upperZoneBox)
            box.set_right(upperZoneBox, zEndTime)
        if not na(lowerZoneBox)
            box.set_right(lowerZoneBox, zEndTime)
        if i_showProbability
            if not na(upperProbZoneBox)
                box.set_right(upperProbZoneBox, zEndTime)
            if not na(lowerProbZoneBox)
                box.set_right(lowerProbZoneBox, zEndTime)

// ============================================
// Monthly Level Lines
// ============================================
// Carry-forward dashed lines: prev month levels extending into current month only
bool hasCarryData = not na(prevMonthHigh) and not na(currMonthStartTime)
lnPmHighCarry := f_update_segment_line(lnPmHighCarry, i_showMonthHigh and hasCarryData, prevMonthHigh, currMonthStartTime, time_close + (time_close - time) * 5, i_cMonthHigh, i_liveWidth, "Dashed")
lnPmLowCarry := f_update_segment_line(lnPmLowCarry, i_showMonthLow and hasCarryData, prevMonthLow, currMonthStartTime, time_close + (time_close - time) * 5, i_cMonthLow, i_liveWidth, "Dashed")
lnPmMidCarry := f_update_segment_line(lnPmMidCarry, i_showMonthMid and hasCarryData, prevMonthMid, currMonthStartTime, time_close + (time_close - time) * 5, i_cMonthMid, i_liveWidth, "Dashed")

// Current month 30% line (solid, within current month only)
lnCurrMonth30 := f_update_segment_line(lnCurrMonth30, i_showCurrentMonth30 and not na(currMonth30) and not na(currMonthStartTime), currMonth30, currMonthStartTime, time_close + (time_close - time) * 5, i_cMonth30, i_liveWidth, i_liveStyle)

// Previous week lines
int pwSegEnd = time_close + (time_close - time) * 5
bool showPwCarry = i_showPrevWeek and tfIsIntraday and wkMask and not na(weekStartTime)
lnPwHigh := f_update_segment_line(lnPwHigh, showPwCarry and i_showPwh, prevWeekHigh, weekStartTime, pwSegEnd, i_cPwh, i_prevWeekWidth, i_prevWeekStyle)
lnPwLow := f_update_segment_line(lnPwLow, showPwCarry and i_showPwl, prevWeekLow, weekStartTime, pwSegEnd, i_cPwl, i_prevWeekWidth, i_prevWeekStyle)
lnPw50 := f_update_segment_line(lnPw50, showPwCarry and i_showPw50, prevWeekMid, weekStartTime, pwSegEnd, i_cPwMid, i_prevWeekWidth, i_prevWeekStyle)
lnPw25 := f_update_segment_line(lnPw25, showPwCarry and i_showPw25, prevWeek25, weekStartTime, pwSegEnd, i_cPwQ, i_prevWeekWidth, i_prevWeekStyle)
lnPw75 := f_update_segment_line(lnPw75, showPwCarry and i_showPw75, prevWeek75, weekStartTime, pwSegEnd, i_cPwQ, i_prevWeekWidth, i_prevWeekStyle)


// ============================================
// Visuals (only plots that must be plots)
// ============================================
// Single EMA line
plot(i_showEmaLine ? weeklyEma : na, "Weekly EMA", color=i_cEma, linewidth=2)

// Optimal zone marker removed (not in reference design)

// Range debug (only when enabled)
float rangeDebugHigh = i_showRangeDebug and i_showRangeAnalysis and activeRangeTracking ? activeRangeHigh : na
float rangeDebugLow = i_showRangeDebug and i_showRangeAnalysis and activeRangeTracking ? activeRangeLow : na
plot(rangeDebugHigh, "Range Debug High", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(rangeDebugLow, "Range Debug Low", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)



// ============================================
// Labels
// ============================================
if i_showLabels and barstate.islast
    int lx = bar_index + 6
    lblPmHigh := f_update_label(lblPmHigh, i_showMonthHigh, lx, prevMonthHigh, "Prev Month High", i_cMonthHigh, labelBg, i_labelSize)
    lblPmLow := f_update_label(lblPmLow, i_showMonthLow, lx, prevMonthLow, "Prev Month Low", i_cMonthLow, labelBg, i_labelSize)
    lblPmMid := f_update_label(lblPmMid, i_showMonthMid, lx, prevMonthMid, "Prev Month Mid", i_cMonthMid, labelBg, i_labelSize)
    lblMonth30 := f_update_label(lblMonth30, i_showCurrentMonth30, lx, currMonth30, "Current Month 30%", i_cMonth30, labelBg, i_labelSize)
    float nfpMidY = i_showNfp and not na(nfpHigh) and not na(nfpLow) ? (nfpHigh + nfpLow) * 0.5 : na
    lblNfp := f_update_label(lblNfp, not na(nfpMidY), lx, nfpMidY, "NFP Friday", i_cNfp, labelBg, i_labelSize)
    bool pwActive = i_showPrevWeek and tfIsIntraday and showPwCarry
    lblPwHigh := f_update_label(lblPwHigh, pwActive and i_showPwh, lx, prevWeekHigh, "PW High", i_cPwh, labelBg, i_labelSize)
    lblPwLow := f_update_label(lblPwLow, pwActive and i_showPwl, lx, prevWeekLow, "PW Low", i_cPwl, labelBg, i_labelSize)
    lblPw50 := f_update_label(lblPw50, pwActive and i_showPw50, lx, prevWeekMid, "PW 50%", i_cPwMid, labelBg, i_labelSize)
    lblPw25 := f_update_label(lblPw25, pwActive and i_showPw25, lx, prevWeek25, "PW 25%", i_cPwQ, labelBg, i_labelSize)
    lblPw75 := f_update_label(lblPw75, pwActive and i_showPw75, lx, prevWeek75, "PW 75%", i_cPwQ, labelBg, i_labelSize)

// ============================================
// Statistical Dashboard Calculations (Optimized)
// ============================================
var float upMean = na
var float upMedian = na
var float upMode = na
var float dnMean = na
var float dnMedian = na
var float dnMode = na
var float zoneHitRate = na
var string zoneStatus = ""
var color zoneStatusColor = na

var float rangeMean = na
var float rangeMedian = na
var float rangeMode = na
var float rangeHitRate = na

if barstate.islast
    // Calculate Weekly Stats once on the final bar
    array<float> weekUpPctNZ = f_array_filter_nonzero(weekUpPct)
    array<float> weekDownPctNZ = f_array_filter_nonzero(weekDownPct)
    
    upMean := f_mean(weekUpPctNZ)
    upMedian := f_median(weekUpPctNZ)
    upMode := f_mode_nearest_mean(weekUpPct, i_modeBinSize)
    dnMean := f_mean(weekDownPctNZ)
    dnMedian := f_median(weekDownPctNZ)
    dnMode := f_mode_nearest_mean(weekDownPct, i_modeBinSize)
    zoneHitRate := f_hitrate_bool(weekZoneHits)
    zoneStatus := f_status(zoneHitRate)
    zoneStatusColor := f_status_color(zoneHitRate)
 
// ============================================
// Upgraded Dashboard Rendering (Executes on Last Bar)
// ============================================
if i_showProbability and barstate.islast
    // --- Global Hit/Comp Calculations ---
    int nWeeks = array.size(weekUpPct)
    float rateHitUp = f_hitrate_level(weekUpPct, i_zoneStartPct)
    float rateHitDn = f_hitrate_level(weekDownPct, i_zoneStartPct)
    float rateCompUp = f_hitrate_level(weekUpPct, i_zoneEndPct)
    float rateCompDn = f_hitrate_level(weekDownPct, i_zoneEndPct)
    
    // Calculate conversions (how often a hit becomes a completion)
    int hitsUpCount = f_hits_at_level(weekUpPct, i_zoneStartPct)
    int hitsDnCount = f_hits_at_level(weekDownPct, i_zoneStartPct)
    int compUpCount = f_hits_at_level(weekUpPct, i_zoneEndPct)
    int compDnCount = f_hits_at_level(weekDownPct, i_zoneEndPct)
    float convUp = hitsUpCount > 0 ? (compUpCount * 1.0 / hitsUpCount) * 100 : 0.0
    float convDn = hitsDnCount > 0 ? (compDnCount * 1.0 / hitsDnCount) * 100 : 0.0

    // Opening Position Impact
    int nWeeksOpen = array.size(weekOpenAboveEma)
    int openAboveCount = 0
    if nWeeksOpen > 0
        for i = 0 to nWeeksOpen - 1
            if array.get(weekOpenAboveEma, i)
                openAboveCount += 1
    float pctOpenAbove = nWeeksOpen > 0 ? (openAboveCount * 1.0 / nWeeksOpen) * 100 : 0.0
    float pctOpenBelow = nWeeksOpen > 0 ? 100.0 - pctOpenAbove : 0.0

    // ============================================
    // TABLE 1: STATISTICAL SUMMARY
    // ============================================
    var table statTable = table.new(f_table_pos(i_weeklyTablePos), 9, 8, bgcolor=tblBg, border_color=uiBorder, border_width=1)
    
    table.cell(statTable, 0, 0, "STATISTICAL SUMMARY", text_color=tblText, bgcolor=uiSubHead, text_size=f_table_size(i_weeklyTableSize), text_halign=text.align_center)
    table.merge_cells(statTable, 0, 0, 8, 0)
    
    table.cell(statTable, 0, 1, "Statistic", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 1, 1, "High %", text_color=tblText, bgcolor=colUpHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 2, 1, "Low %", text_color=tblText, bgcolor=colDnHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 3, 1, "Explanation", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 4, 1, "", bgcolor=tblBg) // Spacer
    table.cell(statTable, 5, 1, "Zone Entry", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 6, 1, "↑ " + str.tostring(rateHitUp, "#.#") + "%", text_color=colUp, bgcolor=tblBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 7, 1, "↓ " + str.tostring(rateHitDn, "#.#") + "%", text_color=colDn, bgcolor=tblBg, text_size=f_table_size(i_weeklyTableSize))
    
    table.cell(statTable, 0, 2, "Mean (Average)", text_color=tblText, text_size=f_table_size(i_weeklyTableSize), text_halign=text.align_left)
    table.cell(statTable, 1, 2, str.tostring(upMean, "#.#") + "%", text_color=colUp, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 2, 2, str.tostring(dnMean, "#.#") + "%", text_color=colDn, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 3, 2, "Typical weekly move", text_color=tblTextMuted, text_size=f_table_size(i_weeklyTableSize))
    
    table.cell(statTable, 0, 3, "Median (Middle)", text_color=tblText, text_size=f_table_size(i_weeklyTableSize), text_halign=text.align_left)
    table.cell(statTable, 1, 3, str.tostring(upMedian, "#.#") + "%", text_color=colUp, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 2, 3, str.tostring(dnMedian, "#.#") + "%", text_color=colDn, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 3, 3, "50th percentile", text_color=tblTextMuted, text_size=f_table_size(i_weeklyTableSize))
    
    table.cell(statTable, 0, 4, "Mode (Most Common)", text_color=tblText, text_size=f_table_size(i_weeklyTableSize), text_halign=text.align_left)
    table.cell(statTable, 1, 4, str.tostring(upMode, "#.#") + "%", text_color=colUp, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 2, 4, str.tostring(dnMode, "#.#") + "%", text_color=colDn, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 3, 4, "Most frequent move", text_color=tblTextMuted, text_size=f_table_size(i_weeklyTableSize))

    table.cell(statTable, 5, 2, "Zone Complete", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 6, 2, "↑ " + str.tostring(rateCompUp, "#.#") + "%", text_color=colUp, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 7, 2, "↓ " + str.tostring(rateCompDn, "#.#") + "%", text_color=colDn, text_size=f_table_size(i_weeklyTableSize))
    
    table.cell(statTable, 5, 3, "Completion Rate", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 6, 3, "↑ " + str.tostring(convUp, "#.#") + "%", text_color=colUp, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 7, 3, "↓ " + str.tostring(convDn, "#.#") + "%", text_color=colDn, text_size=f_table_size(i_weeklyTableSize))

    table.cell(statTable, 0, 6, "Opening Position Impact", text_color=tblText, bgcolor=uiSubHead, text_size=f_table_size(i_weeklyTableSize), text_halign=text.align_center)
    table.merge_cells(statTable, 0, 6, 8, 6)
    table.cell(statTable, 0, 7, "Opened Above EMA:", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 1, 7, str.tostring(pctOpenAbove, "#.#") + "% of weeks", text_color=colUp, text_size=f_table_size(i_weeklyTableSize)) 
    table.cell(statTable, 4, 7, "Opened Below EMA:", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 5, 7, str.tostring(pctOpenBelow, "#.#") + "% of weeks", text_color=colDn, text_size=f_table_size(i_weeklyTableSize))

    // DEBUG: raw counts and EMA values for comparison
    string dbg = "N=" + str.tostring(nWeeksOpen) + " above=" + str.tostring(openAboveCount) + " | wkEma=" + str.tostring(weeklyEma, "#.##") + " prevEma=" + str.tostring(prevWeeklyEma, "#.##") + " prevOpen=" + str.tostring(prevWeekOpen, "#.##")
    table.cell(statTable, 0, 5, "DEBUG:", text_color=color.new(#facc15, 0), bgcolor=tblHeaderBg, text_size=f_table_size(i_weeklyTableSize))
    table.cell(statTable, 1, 5, dbg, text_color=color.new(#facc15, 0), text_size=f_table_size(i_weeklyTableSize))
    table.merge_cells(statTable, 1, 5, 8, 5)

    // ============================================
    // TABLE 2: DAY OF WEEK ANALYSIS
    // ============================================

    if i_showDowStats
        var table dowTable = table.new(f_table_pos(i_dowTablePos), 12, 7, bgcolor=tblBg, border_color=uiBorder, border_width=1)
        var int lastDowDbgBar = na
        table.cell(dowTable, 0, 0, "DAY OF WEEK ANALYSIS - Zone: " + str.tostring(i_zoneStartPct) + "-" + str.tostring(i_zoneEndPct) + "%", text_color=tblText, bgcolor=uiSubHead, text_size=f_table_size(i_dowTableSize), text_halign=text.align_center)
        table.merge_cells(dowTable, 0, 0, 11, 0)
        string[] dHeaders = array.from("Day", "Hit Up", "Hit Down", "Complete Up", "Complete Down", "Mean Hi", "Mean Lo", "Med Hi", "MdLo", "Mode Hi", "Mode Lo", "N")
        for [i, h] in dHeaders
            table.cell(dowTable, i, 1, h, text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_dowTableSize))
        array<string> dayNames = array.from("Mon", "Tue", "Wed", "Thu", "Fri")
        for r = 0 to 4
            // Dynamically assign the correct array using a switch statement
            array<float> uArr = switch r
                0 => monUp
                1 => tueUp
                2 => wedUp
                3 => thuUp
                => friUp
            array<float> dArr = switch r
                0 => monDn
                1 => tueDn
                2 => wedDn
                3 => thuDn
                => friDn
            array<float> dArrSigned = switch r
                0 => monDnSigned
                1 => tueDnSigned
                2 => wedDnSigned
                3 => thuDnSigned
                => friDnSigned
            // Use thresholded arrays for stats
            array<float> uArrActive = f_array_filter_threshold(uArr, i_extensionThreshold)
            array<float> dArrActive = f_array_filter_threshold(dArr, i_extensionThreshold)
            int nDays = array.size(uArrActive)
            // Daily Stats
            float hUp = f_hitrate_level(uArr, i_zoneStartPct)
            float hDn = f_hitrate_level(dArr, i_zoneStartPct)
            float cUp = f_hitrate_level(uArr, i_zoneEndPct)
            float cDn = f_hitrate_level(dArr, i_zoneEndPct)
            float mUp = f_mean(uArrActive)
            float mDn = f_mean(dArrActive)
            float medUp = f_median(uArrActive)
            float medDn = f_median(dArrActive)
            float modUp = f_mode_bin(uArrActive, i_modeBinSize, true)
            float modDn = f_mode_bin(dArrActive, i_modeBinSize, true)
            int row = r + 2
            table.cell(dowTable, 0, row, array.get(dayNames, r), text_color=tblText)
            table.cell(dowTable, 1, row, na(hUp) ? "-" : str.tostring(hUp, "#.#") + "%", text_color=color.new(#facc15, 0))
            table.cell(dowTable, 2, row, na(hDn) ? "-" : str.tostring(hDn, "#.#") + "%", text_color=color.new(#facc15, 0))
            table.cell(dowTable, 3, row, na(cUp) ? "-" : str.tostring(cUp, "#.#") + "%", text_color=colUp)
            table.cell(dowTable, 4, row, na(cDn) ? "-" : str.tostring(cDn, "#.#") + "%", text_color=colDn)
            table.cell(dowTable, 5, row, na(mUp) ? "-" : str.tostring(mUp, "#.##"), text_color=colUp)
            table.cell(dowTable, 6, row, na(mDn) ? "-" : str.tostring(mDn, "#.##"), text_color=colDn)
            table.cell(dowTable, 7, row, na(medUp) ? "-" : str.tostring(medUp, "#.##"), text_color=colUpMuted)
            table.cell(dowTable, 8, row, na(medDn) ? "-" : str.tostring(medDn, "#.##"), text_color=colDnMuted)
            string sModUp = na(modUp) ? "-" : str.tostring(modUp, "#.##")
            string sModDn = na(modDn) ? "-" : str.tostring(modDn, "#.##")
            table.cell(dowTable, 9, row, sModUp, text_color=colUp)
            table.cell(dowTable, 10, row, sModDn, text_color=colDn)
            table.cell(dowTable, 11, row, str.tostring(nDays), text_color=tblTextMuted)
            if i_debugDowTable
                log.info(
                  array.get(dayNames, r) +
                  " N=" + str.tostring(nDays) +
                  " HitUp=" + (na(hUp) ? "-" : str.tostring(hUp, "#.#") + "%") +
                  " HitDn=" + (na(hDn) ? "-" : str.tostring(hDn, "#.#") + "%") +
                  " CompUp=" + (na(cUp) ? "-" : str.tostring(cUp, "#.#") + "%") +
                  " CompDn=" + (na(cDn) ? "-" : str.tostring(cDn, "#.#") + "%") +
                  " MeanHi=" + (na(mUp) ? "-" : str.tostring(mUp, "#.##")) +
                  " MeanLo=" + (na(mDn) ? "-" : str.tostring(mDn, "#.##")) +
                  " MedHi=" + (na(medUp) ? "-" : str.tostring(medUp, "#.##")) +
                  " MdLo=" + (na(medDn) ? "-" : str.tostring(medDn, "#.##")) +
                  " ModeHi=" + (na(modUp) ? "-" : str.tostring(modUp, "#.##")) +
                  " ModeLo=" + (na(modDn) ? "-" : str.tostring(modDn, "#.##")))
            if r == 4
                lastDowDbgBar := bar_index

// % Distance Table
var table pctTable = table.new(f_table_pos(i_pctTablePos), 2, 6, bgcolor=tblBg, border_width=1)
if i_showPctDistanceTable and barstate.islast
    float upperDist = ((upperZoneLo - close) / close) * 100.0
    float lowerDist = ((close - lowerZoneHi) / close) * 100.0
    
    // New calculations for Weekly High/Low distance to EMA
    float wkHighDist = ((currWeekHigh - weeklyEma) / weeklyEma) * 100.0
    float wkLowDist = ((currWeekLow - weeklyEma) / weeklyEma) * 100.0

    table.cell(pctTable, 0, 0, "% DISTANCE", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(pctTable, 1, 0, "Value", text_color=tblText, bgcolor=tblHeaderBg)
    
    table.cell(pctTable, 0, 1, "Close to EMA", text_color=tblText)
    table.cell(pctTable, 1, 1, str.tostring(pctDistance, "#.##") + "%", text_color=tblText)
    
    table.cell(pctTable, 0, 2, "Wk High to EMA", text_color=tblText)
    table.cell(pctTable, 1, 2, "+" + str.tostring(wkHighDist, "#.##") + "%", text_color=colUp)
    
    table.cell(pctTable, 0, 3, "Wk Low to EMA", text_color=tblText)
    table.cell(pctTable, 1, 3, str.tostring(wkLowDist, "#.##") + "%", text_color=colDn)
    
    table.cell(pctTable, 0, 4, "To Upper Lo Lvl", text_color=tblText)
    table.cell(pctTable, 1, 4, str.tostring(upperDist, "#.##") + "%", text_color=tblText)
    
    table.cell(pctTable, 0, 5, "To Lower Hi Lvl", text_color=tblText)
    table.cell(pctTable, 1, 5, str.tostring(lowerDist, "#.##") + "%", text_color=tblText)
    
    for rr = 0 to 5
        for cc = 0 to 1
            table.cell_set_text_size(pctTable, cc, rr, f_table_size(i_pctTableSize))

// ============================================
// ALL LEVELS TABLE (with Hit Rate ↑ and Hit Rate ↓)
// ============================================
var table allLevelsTable = table.new(f_table_pos(i_allLevelsTablePos), 4, 16, bgcolor=tblBg, border_width=1)
if i_showAllLevelsTable and barstate.islast
    // Header row
    table.cell(allLevelsTable, 0, 0, "Level %", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_allLevelsTableSize))
    table.cell(allLevelsTable, 1, 0, "Hit Rate ↑", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_allLevelsTableSize))
    table.cell(allLevelsTable, 2, 0, "Hit Rate ↓", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_allLevelsTableSize))
    table.cell(allLevelsTable, 3, 0, "Status", text_color=tblText, bgcolor=tblHeaderBg, text_size=f_table_size(i_allLevelsTableSize))

    float bestLvl = na
    float bestHr = na
    int nWeeksUp = array.size(weekUpPct)
    int nWeeksDn = array.size(weekDownPct)
    int row = 1
    for i = 1 to 10
        float lvl = i * 0.5
        float hrUp = f_hitrate_level(weekUpPct, lvl)
        float hrDn = f_hitrate_level(weekDownPct, lvl)
        int hitsUp = f_hits_at_level(weekUpPct, lvl)
        int hitsDn = f_hits_at_level(weekDownPct, lvl)
        // Status based on upside hit rate (primary direction)
        string st = f_status(hrUp)
        color stCol = f_status_color(hrUp)
        table.cell(allLevelsTable, 0, row, str.tostring(lvl, "#.#") + "%", text_color=tblText)
        table.cell(allLevelsTable, 1, row, na(hrUp) ? "n/a" : str.tostring(hrUp, "#.#") + "%", text_color=f_status_color(hrUp))
        table.cell(allLevelsTable, 2, row, na(hrDn) ? "n/a" : str.tostring(hrDn, "#.#") + "%", text_color=f_status_color(hrDn))
        table.cell(allLevelsTable, 3, row, st, text_color=stCol)
        string upTip = nWeeksUp == 0 ? "No weekly samples collected yet." : str.tostring(hitsUp) + " out of " + str.tostring(nWeeksUp) + " weeks reached " + str.tostring(lvl, "#.#") + "% above EMA."
        string dnTip = nWeeksDn == 0 ? "No weekly samples collected yet." : str.tostring(hitsDn) + " out of " + str.tostring(nWeeksDn) + " weeks reached " + str.tostring(lvl, "#.#") + "% below EMA."
        table.cell_set_tooltip(allLevelsTable, 1, row, upTip)
        table.cell_set_tooltip(allLevelsTable, 2, row, dnTip)
        // Best level = highest level that still has ≥50% hit rate
        if not na(hrUp) and hrUp >= 50.0
            bestHr := hrUp
            bestLvl := lvl
        row += 1

    // Separator
    table.cell(allLevelsTable, 0, 12, "", bgcolor=tblHeaderBg)
    table.cell(allLevelsTable, 1, 12, "", bgcolor=tblHeaderBg)
    table.cell(allLevelsTable, 2, 12, "", bgcolor=tblHeaderBg)
    table.cell(allLevelsTable, 3, 12, "", bgcolor=tblHeaderBg)

    // Best Level row
    table.cell(allLevelsTable, 0, 13, "Best Level", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(allLevelsTable, 1, 13, na(bestLvl) ? "n/a" : str.tostring(bestLvl, "#.#") + "%", text_color=tblText)
    table.cell(allLevelsTable, 2, 13, na(bestHr) ? "" : str.tostring(bestHr, "#.#") + "%", text_color=tblText)
    table.cell(allLevelsTable, 3, 13, f_status(bestHr), text_color=f_status_color(bestHr))

    // Calculate Mode specifically for the 0.5 bins used in the All Levels table
    float upBinMode = f_mode_nearest_mean(weekUpPct, 0.5)
    float dnBinMode = f_mode_nearest_mean(weekDownPct, 0.5)

    // Statistics summary row (Mean/Med/Mode for ↑ and ↓)
    table.cell(allLevelsTable, 0, 14, "Mean/Med/Mode", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(allLevelsTable, 1, 14, str.tostring(upMean, "#.#") + "/" + str.tostring(upMedian, "#.#") + "/" + str.tostring(upBinMode, "#.#"), text_color=tblTextMuted)
    table.cell(allLevelsTable, 2, 14, str.tostring(dnMean, "#.#") + "/" + str.tostring(dnMedian, "#.#") + "/" + str.tostring(dnBinMode, "#.#"), text_color=tblTextMuted)
    table.cell(allLevelsTable, 3, 14, "", text_color=tblTextMuted)

    // Statistics detail row
    table.cell(allLevelsTable, 0, 15, "↑ / ↓", text_color=tblTextMuted, bgcolor=tblHeaderBg)
    table.cell(allLevelsTable, 1, 15, "Above EMA", text_color=tblTextMuted)
    table.cell(allLevelsTable, 2, 15, "Below EMA", text_color=tblTextMuted)
    table.cell(allLevelsTable, 3, 15, "", text_color=tblTextMuted)

    for rr = 0 to 15
        for cc = 0 to 3
            table.cell_set_text_size(allLevelsTable, cc, rr, f_table_size(i_allLevelsTableSize))

// Position Table
var table positionTable = table.new(f_table_pos(i_positionTablePos), 2, 5, bgcolor=tblBg, border_width=1)
if i_showPositionTable and barstate.islast
    string pmState = close >= prevMonthMid ? "Above" : "Below"
    string nfpState = na(nfpHigh) and na(nfpLow) ? "No NFP candle" : (close > nfpHigh ? "Above NFP High" : close < nfpLow ? "Below NFP Low" : "Inside NFP Range")
    table.cell(positionTable, 0, 0, "Level", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(positionTable, 1, 0, "Position", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(positionTable, 0, 1, "Prev Month Mid", text_color=tblText)
    table.cell(positionTable, 1, 1, pmState, text_color=tblText)
    table.cell(positionTable, 0, 2, "NFP Friday", text_color=tblText)
    table.cell(positionTable, 1, 2, nfpState, text_color=tblText)
    table.cell(positionTable, 0, 3, "Weekly EMA", text_color=tblText)
    table.cell(positionTable, 1, 3, close >= weeklyEma ? "Above" : "Below", text_color=tblText)
    table.cell(positionTable, 0, 4, "2-3% Zone", text_color=tblText)
    table.cell(positionTable, 1, 4, pctDistance >= i_zoneStartPct and pctDistance <= i_zoneEndPct ? "Inside" : "Outside", text_color=tblText)
    for rr = 0 to 4
        for cc = 0 to 1
            table.cell_set_text_size(positionTable, cc, rr, f_table_size(i_positionTableSize))

// Range Analysis Tables
if barstate.islast
    rangeMean := f_mean(rangePcts)
    rangeMedian := f_median(rangePcts)
    rangeMode := f_mode_nearest_mean(rangePcts, 0.1)
    rangeHitRate := f_hitrate_bool(rangeZoneHits)

var table rangeProbTable = table.new(f_table_pos(i_rangeProbTablePos), 2, 6, bgcolor=tblBg, border_width=1)
if i_showRangeAnalysis and i_showRangeProbTable and barstate.islast
    table.cell(rangeProbTable, 0, 0, "RANGE PROB", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(rangeProbTable, 1, 0, "Value", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(rangeProbTable, 0, 1, "Samples")
    table.cell(rangeProbTable, 1, 1, str.tostring(array.size(rangePcts)))
    table.cell(rangeProbTable, 0, 2, "Hit Rate")
    table.cell(rangeProbTable, 1, 2, str.tostring(rangeHitRate, "#.#") + "%", text_color=f_status_color(rangeHitRate))
    table.cell(rangeProbTable, 0, 3, "Status")
    table.cell(rangeProbTable, 1, 3, f_status(rangeHitRate), text_color=f_status_color(rangeHitRate))
    table.cell(rangeProbTable, 0, 4, "Zone")
    table.cell(rangeProbTable, 1, 4, str.tostring(i_rangeZoneFrom, "#.#") + "-" + str.tostring(i_rangeZoneTo, "#.#") + "%")
    table.cell(rangeProbTable, 0, 5, "Method")
    table.cell(rangeProbTable, 1, 5, i_analysisMethod)
    for rr = 0 to 5
        for cc = 0 to 1
            table.cell_set_text_size(rangeProbTable, cc, rr, f_table_size(i_rangeProbTableSize))

var table rangeLevelsTable = table.new(f_table_pos(i_rangeLevelsTablePos), 3, 5, bgcolor=tblBg, border_width=1)
if i_showRangeAnalysis and i_showRangeLevelsTable and barstate.islast
    table.cell(rangeLevelsTable, 0, 0, "RANGE", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(rangeLevelsTable, 1, 0, "Stat", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(rangeLevelsTable, 2, 0, "Value", text_color=tblText, bgcolor=tblHeaderBg)
    table.cell(rangeLevelsTable, 0, 1, i_rangeDow)
    table.cell(rangeLevelsTable, 1, 1, "Mean")
    table.cell(rangeLevelsTable, 2, 1, str.tostring(rangeMean, "#.##") + "%")
    table.cell(rangeLevelsTable, 0, 2, i_rangeDow)
    table.cell(rangeLevelsTable, 1, 2, "Median")
    table.cell(rangeLevelsTable, 2, 2, str.tostring(rangeMedian, "#.##") + "%")
    table.cell(rangeLevelsTable, 0, 3, i_rangeDow)
    table.cell(rangeLevelsTable, 1, 3, "Mode")
    table.cell(rangeLevelsTable, 2, 3, str.tostring(rangeMode, "#.##") + "%")
    table.cell(rangeLevelsTable, 0, 4, i_rangeDow)
    table.cell(rangeLevelsTable, 1, 4, "Hit%")
    table.cell(rangeLevelsTable, 2, 4, str.tostring(rangeHitRate, "#.##") + "%")
    for rr = 0 to 4
        for cc = 0 to 2
            table.cell_set_text_size(rangeLevelsTable, cc, rr, f_table_size(i_rangeLevelsTableSize))
