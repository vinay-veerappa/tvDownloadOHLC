//@version=6
indicator("Daily NY Levels v7 (v3 Library Migration)", overlay=true, max_bars_back=5000, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// Daily NY Levels v7 — Spec-aligned migration onto v3 family libraries
// Author: vveerappa | Version: 7
// ============================================================================
// Migration notes (vs v5):
//   - All family library imports updated to /3
//   - Stat lines now use HLevels semantic renderers (f_draw_confirm_level,
//     f_draw_stretch_level, f_draw_target_level_pN, etc.) instead of the
//     hand-rolled f_draw_labeled_stat_line_meta
//   - theme_mode propagated throughout (Dark/Light theme toggle now works)
//   - Tier-driven styling: Confirm=C, Target/Avg=S, Stretch/Pivot=P
//   - Session mid now uses HLevels.f_draw_priority_line with neutral color
//     (session_mid_level expects a session-specific palette token; for a generic
//     mid line, priority_line is the better fit)
//   - Time-distribution vline calls updated to Core.f_draw_vline (signature fix)
//   - Tables now propagate theme_mode to correctly theme-resolve every color
//
// Libraries required (publish order: Core first, then family libs, then this):
//   - vveerappa/RangeSessionLib/6
//   - vveerappa/PineDrawingCore/3
//   - vveerappa/PineDrawingHorizontalLevels/3
//   - vveerappa/PineDrawingMarkers/3
//   - vveerappa/PineDrawingZones/3
//   - vveerappa/PineDrawingTables/3
//   - vveerappa/PineDrawingVerticalMarkers/3
//   - vveerappa/StatsLib/2
// ============================================================================

import vveerappa/RangeSessionLib/6 as RSL
import vveerappa/PineDrawingCore/3 as Core
import vveerappa/PineDrawingHorizontalLevels/3 as HLevels
import vveerappa/PineDrawingMarkers/3 as Markers
import vveerappa/PineDrawingZones/3 as Zones
import vveerappa/PineDrawingTables/4 as Tables
import vveerappa/PineDrawingVerticalMarkers/3 as VMarks
import vveerappa/StatsLib/2 as STL

// ============================================================================
// Inputs
// ============================================================================

grp_theme = "Theme"
i_theme_mode = input.string("Dark", "Color Theme", options=["Custom", "Dark", "Light"], group=grp_theme)
i_display_profile = input.string("Normal", "Display Profile", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_theme)

grp_session = "Session & Presets"
i_preset = input.string("Market Open", "Preset", options=["1800 Break", "0300 Break", "0300 Transfer", "Q1 Break", "Market Open", "Magic Hour", "1100 BO", "Lunch Break", "1400 Break", "Custom"], group=grp_session)
i_custom_start = input.string("0930", "Custom OR Start (HHMM)", group=grp_session)
i_custom_end = input.string("0935", "Custom OR End (HHMM)", group=grp_session)
i_custom_cutoff = input.string("1200", "Custom Cutoff (HHMM)", group=grp_session)
i_timezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "America/Denver", "US/Eastern", "US/Central", "UTC"], group=grp_session)
i_ev_target_pct = input.float(0.30, "EV Target (%)", minval=0.01, step=0.01, group=grp_session)

grp_style = "Style (Custom Theme)"
i_bull_color = input.color(color.green, "Bull Color (Custom)", group=grp_style)
i_bear_color = input.color(color.red, "Bear Color (Custom)", group=grp_style)
i_box_style = input.string("Solid", "OR Box Style", options=["Solid", "Dashed", "Dotted"], group=grp_style)
i_box_width = input.int(1, "OR Box Width", minval=1, maxval=5, group=grp_style)

grp_lines = "Stat Lines"
i_show_stat_lines = input.bool(true, "Show Stat Lines", group=grp_lines)
i_show_histogram = input.bool(true, "Show Histogram Bands", group=grp_lines)
i_hist_start_pct = input.int(20, "Histogram Start Percentile", minval=1, maxval=98, group=grp_lines)
i_hist_end_pct = input.int(90, "Histogram End Percentile", minval=2, maxval=99, group=grp_lines)
i_hist_pct_step = input.int(5, "Histogram Percentile Step", minval=1, maxval=25, group=grp_lines)
i_show_hist_bin_labels = input.bool(true, "Show Histogram Bin Labels", group=grp_lines)
i_pct_confirm = input.int(20, "Confirm Percentile", minval=1, maxval=99, group=grp_lines)
i_pct_target1 = input.int(50, "Target1 Percentile", minval=1, maxval=99, group=grp_lines)
i_pct_target2 = input.int(75, "Target2 Percentile", minval=1, maxval=99, group=grp_lines)
i_pct_stretch = input.int(90, "Stretch Percentile", minval=1, maxval=99, group=grp_lines)
i_right_extend_bars = input.int(5, "Line Right Extension", minval=1, maxval=200, group=grp_lines)

grp_time = "Hit Time Distribution"
i_show_time_dist    = input.bool(true,  "Show Time Distribution",     group=grp_time)
i_time_bucket_mins  = input.int(5,      "Time Bucket (minutes)",      minval=1, maxval=60, group=grp_time)
i_time_offset_ticks = input.int(200,    "Offset Below MFE (ticks)",   group=grp_time)
i_show_time_avg     = input.bool(true,  "Show AVG Line",              group=grp_time)
i_show_time_med     = input.bool(true,  "Show Median Line",           group=grp_time)
i_time_bull_color   = input.color(color.new(color.green, 80),         "Bull Bar Color (Custom)", group=grp_time)
i_time_bear_color   = input.color(color.new(color.red, 80),           "Bear Bar Color (Custom)", group=grp_time)

grp_table = "Data Table"
i_show_table = input.bool(true, "Show Data Table", group=grp_table)
i_table_view = input.string("MFE View", "Table View", options=["MFE View", "MAE View", "DOW View", "Fakeout View"], group=grp_table)
i_table_pos = input.string("Bottom Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grp_table)

grp_debug = "Debug"
i_show_debug = input.bool(false, "Show Debug Labels", group=grp_debug)

// ============================================================================
// Theme resolution
// ============================================================================
// The family libraries expect theme_mode="Dark" or "Light". For "Custom",
// fall back to Dark for semantic renderer lookups (they resolve palette tokens
// from Core, and Custom colors are only used where the user's custom override
// is specifically applied via color.new).
string theme_mode_resolved = i_theme_mode == "Light" ? "Light" : "Dark"

// ============================================================================
// Runtime state
// ============================================================================

var array<RSL.RangeSpec> specs = array.new<RSL.RangeSpec>(0)
var array<RSL.RangeState> states = array.new<RSL.RangeState>(0)
var array<STL.ExcursionHistory> histories = array.new<STL.ExcursionHistory>(0)
var array<Core.PineDrawingState> drawings = array.new<Core.PineDrawingState>(0)
var array<bool> prev_in_or = array.new_bool(0)
var array<bool> prev_in_data = array.new_bool(0)

f_init_runtime() =>
    array.clear(specs)
    array.clear(states)
    array.clear(histories)
    array.clear(drawings)
    array.clear(prev_in_or)
    array.clear(prev_in_data)

    array<RSL.RangeSpec> resolved = RSL.f_resolve_preset(i_preset, i_custom_start, i_custom_end, i_custom_cutoff, i_timezone)
    int n = array.size(resolved)
    if n > 0
        for i = 0 to n - 1
            RSL.RangeSpec sp = array.get(resolved, i)
            array.push(specs, sp)
            array.push(states, RSL.f_new_range_state(sp))
            array.push(histories, STL.f_new_excursion_history(sp.name))
            array.push(drawings, Core.f_new_drawing_state())
            array.push(prev_in_or, false)
            array.push(prev_in_data, false)

if barstate.isfirst
    f_init_runtime()

// Lower timeframe cache once per bar.
[ltf_high_arr, ltf_low_arr, ltf_close_arr, ltf_time_arr] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, close, time])
int ny_dow = dayofweek(time, i_timezone)


f_or_color(int idx) =>
    color bull_base = Core.f_resolve_color(i_theme_mode, color.new(i_bull_color, 0), #38BD8A, #008060)
    color bear_base = Core.f_resolve_color(i_theme_mode, color.new(i_bear_color, 0), #F87171, #B3261E)
    color base = idx % 2 == 0 ? bull_base : bear_base
    color.new(base, math.min(15 + idx * 10, 75))

// ============================================================================
// Session tracking (unchanged from v5 — this is indicator-specific logic)
// ============================================================================

f_track_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    bool in_or = RSL.f_in_session_pine(sp.session_or, sp.tz)
    bool in_data = RSL.f_in_session_pine(sp.session_data, sp.tz)

    bool was_in_or = array.get(prev_in_or, idx)
    bool is_new_session = in_or and not was_in_or
    array.set(prev_in_or, idx, in_or)

    if is_new_session and not st.is_committed and st.ref_set and not na(st.bull_ref)
        float pb_bull = na(st.daily_mae_bull_pb) ? 0.0 : st.daily_mae_bull_pb
        float pb_bear = na(st.daily_mae_bear_pb) ? 0.0 : st.daily_mae_bear_pb
        int direction = na
        if sp.is_transfer
            direction := (st.or_high > st.session_open) ? 1 : -1
        STL.f_commit_daily(hist, st.daily_bull_mfe, st.daily_bear_mfe, 0.0, 0.0, st.daily_bull_peak_min, st.daily_bear_peak_min, st.daily_pivot_bulls, st.daily_pivot_bears, st.daily_mae_bull_abs, st.daily_mae_bear_abs, pb_bull, pb_bear, 0.0, 0.0, st.mid_hit_bull, st.mid_hit_bear, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.session_low_data, st.session_high_data, i_ev_target_pct)
        st.is_committed := true

    if is_new_session
        RSL.f_reset_daily(st)

    bool ltf_or_found = false
    int ltf_count = array.size(ltf_time_arr)
    if ltf_count > 0
        for j = 0 to ltf_count - 1
            int t = array.get(ltf_time_arr, j)
            int m = RSL.f_mins_of_day(t, sp.tz)
            bool in_or_m = RSL.f_in_session_minutes(m, sp.or_start_min, sp.or_end_min, sp.or_end_min < sp.or_start_min)
            if in_or_m
                float h = array.get(ltf_high_arr, j)
                float l = array.get(ltf_low_arr, j)
                float c = array.get(ltf_close_arr, j)
                if not st.or_building
                    st.or_high := h
                    st.or_low := l
                    st.or_last_close := c
                    st.or_building := true
                    st.or_start_bar := bar_index
                else
                    st.or_high := math.max(st.or_high, h)
                    st.or_low := math.min(st.or_low, l)
                    st.or_last_close := c
                ltf_or_found := true

    if in_or and not ltf_or_found
        if not st.or_building
            st.or_high := high
            st.or_low := low
            st.or_last_close := close
            st.or_building := true
            st.or_start_bar := bar_index
        else
            st.or_high := math.max(st.or_high, high)
            st.or_low := math.min(st.or_low, low)
            st.or_last_close := close

    if st.or_building and not st.or_complete and not in_or and not ltf_or_found
        st.or_complete := true

    if st.or_complete and not st.ref_set and not na(st.or_high)
        st.bull_ref := st.or_high
        st.bear_ref := st.or_low
        st.or_mid := (st.or_high + st.or_low) / 2.0
        st.session_open := st.or_last_close
        st.ref_set := true

    bool ltf_in_data = false
    if st.ref_set and ltf_count > 0
        for j = 0 to ltf_count - 1
            int t = array.get(ltf_time_arr, j)
            int m = RSL.f_mins_of_day(t, sp.tz)
            bool in_data_m = RSL.f_in_session_minutes(m, sp.or_end_min, sp.cutoff_min, sp.cutoff_min < sp.or_end_min)
            if in_data_m
                ltf_in_data := true
                float h = array.get(ltf_high_arr, j)
                float l = array.get(ltf_low_arr, j)
                float c = array.get(ltf_close_arr, j)
                int mins_since_or = RSL.f_mins_since(m, sp.or_start_min)
                [nb, ns, nbp, nsp] = STL.f_track_mfe(h, l, mins_since_or, st.bull_ref, st.bear_ref, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bull_peak_min, st.daily_bear_peak_min)
                st.daily_bull_mfe := nb
                st.daily_bear_mfe := ns
                st.daily_bull_peak_min := nbp
                st.daily_bear_peak_min := nsp
                [mab, mas] = STL.f_track_mae_abs(h, l, st.or_low, st.or_high, st.daily_mae_bull_abs, st.daily_mae_bear_abs)
                st.daily_mae_bull_abs := mab
                st.daily_mae_bear_abs := mas
                bool bull_peak_finalized = mins_since_or >= st.daily_bull_peak_min
                bool bear_peak_finalized = mins_since_or >= st.daily_bear_peak_min
                [mpb, mps] = STL.f_track_mae_pullback(h, l, st.or_high, st.or_low, bull_peak_finalized, bear_peak_finalized, st.daily_mae_bull_pb, st.daily_mae_bear_pb)
                st.daily_mae_bull_pb := mpb
                st.daily_mae_bear_pb := mps
                array.push(st.data_mins, mins_since_or)
                array.push(st.data_highs, h)
                array.push(st.data_lows, l)
                [mhb, mhs] = STL.f_track_mid_hit(h, l, st.or_mid, st.mid_hit_bull, st.mid_hit_bear)
                st.mid_hit_bull := mhb
                st.mid_hit_bear := mhs
                if h > st.bull_ref
                    st.entry_triggered_bull := true
                    array.push(st.daily_pivot_bulls, (h - st.bull_ref) / st.bull_ref * 100.0)
                if l < st.bear_ref
                    st.entry_triggered_bear := true
                    array.push(st.daily_pivot_bears, (st.bear_ref - l) / st.bear_ref * 100.0)
                st.session_low_data := na(st.session_low_data) ? l : math.min(st.session_low_data, l)
                st.session_high_data := na(st.session_high_data) ? h : math.max(st.session_high_data, h)
                st.close_at_cutoff := c

    if st.ref_set and in_data and not ltf_in_data
        int mins_since_or = RSL.f_mins_since(RSL.f_mins_of_day(time, sp.tz), sp.or_start_min)
        [nb, ns, nbp, nsp] = STL.f_track_mfe(high, low, mins_since_or, st.bull_ref, st.bear_ref, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bull_peak_min, st.daily_bear_peak_min)
        st.daily_bull_mfe := nb
        st.daily_bear_mfe := ns
        st.daily_bull_peak_min := nbp
        st.daily_bear_peak_min := nsp
        [mab, mas] = STL.f_track_mae_abs(high, low, st.or_low, st.or_high, st.daily_mae_bull_abs, st.daily_mae_bear_abs)
        st.daily_mae_bull_abs := mab
        st.daily_mae_bear_abs := mas
        bool bull_peak_finalized = mins_since_or >= st.daily_bull_peak_min
        bool bear_peak_finalized = mins_since_or >= st.daily_bear_peak_min
        [mpb, mps] = STL.f_track_mae_pullback(high, low, st.or_high, st.or_low, bull_peak_finalized, bear_peak_finalized, st.daily_mae_bull_pb, st.daily_mae_bear_pb)
        st.daily_mae_bull_pb := mpb
        st.daily_mae_bear_pb := mps
        array.push(st.data_mins, mins_since_or)
        array.push(st.data_highs, high)
        array.push(st.data_lows, low)
        [mhb, mhs] = STL.f_track_mid_hit(high, low, st.or_mid, st.mid_hit_bull, st.mid_hit_bear)
        st.mid_hit_bull := mhb
        st.mid_hit_bear := mhs
        if high > st.bull_ref
            st.entry_triggered_bull := true
            array.push(st.daily_pivot_bulls, (high - st.bull_ref) / st.bull_ref * 100.0)
        if low < st.bear_ref
            st.entry_triggered_bear := true
            array.push(st.daily_pivot_bears, (st.bear_ref - low) / st.bear_ref * 100.0)
        st.session_low_data := na(st.session_low_data) ? low : math.min(st.session_low_data, low)
        st.session_high_data := na(st.session_high_data) ? high : math.max(st.session_high_data, high)
        st.close_at_cutoff := close

    bool effective_in_data = in_data or ltf_in_data
    bool was_in_data = array.get(prev_in_data, idx)
    bool data_just_ended = was_in_data and not effective_in_data
    array.set(prev_in_data, idx, effective_in_data)

    if data_just_ended and not st.is_committed and st.ref_set
        float pb_bull = na(st.daily_mae_bull_pb) ? 0.0 : st.daily_mae_bull_pb
        float pb_bear = na(st.daily_mae_bear_pb) ? 0.0 : st.daily_mae_bear_pb
        int direction = na
        if sp.is_transfer
            direction := (st.or_high > st.session_open) ? 1 : -1
        STL.f_commit_daily(hist, st.daily_bull_mfe, st.daily_bear_mfe, 0.0, 0.0, st.daily_bull_peak_min, st.daily_bear_peak_min, st.daily_pivot_bulls, st.daily_pivot_bears, st.daily_mae_bull_abs, st.daily_mae_bear_abs, pb_bull, pb_bear, 0.0, 0.0, st.mid_hit_bull, st.mid_hit_bear, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.session_low_data, st.session_high_data, i_ev_target_pct)
        st.is_committed := true

    array.set(states, idx, st)
    array.set(histories, idx, hist)

if array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_track_range(i)

// ============================================================================
// Rendering
// ============================================================================

f_render_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)
    Core.PineDrawingState ds = array.get(drawings, idx)

    Core.f_clear_all(ds)

    // Custom-theme colors used for OR box and histogram fills (user-driven)
    color bull_color = Core.f_resolve_color(i_theme_mode, color.new(i_bull_color, 0), #38BD8A, #008060)
    color bear_color = Core.f_resolve_color(i_theme_mode, color.new(i_bear_color, 0), #F87171, #B3261E)
    color stat_label_color = Core.f_theme_color("text_primary", theme_mode_resolved)
    color time_title_color = Core.f_theme_color("caution", theme_mode_resolved)
    color time_bull_color = Core.f_resolve_color(i_theme_mode, color.new(i_time_bull_color, 0), color.new(#38BD8A, 80), color.new(#008060, 80))
    color time_bear_color = Core.f_resolve_color(i_theme_mode, color.new(i_time_bear_color, 0), color.new(#F87171, 80), color.new(#B3261E, 80))
    color stat_avg_color = Core.f_theme_color("average", theme_mode_resolved)
    color stat_median_color = Core.f_theme_color("median", theme_mode_resolved)
    
    string time_label_size = Core.f_display_profile_label_size("tiny", i_display_profile)
    string stat_label_size = Core.f_display_profile_label_size("normal", i_display_profile)
    string debug_label_size = "normal"
    int or_box_width = Core.f_display_profile_width(i_box_width, i_display_profile)
    int hist_fill_transparency = Core.f_display_profile_transparency(58, i_display_profile)
    Core.LabelRegistry lbl_reg = Core.f_label_registry_begin()

    int tf_min = timeframe.isintraday ? timeframe.multiplier : 1
    int total_mins_to_cutoff = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
    int bars_to_cutoff = int(math.max(1.0, math.ceil(float(total_mins_to_cutoff) / float(tf_min))))
    int cutoff_bar = st.or_start_bar + bars_to_cutoff
    cutoff_bar := math.min(cutoff_bar, bar_index)
    int line_render_end = cutoff_bar + i_right_extend_bars

    // OR box (custom theme colors)
    if st.or_building and not na(st.or_start_bar)
        Zones.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx), i_box_style, or_box_width)
    else if st.or_complete and not na(st.or_start_bar)
        Zones.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx), i_box_style, or_box_width)

    if i_show_debug and st.or_building and not na(st.or_start_bar)
        Markers.f_draw_text_marker(ds, bar_index, st.or_high, "NEW: " + sp.name, stat_label_color, "down", debug_label_size)

    // ========================================================================
    // Stat lines — migrated to semantic renderers
    // ========================================================================
    if i_show_stat_lines and st.ref_set and not na(st.bull_ref)
        array<float> bull_filtered = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear_filtered = STL.f_build_filtered(hist.mfe_bear)
        int ln_start = st.or_start_bar
        int ln_end = line_render_end
        string bull_tag_base = sp.name + "_bull"
        string bear_tag_base = sp.name + "_bear"
        string unit_str = "%"

        // BULL STAT LINES
        if array.size(bull_filtered) > 0
            float p_confirm_b = array.percentile_nearest_rank(bull_filtered, i_pct_confirm)
            float p_t1_b = array.percentile_nearest_rank(bull_filtered, i_pct_target1)
            float p_t2_b = array.percentile_nearest_rank(bull_filtered, i_pct_target2)
            float p_stretch_b = array.percentile_nearest_rank(bull_filtered, i_pct_stretch)
            float p_avg_b = array.avg(bull_filtered)
            float y_confirm_b = st.bull_ref * (1.0 + p_confirm_b / 100.0)
            float y_t1_b = st.bull_ref * (1.0 + p_t1_b / 100.0)
            float y_t2_b = st.bull_ref * (1.0 + p_t2_b / 100.0)
            float y_stretch_b = st.bull_ref * (1.0 + p_stretch_b / 100.0)
            float y_avg_b = st.bull_ref * (1.0 + p_avg_b / 100.0)
            
            // Confirm level — tier C, direction bull (renders in 'positive' color per §2.3)
            HLevels.f_draw_confirm_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "C", ln_start, ln_end, y_confirm_b, "bull", str.tostring(int(i_pct_confirm)), STL.f_pct_fmt(p_confirm_b), unit_str, sp.name + " MFE", bull_tag_base + "_confirm", 0)
            
            // Target P50 — tier P (pivot_structural color), with qualifier for source name
            HLevels.f_draw_target_level_p50(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", ln_start, ln_end, y_t1_b, sp.name + " Bull", "MFE", STL.f_pct_fmt(p_t1_b), unit_str, bull_tag_base + "_t1", 0)
            
            // Target P75 — tier S
            HLevels.f_draw_target_level_p75(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", ln_start, ln_end, y_t2_b, sp.name + " Bull", "MFE", STL.f_pct_fmt(p_t2_b), unit_str, bull_tag_base + "_t2", 0)
            
            // Stretch — tier P, renders in 'stretch' color per spec §2.2
            HLevels.f_draw_stretch_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", ln_start, ln_end, y_stretch_b, sp.name + " Bull", str.tostring(int(i_pct_stretch)), STL.f_pct_fmt(p_stretch_b), unit_str, bull_tag_base + "_stretch", 0)
            
            // Average — tier S, renders in 'average' color per spec §2.2
            HLevels.f_draw_statistical_level_avg(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", ln_start, ln_end, y_avg_b, sp.name + " Bull MFE", STL.f_pct_fmt(p_avg_b), unit_str, bull_tag_base + "_avg", 0)

        // BEAR STAT LINES
        if array.size(bear_filtered) > 0
            float p_confirm_s = array.percentile_nearest_rank(bear_filtered, i_pct_confirm)
            float p_t1_s = array.percentile_nearest_rank(bear_filtered, i_pct_target1)
            float p_t2_s = array.percentile_nearest_rank(bear_filtered, i_pct_target2)
            float p_stretch_s = array.percentile_nearest_rank(bear_filtered, i_pct_stretch)
            float p_avg_s = array.avg(bear_filtered)
            float y_confirm_s = st.bear_ref * (1.0 - p_confirm_s / 100.0)
            float y_t1_s = st.bear_ref * (1.0 - p_t1_s / 100.0)
            float y_t2_s = st.bear_ref * (1.0 - p_t2_s / 100.0)
            float y_stretch_s = st.bear_ref * (1.0 - p_stretch_s / 100.0)
            float y_avg_s = st.bear_ref * (1.0 - p_avg_s / 100.0)
            
            HLevels.f_draw_confirm_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "C", ln_start, ln_end, y_confirm_s, "bear", str.tostring(int(i_pct_confirm)), STL.f_pct_fmt(p_confirm_s), unit_str, sp.name + " MFE", bear_tag_base + "_confirm", 0)
            HLevels.f_draw_target_level_p50(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", ln_start, ln_end, y_t1_s, sp.name + " Bear", "MFE", STL.f_pct_fmt(p_t1_s), unit_str, bear_tag_base + "_t1", 0)
            HLevels.f_draw_target_level_p75(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", ln_start, ln_end, y_t2_s, sp.name + " Bear", "MFE", STL.f_pct_fmt(p_t2_s), unit_str, bear_tag_base + "_t2", 0)
            HLevels.f_draw_stretch_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", ln_start, ln_end, y_stretch_s, sp.name + " Bear", str.tostring(int(i_pct_stretch)), STL.f_pct_fmt(p_stretch_s), unit_str, bear_tag_base + "_stretch", 0)
            HLevels.f_draw_statistical_level_avg(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", ln_start, ln_end, y_avg_s, sp.name + " Bear MFE", STL.f_pct_fmt(p_avg_s), unit_str, bear_tag_base + "_avg", 0)

        // Mid line (session mid) — renders with hit_rate data slot
        int n_mid = math.min(array.size(hist.mid_hit_bull), array.size(hist.mid_hit_bear))
        int mid_hits = 0
        if n_mid > 0
            for k = 0 to n_mid - 1
                mid_hits += array.get(hist.mid_hit_bull, k) ? 1 : 0
                mid_hits += array.get(hist.mid_hit_bear, k) ? 1 : 0
        float mid_hit_pct = n_mid == 0 ? na : (float(mid_hits) / float(2 * n_mid)) * 100.0
        string mid_hit_str = na(mid_hit_pct) ? "" : str.tostring(mid_hit_pct, "#.0")
        
        // Mid line uses priority_line with neutral color (session_mid_level expects a session_token)
        string mid_label = sp.name + " Mid" + (na(mid_hit_pct) ? "" : " " + mid_hit_str + "%")
        HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", ln_start, ln_end, st.or_mid, mid_label, Core.f_theme_color("neutral", theme_mode_resolved), 25, sp.name + "_mid", 0)

    // ========================================================================
    // MFE Histogram (indicator-specific; stays custom)
    // ========================================================================
    if i_show_histogram and st.ref_set and not na(st.bull_ref)
        array<float> bull_filtered = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear_filtered = STL.f_build_filtered(hist.mfe_bear)

        int max_profile_width = math.max(6, cutoff_bar - st.or_start_bar)
        int hist_pct_start = math.min(i_hist_start_pct, i_hist_end_pct - 1)
        int hist_pct_end = math.max(i_hist_end_pct, hist_pct_start + 1)
        int hist_pct_step = math.max(1, i_hist_pct_step)
        int hist_bin_count = int(math.ceil(float(hist_pct_end - hist_pct_start) / float(hist_pct_step)))

        // BULL HISTOGRAM
        if array.size(bull_filtered) > 0
            array<float> bull_val_los = array.new_float(0)
            array<float> bull_val_his = array.new_float(0)
            array<float> bull_densities = array.new_float(0)
            array<float> bull_pct_los = array.new_float(0)
            array<float> bull_pct_his = array.new_float(0)

            for b = 0 to hist_bin_count - 1
                float p_lo = hist_pct_start + float(hist_pct_step * b)
                float p_hi = math.min(hist_pct_end, p_lo + hist_pct_step)
                float v_lo = array.percentile_nearest_rank(bull_filtered, p_lo)
                float v_hi = array.percentile_nearest_rank(bull_filtered, p_hi)
                float band_span = math.max(v_hi - v_lo, 0.0001)
                int count = 0
                for s = 0 to array.size(bull_filtered) - 1
                    float val = array.get(bull_filtered, s)
                    if val >= v_lo and (b == hist_bin_count - 1 ? val <= v_hi : val < v_hi)
                        count += 1
                array.push(bull_val_los, v_lo)
                array.push(bull_val_his, v_hi)
                array.push(bull_densities, float(count) / band_span)
                array.push(bull_pct_los, p_lo)
                array.push(bull_pct_his, p_hi)

            float bull_p20_density = na
            for b = 0 to hist_bin_count - 1
                if array.get(bull_pct_los, b) >= 20.0 and na(bull_p20_density)
                    bull_p20_density := array.get(bull_densities, b)
            if not na(bull_p20_density)
                for b = 0 to hist_bin_count - 1
                    if array.get(bull_pct_los, b) < 20.0
                        array.set(bull_densities, b, math.min(array.get(bull_densities, b), bull_p20_density))

            float max_density = 0.0
            for b = 0 to hist_bin_count - 1
                max_density := math.max(max_density, array.get(bull_densities, b))

            for b = 0 to hist_bin_count - 1
                float v_lo = array.get(bull_val_los, b)
                float v_hi = array.get(bull_val_his, b)
                float density = array.get(bull_densities, b)
                float p_lo = array.get(bull_pct_los, b)
                float p_hi = array.get(bull_pct_his, b)
                float width_normalized = max_density > 0 ? density / max_density : 0.0
                int box_width = math.max(2, int(math.round(width_normalized * float(max_profile_width))))

                if v_hi >= v_lo
                    float y_low = st.bull_ref * (1.0 + v_lo / 100.0)
                    float y_high = st.bull_ref * (1.0 + v_hi / 100.0)
                    Zones.f_draw_hist_band(ds, st.or_start_bar, y_high, y_low, box_width, bull_color, hist_fill_transparency)
                    if i_show_hist_bin_labels
                        float y_mid = (y_high + y_low) / 2.0
                        Core.f_draw_stat_label(ds, st.or_start_bar - 1, y_mid, str.tostring(int(math.round(p_lo))) + "th", stat_label_color, "right", stat_label_size)
                    if i_show_debug
                        float y_mid = (y_high + y_low) / 2.0
                        Markers.f_draw_text_marker(ds, bar_index, y_mid, "B P" + str.tostring(p_lo, "#.0") + "-P" + str.tostring(p_hi, "#.0") + " v=" + str.tostring(v_lo, "#.##") + "-" + str.tostring(v_hi, "#.##"), stat_label_color, "center", debug_label_size)

        // BEAR HISTOGRAM
        if array.size(bear_filtered) > 0
            array<float> bear_val_los = array.new_float(0)
            array<float> bear_val_his = array.new_float(0)
            array<float> bear_densities = array.new_float(0)
            array<float> bear_pct_los = array.new_float(0)
            array<float> bear_pct_his = array.new_float(0)

            for b = 0 to hist_bin_count - 1
                float p_lo = hist_pct_start + float(hist_pct_step * b)
                float p_hi = math.min(hist_pct_end, p_lo + hist_pct_step)
                float v_lo = array.percentile_nearest_rank(bear_filtered, p_lo)
                float v_hi = array.percentile_nearest_rank(bear_filtered, p_hi)
                float band_span = math.max(v_hi - v_lo, 0.0001)
                int count = 0
                for s = 0 to array.size(bear_filtered) - 1
                    float val = array.get(bear_filtered, s)
                    if val >= v_lo and (b == hist_bin_count - 1 ? val <= v_hi : val < v_hi)
                        count += 1
                array.push(bear_val_los, v_lo)
                array.push(bear_val_his, v_hi)
                array.push(bear_densities, float(count) / band_span)
                array.push(bear_pct_los, p_lo)
                array.push(bear_pct_his, p_hi)

            float bear_p20_density = na
            for b = 0 to hist_bin_count - 1
                if array.get(bear_pct_los, b) >= 20.0 and na(bear_p20_density)
                    bear_p20_density := array.get(bear_densities, b)
            if not na(bear_p20_density)
                for b = 0 to hist_bin_count - 1
                    if array.get(bear_pct_los, b) < 20.0
                        array.set(bear_densities, b, math.min(array.get(bear_densities, b), bear_p20_density))

            float max_density = 0.0
            for b = 0 to hist_bin_count - 1
                max_density := math.max(max_density, array.get(bear_densities, b))

            for b = 0 to hist_bin_count - 1
                float v_lo = array.get(bear_val_los, b)
                float v_hi = array.get(bear_val_his, b)
                float density = array.get(bear_densities, b)
                float p_lo = array.get(bear_pct_los, b)
                float p_hi = array.get(bear_pct_his, b)
                float width_normalized = max_density > 0 ? density / max_density : 0.0
                int box_width = math.max(2, int(math.round(width_normalized * float(max_profile_width))))

                if v_hi >= v_lo
                    float y_high = st.bear_ref * (1.0 - v_lo / 100.0)
                    float y_low = st.bear_ref * (1.0 - v_hi / 100.0)
                    Zones.f_draw_hist_band(ds, st.or_start_bar, y_high, y_low, box_width, bear_color, hist_fill_transparency)
                    if i_show_hist_bin_labels
                        float y_mid = (y_high + y_low) / 2.0
                        Core.f_draw_stat_label(ds, st.or_start_bar - 1, y_mid, str.tostring(int(math.round(p_lo))) + "th", stat_label_color, "right", stat_label_size)
                    if i_show_debug
                        float y_mid = (y_high + y_low) / 2.0
                        Markers.f_draw_text_marker(ds, bar_index, y_mid, "S P" + str.tostring(p_lo, "#.0") + "-P" + str.tostring(p_hi, "#.0") + " v=" + str.tostring(v_lo, "#.##") + "-" + str.tostring(v_hi, "#.##"), stat_label_color, "center", debug_label_size)

    // ========================================================================
    // Time Distribution Histogram (indicator-specific; stays custom)
    // ========================================================================
    if i_show_time_dist and st.ref_set and st.or_complete and not na(st.or_start_bar)
        int time_data_dur = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
        if time_data_dur > 0
            float bars_per_min = 1.0 / float(tf_min)
            int min_box_w = math.max(1, int(float(i_time_bucket_mins) * bars_per_min))
            int num_bins = math.ceil(float(time_data_dur) / float(i_time_bucket_mins))

            float mfe_hist_bot = na
            if i_show_histogram and not na(st.bear_ref)
                array<float> bear_filt2 = STL.f_build_filtered(hist.mfe_bear)
                if array.size(bear_filt2) > 0
                    float max_bear_mfe = array.percentile_nearest_rank(bear_filt2, float(i_hist_end_pct))
                    mfe_hist_bot := st.bear_ref * (1.0 - max_bear_mfe / 100.0)
            float base_y = not na(mfe_hist_bot) ? mfe_hist_bot - syminfo.mintick * float(i_time_offset_ticks) : st.or_low - syminfo.mintick * float(i_time_offset_ticks)

            int n_ptb = array.size(hist.peak_time_bull)
            int n_pts = array.size(hist.peak_time_bear)
            array<int> bull_cnt = array.new_int(num_bins, 0)
            array<int> bear_cnt = array.new_int(num_bins, 0)
            int max_t_count = 1
            for bi = 0 to num_bins - 1
                int bin_s = bi * i_time_bucket_mins
                int bin_e = bin_s + i_time_bucket_mins
                int cb = 0
                int cs = 0
                if n_ptb > 0
                    for j = 0 to n_ptb - 1
                        int pk = array.get(hist.peak_time_bull, j)
                        if pk >= bin_s and pk < bin_e and array.get(hist.mfe_bull, j) > 0
                            cb += 1
                if n_pts > 0
                    for j = 0 to n_pts - 1
                        int pk = array.get(hist.peak_time_bear, j)
                        if pk >= bin_s and pk < bin_e and array.get(hist.mfe_bear, j) > 0
                            cs += 1
                array.set(bull_cnt, bi, cb)
                array.set(bear_cnt, bi, cs)
                max_t_count := math.max(max_t_count, math.max(cb, cs))

            float prof_h = syminfo.mintick * float(i_time_offset_ticks) * 0.4
            float line_h = prof_h * 1.2

            int title_x = st.or_start_bar + int(float(time_data_dur / 2) * bars_per_min)
            Core.f_draw_stat_label(ds, title_x, base_y + syminfo.mintick * 80.0, sp.name + " Time Dist", color.new(time_title_color, 50), "down", time_label_size)

            // Histogram bars
            for bi = 0 to num_bins - 1
                int x_l = st.or_start_bar + int(float(bi * i_time_bucket_mins) * bars_per_min)
                int x_r = x_l + min_box_w
                if x_r <= x_l
                    x_r := x_l + 1
                int cb = array.get(bull_cnt, bi)
                int cs = array.get(bear_cnt, bi)
                if cb > 0
                    float h = float(cb) / float(max_t_count) * prof_h
                    Zones.f_draw_time_bar(ds, x_l, x_r, base_y + h, base_y, time_bull_color)
                if cs > 0
                    float h = float(cs) / float(max_t_count) * prof_h
                    Zones.f_draw_time_bar(ds, x_l, x_r, base_y, base_y - h, time_bear_color)

            // AVG and Median vertical stat lines via Core.f_draw_vline (width=1 default)
            array<int> bull_t_nz = array.new_int(0)
            array<int> bear_t_nz = array.new_int(0)
            if n_ptb > 0
                for j = 0 to n_ptb - 1
                    if array.get(hist.mfe_bull, j) > 0
                        array.push(bull_t_nz, array.get(hist.peak_time_bull, j))
            if n_pts > 0
                for j = 0 to n_pts - 1
                    if array.get(hist.mfe_bear, j) > 0
                        array.push(bear_t_nz, array.get(hist.peak_time_bear, j))

            if array.size(bull_t_nz) > 0
                float avg_t = array.avg(bull_t_nz)
                float med_t = array.median(bull_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min)
                int x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    Core.f_draw_vline(ds, x_avg, base_y + line_h, base_y, stat_avg_color, "Dashed", 1)
                    Core.f_draw_stat_label(ds, x_avg, base_y + line_h, "Bull AVG", stat_avg_color, "down", time_label_size)
                if i_show_time_med
                    Core.f_draw_vline(ds, x_med, base_y + line_h * 0.8, base_y, stat_median_color, "Dashed", 1)
                    Core.f_draw_stat_label(ds, x_med, base_y + line_h * 0.8, "Bull MED", stat_median_color, "down", time_label_size)

            if array.size(bear_t_nz) > 0
                float avg_t = array.avg(bear_t_nz)
                float med_t = array.median(bear_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min)
                int x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    Core.f_draw_vline(ds, x_avg, base_y, base_y - line_h, stat_avg_color, "Dashed", 1)
                    Core.f_draw_stat_label(ds, x_avg, base_y - line_h, "Bear AVG", stat_avg_color, "up", time_label_size)
                if i_show_time_med
                    Core.f_draw_vline(ds, x_med, base_y, base_y - line_h * 0.8, stat_median_color, "Dashed", 1)
                    Core.f_draw_stat_label(ds, x_med, base_y - line_h * 0.8, "Bear MED", stat_median_color, "up", time_label_size)

    float merge_thr = Core.f_merge_threshold_for_symbol(syminfo.ticker, syminfo.mintick)
    Core.f_label_registry_flush(ds, lbl_reg, merge_thr, stat_label_size, 2)

if barstate.islast and array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_render_range(i)

// ============================================================================
// Table rendering
// ============================================================================

f_focus_idx() =>
    int focus = array.size(specs) > 0 ? array.size(specs) - 1 : 0
    if array.size(specs) > 0
        for i = 0 to array.size(specs) - 1
            RSL.RangeSpec sp = array.get(specs, i)
            RSL.RangeState st = array.get(states, i)
            bool in_or = RSL.f_in_session_pine(sp.session_or, sp.tz)
            bool in_data = RSL.f_in_session_pine(sp.session_data, sp.tz)
            if in_or or in_data or st.or_building
                focus := i
                break
    focus

if barstate.islast and i_show_table and array.size(specs) > 0
    int idx = f_focus_idx()
    RSL.RangeSpec sp = array.get(specs, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    bool is_dow = i_table_view == "DOW View"
    int n_cols = is_dow ? 3 : 6
    int n_rows = is_dow ? 6 : 3
    
    // Theme-aware table colors (theme_mode_resolved pulls from palette)
    color table_border_color = Core.f_theme_color("bg_border", theme_mode_resolved)
    color table_header_bg_color = Core.f_theme_color("header_bg", theme_mode_resolved)
    color table_header_text_color = Core.f_theme_color("header_text", theme_mode_resolved)
    color table_body_text_color = Core.f_theme_color("text_primary", theme_mode_resolved)
    color table_body_bg = Core.f_theme_color("bg_secondary", theme_mode_resolved)
    color table_bull_color = Core.f_theme_color("bull", theme_mode_resolved)
    color table_bear_color = Core.f_theme_color("bear", theme_mode_resolved)
    color table_cell_bg = color.new(table_body_bg, 85)
    string table_text_size = Core.f_display_profile_table_size("small", i_display_profile)
    
    // Use Tables.f_draw_stats_table wrapper (§9.1) — spec-compliant stats table
    table t = Tables.f_draw_stats_table(i_table_pos, n_cols, n_rows, color.new(table_border_color, 70), 1, theme_mode_resolved)

    // Header row
    Tables.f_draw_header_cell(t, 0, 0, sp.name + " - " + i_table_view, color.new(table_header_bg_color, 70), table_header_text_color, table_text_size)
    if is_dow
        Tables.f_draw_header_cell(t, 1, 0, "Count", table_cell_bg, table_header_text_color, table_text_size)
        Tables.f_draw_header_cell(t, 2, 0, "Avg MFE", table_cell_bg, table_header_text_color, table_text_size)
    else
        Tables.f_draw_header_cell(t, 1, 0, "Count", table_cell_bg, table_header_text_color, table_text_size)
        Tables.f_draw_header_cell(t, 2, 0, "P50", table_cell_bg, table_header_text_color, table_text_size)
        Tables.f_draw_header_cell(t, 3, 0, "P75", table_cell_bg, table_header_text_color, table_text_size)
        Tables.f_draw_header_cell(t, 4, 0, "P90", table_cell_bg, table_header_text_color, table_text_size)
        Tables.f_draw_header_cell(t, 5, 0, "Rate", table_cell_bg, table_header_text_color, table_text_size)

    if i_table_view == "MFE View"
        array<float> bull = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear = STL.f_build_filtered(hist.mfe_bear)
        float b50 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 50) : na
        float b75 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 75) : na
        float b90 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 90) : na
        float s50 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 50) : na
        float s75 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 75) : na
        float s90 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 90) : na
        Tables.f_draw_value_cell(t, 0, 1, "Bull", table_cell_bg, table_bull_color, table_text_size)
        Tables.f_draw_value_cell(t, 1, 1, str.tostring(array.size(bull)), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 2, 1, STL.f_pct_fmt(b50), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 3, 1, STL.f_pct_fmt(b75), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 4, 1, STL.f_pct_fmt(b90), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 5, 1, "-", table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 0, 2, "Bear", table_cell_bg, table_bear_color, table_text_size)
        Tables.f_draw_value_cell(t, 1, 2, str.tostring(array.size(bear)), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 2, 2, STL.f_pct_fmt(s50), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 3, 2, STL.f_pct_fmt(s75), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 4, 2, STL.f_pct_fmt(s90), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 5, 2, "-", table_cell_bg, table_body_text_color, table_text_size)
    else if i_table_view == "MAE View"
        array<float> mab = STL.f_build_filtered(hist.mae_bull_abs)
        array<float> mas = STL.f_build_filtered(hist.mae_bear_abs)
        array<float> mpb = STL.f_build_filtered(hist.mae_bull_pb)
        array<float> mps = STL.f_build_filtered(hist.mae_bear_pb)
        float rb = array.size(hist.r_multiple_bull) > 0 ? array.avg(hist.r_multiple_bull) : na
        float rs = array.size(hist.r_multiple_bear) > 0 ? array.avg(hist.r_multiple_bear) : na
        Tables.f_draw_value_cell(t, 0, 1, "Bull Abs/PB", table_cell_bg, table_bull_color, table_text_size)
        Tables.f_draw_value_cell(t, 1, 1, str.tostring(array.size(mab)), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 2, 1, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 50) : na), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 3, 1, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 75) : na), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 4, 1, STL.f_pct_fmt(array.size(mpb) > 0 ? array.percentile_nearest_rank(mpb, 50) : na), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 5, 1, na(rb) ? "n/a" : str.tostring(rb, "#.##"), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 0, 2, "Bear Abs/PB", table_cell_bg, table_bear_color, table_text_size)
        Tables.f_draw_value_cell(t, 1, 2, str.tostring(array.size(mas)), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 2, 2, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 50) : na), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 3, 2, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 75) : na), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 4, 2, STL.f_pct_fmt(array.size(mps) > 0 ? array.percentile_nearest_rank(mps, 50) : na), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 5, 2, na(rs) ? "n/a" : str.tostring(rs, "#.##"), table_cell_bg, table_body_text_color, table_text_size)
    else if i_table_view == "DOW View"
        for d = 2 to 6
            int row = d - 1
            int cnt = 0
            float sum_b = 0.0
            float sum_s = 0.0
            int n = math.min(array.size(hist.dow), math.min(array.size(hist.mfe_bull), array.size(hist.mfe_bear)))
            if n > 0
                for j = 0 to n - 1
                    if array.get(hist.dow, j) == d
                        cnt += 1
                        sum_b += array.get(hist.mfe_bull, j)
                        sum_s += array.get(hist.mfe_bear, j)
            float avg_net = cnt == 0 ? na : (sum_b + sum_s) / float(2 * cnt)
            Tables.f_draw_value_cell(t, 0, row, STL.f_day_full(d), table_cell_bg, table_body_text_color, table_text_size)
            Tables.f_draw_value_cell(t, 1, row, str.tostring(cnt), table_cell_bg, table_body_text_color, table_text_size)
            Tables.f_draw_value_cell(t, 2, row, STL.f_pct_fmt(avg_net), table_cell_bg, table_body_text_color, table_text_size)
    else
        [b25, b50, b75, b90] = STL.f_fakeout_mfe_percentiles(hist.mfe_bull, hist.fakeout_bull)
        [s25, s50, s75, s90] = STL.f_fakeout_mfe_percentiles(hist.mfe_bear, hist.fakeout_bear)
        [rb25, rb50, rb75, rb90] = STL.f_fakeout_reversal_percentiles(hist.fakeout_reversal_bull, hist.fakeout_bull)
        [rs25, rs50, rs75, rs90] = STL.f_fakeout_reversal_percentiles(hist.fakeout_reversal_bear, hist.fakeout_bear)
        float dbr = STL.f_double_break_rate(hist.double_break, hist.entry_triggered_bull, hist.entry_triggered_bear)
        Tables.f_draw_value_cell(t, 0, 1, "Bull Fake", table_cell_bg, table_bull_color, table_text_size)
        Tables.f_draw_value_cell(t, 1, 1, STL.f_pct_fmt(b50), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 2, 1, STL.f_pct_fmt(b75), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 3, 1, STL.f_pct_fmt(rb50), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 4, 1, STL.f_pct_fmt(rb90), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 5, 1, STL.f_pct_fmt(dbr), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 0, 2, "Bear Fake", table_cell_bg, table_bear_color, table_text_size)
        Tables.f_draw_value_cell(t, 1, 2, STL.f_pct_fmt(s50), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 2, 2, STL.f_pct_fmt(s75), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 3, 2, STL.f_pct_fmt(rs50), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 4, 2, STL.f_pct_fmt(rs90), table_cell_bg, table_body_text_color, table_text_size)
        Tables.f_draw_value_cell(t, 5, 2, STL.f_pct_fmt(dbr), table_cell_bg, table_body_text_color, table_text_size)
