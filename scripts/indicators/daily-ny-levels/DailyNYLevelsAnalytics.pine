indicator("Daily NY Levels Analytics v3 (Phase 2)", overlay=true, max_bars_back=5000, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// Daily NY Levels Analytics v3 — Phase 2 with v3 Library Migration
// Author: vveerappa | Version: 3
// ============================================================================
// Architecture — Visual System v3.1:
//   - All family libraries on /3, StatsLib on /9
//   - StatsLib/9: f_streak_stats, f_prob_after_streak,
//     f_rolling_win_rate, f_combine_bool_or, f_combine_bool_and
//   - All stat and tactical lines use HLevels.f_draw_priority_line for
//     registry-based collision suppression and staggering
//   - Module-scope color palette resolved once per bar (r_ prefix vars)
//   - Combined Summary table with directional split (UP/DOWN) at top
//   - DOW Diagnostic split by direction (▲/▼) using O(N) single-pass aggregation
//   - Rolling section computes from committed history (last 5/10/20 win rate)
//
// Libraries required:
//   - vveerappa/RangeSessionLib/15
//   - vveerappa/PineDrawingCore/3
//   - vveerappa/PineDrawingHorizontalLevels/4
//   - vveerappa/PineDrawingMarkers/3
//   - vveerappa/PineDrawingZones/3
//   - vveerappa/PineDrawingTables/4
//   - vveerappa/PineDrawingVerticalMarkers/3
//   - vveerappa/StatsLib/15
// ============================================================================

import vveerappa/RangeSessionLib/15 as RSL
import vveerappa/PineDrawingCore/3 as Core
import vveerappa/PineDrawingHorizontalLevels/4 as HLevels
import vveerappa/PineDrawingMarkers/3 as Markers
