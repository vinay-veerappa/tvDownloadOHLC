indicator("Daily NY Levels Analytics v3 (Phase 2)", overlay=true, max_bars_back=5000, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// Daily NY Levels Analytics v3 — Phase 2 with v3 Library Migration
// Author: vveerappa | Version: 3
// ============================================================================
// Evolves Phase 2 onto:
//   - All family libraries on /3
//   - StatsLib on /3 (adds f_streak_stats, f_prob_after_streak,
//     f_rolling_win_rate, f_combine_bool_or, f_combine_bool_and)
//   - HLevels semantic renderers for Phase 1 stat lines (confirm/stretch/pN)
//   - Phase 2 directional overlay uses f_draw_labeled_stat_line_meta helper
//     for custom-colored tactical lines (breakout, pullback, pivot, etc.)
//   - Combined Summary + Up/Down table (Up/Down removed, Summary now has
//     directional split at the top)
//   - DOW Diagnostic split by direction (▲/▼ stacked)
//   - Rolling section computes from committed history (last 5/10/20 win rate)
//
// Libraries required:
//   - vveerappa/RangeSessionLib/6
//   - vveerappa/PineDrawingCore/3
//   - vveerappa/PineDrawingHorizontalLevels/3
//   - vveerappa/PineDrawingMarkers/3
//   - vveerappa/PineDrawingZones/3
//   - vveerappa/PineDrawingTables/3
//   - vveerappa/PineDrawingVerticalMarkers/3
//   - vveerappa/StatsLib/3
// ============================================================================

import vveerappa/RangeSessionLib/6 as RSL
import vveerappa/PineDrawingCore/3 as Core
import vveerappa/PineDrawingHorizontalLevels/3 as HLevels
import vveerappa/PineDrawingMarkers/3 as Markers
import vveerappa/PineDrawingZones/3 as Zones
import vveerappa/PineDrawingTables/4 as Tables
import vveerappa/PineDrawingVerticalMarkers/3 as VMarks
import vveerappa/StatsLib/3 as STL

