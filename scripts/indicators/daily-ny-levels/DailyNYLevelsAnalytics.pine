r_tbl_title_size = Core.f_display_profile_table_size("Small", i_display_profile)

// ============================================================================

var array<RSL.RangeSpec> specs = array.new<RSL.RangeSpec>(0)
var array<RSL.RangeState> states = array.new<RSL.RangeState>(0)
var array<STL.ExcursionHistory> histories = array.new<STL.ExcursionHistory>(0)
var array<Core.PineDrawingState> drawings = array.new<Core.PineDrawingState>(0)
var array<bool> prev_in_or = array.new_bool(0)
var array<bool> prev_in_data = array.new_bool(0)
var array<int> phase2_live_bias = array.new_int(0)
var array<int> phase2_breakout_side = array.new_int(0)
var array<float> phase2_breakout_price = array.new_float(0)
var array<bool> phase2_pullback_armed = array.new_bool(0)
var array<float> phase2_pullback_price = array.new_float(0)

f_init_runtime() =>
    array.clear(specs)
    array.clear(states)
    array.clear(histories)
    array.clear(drawings)
    array.clear(prev_in_or)
    array.clear(prev_in_data)
    array.clear(phase2_live_bias)
    array.clear(phase2_breakout_side)
    array.clear(phase2_breakout_price)
    array.clear(phase2_pullback_armed)
    array.clear(phase2_pullback_price)

    array<RSL.RangeSpec> resolved = RSL.f_resolve_preset(i_preset, i_custom_start, i_custom_end, i_custom_cutoff, i_timezone)
    int n = array.size(resolved)
    if n > 0
        for i = 0 to n - 1
            RSL.RangeSpec sp = array.get(resolved, i)
            array.push(specs, sp)
            array.push(states, RSL.f_new_range_state(sp))
            array.push(histories, STL.f_new_excursion_history(sp.name))
            array.push(drawings, Core.f_new_drawing_state())
            array.push(prev_in_or, false)
            array.push(prev_in_data, false)
            array.push(phase2_live_bias, 0)
            array.push(phase2_breakout_side, 0)
            array.push(phase2_breakout_price, na)
            array.push(phase2_pullback_armed, false)
            array.push(phase2_pullback_price, na)

if barstate.isfirst
    f_init_runtime()

// Lower timeframe cache once per bar.
[ltf_high_arr, ltf_low_arr, ltf_close_arr, ltf_time_arr] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, close, time])
int ny_dow = dayofweek(time, i_timezone)

// ============================================================================
// Formatting helpers
// ============================================================================

f_or_color(int idx) =>
    // Consume module-level resolved base colors — do not re-resolve here.
    color base = idx % 2 == 0 ? r_bull_color : r_bear_color
    color.new(base, math.min(15 + idx * 10, 75))

f_fmt_stat_text(string name, string line_name, float pct_level, float pct_value) =>
    name + " " + line_name + " P" + str.tostring(int(pct_level)) + " " + STL.f_pct_fmt(pct_value)

f_fmt_avg_text(string name, string line_name, float pct_value) =>
    name + " " + line_name + " " + STL.f_pct_fmt(pct_value)

f_fmt_med_text(string name, float pct_value) =>
    name + " Med " + STL.f_pct_fmt(pct_value)

f_fmt_percentile_text(float pct_value) =>
    str.tostring(int(math.round(pct_value))) + "th"

// Helper for custom-colored tactical lines that don't map to semantic renderers.
// Used for Phase 2 overlay lines that have bespoke colors/styles.
// strategy: "stagger" (default) or "merge" — controlled by i_label_strategy input.
f_draw_labeled_stat_line_meta(Core.PineDrawingState ds, Core.LabelRegistry lr, int x1, float y, int x2, color line_clr, string line_style, int line_width, string label_text, color label_clr, int label_x, string strategy, int priority, string merge_group) =>
    HLevels.f_draw_stat_line(ds, x1, y, x2, line_clr, line_style, line_width)
    Core.f_label_registry_push_ex(lr, y, label_text, label_clr, label_x, strategy, priority, merge_group, "left", "", "Label", "")

// Shared rendering geometry so OR box, lines/labels, and histogram width stay in sync.
f_render_geometry(RSL.RangeSpec sp, RSL.RangeState st, int tf_min) =>
    int total_mins_to_cutoff = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
    int bars_to_cutoff = int(math.max(1.0, math.ceil(float(total_mins_to_cutoff) / float(tf_min))))
    int start_bar = na(st.or_start_bar) ? bar_index : st.or_start_bar
    int cutoff_bar = start_bar + bars_to_cutoff
    cutoff_bar := math.min(cutoff_bar, bar_index)
    int render_end_bar = cutoff_bar
    int profile_width = math.max(10, bars_to_cutoff)
    [bars_to_cutoff, cutoff_bar, render_end_bar, profile_width]

// Returns true if y is within threshold of any value in the ys array.
f_near_any(float y, array<float> ys, float thr) =>
    bool found = false
    if array.size(ys) > 0
        for i = 0 to array.size(ys) - 1
            if math.abs(y - array.get(ys, i)) < thr
                found := true
                break
    found

// ============================================================================
// Session tracking (unchanged from Phase 2 source)
// ============================================================================

f_track_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    bool in_or = RSL.f_in_session_pine(sp.session_or, sp.tz)
    bool in_data = RSL.f_in_session_pine(sp.session_data, sp.tz)

    bool was_in_or = array.get(prev_in_or, idx)
    bool is_new_session = in_or and not was_in_or
    array.set(prev_in_or, idx, in_or)

    if is_new_session and not st.is_committed and st.ref_set and not na(st.bull_ref)
        float pb_bull = na(st.daily_mae_bull_pb) ? 0.0 : st.daily_mae_bull_pb
        float pb_bear = na(st.daily_mae_bear_pb) ? 0.0 : st.daily_mae_bear_pb
        int direction = na
        if sp.is_transfer
            direction := (st.or_high > st.session_open) ? 1 : -1
        STL.f_commit_daily(hist, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bo_mfe_bull, st.daily_bo_mfe_bear, st.daily_bull_peak_min, st.daily_bear_peak_min, st.daily_pivot_bulls, st.daily_pivot_bears, st.daily_mae_bull_abs, st.daily_mae_bear_abs, pb_bull, pb_bear, st.daily_bo_mae_bull, st.daily_bo_mae_bear, st.mid_hit_bull, st.mid_hit_bear, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.session_low_data, st.session_high_data, i_ev_target_pct)
        st.is_committed := true

    if is_new_session
        RSL.f_reset_daily(st)
        array.set(phase2_live_bias, idx, 0)
        array.set(phase2_breakout_side, idx, 0)
        array.set(phase2_breakout_price, idx, na)
        array.set(phase2_pullback_armed, idx, false)
        array.set(phase2_pullback_price, idx, na)

    bool ltf_or_found = false
    int ltf_count = array.size(ltf_time_arr)
    if ltf_count > 0
        for j = 0 to ltf_count - 1
            int t = array.get(ltf_time_arr, j)
            int m = RSL.f_mins_of_day(t, sp.tz)
            bool in_or_m = RSL.f_in_session_minutes(m, sp.or_start_min, sp.or_end_min, sp.or_end_min < sp.or_start_min)
            if in_or_m
                float h = array.get(ltf_high_arr, j)
                float l = array.get(ltf_low_arr, j)
                float c = array.get(ltf_close_arr, j)
                if not st.or_building
                    st.or_high := h
                    st.or_low := l
                    st.or_last_close := c
                    st.or_building := true
                    st.or_start_bar := bar_index
                else
                    st.or_high := math.max(st.or_high, h)
                    st.or_low := math.min(st.or_low, l)
                    st.or_last_close := c
                ltf_or_found := true

    if in_or and not ltf_or_found
        if not st.or_building
            st.or_high := high
            st.or_low := low
            st.or_last_close := close
            st.or_building := true
            st.or_start_bar := bar_index
        else
            st.or_high := math.max(st.or_high, high)
            st.or_low := math.min(st.or_low, low)
            st.or_last_close := close

    if st.or_building and not st.or_complete and not in_or and not ltf_or_found
        st.or_complete := true

    if st.or_complete and not st.ref_set and not na(st.or_high)
        st.bull_ref := st.or_high
        st.bear_ref := st.or_low
        st.or_mid := (st.or_high + st.or_low) / 2.0
        st.session_open := st.or_last_close
        st.ref_set := true

    bool ltf_in_data = false
    if st.ref_set and ltf_count > 0
        for j = 0 to ltf_count - 1
            int t = array.get(ltf_time_arr, j)
            int m = RSL.f_mins_of_day(t, sp.tz)
            bool in_data_m = RSL.f_in_session_minutes(m, sp.or_end_min, sp.cutoff_min, sp.cutoff_min < sp.or_end_min)
            if in_data_m
                ltf_in_data := true
                float h = array.get(ltf_high_arr, j)
                float l = array.get(ltf_low_arr, j)
                float c = array.get(ltf_close_arr, j)
                int mins_since_or = RSL.f_mins_since(m, sp.or_start_min)
                [nb, ns, nbp, nsp] = STL.f_track_mfe(h, l, mins_since_or, st.bull_ref, st.bear_ref, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bull_peak_min, st.daily_bear_peak_min)
                st.daily_bull_mfe := nb
                st.daily_bear_mfe := ns
                st.daily_bull_peak_min := nbp
                st.daily_bear_peak_min := nsp
                [mab, mas] = STL.f_track_mae_abs(h, l, st.or_low, st.or_high, st.daily_mae_bull_abs, st.daily_mae_bear_abs)
                st.daily_mae_bull_abs := mab
                st.daily_mae_bear_abs := mas
                bool bull_peak_finalized = mins_since_or >= st.daily_bull_peak_min
                bool bear_peak_finalized = mins_since_or >= st.daily_bear_peak_min
                [mpb, mps] = STL.f_track_mae_pullback(h, l, st.or_high, st.or_low, bull_peak_finalized, bear_peak_finalized, st.daily_mae_bull_pb, st.daily_mae_bear_pb)
                st.daily_mae_bull_pb := mpb
                st.daily_mae_bear_pb := mps
                // Track breakout-level MFE/MAE
                int bo_side = array.get(phase2_breakout_side, idx)
                float bo_px = array.get(phase2_breakout_price, idx)
                if bo_side != 0 and not na(bo_px)
                    if bo_side == 1
                        if h > bo_px
                            st.daily_bo_mfe_bull := math.max(st.daily_bo_mfe_bull, (h - bo_px) / bo_px * 100.0)
                        if l < bo_px
                            st.daily_bo_mae_bull := math.max(st.daily_bo_mae_bull, (bo_px - l) / bo_px * 100.0)
                    else
                        if l < bo_px
                            st.daily_bo_mfe_bear := math.max(st.daily_bo_mfe_bear, (bo_px - l) / bo_px * 100.0)
                        if h > bo_px
                            st.daily_bo_mae_bear := math.max(st.daily_bo_mae_bear, (h - bo_px) / bo_px * 100.0)
                array.push(st.data_mins, mins_since_or)
                array.push(st.data_highs, h)
                array.push(st.data_lows, l)
                [mhb, mhs] = STL.f_track_mid_hit(h, l, st.or_mid, st.mid_hit_bull, st.mid_hit_bear)
                st.mid_hit_bull := mhb
                st.mid_hit_bear := mhs
                if h > st.bull_ref
                    st.entry_triggered_bull := true
                    array.push(st.daily_pivot_bulls, (h - st.bull_ref) / st.bull_ref * 100.0)
                if l < st.bear_ref
                    st.entry_triggered_bear := true
                    array.push(st.daily_pivot_bears, (st.bear_ref - l) / st.bear_ref * 100.0)
                st.session_low_data := na(st.session_low_data) ? l : math.min(st.session_low_data, l)
                st.session_high_data := na(st.session_high_data) ? h : math.max(st.session_high_data, h)
                st.close_at_cutoff := c

    if st.ref_set and in_data and not ltf_in_data
        int mins_since_or = RSL.f_mins_since(RSL.f_mins_of_day(time, sp.tz), sp.or_start_min)
        [nb, ns, nbp, nsp] = STL.f_track_mfe(high, low, mins_since_or, st.bull_ref, st.bear_ref, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bull_peak_min, st.daily_bear_peak_min)
        st.daily_bull_mfe := nb
        st.daily_bear_mfe := ns
        st.daily_bull_peak_min := nbp
        st.daily_bear_peak_min := nsp
        [mab, mas] = STL.f_track_mae_abs(high, low, st.or_low, st.or_high, st.daily_mae_bull_abs, st.daily_mae_bear_abs)
        st.daily_mae_bull_abs := mab
        st.daily_mae_bear_abs := mas
        bool bull_peak_finalized = mins_since_or >= st.daily_bull_peak_min
        bool bear_peak_finalized = mins_since_or >= st.daily_bear_peak_min
        [mpb, mps] = STL.f_track_mae_pullback(high, low, st.or_high, st.or_low, bull_peak_finalized, bear_peak_finalized, st.daily_mae_bull_pb, st.daily_mae_bear_pb)
        st.daily_mae_bull_pb := mpb
        st.daily_mae_bear_pb := mps
        int bo_side = array.get(phase2_breakout_side, idx)
        float bo_px = array.get(phase2_breakout_price, idx)
        if bo_side != 0 and not na(bo_px)
            if bo_side == 1
                if high > bo_px
                    st.daily_bo_mfe_bull := math.max(st.daily_bo_mfe_bull, (high - bo_px) / bo_px * 100.0)
                if low < bo_px
                    st.daily_bo_mae_bull := math.max(st.daily_bo_mae_bull, (bo_px - low) / bo_px * 100.0)
            else
                if low < bo_px
                    st.daily_bo_mfe_bear := math.max(st.daily_bo_mfe_bear, (bo_px - low) / bo_px * 100.0)
                if high > bo_px
                    st.daily_bo_mae_bear := math.max(st.daily_bo_mae_bear, (high - bo_px) / bo_px * 100.0)
        array.push(st.data_mins, mins_since_or)
        array.push(st.data_highs, high)
        array.push(st.data_lows, low)
        [mhb, mhs] = STL.f_track_mid_hit(high, low, st.or_mid, st.mid_hit_bull, st.mid_hit_bear)
        st.mid_hit_bull := mhb
        st.mid_hit_bear := mhs
        if high > st.bull_ref
            st.entry_triggered_bull := true
            array.push(st.daily_pivot_bulls, (high - st.bull_ref) / st.bull_ref * 100.0)
        if low < st.bear_ref
            st.entry_triggered_bear := true
            array.push(st.daily_pivot_bears, (st.bear_ref - low) / st.bear_ref * 100.0)
        st.session_low_data := na(st.session_low_data) ? low : math.min(st.session_low_data, low)
        st.session_high_data := na(st.session_high_data) ? high : math.max(st.session_high_data, high)
        st.close_at_cutoff := close

    bool effective_in_data = in_data or ltf_in_data
    bool was_in_data = array.get(prev_in_data, idx)
    bool data_just_ended = was_in_data and not effective_in_data
    array.set(prev_in_data, idx, effective_in_data)

    // Phase 2 live bias: close vs OR midpoint
    if st.ref_set and not na(st.or_mid)
        int lb = close > st.or_mid ? 1 : close < st.or_mid ? -1 : 0
        array.set(phase2_live_bias, idx, lb)

    // Phase 2 breakout keying
    int bo_side_local = array.get(phase2_breakout_side, idx)
    if st.ref_set and effective_in_data and bo_side_local == 0
        if close > st.or_high
            array.set(phase2_breakout_side, idx, 1)
            array.set(phase2_breakout_price, idx, close)
        else if close < st.or_low
            array.set(phase2_breakout_side, idx, -1)
            array.set(phase2_breakout_price, idx, close)

    // Phase 2 pullback activation
    bool pb_armed = array.get(phase2_pullback_armed, idx)
    bo_side_local := array.get(phase2_breakout_side, idx)
    float bo_px_local = array.get(phase2_breakout_price, idx)
    if st.ref_set and effective_in_data and bo_side_local != 0 and not pb_armed and not na(bo_px_local)
        array<float> mae_side = bo_side_local == 1 ? STL.f_build_filtered(hist.bo_mae_bull) : STL.f_build_filtered(hist.bo_mae_bear)
        if array.size(mae_side) > 0
            float p25 = array.percentile_nearest_rank(mae_side, 25)
            float act_px = bo_side_local == 1 ? bo_px_local * (1.0 - p25 / 100.0) : bo_px_local * (1.0 + p25 / 100.0)
            array.set(phase2_pullback_price, idx, act_px)
            bool armed_now = bo_side_local == 1 ? close <= act_px : close >= act_px
            if armed_now
                array.set(phase2_pullback_armed, idx, true)

    if data_just_ended and not st.is_committed and st.ref_set
        float pb_bull = na(st.daily_mae_bull_pb) ? 0.0 : st.daily_mae_bull_pb
        float pb_bear = na(st.daily_mae_bear_pb) ? 0.0 : st.daily_mae_bear_pb
        int direction = na
        if sp.is_transfer
            direction := (st.or_high > st.session_open) ? 1 : -1
        STL.f_commit_daily(hist, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bo_mfe_bull, st.daily_bo_mfe_bear, st.daily_bull_peak_min, st.daily_bear_peak_min, st.daily_pivot_bulls, st.daily_pivot_bears, st.daily_mae_bull_abs, st.daily_mae_bear_abs, pb_bull, pb_bear, st.daily_bo_mae_bull, st.daily_bo_mae_bear, st.mid_hit_bull, st.mid_hit_bear, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.session_low_data, st.session_high_data, i_ev_target_pct)
        st.is_committed := true

    if i_show_debug and is_new_session
        Markers.f_draw_text_marker(array.get(drawings, idx), bar_index, high, "NEW: " + sp.name, debug_text_color_resolved, "down", "tiny")

    array.set(states, idx, st)
    array.set(histories, idx, hist)

if array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_track_range(i)

// ============================================================================
// Rendering
// ============================================================================

f_render_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)
    Core.PineDrawingState ds = array.get(drawings, idx)

    Core.f_clear_all(ds)

    int tf_min = timeframe.isintraday ? timeframe.multiplier : 1
    [bars_to_cutoff, cutoff_bar, line_render_end, max_profile_width] = f_render_geometry(sp, st, tf_min)

    // Display Profile scaling for direct Core draw calls (histogram bins, time dist).
    // f_display_profile_label_size(base, profile) shifts the base size by the profile delta.
    // f_display_profile_width(base_width, profile) scales a line width by the profile multiplier.
    string profile_label_size = Core.f_display_profile_label_size(i_label_size, i_display_profile)
    int    profile_line_width = Core.f_display_profile_width(1, i_display_profile)

    // Consumed from module-level palette (resolved once per bar, not per render call).
    // r_bull_color, r_bear_color, r_stat_*, r_reversal_zone_color, etc. are all available.
    color bull_color              = r_bull_color
    color bear_color              = r_bear_color
    color stat_label_color        = r_stat_label_color
    color stat_median_color       = r_stat_median_color
    color stat_avg_color          = r_stat_avg_color
    color stat_stretch_color      = r_stat_stretch_color
    color mid_line_color          = r_mid_line_color
    color time_title_color        = r_time_title_color
    color bo_cashflow_color       = r_bo_cashflow_color
    color bo_confirm_color        = r_bo_confirm_color
    color pivot_color             = r_pivot_color
    color reversal_zone_color     = r_reversal_zone_color
    color max_reversal_color      = r_max_reversal_color
    color invalidation_line_color = r_invalidation_color
    color breakout_activation_color = r_breakout_act_color
    color pullback_activation_color = r_pullback_act_color
    color pb_not_armed_color      = r_pb_not_armed_color

    // Overlap suppression: pre-compute tactical Y levels
    array<float> tac_ys = array.new_float(0)
    float suppress_thr = syminfo.mintick * float(i_label_merge_threshold_ticks)
    if i_show_phase2_levels and st.ref_set and not na(st.or_start_bar)
        int _bo_side = array.get(phase2_breakout_side, idx)
        int _live_bias = array.get(phase2_live_bias, idx)
        float _bo_px = array.get(phase2_breakout_price, idx)
        int _rs = _bo_side != 0 ? _bo_side : _live_bias
        float _rp = not na(_bo_px) ? _bo_px : (_rs == 1 ? st.or_high : _rs == -1 ? st.or_low : na)
        if _rs != 0 and not na(_rp)
            array.push(tac_ys, _rp)
            float _pb = array.get(phase2_pullback_price, idx)
            if not na(_pb)
                array.push(tac_ys, _pb)
            array<float> _bm = _rs == 1 ? STL.f_build_filtered(hist.bo_mfe_bull) : STL.f_build_filtered(hist.bo_mfe_bear)
            if array.size(_bm) > 0
                float _p20 = array.percentile_nearest_rank(_bm, 20)
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 + _p20 / 100.0) : _rp * (1.0 - _p20 / 100.0))
            array<float> _fm = _rs == 1 ? STL.f_build_filtered(hist.fake_mfe_bull) : STL.f_build_filtered(hist.fake_mfe_bear)
            if array.size(_fm) > 0
                float _f50 = array.percentile_nearest_rank(_fm, 50)
                float _f75 = array.percentile_nearest_rank(_fm, 75)
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 + _f75 / 100.0) : _rp * (1.0 - _f75 / 100.0))
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 + _f50 / 100.0) : _rp * (1.0 - _f50 / 100.0))
            array<float> _rf = _rs == 1 ? STL.f_build_filtered(hist.fake_mae_bull) : STL.f_build_filtered(hist.fake_mae_bear)
            if array.size(_rf) > 0
                float _r20 = array.percentile_nearest_rank(_rf, 20)
                float _r50 = array.percentile_nearest_rank(_rf, 50)
                float _r90 = array.percentile_nearest_rank(_rf, 90)
                array.push(tac_ys, _rs == 1 ? st.or_high * (1.0 - _r20 / 100.0) : st.or_low * (1.0 + _r20 / 100.0))
                array.push(tac_ys, _rs == 1 ? st.or_high * (1.0 - _r50 / 100.0) : st.or_low * (1.0 + _r50 / 100.0))
                array.push(tac_ys, _rs == 1 ? st.or_high * (1.0 - _r90 / 100.0) : st.or_low * (1.0 + _r90 / 100.0))
            array<float> _ms = _rs == 1 ? STL.f_build_filtered(hist.bo_mae_bull) : STL.f_build_filtered(hist.bo_mae_bear)
            if array.size(_ms) > 0
                float _mp80 = array.percentile_nearest_rank(_ms, 80)
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 - _mp80 / 100.0) : _rp * (1.0 + _mp80 / 100.0))

    Core.LabelRegistry lbl_reg = Core.f_label_registry_begin()

    // OR box
    if st.or_building and not na(st.or_start_bar)
        Zones.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx), i_box_style, i_box_width)
    else if st.or_complete and not na(st.or_start_bar)
        Zones.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx), i_box_style, i_box_width)

    // ========================================================================
    // Phase 1 Stat Lines — semantic renderers for most, custom helper for Mid
    // ========================================================================
    if i_show_stat_lines and st.ref_set and not na(st.bull_ref)
        array<float> bull_filtered = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear_filtered = STL.f_build_filtered(hist.mfe_bear)
        int ln_end = line_render_end
        int stat_label_x = ln_end + i_label_gap_bars
        string bull_tag_base = sp.name + "_bull"
        string bear_tag_base = sp.name + "_bear"
        string unit_str = "%"

        if array.size(bull_filtered) > 0
            float p_confirm_b = array.percentile_nearest_rank(bull_filtered, i_pct_confirm)
            float p_t1_b = array.percentile_nearest_rank(bull_filtered, i_pct_target1)
            float p_t2_b = array.percentile_nearest_rank(bull_filtered, i_pct_target2)
            float p_stretch_b = array.percentile_nearest_rank(bull_filtered, i_pct_stretch)
            float p_avg_b = array.avg(bull_filtered)
            float p_med_b = array.median(bull_filtered)
            float y_confirm_b = st.bull_ref * (1.0 + p_confirm_b / 100.0)
            float y_t1_b = st.bull_ref * (1.0 + p_t1_b / 100.0)
            float y_t2_b = st.bull_ref * (1.0 + p_t2_b / 100.0)
            float y_stretch_b = st.bull_ref * (1.0 + p_stretch_b / 100.0)
            float y_avg_b = st.bull_ref * (1.0 + p_avg_b / 100.0)
            float y_med_b = st.bull_ref * (1.0 + p_med_b / 100.0)

            if not f_near_any(y_confirm_b, tac_ys, suppress_thr)
                HLevels.f_draw_confirm_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "C", st.or_start_bar, ln_end, y_confirm_b, "bull", str.tostring(int(i_pct_confirm)), STL.f_pct_fmt(p_confirm_b), unit_str, sp.name + " MFE", bull_tag_base + "_confirm", 0)
            if not f_near_any(y_t1_b, tac_ys, suppress_thr)
                HLevels.f_draw_target_level_p50(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", st.or_start_bar, ln_end, y_t1_b, sp.name + " Bull", "MFE", STL.f_pct_fmt(p_t1_b), unit_str, bull_tag_base + "_t1", 0)
            if not f_near_any(y_t2_b, tac_ys, suppress_thr)
                HLevels.f_draw_target_level_p75(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, y_t2_b, sp.name + " Bull", "MFE", STL.f_pct_fmt(p_t2_b), unit_str, bull_tag_base + "_t2", 0)
            if not f_near_any(y_stretch_b, tac_ys, suppress_thr)
                HLevels.f_draw_stretch_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", st.or_start_bar, ln_end, y_stretch_b, sp.name + " Bull", str.tostring(int(i_pct_stretch)), STL.f_pct_fmt(p_stretch_b), unit_str, bull_tag_base + "_stretch", 0)
            if not f_near_any(y_avg_b, tac_ys, suppress_thr)
                HLevels.f_draw_statistical_level_avg(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, y_avg_b, sp.name + " Bull MFE", STL.f_pct_fmt(p_avg_b), unit_str, bull_tag_base + "_avg", 0)
            if not f_near_any(y_med_b, tac_ys, suppress_thr)
                HLevels.f_draw_statistical_level_median(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", st.or_start_bar, ln_end, y_med_b, sp.name + " Bull MFE", STL.f_pct_fmt(p_med_b), unit_str, bull_tag_base + "_med", 0)

        if array.size(bear_filtered) > 0
            float p_confirm_s = array.percentile_nearest_rank(bear_filtered, i_pct_confirm)
            float p_t1_s = array.percentile_nearest_rank(bear_filtered, i_pct_target1)
            float p_t2_s = array.percentile_nearest_rank(bear_filtered, i_pct_target2)
            float p_stretch_s = array.percentile_nearest_rank(bear_filtered, i_pct_stretch)
            float p_avg_s = array.avg(bear_filtered)
            float p_med_s = array.median(bear_filtered)
            float y_confirm_s = st.bear_ref * (1.0 - p_confirm_s / 100.0)
            float y_t1_s = st.bear_ref * (1.0 - p_t1_s / 100.0)
            float y_t2_s = st.bear_ref * (1.0 - p_t2_s / 100.0)
            float y_stretch_s = st.bear_ref * (1.0 - p_stretch_s / 100.0)
            float y_avg_s = st.bear_ref * (1.0 - p_avg_s / 100.0)
            float y_med_s = st.bear_ref * (1.0 - p_med_s / 100.0)

            if not f_near_any(y_confirm_s, tac_ys, suppress_thr)
                HLevels.f_draw_confirm_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "C", st.or_start_bar, ln_end, y_confirm_s, "bear", str.tostring(int(i_pct_confirm)), STL.f_pct_fmt(p_confirm_s), unit_str, sp.name + " MFE", bear_tag_base + "_confirm", 0)
            if not f_near_any(y_t1_s, tac_ys, suppress_thr)
                HLevels.f_draw_target_level_p50(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", st.or_start_bar, ln_end, y_t1_s, sp.name + " Bear", "MFE", STL.f_pct_fmt(p_t1_s), unit_str, bear_tag_base + "_t1", 0)
            if not f_near_any(y_t2_s, tac_ys, suppress_thr)
                HLevels.f_draw_target_level_p75(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, y_t2_s, sp.name + " Bear", "MFE", STL.f_pct_fmt(p_t2_s), unit_str, bear_tag_base + "_t2", 0)
            if not f_near_any(y_stretch_s, tac_ys, suppress_thr)
                HLevels.f_draw_stretch_level(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", st.or_start_bar, ln_end, y_stretch_s, sp.name + " Bear", str.tostring(int(i_pct_stretch)), STL.f_pct_fmt(p_stretch_s), unit_str, bear_tag_base + "_stretch", 0)
            if not f_near_any(y_avg_s, tac_ys, suppress_thr)
                HLevels.f_draw_statistical_level_avg(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, y_avg_s, sp.name + " Bear MFE", STL.f_pct_fmt(p_avg_s), unit_str, bear_tag_base + "_avg", 0)
            if not f_near_any(y_med_s, tac_ys, suppress_thr)
                HLevels.f_draw_statistical_level_median(ds, lbl_reg, theme_mode_resolved, i_display_profile, "P", st.or_start_bar, ln_end, y_med_s, sp.name + " Bear MFE", STL.f_pct_fmt(p_med_s), unit_str, bear_tag_base + "_med", 0)

        // Mid line via priority_line
        int n_mid = math.min(array.size(hist.mid_hit_bull), array.size(hist.mid_hit_bear))
        int mid_hits = 0
        if n_mid > 0
            for k = 0 to n_mid - 1
                mid_hits += array.get(hist.mid_hit_bull, k) ? 1 : 0
                mid_hits += array.get(hist.mid_hit_bear, k) ? 1 : 0
        float mid_hit_pct = n_mid == 0 ? na : (float(mid_hits) / float(2 * n_mid)) * 100.0
        if not f_near_any(st.or_mid, tac_ys, suppress_thr)
            string mid_label = "Midpoint (" + STL.f_pct_fmt(mid_hit_pct) + ")"
            HLevels.f_draw_priority_line(ds, lbl_reg, theme_mode_resolved, i_display_profile, "S", st.or_start_bar, ln_end, st.or_mid, mid_label, mid_line_color, 50, sp.name + "_mid", 0)

    // ========================================================================
    // MFE Histogram (indicator-specific density-driven profile)
    // ========================================================================
    if i_show_histogram and st.ref_set and not na(st.bull_ref)
        array<float> bull_filtered = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear_filtered = STL.f_build_filtered(hist.mfe_bear)

        int hist_pct_start = math.min(i_hist_start_pct, i_hist_end_pct - 1)
        int hist_pct_end = math.max(i_hist_end_pct, hist_pct_start + 1)
        int hist_pct_step = math.max(1, i_hist_pct_step)
        int hist_bin_count = int(math.ceil(float(hist_pct_end - hist_pct_start) / float(hist_pct_step)))

        // BULL HISTOGRAM
        if array.size(bull_filtered) > 0
            array<float> bull_val_los = array.new_float(0)
            array<float> bull_val_his = array.new_float(0)
            array<float> bull_densities = array.new_float(0)
            array<float> bull_pct_los = array.new_float(0)
            for b = 0 to hist_bin_count - 1
                float p_lo = hist_pct_start + float(hist_pct_step * b)
                float p_hi = math.min(hist_pct_end, p_lo + hist_pct_step)
                float v_lo = array.percentile_nearest_rank(bull_filtered, p_lo)
                float v_hi = array.percentile_nearest_rank(bull_filtered, p_hi)
                float band_span = math.max(v_hi - v_lo, 0.0001)
                int count = 0
                for s = 0 to array.size(bull_filtered) - 1
                    float val = array.get(bull_filtered, s)
                    if val >= v_lo and (b == hist_bin_count - 1 ? val <= v_hi : val < v_hi)
                        count += 1
                array.push(bull_val_los, v_lo)
                array.push(bull_val_his, v_hi)
                array.push(bull_densities, float(count) / band_span)
                array.push(bull_pct_los, p_lo)
            float bull_p20_density = na
            for b = 0 to hist_bin_count - 1
                if array.get(bull_pct_los, b) >= 20.0 and na(bull_p20_density)
                    bull_p20_density := array.get(bull_densities, b)
            if not na(bull_p20_density)
                for b = 0 to hist_bin_count - 1
                    if array.get(bull_pct_los, b) < 20.0
                        array.set(bull_densities, b, math.min(array.get(bull_densities, b), bull_p20_density))
            float max_density = 0.0
            for b = 0 to hist_bin_count - 1
                max_density := math.max(max_density, array.get(bull_densities, b))
            for b = 0 to hist_bin_count - 1
                float v_lo = array.get(bull_val_los, b)
                float v_hi = array.get(bull_val_his, b)
                float density = array.get(bull_densities, b)
                float p_lo = array.get(bull_pct_los, b)
                float width_normalized = max_density > 0 ? density / max_density : 0.0
                int box_width = math.max(2, int(math.round(width_normalized * float(max_profile_width))))
                if v_hi >= v_lo
                    float y_low = st.bull_ref * (1.0 + v_lo / 100.0)
                    float y_high = st.bull_ref * (1.0 + v_hi / 100.0)
                    Zones.f_draw_hist_band(ds, st.or_start_bar, y_high, y_low, box_width, bull_color, 58)
                    if i_show_hist_bin_labels
                        Core.f_draw_stat_label(ds, st.or_start_bar - 1, (y_high + y_low) / 2.0, f_fmt_percentile_text(p_lo), stat_label_color, "right", profile_label_size)

        // BEAR HISTOGRAM
        if array.size(bear_filtered) > 0
            array<float> bear_val_los = array.new_float(0)
            array<float> bear_val_his = array.new_float(0)
            array<float> bear_densities = array.new_float(0)
            array<float> bear_pct_los = array.new_float(0)
            for b = 0 to hist_bin_count - 1
                float p_lo = hist_pct_start + float(hist_pct_step * b)
                float p_hi = math.min(hist_pct_end, p_lo + hist_pct_step)
                float v_lo = array.percentile_nearest_rank(bear_filtered, p_lo)
                float v_hi = array.percentile_nearest_rank(bear_filtered, p_hi)
                float band_span = math.max(v_hi - v_lo, 0.0001)
                int count = 0
                for s = 0 to array.size(bear_filtered) - 1
                    float val = array.get(bear_filtered, s)
                    if val >= v_lo and (b == hist_bin_count - 1 ? val <= v_hi : val < v_hi)
                        count += 1
                array.push(bear_val_los, v_lo)
                array.push(bear_val_his, v_hi)
                array.push(bear_densities, float(count) / band_span)
                array.push(bear_pct_los, p_lo)
            float bear_p20_density = na
            for b = 0 to hist_bin_count - 1
                if array.get(bear_pct_los, b) >= 20.0 and na(bear_p20_density)
                    bear_p20_density := array.get(bear_densities, b)
            if not na(bear_p20_density)
                for b = 0 to hist_bin_count - 1
                    if array.get(bear_pct_los, b) < 20.0
                        array.set(bear_densities, b, math.min(array.get(bear_densities, b), bear_p20_density))
            float max_density = 0.0
            for b = 0 to hist_bin_count - 1
                max_density := math.max(max_density, array.get(bear_densities, b))
            for b = 0 to hist_bin_count - 1
                float v_lo = array.get(bear_val_los, b)
                float v_hi = array.get(bear_val_his, b)
                float density = array.get(bear_densities, b)
                float p_lo = array.get(bear_pct_los, b)
                float width_normalized = max_density > 0 ? density / max_density : 0.0
                float width_shaped = math.sqrt(width_normalized)
                int min_width = math.max(3, int(math.round(float(max_profile_width) * 0.10)))
                int box_width = math.max(min_width, int(math.round(width_shaped * float(max_profile_width))))
                if v_hi >= v_lo
                    float y_high = st.bear_ref * (1.0 - v_lo / 100.0)
                    float y_low = st.bear_ref * (1.0 - v_hi / 100.0)
                    Zones.f_draw_hist_band(ds, st.or_start_bar, y_high, y_low, box_width, bear_color, 58)
                    if i_show_hist_bin_labels
                        Core.f_draw_stat_label(ds, st.or_start_bar - 1, (y_high + y_low) / 2.0, f_fmt_percentile_text(p_lo), stat_label_color, "right", profile_label_size)

    // ========================================================================
    // Time Distribution Histogram
    // ========================================================================
    if i_show_time_dist and st.ref_set and st.or_complete and not na(st.or_start_bar)
        int time_data_dur = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
        if time_data_dur > 0
            float bars_per_min = 1.0 / float(tf_min)
            int min_box_w = math.max(1, int(float(i_time_bucket_mins) * bars_per_min))
            int num_bins = math.ceil(float(time_data_dur) / float(i_time_bucket_mins))

            float mfe_hist_bot = na
            if i_show_histogram and not na(st.bear_ref)
                array<float> bear_filt2 = STL.f_build_filtered(hist.mfe_bear)
                if array.size(bear_filt2) > 0
                    float max_bear_mfe = array.percentile_nearest_rank(bear_filt2, float(i_hist_end_pct))
                    mfe_hist_bot := st.bear_ref * (1.0 - max_bear_mfe / 100.0)
            float base_y = not na(mfe_hist_bot) ? mfe_hist_bot - syminfo.mintick * float(i_time_offset_ticks) : st.or_low - syminfo.mintick * float(i_time_offset_ticks)

            int n_ptb = array.size(hist.peak_time_bull)
            int n_pts = array.size(hist.peak_time_bear)
            array<int> bull_cnt = array.new_int(num_bins, 0)
            array<int> bear_cnt = array.new_int(num_bins, 0)
            int max_t_count = 1
            for bi = 0 to num_bins - 1
                int bin_s = bi * i_time_bucket_mins
                int bin_e = bin_s + i_time_bucket_mins
                int cb = 0
                int cs = 0
                if n_ptb > 0
                    for j = 0 to n_ptb - 1
                        int pk = array.get(hist.peak_time_bull, j)
                        if pk >= bin_s and pk < bin_e and array.get(hist.mfe_bull, j) > 0
                            cb += 1
                if n_pts > 0
                    for j = 0 to n_pts - 1
                        int pk = array.get(hist.peak_time_bear, j)
                        if pk >= bin_s and pk < bin_e and array.get(hist.mfe_bear, j) > 0
                            cs += 1
                array.set(bull_cnt, bi, cb)
                array.set(bear_cnt, bi, cs)
                max_t_count := math.max(max_t_count, math.max(cb, cs))

            float prof_h = syminfo.mintick * float(i_time_offset_ticks) * 0.4
            float line_h = prof_h * 1.2

            int title_x = st.or_start_bar + int(float(time_data_dur / 2) * bars_per_min)
            Core.f_draw_stat_label(ds, title_x, base_y + syminfo.mintick * 80.0, sp.name + " Time Dist", color.new(time_title_color, 50), "down", profile_label_size)

            for bi = 0 to num_bins - 1
                int x_l = st.or_start_bar + int(float(bi * i_time_bucket_mins) * bars_per_min)
                int x_r = x_l + min_box_w
                if x_r <= x_l
                    x_r := x_l + 1
                int cb = array.get(bull_cnt, bi)
                int cs = array.get(bear_cnt, bi)
                if cb > 0
                    float h = float(cb) / float(max_t_count) * prof_h
                    Zones.f_draw_time_bar(ds, x_l, x_r, base_y + h, base_y, color.new(bull_color, 80))
                if cs > 0
                    float h = float(cs) / float(max_t_count) * prof_h
                    Zones.f_draw_time_bar(ds, x_l, x_r, base_y, base_y - h, color.new(bear_color, 80))

            array<int> bull_t_nz = array.new_int(0)
            array<int> bear_t_nz = array.new_int(0)
            if n_ptb > 0
                for j = 0 to n_ptb - 1
                    if array.get(hist.mfe_bull, j) > 0
                        array.push(bull_t_nz, array.get(hist.peak_time_bull, j))
            if n_pts > 0
                for j = 0 to n_pts - 1
                    if array.get(hist.mfe_bear, j) > 0
                        array.push(bear_t_nz, array.get(hist.peak_time_bear, j))

            if array.size(bull_t_nz) > 0
                float avg_t = array.avg(bull_t_nz)
                float med_t = array.median(bull_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min)
                int x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    Core.f_draw_vline(ds, x_avg, base_y + line_h, base_y, stat_avg_color, "Dashed", profile_line_width)
                    Core.f_draw_stat_label(ds, x_avg, base_y + line_h, "Bull AVG", stat_avg_color, "down", profile_label_size)
                if i_show_time_med
                    Core.f_draw_vline(ds, x_med, base_y + line_h * 0.8, base_y, stat_median_color, "Dashed", profile_line_width)
                    Core.f_draw_stat_label(ds, x_med, base_y + line_h * 0.8, "Bull MED", stat_median_color, "down", profile_label_size)

            if array.size(bear_t_nz) > 0
                float avg_t = array.avg(bear_t_nz)
                float med_t = array.median(bear_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min)
                int x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    Core.f_draw_vline(ds, x_avg, base_y, base_y - line_h, stat_avg_color, "Dashed", profile_line_width)
                    Core.f_draw_stat_label(ds, x_avg, base_y - line_h, "Bear AVG", stat_avg_color, "up", profile_label_size)
                if i_show_time_med
                    Core.f_draw_vline(ds, x_med, base_y, base_y - line_h * 0.8, stat_median_color, "Dashed", profile_line_width)
                    Core.f_draw_stat_label(ds, x_med, base_y - line_h * 0.8, "Bear MED", stat_median_color, "up", profile_label_size)

    // ========================================================================
    // Phase 2 Directional Overlay
    // ========================================================================
    if i_show_phase2_levels and st.ref_set and not na(st.or_start_bar)
        int ln_end = line_render_end
        int bo_side = array.get(phase2_breakout_side, idx)
        int live_bias = array.get(phase2_live_bias, idx)
        float bo_px = array.get(phase2_breakout_price, idx)
        bool pb_armed = array.get(phase2_pullback_armed, idx)
        int phase2_label_x = ln_end + i_label_gap_bars

        int render_side = bo_side != 0 ? bo_side : live_bias
        float render_px = not na(bo_px) ? bo_px : (render_side == 1 ? st.or_high : render_side == -1 ? st.or_low : na)

        if render_side != 0 and not na(render_px)
            int inactive_alpha = i_emphasize_active_side and live_bias != 0 and live_bias != render_side ? 65 : 0

            array<float> bo_mfe_hist = render_side == 1 ? STL.f_build_filtered(hist.bo_mfe_bull) : STL.f_build_filtered(hist.bo_mfe_bear)
            float p20_bo = array.size(bo_mfe_hist) > 0 ? array.percentile_nearest_rank(bo_mfe_hist, 20) : na

            float f50 = na
            float f75 = na
            if render_side == 1
                array<float> fake_mfe_hist = STL.f_build_filtered(hist.fake_mfe_bull)
                f50 := array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 50) : na
                f75 := array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 75) : na
            else
                array<float> fake_mfe_hist = STL.f_build_filtered(hist.fake_mfe_bear)
                f50 := array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 50) : na
                f75 := array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 75) : na

            array<float> rev_f = render_side == 1 ? STL.f_build_filtered(hist.fake_mae_bull) : STL.f_build_filtered(hist.fake_mae_bear)
            float rev_p20 = array.size(rev_f) > 0 ? array.percentile_nearest_rank(rev_f, 20) : na
            float rev_p50 = array.size(rev_f) > 0 ? array.percentile_nearest_rank(rev_f, 50) : na
            float rev_p90 = array.size(rev_f) > 0 ? array.percentile_nearest_rank(rev_f, 90) : na

            array<float> mae_side = render_side == 1 ? STL.f_build_filtered(hist.bo_mae_bull) : STL.f_build_filtered(hist.bo_mae_bear)
            float mae_p80 = array.size(mae_side) > 0 ? array.percentile_nearest_rank(mae_side, 80) : na

            float y_cash = na
            float y_confirm = na
            float y_pivot = na
            float y_rev20 = na
            float y_rev50 = na
            float y_rev90 = na
            float y_inv = na
            if render_side == 1
                y_cash := na(p20_bo) ? na : render_px * (1.0 + p20_bo / 100.0)
                y_confirm := na(f75) ? na : render_px * (1.0 + f75 / 100.0)
                y_pivot := na(f50) ? na : render_px * (1.0 + f50 / 100.0)
                y_rev20 := na(rev_p20) ? na : st.or_high * (1.0 - rev_p20 / 100.0)
                y_rev50 := na(rev_p50) ? na : st.or_high * (1.0 - rev_p50 / 100.0)
                y_rev90 := na(rev_p90) ? na : st.or_high * (1.0 - rev_p90 / 100.0)
                y_inv := na(mae_p80) ? na : render_px * (1.0 - mae_p80 / 100.0)
            else
                y_cash := na(p20_bo) ? na : render_px * (1.0 - p20_bo / 100.0)
                y_confirm := na(f75) ? na : render_px * (1.0 - f75 / 100.0)
                y_pivot := na(f50) ? na : render_px * (1.0 - f50 / 100.0)
                y_rev20 := na(rev_p20) ? na : st.or_low * (1.0 + rev_p20 / 100.0)
                y_rev50 := na(rev_p50) ? na : st.or_low * (1.0 + rev_p50 / 100.0)
                y_rev90 := na(rev_p90) ? na : st.or_low * (1.0 + rev_p90 / 100.0)
                y_inv := na(mae_p80) ? na : render_px * (1.0 + mae_p80 / 100.0)

            // Reversal target zone
            if not na(y_rev20) and not na(y_rev50)
                float z_top = math.max(y_rev20, y_rev50)
                float z_bot = math.min(y_rev20, y_rev50)
                int z_w = math.max(2, ln_end - st.or_start_bar)
                float z_mid = (z_top + z_bot) / 2.0
                int z_mid_x = st.or_start_bar + int(math.floor(z_w / 2.0))
                int zone_line_alpha = math.min(i_zone_transparency + 10, 95)
                int zone_text_alpha = math.min(int(math.round(float(i_zone_transparency) * 0.6)), 90)
                Zones.f_draw_hist_band(ds, st.or_start_bar, z_top, z_bot, z_w, reversal_zone_color, i_zone_transparency)
                HLevels.f_draw_stat_line(ds, st.or_start_bar, z_mid, st.or_start_bar + z_w, color.new(reversal_zone_color, zone_line_alpha), "Dashed", i_line_width_secondary)
                Core.f_draw_stat_label(ds, z_mid_x, z_mid, "Reversal Zone (P20-P50 Fake MAE)", color.new(stat_label_color, zone_text_alpha), "center", i_label_size)

            // Phase 2 directional lines
            if not na(render_px)
                f_draw_labeled_stat_line_meta(ds, lbl_reg, st.or_start_bar, render_px, ln_end, color.new(breakout_activation_color, 0), "Dotted", i_line_width_primary, "Breakout Activation " + STL.f_pct_fmt(0), color.new(breakout_activation_color, inactive_alpha), phase2_label_x, str.lower(i_label_strategy), 90, "phase2-levels")
            float pb_px = array.get(phase2_pullback_price, idx)
            if not na(pb_px)
                f_draw_labeled_stat_line_meta(ds, lbl_reg, st.or_start_bar, pb_px, ln_end, color.new(pullback_activation_color, 0), "Dashed", i_line_width_primary, "Pullback Activation P25 MAE", color.new(pullback_activation_color, inactive_alpha), phase2_label_x, str.lower(i_label_strategy), 85, "phase2-levels")
            if not na(y_cash)
                f_draw_labeled_stat_line_meta(ds, lbl_reg, st.or_start_bar, y_cash, ln_end, color.new(bo_cashflow_color, inactive_alpha), "Dotted", i_line_width_secondary, "BO Cashflow P20 (MFE from BO) " + STL.f_pct_fmt(p20_bo), color.new(bo_cashflow_color, inactive_alpha), phase2_label_x, str.lower(i_label_strategy), 80, "phase2-levels")
            if not na(y_confirm)
                f_draw_labeled_stat_line_meta(ds, lbl_reg, st.or_start_bar, y_confirm, ln_end, color.new(bo_confirm_color, inactive_alpha), "Dashed", i_line_width_primary, "BO Confirm P75 (Fake MFE) " + STL.f_pct_fmt(f75), color.new(bo_confirm_color, inactive_alpha), phase2_label_x, str.lower(i_label_strategy), 75, "phase2-levels")
            if not na(y_pivot)
                f_draw_labeled_stat_line_meta(ds, lbl_reg, st.or_start_bar, y_pivot, ln_end, color.new(pivot_color, inactive_alpha), "Solid", i_line_width_primary, "Pivot P50 (Fake MFE) " + STL.f_pct_fmt(f50), color.new(pivot_color, inactive_alpha), phase2_label_x, str.lower(i_label_strategy), 70, "phase2-levels")
            if not na(y_rev90)
                f_draw_labeled_stat_line_meta(ds, lbl_reg, st.or_start_bar, y_rev90, ln_end, color.new(max_reversal_color, inactive_alpha), "Dotted", i_line_width_secondary, "Max Reversal P90 (Fake MAE) " + STL.f_pct_fmt(rev_p90), color.new(max_reversal_color, inactive_alpha), phase2_label_x, str.lower(i_label_strategy), 65, "phase2-levels")
            if not na(y_inv)
                f_draw_labeled_stat_line_meta(ds, lbl_reg, st.or_start_bar, y_inv, ln_end, color.new(invalidation_line_color, inactive_alpha), "Solid", i_line_width_primary, "PB | BO Invalidation P80 (BO MAE) " + STL.f_pct_fmt(mae_p80), color.new(invalidation_line_color, inactive_alpha), phase2_label_x, str.lower(i_label_strategy), 95, "phase2-levels")

            if i_show_debug and not pb_armed
                Core.f_draw_stat_label(ds, phase2_label_x, render_side == 1 ? st.or_high : st.or_low, "PB not armed", color.new(pb_not_armed_color, 90), "left", "tiny")

    // Flush label registry
    float merge_thr_manual = syminfo.mintick * float(i_label_merge_threshold_ticks)
    float merge_thr_auto = Core.f_merge_threshold_for_symbol(syminfo.ticker, syminfo.mintick)
    float merge_thr = math.max(merge_thr_manual, merge_thr_auto)
    Core.f_label_registry_flush(ds, lbl_reg, merge_thr, profile_label_size, i_label_stagger_bars)

if barstate.islast and array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_render_range(i)

// ============================================================================
// Tables
// ============================================================================

f_focus_idx() =>
    int focus = array.size(specs) > 0 ? array.size(specs) - 1 : 0
    if array.size(specs) > 0
        for i = 0 to array.size(specs) - 1
            RSL.RangeSpec sp = array.get(specs, i)
            RSL.RangeState st = array.get(states, i)
            bool in_or = RSL.f_in_session_pine(sp.session_or, sp.tz)
            bool in_data = RSL.f_in_session_pine(sp.session_data, sp.tz)
            if in_or or in_data or st.or_building
                focus := i
                break
    focus

// ----------------------------------------------------------------------------
// Combined Summary Table (includes UP/DOWN breakdown, streaks, after-streak,
// rolling windows). 3-column layout: Metric | UP | DOWN.
// ----------------------------------------------------------------------------

// Helper: draw section header row spanning all 3 columns
f_summary_section_header(table t, int row, string title, color bg, color fg, string hdr_sz) =>
    Tables.f_draw_header_cell(t, 0, row, title, color.new(bg, 80), fg, hdr_sz, 3, text.align_center)

// Helper: draw a row with metric label (col 0) and aggregate value spanning cols 1-2
f_summary_aggregate_row(table t, int row, string label, string value, color label_bg, color label_fg, color value_fg, string cell_sz) =>
    Tables.f_draw_value_cell(t, 0, row, label, label_bg, label_fg, cell_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 1, row, value, label_bg, value_fg, cell_sz, 2, text.align_left)

// Helper: draw a row with metric label (col 0), UP value (col 1), DOWN value (col 2)
f_summary_split_row(table t, int row, string label, string up_val, string down_val, color bg, color label_fg, color up_fg, color down_fg, string cell_sz) =>
    Tables.f_draw_value_cell(t, 0, row, label, bg, label_fg, cell_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 1, row, up_val, bg, up_fg, cell_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 2, row, down_val, bg, down_fg, cell_sz, 1, text.align_left)

f_draw_summary_table(int idx, string pos, color bg, color border, color header_bg, color header_txt, color body_txt, color bull_clr, color bear_clr, float target_pct, string hdr_sz, string body_sz) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    // Per-direction wins
    array<bool> bull_wins = hist.ev_win_bull
    array<bool> bear_wins = hist.ev_win_bear
    // Combined wins (bull OR bear on the same committed day)
    array<bool> combined_wins = STL.f_combine_bool_or(bull_wins, bear_wins)

    int n_total = array.size(combined_wins)

    // Per-direction counts
    int bull_full = 0
    int bull_fail = 0
    if array.size(bull_wins) > 0
        for i = 0 to array.size(bull_wins) - 1
            if array.get(bull_wins, i)
                bull_full += 1
            else
                bull_fail += 1
    int bear_full = 0
    int bear_fail = 0
    if array.size(bear_wins) > 0
        for i = 0 to array.size(bear_wins) - 1
            if array.get(bear_wins, i)
                bear_full += 1
            else
                bear_fail += 1

    float bull_rate = (bull_full + bull_fail) > 0 ? (float(bull_full) / float(bull_full + bull_fail)) * 100.0 : na
    float bear_rate = (bear_full + bear_fail) > 0 ? (float(bear_full) / float(bear_full + bear_fail)) * 100.0 : na

    // Per-direction stats
    array<float> mfe_b = STL.f_build_filtered(hist.mfe_bull)
    array<float> mfe_s = STL.f_build_filtered(hist.mfe_bear)
    array<float> mae_b = STL.f_build_filtered(hist.mae_bull_abs)
    array<float> mae_s = STL.f_build_filtered(hist.mae_bear_abs)
    float p20_mfe_b = array.size(mfe_b) > 0 ? array.percentile_nearest_rank(mfe_b, 20) : na
    float p20_mfe_s = array.size(mfe_s) > 0 ? array.percentile_nearest_rank(mfe_s, 20) : na
    float p50_mae_b = array.size(mae_b) > 0 ? array.percentile_nearest_rank(mae_b, 50) : na
    float p50_mae_s = array.size(mae_s) > 0 ? array.percentile_nearest_rank(mae_s, 50) : na

    // Streak stats — 3 scopes: UP, DOWN, Combined
    [cs_up, cw_up, bw_up, wf_up, aw_up, af_up] = STL.f_streak_stats(bull_wins)
    [cs_dn, cw_dn, bw_dn, wf_dn, aw_dn, af_dn] = STL.f_streak_stats(bear_wins)
    [cs_ag, cw_ag, bw_ag, wf_ag, aw_ag, af_ag] = STL.f_streak_stats(combined_wins)

    // After-streak probabilities (on combined wins)
    float p_f1 = STL.f_prob_after_streak(combined_wins, false, 1)
    float p_f2 = STL.f_prob_after_streak(combined_wins, false, 2)
    float p_f3 = STL.f_prob_after_streak(combined_wins, false, 3)
    float p_w1 = STL.f_prob_after_streak(combined_wins, true, 1)
    float p_w2 = STL.f_prob_after_streak(combined_wins, true, 2)
    float p_w3 = STL.f_prob_after_streak(combined_wins, true, 3)

    // Rolling win rates (UP | DOWN | Combined)
    float r5_up = STL.f_rolling_win_rate(bull_wins, 5)
    float r5_dn = STL.f_rolling_win_rate(bear_wins, 5)
    float r5_ag = STL.f_rolling_win_rate(combined_wins, 5)
    float r10_up = STL.f_rolling_win_rate(bull_wins, 10)
    float r10_dn = STL.f_rolling_win_rate(bear_wins, 10)
    float r10_ag = STL.f_rolling_win_rate(combined_wins, 10)
    float r20_up = STL.f_rolling_win_rate(bull_wins, 20)
    float r20_dn = STL.f_rolling_win_rate(bear_wins, 20)
    float r20_ag = STL.f_rolling_win_rate(combined_wins, 20)

    // Table size: header(1) + SUMMARY(8) + LIVE(7) + STREAKS_UP(6) + STREAKS_DN(6) + STREAKS_AGG(6) + FRONTRUN(6) + AFTER(7) + ROLLING(4) = 51 rows max
    int n_rows = 53
    int n_cols = 3
    table t = Tables.f_new_table(pos, n_cols, n_rows, color.new(bg, 90), color.new(border, 75), 1)
    color cell_bg = color.new(bg, 85)
    color section_bg = color.new(header_bg, 90)

    int r = 0

    // Title row (spans 3 cols)
    Tables.f_draw_header_cell(t, 0, r, "♦ " + sp.name + " ♦", color.new(header_bg, 70), header_txt, hdr_sz, 3, text.align_center)
    r += 1

    // ====== SUMMARY section (directional split) ======
    f_summary_section_header(t, r, "♦ SUMMARY ♦", header_bg, header_txt, hdr_sz)
    r += 1
    Tables.f_draw_header_cell(t, 0, r, "Metric", cell_bg, header_txt, body_sz, 1, text.align_left)
    Tables.f_draw_header_cell(t, 1, r, "↑ UP", cell_bg, bull_clr, body_sz, 1, text.align_center)
    Tables.f_draw_header_cell(t, 2, r, "↓ DOWN", cell_bg, bear_clr, body_sz, 1, text.align_center)
    r += 1
    f_summary_split_row(t, r, "› Full", str.tostring(bull_full), str.tostring(bear_full), cell_bg, body_txt, bull_clr, bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Failed", str.tostring(bull_fail), str.tostring(bear_fail), cell_bg, body_txt, bear_clr, bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Rate", STL.f_pct_fmt(bull_rate), STL.f_pct_fmt(bear_rate), cell_bg, body_txt, not na(bull_rate) and bull_rate >= 50 ? bull_clr : bear_clr, not na(bear_rate) and bear_rate >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› p20 MFE", STL.f_pct_fmt(p20_mfe_b), STL.f_pct_fmt(p20_mfe_s), cell_bg, body_txt, bull_clr, bull_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› p50 MAE", STL.f_pct_fmt(p50_mae_b), STL.f_pct_fmt(p50_mae_s), cell_bg, body_txt, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› N (total)", str.tostring(n_total), cell_bg, body_txt, body_txt, body_sz)
    r += 1

    // ====== LIVE SESSION section ======
    f_summary_section_header(t, r, "♦ LIVE SESSION ♦", header_bg, header_txt, hdr_sz)
    r += 1
    string status_txt = st.or_building ? "Building" : st.or_complete ? "Active" : "Wait"
    f_summary_aggregate_row(t, r, "› Status", status_txt, cell_bg, body_txt, body_txt, body_sz)
    r += 1
    int live_bias = array.get(phase2_live_bias, idx)
    string bearing_txt = live_bias == 1 ? "UP" : live_bias == -1 ? "DOWN" : "NEUTRAL"
    color bearing_clr = live_bias == 1 ? bull_clr : live_bias == -1 ? bear_clr : body_txt
    f_summary_aggregate_row(t, r, "› Bearing", bearing_txt, cell_bg, body_txt, bearing_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› FR Zone", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› FR Price", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    bool is_full = st.daily_bull_mfe >= target_pct or st.daily_bear_mfe >= target_pct
    string res_txt = is_full ? "FULL" : "PENDING"
    color res_clr = is_full ? bull_clr : body_txt
    f_summary_aggregate_row(t, r, "› Result", res_txt, cell_bg, body_txt, res_clr, body_sz)
    r += 1
    float entry_px = array.get(phase2_breakout_price, idx)
    string entry_txt = na(entry_px) ? "---" : str.tostring(entry_px, format.mintick)
    f_summary_aggregate_row(t, r, "› Entry Price", entry_txt, cell_bg, body_txt, body_txt, body_sz)
    r += 1

    // ====== STREAKS — UP ======
    f_summary_section_header(t, r, "♦ STREAKS — UP ♦", header_bg, header_txt, hdr_sz)
    r += 1
    string cur_up_txt = str.tostring(cs_up) + (cw_up ? " Full" : " Failed")
    color cur_up_clr = cw_up ? bull_clr : bear_clr
    f_summary_aggregate_row(t, r, "› Current", cur_up_txt, cell_bg, body_txt, cur_up_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Best Full Run", str.tostring(bw_up), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Worst Fail Run", str.tostring(wf_up), cell_bg, body_txt, bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Full Run", str.tostring(aw_up, "#.#"), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Fail Run", str.tostring(af_up, "#.#"), cell_bg, body_txt, bear_clr, body_sz)
    r += 1

    // ====== STREAKS — DOWN ======
    f_summary_section_header(t, r, "♦ STREAKS — DOWN ♦", header_bg, header_txt, hdr_sz)
    r += 1
    string cur_dn_txt = str.tostring(cs_dn) + (cw_dn ? " Full" : " Failed")
    color cur_dn_clr = cw_dn ? bull_clr : bear_clr
    f_summary_aggregate_row(t, r, "› Current", cur_dn_txt, cell_bg, body_txt, cur_dn_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Best Full Run", str.tostring(bw_dn), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Worst Fail Run", str.tostring(wf_dn), cell_bg, body_txt, bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Full Run", str.tostring(aw_dn, "#.#"), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Fail Run", str.tostring(af_dn, "#.#"), cell_bg, body_txt, bear_clr, body_sz)
    r += 1

    // ====== STREAKS — AGGREGATE ======
    f_summary_section_header(t, r, "♦ STREAKS — AGGREGATE ♦", header_bg, header_txt, hdr_sz)
    r += 1
    string cur_ag_txt = str.tostring(cs_ag) + (cw_ag ? " Full" : " Failed")
    color cur_ag_clr = cw_ag ? bull_clr : bear_clr
    f_summary_aggregate_row(t, r, "› Current", cur_ag_txt, cell_bg, body_txt, cur_ag_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Best Full Run", str.tostring(bw_ag), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Worst Fail Run", str.tostring(wf_ag), cell_bg, body_txt, bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Full Run", str.tostring(aw_ag, "#.#"), cell_bg, body_txt, bull_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Fail Run", str.tostring(af_ag, "#.#"), cell_bg, body_txt, bear_clr, body_sz)
    r += 1

    // ====== FRONT RUN (placeholder) ======
    f_summary_section_header(t, r, "♦ FRONT RUN ♦", header_bg, header_txt, hdr_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Current", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Best Full Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Worst Fail Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Full Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› Avg Fail Run", "---", cell_bg, body_txt, body_txt, body_sz)
    r += 1

    // ====== AFTER STREAK (aggregate on combined wins) ======
    f_summary_section_header(t, r, "♦ AFTER STREAK ♦", header_bg, header_txt, hdr_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 1 Fail", STL.f_pct_fmt(p_f1) + " nxt Full", cell_bg, body_txt, not na(p_f1) and p_f1 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 2 Fail", STL.f_pct_fmt(p_f2) + " nxt Full", cell_bg, body_txt, not na(p_f2) and p_f2 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 3+ Fail", STL.f_pct_fmt(p_f3) + " nxt Full", cell_bg, body_txt, not na(p_f3) and p_f3 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 1 Full", STL.f_pct_fmt(p_w1) + " nxt Full", cell_bg, body_txt, not na(p_w1) and p_w1 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 2 Full", STL.f_pct_fmt(p_w2) + " nxt Full", cell_bg, body_txt, not na(p_w2) and p_w2 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_aggregate_row(t, r, "› After 3+ Full", STL.f_pct_fmt(p_w3) + " nxt Full", cell_bg, body_txt, not na(p_w3) and p_w3 > 50 ? bull_clr : bear_clr, body_sz)
    r += 1

    // ====== ROLLING (UP | DOWN | Combined) ======
    f_summary_section_header(t, r, "♦ ROLLING (Full %) ♦", header_bg, header_txt, hdr_sz)
    r += 1
    Tables.f_draw_header_cell(t, 0, r, "Window", cell_bg, header_txt, body_sz, 1, text.align_left)
    Tables.f_draw_header_cell(t, 1, r, "UP", cell_bg, bull_clr, body_sz, 1, text.align_center)
    Tables.f_draw_header_cell(t, 2, r, "DOWN", cell_bg, bear_clr, body_sz, 1, text.align_center)
    r += 1
    f_summary_split_row(t, r, "› Last 5", STL.f_pct_fmt(r5_up), STL.f_pct_fmt(r5_dn), cell_bg, body_txt, not na(r5_up) and r5_up >= 50 ? bull_clr : bear_clr, not na(r5_dn) and r5_dn >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Last 10", STL.f_pct_fmt(r10_up), STL.f_pct_fmt(r10_dn), cell_bg, body_txt, not na(r10_up) and r10_up >= 50 ? bull_clr : bear_clr, not na(r10_dn) and r10_dn >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    f_summary_split_row(t, r, "› Last 20", STL.f_pct_fmt(r20_up), STL.f_pct_fmt(r20_dn), cell_bg, body_txt, not na(r20_up) and r20_up >= 50 ? bull_clr : bear_clr, not na(r20_dn) and r20_dn >= 50 ? bull_clr : bear_clr, body_sz)
    r += 1
    // Combined row spanning cols 1-2
    Tables.f_draw_value_cell(t, 0, r, "› Combined 5/10/20", cell_bg, body_txt, body_sz, 1, text.align_left)
    Tables.f_draw_value_cell(t, 1, r, STL.f_pct_fmt(r5_ag) + " / " + STL.f_pct_fmt(r10_ag) + " / " + STL.f_pct_fmt(r20_ag), cell_bg, body_txt, body_sz, 2, text.align_center)

// ----------------------------------------------------------------------------
// DOW Diagnostic — MFE/MAE percentiles per weekday, split by direction (▲/▼)
// ----------------------------------------------------------------------------

f_draw_dow_table(int idx, string pos, color bg, color border, color header_bg, color header_txt, color body_txt, color bull_clr, color bear_clr, string hdr_sz, string body_sz) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    // Layout: 7 cols (Metric | SUN..FRI). Rows: Title(1) + ColHeader(1) + 8 metrics × 2 directions = 18 rows
    int n_cols = 7
    int n_rows = 20
    table t = Tables.f_new_table(pos, n_cols, n_rows, color.new(bg, 90), color.new(border, 75), 1)
    color cell_bg = color.new(bg, 85)

    int r = 0
    // Title spans 7 cols
    Tables.f_draw_header_cell(t, 0, r, "♦ " + sp.name + " — DAY OF WEEK ♦", color.new(header_bg, 70), header_txt, hdr_sz, 7, text.align_center)
    r += 1

    // Column headers: METRIC | SUN | MON | TUE | WED | THU | FRI
    Tables.f_draw_header_cell(t, 0, r, "METRIC", color.new(header_bg, 80), header_txt, body_sz, 1, text.align_left)
    array<string> dow_labels = array.from("SUN", "MON", "TUE", "WED", "THU", "FRI")
    for d_idx = 0 to 5
        Tables.f_draw_header_cell(t, d_idx + 1, r, array.get(dow_labels, d_idx), color.new(header_bg, 80), header_txt, body_sz, 1, text.align_center)
    r += 1

    // Per-day stats computation (for each day, split into bull & bear slices)
    // dow values: 1=SUN, 2=MON, 3=TUE, 4=WED, 5=THU, 6=FRI
    array<int> dow_values = array.from(1, 2, 3, 4, 5, 6)

    // For each metric row, we iterate over days. Structure: one row per metric, each metric has ▲ and ▼ sub-rows.
    string metric_names = ""  // (placeholder if needed later)

    // Row: N (per day, split)
    Tables.f_draw_value_cell(t, 0, r, "› N ▲", cell_bg, body_txt, body_sz, 1, text.align_left)
    for d_idx = 0 to 5
        int d = array.get(dow_values, d_idx)
        int n_bull = 0
        int n_all = array.size(hist.dow)
        if n_all > 0
            for i = 0 to n_all - 1
                if array.get(hist.dow, i) == d
                    float v = array.get(hist.mfe_bull, i)
                    if not na(v) and v > 0
                        n_bull += 1
        Tables.f_draw_value_cell(t, d_idx + 1, r, str.tostring(n_bull), cell_bg, bull_clr, body_sz, 1, text.align_center)
    r += 1
    Tables.f_draw_value_cell(t, 0, r, "› N ▼", cell_bg, body_txt, body_sz, 1, text.align_left)
    for d_idx = 0 to 5
        int d = array.get(dow_values, d_idx)
        int n_bear = 0
        int n_all = array.size(hist.dow)
        if n_all > 0
            for i = 0 to n_all - 1
                if array.get(hist.dow, i) == d
                    float v = array.get(hist.mfe_bear, i)
                    if not na(v) and v > 0
                        n_bear += 1
        Tables.f_draw_value_cell(t, d_idx + 1, r, str.tostring(n_bear), cell_bg, bear_clr, body_sz, 1, text.align_center)
    r += 1

    // Row: Full% (per day, split)
    Tables.f_draw_value_cell(t, 0, r, "› Full% ▲", cell_bg, body_txt, body_sz, 1, text.align_left)
    for d_idx = 0 to 5
        int d = array.get(dow_values, d_idx)
        int w = 0
        int n = 0
        int n_all = array.size(hist.dow)
        if n_all > 0
            for i = 0 to n_all - 1
                if array.get(hist.dow, i) == d
                    n += 1
                    if array.get(hist.ev_win_bull, i)
                        w += 1
        float rate = n > 0 ? (float(w) / float(n)) * 100.0 : na
        color rate_clr = not na(rate) and rate >= 50 ? bull_clr : bear_clr
        Tables.f_draw_value_cell(t, d_idx + 1, r, na(rate) ? "---" : str.tostring(rate, "#.#") + "%", cell_bg, rate_clr, body_sz, 1, text.align_center)
    r += 1
    Tables.f_draw_value_cell(t, 0, r, "› Full% ▼", cell_bg, body_txt, body_sz, 1, text.align_left)
    for d_idx = 0 to 5
        int d = array.get(dow_values, d_idx)
        int w = 0
        int n = 0
        int n_all = array.size(hist.dow)
        if n_all > 0
            for i = 0 to n_all - 1
                if array.get(hist.dow, i) == d
                    n += 1
                    if array.get(hist.ev_win_bear, i)
                        w += 1
        float rate = n > 0 ? (float(w) / float(n)) * 100.0 : na
        color rate_clr = not na(rate) and rate >= 50 ? bull_clr : bear_clr
        Tables.f_draw_value_cell(t, d_idx + 1, r, na(rate) ? "---" : str.tostring(rate, "#.#") + "%", cell_bg, rate_clr, body_sz, 1, text.align_center)
    r += 1

    // Rows: p50 / p75 / p90 MAE (per day, split)
    array<int> mae_pctiles = array.from(50, 75, 90)
    for mi = 0 to 2
        int pct = array.get(mae_pctiles, mi)
        string mbull_label = "› p" + str.tostring(pct) + " MAE ▲"
        string mbear_label = "› p" + str.tostring(pct) + " MAE ▼"
        Tables.f_draw_value_cell(t, 0, r, mbull_label, cell_bg, body_txt, "Tiny", 1, text.align_left)
        for d_idx = 0 to 5
            int d = array.get(dow_values, d_idx)
            array<float> arr = array.new_float(0)
            int n_all = array.size(hist.dow)
            if n_all > 0
                for i = 0 to n_all - 1
                    if array.get(hist.dow, i) == d
                        float v = array.get(hist.mae_bull_abs, i)
                        if not na(v) and v > 0
                            array.push(arr, v)
            float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, pct) : na
            Tables.f_draw_value_cell(t, d_idx + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, body_txt, "Tiny", 1, text.align_center)
        r += 1
        Tables.f_draw_value_cell(t, 0, r, mbear_label, cell_bg, body_txt, "Tiny", 1, text.align_left)
        for d_idx = 0 to 5
            int d = array.get(dow_values, d_idx)
            array<float> arr = array.new_float(0)
            int n_all = array.size(hist.dow)
            if n_all > 0
                for i = 0 to n_all - 1
                    if array.get(hist.dow, i) == d
                        float v = array.get(hist.mae_bear_abs, i)
                        if not na(v) and v > 0
                            array.push(arr, v)
            float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, pct) : na
            Tables.f_draw_value_cell(t, d_idx + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, body_txt, "Tiny", 1, text.align_center)
        r += 1

    // Rows: p25 / p50 / p75 MFE (per day, split)
    array<int> mfe_pctiles = array.from(25, 50, 75)
    for mi = 0 to 2
        int pct = array.get(mfe_pctiles, mi)
        string fbull_label = "› p" + str.tostring(pct) + " MFE ▲"
        string fbear_label = "› p" + str.tostring(pct) + " MFE ▼"
        Tables.f_draw_value_cell(t, 0, r, fbull_label, cell_bg, body_txt, "Tiny", 1, text.align_left)
        for d_idx = 0 to 5
            int d = array.get(dow_values, d_idx)
            array<float> arr = array.new_float(0)
            int n_all = array.size(hist.dow)
            if n_all > 0
                for i = 0 to n_all - 1
                    if array.get(hist.dow, i) == d
                        float v = array.get(hist.mfe_bull, i)
                        if not na(v) and v > 0
                            array.push(arr, v)
            float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, pct) : na
            Tables.f_draw_value_cell(t, d_idx + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, bull_clr, "Tiny", 1, text.align_center)
        r += 1
        Tables.f_draw_value_cell(t, 0, r, fbear_label, cell_bg, body_txt, "Tiny", 1, text.align_left)
        for d_idx = 0 to 5
            int d = array.get(dow_values, d_idx)
            array<float> arr = array.new_float(0)
            int n_all = array.size(hist.dow)
            if n_all > 0
                for i = 0 to n_all - 1
                    if array.get(hist.dow, i) == d
                        float v = array.get(hist.mfe_bear, i)
                        if not na(v) and v > 0
                            array.push(arr, v)
            float val = array.size(arr) > 0 ? array.percentile_nearest_rank(arr, pct) : na
            Tables.f_draw_value_cell(t, d_idx + 1, r, na(val) ? "---" : STL.f_pct_fmt(val), cell_bg, bear_clr, "Tiny", 1, text.align_center)
        r += 1

// ----------------------------------------------------------------------------
// Legacy table views: MFE / MAE / DOW (simple) / Fakeout
// ----------------------------------------------------------------------------

f_draw_legacy_table(int idx, string pos, color bg, color border, color header_bg, color header_txt, color body_txt, color bull_clr, color bear_clr, string view, string hdr_sz, string body_sz) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    bool is_dow = view == "DOW View"
    int n_cols = is_dow ? 3 : 6
    int n_rows = is_dow ? 7 : 3
    table t = Tables.f_new_table(pos, n_cols, n_rows, color.new(bg, 85), color.new(border, 70), 1)
    color cell_bg = color.new(bg, 85)
    color h_bg = color.new(header_bg, 70)

    Tables.f_draw_header_cell(t, 0, 0, sp.name + " - " + view, h_bg, header_txt, hdr_sz, 1, text.align_center)
    if is_dow
        Tables.f_draw_header_cell(t, 1, 0, "Count", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 2, 0, "Avg MFE", h_bg, header_txt, hdr_sz, 1, text.align_center)
    else
        Tables.f_draw_header_cell(t, 1, 0, "Count", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 2, 0, "P50", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 3, 0, "P75", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 4, 0, "P90", h_bg, header_txt, hdr_sz, 1, text.align_center)
        Tables.f_draw_header_cell(t, 5, 0, "Rate", h_bg, header_txt, hdr_sz, 1, text.align_center)

    if view == "MFE View"
        array<float> bull = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear = STL.f_build_filtered(hist.mfe_bear)
        float b50 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 50) : na
        float b75 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 75) : na
        float b90 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 90) : na
        float s50 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 50) : na
        float s75 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 75) : na
        float s90 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 90) : na
        Tables.f_draw_value_cell(t, 0, 1, "Bull", cell_bg, bull_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 1, str.tostring(array.size(bull)), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 1, STL.f_pct_fmt(b50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 1, STL.f_pct_fmt(b75), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 1, STL.f_pct_fmt(b90), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 1, "-", cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 0, 2, "Bear", cell_bg, bear_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 2, str.tostring(array.size(bear)), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 2, STL.f_pct_fmt(s50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 2, STL.f_pct_fmt(s75), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 2, STL.f_pct_fmt(s90), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 2, "-", cell_bg, body_txt, body_sz, 1, text.align_center)
    else if view == "MAE View"
        array<float> mab = STL.f_build_filtered(hist.mae_bull_abs)
        array<float> mas = STL.f_build_filtered(hist.mae_bear_abs)
        array<float> mpb = STL.f_build_filtered(hist.mae_bull_pb)
        array<float> mps = STL.f_build_filtered(hist.mae_bear_pb)
        float rb = array.size(hist.r_multiple_bull) > 0 ? array.avg(hist.r_multiple_bull) : na
        float rs = array.size(hist.r_multiple_bear) > 0 ? array.avg(hist.r_multiple_bear) : na
        Tables.f_draw_value_cell(t, 0, 1, "Bull Abs/PB", cell_bg, bull_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 1, str.tostring(array.size(mab)), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 1, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 1, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 75) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 1, STL.f_pct_fmt(array.size(mpb) > 0 ? array.percentile_nearest_rank(mpb, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 1, na(rb) ? "n/a" : str.tostring(rb, "#.##"), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 0, 2, "Bear Abs/PB", cell_bg, bear_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 2, str.tostring(array.size(mas)), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 2, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 2, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 75) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 2, STL.f_pct_fmt(array.size(mps) > 0 ? array.percentile_nearest_rank(mps, 50) : na), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 2, na(rs) ? "n/a" : str.tostring(rs, "#.##"), cell_bg, body_txt, body_sz, 1, text.align_center)
    else if view == "Fakeout View"
        array<float> fmb = STL.f_build_filtered(hist.fake_mfe_bull)
        array<float> fms = STL.f_build_filtered(hist.fake_mfe_bear)
        array<float> rfb = STL.f_build_filtered(hist.fake_mae_bull)
        array<float> rfs = STL.f_build_filtered(hist.fake_mae_bear)
        float b50 = array.size(fmb) > 0 ? array.percentile_nearest_rank(fmb, 50) : na
        float b75 = array.size(fmb) > 0 ? array.percentile_nearest_rank(fmb, 75) : na
        float s50 = array.size(fms) > 0 ? array.percentile_nearest_rank(fms, 50) : na
        float s75 = array.size(fms) > 0 ? array.percentile_nearest_rank(fms, 75) : na
        float rb50 = array.size(rfb) > 0 ? array.percentile_nearest_rank(rfb, 50) : na
        float rb90 = array.size(rfb) > 0 ? array.percentile_nearest_rank(rfb, 90) : na
        float rs50 = array.size(rfs) > 0 ? array.percentile_nearest_rank(rfs, 50) : na
        float rs90 = array.size(rfs) > 0 ? array.percentile_nearest_rank(rfs, 90) : na
        float dbr = STL.f_double_break_rate(hist.double_break, hist.entry_triggered_bull, hist.entry_triggered_bear)
        Tables.f_draw_value_cell(t, 0, 1, "Bull Fake", cell_bg, bull_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 1, STL.f_pct_fmt(b50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 1, STL.f_pct_fmt(b75), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 1, STL.f_pct_fmt(rb50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 1, STL.f_pct_fmt(rb90), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 1, STL.f_pct_fmt(dbr), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 0, 2, "Bear Fake", cell_bg, bear_clr, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 1, 2, STL.f_pct_fmt(s50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 2, 2, STL.f_pct_fmt(s75), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 3, 2, STL.f_pct_fmt(rs50), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 4, 2, STL.f_pct_fmt(rs90), cell_bg, body_txt, body_sz, 1, text.align_center)
        Tables.f_draw_value_cell(t, 5, 2, STL.f_pct_fmt(dbr), cell_bg, body_txt, body_sz, 1, text.align_center)
    else  // DOW View (aggregate)
        for d = 1 to 6
            string d_name = STL.f_day_full(d)
            Tables.f_draw_header_cell(t, 0, d, d_name, cell_bg, header_txt, hdr_sz, 1, text.align_center)
            int cnt = 0
            float sum_b = 0.0
            float sum_s = 0.0
            int n_all = array.size(hist.dow)
            if n_all > 0
                for j = 0 to n_all - 1
                    if array.get(hist.dow, j) == d
                        cnt += 1
                        sum_b += array.get(hist.mfe_bull, j)
                        sum_s += array.get(hist.mfe_bear, j)
            float avg_net = cnt == 0 ? na : (sum_b + sum_s) / float(2 * cnt)
            Tables.f_draw_value_cell(t, 1, d, str.tostring(cnt), cell_bg, body_txt, body_sz, 1, text.align_center)
            Tables.f_draw_value_cell(t, 2, d, STL.f_pct_fmt(avg_net), cell_bg, body_txt, body_sz, 1, text.align_center)

// ----------------------------------------------------------------------------
// Table dispatcher
// ----------------------------------------------------------------------------

if barstate.islast and i_show_table and array.size(specs) > 0
    int idx = f_focus_idx()
    string pos_resolved = Tables.f_table_pos(i_table_pos)

    if i_table_view == "Summary"
        f_draw_summary_table(idx, pos_resolved, table_bg_color_resolved, table_border_color_resolved, table_header_bg_color_resolved, table_header_text_color_resolved, table_body_text_color_resolved, table_bull_color, table_bear_color, i_ev_target_pct, r_tbl_hdr_size, r_tbl_body_size)
    else if i_table_view == "DOW Diagnostic"
        f_draw_dow_table(idx, pos_resolved, table_bg_color_resolved, table_border_color_resolved, table_header_bg_color_resolved, table_header_text_color_resolved, table_body_text_color_resolved, table_bull_color, table_bear_color, r_tbl_hdr_size, r_tbl_body_size)
    else
        f_draw_legacy_table(idx, pos_resolved, table_bg_color_resolved, table_border_color_resolved, table_header_bg_color_resolved, table_header_text_color_resolved, table_body_text_color_resolved, table_bull_color, table_bear_color, i_table_view, r_tbl_hdr_size, r_tbl_body_size)
