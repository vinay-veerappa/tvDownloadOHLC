// ============================================================================
// Theme resolution
// ============================================================================
// theme_mode_resolved: "Custom" collapses to "Dark" for all HLevels/Zones/Markers/VMarks calls
// so stat lines always use contrast-validated palette colors.
// Table colors (L152-160) use i_theme_mode directly, preserving user-specified table chrome
// in Custom mode. This asymmetry is intentional.
string theme_mode_resolved = i_theme_mode == "Light" ? "Light" : "Dark"

// Pre-resolve common colors at top-level
debug_text_color_resolved = Core.f_resolve_color(i_theme_mode, color.new(i_debug_text_color, 0), #F1F5F9, #111827)
debug_bg_color_resolved = Core.f_resolve_color(i_theme_mode, color.new(i_debug_bg_color, 0), #1E3A8A, #93C5FD)
table_bg_color_resolved = Core.f_resolve_color(i_theme_mode, color.new(i_table_bg_color, 0), #0F172A, #F1F5F9)
table_border_color_resolved = Core.f_resolve_color(i_theme_mode, color.new(i_table_border_color, 0), #64748B, #CBD5E1)
table_header_bg_color_resolved = Core.f_resolve_color(i_theme_mode, color.new(i_table_header_bg_color, 0), #2563EB, #60A5FA)
table_header_text_color_resolved = Core.f_resolve_color(i_theme_mode, color.new(i_table_header_text_color, 0), #F1F5F9, #0F172A)
table_body_text_color_resolved = Core.f_resolve_color(i_theme_mode, color.new(i_table_body_text_color, 0), #F1F5F9, #0F172A)
