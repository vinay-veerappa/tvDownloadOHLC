//@version=6
indicator("Daily NY Levels Analytics (Phase 2)", overlay=true, max_bars_back=5000, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// Daily NY Levels Analytics - Phase 2 Base
// Derived from DailyNYLevelsV5 to reuse proven runtime/session/history logic.
// Author: vveerappa | Version: 1
// ============================================================================
// CRITICAL: These import IDs assume the three libraries are published to TradingView
// under your account (vveerappa) with version 1. Before publishing this indicator,
// ensure all three libraries are published first:
//   - vveerappa/RangeSessionLib/1
//   - vveerappa/PineDrawingLib/1  
//   - vveerappa/StatsLib/1
// If libraries have different versions, update the /1 suffixes below.
// ============================================================================
import vveerappa/RangeSessionLib/6 as RSL
import vveerappa/PineDrawingLib/2 as PDL
import vveerappa/StatsLib/2 as STL

// Inputs
grp_theme = "Theme"
i_theme_mode = input.string("Custom", "Color Theme", options=["Custom", "Dark", "Light"], group=grp_theme)

grp_session = "Session & Presets"
i_preset = input.string("Market Open", "Preset", options=["1800 Break", "0300 Break", "0300 Transfer", "Q1 Break", "Market Open", "Magic Hour", "1100 BO", "Lunch Break", "1400 Break", "Custom"], group=grp_session)
i_custom_start = input.string("0930", "Custom OR Start (HHMM)", group=grp_session)
i_custom_end = input.string("0935", "Custom OR End (HHMM)", group=grp_session)
i_custom_cutoff = input.string("1200", "Custom Cutoff (HHMM)", group=grp_session)
i_timezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "America/Denver", "US/Eastern", "US/Central", "UTC"], group=grp_session)
i_ev_target_pct = input.float(0.30, "EV Target (%)", minval=0.01, step=0.01, group=grp_session)

// ── Visual System ──────────────────────────────────────────────────────
// Shared design tokens controlling every visual element. See VISUAL_SYSTEM.md.
grp_visual = "Visual System"
i_bull_color = input.color(color.green, "Bull Color", group=grp_visual)
i_bear_color = input.color(color.red, "Bear Color", group=grp_visual)
i_label_size = input.string("small", "Label Size", options=["tiny", "small", "normal", "large", "huge"], group=grp_visual)
i_label_text_color = input.color(color.white, "Label Text Color", group=grp_visual)
i_line_width_primary = input.int(2, "Primary Line Width", minval=1, maxval=5, group=grp_visual)
i_line_width_secondary = input.int(1, "Secondary Line Width", minval=1, maxval=5, group=grp_visual)
i_label_offset_ticks = input.int(24, "Label Offset (ticks)", minval=0, maxval=500, group=grp_visual)
i_label_gap_bars = input.int(8, "Label Gap From Line End (bars)", minval=0, maxval=100, group=grp_visual)
i_zone_transparency = input.int(75, "Zone Transparency", minval=0, maxval=100, group=grp_visual)
i_right_extend_bars = input.int(20, "Line Right Extension", minval=1, maxval=200, group=grp_visual)
i_box_style = input.string("Solid", "OR Box Style", options=["Solid", "Dashed", "Dotted"], group=grp_visual)
i_box_width = input.int(1, "OR Box Width", minval=1, maxval=5, group=grp_visual)
i_label_merge_threshold_ticks = input.int(20, "Label Merge Threshold (ticks)", minval=1, maxval=500, group=grp_visual)

// ── Context Colors ────────────────────────────────────────────────────
// Colors for bilateral MFE stat lines, histogram, time distribution.
grp_ctx_colors = "Context Colors"
i_color_median = input.color(color.yellow, "Median Color", group=grp_ctx_colors)
i_color_average = input.color(color.aqua, "Average Color", group=grp_ctx_colors)
i_color_stretch = input.color(color.orange, "Stretch Color", group=grp_ctx_colors)
i_color_midpoint = input.color(color.gray, "Midpoint Color", group=grp_ctx_colors)
i_color_time_title = input.color(color.fuchsia, "Time Dist Title Color", group=grp_ctx_colors)

// ── Tactical Colors ───────────────────────────────────────────────────
// Colors for Phase 2 directional overlay lines and zones.
grp_tac_colors = "Tactical Colors"
i_color_bo_cashflow = input.color(color.new(color.green, 0), "BO Cashflow Color", group=grp_tac_colors)
i_color_bo_confirm = input.color(color.new(color.teal, 0), "BO Confirm Color", group=grp_tac_colors)
i_color_pivot = input.color(color.new(color.aqua, 0), "Pivot Color", group=grp_tac_colors)
i_color_reversal_zone = input.color(color.new(color.orange, 75), "Reversal Target Zone Color", group=grp_tac_colors)
i_color_max_reversal = input.color(color.new(color.orange, 0), "Max Reversal Color", group=grp_tac_colors)
i_color_invalidation_line = input.color(color.new(color.red, 0), "Invalidation Line Color", group=grp_tac_colors)
i_color_mid_probability = input.color(color.new(color.gray, 0), "Mid Probability Color", group=grp_tac_colors)
i_color_breakout_activation = input.color(color.purple, "Breakout Activation Color", group=grp_tac_colors)
i_color_pullback_activation = input.color(color.lime, "Pullback Activation Color", group=grp_tac_colors)

// ── Features ──────────────────────────────────────────────────────────
// Toggles and functional parameters for each rendering module.
grp_features = "Features"
i_show_stat_lines = input.bool(true, "Show Stat Lines", group=grp_features)
i_show_histogram = input.bool(true, "Show Histogram Bands", group=grp_features)
i_hist_start_pct = input.int(20, "Histogram Start Percentile", minval=1, maxval=98, group=grp_features)
i_hist_end_pct = input.int(90, "Histogram End Percentile", minval=2, maxval=99, group=grp_features)
i_hist_pct_step = input.int(5, "Histogram Percentile Step", minval=1, maxval=25, group=grp_features)
i_show_hist_bin_labels = input.bool(true, "Show Histogram Bin Labels", group=grp_features)
i_pct_confirm = input.int(20, "Confirm Percentile", minval=1, maxval=99, group=grp_features)
i_pct_target1 = input.int(50, "Target1 Percentile", minval=1, maxval=99, group=grp_features)
i_pct_target2 = input.int(75, "Target2 Percentile", minval=1, maxval=99, group=grp_features)
i_pct_stretch = input.int(90, "Stretch Percentile", minval=1, maxval=99, group=grp_features)
i_show_time_dist = input.bool(true, "Show Time Distribution", group=grp_features)
i_time_bucket_mins = input.int(5, "Time Bucket (minutes)", minval=1, maxval=60, group=grp_features)
i_time_offset_ticks = input.int(200, "Offset Below MFE (ticks)", group=grp_features)
i_show_time_avg = input.bool(true, "Show AVG Line", group=grp_features)
i_show_time_med = input.bool(true, "Show Median Line", group=grp_features)
i_show_phase2_levels = input.bool(true, "Show Phase 2 Levels", group=grp_features)
i_emphasize_active_side = input.bool(true, "Emphasize Active Side", group=grp_features)
i_show_mae_hist = input.bool(false, "Show MAE Histogram (Optional)", group=grp_features)

// ── Data Table ────────────────────────────────────────────────────────
grp_table = "Data Table"
i_show_table = input.bool(true, "Show Data Table", group=grp_table)
i_table_view = input.string("MFE View", "Table View", options=["MFE View", "MAE View", "DOW View", "Fakeout View"], group=grp_table)
i_table_pos = input.string("Bottom Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grp_table)
i_table_bg_color = input.color(color.black, "Table Background Color", group=grp_table)
i_table_border_color = input.color(color.gray, "Table Border Color", group=grp_table)
i_table_header_bg_color = input.color(color.blue, "Table Header Background Color", group=grp_table)
i_table_header_text_color = input.color(color.white, "Table Header Text Color", group=grp_table)
i_table_body_text_color = input.color(color.white, "Table Body Text Color", group=grp_table)

// ── Debug ─────────────────────────────────────────────────────────────
grp_debug = "Debug"
i_show_debug = input.bool(false, "Show Debug Labels", group=grp_debug)
i_debug_text_color = input.color(color.white, "Debug Text Color", group=grp_debug)
i_debug_bg_color = input.color(color.blue, "Debug Background Color", group=grp_debug)

// Resolved ranges + runtime state arrays
var array<RSL.RangeSpec> specs = array.new<RSL.RangeSpec>(0)
var array<RSL.RangeState> states = array.new<RSL.RangeState>(0)
var array<STL.ExcursionHistory> histories = array.new<STL.ExcursionHistory>(0)
var array<PDL.PineDrawingState> drawings = array.new<PDL.PineDrawingState>(0)
var array<bool> prev_in_or = array.new_bool(0)
var array<bool> prev_in_data = array.new_bool(0)
var array<int> phase2_live_bias = array.new_int(0)        // 1=bull, -1=bear, 0=neutral
var array<int> phase2_breakout_side = array.new_int(0)    // 1=bull, -1=bear, 0=none
var array<float> phase2_breakout_price = array.new_float(0)
var array<bool> phase2_pullback_armed = array.new_bool(0)
var array<float> phase2_pullback_price = array.new_float(0)  // P25 MAE activation price

f_init_runtime() =>
    array.clear(specs)
    array.clear(states)
    array.clear(histories)
    array.clear(drawings)
    array.clear(prev_in_or)
    array.clear(prev_in_data)
    array.clear(phase2_live_bias)
    array.clear(phase2_breakout_side)
    array.clear(phase2_breakout_price)
    array.clear(phase2_pullback_armed)
    array.clear(phase2_pullback_price)

    array<RSL.RangeSpec> resolved = RSL.f_resolve_preset(i_preset, i_custom_start, i_custom_end, i_custom_cutoff, i_timezone)
    int n = array.size(resolved)
    if n > 0
        for i = 0 to n - 1
            RSL.RangeSpec sp = array.get(resolved, i)
            array.push(specs, sp)
            array.push(states, RSL.f_new_range_state(sp))
            array.push(histories, STL.f_new_excursion_history(sp.name))
            array.push(drawings, PDL.f_new_drawing_state())
            array.push(prev_in_or, false)
            array.push(prev_in_data, false)
            array.push(phase2_live_bias, 0)
            array.push(phase2_breakout_side, 0)
            array.push(phase2_breakout_price, na)
            array.push(phase2_pullback_armed, false)
            array.push(phase2_pullback_price, na)

if barstate.isfirst
    f_init_runtime()

// Lower timeframe cache once per bar.
[ltf_high_arr, ltf_low_arr, ltf_close_arr, ltf_time_arr] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, close, time])
int ny_dow = dayofweek(time, i_timezone)

f_theme_color(color custom_color, color dark_color, color light_color) =>
    i_theme_mode == "Dark" ? dark_color : i_theme_mode == "Light" ? light_color : custom_color

f_or_color(int idx) =>
    color bull_base = f_theme_color(i_bull_color, #38BD8A, #008060)
    color bear_base = f_theme_color(i_bear_color, #F87171, #B3261E)
    color base = idx % 2 == 0 ? bull_base : bear_base
    color.new(base, math.min(15 + idx * 10, 75))

f_fmt_stat_text(string name, string line_name, float pct_level, float pct_value) =>
    name + " " + line_name + " P" + str.tostring(int(pct_level)) + " " + STL.f_pct_fmt(pct_value)

f_fmt_avg_text(string name, string line_name, float pct_value) =>
    name + " " + line_name + " " + STL.f_pct_fmt(pct_value)

f_fmt_med_text(string name, float pct_value) =>
    name + " Med " + STL.f_pct_fmt(pct_value)

f_fmt_percentile_text(float pct_value) =>
    str.tostring(int(math.round(pct_value))) + "th"

// Shared rendering geometry so OR box, lines/labels, and histogram width stay in sync.
f_render_geometry(RSL.RangeSpec sp, RSL.RangeState st, int tf_min) =>
    int total_mins_to_cutoff = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
    int bars_to_cutoff = int(math.max(1.0, math.ceil(float(total_mins_to_cutoff) / float(tf_min))))
    int start_bar = na(st.or_start_bar) ? bar_index : st.or_start_bar
    int cutoff_bar = start_bar + bars_to_cutoff
    cutoff_bar := math.min(cutoff_bar, bar_index)
    int render_end_bar = cutoff_bar
    int profile_width = math.max(10, bars_to_cutoff)
    [bars_to_cutoff, cutoff_bar, render_end_bar, profile_width]

// Returns true if y is within threshold of any value in the ys array.
f_near_any(float y, array<float> ys, float thr) =>
    bool found = false
    if array.size(ys) > 0
        for i = 0 to array.size(ys) - 1
            if math.abs(y - array.get(ys, i)) < thr
                found := true
                break
    found

f_track_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    bool in_or = RSL.f_in_session_pine(sp.session_or, sp.tz)
    bool in_data = RSL.f_in_session_pine(sp.session_data, sp.tz)

    bool was_in_or = array.get(prev_in_or, idx)
    bool is_new_session = in_or and not was_in_or
    array.set(prev_in_or, idx, in_or)

    // Commit at next OR start if prior day was still uncommitted.
    if is_new_session and not st.is_committed and st.ref_set and not na(st.bull_ref)
        // Recompute exact pullback MAE using full intraday trace (before peak finalization cutoff)
        // Use existing pullback MAE values from state (already tracked during the session)
        float pb_bull = na(st.daily_mae_bull_pb) ? 0.0 : st.daily_mae_bull_pb
        float pb_bear = na(st.daily_mae_bear_pb) ? 0.0 : st.daily_mae_bear_pb
        // Apply transfer-direction gating if applicable
        int direction = na
        if sp.is_transfer
            direction := (st.or_high > st.session_open) ? 1 : -1
        STL.f_commit_daily(hist, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bo_mfe_bull, st.daily_bo_mfe_bear, st.daily_bull_peak_min, st.daily_bear_peak_min, st.daily_pivot_bulls, st.daily_pivot_bears, st.daily_mae_bull_abs, st.daily_mae_bear_abs, pb_bull, pb_bear, st.daily_bo_mae_bull, st.daily_bo_mae_bear, st.mid_hit_bull, st.mid_hit_bear, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.session_low_data, st.session_high_data, i_ev_target_pct)
        st.is_committed := true

    if is_new_session
        RSL.f_reset_daily(st)
        array.set(phase2_live_bias, idx, 0)
        array.set(phase2_breakout_side, idx, 0)
        array.set(phase2_breakout_price, idx, na)
        array.set(phase2_pullback_armed, idx, false)
        array.set(phase2_pullback_price, idx, na)

    bool ltf_or_found = false
    int ltf_count = array.size(ltf_time_arr)
    if ltf_count > 0
        for j = 0 to ltf_count - 1
            int t = array.get(ltf_time_arr, j)
            int m = RSL.f_mins_of_day(t, sp.tz)
            bool in_or_m = RSL.f_in_session_minutes(m, sp.or_start_min, sp.or_end_min, sp.or_end_min < sp.or_start_min)
            if in_or_m
                float h = array.get(ltf_high_arr, j)
                float l = array.get(ltf_low_arr, j)
                float c = array.get(ltf_close_arr, j)
                if not st.or_building
                    st.or_high := h
                    st.or_low := l
                    st.or_last_close := c
                    st.or_building := true
                    st.or_start_bar := bar_index
                else
                    st.or_high := math.max(st.or_high, h)
                    st.or_low := math.min(st.or_low, l)
                    st.or_last_close := c
                ltf_or_found := true

    if in_or and not ltf_or_found
        if not st.or_building
            st.or_high := high
            st.or_low := low
            st.or_last_close := close
            st.or_building := true
            st.or_start_bar := bar_index
        else
            st.or_high := math.max(st.or_high, high)
            st.or_low := math.min(st.or_low, low)
            st.or_last_close := close

    if st.or_building and not st.or_complete and not in_or and not ltf_or_found
        st.or_complete := true

    if st.or_complete and not st.ref_set and not na(st.or_high)
        st.bull_ref := st.or_high
        st.bear_ref := st.or_low
        st.or_mid := (st.or_high + st.or_low) / 2.0
        st.session_open := st.or_last_close  // Capture close for transfer-direction gating
        st.ref_set := true

    bool ltf_in_data = false
    if st.ref_set and ltf_count > 0
        for j = 0 to ltf_count - 1
            int t = array.get(ltf_time_arr, j)
            int m = RSL.f_mins_of_day(t, sp.tz)
            bool in_data_m = RSL.f_in_session_minutes(m, sp.or_end_min, sp.cutoff_min, sp.cutoff_min < sp.or_end_min)
            if in_data_m
                ltf_in_data := true
                float h = array.get(ltf_high_arr, j)
                float l = array.get(ltf_low_arr, j)
                float c = array.get(ltf_close_arr, j)
                int mins_since_or = RSL.f_mins_since(m, sp.or_start_min)
                [nb, ns, nbp, nsp] = STL.f_track_mfe(h, l, mins_since_or, st.bull_ref, st.bear_ref, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bull_peak_min, st.daily_bear_peak_min)
                st.daily_bull_mfe := nb
                st.daily_bear_mfe := ns
                st.daily_bull_peak_min := nbp
                st.daily_bear_peak_min := nsp
                [mab, mas] = STL.f_track_mae_abs(h, l, st.or_low, st.or_high, st.daily_mae_bull_abs, st.daily_mae_bear_abs)
                st.daily_mae_bull_abs := mab
                st.daily_mae_bear_abs := mas
                bool bull_peak_finalized = mins_since_or >= st.daily_bull_peak_min
                bool bear_peak_finalized = mins_since_or >= st.daily_bear_peak_min
                [mpb, mps] = STL.f_track_mae_pullback(h, l, st.or_high, st.or_low, bull_peak_finalized, bear_peak_finalized, st.daily_mae_bull_pb, st.daily_mae_bear_pb)
                st.daily_mae_bull_pb := mpb
                st.daily_mae_bear_pb := mps
                // Track breakout-level MFE/MAE from breakout activation price.
                int bo_side = array.get(phase2_breakout_side, idx)
                float bo_px = array.get(phase2_breakout_price, idx)
                if bo_side != 0 and not na(bo_px)
                    if bo_side == 1
                        if h > bo_px
                            float bo_mfe_val = (h - bo_px) / bo_px * 100.0
                            st.daily_bo_mfe_bull := math.max(st.daily_bo_mfe_bull, bo_mfe_val)
                        if l < bo_px
                            float bo_mae_val = (bo_px - l) / bo_px * 100.0
                            st.daily_bo_mae_bull := math.max(st.daily_bo_mae_bull, bo_mae_val)
                    else
                        if l < bo_px
                            float bo_mfe_val = (bo_px - l) / bo_px * 100.0
                            st.daily_bo_mfe_bear := math.max(st.daily_bo_mfe_bear, bo_mfe_val)
                        if h > bo_px
                            float bo_mae_val = (h - bo_px) / bo_px * 100.0
                            st.daily_bo_mae_bear := math.max(st.daily_bo_mae_bear, bo_mae_val)
                // Capture intraday trace for later post-peak analysis
                array.push(st.data_mins, mins_since_or)
                array.push(st.data_highs, h)
                array.push(st.data_lows, l)
                [mhb, mhs] = STL.f_track_mid_hit(h, l, st.or_mid, st.mid_hit_bull, st.mid_hit_bear)
                st.mid_hit_bull := mhb
                st.mid_hit_bear := mhs
                if h > st.bull_ref
                    st.entry_triggered_bull := true
                    array.push(st.daily_pivot_bulls, (h - st.bull_ref) / st.bull_ref * 100.0)
                if l < st.bear_ref
                    st.entry_triggered_bear := true
                    array.push(st.daily_pivot_bears, (st.bear_ref - l) / st.bear_ref * 100.0)
                st.session_low_data := na(st.session_low_data) ? l : math.min(st.session_low_data, l)
                st.session_high_data := na(st.session_high_data) ? h : math.max(st.session_high_data, h)
                st.close_at_cutoff := c

    if st.ref_set and in_data and not ltf_in_data
        int mins_since_or = RSL.f_mins_since(RSL.f_mins_of_day(time, sp.tz), sp.or_start_min)
        [nb, ns, nbp, nsp] = STL.f_track_mfe(high, low, mins_since_or, st.bull_ref, st.bear_ref, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bull_peak_min, st.daily_bear_peak_min)
        st.daily_bull_mfe := nb
        st.daily_bear_mfe := ns
        st.daily_bull_peak_min := nbp
        st.daily_bear_peak_min := nsp
        [mab, mas] = STL.f_track_mae_abs(high, low, st.or_low, st.or_high, st.daily_mae_bull_abs, st.daily_mae_bear_abs)
        st.daily_mae_bull_abs := mab
        st.daily_mae_bear_abs := mas
        bool bull_peak_finalized = mins_since_or >= st.daily_bull_peak_min
        bool bear_peak_finalized = mins_since_or >= st.daily_bear_peak_min
        [mpb, mps] = STL.f_track_mae_pullback(high, low, st.or_high, st.or_low, bull_peak_finalized, bear_peak_finalized, st.daily_mae_bull_pb, st.daily_mae_bear_pb)
        st.daily_mae_bull_pb := mpb
        st.daily_mae_bear_pb := mps
        // Track breakout-level MFE/MAE from breakout activation price.
        int bo_side = array.get(phase2_breakout_side, idx)
        float bo_px = array.get(phase2_breakout_price, idx)
        if bo_side != 0 and not na(bo_px)
            if bo_side == 1
                if high > bo_px
                    float bo_mfe_val = (high - bo_px) / bo_px * 100.0
                    st.daily_bo_mfe_bull := math.max(st.daily_bo_mfe_bull, bo_mfe_val)
                if low < bo_px
                    float bo_mae_val = (bo_px - low) / bo_px * 100.0
                    st.daily_bo_mae_bull := math.max(st.daily_bo_mae_bull, bo_mae_val)
            else
                if low < bo_px
                    float bo_mfe_val = (bo_px - low) / bo_px * 100.0
                    st.daily_bo_mfe_bear := math.max(st.daily_bo_mfe_bear, bo_mfe_val)
                if high > bo_px
                    float bo_mae_val = (high - bo_px) / bo_px * 100.0
                    st.daily_bo_mae_bear := math.max(st.daily_bo_mae_bear, bo_mae_val)
        // Capture intraday trace for later post-peak analysis
        array.push(st.data_mins, mins_since_or)
        array.push(st.data_highs, high)
        array.push(st.data_lows, low)
        [mhb, mhs] = STL.f_track_mid_hit(high, low, st.or_mid, st.mid_hit_bull, st.mid_hit_bear)
        st.mid_hit_bull := mhb
        st.mid_hit_bear := mhs
        if high > st.bull_ref
            st.entry_triggered_bull := true
            array.push(st.daily_pivot_bulls, (high - st.bull_ref) / st.bull_ref * 100.0)
        if low < st.bear_ref
            st.entry_triggered_bear := true
            array.push(st.daily_pivot_bears, (st.bear_ref - low) / st.bear_ref * 100.0)
        st.session_low_data := na(st.session_low_data) ? low : math.min(st.session_low_data, low)
        st.session_high_data := na(st.session_high_data) ? high : math.max(st.session_high_data, high)
        st.close_at_cutoff := close

    bool effective_in_data = in_data or ltf_in_data
    bool was_in_data = array.get(prev_in_data, idx)
    bool data_just_ended = was_in_data and not effective_in_data
    array.set(prev_in_data, idx, effective_in_data)

    // Phase 2 live bias: close-based only relative to OR midpoint.
    if st.ref_set and not na(st.or_mid)
        int lb = close > st.or_mid ? 1 : close < st.or_mid ? -1 : 0
        array.set(phase2_live_bias, idx, lb)

    // Phase 2 breakout side keying: first candle close outside OR during data window.
    int bo_side = array.get(phase2_breakout_side, idx)
    if st.ref_set and effective_in_data and bo_side == 0
        if close > st.or_high
            array.set(phase2_breakout_side, idx, 1)
            array.set(phase2_breakout_price, idx, close)
        else if close < st.or_low
            array.set(phase2_breakout_side, idx, -1)
            array.set(phase2_breakout_price, idx, close)

    // Phase 2 pullback activation: P25 breakout MAE from historical data.
    bool pb_armed = array.get(phase2_pullback_armed, idx)
    bo_side := array.get(phase2_breakout_side, idx)
    float bo_px = array.get(phase2_breakout_price, idx)
    if st.ref_set and effective_in_data and bo_side != 0 and not pb_armed and not na(bo_px)
        array<float> mae_side = bo_side == 1 ? STL.f_build_filtered(hist.bo_mae_bull) : STL.f_build_filtered(hist.bo_mae_bear)
        if array.size(mae_side) > 0
            float p25 = array.percentile_nearest_rank(mae_side, 25)
            float act_px = bo_side == 1 ? bo_px * (1.0 - p25 / 100.0) : bo_px * (1.0 + p25 / 100.0)
            array.set(phase2_pullback_price, idx, act_px)  // Store activation price
            bool armed_now = bo_side == 1 ? close <= act_px : close >= act_px
            if armed_now
                array.set(phase2_pullback_armed, idx, true)

    if data_just_ended and not st.is_committed and st.ref_set
        // Use existing pullback MAE values from state (already tracked during the session)
        float pb_bull = na(st.daily_mae_bull_pb) ? 0.0 : st.daily_mae_bull_pb
        float pb_bear = na(st.daily_mae_bear_pb) ? 0.0 : st.daily_mae_bear_pb
        // Apply transfer-direction gating if applicable
        int direction = na
        if sp.is_transfer
            direction := (st.or_high > st.session_open) ? 1 : -1
        STL.f_commit_daily(hist, st.daily_bull_mfe, st.daily_bear_mfe, st.daily_bo_mfe_bull, st.daily_bo_mfe_bear, st.daily_bull_peak_min, st.daily_bear_peak_min, st.daily_pivot_bulls, st.daily_pivot_bears, st.daily_mae_bull_abs, st.daily_mae_bear_abs, pb_bull, pb_bear, st.daily_bo_mae_bull, st.daily_bo_mae_bear, st.mid_hit_bull, st.mid_hit_bear, st.or_high, st.or_low, ny_dow, st.entry_triggered_bull, st.entry_triggered_bear, st.close_at_cutoff, st.session_low_data, st.session_high_data, i_ev_target_pct)
        st.is_committed := true

    if i_show_debug and is_new_session
        color debug_text = f_theme_color(i_debug_text_color, #F1F5F9, #111827)
        color debug_bg = f_theme_color(i_debug_bg_color, #1E3A8A, #93C5FD)
        label.new(bar_index, high, "NEW: " + sp.name, style=label.style_label_down, textcolor=debug_text, color=color.new(debug_bg, 50), size=size.tiny)

    array.set(states, idx, st)
    array.set(histories, idx, hist)

if array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_track_range(i)

f_render_range(int idx) =>
    RSL.RangeSpec sp = array.get(specs, idx)
    RSL.RangeState st = array.get(states, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)
    PDL.PineDrawingState ds = array.get(drawings, idx)

    PDL.f_clear_all(ds)

    int tf_min = timeframe.isintraday ? timeframe.multiplier : 1
    [bars_to_cutoff, cutoff_bar, line_render_end, max_profile_width] = f_render_geometry(sp, st, tf_min)
    // ── Resolve shared design tokens via theme ──
    color bull_color = f_theme_color(i_bull_color, #38BD8A, #008060)
    color bear_color = f_theme_color(i_bear_color, #F87171, #B3261E)
    color stat_label_color = f_theme_color(i_label_text_color, #E2E8F0, #1F2937)
    color stat_median_color = f_theme_color(i_color_median, #FACC15, #B45309)
    color stat_avg_color = f_theme_color(i_color_average, #22D3EE, #0891B2)
    color stat_stretch_color = f_theme_color(i_color_stretch, #FB923C, #C2410C)
    color mid_line_color = f_theme_color(i_color_midpoint, #94A3B8, #6B7280)
    color time_title_color = f_theme_color(i_color_time_title, #D946EF, #9333EA)
    color bo_cashflow_color = f_theme_color(i_color_bo_cashflow, #4ADE80, #16A34A)
    color bo_confirm_color = f_theme_color(i_color_bo_confirm, #2DD4BF, #0D9488)
    color pivot_color = f_theme_color(i_color_pivot, #22D3EE, #0891B2)
    color reversal_zone_color = f_theme_color(i_color_reversal_zone, #F97316, #C2410C)
    color max_reversal_color = f_theme_color(i_color_max_reversal, #FB923C, #C2410C)
    color invalidation_line_color = f_theme_color(i_color_invalidation_line, #F87171, #B3261E)
    color breakout_activation_color = f_theme_color(i_color_breakout_activation, #C084FC, #7E22CE)
    color pullback_activation_color = f_theme_color(i_color_pullback_activation, #A3E635, #4D7C0F)
    color pb_not_armed_color = f_theme_color(i_color_mid_probability, #94A3B8, #6B7280)
    float phase2_label_dy = syminfo.mintick * float(i_label_offset_ticks)

    // ── Overlap suppression: pre-compute tactical Y levels ──
    array<float> tac_ys = array.new_float(0)
    float suppress_thr = syminfo.mintick * float(i_label_merge_threshold_ticks)
    if i_show_phase2_levels and st.ref_set and not na(st.or_start_bar)
        int _bo_side = array.get(phase2_breakout_side, idx)
        int _live_bias = array.get(phase2_live_bias, idx)
        float _bo_px = array.get(phase2_breakout_price, idx)
        int _rs = _bo_side != 0 ? _bo_side : _live_bias
        float _rp = not na(_bo_px) ? _bo_px : (_rs == 1 ? st.or_high : _rs == -1 ? st.or_low : na)
        if _rs != 0 and not na(_rp)
            array.push(tac_ys, _rp)
            float _pb = array.get(phase2_pullback_price, idx)
            if not na(_pb)
                array.push(tac_ys, _pb)
            array<float> _bm = _rs == 1 ? STL.f_build_filtered(hist.bo_mfe_bull) : STL.f_build_filtered(hist.bo_mfe_bear)
            if array.size(_bm) > 0
                float _p20 = array.percentile_nearest_rank(_bm, 20)
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 + _p20 / 100.0) : _rp * (1.0 - _p20 / 100.0))
            array<float> _fm = _rs == 1 ? STL.f_build_filtered(hist.fake_mfe_bull) : STL.f_build_filtered(hist.fake_mfe_bear)
            if array.size(_fm) > 0
                float _f50 = array.percentile_nearest_rank(_fm, 50)
                float _f75 = array.percentile_nearest_rank(_fm, 75)
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 + _f75 / 100.0) : _rp * (1.0 - _f75 / 100.0))
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 + _f50 / 100.0) : _rp * (1.0 - _f50 / 100.0))
            array<float> _rf = _rs == 1 ? STL.f_build_filtered(hist.fake_mae_bull) : STL.f_build_filtered(hist.fake_mae_bear)
            if array.size(_rf) > 0
                float _r20 = array.percentile_nearest_rank(_rf, 20)
                float _r50 = array.percentile_nearest_rank(_rf, 50)
                float _r90 = array.percentile_nearest_rank(_rf, 90)
                array.push(tac_ys, _rs == 1 ? st.or_high * (1.0 - _r20 / 100.0) : st.or_low * (1.0 + _r20 / 100.0))
                array.push(tac_ys, _rs == 1 ? st.or_high * (1.0 - _r50 / 100.0) : st.or_low * (1.0 + _r50 / 100.0))
                array.push(tac_ys, _rs == 1 ? st.or_high * (1.0 - _r90 / 100.0) : st.or_low * (1.0 + _r90 / 100.0))
            array<float> _ms = _rs == 1 ? STL.f_build_filtered(hist.bo_mae_bull) : STL.f_build_filtered(hist.bo_mae_bear)
            if array.size(_ms) > 0
                float _mp80 = array.percentile_nearest_rank(_ms, 80)
                array.push(tac_ys, _rs == 1 ? _rp * (1.0 - _mp80 / 100.0) : _rp * (1.0 + _mp80 / 100.0))

    // ── Label registry for merge-on-proximity ──
    array<float> lbl_ys = array.new_float(0)
    array<string> lbl_texts = array.new_string(0)
    array<color> lbl_colors = array.new_color(0)
    array<int> lbl_xs = array.new_int(0)

    if st.or_building and not na(st.or_start_bar)
        PDL.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx), i_box_style, i_box_width)
    else if st.or_complete and not na(st.or_start_bar)
        PDL.f_draw_or_box(ds, st.or_start_bar, st.or_high, st.or_low, cutoff_bar, f_or_color(idx), i_box_style, i_box_width)

    if i_show_stat_lines and st.ref_set and not na(st.bull_ref)
        array<float> bull_filtered = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear_filtered = STL.f_build_filtered(hist.mfe_bear)
        int ln_end = line_render_end
        int stat_label_x = ln_end + i_label_gap_bars

        if array.size(bull_filtered) > 0
            float p_confirm_b = array.percentile_nearest_rank(bull_filtered, i_pct_confirm)
            float p_t1_b = array.percentile_nearest_rank(bull_filtered, i_pct_target1)
            float p_t2_b = array.percentile_nearest_rank(bull_filtered, i_pct_target2)
            float p_stretch_b = array.percentile_nearest_rank(bull_filtered, i_pct_stretch)
            float p_avg_b = array.avg(bull_filtered)
            float p_med_b = array.median(bull_filtered)
            float y_confirm_b = st.bull_ref * (1.0 + p_confirm_b / 100.0)
            float y_t1_b = st.bull_ref * (1.0 + p_t1_b / 100.0)
            float y_t2_b = st.bull_ref * (1.0 + p_t2_b / 100.0)
            float y_stretch_b = st.bull_ref * (1.0 + p_stretch_b / 100.0)
            float y_avg_b = st.bull_ref * (1.0 + p_avg_b / 100.0)
            float y_med_b = st.bull_ref * (1.0 + p_med_b / 100.0)
            float y_confirm_b_label = y_confirm_b
            float y_t2_b_label = y_t2_b
            float y_stretch_b_label = y_stretch_b
            float y_avg_b_label = y_avg_b
            float y_med_b_label = y_med_b
            // Stat lines suppressed where tactical lines overlap
            if not f_near_any(y_confirm_b, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_confirm_b, ln_end, color.new(bull_color, 15), "Dotted", i_line_width_secondary)
                array.push(lbl_ys, y_confirm_b_label)
                array.push(lbl_texts, f_fmt_stat_text(sp.name, "Confirm", i_pct_confirm, p_confirm_b))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_t1_b, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_t1_b, ln_end, color.new(bull_color, 0), "Solid", i_line_width_secondary)
            if not f_near_any(y_t2_b, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_t2_b, ln_end, color.new(bull_color, 25), "Dashed", i_line_width_secondary)
                array.push(lbl_ys, y_t2_b_label)
                array.push(lbl_texts, f_fmt_stat_text(sp.name, "Target2", i_pct_target2, p_t2_b))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_stretch_b, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_stretch_b, ln_end, color.new(stat_stretch_color, 0), "Dotted", i_line_width_secondary)
                array.push(lbl_ys, y_stretch_b_label)
                array.push(lbl_texts, f_fmt_stat_text(sp.name, "Stretch", i_pct_stretch, p_stretch_b))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_avg_b, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_avg_b, ln_end, color.new(stat_avg_color, 0), "Dashed", i_line_width_secondary)
                array.push(lbl_ys, y_avg_b_label)
                array.push(lbl_texts, f_fmt_avg_text(sp.name, "Avg", p_avg_b))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_med_b, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_med_b, ln_end, color.new(stat_median_color, 0), "Solid", i_line_width_primary)
                array.push(lbl_ys, y_med_b_label)
                array.push(lbl_texts, f_fmt_med_text(sp.name, p_med_b))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)

        if array.size(bear_filtered) > 0
            float p_confirm_s = array.percentile_nearest_rank(bear_filtered, i_pct_confirm)
            float p_t1_s = array.percentile_nearest_rank(bear_filtered, i_pct_target1)
            float p_t2_s = array.percentile_nearest_rank(bear_filtered, i_pct_target2)
            float p_stretch_s = array.percentile_nearest_rank(bear_filtered, i_pct_stretch)
            float p_avg_s = array.avg(bear_filtered)
            float p_med_s = array.median(bear_filtered)
            float y_confirm_s = st.bear_ref * (1.0 - p_confirm_s / 100.0)
            float y_t1_s = st.bear_ref * (1.0 - p_t1_s / 100.0)
            float y_t2_s = st.bear_ref * (1.0 - p_t2_s / 100.0)
            float y_stretch_s = st.bear_ref * (1.0 - p_stretch_s / 100.0)
            float y_avg_s = st.bear_ref * (1.0 - p_avg_s / 100.0)
            float y_med_s = st.bear_ref * (1.0 - p_med_s / 100.0)
            float y_confirm_s_label = y_confirm_s
            float y_t2_s_label = y_t2_s
            float y_stretch_s_label = y_stretch_s
            float y_avg_s_label = y_avg_s
            float y_med_s_label = y_med_s
            // Stat lines suppressed where tactical lines overlap
            if not f_near_any(y_confirm_s, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_confirm_s, ln_end, color.new(bear_color, 15), "Dotted", i_line_width_secondary)
                array.push(lbl_ys, y_confirm_s_label)
                array.push(lbl_texts, f_fmt_stat_text(sp.name, "Confirm", i_pct_confirm, p_confirm_s))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_t1_s, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_t1_s, ln_end, color.new(bear_color, 0), "Solid", i_line_width_secondary)
            if not f_near_any(y_t2_s, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_t2_s, ln_end, color.new(bear_color, 25), "Dashed", i_line_width_secondary)
                array.push(lbl_ys, y_t2_s_label)
                array.push(lbl_texts, f_fmt_stat_text(sp.name, "Target2", i_pct_target2, p_t2_s))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_stretch_s, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_stretch_s, ln_end, color.new(stat_stretch_color, 0), "Dotted", i_line_width_secondary)
                array.push(lbl_ys, y_stretch_s_label)
                array.push(lbl_texts, f_fmt_stat_text(sp.name, "Stretch", i_pct_stretch, p_stretch_s))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_avg_s, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_avg_s, ln_end, color.new(stat_avg_color, 0), "Dashed", i_line_width_secondary)
                array.push(lbl_ys, y_avg_s_label)
                array.push(lbl_texts, f_fmt_avg_text(sp.name, "Avg", p_avg_s))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)
            if not f_near_any(y_med_s, tac_ys, suppress_thr)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_med_s, ln_end, color.new(stat_median_color, 0), "Solid", i_line_width_primary)
                array.push(lbl_ys, y_med_s_label)
                array.push(lbl_texts, f_fmt_med_text(sp.name, p_med_s))
                array.push(lbl_colors, stat_label_color)
                array.push(lbl_xs, stat_label_x)

        int n_mid = math.min(array.size(hist.mid_hit_bull), array.size(hist.mid_hit_bear))
        int mid_hits = 0
        if n_mid > 0
            for k = 0 to n_mid - 1
                mid_hits += array.get(hist.mid_hit_bull, k) ? 1 : 0
                mid_hits += array.get(hist.mid_hit_bear, k) ? 1 : 0
        float mid_hit_pct = n_mid == 0 ? na : (float(mid_hits) / float(2 * n_mid)) * 100.0
        if not f_near_any(st.or_mid, tac_ys, suppress_thr)
            PDL.f_draw_stat_line(ds, st.or_start_bar, st.or_mid, ln_end, color.new(mid_line_color, 20), "Dashed", i_line_width_secondary)
            array.push(lbl_ys, st.or_mid)
            array.push(lbl_texts, "Midpoint (" + STL.f_pct_fmt(mid_hit_pct) + ")")
            array.push(lbl_colors, stat_label_color)
            array.push(lbl_xs, stat_label_x)

    // Render MFE histogram as a profile-like bell curve.
    // Y uses percentile bands from the selected percentile window.
    // X width uses local density so the middle bands can expand and tails contract.
    if i_show_histogram and st.ref_set and not na(st.bull_ref)
        array<float> bull_filtered = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear_filtered = STL.f_build_filtered(hist.mfe_bear)

        // Use full OR->cutoff span for profile width so 1m charts do not render tiny histograms early in the session.
        int hist_pct_start = math.min(i_hist_start_pct, i_hist_end_pct - 1)
        int hist_pct_end = math.max(i_hist_end_pct, hist_pct_start + 1)
        int hist_pct_step = math.max(1, i_hist_pct_step)
        int hist_bin_count = int(math.ceil(float(hist_pct_end - hist_pct_start) / float(hist_pct_step)))

        // BULL HISTOGRAM
        if array.size(bull_filtered) > 0
            array<float> bull_val_los = array.new_float(0)
            array<float> bull_val_his = array.new_float(0)
            array<float> bull_densities = array.new_float(0)
            array<float> bull_pct_los = array.new_float(0)
            array<float> bull_pct_his = array.new_float(0)

            for b = 0 to hist_bin_count - 1
                float p_lo = hist_pct_start + float(hist_pct_step * b)
                float p_hi = math.min(hist_pct_end, p_lo + hist_pct_step)
                float v_lo = array.percentile_nearest_rank(bull_filtered, p_lo)
                float v_hi = array.percentile_nearest_rank(bull_filtered, p_hi)
                float band_span = math.max(v_hi - v_lo, 0.0001)
                int count = 0
                for s = 0 to array.size(bull_filtered) - 1
                    float val = array.get(bull_filtered, s)
                    if val >= v_lo and (b == hist_bin_count - 1 ? val <= v_hi : val < v_hi)
                        count += 1
                array.push(bull_val_los, v_lo)
                array.push(bull_val_his, v_hi)
                array.push(bull_densities, float(count) / band_span)
                array.push(bull_pct_los, p_lo)
                array.push(bull_pct_his, p_hi)

            // Cap tail bins below P20 to the density of the first bin at or above P20
            float bull_p20_density = na
            for b = 0 to hist_bin_count - 1
                if array.get(bull_pct_los, b) >= 20.0 and na(bull_p20_density)
                    bull_p20_density := array.get(bull_densities, b)
            if not na(bull_p20_density)
                for b = 0 to hist_bin_count - 1
                    if array.get(bull_pct_los, b) < 20.0
                        array.set(bull_densities, b, math.min(array.get(bull_densities, b), bull_p20_density))

            float max_density = 0.0
            for b = 0 to hist_bin_count - 1
                max_density := math.max(max_density, array.get(bull_densities, b))

            for b = 0 to hist_bin_count - 1
                float v_lo = array.get(bull_val_los, b)
                float v_hi = array.get(bull_val_his, b)
                float density = array.get(bull_densities, b)
                float p_lo = array.get(bull_pct_los, b)
                float p_hi = array.get(bull_pct_his, b)
                float width_normalized = max_density > 0 ? density / max_density : 0.0
                int box_width = math.max(2, int(math.round(width_normalized * float(max_profile_width))))

                if v_hi >= v_lo
                    float y_low = st.bull_ref * (1.0 + v_lo / 100.0)
                    float y_high = st.bull_ref * (1.0 + v_hi / 100.0)
                    PDL.f_draw_hist_band(ds, st.or_start_bar, y_high, y_low, box_width, bull_color, 58)
                    if i_show_hist_bin_labels
                        float y_mid = (y_high + y_low) / 2.0
                        PDL.f_draw_stat_label(ds, st.or_start_bar - 1, y_mid, f_fmt_percentile_text(p_lo), stat_label_color, "right", i_label_size)

                    if i_show_debug
                        float y_mid = (y_high + y_low) / 2.0
                        label.new(bar_index, y_mid, "B P" + str.tostring(p_lo, "#.0") + "-P" + str.tostring(p_hi, "#.0") + " v=" + str.tostring(v_lo, "#.##") + "-" + str.tostring(v_hi, "#.##"),
                                 style=label.style_label_center, textcolor=stat_label_color, size=size.tiny)

        // BEAR HISTOGRAM
        if array.size(bear_filtered) > 0
            array<float> bear_val_los = array.new_float(0)
            array<float> bear_val_his = array.new_float(0)
            array<float> bear_densities = array.new_float(0)
            array<float> bear_pct_los = array.new_float(0)
            array<float> bear_pct_his = array.new_float(0)

            for b = 0 to hist_bin_count - 1
                float p_lo = hist_pct_start + float(hist_pct_step * b)
                float p_hi = math.min(hist_pct_end, p_lo + hist_pct_step)
                float v_lo = array.percentile_nearest_rank(bear_filtered, p_lo)
                float v_hi = array.percentile_nearest_rank(bear_filtered, p_hi)
                float band_span = math.max(v_hi - v_lo, 0.0001)
                int count = 0
                for s = 0 to array.size(bear_filtered) - 1
                    float val = array.get(bear_filtered, s)
                    if val >= v_lo and (b == hist_bin_count - 1 ? val <= v_hi : val < v_hi)
                        count += 1
                array.push(bear_val_los, v_lo)
                array.push(bear_val_his, v_hi)
                array.push(bear_densities, float(count) / band_span)
                array.push(bear_pct_los, p_lo)
                array.push(bear_pct_his, p_hi)

            // Cap tail bins below P20 to the density of the first bin at or above P20
            float bear_p20_density = na
            for b = 0 to hist_bin_count - 1
                if array.get(bear_pct_los, b) >= 20.0 and na(bear_p20_density)
                    bear_p20_density := array.get(bear_densities, b)
            if not na(bear_p20_density)
                for b = 0 to hist_bin_count - 1
                    if array.get(bear_pct_los, b) < 20.0
                        array.set(bear_densities, b, math.min(array.get(bear_densities, b), bear_p20_density))

            float max_density = 0.0
            for b = 0 to hist_bin_count - 1
                max_density := math.max(max_density, array.get(bear_densities, b))

            for b = 0 to hist_bin_count - 1
                float v_lo = array.get(bear_val_los, b)
                float v_hi = array.get(bear_val_his, b)
                float density = array.get(bear_densities, b)
                float p_lo = array.get(bear_pct_los, b)
                float p_hi = array.get(bear_pct_his, b)
                float width_normalized = max_density > 0 ? density / max_density : 0.0
                float width_shaped = math.sqrt(width_normalized)
                int min_width = math.max(3, int(math.round(float(max_profile_width) * 0.10)))
                int box_width = math.max(min_width, int(math.round(width_shaped * float(max_profile_width))))

                if v_hi >= v_lo
                    float y_high = st.bear_ref * (1.0 - v_lo / 100.0)
                    float y_low = st.bear_ref * (1.0 - v_hi / 100.0)
                    PDL.f_draw_hist_band(ds, st.or_start_bar, y_high, y_low, box_width, bear_color, 58)
                    if i_show_hist_bin_labels
                        float y_mid = (y_high + y_low) / 2.0
                        PDL.f_draw_stat_label(ds, st.or_start_bar - 1, y_mid, f_fmt_percentile_text(p_lo), stat_label_color, "right", i_label_size)

                    if i_show_debug
                        float y_mid = (y_high + y_low) / 2.0
                        label.new(bar_index, y_mid, "S P" + str.tostring(p_lo, "#.0") + "-P" + str.tostring(p_hi, "#.0") + " v=" + str.tostring(v_lo, "#.##") + "-" + str.tostring(v_hi, "#.##"),
                                 style=label.style_label_center, textcolor=stat_label_color, size=size.tiny)

    // MODULE: TIME DISTRIBUTION HISTOGRAM
    // Renders when during the session (minutes since OR start) the MFE peak was reached.
    // Bull bars grow upward from base_y; bear bars grow downward. Vertical dashed lines
    // mark the bull/bear AVG and Median peak times.
    if i_show_time_dist and st.ref_set and st.or_complete and not na(st.or_start_bar)
        int time_data_dur = RSL.f_duration(sp.or_start_min, sp.cutoff_min)
        if time_data_dur > 0
            float bars_per_min = 1.0 / float(tf_min)
            int min_box_w = math.max(1, int(float(i_time_bucket_mins) * bars_per_min))
            int num_bins = math.ceil(float(time_data_dur) / float(i_time_bucket_mins))

            // base_y: position below the bear MFE histogram when visible, else below OR low
            float mfe_hist_bot = na
            if i_show_histogram and not na(st.bear_ref)
                array<float> bear_filt2 = STL.f_build_filtered(hist.mfe_bear)
                if array.size(bear_filt2) > 0
                    float max_bear_mfe = array.percentile_nearest_rank(bear_filt2, float(i_hist_end_pct))
                    mfe_hist_bot := st.bear_ref * (1.0 - max_bear_mfe / 100.0)
            float base_y = not na(mfe_hist_bot) ? mfe_hist_bot - syminfo.mintick * float(i_time_offset_ticks) : st.or_low - syminfo.mintick * float(i_time_offset_ticks)

            // Count days per bin — only include days where the respective MFE > 0
            int n_ptb = array.size(hist.peak_time_bull)
            int n_pts = array.size(hist.peak_time_bear)
            array<int> bull_cnt = array.new_int(num_bins, 0)
            array<int> bear_cnt = array.new_int(num_bins, 0)
            int max_t_count = 1
            for bi = 0 to num_bins - 1
                int bin_s = bi * i_time_bucket_mins
                int bin_e = bin_s + i_time_bucket_mins
                int cb = 0
                int cs = 0
                if n_ptb > 0
                    for j = 0 to n_ptb - 1
                        int pk = array.get(hist.peak_time_bull, j)
                        if pk >= bin_s and pk < bin_e and array.get(hist.mfe_bull, j) > 0
                            cb += 1
                if n_pts > 0
                    for j = 0 to n_pts - 1
                        int pk = array.get(hist.peak_time_bear, j)
                        if pk >= bin_s and pk < bin_e and array.get(hist.mfe_bear, j) > 0
                            cs += 1
                array.set(bull_cnt, bi, cb)
                array.set(bear_cnt, bi, cs)
                max_t_count := math.max(max_t_count, math.max(cb, cs))

            float prof_h = syminfo.mintick * float(i_time_offset_ticks) * 0.4
            float line_h = prof_h * 1.2

            // Title label — rendered at horizontal midpoint, slightly above the baseline
            int title_x = st.or_start_bar + int(float(time_data_dur / 2) * bars_per_min)
            PDL.f_draw_stat_label(ds, title_x, base_y + syminfo.mintick * 80.0, sp.name + " Time Dist", color.new(time_title_color, 50), "down", i_label_size)

            // Histogram bars
            for bi = 0 to num_bins - 1
                int x_l = st.or_start_bar + int(float(bi * i_time_bucket_mins) * bars_per_min)
                int x_r = x_l + min_box_w
                if x_r <= x_l
                    x_r := x_l + 1
                int cb = array.get(bull_cnt, bi)
                int cs = array.get(bear_cnt, bi)
                if cb > 0
                    float h = float(cb) / float(max_t_count) * prof_h
                    PDL.f_draw_time_bar(ds, x_l, x_r, base_y + h, base_y, color.new(bull_color, 80))
                if cs > 0
                    float h = float(cs) / float(max_t_count) * prof_h
                    PDL.f_draw_time_bar(ds, x_l, x_r, base_y, base_y - h, color.new(bear_color, 80))

            // AVG and Median vertical stat lines — build non-zero-mfe time arrays first
            array<int> bull_t_nz = array.new_int(0)
            array<int> bear_t_nz = array.new_int(0)
            if n_ptb > 0
                for j = 0 to n_ptb - 1
                    if array.get(hist.mfe_bull, j) > 0
                        array.push(bull_t_nz, array.get(hist.peak_time_bull, j))
            if n_pts > 0
                for j = 0 to n_pts - 1
                    if array.get(hist.mfe_bear, j) > 0
                        array.push(bear_t_nz, array.get(hist.peak_time_bear, j))

            if array.size(bull_t_nz) > 0
                float avg_t = array.avg(bull_t_nz)
                float med_t = array.median(bull_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min)
                int x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    PDL.f_draw_vline(ds, x_avg, base_y + line_h, base_y, stat_avg_color, "Dashed")
                    PDL.f_draw_stat_label(ds, x_avg, base_y + line_h, "Bull AVG", stat_avg_color, "down", i_label_size)
                if i_show_time_med
                    PDL.f_draw_vline(ds, x_med, base_y + line_h * 0.8, base_y, stat_median_color, "Dashed")
                    PDL.f_draw_stat_label(ds, x_med, base_y + line_h * 0.8, "Bull MED", stat_median_color, "down", i_label_size)

            if array.size(bear_t_nz) > 0
                float avg_t = array.avg(bear_t_nz)
                float med_t = array.median(bear_t_nz)
                int x_avg = st.or_start_bar + int(avg_t * bars_per_min)
                int x_med = st.or_start_bar + int(med_t * bars_per_min)
                if i_show_time_avg
                    PDL.f_draw_vline(ds, x_avg, base_y, base_y - line_h, stat_avg_color, "Dashed")
                    PDL.f_draw_stat_label(ds, x_avg, base_y - line_h, "Bear AVG", stat_avg_color, "up", i_label_size)
                if i_show_time_med
                    PDL.f_draw_vline(ds, x_med, base_y, base_y - line_h * 0.8, stat_median_color, "Dashed")
                    PDL.f_draw_stat_label(ds, x_med, base_y - line_h * 0.8, "Bear MED", stat_median_color, "up", i_label_size)

    // MODULE: PHASE 2 DIRECTIONAL LEVELS
    // Three MFE/MAE calculation types:
    // 1. OR-based MFE/MAE: measured from OR high/low (used for stat lines, histograms, Phase 1 levels)
    // 2. Breakout-level MFE/MAE: measured from breakout candle close (used for BO Cashflow, BO Confirm, Pivot)
    // 3. Fake-move MFE/MAE: MFE of price that penetrated OR, and MAE of those fake reversals (used for reversal zone levels)
    if i_show_phase2_levels and st.ref_set and not na(st.or_start_bar)
        int ln_end = line_render_end
        int bo_side = array.get(phase2_breakout_side, idx)
        int live_bias = array.get(phase2_live_bias, idx)
        float bo_px = array.get(phase2_breakout_price, idx)
        bool pb_armed = array.get(phase2_pullback_armed, idx)
        int phase2_label_x = ln_end + i_label_gap_bars

        int render_side = bo_side != 0 ? bo_side : live_bias
        float render_px = not na(bo_px) ? bo_px : (render_side == 1 ? st.or_high : render_side == -1 ? st.or_low : na)

        if render_side != 0 and not na(render_px)
            int inactive_alpha = i_emphasize_active_side and live_bias != 0 and live_bias != render_side ? 65 : 0

            // Breakout MFE (P20 from historical breakout-MFE series)
            array<float> bo_mfe_hist = render_side == 1 ? STL.f_build_filtered(hist.bo_mfe_bull) : STL.f_build_filtered(hist.bo_mfe_bear)
            float p20_bo = array.size(bo_mfe_hist) > 0 ? array.percentile_nearest_rank(bo_mfe_hist, 20) : na

            // Fakeout-filtered MFE percentiles
            float f25 = na
            float f50 = na
            float f75 = na
            float f90 = na
            if render_side == 1
                array<float> fake_mfe_hist = STL.f_build_filtered(hist.fake_mfe_bull)
                bf25 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 25) : na
                bf50 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 50) : na
                bf75 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 75) : na
                bf90 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 90) : na
                f25 := bf25
                f50 := bf50
                f75 := bf75
                f90 := bf90
            else
                array<float> fake_mfe_hist = STL.f_build_filtered(hist.fake_mfe_bear)
                sf25 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 25) : na
                sf50 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 50) : na
                sf75 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 75) : na
                sf90 = array.size(fake_mfe_hist) > 0 ? array.percentile_nearest_rank(fake_mfe_hist, 90) : na
                f25 := sf25
                f50 := sf50
                f75 := sf75
                f90 := sf90

            // Fakeout reversal depth percentiles (MAE of fakes)
            array<float> rev_f = render_side == 1 ? STL.f_build_filtered(hist.fake_mae_bull) : STL.f_build_filtered(hist.fake_mae_bear)
            float rev_p20 = array.size(rev_f) > 0 ? array.percentile_nearest_rank(rev_f, 20) : na
            float rev_p50 = array.size(rev_f) > 0 ? array.percentile_nearest_rank(rev_f, 50) : na
            float rev_p90 = array.size(rev_f) > 0 ? array.percentile_nearest_rank(rev_f, 90) : na

            // Breakout MAE P80 (shared PB/BO invalidation line)
            array<float> mae_side = render_side == 1 ? STL.f_build_filtered(hist.bo_mae_bull) : STL.f_build_filtered(hist.bo_mae_bear)
            float mae_p80 = array.size(mae_side) > 0 ? array.percentile_nearest_rank(mae_side, 80) : na

            // Price mapping helpers
            float y_cash = na
            float y_confirm = na
            float y_pivot = na
            float y_rev20 = na
            float y_rev50 = na
            float y_rev90 = na
            float y_inv = na
            if render_side == 1
                y_cash := na(p20_bo) ? na : render_px * (1.0 + p20_bo / 100.0)
                y_confirm := na(f75) ? na : render_px * (1.0 + f75 / 100.0)
                y_pivot := na(f50) ? na : render_px * (1.0 + f50 / 100.0)
                y_rev20 := na(rev_p20) ? na : st.or_high * (1.0 - rev_p20 / 100.0)
                y_rev50 := na(rev_p50) ? na : st.or_high * (1.0 - rev_p50 / 100.0)
                y_rev90 := na(rev_p90) ? na : st.or_high * (1.0 - rev_p90 / 100.0)
                y_inv := na(mae_p80) ? na : render_px * (1.0 - mae_p80 / 100.0)
            else
                y_cash := na(p20_bo) ? na : render_px * (1.0 - p20_bo / 100.0)
                y_confirm := na(f75) ? na : render_px * (1.0 - f75 / 100.0)
                y_pivot := na(f50) ? na : render_px * (1.0 - f50 / 100.0)
                y_rev20 := na(rev_p20) ? na : st.or_low * (1.0 + rev_p20 / 100.0)
                y_rev50 := na(rev_p50) ? na : st.or_low * (1.0 + rev_p50 / 100.0)
                y_rev90 := na(rev_p90) ? na : st.or_low * (1.0 + rev_p90 / 100.0)
                y_inv := na(mae_p80) ? na : render_px * (1.0 + mae_p80 / 100.0)

            // Reversal target zone (P20-P50 of fake MAE)
            if not na(y_rev20) and not na(y_rev50)
                float z_top = math.max(y_rev20, y_rev50)
                float z_bot = math.min(y_rev20, y_rev50)
                int z_w = math.max(2, ln_end - st.or_start_bar)
                float z_mid = (z_top + z_bot) / 2.0
                int z_mid_x = st.or_start_bar + int(math.floor(z_w / 2.0))
                int zone_line_alpha = math.min(i_zone_transparency + 10, 95)
                int zone_text_alpha = math.min(int(math.round(float(i_zone_transparency) * 0.6)), 90)
                PDL.f_draw_hist_band(ds, st.or_start_bar, z_top, z_bot, z_w, reversal_zone_color, i_zone_transparency)
                PDL.f_draw_stat_line(ds, st.or_start_bar, z_mid, st.or_start_bar + z_w, color.new(reversal_zone_color, zone_line_alpha), "Dashed", i_line_width_secondary)
                PDL.f_draw_stat_label(ds, z_mid_x, z_mid, "Reversal Zone (P20-P50 Fake MAE)", color.new(stat_label_color, zone_text_alpha), "center", i_label_size)

            // Breakout activation level (close that breaks out of range)
            if not na(render_px)
                float bo_label_y = render_px
                PDL.f_draw_stat_line(ds, st.or_start_bar, render_px, ln_end, color.new(breakout_activation_color, 0), "Dotted", i_line_width_primary)
                string bo_tooltip = render_side == 1 ? "Bull Breakout Activation: first close above OR high" : "Bear Breakout Activation: first close below OR low"
                array.push(lbl_ys, bo_label_y)
                array.push(lbl_texts, "Breakout Activation " + STL.f_pct_fmt(0))
                array.push(lbl_colors, color.new(breakout_activation_color, inactive_alpha))
                array.push(lbl_xs, phase2_label_x)

            // Pullback activation level (P25 MAE from breakout activation)
            float pb_px = array.get(phase2_pullback_price, idx)
            if not na(pb_px)
                float pb_label_y = pb_px
                PDL.f_draw_stat_line(ds, st.or_start_bar, pb_px, ln_end, color.new(pullback_activation_color, 0), "Dashed", i_line_width_primary)
                string pb_tooltip = render_side == 1 ? "Bull Pullback Activation: P25 MAE below breakout activation" : "Bear Pullback Activation: P25 MAE above breakout activation"
                array.push(lbl_ys, pb_label_y)
                array.push(lbl_texts, "Pullback Activation P25 MAE")
                array.push(lbl_colors, color.new(pullback_activation_color, inactive_alpha))
                array.push(lbl_xs, phase2_label_x)

            // Core directional lines
            if not na(y_cash)
                float y_cash_label = y_cash
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_cash, ln_end, color.new(bo_cashflow_color, inactive_alpha), "Dotted", i_line_width_secondary)
                array.push(lbl_ys, y_cash_label)
                array.push(lbl_texts, "BO Cashflow P20 (MFE from BO) " + STL.f_pct_fmt(p20_bo))
                array.push(lbl_colors, color.new(bo_cashflow_color, inactive_alpha))
                array.push(lbl_xs, phase2_label_x)
            if not na(y_confirm)
                float y_confirm_label = y_confirm
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_confirm, ln_end, color.new(bo_confirm_color, inactive_alpha), "Dashed", i_line_width_primary)
                array.push(lbl_ys, y_confirm_label)
                array.push(lbl_texts, "BO Confirm P75 (Fake MFE) " + STL.f_pct_fmt(f75))
                array.push(lbl_colors, color.new(bo_confirm_color, inactive_alpha))
                array.push(lbl_xs, phase2_label_x)
            if not na(y_pivot)
                float y_pivot_label = y_pivot
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_pivot, ln_end, color.new(pivot_color, inactive_alpha), "Solid", i_line_width_primary)
                array.push(lbl_ys, y_pivot_label)
                array.push(lbl_texts, "Pivot P50 (Fake MFE) " + STL.f_pct_fmt(f50))
                array.push(lbl_colors, color.new(pivot_color, inactive_alpha))
                array.push(lbl_xs, phase2_label_x)
            if not na(y_rev90)
                float y_rev90_label = y_rev90
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_rev90, ln_end, color.new(max_reversal_color, inactive_alpha), "Dotted", i_line_width_secondary)
                array.push(lbl_ys, y_rev90_label)
                array.push(lbl_texts, "Max Reversal P90 (Fake MAE) " + STL.f_pct_fmt(rev_p90))
                array.push(lbl_colors, color.new(max_reversal_color, inactive_alpha))
                array.push(lbl_xs, phase2_label_x)

            // Shared PB/BO invalidation line — single merged label
            if not na(y_inv)
                PDL.f_draw_stat_line(ds, st.or_start_bar, y_inv, ln_end, color.new(invalidation_line_color, inactive_alpha), "Solid", i_line_width_primary)
                float y_inv_label = y_inv
                array.push(lbl_ys, y_inv_label)
                array.push(lbl_texts, "PB | BO Invalidation P80 (BO MAE) " + STL.f_pct_fmt(mae_p80))
                array.push(lbl_colors, color.new(invalidation_line_color, inactive_alpha))
                array.push(lbl_xs, phase2_label_x)

            if i_show_debug and not pb_armed
                PDL.f_draw_stat_label(ds, phase2_label_x, render_side == 1 ? st.or_high : st.or_low, "PB not armed", color.new(pb_not_armed_color, 20), "left", "tiny")

    // ── Merge and draw label registry ──
    int n_labels = math.min(array.size(lbl_ys), math.min(array.size(lbl_texts), math.min(array.size(lbl_colors), array.size(lbl_xs))))
    if n_labels > 0
        float merge_thr = syminfo.mintick * float(i_label_merge_threshold_ticks)
        array<bool> used = array.new_bool(n_labels, false)
        for k = 0 to n_labels - 1
            if not array.get(used, k)
                string combined = array.get(lbl_texts, k)
                color lbl_col = array.get(lbl_colors, k)
                float lbl_y = array.get(lbl_ys, k)
                int lbl_x = array.get(lbl_xs, k)
                if k < n_labels - 1
                    for m = k + 1 to n_labels - 1
                        if not array.get(used, m) and math.abs(array.get(lbl_ys, m) - lbl_y) < merge_thr and array.get(lbl_xs, m) == lbl_x
                            combined := combined + " | " + array.get(lbl_texts, m)
                            array.set(used, m, true)
                PDL.f_draw_stat_label(ds, lbl_x, lbl_y, combined, lbl_col, "left", i_label_size)

if barstate.islast and array.size(specs) > 0
    for i = 0 to array.size(specs) - 1
        f_render_range(i)

// Focus range for table: live first, else last range.
f_focus_idx() =>
    int focus = array.size(specs) > 0 ? array.size(specs) - 1 : 0
    if array.size(specs) > 0
        for i = 0 to array.size(specs) - 1
            RSL.RangeSpec sp = array.get(specs, i)
            RSL.RangeState st = array.get(states, i)
            bool in_or = RSL.f_in_session_pine(sp.session_or, sp.tz)
            bool in_data = RSL.f_in_session_pine(sp.session_data, sp.tz)
            if in_or or in_data or st.or_building
                focus := i
                break
    focus

if barstate.islast and i_show_table and array.size(specs) > 0
    int idx = f_focus_idx()
    RSL.RangeSpec sp = array.get(specs, idx)
    STL.ExcursionHistory hist = array.get(histories, idx)

    // Create table sized exactly for the active view.
    // DOW View: 3 cols (Day / Count / Avg MFE), 6 rows (header + Mon-Fri).
    // All other views: 6 cols, 3 rows (header + Bull + Bear).
    bool is_dow = i_table_view == "DOW View"
    int n_cols = is_dow ? 3 : 6
    int n_rows = is_dow ? 6 : 3
    color table_bg_color = f_theme_color(i_table_bg_color, #0F172A, #F8FAFC)
    color table_border_color = f_theme_color(i_table_border_color, #334155, #94A3B8)
    color table_header_bg_color = f_theme_color(i_table_header_bg_color, #1E3A8A, #BFDBFE)
    color table_header_text_color = f_theme_color(i_table_header_text_color, #E2E8F0, #111827)
    color table_body_text_color = f_theme_color(i_table_body_text_color, #E2E8F0, #1F2937)
    color table_bull_color = f_theme_color(i_bull_color, #38BD8A, #008060)
    color table_bear_color = f_theme_color(i_bear_color, #F87171, #B3261E)
    table t = table.new(PDL.f_table_pos(i_table_pos), n_cols, n_rows, bgcolor=color.new(table_bg_color, 85), border_color=color.new(table_border_color, 70), border_width=1)

    // Header row
    table.cell(t, 0, 0, sp.name + " - " + i_table_view, text_color=table_header_text_color, text_size=size.small, bgcolor=color.new(table_header_bg_color, 70))
    if is_dow
        table.cell(t, 1, 0, "Count",   text_color=table_header_text_color, text_size=size.small)
        table.cell(t, 2, 0, "Avg MFE", text_color=table_header_text_color, text_size=size.small)
    else
        table.cell(t, 1, 0, "Count", text_color=table_header_text_color, text_size=size.small)
        table.cell(t, 2, 0, "P50",   text_color=table_header_text_color, text_size=size.small)
        table.cell(t, 3, 0, "P75",   text_color=table_header_text_color, text_size=size.small)
        table.cell(t, 4, 0, "P90",   text_color=table_header_text_color, text_size=size.small)
        table.cell(t, 5, 0, "Rate",  text_color=table_header_text_color, text_size=size.small)

    if i_table_view == "MFE View"
        array<float> bull = STL.f_build_filtered(hist.mfe_bull)
        array<float> bear = STL.f_build_filtered(hist.mfe_bear)
        float b50 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 50) : na
        float b75 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 75) : na
        float b90 = array.size(bull) > 0 ? array.percentile_nearest_rank(bull, 90) : na
        float s50 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 50) : na
        float s75 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 75) : na
        float s90 = array.size(bear) > 0 ? array.percentile_nearest_rank(bear, 90) : na
        table.cell(t, 0, 1, "Bull", text_color=table_bull_color)
        table.cell(t, 1, 1, str.tostring(array.size(bull)))
        table.cell(t, 2, 1, STL.f_pct_fmt(b50))
        table.cell(t, 3, 1, STL.f_pct_fmt(b75))
        table.cell(t, 4, 1, STL.f_pct_fmt(b90))
        table.cell(t, 5, 1, "-")
        table.cell(t, 0, 2, "Bear", text_color=table_bear_color)
        table.cell(t, 1, 2, str.tostring(array.size(bear)))
        table.cell(t, 2, 2, STL.f_pct_fmt(s50))
        table.cell(t, 3, 2, STL.f_pct_fmt(s75))
        table.cell(t, 4, 2, STL.f_pct_fmt(s90))
        table.cell(t, 5, 2, "-")
    else if i_table_view == "MAE View"
        array<float> mab = STL.f_build_filtered(hist.mae_bull_abs)
        array<float> mas = STL.f_build_filtered(hist.mae_bear_abs)
        array<float> mpb = STL.f_build_filtered(hist.mae_bull_pb)
        array<float> mps = STL.f_build_filtered(hist.mae_bear_pb)
        float rb = array.size(hist.r_multiple_bull) > 0 ? array.avg(hist.r_multiple_bull) : na
        float rs = array.size(hist.r_multiple_bear) > 0 ? array.avg(hist.r_multiple_bear) : na
        table.cell(t, 0, 1, "Bull Abs/PB", text_color=table_bull_color)
        table.cell(t, 1, 1, str.tostring(array.size(mab)))
        table.cell(t, 2, 1, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 50) : na))
        table.cell(t, 3, 1, STL.f_pct_fmt(array.size(mab) > 0 ? array.percentile_nearest_rank(mab, 75) : na))
        table.cell(t, 4, 1, STL.f_pct_fmt(array.size(mpb) > 0 ? array.percentile_nearest_rank(mpb, 50) : na))
        table.cell(t, 5, 1, na(rb) ? "n/a" : str.tostring(rb, "#.##"))
        table.cell(t, 0, 2, "Bear Abs/PB", text_color=table_bear_color)
        table.cell(t, 1, 2, str.tostring(array.size(mas)))
        table.cell(t, 2, 2, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 50) : na))
        table.cell(t, 3, 2, STL.f_pct_fmt(array.size(mas) > 0 ? array.percentile_nearest_rank(mas, 75) : na))
        table.cell(t, 4, 2, STL.f_pct_fmt(array.size(mps) > 0 ? array.percentile_nearest_rank(mps, 50) : na))
        table.cell(t, 5, 2, na(rs) ? "n/a" : str.tostring(rs, "#.##"))
    else if i_table_view == "DOW View"
        for d = 2 to 6
            int row = d - 1
            int cnt = 0
            float sum_b = 0.0
            float sum_s = 0.0
            int n = math.min(array.size(hist.dow), math.min(array.size(hist.mfe_bull), array.size(hist.mfe_bear)))
            if n > 0
                for j = 0 to n - 1
                    if array.get(hist.dow, j) == d
                        cnt += 1
                        sum_b += array.get(hist.mfe_bull, j)
                        sum_s += array.get(hist.mfe_bear, j)
            float avg_net = cnt == 0 ? na : (sum_b + sum_s) / float(2 * cnt)
            table.cell(t, 0, row, STL.f_day_full(d), text_color=table_body_text_color)
            table.cell(t, 1, row, str.tostring(cnt))
            table.cell(t, 2, row, STL.f_pct_fmt(avg_net))
    else
        array<float> fake_mfe_bull = STL.f_build_filtered(hist.fake_mfe_bull)
        array<float> fake_mfe_bear = STL.f_build_filtered(hist.fake_mfe_bear)
        array<float> fake_mae_bull = STL.f_build_filtered(hist.fake_mae_bull)
        array<float> fake_mae_bear = STL.f_build_filtered(hist.fake_mae_bear)
        float b25 = array.size(fake_mfe_bull) > 0 ? array.percentile_nearest_rank(fake_mfe_bull, 25) : na
        float b50 = array.size(fake_mfe_bull) > 0 ? array.percentile_nearest_rank(fake_mfe_bull, 50) : na
        float b75 = array.size(fake_mfe_bull) > 0 ? array.percentile_nearest_rank(fake_mfe_bull, 75) : na
        float b90 = array.size(fake_mfe_bull) > 0 ? array.percentile_nearest_rank(fake_mfe_bull, 90) : na
        float s25 = array.size(fake_mfe_bear) > 0 ? array.percentile_nearest_rank(fake_mfe_bear, 25) : na
        float s50 = array.size(fake_mfe_bear) > 0 ? array.percentile_nearest_rank(fake_mfe_bear, 50) : na
        float s75 = array.size(fake_mfe_bear) > 0 ? array.percentile_nearest_rank(fake_mfe_bear, 75) : na
        float s90 = array.size(fake_mfe_bear) > 0 ? array.percentile_nearest_rank(fake_mfe_bear, 90) : na
        float rb25 = array.size(fake_mae_bull) > 0 ? array.percentile_nearest_rank(fake_mae_bull, 25) : na
        float rb50 = array.size(fake_mae_bull) > 0 ? array.percentile_nearest_rank(fake_mae_bull, 50) : na
        float rb75 = array.size(fake_mae_bull) > 0 ? array.percentile_nearest_rank(fake_mae_bull, 75) : na
        float rb90 = array.size(fake_mae_bull) > 0 ? array.percentile_nearest_rank(fake_mae_bull, 90) : na
        float rs25 = array.size(fake_mae_bear) > 0 ? array.percentile_nearest_rank(fake_mae_bear, 25) : na
        float rs50 = array.size(fake_mae_bear) > 0 ? array.percentile_nearest_rank(fake_mae_bear, 50) : na
        float rs75 = array.size(fake_mae_bear) > 0 ? array.percentile_nearest_rank(fake_mae_bear, 75) : na
        float rs90 = array.size(fake_mae_bear) > 0 ? array.percentile_nearest_rank(fake_mae_bear, 90) : na
        float dbr = STL.f_double_break_rate(hist.double_break, hist.entry_triggered_bull, hist.entry_triggered_bear)
        table.cell(t, 0, 1, "Bull Fake", text_color=table_bull_color)
        table.cell(t, 1, 1, STL.f_pct_fmt(b50))
        table.cell(t, 2, 1, STL.f_pct_fmt(b75))
        table.cell(t, 3, 1, STL.f_pct_fmt(rb50))
        table.cell(t, 4, 1, STL.f_pct_fmt(rb90))
        table.cell(t, 5, 1, STL.f_pct_fmt(dbr))
        table.cell(t, 0, 2, "Bear Fake", text_color=table_bear_color)
        table.cell(t, 1, 2, STL.f_pct_fmt(s50))
        table.cell(t, 2, 2, STL.f_pct_fmt(s75))
        table.cell(t, 3, 2, STL.f_pct_fmt(rs50))
        table.cell(t, 4, 2, STL.f_pct_fmt(rs90))
        table.cell(t, 5, 2, STL.f_pct_fmt(dbr))
