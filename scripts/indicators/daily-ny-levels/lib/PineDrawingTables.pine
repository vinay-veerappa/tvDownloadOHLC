//@version=6
library("PineDrawingTables", overlay=true)

// ============================================================================
// PineDrawingTables v1.0 — Table and cell rendering helpers
// ============================================================================
// Depends on: PineDrawingCore/1
// Purpose: Semantic helpers for table positioning and cell rendering (headers,
//          values, metric rows)
// ============================================================================

import vveerappa/PineDrawingCore/2 as Core

/// Resolve a table position string token to Pine position constant.
/// Delegates to Core token mapping ("Top Left", "Middle Center", etc.).
/// Parameters:
///   - s: Position string token
/// Returns: position.* constant
export f_table_pos(string s) =>
    Core.f_table_pos(s)

/// Create a table with semantic position resolution and standard styling inputs.
/// Parameters:
///   - pos_token: Position string token
///   - cols, rows: Table dimensions
///   - bg: Background color
///   - border_color: Border color
///   - border_width: Border width
export f_new_table(string pos_token, int cols, int rows, color bg, color border_color, int border_width) =>
    table.new(f_table_pos(pos_token), cols, rows, bgcolor=bg, border_color=border_color, border_width=border_width)

/// Render a standard header cell with specified styling.
/// Parameters:
///   - t: Table object
///   - col, row: Cell coordinates
///   - text_value: Cell text
///   - bg: Background color
///   - text_color: Text color
///   - text_size: Size token ("Tiny", "Small", "Normal", "Large", "Huge")
export f_draw_header_cell(table t, int col, int row, string text_value, color bg, color text_color, string text_size) =>
    table.cell(t, col, row, text_value, text_color=text_color, bgcolor=bg, text_size=Core.f_text_size(text_size))

/// Render a standard body/value cell with specified styling.
/// Parameters:
///   - t: Table object
///   - col, row: Cell coordinates
///   - text_value: Cell text
///   - bg: Background color
///   - text_color: Text color
///   - text_size: Size token ("Tiny", "Small", "Normal", "Large", "Huge")
export f_draw_value_cell(table t, int col, int row, string text_value, color bg, color text_color, string text_size) =>
    table.cell(t, col, row, text_value, text_color=text_color, bgcolor=bg, text_size=Core.f_text_size(text_size))

/// Render a key/value metric row (two-column layout: metric name | metric value).
/// Parameters:
///   - t: Table object
///   - row: Row index
///   - metric_name: Name/label text (column 0)
///   - metric_value: Value text (column 1)
///   - name_bg, value_bg: Background colors for each column
///   - name_color, value_color: Text colors for each column
///   - text_size: Size token ("Tiny", "Small", "Normal", "Large", "Huge")
export f_draw_metric_row(table t, int row, string metric_name, string metric_value, color name_bg, color value_bg, color name_color, color value_color, string text_size) =>
    f_draw_value_cell(t, 0, row, metric_name, name_bg, name_color, text_size)
    f_draw_value_cell(t, 1, row, metric_value, value_bg, value_color, text_size)
