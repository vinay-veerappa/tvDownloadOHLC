// ============================================================================
// 2.5 Session Levels
// ============================================================================

export f_draw_session_high_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string session_token, string session_name, string probability = "", string streak_arrow = "", string streak_count = "", string hit_rate = "", string tag = "", int lookback = 0) =>
    f_draw_labeled_stat_line(
        ds, lr, x1, y, x2,
        color.new(
            Core.f_theme_color_safe(str.length(session_token) > 0 ? session_token : str.lower(session_name), theme_mode, Core.f_theme_color("neutral", theme_mode)),
            Core.f_display_profile_transparency(Core.f_tier_transparency(tier), profile)
        ),
        Core.f_tier_style(tier),
        Core.f_display_profile_width(Core.f_tier_width(tier), profile),
        session_name,
        Core.f_theme_color_safe(str.length(session_token) > 0 ? session_token : str.lower(session_name), theme_mode, Core.f_theme_color("neutral", theme_mode)),
        x2 + Core.f_geometry_label_gap_bars(),
        "stagger", 30, tag, lookback
    )

export f_draw_session_low_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string session_token, string session_name, string probability = "", string streak_arrow = "", string streak_count = "", string hit_rate = "", string tag = "", int lookback = 0) =>
    f_draw_labeled_stat_line(
        ds, lr, x1, y, x2,
        color.new(
            Core.f_theme_color_safe(str.length(session_token) > 0 ? session_token : str.lower(session_name), theme_mode, Core.f_theme_color("neutral", theme_mode)),
            Core.f_display_profile_transparency(Core.f_tier_transparency(tier), profile)
        ),
        Core.f_tier_style(tier),
        Core.f_display_profile_width(Core.f_tier_width(tier), profile),
        session_name,
        Core.f_theme_color_safe(str.length(session_token) > 0 ? session_token : str.lower(session_name), theme_mode, Core.f_theme_color("neutral", theme_mode)),
        x2 + Core.f_geometry_label_gap_bars(),
        "stagger", 30, tag, lookback
    )

export f_draw_session_mid_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string session_token, string session_name, string probability = "", string streak_arrow = "", string streak_count = "", string hit_rate = "", string tag = "", int lookback = 0) =>
    f_draw_labeled_stat_line(
        ds, lr, x1, y, x2,
        color.new(
            Core.f_theme_color_safe(str.length(session_token) > 0 ? session_token : str.lower(session_name), theme_mode, Core.f_theme_color("neutral", theme_mode)),
            Core.f_display_profile_transparency(tier == "P" ? 20 : tier == "S" ? 30 : 50, profile)
        ),
        "Dotted",
        Core.f_display_profile_width(1, profile),
        session_name,
        Core.f_theme_color_safe(str.length(session_token) > 0 ? session_token : str.lower(session_name), theme_mode, Core.f_theme_color("neutral", theme_mode)),
        x2 + Core.f_geometry_label_gap_bars(),
        "stagger", 30, tag, lookback
    )


// ============================================================================
// 2.6 Previous-period Levels
// ============================================================================

export f_draw_previous_period_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string variant = "day", string period_abbrev = "PD", string level_abbrev = "H", string hit_rate = "", string streak_arrow = "", string streak_count = "", string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    int width = 1
    string style = tier == "S" ? "Dashed" : tier == "C" ? "Dotted" : "Solid"
    int transp = tier == "S" ? 15 : tier == "C" ? 30 : 0
    // TODO: per-variant color binding per spec §2.6 when finalized (week/month variants)
    color base_clr = Core.f_theme_color("prev_day", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    array<string> keys = array.from("period_abbrev", "level_abbrev", "hit_rate", "streak_arrow", "streak_count", "value", "unit", "base_text")
    array<string> vals = array.from(period_abbrev, level_abbrev, hit_rate, streak_arrow, streak_count, value_str, unit_str, period_abbrev + level_abbrev)
    string label_text = Core.f_format_template("{base_text}{if:hit_rate} {hit_rate}%{endif}{if:streak_count} ({streak_arrow}{streak_count}){endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "stagger", 20, tag, lookback)

export f_draw_settlement_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string hit_rate = "", string streak_arrow = "", string streak_count = "", string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    int width = 1
    string style = tier == "S" ? "Dashed" : tier == "C" ? "Dotted" : "Solid"
    int transp = tier == "S" ? 15 : tier == "C" ? 30 : 0
    
    color base_clr = Core.f_theme_color("settlement", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    array<string> keys = array.from("hit_rate", "streak_arrow", "streak_count", "value", "unit", "base_text")
    array<string> vals = array.from(hit_rate, streak_arrow, streak_count, value_str, unit_str, "Settle")
    string label_text = Core.f_format_template("{base_text}{if:hit_rate} {hit_rate}%{endif}{if:streak_count} ({streak_arrow}{streak_count}){endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "stagger", 25, tag, lookback)

// ============================================================================
// 2.1 Generic Priority Lines
// ============================================================================

/// Draw a generic priority line (P, S, or C tier).
export f_draw_priority_line(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string label_text, color base_clr = na, int priority = 10, string tag = "", int lookback = 0) =>
    int width = tier == "P" ? 2 : 1
    string style = tier == "C" ? "Dotted" : tier == "S" ? "Dashed" : "Solid"
    int transp = tier == "S" ? 15 : tier == "C" ? 30 : 0
    color c = na(base_clr) ? Core.f_theme_color("neutral", theme_mode) : base_clr
    color clr = color.new(c, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, c, x2 + Core.f_geometry_label_gap_bars(), "merge", priority, tag, lookback)

// ============================================================================
// 2.7 Anchored and Reference Levels
// ============================================================================

/// Draw a generic reference level (§2.7).
export f_draw_reference_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string label_text, string variant = "neutral", string tag = "", int lookback = 0) =>
    // Use the variant as a palette token for color
    color ref_base_clr = Core.f_theme_color(variant, theme_mode)
    f_draw_priority_line(ds, lr, theme_mode, profile, tier, x1, x2, y, label_text, ref_base_clr, 5, tag, lookback)

// ============================================================================
// 3. Options and Gamma Levels
// ============================================================================


// --- 3.2 Key Walls and Magnets ----------------------------------------------

/// Draw a wall level (key options wall, macro, sweep, etc.).
export f_draw_wall_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string variant = "standard", string direction = "call", string wall_label = "", string glyph_prefix = "", string value_str = "", string unit = "", string tag = "", int lookback = 0) =>
    f_draw_labeled_stat_line(
        ds, lr, x1, y, x2,
        color.new(
            Core.f_theme_color(
                variant == "whale" ? (direction == "call" ? "pivot_color" : "warning") :
                variant == "macro" ? (direction == "call" ? "median" : "caution") :
                variant == "golden_sweep" ? "median" :
                variant == "zero_dte" ? (direction == "call" ? "bull" : "bear") :
                variant == "local" ? (direction == "call" ? "bull" : "bear") :
                variant == "dex" ? (direction == "call" ? "bull" : "bear") :
                (direction == "call" ? "bull" : "bear"),
                theme_mode
            ),
            Core.f_display_profile_transparency(Core.f_tier_transparency(tier), profile)
        ),
        variant == "whale" ? "Dashed" : variant == "zero_dte" ? "Dotted" : variant == "dex" ? "Dashed" : Core.f_tier_style(tier),
        Core.f_display_profile_width(Core.f_tier_width(tier), profile),
        Core.f_format_template(
            "{if:glyph_prefix}{glyph_prefix} {endif}{wall_label}{if:value_str} ({value_str}{unit}){endif}",
            array.from("wall_label", "glyph_prefix", "value_str", "unit", "base_text"),
            array.from(str.length(wall_label) > 0 ? wall_label : (direction == "call" ? "Call Wall" : "Put Wall"), glyph_prefix, value_str, unit, "Wall")
        ),
        Core.f_theme_color(
            variant == "whale" ? (direction == "call" ? "pivot_color" : "warning") :
            variant == "macro" ? (direction == "call" ? "median" : "caution") :
            variant == "golden_sweep" ? "median" :
            variant == "zero_dte" ? (direction == "call" ? "bull" : "bear") :
            variant == "local" ? (direction == "call" ? "bull" : "bear") :
            variant == "dex" ? (direction == "call" ? "bull" : "bear") :
            (direction == "call" ? "bull" : "bear"),
            theme_mode
        ),
        x2 + Core.f_geometry_label_gap_bars(),
        "stagger", 35, tag, lookback
    )

/// Draw a magnet level (gamma magnet, pin strike, max pain, hedge wall).
export f_draw_magnet_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string variant = "gamma_magnet", string value_str = "", string unit = "", string tag = "", int lookback = 0) =>
    f_draw_priority_line(
        ds, lr, theme_mode, profile, tier, x1, x2, y,
        Core.f_format_template(
            "{base_text}{if:value_str} ({value_str}{unit}){endif}",
            array.from("variant_display", "value_str", "unit", "base_text"),
            array.from(
                variant == "gamma_magnet" ? "Gamma Magnet" :
                variant == "pin_strike" ? "Pin Strike" :
                variant == "max_pain" ? "Max Pain" :
                variant == "hedge_wall" ? "Hedge Wall" : "Magnet",
                value_str, unit,
                variant == "gamma_magnet" ? "Gamma Magnet" :
                variant == "pin_strike" ? "Pin Strike" :
                variant == "max_pain" ? "Max Pain" :
                variant == "hedge_wall" ? "Hedge Wall" : "Magnet"
            )
        ),
        Core.f_theme_color(
            variant == "gamma_magnet" ? "pivot_color" :
            variant == "pin_strike" ? "pivot_color" :
            variant == "max_pain" ? "warning" :
            variant == "hedge_wall" ? "caution" : "pivot_color",
            theme_mode
        ),
        38, tag, lookback
    )
/// Draw the Zero Gamma level (gamma flip boundary).
export f_draw_zero_gamma_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string value_str = "", string unit = "", string tag = "", int lookback = 0) =>
    f_draw_priority_line(
        ds, lr, theme_mode, profile, tier, x1, x2, y,
        Core.f_format_template(
            "{base_text}{if:value} {value}{unit}{endif}",
            array.from("value", "unit", "base_text"),
            array.from(value_str, unit, "Zero Gamma")
        ),
        Core.f_theme_color("warning", theme_mode),
        45, tag, lookback
    )

/// Draw the Gamma Flip level (where gamma changes sign).
export f_draw_gamma_flip_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string value_str = "", string unit = "", string tag = "", int lookback = 0) =>
    f_draw_priority_line(
        ds, lr, theme_mode, profile, tier, x1, x2, y,
        Core.f_format_template(
            "{base_text}{if:value} {value}{unit}{endif}",
            array.from("value", "unit", "base_text"),
            array.from(value_str, unit, "Gamma Flip")
        ),
        Core.f_theme_color("caution", theme_mode),
        42, tag, lookback
    )

/// Draw the Gamma Cliff level (sharp gamma change).
export f_draw_gamma_cliff_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string value_str = "", string unit = "", string tag = "", int lookback = 0) =>
    f_draw_priority_line(
        ds, lr, theme_mode, profile, tier, x1, x2, y,
        Core.f_format_template(
            "{base_text}{if:value} {value}{unit}{endif}",
            array.from("value", "unit", "base_text"),
            array.from(value_str, unit, "Gamma Cliff")
        ),
        Core.f_theme_color("invalidation", theme_mode),
        48, tag, lookback
    )

// --- 3.3 Expected Move Boundaries -------------------------------------------

export f_draw_expected_move_boundary(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string direction = "upper", string sigma = "1", string probability = "68", string value_str = "", string unit = "", string tag = "", int lookback = 0) =>
    // Spec §3.3: expected move uses neutral color with direction indicated via arrow glyph
    color c = Core.f_theme_color("neutral", theme_mode)
    array<string> keys = array.from("sigma", "arrow", "probability", "value", "unit", "base_text")
    array<string> vals = array.from(sigma, direction == "upper" ? "↑" : "↓", probability, value_str, unit, "EM")
    string label_text = Core.f_format_template("{base_text} {sigma}σ {arrow}{if:probability} ({probability}%){endif}{if:value} {value}{unit}{endif}", keys, vals)
    f_draw_priority_line(ds, lr, theme_mode, profile, tier, x1, x2, y, label_text, c, 35, tag, lookback)

