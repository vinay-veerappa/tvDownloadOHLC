//@version=6
library("PineDrawingHorizontalLevels", overlay=true)

// ============================================================================
// PineDrawingHorizontalLevels v4.0 — Semantic line renderers
// ============================================================================
// Depends on: PineDrawingCore v4.0
// Purpose: Provides theme-aware and profile-scaled renderers for horizontal
//          price levels (statistical medians, session opens, targets, etc.).
// ============================================================================

import vveerappa/PineDrawingCore/3 as Core

/// Draw a horizontal stat line from x1 to x2 at price y.
/// Parameters:
///   - ds: PineDrawingState to track the line
///   - x1, x2: Bar indices (left and right edges)
///   - y: Price level
///   - clr: Line color
///   - style: "Solid", "Dashed", "Dotted"
///   - width: Line width (1-5)
export f_draw_stat_line(Core.PineDrawingState ds, int x1, float y, int x2, color clr, string style, int width, string tag = "", int lookback = 0) =>
    Core.f_draw_line(ds, x1, y, x2, y, clr, style, width, tag, lookback)

/// Draw a horizontal stat line and enqueue a label for registry-based collision resolution.
/// Combines primitive rendering with label registration for clean label placement.
/// Parameters:
///   - ds: PineDrawingState
///   - lr: LabelRegistry for label collision resolution
///   - x1, x2: Bar indices for the line
///   - y: Price level for both line and label
///   - line_clr: Line color
///   - line_style: "Solid", "Dashed", "Dotted"
///   - line_width: Line width (1-5)
///   - label_text: Label text (e.g., "Resistance")
///   - label_clr: Label text color
///   - label_x: Label bar index (usually x2 or x2 + offset)
///   - strategy: Collision strategy ("merge", "stagger", "hide", "off")
///   - priority: Collision priority (1-50)
///   - tag: Optional lookup tag
///   - lookback: Days back (nd)
export f_draw_labeled_stat_line(Core.PineDrawingState ds, Core.LabelRegistry lr, int x1, float y, int x2, color line_clr, string line_style, int line_width, string label_text, color label_clr, int label_x, string strategy = "merge", int priority = 0, string tag = "", int lookback = 0, string tooltip_text = "", string label_mode = "Label") =>
    f_draw_stat_line(ds, x1, y, x2, line_clr, line_style, line_width, tag, lookback)
    Core.f_label_registry_push_ex(lr, y, label_text, label_clr, label_x, strategy, priority, "", "left", "", label_mode, tooltip_text, lookback, tag)

// ============================================================================
// 2.2 Statistical Lines
// ============================================================================

export f_draw_session_open_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string session_token, string session_name, string tag = "", int lookback = 0) =>
    int base_width = 1  // Spec §2.5: session opens use width=1 at all tiers
    string style = Core.f_tier_style(tier)
    int transp = Core.f_tier_transparency(tier)
    color base_clr = Core.f_theme_color_safe(session_token, theme_mode, color.gray)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(base_width, profile)
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, session_name, base_clr, x2 + Core.f_geometry_label_gap_bars(), "merge", 50, tag, lookback)

export f_draw_statistical_level_median(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string source_name, string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    int base_width = Core.f_tier_width(tier)
    string style = Core.f_tier_style(tier)
    int transp = Core.f_tier_transparency(tier)
    color base_clr = Core.f_theme_color("median", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(base_width, profile)
    array<string> keys = array.from("source_name", "value", "unit", "base_text")
    array<string> vals = array.from(source_name, value_str, unit_str, source_name + " Med")
    string label_text = Core.f_format_template("{base_text}{if:value} {value}{unit}{endif}", keys, vals)
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "merge", 20, tag, lookback)

export f_draw_statistical_level_avg(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string source_name, string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    int base_width = Core.f_tier_width(tier)
    string style = Core.f_tier_style(tier)
    int transp = Core.f_tier_transparency(tier)
    color base_clr = Core.f_theme_color("average", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(base_width, profile)
    array<string> keys = array.from("source_name", "value", "unit", "base_text")
    array<string> vals = array.from(source_name, value_str, unit_str, source_name + " Avg")
    string label_text = Core.f_format_template("{base_text}{if:value} {value}{unit}{endif}", keys, vals)
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "merge", 20, tag, lookback)

export f_draw_statistical_level_pN(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string source_name, string percentile_str, string value_str = "", string unit_str = "", string direction = "neutral", string tag = "", int lookback = 0) =>
    int base_width = Core.f_tier_width(tier)
    string style = Core.f_tier_style(tier)
    int transp = Core.f_tier_transparency(tier)
    string base_token = direction == "bull" ? "bull" : direction == "bear" ? "bear" : "neutral"
    color base_clr = Core.f_theme_color(base_token, theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(base_width, profile)
    array<string> keys = array.from("source_name", "percentile", "value", "unit", "base_text")
    array<string> vals = array.from(source_name, percentile_str, value_str, unit_str, source_name + " P" + percentile_str)
    string label_text = Core.f_format_template("{base_text}{if:value} {value}{unit}{endif}", keys, vals)
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "stagger", 20, tag, lookback)

export f_draw_stretch_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string source_name, string percentile_str = "90", string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    int width = 1
    string style = "Dotted"
    int transp = tier == "S" ? 20 : tier == "C" ? 40 : 0
    color base_clr = Core.f_theme_color("stretch", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    array<string> keys = array.from("source_name", "percentile", "value", "unit", "base_text")
    array<string> vals = array.from(source_name, percentile_str, value_str, unit_str, source_name + " Stretch")
    string label_text = Core.f_format_template("{base_text}{if:value} {value}{unit}{endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "stagger", 25, tag, lookback)

export f_draw_max_excursion_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string source_name = "", string percentile_str = "90", string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    int width = 1
    string style = "Dotted"
    int transp = tier == "S" ? 20 : tier == "C" ? 40 : 0
    color base_clr = Core.f_theme_color("max_reversal", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    array<string> keys = array.from("source_name", "percentile", "value", "unit", "base_text")
    array<string> vals = array.from(source_name, percentile_str, value_str, unit_str, "Max Reversal")
    string label_text = Core.f_format_template("{base_text}{if:percentile} P{percentile}{endif}{if:source_name} ({source_name}){endif}{if:value} {value}{unit}{endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "stagger", 45, tag, lookback)

// ============================================================================
// 2.3 Thesis-defining Lines
// ============================================================================

export f_draw_invalidation_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string direction_hint = "", string value_str = "", string unit_str = "", string source = "", string tag = "", int lookback = 0) =>
    int width = tier == "P" ? 2 : 1
    string style = tier == "P" ? "Solid" : tier == "S" ? "Dashed" : "Dotted"
    int transp = tier == "S" ? 15 : tier == "C" ? 40 : 0
    color base_clr = Core.f_theme_color("invalidation", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    array<string> keys = array.from("source", "value", "unit", "direction_hint", "base_text")
    array<string> vals = array.from(source, value_str, unit_str, direction_hint, "Invalidation")
    string label_text = Core.f_format_template("{base_text}{if:direction_hint} {direction_hint}{endif}{if:value} {value}{unit}{endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "merge", 50, tag, lookback)

export f_draw_activation_trigger(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string variant = "breakout", string direction = "bull", string basis = "", string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    string style = variant == "breakout" ? "Dotted" : "Dashed"
    int width = tier == "C" ? 1 : 2
    int transp = tier == "C" ? 25 : 0
    
    color base_clr = Core.f_theme_color("pivot_color", theme_mode)
    if variant == "breakout"
        base_clr := Core.f_theme_color(direction == "bull" ? "confirm" : "invalidation", theme_mode)
    else if variant == "pullback"
        base_clr := Core.f_theme_color(direction == "bull" ? "positive" : "negative", theme_mode)
    
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    string v_display = variant == "breakout" ? "Breakout" : "Pullback"
    array<string> keys = array.from("variant_display", "value", "unit", "basis", "base_text")
    array<string> vals = array.from(v_display, value_str, unit_str, basis, v_display + " Activation")
    string label_text = Core.f_format_template("{base_text}{if:basis} {basis}{endif}{if:value} {value}{unit}{endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + 2, "stagger", 45, tag, lookback)

export f_draw_confirm_level(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string direction = "bull", string percentile_str = "", string value_str = "", string unit_str = "", string source = "", string tag = "", int lookback = 0) =>
    int width = 1
    string style = "Dotted"
    int transp = tier == "S" ? 15 : tier == "C" ? 30 : 0
    color base_clr = Core.f_theme_color("confirm", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    array<string> keys = array.from("source", "percentile", "value", "unit", "base_text")
    array<string> vals = array.from(source, percentile_str, value_str, unit_str, "Confirm")
    string label_text = Core.f_format_template("{base_text}{if:percentile} P{percentile}{endif}{if:value} {value}{unit}{endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "stagger", 30, tag, lookback)

export f_draw_pivot_structural(Core.PineDrawingState ds, Core.LabelRegistry lr, string theme_mode, string profile, string tier, int x1, int x2, float y, string label_suffix = "", string basis = "", string value_str = "", string unit_str = "", string tag = "", int lookback = 0) =>
    int width = tier == "P" ? 2 : 1
    string style = tier == "C" ? "Dashed" : "Solid"
    int transp = tier == "S" ? 15 : tier == "C" ? 30 : 0
    color base_clr = Core.f_theme_color("pivot_color", theme_mode)
    color clr = color.new(base_clr, Core.f_display_profile_transparency(transp, profile))
    int w = Core.f_display_profile_width(width, profile)
    
    array<string> keys = array.from("label_suffix", "value", "unit", "basis", "base_text")
    array<string> vals = array.from(label_suffix, value_str, unit_str, basis, "Pivot")
    string label_text = Core.f_format_template("{base_text}{if:label_suffix} {label_suffix}{endif}{if:basis} {basis}{endif}{if:value} {value}{unit}{endif}", keys, vals)
    
    f_draw_labeled_stat_line(ds, lr, x1, y, x2, clr, style, w, label_text, base_clr, x2 + Core.f_geometry_label_gap_bars(), "merge", 35, tag, lookback)

