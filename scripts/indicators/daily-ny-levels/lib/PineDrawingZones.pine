//@version=6
library("PineDrawingZones")

// NOTE: This import path is the intended published dependency once Core is published.
// Local workspace references cannot be imported directly by Pine libraries.
import vveerappa/PineDrawingCore/1 as Core

// Opening-range/session zone renderer.
export f_draw_or_box(Core.PineDrawingState ds, int start_bar, float hi, float lo, int end_bar, color clr, string style, int width) =>
    Core.f_draw_or_box(ds, start_bar, hi, lo, end_bar, clr, style, width)

// Generic vertical price band renderer used by histograms and reversal bands.
export f_draw_hist_band(Core.PineDrawingState ds, int anchor, float p_top, float p_bot, int width_bars, color clr, int transp) =>
    Core.f_draw_hist_band(ds, anchor, p_top, p_bot, width_bars, clr, transp)

// Time-distribution bar renderer.
export f_draw_time_bar(Core.PineDrawingState ds, int x_left, int x_right, float y_top, float y_bot, color clr) =>
    Core.f_draw_time_bar(ds, x_left, x_right, y_top, y_bot, clr)
