<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <!--
      ICT ENGINE PARITY HARNESS (docs/architecture/NT8_STRATEGY_OWNERSHIP.md §Workflow).

      Compiles ONLY shared/ict/ (pure C#, zero NinjaScript deps — that is the
      design contract that makes this harness possible) plus scripts/parity's
      C# runner stub, then emits the same per-bar CSV the NT8 indicator's diag
      writer produces. scripts/parity/run_signal_parity.py diffs the two.

      The engines are ALSO compiled by NT8 (Strategies/Vinay/) — this harness
      does not replace that; it catches drift before a deploy.
    -->
    <RootNamespace>Vinay.Ict.Parity</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CsdEngineHarness.cs" />
    <Compile Include="../../ninjatrader/shared/ict/**/*.cs" />
  </ItemGroup>
</Project>