//@version=6
indicator("[VxV]Probability Engine", shorttitle="[VxV]ProbMap", overlay=true,
     max_boxes_count=50, max_lines_count=100, max_labels_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
//  PROBABILITY ENGINE 
// ═══════════════════════════════════════════════════════════════════════════════
// 
// CHANGELOG from v3:
// ─────────────────────────────────────────────────────────────────────────────
// 1. [CRITICAL] 72-Scenario Decision Tree — Asia size now modifies probabilities
// 2. [CRITICAL] Gap Confluence — Tracks RTH gap direction, calculates chasing vs fading
// 3. [CRITICAL] Fixed Judas Detection — Now tracks sweep ORDER, not just occurrence
// 4. [CRITICAL] Misaligned = SKIP — Shows "⚠ SKIP" with actual 49-56% probability
// 5. [HIGH] Conditional CBDR Sigmas — Asymmetric based on manipulation direction
// 6. [HIGH] London Range Effect — Large London reduces probability
// 7. [HIGH] DOW Adjustment — Tuesday/Wednesday boost, Monday reduction
// 8. [MEDIUM] Fixed 7-8AM Mid probability — 80.6% not 94.3%
// 9. [MEDIUM] Setup Quality Score — Combines all factors into single score
// 10. [LOW] Timing Window Warning — Alerts when 80% of reversals complete
// 11. [LOW] PM Management Mode — Different display during PM session
// 12. [LOW] Commodity Exception — Different logic for CL/GC
//
// Based on 5,165 NQ trading days (2006-2026)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────────────

grp_s = "Sessions"
i_tz = input.string("America/New_York", "Timezone", options=["America/New_York","America/Chicago"], group=grp_s)

grp_t = "═══════ Theme ═══════"
i_theme = input.string("Dark", "Chart Theme", options=["Dark","Light","Auto"], group=grp_t)
i_dashOpacity = input.int(10, "Dashboard Background Opacity", minval=0, maxval=100, group=grp_t)

grp_d = "═══════ Dashboard ═══════"
i_showDash = input.bool(true, "Show Dashboard", group=grp_d)
i_dashPos = input.string("Top Right", "Dashboard Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grp_d)
i_dashSz = input.string("Small", "Dashboard Size", options=["Tiny","Small","Normal","Huge"], group=grp_d)

grp_l = "═══════ Lines ═══════"
i_showLevels = input.bool(true, "Show All Levels", group=grp_l)
i_showLondon = input.bool(true, "  Show London H/L/Mid", group=grp_l, inline="lon")
i_londonWidth = input.int(2, "Width", minval=1, maxval=5, group=grp_l, inline="lon")
i_londonStyle = input.string("Solid", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="lon")

i_showAsia = input.bool(true, "  Show Asia H/L", group=grp_l, inline="asia")
i_asiaWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="asia")
i_asiaStyle = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="asia")

i_show78Mid = input.bool(true, "  Show 7-8 AM Mid", group=grp_l, inline="78")
i_78Width = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="78")
i_78Style = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="78")

i_show730 = input.bool(true, "  Show 07:30 Open", group=grp_l, inline="730")
i_730Width = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="730")
i_730Style = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="730")

i_showMidnight = input.bool(true, "  Show Midnight Open", group=grp_l, inline="mn")
i_mnWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="mn")
i_mnStyle = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="mn")

i_showONMid = input.bool(true, "  Show ON Mid", group=grp_l, inline="onm")
i_onmWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="onm")
i_onmStyle = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="onm")

i_showOTE = input.bool(false, "  Show OTE Zones", group=grp_l, inline="ote")
i_oteWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="ote")
i_oteStyle = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="ote")

i_showGlobex = input.bool(true, "  Show Globex Open", group=grp_l, inline="glx")
i_glxWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="glx")
i_glxStyle = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="glx")

i_showSettle = input.bool(true, "  Show Settlement/PDC", group=grp_l, inline="pdc")
i_pdcWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="pdc")
i_pdcStyle = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="pdc")

i_showPDHL = input.bool(true, "  Show PDH/PDL", group=grp_l, inline="pdhl")
i_pdhlWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="pdhl")
i_pdhlStyle = input.string("Solid", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="pdhl")

i_showSigma = input.bool(true, "  Show CBDR Sigma", group=grp_l, inline="sig")
i_sigWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="sig")
i_sigStyle = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="sig")

i_showAM = input.bool(true, "  Show AM H/L (PM only)", group=grp_l, inline="am")
i_amWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="am")
i_amStyle = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="am")

i_showLunch = input.bool(true, "  Show Lunch H/L (PM only)", group=grp_l, inline="lch")
i_lchWidth = input.int(1, "Width", minval=1, maxval=5, group=grp_l, inline="lch")
i_lchStyle = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grp_l, inline="lch")

i_lvlWidth = input.int(1, "Default Level Width", minval=1, maxval=5, group=grp_l)

grp_lb = "═══════ Labels ═══════"
i_showLabels = input.bool(true, "Show Level Labels", group=grp_lb)
i_labelSize = input.string("Small", "Label Size", options=["Tiny","Small","Normal","Huge"], group=grp_lb)
i_labelOffset = input.int(12, "Label Offset (bars)", minval=0, maxval=50, group=grp_lb)
i_lineOffset = input.int(10, "Line Offset (bars)", minval=0, maxval=50, group=grp_lb)


grp_c = "═══════ Colors ═══════"
i_londonColor = input.color(#ef4444, "London Levels", group=grp_c)
i_asiaColor = input.color(#3b82f6, "Asia Levels", group=grp_c)
i_intradayColor = input.color(#10b981, "Intraday Levels", group=grp_c)
i_overnightColor = input.color(#f59e0b, "Overnight Levels", group=grp_c)
i_priorColor = input.color(#f97316, "Prior Day Levels", group=grp_c)
i_sigmaUpColor = input.color(#16a34a, "Sigma Upside", group=grp_c)
i_sigmaDnColor = input.color(#dc2626, "Sigma Downside", group=grp_c)

grp_b = "═══════ Session Boxes ═══════"
i_showBoxes = input.bool(true, "Show Session Boxes", group=grp_b)
i_boxTransp = input.int(93, "Box Transparency", minval=80, maxval=98, group=grp_b)

grp_r = "═══════ Range Stats ═══════"
i_rangeLookback = input.int(50, "Range Percentile Lookback", minval=5, maxval=100, group=grp_r)

// ─── COMPREHENSIVE THEME SYSTEM ──────────────────────────────────────────────

type ThemePalette
    color bg_primary
    color bg_secondary
    color bg_border
    color text_primary
    color text_secondary
    color text_dim
    color asia_primary
    color london_primary
    color ny_primary
    color overnight_primary
    color prior_primary
    color bullish
    color bearish
    color neutral
    color caution
    color confirm
    color header_bg
    color header_text
    color validated_bg
    color validated_text
    color pending_bg
    color pending_text
    color skip_bg
    color skip_text
    int line_transp_primary
    int line_transp_secondary
    int label_transp

getDarkPalette() =>
    ThemePalette.new(
        bg_primary = color.new(#0f172a, 0),
        bg_secondary = color.new(#1e293b, 0),
        bg_border = color.new(#334155, 60),
        text_primary = color.new(#f1f5f9, 0),
        text_secondary = color.new(#cbd5e1, 0),
        text_dim = color.new(#94a3b8, 0),
        asia_primary = color.new(#0ea5e9, 0),
        london_primary = color.new(#ef4444, 0),
        ny_primary = color.new(#10b981, 0),
        overnight_primary = color.new(#f59e0b, 0),
        prior_primary = color.new(#f97316, 0),
        bullish = color.new(#22c55e, 0),
        bearish = color.new(#ef4444, 0),
        neutral = color.new(#6b7280, 0),
        caution = color.new(#f59e0b, 0),
        confirm = color.new(#8b5cf6, 0),
        header_bg = color.new(#1e3a5f, 0),
        header_text = color.new(#60a5fa, 0),
        validated_bg = color.new(#166534, 0),
        validated_text = color.new(#dcfce7, 0),
        pending_bg = color.new(#92400e, 0),
        pending_text = color.new(#fef3c7, 0),
        skip_bg = color.new(#7f1d1d, 0),
        skip_text = color.new(#fecaca, 0),
        line_transp_primary = 25,
        line_transp_secondary = 40,
        label_transp = 0
    )

getLightPalette() =>
    ThemePalette.new(
        bg_primary = color.new(#ffffff, 0),
        bg_secondary = color.new(#f8fafc, 0),
        bg_border = color.new(#cbd5e1, 60),
        text_primary = color.new(#0f172a, 0),
        text_secondary = color.new(#475569, 0),
        text_dim = color.new(#78716c, 0),
        asia_primary = color.new(#0369a1, 0),
        london_primary = color.new(#dc2626, 0),
        ny_primary = color.new(#059669, 0),
        overnight_primary = color.new(#d97706, 0),
        prior_primary = color.new(#ea580c, 0),
        bullish = color.new(#16a34a, 0),
        bearish = color.new(#dc2626, 0),
        neutral = color.new(#6b7280, 0),
        caution = color.new(#ea580c, 0),
        confirm = color.new(#7c3aed, 0),
        header_bg = color.new(#e0f2fe, 0),
        header_text = color.new(#0369a1, 0),
        validated_bg = color.new(#dcfce7, 0),
        validated_text = color.new(#166534, 0),
        pending_bg = color.new(#fef3c7, 0),
        pending_text = color.new(#92400e, 0),
        skip_bg = color.new(#fee2e2, 0),
        skip_text = color.new(#991b1b, 0),
        line_transp_primary = 35,
        line_transp_secondary = 50,
        label_transp = 0
    )

isDarkTheme = i_theme == "Dark" or (i_theme == "Auto")

getCurrentPalette() =>
    isDarkTheme ? getDarkPalette() : getLightPalette()

// ─── TICKER DETECTION ────────────────────────────────────────────────────────

r = syminfo.root
is_nq  = str.contains(r,"NQ") or str.contains(r,"MNQ")
is_es  = str.contains(r,"ES") or str.contains(r,"MES")
is_rty = str.contains(r,"RTY") or str.contains(r,"M2K")
is_ym  = str.contains(r,"YM") or str.contains(r,"MYM")
is_cl  = str.contains(r,"CL") or str.contains(r,"MCL")
is_gc  = str.contains(r,"GC") or str.contains(r,"MGC")

// NEW: Commodity flag for different logic
is_commodity = is_cl or is_gc

// ─── TIME HELPERS ────────────────────────────────────────────────────────────

curH = hour(time, i_tz)
curM = minute(time, i_tz)
hhmm = curH * 100 + curM
curDay = dayofmonth(time, i_tz)
curDOW = dayofweek(time, i_tz)

getSz(string s) =>
    switch s
        "Tiny" => size.tiny
        "Small" => size.small
        "Huge" => size.huge
        "Normal" => size.normal

getLineStyle(string s) =>
    switch s
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

getPos(string s) =>
    switch s
        "Top Left" => position.top_left
        "Top Right" => position.top_right
        "Bottom Left" => position.bottom_left
        => position.bottom_right

// ─── SESSION DETECTION ───────────────────────────────────────────────────────
                                        // Lucy's ranges
inAsia   = hhmm >= 1930 or hhmm < 230   //  2000 and 0200
inLondon = hhmm >= 230 and hhmm < 800  // 0200 and 0800  
inPreMkt = hhmm >= 800 and hhmm < 930
inNYAM   = hhmm >= 930 and hhmm < 1200
inLunch  = hhmm >= 1200 and hhmm < 1330
inNYPM   = hhmm >= 1330 and hhmm < 1600

string curSession = inAsia ? "ASIA" : inLondon ? "LONDON" : inPreMkt ? "PRE-MKT" : inNYAM ? "NY AM" : inLunch ? "LUNCH" : inNYPM ? "NY PM" : "CLOSED"

var int lastDay = -1
isNewDay = false
if hhmm >= 1700 and hhmm < 1801 and curDay != lastDay
    isNewDay := true
    lastDay := curDay

// ─── SESSION TRACKING ────────────────────────────────────────────────────────

var float asiaH = na, var float asiaL = na
var float lonH = na, var float lonL = na, var float lonMid = na
var float amH = na, var float amL = na, var float amMid = na
var float lunchH = na, var float lunchL = na, var float lunchMid = na
var float pmH = na, var float pmL = na
var float onH = na, var float onL = na, var float onMid = na
var float p12H = na, var float p12L = na
var float h78H = na, var float h78L = na
var float glxOpen = na, var float mnOpen = na, var float o730 = na
var float rthOpen = na, var float pmOpen = na
var int asiaBar0 = na, var int lonBar0 = na, var int amBar0 = na

// NEW: Gap tracking
var float rthGap = na
var string gapDir = "—"
var bool gapChasing = false
var float gapPts = na

// NEW: London sweep order tracking (for Judas detection)
var int lonHighTime = na
var int lonLowTime = na
var int lonHighFirst = 0  // 0=unknown, 1=high first, -1=low first
var bool isJudas = false

// Daily high/low tracking
var float dayH = na, var float dayL = na
var int dayHHour = na, var int dayHMin = na
var int dayLHour = na, var int dayLMin = na

// Range tracking arrays
var array<float> asiaRanges = array.new_float()
var array<float> londonRanges = array.new_float()
var array<float> nyRanges = array.new_float()

// Daily data
[pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)

// Resets
if isNewDay
    asiaH := na, asiaL := na
    lonH := na, lonL := na, lonMid := na
    amH := na, amL := na, amMid := na
    lunchH := na, lunchL := na, lunchMid := na
    pmH := na, pmL := na
    onH := na, onL := na, onMid := na
    p12H := na, p12L := na
    h78H := na, h78L := na
    glxOpen := open, mnOpen := na, o730 := na
    rthOpen := na, pmOpen := na
    asiaBar0 := na, lonBar0 := na, amBar0 := na
    dayH := na, dayL := na
    dayHHour := na, dayHMin := na
    dayLHour := na, dayLMin := na
    // NEW: Reset gap and Judas tracking
    rthGap := na
    gapDir := "—"
    gapChasing := false
    gapPts := na
    lonHighTime := na
    lonLowTime := na
    lonHighFirst := 0  // Reset to unknown
    isJudas := false

// Track Asia
if inAsia
    if na(asiaBar0)
        asiaBar0 := bar_index
    asiaH := na(asiaH) ? high : math.max(asiaH, high)
    asiaL := na(asiaL) ? low  : math.min(asiaL, low)

if not inAsia and inAsia[1] and not na(asiaH) and not na(asiaL)
    asiaRng = asiaH - asiaL
    asiaRanges.push(asiaRng)
    if asiaRanges.size() > i_rangeLookback
        asiaRanges.shift()

// Track London with sweep order
if inLondon
    if na(lonBar0)
        lonBar0 := bar_index
    
    // Track WHEN London first sweeps each Asia level
    if not na(asiaH) and high > asiaH and na(lonHighTime)
        lonHighTime := time
    if not na(asiaL) and low < asiaL and na(lonLowTime)
        lonLowTime := time
    
    lonH := na(lonH) ? high : math.max(lonH, high)
    lonL := na(lonL) ? low  : math.min(lonL, low)
    lonMid := (lonH + lonL) / 2.0

// At London close, determine sweep order
if not inLondon and inLondon[1] and not na(lonH) and not na(lonL)
    lonRng = lonH - lonL
    londonRanges.push(lonRng)
    if londonRanges.size() > i_rangeLookback
        londonRanges.shift()
    
    // Determine high-first vs low-first (1=high first, -1=low first, 0=unknown)
    if not na(lonHighTime) and not na(lonLowTime)
        lonHighFirst := lonHighTime < lonLowTime ? 1 : -1
    else if not na(lonHighTime) and na(lonLowTime)
        lonHighFirst := 1
    else if na(lonHighTime) and not na(lonLowTime)
        lonHighFirst := -1
    else
        lonHighFirst := 0

// Track NY AM
if inNYAM
    if na(amBar0)
        amBar0 := bar_index
    amH := na(amH) ? high : math.max(amH, high)
    amL := na(amL) ? low  : math.min(amL, low)
    amMid := (amH + amL) / 2.0

if inLunch
    lunchH := na(lunchH) ? high : math.max(lunchH, high)
    lunchL := na(lunchL) ? low  : math.min(lunchL, low)
    lunchMid := (lunchH + lunchL) / 2.0

if inNYPM
    pmH := na(pmH) ? high : math.max(pmH, high)
    pmL := na(pmL) ? low  : math.min(pmL, low)

is_4pm = hhmm >= 1600 and hhmm < 1615
if is_4pm and not is_4pm[1] and not na(amH) and not na(pmL)
    nyRng = math.max(amH, nz(pmH, amH)) - math.min(amL, nz(pmL, amL))
    nyRanges.push(nyRng)
    if nyRanges.size() > i_rangeLookback
        nyRanges.shift()

if hhmm >= 1800 or hhmm < 930
    onH := na(onH) ? high : math.max(onH, high)
    onL := na(onL) ? low  : math.min(onL, low)
    onMid := (onH + onL) / 2.0

if curH == 7
    h78H := na(h78H) ? high : math.max(h78H, high)
    h78L := na(h78L) ? low  : math.min(h78L, low)

if curH == 0 and curM == 0 and na(mnOpen)
    mnOpen := open
if curH == 7 and curM == 30 and na(o730)
    o730 := open
if curH == 9 and curM == 30 and na(rthOpen)
    rthOpen := open
    // NEW: Calculate RTH gap
    rthGap := open - pdC
    gapPts := math.abs(rthGap)
    gapDir := rthGap > 5 ? "UP" : rthGap < -5 ? "DOWN" : "FLAT"
    
if curH == 13 and curM == 30 and na(pmOpen)
    pmOpen := open

// Daily H/L tracking
if hhmm >= 1800 or hhmm < 1600
    if na(dayH) or high > dayH
        dayH := high
        dayHHour := hour(time, i_tz)
        dayHMin := minute(time, i_tz)
    if na(dayL) or low < dayL
        dayL := low
        dayLHour := hour(time, i_tz)
        dayLMin := minute(time, i_tz)

// ─── PERCENTILE CALCULATION ──────────────────────────────────────────────────

pctRank(float val, array<float> arr) =>
    if arr.size() < 2 or na(val)
        50.0
    else
        int below = 0
        for i = 0 to arr.size() - 1
            if arr.get(i) < val
                below += 1
        float(below) / float(arr.size()) * 100.0

float asiaPctl = not na(asiaH) and not na(asiaL) ? pctRank(asiaH - asiaL, asiaRanges) : na
float lonPctl = not na(lonH) and not na(lonL) ? pctRank(lonH - lonL, londonRanges) : na
float nyRng = not na(amH) and not na(amL) ? math.max(amH, nz(pmH, amH)) - math.min(amL, nz(pmL, amL)) : na
float nyPctl = not na(nyRng) ? pctRank(nyRng, nyRanges) : na

// NEW: Asia size classification
string asiaSize = na(asiaPctl) ? "—" : asiaPctl < 25 ? "SMALL" : asiaPctl < 50 ? "MED" : asiaPctl < 75 ? "MED-LG" : "LARGE"

// NEW: London size classification
string londonSize = na(lonPctl) ? "—" : lonPctl < 25 ? "SMALL" : lonPctl < 50 ? "MED" : lonPctl < 75 ? "MED-LG" : "LARGE"

// ─── CLASSIFICATION ──────────────────────────────────────────────────────────

var string pattern = "—"
var string manipulation = "NONE"
var string nyPos = "—"
var string bias = "WAITING"
var float biasPct = 0.0
var bool isAligned = false
var bool isMisaligned = false

if not na(lonH) and not na(asiaH) and not na(asiaL)
    bool sweptH = lonH > asiaH
    bool sweptL = lonL < asiaL
    if sweptH and not sweptL
        pattern := "PARTIAL UP"
        manipulation := "BEARISH"
    else if sweptL and not sweptH
        pattern := "PARTIAL DN"
        manipulation := "BULLISH"
    else if sweptH and sweptL
        pattern := "ENGULFS"
        manipulation := close > (asiaH + asiaL) / 2.0 ? "BEARISH" : "BULLISH"
    else
        pattern := "INSIDE"
        manipulation := "NONE"
    
    // NEW: Judas detection - fake one direction, then commit opposite
    // lonHighFirst: 1=high first, -1=low first, 0=unknown
    if manipulation == "BULLISH" and lonHighFirst == 1
        isJudas := true  // Faked up first, then swept low (bullish)
    else if manipulation == "BEARISH" and lonHighFirst == -1
        isJudas := true  // Faked down first, then swept high (bearish)
    else
        isJudas := false

if not na(lonMid)
    nyPos := close > lonMid ? "ABOVE" : "BELOW"

// NEW: Gap confluence calculation
if manipulation == "BULLISH" and gapDir == "UP"
    gapChasing := true
else if manipulation == "BEARISH" and gapDir == "DOWN"
    gapChasing := true
else
    gapChasing := false

// ─── 72-SCENARIO PROBABILITY LOOKUP (NEW) ────────────────────────────────────

// Full decision tree: Pattern × Position × Asia Size × London Size
get72ScenarioProb(string pat, string pos, string aSz, string lSz) =>
    float result = 50.0
    
    // Base probabilities from research
    if is_nq
        // ALIGNED SETUPS
        if (pat == "PARTIAL DN" and pos == "ABOVE") or (pat == "PARTIAL UP" and pos == "BELOW")
            // Start with aligned base
            result := 84.0
            
            // Asia size adjustment (±6%)
            if aSz == "SMALL"
                result += 4.0  // 88%
            else if aSz == "MED"
                result -= 2.0  // 82%
            else if aSz == "LARGE" or aSz == "MED-LG"
                result -= 6.0  // 78%
            
            // London size adjustment (±5%)
            if lSz == "SMALL"
                result += 3.0
            else if lSz == "LARGE" or lSz == "MED-LG"
                result -= 5.0
        
        // MISALIGNED SETUPS
        else if (pat == "PARTIAL DN" and pos == "BELOW") or (pat == "PARTIAL UP" and pos == "ABOVE")
            result := 52.0  // Base misaligned
            // Asia/London don't help misaligned setups much
            if aSz == "SMALL"
                result += 2.0
            if lSz == "SMALL"
                result += 2.0
        
        // ENGULFS
        else if pat == "ENGULFS"
            if pos == "ABOVE"
                result := 68.0
            else
                result := 66.0
            if aSz == "SMALL"
                result += 3.0
            if lSz == "LARGE"
                result -= 4.0
        
        // INSIDE (no manipulation)
        else if pat == "INSIDE"
            result := 50.0  // No edge
    
    else if is_es
        if (pat == "PARTIAL DN" and pos == "ABOVE") or (pat == "PARTIAL UP" and pos == "BELOW")
            result := 82.0
            if aSz == "SMALL"
                result += 4.0
            else if aSz == "LARGE"
                result -= 5.0
            if lSz == "SMALL"
                result += 2.0
            else if lSz == "LARGE" or lSz == "MED-LG"
                result -= 4.0
        else if (pat == "PARTIAL DN" and pos == "BELOW") or (pat == "PARTIAL UP" and pos == "ABOVE")
            result := 51.0
            if aSz == "SMALL"
                result += 2.0
        else if pat == "ENGULFS"
            result := pos == "ABOVE" ? 66.0 : 64.0
            if aSz == "SMALL"
                result += 2.0
        else
            result := 50.0
    
    else if is_rty
        if (pat == "PARTIAL DN" and pos == "ABOVE") or (pat == "PARTIAL UP" and pos == "BELOW")
            result := 80.0
            if aSz == "SMALL"
                result += 4.0
            else if aSz == "LARGE"
                result -= 4.0
            if lSz == "SMALL"
                result += 2.0
            else if lSz == "LARGE"
                result -= 3.0
        else if (pat == "PARTIAL DN" and pos == "BELOW") or (pat == "PARTIAL UP" and pos == "ABOVE")
            result := 50.0
            if aSz == "SMALL"
                result += 2.0
        else if pat == "ENGULFS"
            result := pos == "ABOVE" ? 64.0 : 62.0
            if aSz == "SMALL"
                result += 2.0
        else
            result := 50.0
    
    else if is_ym
        if (pat == "PARTIAL DN" and pos == "ABOVE") or (pat == "PARTIAL UP" and pos == "BELOW")
            result := 81.0
            if aSz == "SMALL"
                result += 4.0
            else if aSz == "LARGE"
                result -= 5.0
            if lSz == "SMALL"
                result += 2.0
            else if lSz == "LARGE"
                result -= 4.0
        else if (pat == "PARTIAL DN" and pos == "BELOW") or (pat == "PARTIAL UP" and pos == "ABOVE")
            result := 51.0
            if aSz == "SMALL"
                result += 2.0
        else if pat == "ENGULFS"
            result := pos == "ABOVE" ? 65.0 : 63.0
            if aSz == "SMALL"
                result += 2.0
        else
            result := 50.0
    
    // COMMODITIES: Different model - trade WITH London, not against
    else if is_cl
        // CL trades WITH manipulation (continuation model)
        if manipulation == "BULLISH"
            result := pos == "ABOVE" ? 58.0 : 46.0
            if aSz == "SMALL"
                result += 3.0
        else if manipulation == "BEARISH"
            result := pos == "BELOW" ? 57.0 : 45.0
            if aSz == "SMALL"
                result += 3.0
        else
            result := 50.0
    
    else if is_gc
        // GC trades WITH manipulation (continuation model)
        if manipulation == "BULLISH"
            result := pos == "ABOVE" ? 56.0 : 47.0
            if aSz == "SMALL"
                result += 2.0
        else if manipulation == "BEARISH"
            result := pos == "BELOW" ? 55.0 : 46.0
            if aSz == "SMALL"
                result += 2.0
        else
            result := 50.0
    
    result

// ─── ADJUSTMENT FACTORS (NEW) ────────────────────────────────────────────────

// Day of week adjustment
getDOWAdjust() =>
    float adj = 1.0
    if curDOW == dayofweek.tuesday
        adj := 1.05
    else if curDOW == dayofweek.wednesday
        adj := 1.03
    else if curDOW == dayofweek.monday
        adj := 0.96
    else if curDOW == dayofweek.friday
        adj := 0.98
    adj

// Gap confluence adjustment (+18% for chasing)
getGapAdjust() =>
    gapChasing ? 1.12 : 1.0  // Conservative 12% vs full 18%

// Judas adjustment (+10%)
getJudasAdjust() =>
    isJudas ? 1.08 : 1.0

// ─── BIAS CALCULATION (ENHANCED) ─────────────────────────────────────────────

if not na(lonMid) and manipulation != "NONE"
    // Get base probability from 72-scenario lookup
    float baseProb = get72ScenarioProb(pattern, nyPos, asiaSize, londonSize)
    
    // Apply adjustments
    float adjustedProb = baseProb * getDOWAdjust() * getGapAdjust() * getJudasAdjust()
    
    // Cap at reasonable bounds
    adjustedProb := math.min(adjustedProb, 95.0)
    adjustedProb := math.max(adjustedProb, 35.0)
    
    // Determine alignment
    isAligned := (manipulation == "BULLISH" and nyPos == "ABOVE") or 
                 (manipulation == "BEARISH" and nyPos == "BELOW")
    isMisaligned := (manipulation == "BULLISH" and nyPos == "BELOW") or
                     (manipulation == "BEARISH" and nyPos == "ABOVE")
    
    if is_commodity
        // Commodities: trade WITH manipulation
        if manipulation == "BULLISH"
            bias := "LONG (CONT)"
            biasPct := adjustedProb
        else
            bias := "SHORT (CONT)"
            biasPct := adjustedProb
    else
        // Equities: reversal model
        if isAligned
            if manipulation == "BULLISH"
                bias := "LONG"
            else
                bias := "SHORT"
            biasPct := adjustedProb
        else if isMisaligned
            bias := "⚠ SKIP"  // Changed from "WAIT"
            biasPct := adjustedProb  // Show actual low probability
        else
            bias := "NEUTRAL"
            biasPct := 50.0

if manipulation == "NONE"
    bias := "NO SETUP"
    biasPct := 0.0
    isAligned := false
    isMisaligned := false

if isNewDay
    pattern := "—"
    manipulation := "NONE"
    nyPos := "—"
    bias := "WAITING"
    biasPct := 0.0
    isAligned := false
    isMisaligned := false

// ─── SETUP QUALITY SCORE (NEW) ────────────────────────────────────────────────

var int qualityScore = 0
var string qualityTxt = "—"
var string qualityDetails = ""

if not na(lonH) and not na(asiaH) and manipulation != "NONE"
    qualityScore := 0
    qualityDetails := ""
    
    // +2 for aligned setup
    if isAligned
        qualityScore += 2
        qualityDetails += "Aligned+"
    
    // +1 for Judas
    if isJudas
        qualityScore += 1
        qualityDetails += "Judas+"
    
    // +1 for gap chasing
    if gapChasing
        qualityScore += 1
        qualityDetails += "Gap+"
    
    // +1 for Tuesday/Wednesday
    if curDOW == dayofweek.tuesday or curDOW == dayofweek.wednesday
        qualityScore += 1
        qualityDetails += "DOW+"
    
    // +1 for small Asia
    if asiaSize == "SMALL"
        qualityScore += 1
        qualityDetails += "SmAsia+"
    
    // +1 for small London
    if londonSize == "SMALL"
        qualityScore += 1
        qualityDetails += "SmLon+"
    
    // -1 for large London
    if londonSize == "LARGE" or londonSize == "MED-LG"
        qualityScore -= 1
        qualityDetails += "LgLon-"
    
    // -1 for Monday
    if curDOW == dayofweek.monday
        qualityScore -= 1
        qualityDetails += "Mon-"
    
    // -2 for misaligned
    if isMisaligned
        qualityScore -= 2
        qualityDetails += "Misalign-"
    
    // Convert to text
    if qualityScore >= 5
        qualityTxt := "★★★★★"
    else if qualityScore >= 4
        qualityTxt := "★★★★"
    else if qualityScore >= 3
        qualityTxt := "★★★"
    else if qualityScore >= 2
        qualityTxt := "★★"
    else if qualityScore >= 1
        qualityTxt := "★"
    else
        qualityTxt := "—"

