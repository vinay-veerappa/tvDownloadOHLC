// Conditional CBDR sigma probabilities based on manipulation
getCondSigmaProb(string sigma, string manip) =>
    float result = 50.0
    if is_nq
        if sigma == "+1"
            result := manip == "BEARISH" ? 71.4 : manip == "BULLISH" ? 41.2 : 61.0
        else if sigma == "-1"
            result := manip == "BULLISH" ? 73.1 : manip == "BEARISH" ? 43.7 : 56.2
        else if sigma == "+2"
            result := manip == "BEARISH" ? 56.8 : manip == "BULLISH" ? 25.6 : 41.8
        else if sigma == "-2"
            result := manip == "BULLISH" ? 58.3 : manip == "BEARISH" ? 27.2 : 40.7
    else if is_es
        if sigma == "+1"
            result := manip == "BEARISH" ? 69.8 : manip == "BULLISH" ? 39.4 : 59.2
        else if sigma == "-1"
            result := manip == "BULLISH" ? 71.2 : manip == "BEARISH" ? 41.8 : 54.6
        else if sigma == "+2"
            result := manip == "BEARISH" ? 54.1 : manip == "BULLISH" ? 23.8 : 39.4
        else if sigma == "-2"
            result := manip == "BULLISH" ? 55.6 : manip == "BEARISH" ? 25.4 : 38.2
    else if is_rty
        if sigma == "+1"
            result := manip == "BEARISH" ? 68.2 : manip == "BULLISH" ? 40.6 : 58.4
        else if sigma == "-1"
            result := manip == "BULLISH" ? 69.8 : manip == "BEARISH" ? 42.4 : 53.8
        else if sigma == "+2"
            result := manip == "BEARISH" ? 52.4 : manip == "BULLISH" ? 24.9 : 38.6
        else if sigma == "-2"
            result := manip == "BULLISH" ? 54.1 : manip == "BEARISH" ? 26.7 : 37.4
    else if is_ym
        if sigma == "+1"
            result := manip == "BEARISH" ? 70.1 : manip == "BULLISH" ? 40.2 : 59.8
        else if sigma == "-1"
            result := manip == "BULLISH" ? 71.6 : manip == "BEARISH" ? 42.1 : 55.2
        else if sigma == "+2"
            result := manip == "BEARISH" ? 54.8 : manip == "BULLISH" ? 24.2 : 40.1
        else if sigma == "-2"
            result := manip == "BULLISH" ? 56.2 : manip == "BEARISH" ? 25.8 : 38.9
    else if is_cl
        if sigma == "+1"
            result := manip == "BEARISH" ? 62.4 : manip == "BULLISH" ? 44.8 : 54.6
        else if sigma == "-1"
            result := manip == "BULLISH" ? 64.1 : manip == "BEARISH" ? 46.2 : 52.8
        else if sigma == "+2"
            result := manip == "BEARISH" ? 46.8 : manip == "BULLISH" ? 28.4 : 36.2
        else if sigma == "-2"
            result := manip == "BULLISH" ? 48.2 : manip == "BEARISH" ? 29.8 : 35.4
    else if is_gc
        if sigma == "+1"
            result := manip == "BEARISH" ? 59.8 : manip == "BULLISH" ? 46.2 : 52.4
        else if sigma == "-1"
            result := manip == "BULLISH" ? 61.4 : manip == "BEARISH" ? 47.8 : 51.2
        else if sigma == "+2"
            result := manip == "BEARISH" ? 44.2 : manip == "BULLISH" ? 30.1 : 34.8
        else if sigma == "-2"
            result := manip == "BULLISH" ? 45.6 : manip == "BEARISH" ? 31.4 : 33.6
    result

// ─── REVERSAL TIMING (ENHANCED) ──────────────────────────────────────────────

var string timingPhase = "—"
var float timingPct = 0.0
var string timingWarning = ""

if inNYAM or inLunch or inNYPM
    if hhmm >= 930 and hhmm < 1000
        timingPhase := "OPENING"
        timingPct := 60.6
        timingWarning := ""
    else if hhmm >= 1000 and hhmm < 1030
        timingPhase := "MID-MORN"
        timingPct := 12.8
        timingWarning := ""
    else if hhmm >= 1030 and hhmm < 1100
        timingPhase := "LATE-MORN"
        timingPct := 6.8
        timingWarning := "74% complete"
    else if hhmm >= 1100 and hhmm < 1200
        timingPhase := "CLOSING"
        timingPct := 7.3
        timingWarning := "⚠ 81% complete"
    else if hhmm >= 1200 and hhmm < 1330
        timingPhase := "LUNCH"
        timingPct := 5.4
        timingWarning := "⚠ 88% complete"
    else if hhmm >= 1330 and hhmm < 1600
        timingPhase := "PM"
        timingPct := 6.8
        timingWarning := "⚠ MANAGE ONLY"
else
    timingPhase := "—"
    timingPct := 0.0
    timingWarning := ""

// ─── HIT TRACKING ────────────────────────────────────────────────────────────

var bool hitLonH = false, var bool hitLonL = false
var bool hitAsiaH = false, var bool hitAsiaL = false
var bool hitOnMid = false, var bool hit78Mid = false
var bool hitMnOpen = false, var bool hit730 = false
var bool hitOTEBull = false, var bool hitOTEBear = false
var bool hitGlx = false, var bool hitPDC = false
var bool hitPDH = false, var bool hitPDL = false
var bool hitSig1P = false, var bool hitSig1N = false
var bool hitSig2P = false, var bool hitSig2N = false
var bool hitAMH = false, var bool hitAML = false
var bool hitLchH = false, var bool hitLchL = false

// Track if London has closed (levels are finalized)
var bool londonClosed = false
if not inLondon and inLondon[1]
    londonClosed := true
if isNewDay
    londonClosed := false

// Reset all hits at start of pre-market (8:00 AM) to clear previous day's state
if inPreMkt and not inPreMkt[1]
    hitLonH := false, hitLonL := false
    hitAsiaH := false, hitAsiaL := false
    hitOnMid := false, hit78Mid := false
    hitMnOpen := false, hit730 := false
    hitOTEBull := false, hitOTEBear := false
    hitGlx := false, hitPDC := false
    hitPDH := false, hitPDL := false
    hitSig1P := false, hitSig1N := false
    hitSig2P := false, hitSig2N := false
    hitAMH := false, hitAML := false
    hitLchH := false, hitLchL := false

// Also reset at NY AM open (redundant but safe)
if inNYAM and not inNYAM[1]
    hitLonH := false, hitLonL := false
    hitAsiaH := false, hitAsiaL := false
    hitOnMid := false, hit78Mid := false
    hitMnOpen := false, hit730 := false
    hitOTEBull := false, hitOTEBear := false
    hitGlx := false, hitPDC := false
    hitPDH := false, hitPDL := false
    hitSig1P := false, hitSig1N := false
    hitSig2P := false, hitSig2N := false
    hitAMH := false, hitAML := false
    hitLchH := false, hitLchL := false

// Only track hits during NY sessions (after 9:30 AM)
if inNYAM or inLunch or inNYPM or inPreMkt
    // London levels - only track if London has closed
    if londonClosed
        if not na(lonH) and low <= lonH and lonH <= high
            hitLonH := true
        if not na(lonL) and low <= lonL and lonL <= high
            hitLonL := true
    
    if not na(asiaH) and low <= asiaH and asiaH <= high
        hitAsiaH := true
    if not na(asiaL) and low <= asiaL and asiaL <= high
        hitAsiaL := true
    if not na(onMid) and low <= onMid and onMid <= high
        hitOnMid := true
    
    float v78Mid = not na(h78H) and not na(h78L) ? (h78H + h78L) / 2.0 : na
    if not na(v78Mid) and low <= v78Mid and v78Mid <= high
        hit78Mid := true
    
    if not na(mnOpen) and low <= mnOpen and mnOpen <= high
        hitMnOpen := true
    if not na(o730) and low <= o730 and o730 <= high
        hit730 := true
    
    // OTE zones
    float vOTEBull = not na(onH) and not na(onL) ? onL + (onH - onL) * 0.62 : na
    float vOTEBear = not na(onH) and not na(onL) ? onH - (onH - onL) * 0.62 : na
    if not na(vOTEBull) and low <= vOTEBull and vOTEBull <= high
        hitOTEBull := true
    if not na(vOTEBear) and low <= vOTEBear and vOTEBear <= high
        hitOTEBear := true
    
    if not na(glxOpen) and low <= glxOpen and glxOpen <= high
        hitGlx := true
    if not na(pdC) and low <= pdC and pdC <= high
        hitPDC := true
    if not na(pdH) and low <= pdH and pdH <= high
        hitPDH := true
    if not na(pdL) and low <= pdL and pdL <= high
        hitPDL := true
    
    float cbdrR = not na(asiaH) and not na(asiaL) ? asiaH - asiaL : na
    if not na(cbdrR) and cbdrR > 0
        if low <= asiaH + cbdrR and asiaH + cbdrR <= high
            hitSig1P := true
        if low <= asiaL - cbdrR and asiaL - cbdrR <= high
            hitSig1N := true
        if low <= asiaH + 2*cbdrR and asiaH + 2*cbdrR <= high
            hitSig2P := true
        if low <= asiaL - 2*cbdrR and asiaL - 2*cbdrR <= high
            hitSig2N := true
    
    if (inLunch or inNYPM) and not na(amH)
        if low <= amH and amH <= high
            hitAMH := true
        if not na(amL) and low <= amL and amL <= high
            hitAML := true
    
    if inNYPM and not na(lunchH)
        if low <= lunchH and lunchH <= high
            hitLchH := true
        if not na(lunchL) and low <= lunchL and lunchL <= high
            hitLchL := true

// ─── LINE DRAWING ────────────────────────────────────────────────────────────

var line lnLonH = na, var line lnLonL = na, var line lnLonMid = na
var line lnAsiaH = na, var line lnAsiaL = na
var line ln78Mid = na, var line ln730 = na, var line lnMnOpen = na
var line lnOnMid = na, var line lnOTEBull = na, var line lnOTEBear = na
var line lnGlx = na
var line lnPDC = na, var line lnPDH = na, var line lnPDL = na
var line lnSig1P = na, var line lnSig1N = na, var line lnSig2P = na, var line lnSig2N = na
var line lnAMH = na, var line lnAML = na
var line lnLchH = na, var line lnLchL = na

var label lblLonH = na, var label lblLonL = na, var label lblLonMid = na
var label lblAsiaH = na, var label lblAsiaL = na
var label lbl78Mid = na, var label lbl730 = na, var label lblMnOpen = na
var label lblOnMid = na, var label lblOTEBull = na, var label lblOTEBear = na
var label lblGlx = na
var label lblPDC = na, var label lblPDH = na, var label lblPDL = na
var label lblSig1P = na, var label lblSig1N = na, var label lblSig2P = na, var label lblSig2N = na
var label lblAMH = na, var label lblAML = na
var label lblLchH = na, var label lblLchL = na
var label lblDayH = na, var label lblDayL = na

p = getCurrentPalette()
// Draw London levels when London ends
if i_showLevels and i_showLondon and not inLondon and inLondon[1] and not na(lonH)
    line.delete(lnLonH), line.delete(lnLonL), line.delete(lnLonMid)
    label.delete(lblLonH), label.delete(lblLonL), label.delete(lblLonMid)
    
    float pLH = getCondProbLonH(pattern, nyPos)
    float pLL = getCondProbLonL(pattern, nyPos)
    
    lnLonH := line.new(lonBar0, lonH, bar_index + i_lineOffset, lonH, color=color.new(i_londonColor, p.line_transp_primary), style=getLineStyle(i_londonStyle), width=i_londonWidth)
    lnLonL := line.new(lonBar0, lonL, bar_index + i_lineOffset, lonL, color=color.new(i_londonColor, p.line_transp_primary), style=getLineStyle(i_londonStyle), width=i_londonWidth)
    lnLonMid := line.new(lonBar0, lonMid, bar_index + i_lineOffset, lonMid, color=color.new(p.caution, p.line_transp_secondary), style=line.style_dotted, width=1)
    
    if i_showLabels
        lblLonH := label.new(bar_index + i_labelOffset, lonH, str.format("Lon H: {0,number,#.#}%", pLH), style=label.style_none, textcolor=i_londonColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        lblLonL := label.new(bar_index + i_labelOffset, lonL, str.format("Lon L: {0,number,#.#}%", pLL), style=label.style_none, textcolor=i_londonColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        lblLonMid := label.new(bar_index + i_labelOffset, lonMid, "Lon Mid", style=label.style_none, textcolor=p.caution, size=getSz(i_labelSize), text_font_family=font.family_monospace)

// Draw Asia levels when Asia ends
if i_showLevels and i_showAsia and not inAsia and inAsia[1] and not na(asiaH)
    line.delete(lnAsiaH), line.delete(lnAsiaL)
    label.delete(lblAsiaH), label.delete(lblAsiaL)
    
    lnAsiaH := line.new(asiaBar0, asiaH, bar_index + i_lineOffset, asiaH, color=color.new(i_asiaColor, p.line_transp_secondary), style=getLineStyle(i_asiaStyle), width=i_asiaWidth)
    lnAsiaL := line.new(asiaBar0, asiaL, bar_index + i_lineOffset, asiaL, color=color.new(i_asiaColor, p.line_transp_secondary), style=getLineStyle(i_asiaStyle), width=i_asiaWidth)
    
    if i_showLabels
        lblAsiaH := label.new(bar_index + i_labelOffset, asiaH, "Asia H", style=label.style_none, textcolor=i_asiaColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        lblAsiaL := label.new(bar_index + i_labelOffset, asiaL, "Asia L", style=label.style_none, textcolor=i_asiaColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)

// Draw intraday levels at NY open
if i_showLevels and inPreMkt and not inPreMkt[1]
    // 7-8 Mid
    float v78Mid = not na(h78H) and not na(h78L) ? (h78H + h78L) / 2.0 : na
    if i_show78Mid and not na(v78Mid)
        line.delete(ln78Mid), label.delete(lbl78Mid)
        float p78 = getCondProb78Mid(pattern, nyPos)
        ln78Mid := line.new(bar_index, v78Mid, bar_index + i_lineOffset, v78Mid, color=color.new(p.confirm, p.line_transp_primary), style=getLineStyle(i_78Style), width=i_78Width)
        if i_showLabels
            lbl78Mid := label.new(bar_index + i_labelOffset, v78Mid, str.format("78 Mid: {0,number,#.#}%", p78), style=label.style_none, textcolor=p.confirm, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // 07:30 Open
    if i_show730 and not na(o730)
        line.delete(ln730), label.delete(lbl730)
        ln730 := line.new(bar_index, o730, bar_index + i_lineOffset, o730, color=color.new(p.caution, p.line_transp_primary), style=getLineStyle(i_730Style), width=i_730Width)
        if i_showLabels
            lbl730 := label.new(bar_index + i_labelOffset, o730, "07:30: 79.8%", style=label.style_none, textcolor=p.caution, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // Midnight Open
    if i_showMidnight and not na(mnOpen)
        line.delete(lnMnOpen), label.delete(lblMnOpen)
        float pMn = getCondProbMidnight(pattern, nyPos)
        lnMnOpen := line.new(bar_index, mnOpen, bar_index + i_lineOffset, mnOpen, color=color.new(p.text_primary, p.line_transp_secondary), style=getLineStyle(i_mnStyle), width=i_mnWidth)
        if i_showLabels
            lblMnOpen := label.new(bar_index + i_labelOffset, mnOpen, str.format("MN: {0,number,#.#}%", pMn), style=label.style_none, textcolor=p.text_primary, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // ON Mid
    if i_showONMid and not na(onMid)
        line.delete(lnOnMid), label.delete(lblOnMid)
        lnOnMid := line.new(bar_index, onMid, bar_index + i_lineOffset, onMid, color=color.new(p.confirm, p.line_transp_secondary), style=getLineStyle(i_onmStyle), width=i_onmWidth)
        if i_showLabels
            lblOnMid := label.new(bar_index + i_labelOffset, onMid, "ON Mid: 77.6%", style=label.style_none, textcolor=p.confirm, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // OTE Zones
    float vOTEBull = not na(onH) and not na(onL) ? onL + (onH - onL) * 0.62 : na
    float vOTEBear = not na(onH) and not na(onL) ? onH - (onH - onL) * 0.62 : na
    if i_showOTE and not na(vOTEBull)
        line.delete(lnOTEBull), label.delete(lblOTEBull)
        lnOTEBull := line.new(bar_index, vOTEBull, bar_index + i_lineOffset, vOTEBull, color=color.new(p.bullish, p.line_transp_secondary), style=getLineStyle(i_oteStyle), width=i_oteWidth)
        if i_showLabels
            lblOTEBull := label.new(bar_index + i_labelOffset, vOTEBull, "OTE Bull: 78.3%", style=label.style_none, textcolor=p.bullish, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    if i_showOTE and not na(vOTEBear)
        line.delete(lnOTEBear), label.delete(lblOTEBear)
        lnOTEBear := line.new(bar_index, vOTEBear, bar_index + i_lineOffset, vOTEBear, color=color.new(p.bearish, p.line_transp_secondary), style=getLineStyle(i_oteStyle), width=i_oteWidth)
        if i_showLabels
            lblOTEBear := label.new(bar_index + i_labelOffset, vOTEBear, "OTE Bear: 76.1%", style=label.style_none, textcolor=p.bearish, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // Globex Open
    if i_showGlobex and not na(glxOpen)
        line.delete(lnGlx), label.delete(lblGlx)
        lnGlx := line.new(bar_index, glxOpen, bar_index + i_lineOffset, glxOpen, color=color.new(p.neutral, p.line_transp_secondary), style=getLineStyle(i_glxStyle), width=i_glxWidth)
        if i_showLabels
            lblGlx := label.new(bar_index + i_labelOffset, glxOpen, "Globex: 63.9%", style=label.style_none, textcolor=p.neutral, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // Settlement/PDC
    if i_showSettle and not na(pdC)
        line.delete(lnPDC), label.delete(lblPDC)
        lnPDC := line.new(bar_index, pdC, bar_index + i_lineOffset, pdC, color=color.new(i_priorColor, p.line_transp_primary), style=getLineStyle(i_pdcStyle), width=i_pdcWidth)
        if i_showLabels
            lblPDC := label.new(bar_index + i_labelOffset, pdC, "Settlement: 63.6%", style=label.style_none, textcolor=i_priorColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // PDH/PDL
    if i_showPDHL and not na(pdH)
        line.delete(lnPDH), label.delete(lblPDH)
        lnPDH := line.new(bar_index, pdH, bar_index + i_lineOffset, pdH, color=color.new(i_priorColor, p.line_transp_primary), style=getLineStyle(i_pdhlStyle), width=i_pdhlWidth)
        if i_showLabels
            lblPDH := label.new(bar_index + i_labelOffset, pdH, "PDH: 47.1%", style=label.style_none, textcolor=i_priorColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    if i_showPDHL and not na(pdL)
        line.delete(lnPDL), label.delete(lblPDL)
        lnPDL := line.new(bar_index, pdL, bar_index + i_lineOffset, pdL, color=color.new(i_priorColor, p.line_transp_primary), style=getLineStyle(i_pdhlStyle), width=i_pdhlWidth)
        if i_showLabels
            lblPDL := label.new(bar_index + i_labelOffset, pdL, "PDL: 40.0%", style=label.style_none, textcolor=i_priorColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    // CBDR Sigma levels with conditional probabilities (+1σ, -1σ, +2σ, -2σ)
    float cbdrR = not na(asiaH) and not na(asiaL) ? asiaH - asiaL : na
    if i_showSigma and not na(cbdrR) and cbdrR > 0
        float sig1PProb = getCondSigmaProb("+1", manipulation)
        float sig1NProb = getCondSigmaProb("-1", manipulation)
        float sig2PProb = getCondSigmaProb("+2", manipulation)
        float sig2NProb = getCondSigmaProb("-2", manipulation)
        
        line.delete(lnSig1P), label.delete(lblSig1P)
        lnSig1P := line.new(bar_index, asiaH + cbdrR, bar_index + i_lineOffset, asiaH + cbdrR, color=color.new(i_sigmaUpColor, p.line_transp_secondary), style=getLineStyle(i_sigStyle), width=i_sigWidth)
        if i_showLabels
            lblSig1P := label.new(bar_index + i_labelOffset, asiaH + cbdrR, str.format("+1σ: {0,number,#.#}%", sig1PProb), style=label.style_none, textcolor=i_sigmaUpColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        
        line.delete(lnSig1N), label.delete(lblSig1N)
        lnSig1N := line.new(bar_index, asiaL - cbdrR, bar_index + i_lineOffset, asiaL - cbdrR, color=color.new(i_sigmaDnColor, p.line_transp_secondary), style=getLineStyle(i_sigStyle), width=i_sigWidth)
        if i_showLabels
            lblSig1N := label.new(bar_index + i_labelOffset, asiaL - cbdrR, str.format("-1σ: {0,number,#.#}%", sig1NProb), style=label.style_none, textcolor=i_sigmaDnColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        
        line.delete(lnSig2P), label.delete(lblSig2P)
        lnSig2P := line.new(bar_index, asiaH + 2*cbdrR, bar_index + i_lineOffset, asiaH + 2*cbdrR, color=color.new(i_sigmaUpColor, p.line_transp_secondary), style=getLineStyle(i_sigStyle), width=i_sigWidth)
        if i_showLabels
            lblSig2P := label.new(bar_index + i_labelOffset, asiaH + 2*cbdrR, str.format("+2σ: {0,number,#.#}%", sig2PProb), style=label.style_none, textcolor=i_sigmaUpColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        
        line.delete(lnSig2N), label.delete(lblSig2N)
        lnSig2N := line.new(bar_index, asiaL - 2*cbdrR, bar_index + i_lineOffset, asiaL - 2*cbdrR, color=color.new(i_sigmaDnColor, p.line_transp_secondary), style=getLineStyle(i_sigStyle), width=i_sigWidth)
        if i_showLabels
            lblSig2N := label.new(bar_index + i_labelOffset, asiaL - 2*cbdrR, str.format("-2σ: {0,number,#.#}%", sig2NProb), style=label.style_none, textcolor=i_sigmaDnColor, size=getSz(i_labelSize), text_font_family=font.family_monospace)

// Extend lines during NY
if i_showLevels and (inNYAM or inLunch or inNYPM)
    if not na(lnLonH)
        line.set_x2(lnLonH, bar_index + i_lineOffset)
        if i_showLabels and not na(lblLonH)
            label.set_x(lblLonH, bar_index + i_labelOffset)
    if not na(lnLonL)
        line.set_x2(lnLonL, bar_index + i_lineOffset)
        if i_showLabels and not na(lblLonL)
            label.set_x(lblLonL, bar_index + i_labelOffset)
    if not na(lnLonMid)
        line.set_x2(lnLonMid, bar_index + i_lineOffset)
        if i_showLabels and not na(lblLonMid)
            label.set_x(lblLonMid, bar_index + i_labelOffset)
    if not na(lnAsiaH)
        line.set_x2(lnAsiaH, bar_index + i_lineOffset)
        if i_showLabels and not na(lblAsiaH)
            label.set_x(lblAsiaH, bar_index + i_labelOffset)
    if not na(lnAsiaL)
        line.set_x2(lnAsiaL, bar_index + i_lineOffset)
        if i_showLabels and not na(lblAsiaL)
            label.set_x(lblAsiaL, bar_index + i_labelOffset)
    if not na(ln78Mid)
        line.set_x2(ln78Mid, bar_index + i_lineOffset)
        if i_showLabels and not na(lbl78Mid)
            label.set_x(lbl78Mid, bar_index + i_labelOffset)
    if not na(ln730)
        line.set_x2(ln730, bar_index + i_lineOffset)
        if i_showLabels and not na(lbl730)
            label.set_x(lbl730, bar_index + i_labelOffset)
    if not na(lnMnOpen)
        line.set_x2(lnMnOpen, bar_index + i_lineOffset)
        if i_showLabels and not na(lblMnOpen)
            label.set_x(lblMnOpen, bar_index + i_labelOffset)
    if not na(lnOnMid)
        line.set_x2(lnOnMid, bar_index + i_lineOffset)
        if i_showLabels and not na(lblOnMid)
            label.set_x(lblOnMid, bar_index + i_labelOffset)
    if not na(lnOTEBull)
        line.set_x2(lnOTEBull, bar_index + i_lineOffset)
        if i_showLabels and not na(lblOTEBull)
            label.set_x(lblOTEBull, bar_index + i_labelOffset)
    if not na(lnOTEBear)
        line.set_x2(lnOTEBear, bar_index + i_lineOffset)
        if i_showLabels and not na(lblOTEBear)
            label.set_x(lblOTEBear, bar_index + i_labelOffset)
    if not na(lnGlx)
        line.set_x2(lnGlx, bar_index + i_lineOffset)
        if i_showLabels and not na(lblGlx)
            label.set_x(lblGlx, bar_index + i_labelOffset)
    if not na(lnPDC)
        line.set_x2(lnPDC, bar_index + i_lineOffset)
        if i_showLabels and not na(lblPDC)
            label.set_x(lblPDC, bar_index + i_labelOffset)
    if not na(lnPDH)
        line.set_x2(lnPDH, bar_index + i_lineOffset)
        if i_showLabels and not na(lblPDH)
            label.set_x(lblPDH, bar_index + i_labelOffset)
    if not na(lnPDL)
        line.set_x2(lnPDL, bar_index + i_lineOffset)
        if i_showLabels and not na(lblPDL)
            label.set_x(lblPDL, bar_index + i_labelOffset)
    if not na(lnSig1P)
        line.set_x2(lnSig1P, bar_index + i_lineOffset)
        if i_showLabels and not na(lblSig1P)
            label.set_x(lblSig1P, bar_index + i_labelOffset)
    if not na(lnSig1N)
        line.set_x2(lnSig1N, bar_index + i_lineOffset)
        if i_showLabels and not na(lblSig1N)
            label.set_x(lblSig1N, bar_index + i_labelOffset)
    if not na(lnSig2P)
        line.set_x2(lnSig2P, bar_index + i_lineOffset)
        if i_showLabels and not na(lblSig2P)
            label.set_x(lblSig2P, bar_index + i_labelOffset)
    if not na(lnSig2N)
        line.set_x2(lnSig2N, bar_index + i_lineOffset)
        if i_showLabels and not na(lblSig2N)
            label.set_x(lblSig2N, bar_index + i_labelOffset)

// Draw AM H/L at lunch start
if i_showLevels and i_showAM and inLunch and not inLunch[1] and not na(amH)
    line.delete(lnAMH), line.delete(lnAML)
    label.delete(lblAMH), label.delete(lblAML)
    
    lnAMH := line.new(amBar0, amH, bar_index + i_lineOffset, amH, color=color.new(p.bullish, p.line_transp_secondary), style=getLineStyle(i_amStyle), width=i_amWidth)
    lnAML := line.new(amBar0, amL, bar_index + i_lineOffset, amL, color=color.new(p.bearish, p.line_transp_secondary), style=getLineStyle(i_amStyle), width=i_amWidth)
    
    if i_showLabels
        lblAMH := label.new(bar_index + i_labelOffset, amH, "AM H: 38.4%", style=label.style_none, textcolor=p.bullish, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        lblAML := label.new(bar_index + i_labelOffset, amL, "AM L: 31.2%", style=label.style_none, textcolor=p.bearish, size=getSz(i_labelSize), text_font_family=font.family_monospace)

// Draw Lunch H/L at PM start
if i_showLevels and i_showLunch and inNYPM and not inNYPM[1] and not na(lunchH)
    line.delete(lnLchH), line.delete(lnLchL)
    label.delete(lblLchH), label.delete(lblLchL)
    
    lnLchH := line.new(bar_index - 10, lunchH, bar_index + i_lineOffset, lunchH, color=color.new(p.text_dim, p.line_transp_secondary), style=getLineStyle(i_lchStyle), width=i_lchWidth)
    lnLchL := line.new(bar_index - 10, lunchL, bar_index + i_lineOffset, lunchL, color=color.new(p.text_dim, p.line_transp_secondary), style=getLineStyle(i_lchStyle), width=i_lchWidth)
    
    if i_showLabels
        lblLchH := label.new(bar_index + i_labelOffset, lunchH, "Lunch H: 62.1%", style=label.style_none, textcolor=p.text_dim, size=getSz(i_labelSize), text_font_family=font.family_monospace)
        lblLchL := label.new(bar_index + i_labelOffset, lunchL, "Lunch L: 53.2%", style=label.style_none, textcolor=p.text_dim, size=getSz(i_labelSize), text_font_family=font.family_monospace)

// Extend AM/Lunch lines during PM
if i_showLevels and (inLunch or inNYPM)
    if not na(lnAMH)
        line.set_x2(lnAMH, bar_index + i_lineOffset)
        if i_showLabels and not na(lblAMH)
            label.set_x(lblAMH, bar_index + i_labelOffset)
    if not na(lnAML)
        line.set_x2(lnAML, bar_index + i_lineOffset)
        if i_showLabels and not na(lblAML)
            label.set_x(lblAML, bar_index + i_labelOffset)

if i_showLevels and inNYPM
    if not na(lnLchH)
        line.set_x2(lnLchH, bar_index + i_lineOffset)
        if i_showLabels and not na(lblLchH)
            label.set_x(lblLchH, bar_index + i_labelOffset)
    if not na(lnLchL)
        line.set_x2(lnLchL, bar_index + i_lineOffset)
        if i_showLabels and not na(lblLchL)
            label.set_x(lblLchL, bar_index + i_labelOffset)

// Daily H/L labels
if i_showLevels and (hhmm >= 1800 or hhmm < 1600)
    if not na(dayH) and not na(dayHHour) and dayH != dayH[1]
        label.delete(lblDayH)
        timeStr = str.format("{0,number,00}:{1,number,00}", dayHHour, dayHMin)
        lblDayH := label.new(time, dayH, xloc=xloc.bar_time, text=str.format("{0,number,#.#} ({1})", dayH, timeStr), style=label.style_label_down, textcolor=p.bullish, color=color.new(p.bullish, 80), size=getSz(i_labelSize), text_font_family=font.family_monospace)
    
    if not na(dayL) and not na(dayLHour) and dayL != dayL[1]
        label.delete(lblDayL)
        timeStr = str.format("{0,number,00}:{1,number,00}", dayLHour, dayLMin)
        lblDayL := label.new(time, dayL, xloc=xloc.bar_time, text=str.format("{0,number,#.#} ({1})", dayL, timeStr), style=label.style_label_up, textcolor=p.bearish, color=color.new(p.bearish, 80), size=getSz(i_labelSize), text_font_family=font.family_monospace)

// ─── SESSION BOXES ───────────────────────────────────────────────────────────

var box asiaBox = na, var box lonBox = na

if i_showBoxes
    if inAsia and not na(asiaH)
        box.delete(asiaBox)
        asiaBox := box.new(nz(asiaBar0, bar_index), asiaH, bar_index, asiaL, border_color=color.new(p.asia_primary, 50), bgcolor=color.new(p.asia_primary, 93), border_width=1)
    if inLondon and not na(lonH)
        box.delete(lonBox)
        lonBox := box.new(nz(lonBar0, bar_index), lonH, bar_index, lonL, border_color=color.new(p.london_primary, 50), bgcolor=color.new(p.london_primary, 93), border_width=1)

// ─── DASHBOARD (ENHANCED) ────────────────────────────────────────────────────

probClr(float prob) => prob >= 75 ? color.new(#16a34a, 0) : prob >= 60 ? color.new(#f59e0b, 0) : color.new(#6b7280, 0)

var table tbl = na

if i_showDash and barstate.islast
    if not na(tbl)
        table.delete(tbl)
    
    tbl := table.new(getPos(i_dashPos), 3, 55, bgcolor=color.new(p.bg_primary, i_dashOpacity), border_width=1, border_color=p.bg_border)
    sz = getSz(i_dashSz)
    
    int row = 0
    
    // Header with version
    table.cell(tbl, 0, row, "PROB ENGINE", text_color=p.header_text, bgcolor=p.header_bg, text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    // Session and ticker
    sesClr = inNYAM ? p.ny_primary : inLondon ? p.london_primary : inAsia ? p.asia_primary : inNYPM ? p.caution : p.neutral
    table.cell(tbl, 0, row, "Session", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, curSession, text_color=sesClr, bgcolor=p.bg_secondary, text_size=sz)
    commodityNote = is_commodity ? " (CONT)" : ""
    table.cell(tbl, 2, row, syminfo.root + commodityNote, text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // Pattern and manipulation
    patClr = manipulation == "BULLISH" ? p.bullish : manipulation == "BEARISH" ? p.bearish : p.neutral
    table.cell(tbl, 0, row, "Pattern", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, pattern, text_color=patClr, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, manipulation, text_color=patClr, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // NEW: Judas indicator
    if lonHighFirst != 0
        judasClr = isJudas ? p.bullish : p.text_dim
        judasTxt = isJudas ? "✓ JUDAS" : "Standard"
        sweepOrder = lonHighFirst == 1 ? "H→L" : "L→H"
        table.cell(tbl, 0, row, "Sweep", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, sweepOrder, text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, judasTxt, text_color=judasClr, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    // BIAS with enhanced coloring for SKIP
    biasClr = bias == "LONG" or bias == "LONG (CONT)" ? p.bullish : bias == "SHORT" or bias == "SHORT (CONT)" ? p.bearish : bias == "⚠ SKIP" ? p.skip_text : bias == "WAIT" ? p.caution : p.neutral
    biasBg = bias == "⚠ SKIP" ? p.skip_bg : p.bg_secondary
    table.cell(tbl, 0, row, "BIAS", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, bias, text_color=biasClr, bgcolor=biasBg, text_size=sz)
    probTxt = biasPct > 0 ? str.tostring(biasPct, "#.0") + "%" : "—"
    table.cell(tbl, 2, row, probTxt, text_color=probClr(biasPct), bgcolor=biasBg, text_size=sz)
    row += 1
    
    // NEW: Setup Quality Score
    table.cell(tbl, 0, row, "Quality", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    qualityClr = qualityScore >= 4 ? p.bullish : qualityScore >= 2 ? p.caution : p.neutral
    table.cell(tbl, 1, row, qualityTxt, text_color=qualityClr, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, str.tostring(qualityScore) + " pts", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // NEW: Gap Confluence
    if gapDir != "—"
        gapClr = gapChasing ? p.bullish : p.neutral
        gapLabel = gapChasing ? "CHASE +" : "FADE"
        table.cell(tbl, 0, row, "Gap", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, gapDir + " " + str.tostring(gapPts, "#") + "pt", text_color=gapDir == "UP" ? p.bullish : gapDir == "DOWN" ? p.bearish : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, gapLabel, text_color=gapClr, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    // Timing with warning
    if timingPct > 0
        table.cell(tbl, 0, row, "Timing", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, timingPhase, text_color=p.confirm, bgcolor=p.bg_secondary, text_size=sz)
        warnClr = str.contains(timingWarning, "⚠") ? p.caution : p.text_dim
        table.cell(tbl, 2, row, timingWarning != "" ? timingWarning : str.tostring(timingPct, "#.0") + "%", text_color=warnClr, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    
   // ── RANGES SECTION ──
    table.cell(tbl, 0, row, "── RANGES ──", text_color=p.asia_primary, bgcolor=color.new(p.asia_primary, 85), text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    // Asia range
    if not na(asiaH) and not na(asiaL)
        float aRng = asiaH - asiaL
        table.cell(tbl, 0, row, "Asia", text_color=p.asia_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(aRng, "#.0") + " pts", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, asiaSize + " " + (na(asiaPctl) ? "" : str.tostring(asiaPctl, "#") + "th"), text_color=asiaSize == "SMALL" ? p.bullish : asiaSize == "LARGE" ? p.bearish : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    // London range
    if not na(lonH) and not na(lonL)
        float lRng = lonH - lonL
        table.cell(tbl, 0, row, "London", text_color=p.london_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(lRng, "#.0") + " pts", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, londonSize + " " + (na(lonPctl) ? "" : str.tostring(lonPctl, "#") + "th"), text_color=londonSize == "SMALL" ? p.bullish : londonSize == "LARGE" ? p.bearish : p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    // NY range
    if not na(nyRng)
        table.cell(tbl, 0, row, "NY", text_color=p.ny_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(nyRng, "#.0") + " pts", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, na(nyPctl) ? "(live)" : str.tostring(nyPctl, "#") + "th", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
        
    dowNames = array.from("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")
    dowClr = curDOW == dayofweek.tuesday or curDOW == dayofweek.wednesday ? p.bullish : curDOW == dayofweek.monday ? p.bearish : p.neutral
    table.cell(tbl, 0, row, "DOW", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, array.get(dowNames, curDOW - 1), text_color=dowClr, bgcolor=p.bg_secondary, text_size=sz)
    dowNote = curDOW == dayofweek.tuesday ? "+5%" : curDOW == dayofweek.wednesday ? "+3%" : curDOW == dayofweek.monday ? "-4%" : "—"
    table.cell(tbl, 2, row, dowNote, text_color=dowClr, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // ── NY LEVELS ──
    table.cell(tbl, 0, row, "── NY LEVELS ──", text_color=p.confirm, bgcolor=color.new(p.confirm, 85), text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    // Level headers
    table.cell(tbl, 0, row, "Level", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 1, row, "Hit %", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    table.cell(tbl, 2, row, "Status", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
    row += 1
    
    // 7-8 Mid
    float v78 = not na(h78H) and not na(h78L) ? (h78H + h78L) / 2 : na
    if not na(v78)
        float p78 = getCondProb78Mid(pattern, nyPos)
        table.cell(tbl, 0, row, "7-8 Mid", text_color=p.confirm, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(p78, "#.0") + "%", text_color=probClr(p78), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hit78Mid ? p.validated_bg : p.pending_bg
        hitTxt = hit78Mid ? p.validated_text : p.pending_text
        hitLbl = hit78Mid ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // 07:30 Open
    if not na(o730)
        table.cell(tbl, 0, row, "07:30", text_color=p.caution, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "79.8%", text_color=probClr(79.8), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hit730 ? p.validated_bg : p.pending_bg
        hitTxt = hit730 ? p.validated_text : p.pending_text
        hitLbl = hit730 ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // OTE Bull
    float vOTEBull = not na(onH) and not na(onL) ? onL + (onH - onL) * 0.62 : na
    if not na(vOTEBull) and i_showOTE
        table.cell(tbl, 0, row, "OTE Bull", text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "78.3%", text_color=probClr(78.3), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitOTEBull ? p.validated_bg : p.pending_bg
        hitTxt = hitOTEBull ? p.validated_text : p.pending_text
        hitLbl = hitOTEBull ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // ON Mid
    if not na(onMid)
        table.cell(tbl, 0, row, "ON Mid", text_color=p.confirm, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "77.6%", text_color=probClr(77.6), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitOnMid ? p.validated_bg : p.pending_bg
        hitTxt = hitOnMid ? p.validated_text : p.pending_text
        hitLbl = hitOnMid ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // London H
    if not na(lonH)
        float pLH = getCondProbLonH(pattern, nyPos)
        table.cell(tbl, 0, row, "Lon H", text_color=p.london_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(pLH, "#.0") + "%", text_color=probClr(pLH), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitLonH ? p.validated_bg : p.pending_bg
        hitTxt = hitLonH ? p.validated_text : p.pending_text
        hitLbl = hitLonH ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // London L
    if not na(lonL)
        float pLL = getCondProbLonL(pattern, nyPos)
        table.cell(tbl, 0, row, "Lon L", text_color=p.london_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(pLL, "#.0") + "%", text_color=probClr(pLL), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitLonL ? p.validated_bg : p.pending_bg
        hitTxt = hitLonL ? p.validated_text : p.pending_text
        hitLbl = hitLonL ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // Settlement
    if not na(pdC)
        table.cell(tbl, 0, row, "Settlement", text_color=i_priorColor, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "63.6%", text_color=probClr(63.6), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitPDC ? p.validated_bg : p.pending_bg
        hitTxt = hitPDC ? p.validated_text : p.pending_text
        hitLbl = hitPDC ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // Globex
    if not na(glxOpen)
        table.cell(tbl, 0, row, "Globex", text_color=p.neutral, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "63.9%", text_color=probClr(63.9), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitGlx ? p.validated_bg : p.pending_bg
        hitTxt = hitGlx ? p.validated_text : p.pending_text
        hitLbl = hitGlx ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // MN Open
    if not na(mnOpen)
        float pMn = getCondProbMidnight(pattern, nyPos)
        table.cell(tbl, 0, row, "MN Open", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(pMn, "#.0") + "%", text_color=probClr(pMn), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitMnOpen ? p.validated_bg : p.pending_bg
        hitTxt = hitMnOpen ? p.validated_text : p.pending_text
        hitLbl = hitMnOpen ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // PDH
    if not na(pdH)
        table.cell(tbl, 0, row, "PDH", text_color=i_priorColor, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "47.1%", text_color=probClr(47.1), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitPDH ? p.validated_bg : p.pending_bg
        hitTxt = hitPDH ? p.validated_text : p.pending_text
        hitLbl = hitPDH ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // PDL
    if not na(pdL)
        table.cell(tbl, 0, row, "PDL", text_color=i_priorColor, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "40.0%", text_color=probClr(40.0), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitPDL ? p.validated_bg : p.pending_bg
        hitTxt = hitPDL ? p.validated_text : p.pending_text
        hitLbl = hitPDL ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // Sigma levels (+1, -1, +2, -2)
    float cbdrR = not na(asiaH) and not na(asiaL) ? asiaH - asiaL : na
    if not na(cbdrR) and cbdrR > 0
        float sig1PProb = getCondSigmaProb("+1", manipulation)
        table.cell(tbl, 0, row, "+1σ", text_color=i_sigmaUpColor, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(sig1PProb, "#.0") + "%", text_color=probClr(sig1PProb), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitSig1P ? p.validated_bg : p.pending_bg
        hitTxt = hitSig1P ? p.validated_text : p.pending_text
        hitLbl = hitSig1P ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
        
        float sig1NProb = getCondSigmaProb("-1", manipulation)
        table.cell(tbl, 0, row, "-1σ", text_color=i_sigmaDnColor, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(sig1NProb, "#.0") + "%", text_color=probClr(sig1NProb), bgcolor=p.bg_secondary, text_size=sz)
        hitBg := hitSig1N ? p.validated_bg : p.pending_bg
        hitTxt := hitSig1N ? p.validated_text : p.pending_text
        hitLbl := hitSig1N ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
        
        float sig2PProb = getCondSigmaProb("+2", manipulation)
        table.cell(tbl, 0, row, "+2σ", text_color=i_sigmaUpColor, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(sig2PProb, "#.0") + "%", text_color=probClr(sig2PProb), bgcolor=p.bg_secondary, text_size=sz)
        hitBg := hitSig2P ? p.validated_bg : p.pending_bg
        hitTxt := hitSig2P ? p.validated_text : p.pending_text
        hitLbl := hitSig2P ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
        
        float sig2NProb = getCondSigmaProb("-2", manipulation)
        table.cell(tbl, 0, row, "-2σ", text_color=i_sigmaDnColor, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(sig2NProb, "#.0") + "%", text_color=probClr(sig2NProb), bgcolor=p.bg_secondary, text_size=sz)
        hitBg := hitSig2N ? p.validated_bg : p.pending_bg
        hitTxt := hitSig2N ? p.validated_text : p.pending_text
        hitLbl := hitSig2N ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
    
    // PM-specific section
    if (inNYPM or inLunch) and not na(amH)
        table.cell(tbl, 0, row, "── PM ──", text_color=p.caution, bgcolor=color.new(p.caution, 85), text_size=sz)
        table.merge_cells(tbl, 0, row, 2, row)
        row += 1
        
        // PM management guidance
        table.cell(tbl, 0, row, "Mode", text_color=p.text_primary, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "MANAGE", text_color=p.caution, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, "No new entries", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
        
        // AM H
        table.cell(tbl, 0, row, "AM H", text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, "38.4%", text_color=probClr(38.4), bgcolor=p.bg_secondary, text_size=sz)
        hitBg = hitAMH ? p.validated_bg : p.pending_bg
        hitTxt = hitAMH ? p.validated_text : p.pending_text
        hitLbl = hitAMH ? "✓ Hit" : "Pending"
        table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
        row += 1
        
        // AM L
        if not na(amL)
            table.cell(tbl, 0, row, "AM L", text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
            table.cell(tbl, 1, row, "31.2%", text_color=probClr(31.2), bgcolor=p.bg_secondary, text_size=sz)
            hitBg := hitAML ? p.validated_bg : p.pending_bg
            hitTxt := hitAML ? p.validated_text : p.pending_text
            hitLbl := hitAML ? "✓ Hit" : "Pending"
            table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
            row += 1
        
        if inNYPM and not na(lunchH)
            // Lunch H
            table.cell(tbl, 0, row, "Lunch H", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
            table.cell(tbl, 1, row, "62.1%", text_color=probClr(62.1), bgcolor=p.bg_secondary, text_size=sz)
            hitBg := hitLchH ? p.validated_bg : p.pending_bg
            hitTxt := hitLchH ? p.validated_text : p.pending_text
            hitLbl := hitLchH ? "✓ Hit" : "Pending"
            table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
            row += 1
            
            // Lunch L
            table.cell(tbl, 0, row, "Lunch L", text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
            table.cell(tbl, 1, row, "53.2%", text_color=probClr(53.2), bgcolor=p.bg_secondary, text_size=sz)
            hitBg := hitLchL ? p.validated_bg : p.pending_bg
            hitTxt := hitLchL ? p.validated_text : p.pending_text
            hitLbl := hitLchL ? "✓ Hit" : "Pending"
            table.cell(tbl, 2, row, hitLbl, bgcolor=hitBg, text_color=hitTxt, text_size=sz)
            row += 1
    
    
    
    // Daily H/L
    table.cell(tbl, 0, row, "── DAILY ──", text_color=p.confirm, bgcolor=color.new(p.confirm, 85), text_size=sz)
    table.merge_cells(tbl, 0, row, 2, row)
    row += 1
    
    if not na(dayH) and not na(dayHHour)
        dayHTimeStr = str.format("{0,number,00}:{1,number,00}", dayHHour, dayHMin)
        table.cell(tbl, 0, row, "Day H", text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(dayH, "#.#"), text_color=p.bullish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, dayHTimeStr, text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1
    
    if not na(dayL) and not na(dayLHour)
        dayLTimeStr = str.format("{0,number,00}:{1,number,00}", dayLHour, dayLMin)
        table.cell(tbl, 0, row, "Day L", text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 1, row, str.tostring(dayL, "#.#"), text_color=p.bearish, bgcolor=p.bg_secondary, text_size=sz)
        table.cell(tbl, 2, row, dayLTimeStr, text_color=p.text_dim, bgcolor=p.bg_secondary, text_size=sz)
        row += 1

// ─── ALERTS ──────────────────────────────────────────────────────────────────

alertcondition(bias == "LONG", "Long Bias Confirmed", " Prob Engine: LONG bias confirmed")
alertcondition(bias == "SHORT", "Short Bias Confirmed", " Prob Engine: SHORT bias confirmed")
alertcondition(bias == "⚠ SKIP", "Misaligned - Skip", " Prob Engine: Misaligned setup - SKIP")
alertcondition(isJudas and isAligned, "Judas + Aligned", " Prob Engine: JUDAS sweep with aligned setup!")
alertcondition(gapChasing and isAligned, "Gap Chase + Aligned", " Prob Engine : Gap CHASING with aligned setup!")
alertcondition(qualityScore >= 5, "High Quality Setup", " Prob Engine: Quality score 5+ setup detected!")
